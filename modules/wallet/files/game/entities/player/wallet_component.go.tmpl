package player

import (
	db "{{MODULE}}/db"
	"{{MODULE}}/game/components/wallet"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:Wallet}}
const CompTypeWallet entity.ComponentType = {{ID:component:Wallet}}

// WalletComponent 是共用货币组件 wallet.Component 的类型别名，只为 Player 的生成接线命名。
// 货币业务（Apply / Add / Balance）全部在 game/components/wallet；这里只把 Player 的 DAO 字段交给它，
// 并把扣款接到 Player 的消费钩子（wallet_hooks.go）。余额在 PlayerDao.Wallet、回执在 PlayerDao.WalletLedger。
type WalletComponent = wallet.Component

// IWalletEntity 是 Nest handler 用这个组件时的窄实体接口；getter 由生成的 Entity 接线实现。
// 别的模块在自己的 handler 里要动货币时，目标接口里嵌入它即可（两个组件在同一个实体上，同一笔事务）。
type IWalletEntity interface {
	entity.IThreadSafeEntity
	WalletComp() *WalletComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeWallet, wallet.NewComponent)
}

// WalletReceiptWindow 是去重窗口的大小，见 wallet.ReceiptWindow。
const WalletReceiptWindow = wallet.ReceiptWindow

// WalletKeyMaxLen 是业务键的最大字节数，见 wallet.KeyMaxLen。
const WalletKeyMaxLen = wallet.KeyMaxLen

// ErrWalletAmount 是“金额必须为正”的拒绝。
func ErrWalletAmount() error { return wallet.ErrAmount() }

// 下面三个方法实现 wallet.Owner 与可选的消费回调；只在 Player 被 Nest 锁住期间调用。

func (e *Player) WalletState() *db.WalletState   { return e.Dao().GetWallet() }
func (e *Player) WalletLedger() *db.WalletLedger { return e.Dao().GetWalletLedger() }

// WalletSpent 在扣款首次生效时执行 OnWalletSpent 登记的钩子（同一笔事务，失败整笔回滚）。
func (e *Player) WalletSpent(amount, nowUnixMilli int64) error {
	return wallet.RunWalletSpent(e, amount, nowUnixMilli)
}

