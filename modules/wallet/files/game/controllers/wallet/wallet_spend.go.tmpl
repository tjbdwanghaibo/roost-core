package wallet

import (
	"log/slog"

	"github.com/tjbdwanghaibo/roost-core/infra/network/playeraccess"
	"{{MODULE}}/protocol/pb"
)

// HandleWalletSpend 是消费协议的入口；目标取认证会话的玩家，金额与余额在 Nest handler 的锁内校验。
//
//roost:endpoint nest=WalletSpend
func (controller *Controller) HandleWalletSpend(ctx *playeraccess.Context, req *pb.WalletSpendRequest) (*pb.WalletSpendResponse, error) {
	response, err := controller.dispatchWalletSpend(ctx, req)
	// 只记录已确认的请求结果；带业务键的重放也会返回成功，不把日志当作资产流水。
	if err == nil && response != nil && response.Code == 0 && ctx != nil && req != nil {
		slog.InfoContext(ctx.Context(), "wallet: spend completed", "player_id", ctx.PlayerID, "request_key", req.Key, "amount", req.Amount, "balance", response.Balance)
	}
	return response, err
}
