package wallet

import (
	"{{MODULE}}/game/view"
	"fmt"
	"slices"
	"sync"
)

// WalletSpentHook 在消费首次生效；Apply 的回执重放不执行，Add 每次成功扣款执行一次。
// 钩子在 Player 锁内、同一笔 Nest 事务中执行，只改同一实体，不能做 I/O。
// 任一钩子失败，调用方必须把错误返回给 Nest，让原业务与钩子的全部写入一起回滚。
type WalletSpentHook func(owner view.PlayerEntity, amount, nowUnixMilli int64) error

var walletHooksMu sync.RWMutex
var walletHooks = map[string]WalletSpentHook{}

// OnWalletSpent 只在 init 登记。名字用于确定执行顺序，空名、nil、重名直接 panic。
func OnWalletSpent(name string, hook WalletSpentHook) {
	if name == "" || hook == nil {
		panic("wallet: hook needs name and function")
	}
	walletHooksMu.Lock()
	defer walletHooksMu.Unlock()
	if _, exists := walletHooks[name]; exists {
		panic(fmt.Sprintf("wallet: duplicate hook %q", name))
	}
	walletHooks[name] = hook
}

func RunWalletSpent(owner view.PlayerEntity, amount, nowUnixMilli int64) error {
	walletHooksMu.RLock()
	names := make([]string, 0, len(walletHooks))
	for name := range walletHooks {
		names = append(names, name)
	}
	slices.Sort(names)
	hooks := make([]WalletSpentHook, len(names))
	for i, name := range names {
		hooks[i] = walletHooks[name]
	}
	walletHooksMu.RUnlock()
	for i, hook := range hooks {
		if err := hook(owner, amount, nowUnixMilli); err != nil {
			return fmt.Errorf("wallet: hook %s: %w", names[i], err)
		}
	}
	return nil
}
