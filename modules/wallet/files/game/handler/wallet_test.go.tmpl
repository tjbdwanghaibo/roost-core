type walletGetter map[int64]entity.IThreadSafeEntity

func (g walletGetter) Get(_ context.Context, id int64, _ entity.EntityCategory) (entity.IThreadSafeEntity, error) {
	if e := g[id]; e != nil {
		return e, nil
	}
	return nil, fmt.Errorf("missing %d", id)
}

func (g walletGetter) GetMany(ctx context.Context, ids []int64, cats []entity.EntityCategory) ([]entity.IThreadSafeEntity, error) {
	out := make([]entity.IThreadSafeEntity, len(ids))
	for i, id := range ids {
		e, err := g.Get(ctx, id, cats[i])
		if err != nil {
			return nil, err
		}
		out[i] = e
	}
	return out, nil
}

// walletCommitter 是替身提交器：不落盘，reject 打开时拒绝提交，用来验证回滚。
type walletCommitter struct{ reject atomic.Bool }

func (c *walletCommitter) Commit(context.Context, dataengine.CommitRecord) error {
	if c.reject.Load() {
		return errors.New("injected rejection")
	}
	return nil
}

type walletFixture struct {
	engine    *nest.NestMgr
	player    *playerentity.Player
	spendTo   *sender.WalletSpendSender
	grantTo   *sender.WalletGrantSender
	committer *walletCommitter
}

func newWalletFixture(t *testing.T, others ...entity.IThreadSafeEntity) *walletFixture {
	t.Helper()
	playerentity.RegisterEntity()
	RegisterWalletSpendNestHandlers()
	RegisterWalletGrantNestHandlers()
	f := &walletFixture{committer: &walletCommitter{}}
	id, err := entity.BuildEntityID(91001, playerentity.EntityKindPlayer)
	if err != nil {
		t.Fatal(err)
	}
	built, err := entity.BuildEntity(&entity.EntityCreateParam{IsCreate: true, Id: id, Kind: playerentity.EntityKindPlayer})
	if err != nil {
		t.Fatal(err)
	}
	f.player = built.(*playerentity.Player)
	getter := walletGetter{id: built}
	for _, other := range others {
		getter[other.ID()] = other
	}
	f.engine = nest.NewEngine(nest.NestOptionWithGetter(getter), nest.NestOptionWithTransactionCommitter(f.committer),
		nest.NestOptionWithWorkerPools(nest.WorkerPoolConfig{Workers: 2, QueueCap: 64}, nest.WorkerPoolConfig{}, nest.WorkerPoolConfig{}))
	if err := f.engine.Start(); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := f.engine.Shutdown(context.Background()); err != nil {
			t.Error(err)
		}
	})
	f.spendTo = sender.NewWalletSpendSender(f.engine)
	f.grantTo = sender.NewWalletGrantSender(f.engine)
	return f
}

// snapshot 在业务 worker 上持实体锁读余额与回执数。
func (f *walletFixture) snapshot(t *testing.T) (coins int64, receipts int) {
	t.Helper()
	if err := f.engine.RunLocal(context.Background(), func() {
		f.player.GetMutex().Lock()
		defer f.player.GetMutex().Unlock()
		coins = f.player.Dao().GetWallet().GetCoins()
		receipts = f.player.Dao().GetWalletLedger().ReceiptsLen()
	}); err != nil {
		t.Fatal(err)
	}
	return coins, receipts
}

// spend 走客户端协议对应的 handler，返回余额。
func (f *walletFixture) spend(key string, amount int64) (int64, error) {
	response, err := f.spendTo.Sync_WalletSpend(context.Background(), f.player.ID(), &pb.WalletSpendRequest{Key: key, Amount: amount})
	if err != nil {
		return 0, err
	}
	return response.Balance, nil
}

func (f *walletFixture) grant(t *testing.T, key string, amount int64) int64 {
	t.Helper()
	balance, err := f.grantTo.Sync_WalletGrant(context.Background(), f.player.ID(), key, amount)
	if err != nil {
		t.Fatal(err)
	}
	return balance
}

// walletCallHandler 是只在测试里登记的 Nest handler：在一笔真实的事务里直接调组件的 Add / Apply。
// 这两个入口是给服务端别的功能在自己的 handler 里调的（商店扣钱、体力补满、奖励发放），delta 的正负与
// 大小由调用方给；模块自带的两个 handler 只放行正的金额，走不到这里的边界。登记用的是生成代码登记
// handler 的同一个公开接口。swallow 为 true 时它吞掉组件的拒绝、以成功结束——事务照常提交，Nest 不会
// 替组件撤回任何写入，用来确认“拒绝时零写入”是组件自己做到的，不是靠 handler 返回错误之后的回滚。
var walletCallHandler = nest.NewHandlerName("walletTestCall")

var registerWalletCallHandler sync.Once

type walletCallResult struct {
	balance int64
	err     error
}

func (f *walletFixture) call(op, key string, delta int64, swallow bool) (int64, error) {
	registerWalletCallHandler.Do(func() {
		nest.MustRegisterHandlerWithMeta(walletCallHandler, func(es []entity.IThreadSafeEntity, params []any, _ ...nest.HandlerOption) (any, error) {
			component := es[0].(playerentity.IWalletEntity).WalletComp()
			var balance int64
			var err error
			switch params[0].(string) {
			case "add":
				balance, err = component.Add(params[2].(int64))
			case "apply":
				balance, err = component.Apply(params[1].(string), params[2].(int64))
			case "store":
				// 直接改存着的余额，不经组件：只用来摆出组件自己写不出来的状态。
				es[0].(*playerentity.Player).Dao().GetWallet().SetCoins(params[2].(int64))
				balance = params[2].(int64)
			default:
				return nil, fmt.Errorf("unknown op %v", params[0])
			}
			if err != nil && params[3].(bool) {
				return walletCallResult{err: err}, nil
			}
			return walletCallResult{balance: balance}, err
		}, nest.HandlerMeta{Rollback: nest.RollbackUndo, Durability: nest.DurabilityStrict})
	})
	ret, err := f.engine.Request(context.Background(), walletCallHandler, f.player.ID(), nest.NewParams(op, key, delta, swallow))
	if err != nil {
		return 0, err
	}
	result := ret.(walletCallResult)
	return result.balance, result.err
}

// add / apply 直接调组件入口；拒绝被吞掉、事务照常提交（见 walletCallHandler）。
func (f *walletFixture) add(delta int64) (int64, error) { return f.call("add", "", delta, true) }

func (f *walletFixture) apply(key string, delta int64) (int64, error) {
	return f.call("apply", key, delta, true)
}

// expectWallet 断言余额与回执数。
func (f *walletFixture) expectWallet(t *testing.T, what string, wantCoins int64, wantReceipts int) {
	t.Helper()
	if coins, receipts := f.snapshot(t); coins != wantCoins || receipts != wantReceipts {
		t.Fatalf("%s: coins=%d receipts=%d, want %d and %d", what, coins, receipts, wantCoins, wantReceipts)
	}
}

func TestWalletGrantAddsCoins(t *testing.T) {
	f := newWalletFixture(t)
	if got := f.grant(t, "g1", 100); got != 100 {
		t.Fatalf("balance = %d, want 100", got)
	}
	if coins, receipts := f.snapshot(t); coins != 100 || receipts != 1 {
		t.Fatalf("coins=%d receipts=%d", coins, receipts)
	}
}

func TestWalletSpendDeductsCoins(t *testing.T) {
	f := newWalletFixture(t)
	f.grant(t, "g1", 100)
	balance, err := f.spend("s1", 30)
	if err != nil || balance != 70 {
		t.Fatalf("balance=%d err=%v", balance, err)
	}
}

func TestWalletSpendWithoutEnoughCoinsWritesNothing(t *testing.T) {
	f := newWalletFixture(t)
	f.grant(t, "g1", 10)
	_, err := f.spend("s1", 30)
	if !errors.Is(err, apperrors.ErrWalletShort) {
		t.Fatalf("err = %v, want wallet_short", err)
	}
	if coins, receipts := f.snapshot(t); coins != 10 || receipts != 1 {
		t.Fatalf("refusal wrote: coins=%d receipts=%d", coins, receipts)
	}
}

func TestWalletSameKeyAppliesOnce(t *testing.T) {
	f := newWalletFixture(t)
	f.grant(t, "g1", 100)
	for i := 0; i < 3; i++ {
		balance, err := f.spend("s1", 30)
		if err != nil || balance != 70 {
			t.Fatalf("attempt %d: balance=%d err=%v", i, balance, err)
		}
	}
	if coins, receipts := f.snapshot(t); coins != 70 || receipts != 2 {
		t.Fatalf("coins=%d receipts=%d", coins, receipts)
	}
}

func TestWalletSameKeyWithAnotherAmountIsRefused(t *testing.T) {
	f := newWalletFixture(t)
	f.grant(t, "g1", 100)
	if _, err := f.spend("s1", 30); err != nil {
		t.Fatal(err)
	}
	_, err := f.spend("s1", 31)
	if !errors.Is(err, apperrors.ErrWalletConflict) {
		t.Fatalf("err = %v, want wallet_conflict", err)
	}
	if coins, _ := f.snapshot(t); coins != 70 {
		t.Fatalf("coins = %d, want 70", coins)
	}
}

func TestWalletRejectedCommitRollsBackCoinsAndReceipt(t *testing.T) {
	f := newWalletFixture(t)
	f.grant(t, "g1", 100)
	f.committer.reject.Store(true)
	if _, err := f.spend("s1", 30); err == nil {
		t.Fatal("a rejected commit reported success")
	}
	f.committer.reject.Store(false)
	if coins, receipts := f.snapshot(t); coins != 100 || receipts != 1 {
		t.Fatalf("rollback left coins=%d receipts=%d", coins, receipts)
	}
	// 回滚后同一个业务键可以再用：上一次没有生效。
	if balance, err := f.spend("s1", 30); err != nil || balance != 70 {
		t.Fatalf("balance=%d err=%v", balance, err)
	}
}

// 去重窗口只留最近 WalletReceiptWindow 条回执：再多的请求照常成功，最旧的回执被淘汰。
// 修前：回执满了之后每一次带业务键的加减都被拒绝，钱包从此不能用。
func TestWalletOldReceiptsLeaveTheWindow(t *testing.T) {
	f := newWalletFixture(t)
	const extra = 5
	for i := 0; i < playerentity.WalletReceiptWindow+extra; i++ {
		if got := f.grant(t, fmt.Sprintf("g%d", i), 1); got != int64(i+1) {
			t.Fatalf("grant %d: balance = %d", i, got)
		}
	}
	coins, receipts := f.snapshot(t)
	if coins != playerentity.WalletReceiptWindow+extra || receipts != playerentity.WalletReceiptWindow {
		t.Fatalf("coins=%d receipts=%d, want %d coins and a full window of %d", coins, receipts, playerentity.WalletReceiptWindow+extra, playerentity.WalletReceiptWindow)
	}
	// 窗口内的键仍然去重：最后一次发放重发，余额不变。
	if got := f.grant(t, fmt.Sprintf("g%d", playerentity.WalletReceiptWindow+extra-1), 1); got != coins {
		t.Fatalf("a key inside the window applied again: balance = %d, want %d", got, coins)
	}
	// 被淘汰的键不再去重：这是窗口的边界，长期“只发一次”由调用方自己的状态保证。
	if got := f.grant(t, "g0", 1); got != coins+1 {
		t.Fatalf("a key that left the window: balance = %d, want %d", got, coins+1)
	}
}

// Wallet 下发给客户端，回执账本只落库。只断言货币模块自己的两个字段：
// 同一个 DAO 上还有别的模块的字段，它们同不同步与本模块无关。
func TestWalletOnlyTheVisibleStateIsSynced(t *testing.T) {
	synced := map[string]bool{}
	for _, field := range db.PlayerDaoSyncFields() {
		synced[field.Name] = true
	}
	if !synced["Wallet"] {
		t.Fatal("PlayerDao.Wallet is not synced: the player would not see the balance")
	}
	if synced["WalletLedger"] {
		t.Fatal("PlayerDao.WalletLedger is synced: receipts are server-side state")
	}
}

// 业务键会成为落库文档里的字段名：太长、带空字节、带 . 或 $ 这类存储里有特殊含义的字符的键，
// 在写入之前就拒绝（wallet_invalid），不留回执、不动余额；UUID、十六进制串、“会话号:序号”这类键可用。
func TestWalletApplyRefusesKeysThatCannotBeStored(t *testing.T) {
	f := newWalletFixture(t)
	f.grant(t, "seed-1", 1000)
	coins, receipts := f.snapshot(t)
	long := ""
	for i := 0; i < 65; i++ {
		long += "k"
	}
	for _, key := range []string{long, "a.b", "$set", "a\x00b", "has space", "键"} {
		if _, err := f.spend(key, 10); !errors.Is(err, apperrors.ErrWalletInvalid) {
			t.Fatalf("key %q: err = %v, want wallet_invalid", key, err)
		}
		if gotCoins, gotReceipts := f.snapshot(t); gotCoins != coins || gotReceipts != receipts {
			t.Fatalf("key %q: a refused key wrote: coins=%d receipts=%d", key, gotCoins, gotReceipts)
		}
	}
	// 给客户端的拒绝文案要覆盖实际拒绝的几种情况（键的长度与字符、金额为 0 或不为正），不能只说“空键或零金额”。
	reason := errcode.ReasonOf(apperrors.ErrWalletInvalid)
	for _, want := range []string{"key", "1..64", "letters", "amount", "zero", "positive"} {
		if !strings.Contains(reason, want) {
			t.Fatalf("wallet_invalid reason %q does not mention %q", reason, want)
		}
	}
	if _, err := f.spend("negative-1", -10); !errors.Is(err, apperrors.ErrWalletInvalid) {
		t.Fatalf("negative amount: err = %v, want wallet_invalid", err)
	}
	if gotCoins, gotReceipts := f.snapshot(t); gotCoins != coins || gotReceipts != receipts {
		t.Fatalf("negative amount wrote: coins=%d receipts=%d", gotCoins, gotReceipts)
	}
	for i, key := range []string{long[:64], "0f8fad5b-d9cb-469f-a165-70867728950e", "session_7:42"} {
		if _, err := f.spend(key, 10); err != nil {
			t.Fatalf("key %q: %v", key, err)
		}
		if gotCoins, gotReceipts := f.snapshot(t); gotCoins != coins-int64(i+1)*10 || gotReceipts != receipts+i+1 {
			t.Fatalf("key %q: coins=%d receipts=%d", key, gotCoins, gotReceipts)
		}
	}
}

// 扣 math.MinInt64 是余额不足，不是成功：这个数取负还是它自己，用“余额 < -delta”判断不足会被它绕过，
// 余额随后被写成负数（修前：余额 100 时 Add / Apply 返回成功，余额变成 -9223372036854775708）。
// Add 与 Apply 都拒绝，余额与回执都不变；余额为 0、为 int64 上限时同样。
func TestWalletDebitOfTheMinimumIntegerIsRefused(t *testing.T) {
	f := newWalletFixture(t)
	f.expectWallet(t, "a new wallet", 0, 0)
	for _, coins := range []int64{0, 100, math.MaxInt64} {
		if coins > 0 {
			have, _ := f.snapshot(t)
			if _, err := f.add(coins - have); err != nil {
				t.Fatalf("raise the balance to %d: %v", coins, err)
			}
		}
		if balance, err := f.add(math.MinInt64); !errors.Is(err, apperrors.ErrWalletShort) {
			t.Fatalf("balance %d: Add(MinInt64) = %d, %v; want wallet_short", coins, balance, err)
		}
		f.expectWallet(t, fmt.Sprintf("balance %d after the refused Add", coins), coins, 0)
		if balance, err := f.apply("min-debit", math.MinInt64); !errors.Is(err, apperrors.ErrWalletShort) {
			t.Fatalf("balance %d: Apply(MinInt64) = %d, %v; want wallet_short", coins, balance, err)
		}
		f.expectWallet(t, fmt.Sprintf("balance %d after the refused Apply", coins), coins, 0)
	}
	// 被拒绝的键没有留下回执：之后用它做一次合法的扣款照常执行。
	if balance, err := f.apply("min-debit", -math.MaxInt64); err != nil || balance != 0 {
		t.Fatalf("a legal debit under the refused key: balance=%d err=%v, want 0", balance, err)
	}
	f.expectWallet(t, "after the legal debit", 0, 1)
}

// 普通的余额不足经 Add 与 Apply 都拒绝并且什么都不写；刚好扣完是合法的。
func TestWalletShortDebitThroughAddAndApplyWritesNothing(t *testing.T) {
	f := newWalletFixture(t)
	f.grant(t, "seed", 100)
	for _, delta := range []int64{-101, -1000, -math.MaxInt64} {
		if balance, err := f.add(delta); !errors.Is(err, apperrors.ErrWalletShort) {
			t.Fatalf("Add(%d) = %d, %v; want wallet_short", delta, balance, err)
		}
		if balance, err := f.apply(fmt.Sprintf("short%d", delta), delta); !errors.Is(err, apperrors.ErrWalletShort) {
			t.Fatalf("Apply(%d) = %d, %v; want wallet_short", delta, balance, err)
		}
		f.expectWallet(t, fmt.Sprintf("after the refused debits of %d", delta), 100, 1)
	}
	// Add 不留回执，Apply 留一条。
	if balance, err := f.add(-40); err != nil || balance != 60 {
		t.Fatalf("Add(-40): balance=%d err=%v, want 60", balance, err)
	}
	f.expectWallet(t, "after Add(-40)", 60, 1)
	if balance, err := f.apply("exact", -60); err != nil || balance != 0 {
		t.Fatalf("Apply(-60): balance=%d err=%v, want 0", balance, err)
	}
	f.expectWallet(t, "after the exact debit", 0, 2)
	if balance, err := f.add(-1); !errors.Is(err, apperrors.ErrWalletShort) {
		t.Fatalf("Add(-1) on an empty wallet = %d, %v; want wallet_short", balance, err)
	}
	f.expectWallet(t, "after the refused debit on an empty wallet", 0, 2)
}

// 加款的上界：余额加到 int64 上限是合法的，再多 1 是 wallet_overflow 并且什么都不写；从上限整笔扣回 0 合法。
func TestWalletLargestCreditFitsAndOneMoreOverflows(t *testing.T) {
	f := newWalletFixture(t)
	if balance, err := f.apply("fill", math.MaxInt64); err != nil || balance != math.MaxInt64 {
		t.Fatalf("Apply(MaxInt64) on an empty wallet: balance=%d err=%v", balance, err)
	}
	f.expectWallet(t, "after the largest credit", math.MaxInt64, 1)
	if balance, err := f.add(1); !errors.Is(err, apperrors.ErrWalletOverflow) {
		t.Fatalf("Add(1) on a full wallet = %d, %v; want wallet_overflow", balance, err)
	}
	if balance, err := f.apply("one-more", math.MaxInt64); !errors.Is(err, apperrors.ErrWalletOverflow) {
		t.Fatalf("Apply(MaxInt64) on a full wallet = %d, %v; want wallet_overflow", balance, err)
	}
	f.expectWallet(t, "after the refused credits", math.MaxInt64, 1)
	if balance, err := f.add(-math.MaxInt64); err != nil || balance != 0 {
		t.Fatalf("Add(-MaxInt64) on a full wallet: balance=%d err=%v, want 0", balance, err)
	}
	// 分两笔加到上限：第二笔恰好填满。
	if balance, err := f.add(math.MaxInt64 - 7); err != nil || balance != math.MaxInt64-7 {
		t.Fatalf("Add(MaxInt64-7): balance=%d err=%v", balance, err)
	}
	if balance, err := f.add(8); !errors.Is(err, apperrors.ErrWalletOverflow) {
		t.Fatalf("Add(8) with 7 of room = %d, %v; want wallet_overflow", balance, err)
	}
	if balance, err := f.add(7); err != nil || balance != math.MaxInt64 {
		t.Fatalf("Add(7) with 7 of room: balance=%d err=%v", balance, err)
	}
	f.expectWallet(t, "after filling in two credits", math.MaxInt64, 1)
}

// 提交被拒：直接经 Add / Apply 做的加减与回执一起回滚；回滚之后边界照旧——扣 math.MinInt64 仍被拒绝，
// 同一个业务键可以再用。
func TestWalletRejectedCommitRollsBackAddAndApply(t *testing.T) {
	f := newWalletFixture(t)
	f.grant(t, "seed", 100)
	f.committer.reject.Store(true)
	if _, err := f.add(50); err == nil {
		t.Fatal("Add under a rejected commit reported success")
	}
	if _, err := f.apply("k1", -30); err == nil {
		t.Fatal("Apply under a rejected commit reported success")
	}
	f.committer.reject.Store(false)
	f.expectWallet(t, "after the rejected commits", 100, 1)
	if balance, err := f.add(math.MinInt64); !errors.Is(err, apperrors.ErrWalletShort) {
		t.Fatalf("Add(MinInt64) after the rollback = %d, %v; want wallet_short", balance, err)
	}
	f.expectWallet(t, "after the refused debit", 100, 1)
	if balance, err := f.apply("k1", -30); err != nil || balance != 70 {
		t.Fatalf("Apply under the same key after the rollback: balance=%d err=%v, want 70", balance, err)
	}
	f.expectWallet(t, "after the retried debit", 70, 2)
}

// 存着的余额已经是负数时（组件自己写不出来；修掉“扣 math.MinInt64”之前可能留下这样的档），任何扣款
// 都是余额不足并且什么都不写——含 math.MinInt64：负余额加上它会回绕成一个很大的正数。加款照常，
// 加回非负之后扣款恢复正常。
func TestWalletNegativeBalanceRefusesEveryDebit(t *testing.T) {
	f := newWalletFixture(t)
	if _, err := f.call("store", "", -50, false); err != nil {
		t.Fatal(err)
	}
	f.expectWallet(t, "the arranged negative balance", -50, 0)
	for _, delta := range []int64{-1, -50, -math.MaxInt64, math.MinInt64} {
		if balance, err := f.add(delta); !errors.Is(err, apperrors.ErrWalletShort) {
			t.Fatalf("Add(%d) on a negative balance = %d, %v; want wallet_short", delta, balance, err)
		}
		if balance, err := f.apply("debit", delta); !errors.Is(err, apperrors.ErrWalletShort) {
			t.Fatalf("Apply(%d) on a negative balance = %d, %v; want wallet_short", delta, balance, err)
		}
		f.expectWallet(t, fmt.Sprintf("after the refused debits of %d", delta), -50, 0)
	}
	if balance, err := f.add(80); err != nil || balance != 30 {
		t.Fatalf("Add(80) on a negative balance: balance=%d err=%v, want 30", balance, err)
	}
	if balance, err := f.add(-30); err != nil || balance != 0 {
		t.Fatalf("Add(-30) once the balance is back above zero: balance=%d err=%v, want 0", balance, err)
	}
	f.expectWallet(t, "after the balance recovered", 0, 0)
}

// ---- 同一个组件挂在第二个实体上 ----

// walletVault 是只在测试里存在的第二个宿主（比如公会金库）：不是 Player，实体 kind 是测试自己的。
// 它用的组件就是 Player 那一份：经 Player 的组件号登记的工厂创建（工厂是 wallet.NewComponent），
// 真实宿主照 README 的“复用方式”另申请自己的组件号、登记同一个工厂。测试工程里没有第二个带货币字段的
// 生成 DAO，所以它借一份独立的 PlayerDao 实例当自己的存储；真实宿主在自己的 DAO 里加
// WalletState / WalletLedger 两个字段。它还实现可选的消费回调，用来验证回调失败时整笔回滚。
type walletVault struct {
	*entity.EntityBase
	entity.ComponentManager
	entity.DaoManager
	dao       *db.PlayerDao
	wallet    *playerentity.WalletComponent
	spent     []int64
	spentFail bool
}

// walletVaultKind 是测试宿主的实体 kind，取 kind 段的末尾，避开工程与模块分配的号。
const walletVaultKind entity.EntityKind = 250

var registerWalletVault sync.Once

func (v *walletVault) Base() *entity.EntityBase                  { return v.EntityBase }
func (v *walletVault) WalletComp() *playerentity.WalletComponent { return v.wallet }
func (v *walletVault) WalletState() *db.WalletState             { return v.dao.GetWallet() }
func (v *walletVault) WalletLedger() *db.WalletLedger           { return v.dao.GetWalletLedger() }

// WalletSpent 是宿主可选的消费回调：在同一笔事务里、扣款写入之后调用，返回错误时整笔回滚。
func (v *walletVault) WalletSpent(amount, _ int64) error {
	if v.spentFail {
		return errors.New("vault refuses the spend")
	}
	v.spent = append(v.spent, amount)
	return nil
}

func newWalletVault(t *testing.T, unique int64) *walletVault {
	t.Helper()
	playerentity.RegisterEntity()
	registerWalletVault.Do(func() {
		entity.RegisterEntityBuilder(&entity.EntityBuilderParam{
			Category: entity.EntityCategoryOther,
			Kind:     walletVaultKind,
			Builder: func(param *entity.EntityCreateParam) (entity.IThreadSafeEntity, error) {
				if err := param.NormalizeID(walletVaultKind); err != nil {
					return nil, err
				}
				v := &walletVault{ComponentManager: entity.NewComponentManager(), DaoManager: entity.NewDaoManager(), dao: db.NewPlayerDao()}
				v.EntityBase = entity.NewEntityBaseWithMutex(param.Id, param.Category, false, param.Mutex, param.Kind)
				v.dao.SetId(param.StorageID())
				v.DaoManager.Set(db.PlayerDaoCollection, v.dao)
				comp, err := entity.CreateComponent(playerentity.CompTypeWallet, v, param)
				if err != nil {
					return nil, err
				}
				v.wallet = comp.(*playerentity.WalletComponent)
				v.ComponentManager.Set(playerentity.CompTypeWallet, v.wallet)
				if err := v.ComponentManager.InitAll(param, param.IsCreate); err != nil {
					return nil, err
				}
				return v, nil
			},
			DaoBuilders: []entity.DaoBuilderFunc{func() entity.DaoInterface { return db.NewPlayerDao() }},
			Lifetime:    entity.EntityLifetimePersistedHotCold,
		})
	})
	id, err := entity.BuildEntityID(unique, walletVaultKind)
	if err != nil {
		t.Fatal(err)
	}
	built, err := entity.BuildEntity(&entity.EntityCreateParam{IsCreate: true, Id: id, Kind: walletVaultKind})
	if err != nil {
		t.Fatalf("the wallet component does not attach to a second entity: %v", err)
	}
	return built.(*walletVault)
}

// vaultCall 在一笔真实的 Nest 事务里调金库上的组件；拒绝不吞，交给 Nest 回滚。
var walletVaultCallHandler = nest.NewHandlerName("walletTestVaultCall")

var registerWalletVaultCall sync.Once

func (f *walletFixture) vaultCall(vault *walletVault, op, key string, delta int64) (int64, error) {
	registerWalletVaultCall.Do(func() {
		nest.MustRegisterHandlerWithMeta(walletVaultCallHandler, func(es []entity.IThreadSafeEntity, params []any, _ ...nest.HandlerOption) (any, error) {
			component := es[0].(*walletVault).WalletComp()
			switch params[0].(string) {
			case "add":
				return component.Add(params[2].(int64))
			case "apply":
				return component.Apply(params[1].(string), params[2].(int64))
			}
			return nil, fmt.Errorf("unknown op %v", params[0])
		}, nest.HandlerMeta{Rollback: nest.RollbackUndo, Durability: nest.DurabilityStrict})
	})
	ret, err := f.engine.Request(context.Background(), walletVaultCallHandler, vault.ID(), nest.NewParams(op, key, delta))
	if err != nil {
		return 0, err
	}
	return ret.(int64), nil
}

// vaultState 在业务 worker 上持金库的锁读余额、回执数与已回调的消费。
func (f *walletFixture) vaultState(t *testing.T, vault *walletVault) (coins int64, receipts int, spent []int64) {
	t.Helper()
	if err := f.engine.RunLocal(context.Background(), func() {
		vault.GetMutex().Lock()
		defer vault.GetMutex().Unlock()
		coins = vault.WalletState().GetCoins()
		receipts = vault.WalletLedger().ReceiptsLen()
		spent = append([]int64(nil), vault.spent...)
	}); err != nil {
		t.Fatal(err)
	}
	return coins, receipts, spent
}

func (f *walletFixture) expectVault(t *testing.T, vault *walletVault, what string, wantCoins int64, wantReceipts int, wantSpent []int64) {
	t.Helper()
	coins, receipts, spent := f.vaultState(t, vault)
	if coins != wantCoins || receipts != wantReceipts || fmt.Sprint(spent) != fmt.Sprint(wantSpent) {
		t.Fatalf("%s: vault coins=%d receipts=%d spent=%v, want %d, %d, %v", what, coins, receipts, spent, wantCoins, wantReceipts, wantSpent)
	}
}

// 同一个组件挂在第二个实体上：加减、按业务键去重、不足 / 冲突 / 溢出的拒绝与 Player 上一样，
// 拒绝时什么都不写；宿主的消费回调只在扣款首次生效时调用。玩家的钱包一直不动。
func TestWalletSecondHostAddsSpendsAndRefuses(t *testing.T) {
	vault := newWalletVault(t, 72001)
	f := newWalletFixture(t, vault)
	if balance, err := f.vaultCall(vault, "add", "", 100); err != nil || balance != 100 {
		t.Fatalf("vault Add(100): balance=%d err=%v", balance, err)
	}
	for i := 0; i < 2; i++ {
		if balance, err := f.vaultCall(vault, "apply", "upkeep-1", -30); err != nil || balance != 70 {
			t.Fatalf("vault Apply attempt %d: balance=%d err=%v, want 70", i, balance, err)
		}
	}
	f.expectVault(t, vault, "after the deduplicated debit", 70, 1, []int64{30})
	if _, err := f.vaultCall(vault, "apply", "upkeep-1", -31); !errors.Is(err, apperrors.ErrWalletConflict) {
		t.Fatalf("vault Apply with another amount: err = %v, want wallet_conflict", err)
	}
	if _, err := f.vaultCall(vault, "add", "", -71); !errors.Is(err, apperrors.ErrWalletShort) {
		t.Fatalf("vault Add(-71): err = %v, want wallet_short", err)
	}
	if _, err := f.vaultCall(vault, "add", "", math.MinInt64); !errors.Is(err, apperrors.ErrWalletShort) {
		t.Fatalf("vault Add(MinInt64): err = %v, want wallet_short", err)
	}
	if _, err := f.vaultCall(vault, "add", "", math.MaxInt64); !errors.Is(err, apperrors.ErrWalletOverflow) {
		t.Fatalf("vault Add(MaxInt64): err = %v, want wallet_overflow", err)
	}
	if _, err := f.vaultCall(vault, "apply", "bad.key", 5); !errors.Is(err, apperrors.ErrWalletInvalid) {
		t.Fatalf("vault Apply with a key that cannot be stored: err = %v, want wallet_invalid", err)
	}
	f.expectVault(t, vault, "after the refusals", 70, 1, []int64{30})
	f.expectWallet(t, "the player's wallet while the vault changed", 0, 0)
}

// 第二个宿主上的回滚：提交被拒、宿主的消费回调失败，余额与回执都回到事务之前，同一个业务键可以再用。
func TestWalletSecondHostRollsBack(t *testing.T) {
	vault := newWalletVault(t, 72002)
	f := newWalletFixture(t, vault)
	if _, err := f.vaultCall(vault, "apply", "seed", 100); err != nil {
		t.Fatal(err)
	}
	f.committer.reject.Store(true)
	if _, err := f.vaultCall(vault, "apply", "k1", -30); err == nil {
		t.Fatal("vault Apply under a rejected commit reported success")
	}
	f.committer.reject.Store(false)
	// spent 是测试自己在内存里的记录，不随事务回滚：回调在提交之前执行，被拒的那一次也记了一笔。
	f.expectVault(t, vault, "after the rejected commit", 100, 1, []int64{30})
	vault.spentFail = true
	if _, err := f.vaultCall(vault, "apply", "k1", -30); err == nil {
		t.Fatal("vault Apply with a failing spend callback reported success")
	}
	vault.spentFail = false
	f.expectVault(t, vault, "after the failed callback", 100, 1, []int64{30})
	if balance, err := f.vaultCall(vault, "apply", "k1", -30); err != nil || balance != 70 {
		t.Fatalf("vault Apply under the same key after the rollbacks: balance=%d err=%v, want 70", balance, err)
	}
	f.expectVault(t, vault, "after the retried debit", 70, 2, []int64{30, 30})
	f.expectWallet(t, "the player's wallet", 0, 0)
}

// 玩家与金库各有一份状态：同一个业务键在两边各生效一次，互不去重，余额各算各的。
func TestWalletSecondHostAndPlayerKeepSeparateState(t *testing.T) {
	vault := newWalletVault(t, 72003)
	f := newWalletFixture(t, vault)
	f.grant(t, "shared-key", 40)
	if balance, err := f.vaultCall(vault, "apply", "shared-key", 500); err != nil || balance != 500 {
		t.Fatalf("vault Apply under the player's key: balance=%d err=%v, want 500", balance, err)
	}
	if balance, err := f.spend("spend-1", 15); err != nil || balance != 25 {
		t.Fatalf("player spend: balance=%d err=%v, want 25", balance, err)
	}
	f.expectWallet(t, "the player's wallet", 25, 2)
	f.expectVault(t, vault, "the vault", 500, 1, nil)
}
