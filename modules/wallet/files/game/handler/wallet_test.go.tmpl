type walletGetter map[int64]entity.IThreadSafeEntity

func (g walletGetter) Get(_ context.Context, id int64, _ entity.EntityCategory) (entity.IThreadSafeEntity, error) {
	if e := g[id]; e != nil {
		return e, nil
	}
	return nil, fmt.Errorf("missing %d", id)
}

func (g walletGetter) GetMany(ctx context.Context, ids []int64, cats []entity.EntityCategory) ([]entity.IThreadSafeEntity, error) {
	out := make([]entity.IThreadSafeEntity, len(ids))
	for i, id := range ids {
		e, err := g.Get(ctx, id, cats[i])
		if err != nil {
			return nil, err
		}
		out[i] = e
	}
	return out, nil
}

// walletCommitter 是替身提交器：不落盘，reject 打开时拒绝提交，用来验证回滚。
type walletCommitter struct{ reject atomic.Bool }

func (c *walletCommitter) Commit(context.Context, dataengine.CommitRecord) error {
	if c.reject.Load() {
		return errors.New("injected rejection")
	}
	return nil
}

type walletFixture struct {
	engine    *nest.NestMgr
	player    *playerentity.Player
	spendTo   *sender.WalletSpendSender
	grantTo   *sender.WalletGrantSender
	committer *walletCommitter
}

func newWalletFixture(t *testing.T) *walletFixture {
	t.Helper()
	playerentity.RegisterEntity()
	RegisterWalletSpendNestHandlers()
	RegisterWalletGrantNestHandlers()
	f := &walletFixture{committer: &walletCommitter{}}
	id, err := entity.BuildEntityID(91001, playerentity.EntityKindPlayer)
	if err != nil {
		t.Fatal(err)
	}
	built, err := entity.BuildEntity(&entity.EntityCreateParam{IsCreate: true, Id: id, Kind: playerentity.EntityKindPlayer})
	if err != nil {
		t.Fatal(err)
	}
	f.player = built.(*playerentity.Player)
	f.engine = nest.NewEngine(nest.NestOptionWithGetter(walletGetter{id: built}), nest.NestOptionWithTransactionCommitter(f.committer),
		nest.NestOptionWithWorkerPools(nest.WorkerPoolConfig{Workers: 2, QueueCap: 64}, nest.WorkerPoolConfig{}, nest.WorkerPoolConfig{}))
	if err := f.engine.Start(); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := f.engine.Shutdown(context.Background()); err != nil {
			t.Error(err)
		}
	})
	f.spendTo = sender.NewWalletSpendSender(f.engine)
	f.grantTo = sender.NewWalletGrantSender(f.engine)
	return f
}

// snapshot 在业务 worker 上持实体锁读余额与回执数。
func (f *walletFixture) snapshot(t *testing.T) (coins int64, receipts int) {
	t.Helper()
	if err := f.engine.RunLocal(context.Background(), func() {
		f.player.GetMutex().Lock()
		defer f.player.GetMutex().Unlock()
		coins = f.player.Dao().GetWallet().GetCoins()
		receipts = f.player.Dao().GetWalletLedger().ReceiptsLen()
	}); err != nil {
		t.Fatal(err)
	}
	return coins, receipts
}

// spend 走客户端协议对应的 handler，返回余额。
func (f *walletFixture) spend(key string, amount int64) (int64, error) {
	response, err := f.spendTo.Sync_WalletSpend(context.Background(), f.player.ID(), &pb.WalletSpendRequest{Key: key, Amount: amount})
	if err != nil {
		return 0, err
	}
	return response.Balance, nil
}

func (f *walletFixture) grant(t *testing.T, key string, amount int64) int64 {
	t.Helper()
	balance, err := f.grantTo.Sync_WalletGrant(context.Background(), f.player.ID(), key, amount)
	if err != nil {
		t.Fatal(err)
	}
	return balance
}

func TestWalletGrantAddsCoins(t *testing.T) {
	f := newWalletFixture(t)
	if got := f.grant(t, "g1", 100); got != 100 {
		t.Fatalf("balance = %d, want 100", got)
	}
	if coins, receipts := f.snapshot(t); coins != 100 || receipts != 1 {
		t.Fatalf("coins=%d receipts=%d", coins, receipts)
	}
}

func TestWalletSpendDeductsCoins(t *testing.T) {
	f := newWalletFixture(t)
	f.grant(t, "g1", 100)
	balance, err := f.spend("s1", 30)
	if err != nil || balance != 70 {
		t.Fatalf("balance=%d err=%v", balance, err)
	}
}

func TestWalletSpendWithoutEnoughCoinsWritesNothing(t *testing.T) {
	f := newWalletFixture(t)
	f.grant(t, "g1", 10)
	_, err := f.spend("s1", 30)
	if !errors.Is(err, apperrors.ErrWalletShort) {
		t.Fatalf("err = %v, want wallet_short", err)
	}
	if coins, receipts := f.snapshot(t); coins != 10 || receipts != 1 {
		t.Fatalf("refusal wrote: coins=%d receipts=%d", coins, receipts)
	}
}

func TestWalletSameKeyAppliesOnce(t *testing.T) {
	f := newWalletFixture(t)
	f.grant(t, "g1", 100)
	for i := 0; i < 3; i++ {
		balance, err := f.spend("s1", 30)
		if err != nil || balance != 70 {
			t.Fatalf("attempt %d: balance=%d err=%v", i, balance, err)
		}
	}
	if coins, receipts := f.snapshot(t); coins != 70 || receipts != 2 {
		t.Fatalf("coins=%d receipts=%d", coins, receipts)
	}
}

func TestWalletSameKeyWithAnotherAmountIsRefused(t *testing.T) {
	f := newWalletFixture(t)
	f.grant(t, "g1", 100)
	if _, err := f.spend("s1", 30); err != nil {
		t.Fatal(err)
	}
	_, err := f.spend("s1", 31)
	if !errors.Is(err, apperrors.ErrWalletConflict) {
		t.Fatalf("err = %v, want wallet_conflict", err)
	}
	if coins, _ := f.snapshot(t); coins != 70 {
		t.Fatalf("coins = %d, want 70", coins)
	}
}

func TestWalletRejectedCommitRollsBackCoinsAndReceipt(t *testing.T) {
	f := newWalletFixture(t)
	f.grant(t, "g1", 100)
	f.committer.reject.Store(true)
	if _, err := f.spend("s1", 30); err == nil {
		t.Fatal("a rejected commit reported success")
	}
	f.committer.reject.Store(false)
	if coins, receipts := f.snapshot(t); coins != 100 || receipts != 1 {
		t.Fatalf("rollback left coins=%d receipts=%d", coins, receipts)
	}
	// 回滚后同一个业务键可以再用：上一次没有生效。
	if balance, err := f.spend("s1", 30); err != nil || balance != 70 {
		t.Fatalf("balance=%d err=%v", balance, err)
	}
}

// Wallet 下发给客户端，回执账本只落库。只断言货币模块自己的两个字段：
// 同一个 DAO 上还有别的模块的字段，它们同不同步与本模块无关。
func TestWalletOnlyTheVisibleStateIsSynced(t *testing.T) {
	synced := map[string]bool{}
	for _, field := range db.PlayerDaoSyncFields() {
		synced[field.Name] = true
	}
	if !synced["Wallet"] {
		t.Fatal("PlayerDao.Wallet is not synced: the player would not see the balance")
	}
	if synced["WalletLedger"] {
		t.Fatal("PlayerDao.WalletLedger is synced: receipts are server-side state")
	}
}
