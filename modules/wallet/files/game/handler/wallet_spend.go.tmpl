package handler

import (
	"{{MODULE}}/game/components/wallet"
	"{{MODULE}}/game/view"
	"{{MODULE}}/protocol/pb"
)

// handlerWalletSpend 是客户端发起的消费：扣 request.Amount，按 request.Key 幂等。
//
//roost:nest rollback=undo
func handlerWalletSpend(target view.IWalletEntity, request *pb.WalletSpendRequest) (*pb.WalletSpendResponse, error) {
	if request.Amount <= 0 {
		return nil, wallet.ErrAmount()
	}
	balance, err := target.Wallet().Apply(request.Key, -request.Amount)
	if err != nil {
		return nil, err
	}
	return &pb.WalletSpendResponse{Balance: balance}, nil
}
