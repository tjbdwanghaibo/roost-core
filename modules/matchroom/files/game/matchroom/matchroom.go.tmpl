// Package matchroom 把可信成局结果移交给本服唯一属主的 Room。调用在 Nest 锁外执行。
package matchroom

import (
	"context"
	"errors"
	"fmt"
	"slices"

	"{{MODULE}}/game/lifecycle"
	db "{{MODULE}}/db"
	roomentity "{{MODULE}}/game/entities/room"
	sender "{{MODULE}}/game/handler/syncsender"

	"github.com/tjbdwanghaibo/roost-core/framework/app"
	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/framework/nest"
	"github.com/tjbdwanghaibo/roost-core/wiring/mods"
	"go.mongodb.org/mongo-driver/v2/bson"
	fmongo "github.com/tjbdwanghaibo/roost-core/infra/storage/mongo"
	kitdataengine "github.com/tjbdwanghaibo/roost-core/wiring/dataengine"
)

// Binding 保存的是移交身份，不依赖 match 服务短期历史，也不以推送成功当作开房事实。
type Binding struct {
	MatchID string  `bson:"_id"`
	RoomID  int64   `bson:"room"`
	SID     int32   `bson:"sid"`
	Members []int64 `bson:"members"`
}
type Rooms struct {
	sid  int32
	bind func(context.Context, string, []int64) (Binding, error)
	open func(context.Context, Binding) error
}

func FromRegistry(registry *app.Registry) (*Rooms, error) {
	if registry == nil {
		return nil, fmt.Errorf("matchroom: registry required")
	}
	client, ok := app.Lookup[nest.Client](registry, mods.ModNest)
	if !ok || client == nil {
		return nil, fmt.Errorf("matchroom: nest unavailable")
	}
	lifecycle, err := lifecycle.RoomFromRegistry(registry)
	if err != nil {
		return nil, err
	}
	mongo, ok := app.Lookup[fmongo.IMongo](registry, mods.ModMongo)
	if !ok || mongo == nil {
		return nil, fmt.Errorf("matchroom: mongo unavailable")
	}
	databases, err := kitdataengine.Databases(registry)
	if err != nil {
		return nil, err
	}
	var identity app.ServiceIdentity
	if err := app.LoadConfig(registry.Config(), &identity); err != nil {
		return nil, err
	}
	if identity.Sid <= 0 {
		return nil, fmt.Errorf("matchroom: positive sid required")
	}
	database := mongo.Database(databases.Physical(db.RoomDaoDBName))
	ids, bindings := database.Collection("_room_id_sequence"), database.Collection("_match_rooms")
	r := &Rooms{sid: identity.Sid}
	r.bind = func(ctx context.Context, key string, members []int64) (Binding, error) {
		// 已有映射只读返回，不在每次重放时递增分配器或改写账本。
		var value Binding
		if err := bindings.FindOne(ctx, bson.M{"_id": key}, &value); err == nil {
			return value, nil
		} else if !errors.Is(err, fmongo.ErrNotFound) {
			return Binding{}, err
		}
		// 并发重放允许计数器跳号；_id 唯一约束确保同一 match 只有一个最终 RoomID。
		var counter struct {
			Next int64 `bson:"next"`
		}
		if err := ids.FindOneAndUpdate(ctx, bson.M{"_id": "room"}, bson.M{"$inc": bson.M{"next": int64(1)}}, &counter, fmongo.FindOneAndUpdateOption{Upsert: true, ReturnAfter: true}); err != nil {
			return Binding{}, err
		}
		if counter.Next <= 0 || uint64(counter.Next) >= entity.StaticUniqueIDBase {
			return Binding{}, fmt.Errorf("matchroom: room counter exhausted")
		}
		value = Binding{MatchID: key, RoomID: counter.Next, SID: r.sid, Members: slices.Clone(members)}
		if _, err := bindings.InsertOne(ctx, value); err != nil {
			if !errors.Is(err, fmongo.ErrDuplicateKey) {
				return Binding{}, err
			}
			// 另一请求先保留了同一 MatchID，读取赢家；未知写结果留给下一次查询恢复。
			if err := bindings.FindOne(ctx, bson.M{"_id": key}, &value); err != nil {
				return Binding{}, err
			}
		}
		return value, nil
	}
	r.open = func(ctx context.Context, b Binding) error {
		value, _, err := lifecycle.GetOrCreate(ctx, b.RoomID)
		if err != nil {
			return err
		}
		return sender.NewMatchroomOpenSender(client).Sync_MatchroomOpen(ctx, value.ID(), b.MatchID, b.Members)
	}
	return r, nil
}

// Open 幂等恢复“保留房号成功、创建实体/初始化失败”；返回成功前名单和容量必须已提交。
func (r *Rooms) Open(ctx context.Context, matchID string, members []int64) (int64, error) {
	if r == nil || r.bind == nil || r.open == nil || matchID == "" || len(matchID) > 128 || len(members) < 2 || len(members) > int(roomentity.MaxSeats) {
		return 0, fmt.Errorf("matchroom: invalid handoff")
	}
	ids := slices.Clone(members)
	slices.Sort(ids)
	for i, id := range ids {
		if id <= 0 || (i > 0 && ids[i-1] == id) {
			return 0, fmt.Errorf("matchroom: invalid roster")
		}
	}
	binding, err := r.bind(ctx, matchID, ids)
	if err != nil {
		return 0, err
	}
	if binding.MatchID != matchID || binding.SID != r.sid || binding.RoomID <= 0 || uint64(binding.RoomID) >= entity.StaticUniqueIDBase || !slices.Equal(binding.Members, ids) {
		return 0, fmt.Errorf("matchroom: conflicting handoff")
	}
	if err := r.open(ctx, binding); err != nil {
		return 0, err
	}
	return binding.RoomID, nil
}
