package room

import (
	"{{MODULE}}/game/components/matchroom"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:Matchroom}}
const CompTypeMatchroom entity.ComponentType = {{ID:component:Matchroom}}

// MatchroomComponent 是 game/components/matchroom 的组件在 Room 上的名字（生成接线与 handler 用它）；业务在那个包里。
type MatchroomComponent = matchroom.Component

type IMatchroomEntity interface {
	entity.IThreadSafeEntity
	MatchroomComp() *MatchroomComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeMatchroom, matchroom.NewComponent)
}
