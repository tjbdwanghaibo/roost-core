package room

import (
	"fmt"
	"slices"

	apperrors "{{MODULE}}/internal/errors"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:Matchroom}}
const CompTypeMatchroom entity.ComponentType = {{ID:component:Matchroom}}

type MatchroomComponent struct {
	entity.ComponentBase
	owner *Room
}
type IMatchroomEntity interface {
	entity.IThreadSafeEntity
	MatchroomComp() *MatchroomComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeMatchroom, func(owner any, _ *entity.EntityCreateParam) (entity.ComponentInterfaceBase, error) {
		r, ok := owner.(*Room)
		if !ok {
			return nil, fmt.Errorf("matchroom: owner %T is not Room", owner)
		}
		return &MatchroomComponent{owner: r}, nil
	})
	OnRoomJoining("matchroom", func(r *Room, id int64) error {
		state := r.Dao().GetMatchroom()
		if state.GetMatchID() != "" && !slices.Contains(r.MatchroomComp().members(), id) {
			return apperrors.ErrRoomNotMember
		}
		return nil
	})
}
func (c *MatchroomComponent) Name() string { return "matchroom" }

// Open 的全部输入只来自可信匹配结果。普通房不能在有人进入后改造成匹配房；同键名单变化也拒绝。
func (c *MatchroomComponent) Open(matchID string, members []int64) error {
	if matchID == "" || len(matchID) > 128 || len(members) < 2 || len(members) > int(MaxSeats) {
		return apperrors.ErrRoomInvalid
	}
	ids := slices.Clone(members)
	slices.Sort(ids)
	for i, id := range ids {
		if id <= 0 || (i > 0 && ids[i-1] == id) {
			return apperrors.ErrRoomInvalid
		}
	}
	d := c.owner.Dao()
	state := d.GetMatchroom()
	if state.GetMatchID() != "" {
		if state.GetMatchID() != matchID || !slices.Equal(c.members(), ids) {
			return apperrors.ErrRoomInvalid
		}
		// 重复通知可以确认已关闭的同一局，但绝不重新开房、重置席位或代际。
		if d.GetClosed() {
			return nil
		}
		return c.owner.RoomComp().Open(int32(len(ids)))
	}
	if d.GetCapacity() != 0 {
		return apperrors.ErrRoomInvalid
	}
	if err := c.owner.RoomComp().Open(int32(len(ids))); err != nil {
		return err
	}
	state.SetMatchID(matchID)
	state.SetMembers(ids)
	return nil
}

func (c *MatchroomComponent) members() []int64 {
	state := c.owner.Dao().GetMatchroom()
	ids := make([]int64, 0, state.MembersLen())
	state.RangeMembers(func(_ int, id int64) bool { ids = append(ids, id); return true })
	return ids
}

// Closed 仅供可信流程核对前一局已终结，不向玩家泄露未加入的房间数据。
func (c *MatchroomComponent) Closed(matchID string) bool {
	return matchID != "" && c.owner.Dao().GetMatchroom().GetMatchID() == matchID && c.owner.Dao().GetClosed()
}
