package player

import (
	"{{MODULE}}/game/components/rules"
	"{{MODULE}}/protocol/pb"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

// IRulesEntity 是 RulesRead handler 的窄实体接口：规则快照由 game/components/rules 按登记的读取函数拼出。
type IRulesEntity interface {
	entity.IThreadSafeEntity
	RulesSnapshot() (*pb.RulesNowPush, error)
}

// RulesSnapshot 读出当前玩家的规则快照（实现见 rules.Snapshot）。
func (e *Player) RulesSnapshot() (*pb.RulesNowPush, error) { return rules.Snapshot(e) }
