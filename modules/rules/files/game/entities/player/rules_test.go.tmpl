package player

import (
	"errors"
	"reflect"
	"testing"

	"{{MODULE}}/protocol/pb"
)

func rulesEmptyRegistry(t *testing.T) {
	t.Helper()
	playerRuleProviders.Lock()
	saved := playerRuleProviders.entries
	playerRuleProviders.entries = nil
	playerRuleProviders.Unlock()
	t.Cleanup(func() { playerRuleProviders.Lock(); playerRuleProviders.entries = saved; playerRuleProviders.Unlock() })
}
func TestRulesReadersAreOrderedAndSnapshotsOwnTheirBytes(t *testing.T) {
	rulesEmptyRegistry(t)
	owner := &Player{}
	empty, err := owner.RulesSnapshot()
	if err != nil || len(empty.Parts) != 0 {
		t.Fatalf("empty rules=%v %v", empty, err)
	}
	data := []byte{1, 2}
	RegisterPlayerRules("z", func(*Player) (*pb.RulePart, error) { return &pb.RulePart{MessageID: 32, Payload: data}, nil })
	RegisterPlayerRules("a", func(*Player) (*pb.RulePart, error) { return &pb.RulePart{MessageID: 31, Payload: []byte{3}}, nil })
	got, err := owner.RulesSnapshot()
	if err != nil {
		t.Fatal(err)
	}
	data[0] = 9
	if len(got.Parts) != 2 || got.Parts[0].MessageID != 31 || got.Parts[1].MessageID != 32 || !reflect.DeepEqual(got.Parts[1].Payload, []byte{1, 2}) {
		t.Fatalf("ordered owned snapshot=%v", got)
	}
}
func TestRulesBadRegistrationsFailAtStartup(t *testing.T) {
	rulesEmptyRegistry(t)
	read := func(*Player) (*pb.RulePart, error) { return &pb.RulePart{MessageID: 1}, nil }
	RegisterPlayerRules("one", read)
	for _, attempt := range []func(){func() { RegisterPlayerRules(" ", read) }, func() { RegisterPlayerRules("nil", nil) }, func() { RegisterPlayerRules("one", read) }} {
		panicked := false
		func() { defer func() { panicked = recover() != nil }(); attempt() }()
		if !panicked {
			t.Fatal("invalid rules registration accepted")
		}
	}
}
func TestRulesDuplicateMessageIDRejectsTheWholeSnapshot(t *testing.T) {
	rulesEmptyRegistry(t)
	read := func(*Player) (*pb.RulePart, error) { return &pb.RulePart{MessageID: 1}, nil }
	RegisterPlayerRules("one", read)
	RegisterPlayerRules("two", read)
	got, err := (&Player{}).RulesSnapshot()
	if err == nil || got != nil {
		t.Fatalf("duplicate rules accepted: %v %v", got, err)
	}
}
func TestRulesProviderErrorKeepsItsCause(t *testing.T) {
	rulesEmptyRegistry(t)
	refused := errors.New("invalid rules")
	RegisterPlayerRules("fail", func(*Player) (*pb.RulePart, error) { return nil, refused })
	got, err := (&Player{}).RulesSnapshot()
	if got != nil || !errors.Is(err, refused) {
		t.Fatalf("rules failure=%v %v", got, err)
	}
}
