package controllers

import (
	"context"
	"fmt"

	"github.com/tjbdwanghaibo/roost-core/framework/app"
	svcmail "github.com/tjbdwanghaibo/roost-core/service/mail"
	gamerehome "{{MODULE}}/game/modules/rehome"
)

// 进入时向 account 确认本进程仍承载玩家；换服中不允许刷新画像。mail 用同一份快照的代数和序号拒绝迟到的写。
// 单装 mailbox 或 mailbox + enter 不需要换服目录。
func init() {
	mailboxBindingForPull = func(ctx context.Context, reg *app.Registry, player int64) (svcmail.BroadcastBinding, int32, error) {
		self, err := gamerehome.SelfSID(reg)
		if err != nil {
			return svcmail.BroadcastBinding{}, 0, err
		}
		b, err := gamerehome.RegistryDirectory(reg).Binding(ctx, player)
		if err != nil {
			return svcmail.BroadcastBinding{}, 0, err
		}
		if b.PlayerID != player || b.Transfer != nil || b.ServingServerID != self {
			return svcmail.BroadcastBinding{}, 0, svcmail.ErrBroadcastProfileRequired
		}
		return svcmail.BroadcastBinding{ServerID: self, Epoch: b.BindEpoch, Seq: b.TransferSeq}, b.ServerID, nil
	}
	gamerehome.OnLeaving("mailbox", func(ctx context.Context, registry *app.Registry, move gamerehome.Move) error {
		mailer, ok := app.Lookup[svcmail.Mail](registry, svcmail.CapabilityName)
		if !ok || mailer == nil {
			return nil
		} // isolated module fixtures do not publish mail
		b, err := gamerehome.RegistryDirectory(registry).Binding(ctx, move.PlayerID)
		if err != nil {
			return err
		}
		if b.PlayerID != move.PlayerID || b.ServingServerID != move.From || b.BindEpoch != move.Epoch || b.Transfer == nil || b.Transfer.ID != move.ID || b.Transfer.From != move.From || b.Transfer.To != move.To {
			return fmt.Errorf("mailbox: transfer %s is no longer current: %w", move.ID, svcmail.ErrBroadcastProfileRequired)
		}
		return mailboxPullBroadcastsOnLeave(ctx, mailer, move, b.TransferSeq)
	})
}

type mailboxBroadcastCloser interface {
	CloseBroadcastScope(context.Context, int64, svcmail.BroadcastBinding) (svcmail.Summary, error)
}

// 旧服广播追平与停用旧画像必须在同一笔邮箱更新完成。满箱只保留已经合并的进度，不停用，换服中止。
func mailboxPullBroadcastsOnLeave(ctx context.Context, mailer mailboxBroadcastCloser, move gamerehome.Move, seq uint64) error {
	summary, err := mailer.CloseBroadcastScope(ctx, move.PlayerID, svcmail.BroadcastBinding{ServerID: move.From, Epoch: move.Epoch, Seq: seq})
	if err != nil {
		return fmt.Errorf("mailbox: close broadcast scope for player %d leaving %d: %w", move.PlayerID, move.From, err)
	}
	if summary.BroadcastsBehind {
		return fmt.Errorf("mailbox: clear space before moving player %d: %w", move.PlayerID, svcmail.ErrMailboxFull)
	}
	return nil
}
