// mailboxRehomeEnvelopes 是 mail 服务的信封存储替身（进程内的一张表，只插入不改写）。
type mailboxRehomeEnvelopes struct {
	mu   sync.Mutex
	byID map[string]svcmail.Envelope
}

func (s *mailboxRehomeEnvelopes) Create(_ context.Context, envelope svcmail.Envelope) (bool, error) {
	s.mu.Lock()
	defer s.mu.Unlock()
	if _, taken := s.byID[envelope.ID]; taken {
		return false, nil
	}
	s.byID[envelope.ID] = envelope
	return true, nil
}

func (s *mailboxRehomeEnvelopes) Get(_ context.Context, id string) (svcmail.Envelope, bool, error) {
	s.mu.Lock()
	defer s.mu.Unlock()
	envelope, ok := s.byID[id]
	return envelope, ok, nil
}

func (s *mailboxRehomeEnvelopes) GetMany(_ context.Context, ids []string) (map[string]svcmail.Envelope, error) {
	s.mu.Lock()
	defer s.mu.Unlock()
	out := make(map[string]svcmail.Envelope, len(ids))
	for _, id := range ids {
		if envelope, ok := s.byID[id]; ok {
			out[id] = envelope
		}
	}
	return out, nil
}

// mailboxRehomeService 是带 LazyBroadcast（内存索引与存储）的真实 mail 服务。
func mailboxRehomeService(t *testing.T) *svcmail.Service {
	t.Helper()
	service, err := svcmail.New(svcmail.Config{
		Envelopes: &mailboxRehomeEnvelopes{byID: map[string]svcmail.Envelope{}},
		Mailboxes: versionstore.NewMemoryStore[int64, svcmail.Mailbox](),
		Sends:     versionstore.NewMemoryStore[string, svcmail.SentRecord](),
		Broadcast: svcmail.NewLazyBroadcast(svcmail.LazyBroadcastConfig{Index: svcmail.NewMemoryBroadcastIndex()}),
	})
	if err != nil {
		t.Fatal(err)
	}
	return service
}

// 换服 A → B 前后的全服邮件归属（D11 N3 A），用真实的 mail 服务：玩家在 A 进入时按 A 的范围拉过一次；之后发给 A 的
// 一封在离开时由离开钩子合并进来；离开之后才发给 A 的不属于他；离开之前就发给 B 的也不属于他（那时他还不是 B 的人）；
// 到了 B 按 B 的范围拉，之后发给 B 的照常收到。没有离开钩子时，离开前发给 A 的那封会丢，离开前发给 B 的会多出来。
func TestWithMailboxRehomeMergesTheOldServersMailBeforeLeaving(t *testing.T) {
	const playerID, from, to = int64(94301), int32(3), int32(4)
	ctx := context.Background()
	mail := mailboxRehomeService(t)
	registered := time.Now().Add(-24 * time.Hour).Unix()
	pull := func(server int32) {
		t.Helper()
		if _, err := mail.PullBroadcasts(ctx, playerID, svcmail.BroadcastProfile{Scopes: []string{svcmail.ServerScope(server)}, RegisteredAtUnix: registered}); err != nil {
			t.Fatalf("pull with server %d's scope: %v", server, err)
		}
	}
	send := func(server int32, name string) string {
		t.Helper()
		envelope, err := mail.Send(ctx, svcmail.SendRequest{
			Audience: svcmail.AudienceBroadcast, Scope: svcmail.ServerScope(server),
			Subject: name, Body: name, ExpiresInSeconds: 7 * 24 * 3600, RequestID: name,
		})
		if err != nil {
			t.Fatalf("send %s: %v", name, err)
		}
		return envelope.ID
	}

	pull(from) // 在 A 进入
	oldBeforeLeaving := send(from, "a-before-leaving")
	newBeforeLeaving := send(to, "b-before-leaving")
	move := gamerehome.Move{PlayerID: playerID, ID: "transfer-94301", From: from, To: to}
	if err := mailboxPullBroadcastsOnLeave(ctx, mail, move); err != nil {
		t.Fatalf("leave hook: %v", err)
	}
	oldAfterLeaving := send(from, "a-after-leaving")
	newAfterLeaving := send(to, "b-after-leaving")
	pull(to) // 到 B 进入

	page, err := mail.List(ctx, playerID, "", svcmail.MaxPageSize)
	if err != nil {
		t.Fatal(err)
	}
	got := map[string]bool{}
	for _, item := range page.Items {
		got[item.Envelope.ID] = true
	}
	for _, c := range []struct {
		name string
		id   string
		want bool
	}{
		{"sent to the old server while he was there", oldBeforeLeaving, true},
		{"sent to the new server before he left", newBeforeLeaving, false},
		{"sent to the old server after he left", oldAfterLeaving, false},
		{"sent to the new server after he left", newAfterLeaving, true},
	} {
		if got[c.id] != c.want {
			t.Errorf("%s: in the mailbox = %v, want %v", c.name, got[c.id], c.want)
		}
	}
}

// 邮箱满（全是未读）时 mail 服务的合并停在放不下的那封之前、Summary 仍然成功（正常背压，见 service/mail 的
// mergeBroadcasts）。离开钩子不能把这当作“旧服的全服邮件已合并完”：那样换走之后按新服范围合并，旧服那封永远补不回来，
// 离开前发给新服的反而在腾出位置后被合并（RV-20261117-01）。这里钩子必须拒绝（带 mail 的 ErrMailboxFull），换服中止、
// 画像不变；腾出一个位置再离开就合并上旧服那封，到新服之后离开前发给新服的那封仍不属于他。
func TestWithMailboxRehomeRefusesToLeaveWithTheOldServersMailUnmerged(t *testing.T) {
	const playerID, from, to = int64(94309), int32(3), int32(4)
	ctx := context.Background()
	mail := mailboxRehomeService(t)
	registered := time.Now().Add(-24 * time.Hour).Unix()
	pull := func(server int32) {
		t.Helper()
		if _, err := mail.PullBroadcasts(ctx, playerID, svcmail.BroadcastProfile{Scopes: []string{svcmail.ServerScope(server)}, RegisteredAtUnix: registered}); err != nil {
			t.Fatalf("pull with server %d's scope: %v", server, err)
		}
	}
	send := func(req svcmail.SendRequest) string {
		t.Helper()
		envelope, err := mail.Send(ctx, req)
		if err != nil {
			t.Fatalf("send %s: %v", req.RequestID, err)
		}
		return envelope.ID
	}
	broadcast := func(server int32, name string) string {
		return send(svcmail.SendRequest{
			Audience: svcmail.AudienceBroadcast, Scope: svcmail.ServerScope(server),
			Subject: name, Body: name, ExpiresInSeconds: 7 * 24 * 3600, RequestID: name,
		})
	}

	pull(from) // 在 A 进入
	var filler string
	for i := 0; i < svcmail.MaxMailboxEntries; i++ { // 邮箱塞满未读
		id := send(svcmail.SendRequest{
			Audience: svcmail.AudienceDirect, Recipients: []int64{playerID},
			Subject: "filler", Body: "filler", ExpiresInSeconds: 7 * 24 * 3600, RequestID: "filler-" + strconv.Itoa(i),
		})
		if i == 0 {
			filler = id
		}
	}
	oldBeforeLeaving := broadcast(from, "a-before-leaving")
	newBeforeLeaving := broadcast(to, "b-before-leaving")
	move := gamerehome.Move{PlayerID: playerID, ID: "transfer-94309", From: from, To: to}

	err := mailboxPullBroadcastsOnLeave(ctx, mail, move)
	if !errors.Is(err, svcmail.ErrMailboxFull) {
		box, _, _ := mail.Mailbox(ctx, playerID)
		t.Fatalf("leave hook with server %d's mail not merged (mailbox full, watermark %d): err = %v; want the move refused with mail's ErrMailboxFull",
			from, box.BroadcastWatermark, err)
	}

	// 玩家留在 A、腾出一个位置，再离开一次：A 的那封合并进来，钩子放行。
	if _, err := mail.Delete(ctx, playerID, filler); err != nil {
		t.Fatal(err)
	}
	if err := mailboxPullBroadcastsOnLeave(ctx, mail, move); err != nil {
		t.Fatalf("leave hook after making room: %v", err)
	}
	pull(to) // 到 B 进入
	box, _, err := mail.Mailbox(ctx, playerID)
	if err != nil {
		t.Fatal(err)
	}
	if _, ok := box.Entries[oldBeforeLeaving]; !ok {
		t.Errorf("server %d's mail sent while he was there is missing after the move", from)
	}
	if _, ok := box.Entries[newBeforeLeaving]; ok {
		t.Errorf("server %d's mail sent before he left was merged", to)
	}
}

// mailboxRehomeSummarizer 记下离开钩子发出的汇总请求。
type mailboxRehomeSummarizer struct {
	calls    int
	playerID int64
	err      error
}

func (s *mailboxRehomeSummarizer) Summary(_ context.Context, playerID int64) (svcmail.Summary, error) {
	s.calls++
	s.playerID = playerID
	return svcmail.Summary{PlayerID: playerID}, s.err
}

// mail 服务不可用时离开钩子返回错误（带着 mail 的错误），换服因此中止；钩子登记在 rehome 的离开登记点上，名字是模块名。
func TestWithMailboxRehomeAbortsTheMoveWhenTheMergeFails(t *testing.T) {
	away := errors.New("mail service is away")
	summarizer := &mailboxRehomeSummarizer{err: away}
	err := mailboxPullBroadcastsOnLeave(context.Background(), summarizer, gamerehome.Move{PlayerID: 94302, From: 3, To: 4})
	if !errors.Is(err, away) || summarizer.calls != 1 || summarizer.playerID != 94302 {
		t.Fatalf("err = %v after %d calls for player %d; want the mail service's error after one call for 94302", err, summarizer.calls, summarizer.playerID)
	}
	defer func() {
		recovered := recover()
		if message, _ := recovered.(string); !strings.Contains(message, `leave hook "mailbox" is registered twice`) {
			t.Fatalf("registering the mailbox leave hook again: %v; want the duplicate-registration panic (the hook must already be registered)", recovered)
		}
	}()
	gamerehome.OnLeaving("mailbox", func(context.Context, *app.Registry, gamerehome.Move) error { return nil })
}
