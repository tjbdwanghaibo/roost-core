package mailbox

import (
	"context"
	"errors"
	"testing"

	gameenter "{{MODULE}}/game/enter"

	svcaccount "github.com/tjbdwanghaibo/roost-core/service/account"
	svcmail "github.com/tjbdwanghaibo/roost-core/service/mail"
)

// withEnterPuller 记下钩子向 mail 服务发出的拉取。
type withEnterPuller struct {
	calls    int
	playerID int64
	profile  svcmail.BroadcastProfile
	err      error
}

func (p *withEnterPuller) PullBroadcasts(_ context.Context, playerID int64, profile svcmail.BroadcastProfile) (svcmail.Summary, error) {
	p.calls++
	p.playerID, p.profile = playerID, profile
	return svcmail.Summary{}, p.err
}

// 会话没有带 claims 的工程（不用 account 服务）：进入游戏时按“首次进入的时间 = 注册时间”拉一次全服邮件，
// 范围只有“所有玩家”；老玩家再进入用的是同一个注册时间。
func TestWithMailboxEnterPullsBroadcastsWithTheFirstEnterTime(t *testing.T) {
	puller := &withEnterPuller{}
	entered := gameenter.Entered{PlayerID: 94201, InitResult: gameenter.InitResult{First: false, FirstAtUnixMilli: 1_700_000_123_999}}
	if err := pullBroadcastsOnEnter(context.Background(), puller, entered); err != nil {
		t.Fatal(err)
	}
	if puller.calls != 1 || puller.playerID != 94201 {
		t.Fatalf("pulled %d times for player %d, want once for 94201", puller.calls, puller.playerID)
	}
	if puller.profile.RegisteredAtUnix != 1_700_000_123 {
		t.Fatalf("registered at %d, want 1700000123 (the first-enter time in seconds)", puller.profile.RegisteredAtUnix)
	}
	if len(puller.profile.Scopes) != 0 || len(puller.profile.Attributes) != 0 {
		t.Fatalf("profile %+v carries scopes or attributes the default rule does not set", puller.profile)
	}
	if err := puller.profile.Validate(); err != nil {
		t.Fatalf("the mail service would refuse this profile: %v", err)
	}
}

// 注册时间未知时不拉取：不能把玩家当成老玩家，把建号之前的补偿发给他。
func TestWithMailboxEnterDoesNotPullWithoutAFirstEnterTime(t *testing.T) {
	puller := &withEnterPuller{}
	if err := pullBroadcastsOnEnter(context.Background(), puller, gameenter.Entered{PlayerID: 94202}); err == nil {
		t.Fatal("a pull without a registration time reported success")
	}
	if puller.calls != 0 {
		t.Fatalf("pulled %d times without a registration time", puller.calls)
	}
}

// mail 服务不可用时把错误交给进入钩子的调用方（它只记日志，登录照常）。
func TestWithMailboxEnterReportsAFailedPull(t *testing.T) {
	away := errors.New("mail service is away")
	puller := &withEnterPuller{err: away}
	entered := gameenter.Entered{PlayerID: 94203, InitResult: gameenter.InitResult{FirstAtUnixMilli: 1_700_000_000_000}}
	if err := pullBroadcastsOnEnter(context.Background(), puller, entered); !errors.Is(err, away) {
		t.Fatalf("err = %v, want the mail service's error", err)
	}
}

// 用 account 服务的工程：认证器把角色的创建时间、承载服与原服写进会话的 claims，进入钩子把它们带过来。
// 注册时间改用角色的创建时间（比首次进入早，建角之后、进游戏之前发的补偿也收得到）；
// 范围多出承载服；别名合服之后原服与承载服不同的角色再多出原服——合服前发给原服的邮件照样属于他。
// 这三个键写死在这里：它们是认证器与这个钩子之间的约定，改了键名两边要一起改。
func TestWithMailboxEnterTakesRegistrationAndServerScopesFromTheSessionClaims(t *testing.T) {
	if svcaccount.RoleCreatedAtClaim != "role_created_at" || svcaccount.ServerIDClaim != "server_id" || svcaccount.OriginServerIDClaim != "origin_server_id" {
		t.Fatal("the account claim keys changed: authenticators already write the old ones")
	}
	puller := &withEnterPuller{}
	entered := gameenter.Entered{
		PlayerID: 94204, InitResult: gameenter.InitResult{FirstAtUnixMilli: 1_700_000_500_000},
		Claims: map[string]string{"role_created_at": "1700000000", "server_id": "1300", "origin_server_id": "1300", "channel": "ios"},
	}
	if err := pullBroadcastsOnEnter(context.Background(), puller, entered); err != nil {
		t.Fatal(err)
	}
	if puller.calls != 1 || puller.playerID != 94204 {
		t.Fatalf("pulled %d times for player %d, want once for 94204", puller.calls, puller.playerID)
	}
	if puller.profile.RegisteredAtUnix != 1_700_000_000 {
		t.Fatalf("registered at %d, want the role creation time 1700000000, not the first-enter time", puller.profile.RegisteredAtUnix)
	}
	if len(puller.profile.Scopes) != 1 || puller.profile.Scopes[0] != svcmail.ServerScope(1300) {
		t.Fatalf("scopes = %v, want only the serving server 1300 (the origin is the same server)", puller.profile.Scopes)
	}
	if len(puller.profile.Attributes) != 0 {
		t.Fatalf("attributes = %v: a claim the rule does not know became a business attribute", puller.profile.Attributes)
	}
	if err := puller.profile.Validate(); err != nil {
		t.Fatalf("the mail service would refuse this profile: %v", err)
	}
	// 原服 1301 并入 1300 之后：承载服在前、原服在后。
	entered.Claims = map[string]string{"role_created_at": "1700000000", "server_id": "1300", "origin_server_id": "1301"}
	merged, ok := BroadcastProfileOnEnter(entered)
	if !ok || len(merged.Scopes) != 2 || merged.Scopes[0] != svcmail.ServerScope(1300) || merged.Scopes[1] != svcmail.ServerScope(1301) {
		t.Fatalf("a merged role's profile = %+v (%v), want the scopes of 1300 and 1301", merged, ok)
	}
	// 只有角色创建时间、没有区服的会话：注册时间照用，范围仍只有“所有玩家”。原服单独出现不算数——
	// 不知道承载服就不知道这名玩家现在归哪个服。
	entered.Claims = map[string]string{"role_created_at": "1700000000", "origin_server_id": "1301"}
	unscoped, ok := BroadcastProfileOnEnter(entered)
	if !ok || unscoped.RegisteredAtUnix != 1_700_000_000 || len(unscoped.Scopes) != 0 {
		t.Fatalf("a session without a serving server gave %+v (%v), want the role creation time and no scopes", unscoped, ok)
	}
	// 档里还没有首次进入的时间（工程自己改写的进入流程没有带）也不妨碍：角色创建时间就是注册时间。
	entered.InitResult = gameenter.InitResult{}
	if profile, ok := BroadcastProfileOnEnter(entered); !ok || profile.RegisteredAtUnix != 1_700_000_000 {
		t.Fatalf("without a first-enter time the profile = %+v (%v), want the role creation time", profile, ok)
	}
}

// 读不了的 claim 按没写处理，不让进入钩子失败，也不把玩家当成老玩家：注册时间退回首次进入的时间
// （不早于建角，只会少收），区服读不了就不带区服范围。两个时间都没有才不拉取。
func TestWithMailboxEnterTreatsUnreadableClaimsAsAbsent(t *testing.T) {
	first := gameenter.InitResult{FirstAtUnixMilli: 1_700_000_500_000}
	for name, claims := range map[string]map[string]string{
		"not numbers":      {"role_created_at": "yesterday", "server_id": "s1300", "origin_server_id": "x"},
		"zero":             {"role_created_at": "0", "server_id": "0", "origin_server_id": "0"},
		"negative":         {"role_created_at": "-5", "server_id": "-1300", "origin_server_id": "-1"},
		"empty":            {"role_created_at": "", "server_id": "", "origin_server_id": ""},
		"sid beyond int32": {"role_created_at": "9223372036854775808", "server_id": "2147483648", "origin_server_id": "1301"},
	} {
		profile, ok := BroadcastProfileOnEnter(gameenter.Entered{PlayerID: 94205, InitResult: first, Claims: claims})
		if !ok || profile.RegisteredAtUnix != 1_700_000_500 || len(profile.Scopes) != 0 {
			t.Errorf("%s: profile = %+v (%v), want the first-enter time 1700000500 and no scopes", name, profile, ok)
		}
		if _, ok := BroadcastProfileOnEnter(gameenter.Entered{PlayerID: 94205, Claims: claims}); ok {
			t.Errorf("%s: a profile was built with no registration time at all", name)
		}
	}
	// 原服读不了、承载服读得了：只带承载服。
	profile, ok := BroadcastProfileOnEnter(gameenter.Entered{PlayerID: 94205, InitResult: first, Claims: map[string]string{"server_id": "1300", "origin_server_id": "old"}})
	if !ok || len(profile.Scopes) != 1 || profile.Scopes[0] != svcmail.ServerScope(1300) {
		t.Fatalf("profile = %+v (%v), want only the serving server's scope", profile, ok)
	}
	// 不拉取时钩子报错（调用方只记日志），mail 服务没有被调到。
	puller := &withEnterPuller{}
	if err := pullBroadcastsOnEnter(context.Background(), puller, gameenter.Entered{PlayerID: 94205, Claims: map[string]string{"role_created_at": "0"}}); err == nil || puller.calls != 0 {
		t.Fatalf("err = %v after %d pulls, want a refusal before any pull", err, puller.calls)
	}
}
