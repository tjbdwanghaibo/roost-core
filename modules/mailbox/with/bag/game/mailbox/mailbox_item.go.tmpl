package mailbox

import "fmt"

// 这个文件是 mailbox 与 bag 两个模块的联动：两个都装着时才有。
//
// 它登记“道具”这个附件种类：Amount 个 ID 号道具，领取时进背包。这里只有种类的名字、校验与给发件方用的
// 构造函数；发放方式（BagComp().Add）登记在 game/entities/player/mailbox_item.go，两个文件一起写进工程。
// 没有这份联动的工程里 "item" 没登记，道具附件与任何不认识的种类一样被拒绝、邮件保持未领。

// TypeItem 是道具附件。线上格式 {"type":"item","id":1001,"amount":3}。
const TypeItem Type = "item"

// Item 是 amount 个 itemID 号道具的附件，给发件方用：
// mailbox.SendTo(ctx, mailer, mailbox.Letter{..., Attachment: mailbox.Item(1001, 3)})。
func Item(itemID, amount int64) Attachment {
	return Attachment{Type: TypeItem, ID: itemID, Amount: amount}
}

func init() {
	RegisterType(TypeItem, validateItem)
}

// validateItem 是道具附件的校验：道具号必须为正（数量为正由 Validate 统一判断）。
//
// 这里只挡“肯定不是道具”的号。道具号在不在道具表里、这么多放不放得进背包，是背包在发放时的判断
// （game/entities/player/bag_items.go 与 BagComponent.Add）：校验函数必须是纯函数，不读配置表，
// 也不能把背包的上限在这里再写一份。所以发件方要自己保证道具号存在、数量不超过单种上限——
// 否则这封邮件每次领取都被背包拒绝（bag_item_invalid / bag_stack_full），一直留在邮箱里直到过期。
func validateItem(attachment Attachment) error {
	if attachment.ID <= 0 {
		return fmt.Errorf("mailbox: %d is not an item id", attachment.ID)
	}
	return nil
}
