package player

import (
	"{{MODULE}}/game/components/mailbox"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

// MailboxComponent 是 game/components/mailbox 的组件在 Player 上的名字（生成接线与 handler 用它）；业务在那个包里。
// 类型号 mailbox.CompTypeMailbox 与工厂登记在组件包里（模块清单的 component_package）；下面的别名与窄接口暂留给现有 handler。
type MailboxComponent = mailbox.Component

// IMailboxEntity 是 Nest handler 用这个组件时的窄实体接口；getter 由生成的 Entity 接线实现。
type IMailboxEntity interface {
	entity.IThreadSafeEntity
	MailboxComp() *MailboxComponent
}
