package player

import (
	"fmt"
	"sync"

	gamemailbox "{{MODULE}}/game/mailbox"
)

// 这个文件是邮件附件“怎么发到玩家身上”的登记点。附件有哪些种类、各自合不合法登记在 game/mailbox
// （那个包不认识实体）；这里登记每个种类在 Player 上的发放方式，MailboxComponent.Claim 按附件的种类取用。
// 金币内置；别的种类由提供它的功能在本包自己的文件里用 init 登记（例如 mailbox 与 bag 的联动文件）。

// MailboxGrant 是一种附件在 Player 上的发放方式。两个函数都在 Nest 锁住 owner 之后、
// MailboxComponent.Claim 的那笔事务里调用，拿到的附件已经通过 gamemailbox.Validate。
type MailboxGrant struct {
	// Grant 把附件发给 owner，返回发放后的持有量（金币是余额，道具是这个道具号的数量）。
	//
	//   - 它不判重：这封邮件发过没有由 Claim 在同一笔事务里记账本，它被调到就是该发；
	//   - 只经 owner 的 DAO setter 或别的组件改状态，不加锁、不登记 undo、不做事务外的事
	//     （跨进程调用、推送）：返回错误或提交失败时整笔事务回滚，事务外做过的收不回来；
	//   - 发不了就返回带码错误（背包满、余额溢出……），那个码原样答给客户端，邮件保持未领、之后还能再领。
	Grant func(owner *Player, attachment gamemailbox.Attachment) (int64, error)
	// Held 只读：owner 此刻持有多少这份附件说的东西。这封邮件已经到过账的重复到达用它回答，
	// 所以它要与 Grant 返回的是同一个量。
	Held func(owner *Player, attachment gamemailbox.Attachment) int64
}

var (
	mailboxGrantsMu sync.RWMutex
	// mailboxGrants 是登记过的发放方式。金币内置，经货币组件到账。
	mailboxGrants = map[gamemailbox.Type]MailboxGrant{
		gamemailbox.TypeCoins: {
			Grant: func(owner *Player, attachment gamemailbox.Attachment) (int64, error) {
				return owner.WalletComp().Add(attachment.Amount)
			},
			Held: func(owner *Player, _ gamemailbox.Attachment) int64 {
				return owner.WalletComp().Balance()
			},
		},
	}
)

// RegisterMailboxGrant 登记一种附件的发放方式。只在 init 里调用，之后只读。
// 缺函数、重名、或者这个种类没有在 game/mailbox 登记过（RegisterType；空名也在此列）是写错了，直接 panic：
// 没登记校验的种类解不出来，给它登记发放方式永远用不上。本包 import game/mailbox，
// 那边的 init 先跑完，所以这里查得到。
func RegisterMailboxGrant(kind gamemailbox.Type, grant MailboxGrant) {
	if grant.Grant == nil || grant.Held == nil {
		panic("mailbox: RegisterMailboxGrant needs both Grant and Held")
	}
	if !gamemailbox.Registered(kind) {
		panic(fmt.Sprintf("mailbox: attachment type %q has a grant but is not registered in game/mailbox", kind))
	}
	mailboxGrantsMu.Lock()
	defer mailboxGrantsMu.Unlock()
	if _, taken := mailboxGrants[kind]; taken {
		panic(fmt.Sprintf("mailbox: the grant for attachment type %q is registered twice", kind))
	}
	mailboxGrants[kind] = grant
}

// MailboxGrantable 报告这个种类有没有登记发放方式。列表端点用它回答“可领”；不需要实体锁。
func MailboxGrantable(kind gamemailbox.Type) bool {
	_, ok := mailboxGrantFor(kind)
	return ok
}

func mailboxGrantFor(kind gamemailbox.Type) (MailboxGrant, bool) {
	mailboxGrantsMu.RLock()
	defer mailboxGrantsMu.RUnlock()
	grant, ok := mailboxGrants[kind]
	return grant, ok
}
