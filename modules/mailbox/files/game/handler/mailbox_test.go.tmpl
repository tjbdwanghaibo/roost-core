// 邮件附件的发放入口（handlerMailboxClaimReward）是三步领取里唯一能保证“每封至多到账一次”的地方：
// 客户端打不开“发放成功、确认丢失、预留到期、重试再来”这个窗口（它在 mail 服务与游戏之间），
// 所以在这里用真实生成的 handler、真实的 Nest 事务把它钉住。时间都是 Unix 秒；
// 用例把业务时钟停在要的那一刻（handler 拿到的是这条消息冻结的业务时间）。

// mailboxStart 是用例的起点时刻（Unix 秒）。
const mailboxStart int64 = 1_800_000_000

// 测试自己登记两个种类，方式与正式的种类相同（只在 init 里；本包的 init 在 game/mailbox 与实体包之后跑）：
//
//   - mailboxTestVoucher 只登记了“合不合法”，没有登记发放方式：解得出来，但领不了。
//   - mailboxTestChest 两样都登记了：号是 1 到 3 的“宝箱”，开出 数量×号 个金币。3 号箱先把金币写进去
//     再报错，用来验证发放方式写过的东西跟着事务回滚。它报的持有量故意不是钱包余额（余额 + 5000），
//     这样“回的是这个种类自己的持有量”看得出来。
const (
	mailboxTestVoucher gamemailbox.Type = "mailbox_test_voucher"
	mailboxTestChest   gamemailbox.Type = "mailbox_test_chest"
	// mailboxTestChestHeldOffset 是宝箱的持有量比钱包余额多出的数。
	mailboxTestChestHeldOffset int64 = 5000
)

// mailboxTestBagGlue 报告这个工程里有没有 mailbox 与 bag 的联动：联动自带的测试文件在 init 里把它置为 true。
// 它看的是“联动的文件在不在”，不问被测代码“道具能不能发”——没有联动的工程里道具附件必须被拒绝，
// 这件事不能因为被测代码把道具认了下来就不再检查。
var mailboxTestBagGlue bool

var (
	errMailboxTestChestCursed = errors.New("chest 3 is cursed")
	// mailboxTestChestGrants / mailboxTestChestHeldReads 数宝箱的 Grant 与 Held 各被调了几次。
	mailboxTestChestGrants    atomic.Int64
	mailboxTestChestHeldReads atomic.Int64
)

func init() {
	gamemailbox.RegisterType(mailboxTestVoucher, func(gamemailbox.Attachment) error { return nil })
	gamemailbox.RegisterType(mailboxTestChest, func(attachment gamemailbox.Attachment) error {
		if attachment.ID < 1 || attachment.ID > 3 {
			return fmt.Errorf("chest %d does not exist", attachment.ID)
		}
		return nil
	})
	playerentity.RegisterMailboxGrant(mailboxTestChest, playerentity.MailboxGrant{
		Grant: func(owner *playerentity.Player, attachment gamemailbox.Attachment) (int64, error) {
			mailboxTestChestGrants.Add(1)
			balance, err := owner.WalletComp().Add(attachment.Amount * attachment.ID)
			if err != nil {
				return 0, err
			}
			if attachment.ID == 3 {
				return 0, errMailboxTestChestCursed
			}
			return balance + mailboxTestChestHeldOffset, nil
		},
		Held: func(owner *playerentity.Player, _ gamemailbox.Attachment) int64 {
			mailboxTestChestHeldReads.Add(1)
			return owner.WalletComp().Balance() + mailboxTestChestHeldOffset
		},
	})
}

// 测试替身自己带一份，不借用别的模块的测试文件：那些文件归工程所有，可能被改。
type mailboxGetter map[int64]entity.IThreadSafeEntity

func (g mailboxGetter) Get(_ context.Context, id int64, _ entity.EntityCategory) (entity.IThreadSafeEntity, error) {
	if e := g[id]; e != nil {
		return e, nil
	}
	return nil, fmt.Errorf("missing %d", id)
}

func (g mailboxGetter) GetMany(ctx context.Context, ids []int64, cats []entity.EntityCategory) ([]entity.IThreadSafeEntity, error) {
	out := make([]entity.IThreadSafeEntity, len(ids))
	for i, id := range ids {
		e, err := g.Get(ctx, id, cats[i])
		if err != nil {
			return nil, err
		}
		out[i] = e
	}
	return out, nil
}

// mailboxCommitter 是替身提交器：不落盘，数提交次数、记下最近一次提交声明的持久性；
// reject 打开时拒绝提交，用来验证回滚。
type mailboxCommitter struct {
	reject     atomic.Bool
	commits    atomic.Int64
	durability atomic.Int32
}

func (c *mailboxCommitter) Commit(_ context.Context, record dataengine.CommitRecord) error {
	if c.reject.Load() {
		return errors.New("injected rejection")
	}
	c.commits.Add(1)
	c.durability.Store(int32(record.Durability))
	return nil
}

type mailboxFixture struct {
	engine    *nest.NestMgr
	player    *playerentity.Player
	rewards   *sender.MailboxClaimRewardSender
	committer *mailboxCommitter
	nowMilli  atomic.Int64
}

// newMailboxFixture 用替身提交器起一个 Nest，业务时钟由用例拨。
// clock.SetSource 是进程级的：一个用例里只建一个 fixture，后建的会顶掉前一个的时钟。
func newMailboxFixture(t *testing.T) *mailboxFixture {
	t.Helper()
	playerentity.RegisterEntity()
	RegisterMailboxClaimRewardNestHandlers()
	RegisterWalletGrantNestHandlers()
	f := &mailboxFixture{committer: &mailboxCommitter{}}
	f.setNow(mailboxStart)
	clock.SetSource(func() time.Time { return time.UnixMilli(f.nowMilli.Load()) })
	t.Cleanup(func() { clock.SetSource(nil) })
	id, err := entity.BuildEntityID(93001, playerentity.EntityKindPlayer)
	if err != nil {
		t.Fatal(err)
	}
	built, err := entity.BuildEntity(&entity.EntityCreateParam{IsCreate: true, Id: id, Kind: playerentity.EntityKindPlayer})
	if err != nil {
		t.Fatal(err)
	}
	f.player = built.(*playerentity.Player)
	f.engine = nest.NewEngine(nest.NestOptionWithGetter(mailboxGetter{id: built}), nest.NestOptionWithTransactionCommitter(f.committer),
		nest.NestOptionWithWorkerPools(nest.WorkerPoolConfig{Workers: 2, QueueCap: 64}, nest.WorkerPoolConfig{}, nest.WorkerPoolConfig{}))
	if err := f.engine.Start(); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := f.engine.Shutdown(context.Background()); err != nil {
			t.Error(err)
		}
	})
	f.rewards = sender.NewMailboxClaimRewardSender(f.engine)
	return f
}

// setNow 把业务时钟停在 unix 秒整。
func (f *mailboxFixture) setNow(unix int64) { f.nowMilli.Store(unix * 1000) }

// claim 走发放入口：邮件 mailID 带 amount 个金币，邮件自己在 expiresAtUnix 过期。
func (f *mailboxFixture) claim(mailID string, amount, expiresAtUnix int64) (gamemailbox.ClaimResult, error) {
	return f.claimAs(mailID, gamemailbox.Coins(amount), expiresAtUnix)
}

// claimAs 走发放入口：邮件 mailID 带任意一份附件。
func (f *mailboxFixture) claimAs(mailID string, attachment gamemailbox.Attachment, expiresAtUnix int64) (gamemailbox.ClaimResult, error) {
	return f.rewards.Sync_MailboxClaimReward(context.Background(), f.player.ID(), mailID, string(attachment.Type), attachment.ID, attachment.Amount, expiresAtUnix)
}

// mustPay 断言这是一次金币的首次发放，余额到 wantBalance。
func (f *mailboxFixture) mustPay(t *testing.T, mailID string, amount, expiresAtUnix, wantBalance int64) {
	t.Helper()
	result, err := f.claim(mailID, amount, expiresAtUnix)
	if err != nil {
		t.Fatalf("claim %s: %v", mailID, err)
	}
	if !result.Claimed || result.Held != wantBalance {
		t.Fatalf("claim %s = %+v, want a first grant bringing the balance to %d", mailID, result, wantBalance)
	}
}

// mailboxSnapshot 是邮件模块自己的事实：余额、账本大小、提交次数。
type mailboxSnapshot struct {
	coins   int64
	ledger  int
	commits int64
}

// snapshot 在业务 worker 上持实体锁读。
func (f *mailboxFixture) snapshot(t *testing.T) mailboxSnapshot {
	t.Helper()
	var out mailboxSnapshot
	if err := f.engine.RunLocal(context.Background(), func() {
		f.player.GetMutex().Lock()
		defer f.player.GetMutex().Unlock()
		out.coins = f.player.Dao().GetWallet().GetCoins()
		out.ledger = f.player.MailboxComp().LedgerSize()
	}); err != nil {
		t.Fatal(err)
	}
	out.commits = f.committer.commits.Load()
	return out
}

// recorded 报告邮件是否在账本里。
func (f *mailboxFixture) recorded(t *testing.T, mailID string) bool {
	t.Helper()
	var out bool
	if err := f.engine.RunLocal(context.Background(), func() {
		f.player.GetMutex().Lock()
		defer f.player.GetMutex().Unlock()
		out = f.player.MailboxComp().Claimed(mailID)
	}); err != nil {
		t.Fatal(err)
	}
	return out
}

func TestMailboxFirstClaimPaysTheCoins(t *testing.T) {
	f := newMailboxFixture(t)
	result, err := f.claim("mail-1", 100, mailboxStart+3600)
	if err != nil {
		t.Fatal(err)
	}
	if !result.Claimed || result.Held != 100 {
		t.Fatalf("first claim = %+v, want a grant of 100", result)
	}
	if got := f.snapshot(t); got.coins != 100 || got.ledger != 1 || got.commits != 1 {
		t.Fatalf("after the first claim: %+v, want 100 coins, one ledger record, one commit", got)
	}
	if !f.recorded(t, "mail-1") {
		t.Fatal("the mail id is not in the ledger: a replay would be paid again")
	}
	// 发放必须在 handler 返回之前落盘（durability=strict）：端点拿到结果后紧接着让 mail 服务把邮件标成已领，
	// 落盘之前进程崩溃就成了“邮件已领、钱没到”。
	if got := dataengine.Durability(f.committer.durability.Load()); got != dataengine.DurabilityStrict {
		t.Fatalf("the grant committed with durability %v, want strict", got)
	}
}

// 同一封邮件第二次到达——发放成功、CommitClaim 丢了之后的重试正是这样——什么也不发，回的是同样的余额。
// 没有账本判断时这里就是第二笔钱。邮件过期之后的重放同样只确认：钱早就到账了，这次到达是为了补上确认。
func TestMailboxSameMailArrivingAgainPaysNothing(t *testing.T) {
	f := newMailboxFixture(t)
	const expires = mailboxStart + 3600
	f.mustPay(t, "mail-1", 100, expires, 100)
	before := f.snapshot(t)
	for attempt, now := range []int64{mailboxStart, mailboxStart + 30, expires + 1} {
		f.setNow(now)
		result, err := f.claim("mail-1", 100, expires)
		if err != nil {
			t.Fatalf("replay %d: %v", attempt, err)
		}
		if result.Claimed || result.Held != 100 {
			t.Fatalf("replay %d = %+v, want Claimed=false with the same balance 100", attempt, result)
		}
	}
	if got := f.snapshot(t); got.coins != 100 || got.ledger != 1 {
		t.Fatalf("replays wrote: %+v, was %+v", got, before)
	}
}

func TestMailboxDifferentMailsEachPay(t *testing.T) {
	f := newMailboxFixture(t)
	f.mustPay(t, "mail-1", 100, mailboxStart+3600, 100)
	f.mustPay(t, "mail-2", 100, mailboxStart+3600, 200)
	f.mustPay(t, "mail-3", 7, mailboxStart+60, 207)
	if got := f.snapshot(t); got.coins != 207 || got.ledger != 3 {
		t.Fatalf("three mails: %+v, want 207 coins and three records", got)
	}
}

// 发放入口拒绝数量非法、没有邮件 id、没有过期时刻的请求，什么也不写。
// 没有过期时刻的记录永远清不掉，账本就不再有界，所以不收。
func TestMailboxInvalidRequestsWriteNothing(t *testing.T) {
	f := newMailboxFixture(t)
	f.mustPay(t, "mail-1", 100, mailboxStart+3600, 100)
	before := f.snapshot(t)
	for name, request := range map[string]struct {
		mailID  string
		amount  int64
		expires int64
	}{
		"zero amount":     {"mail-2", 0, mailboxStart + 3600},
		"negative amount": {"mail-2", -5, mailboxStart + 3600},
		"empty mail id":   {"", 10, mailboxStart + 3600},
		"no expiry":       {"mail-2", 10, 0},
		"negative expiry": {"mail-2", 10, -1},
	} {
		_, err := f.claim(request.mailID, request.amount, request.expires)
		if !errors.Is(err, apperrors.ErrMailboxInvalid) {
			t.Errorf("%s: err = %v, want mailbox_invalid", name, err)
		}
	}
	if got := f.snapshot(t); got != before {
		t.Fatalf("refusals wrote: %+v, was %+v", got, before)
	}
	if f.recorded(t, "mail-2") {
		t.Fatal("a refused claim left a ledger record")
	}
}

// mail 服务在 now >= 过期时刻时拒绝预留；发放入口用同一个边界，按执行时的业务时间判断。
// 预留在过期前取得、排队到过期后才执行的首次发放被拒绝，客户端拿到的码与 mail 服务拒绝过期邮件的相同。
// 业务时间是毫秒、过期时刻是秒：过期前 1 毫秒仍然放行。
func TestMailboxExpiredFirstGrantIsRefusedAtExecutionTime(t *testing.T) {
	f := newMailboxFixture(t)
	const expires = mailboxStart + 60
	const mailExpiredCode = 590106 // service/mail 的 CodeExpired
	// 窗口内：过期前 1 秒、过期前 1 毫秒都照发。
	f.nowMilli.Store((expires - 1) * 1000)
	f.mustPay(t, "a-second-before", 50, expires, 50)
	f.nowMilli.Store(expires*1000 - 1)
	f.mustPay(t, "a-millisecond-before", 50, expires, 100)
	before := f.snapshot(t)
	// 到期那一刻与之后：拒绝，什么也不写。
	for mailID, nowMilli := range map[string]int64{
		"at-the-expiry":    expires * 1000,
		"after-the-expiry": (expires + 1) * 1000,
	} {
		f.nowMilli.Store(nowMilli)
		result, err := f.claim(mailID, 50, expires)
		if err == nil {
			t.Fatalf("%s: an expired first grant was paid: %+v", mailID, result)
		}
		if code, _ := errcode.ClientError(err); code != mailExpiredCode {
			t.Fatalf("%s: code = %d, want the mail service's expired code %d: %v", mailID, code, mailExpiredCode, err)
		}
		if got := f.snapshot(t); got != before || f.recorded(t, mailID) {
			t.Fatalf("%s: the refusal wrote: %+v, was %+v", mailID, got, before)
		}
	}
}

// 账本迟早会忘掉过期的邮件；忘掉之后同一封邮件的在途旧请求（预留早于过期、执行晚于清理）不能再发一次。
// 清理与执行时准入是一对：这条用例去掉任何一半都会红。
func TestMailboxLateReplayAfterItsRecordWasPrunedIsRefused(t *testing.T) {
	f := newMailboxFixture(t)
	const expires = mailboxStart + 60
	f.mustPay(t, "old", 100, expires, 100)
	// 过期再过 10 分钟宽限之后，另一封邮件的发放顺手清掉这条记录。
	f.setNow(expires + 600)
	f.mustPay(t, "other", 5, mailboxStart+7*24*3600, 105)
	if f.recorded(t, "old") {
		t.Fatal("premise: the expired record was not pruned at the end of the grace")
	}
	before := f.snapshot(t)
	// 旧预留现在才到：账本已经不记得它，只有过期准入挡得住。
	result, err := f.claim("old", 100, expires)
	if err == nil {
		t.Fatalf("a replay whose record was pruned was paid again: %+v", result)
	}
	if got := f.snapshot(t); got != before || f.recorded(t, "old") {
		t.Fatalf("the refused replay wrote: %+v, was %+v", got, before)
	}
}

// 记录在邮件过期后还要留 10 分钟：宕机重启后 Player 可能落到业务时钟稍慢的进程上，
// 那里晚到的旧请求看到的时间还没过期、准入放行，只能靠账本还记得这封邮件。
func TestMailboxRecordOutlivesTheExpiryByTheGrace(t *testing.T) {
	f := newMailboxFixture(t)
	const expires = mailboxStart + 60
	f.mustPay(t, "old", 100, expires, 100)
	// 时钟靠前的进程：过期后、宽限结束前 1 秒有别的发放写账本，记录还在。
	f.setNow(expires + 599)
	f.mustPay(t, "other", 5, mailboxStart+7*24*3600, 105)
	if !f.recorded(t, "old") {
		t.Fatal("a record was pruned inside the grace after its mail's expiry")
	}
	// 时钟慢了 630 秒的进程执行在途的旧请求：按它的时间邮件还没过期。
	f.setNow(expires - 30)
	result, err := f.claim("old", 100, expires)
	if err != nil {
		t.Fatalf("replay on the slower clock: %v", err)
	}
	if result.Claimed || result.Held != 105 {
		t.Fatalf("a replay on a clock behind was paid again: %+v", result)
	}
	// 宽限结束：下一次首次发放把它清掉，还没过期的记录留着。
	f.setNow(expires + 600)
	f.mustPay(t, "another", 5, mailboxStart+7*24*3600, 110)
	if f.recorded(t, "old") {
		t.Fatal("a record whose mail expired a full grace ago is still held")
	}
	if !f.recorded(t, "other") || !f.recorded(t, "another") {
		t.Fatal("a record whose mail is still claimable was pruned: a replay would be paid again")
	}
	// 账本的记忆以邮件自己的过期时刻为界，不是游戏这边定的固定保留期：一封 40 天后才过期的邮件，
	// 第 39 天的重放照样不发——这期间别的发放已经把过期的记录清过了。
	const day = int64(24 * 3600)
	f.mustPay(t, "long-lived", 5, mailboxStart+40*day, 115)
	f.setNow(mailboxStart + 39*day)
	f.mustPay(t, "a-month-later", 5, mailboxStart+46*day, 120)
	if f.recorded(t, "other") || f.recorded(t, "another") {
		t.Fatal("premise: the seven-day mails' records were not pruned a month later")
	}
	replay, err := f.claim("long-lived", 5, mailboxStart+40*day)
	if err != nil || replay.Claimed || replay.Held != 120 {
		t.Fatalf("a replay on day 39 of a mail that lives 40 days = %+v, err = %v, want Claimed=false with the balance 120", replay, err)
	}
}

// 领了很多封之后账本不无限增长：每小时领一封、每封邮件 3 小时后过期，账本里始终只有还没过期满宽限的那几封。
// 清理不会让已领的邮件被重复发放：清掉的邮件重放被拒绝（已过期），还在账本里的重放不发钱。
func TestMailboxLedgerStaysBoundedAfterManyClaims(t *testing.T) {
	f := newMailboxFixture(t)
	const (
		mails    = 500
		hour     = int64(3600)
		lifetime = 3 * hour
	)
	expiry := func(i int) int64 { return mailboxStart + int64(i)*hour + lifetime }
	largest := 0
	for i := 0; i < mails; i++ {
		f.setNow(mailboxStart + int64(i)*hour)
		f.mustPay(t, fmt.Sprintf("mail-%d", i), 1, expiry(i), int64(i+1))
		if size := f.snapshot(t).ledger; size > largest {
			largest = size
		}
	}
	// 第 i 封在第 i+3 小时过期、再过 10 分钟可清理，所以第 i+4 小时的发放把它清掉：账本里最多 4 条。
	if largest != 4 {
		t.Fatalf("the ledger peaked at %d records over %d claims, want 4", largest, mails)
	}
	after := f.snapshot(t)
	if after.coins != mails || after.ledger != 4 {
		t.Fatalf("after %d claims: %+v, want %d coins and 4 records", mails, after, mails)
	}
	// 每一封都重放一遍（各带当初预留时的过期时刻）：没有一封再发钱。
	paidAgain, refused, confirmed := 0, 0, 0
	for i := 0; i < mails; i++ {
		result, err := f.claim(fmt.Sprintf("mail-%d", i), 1, expiry(i))
		switch {
		case err != nil:
			refused++
		case result.Claimed:
			paidAgain++
		default:
			confirmed++
		}
	}
	if paidAgain != 0 || confirmed != 4 || refused != mails-4 {
		t.Fatalf("replaying all %d mails: paid again %d, confirmed %d, refused %d; want 0 / 4 / %d", mails, paidAgain, confirmed, refused, mails-4)
	}
	if got := f.snapshot(t); got.coins != mails || got.ledger != 4 {
		t.Fatalf("the replays wrote: %+v, was %+v", got, after)
	}
	// 账本到过上限之后照常工作：新的一封照发。
	f.setNow(mailboxStart + mails*hour)
	f.mustPay(t, "one-more", 1, mailboxStart+mails*hour+lifetime, mails+1)
}

// 金币与账本记录在同一笔事务里：提交被拒绝时两者一起回滚（连同这一次顺手做的清理），之后同一封还能领。
func TestMailboxRejectedCommitRollsBackCoinsAndLedger(t *testing.T) {
	f := newMailboxFixture(t)
	const expires = mailboxStart + 60
	f.mustPay(t, "old", 100, expires, 100)
	f.setNow(expires + 600) // 这一次发放会顺手清掉 old
	before := f.snapshot(t)
	f.committer.reject.Store(true)
	if _, err := f.claim("new", 30, mailboxStart+7*24*3600); err == nil {
		t.Fatal("a rejected commit reported success")
	}
	f.committer.reject.Store(false)
	if got := f.snapshot(t); got != before {
		t.Fatalf("rollback left %+v, was %+v", got, before)
	}
	if f.recorded(t, "new") {
		t.Fatal("rollback left the mail in the ledger: the player would never be paid for it")
	}
	if !f.recorded(t, "old") {
		t.Fatal("rollback did not restore the record the rejected transaction pruned")
	}
	// 回滚后同一封邮件可以再领：上一次没有生效。
	f.mustPay(t, "new", 30, mailboxStart+7*24*3600, 130)
}

// 货币模块拒绝（余额溢出）时这封邮件不进账本、过期记录也不清理：玩家花掉一些之后还能领。
func TestMailboxWalletRefusalWritesNothing(t *testing.T) {
	f := newMailboxFixture(t)
	const expires = mailboxStart + 60
	f.mustPay(t, "old", 100, expires, 100)
	if _, err := sender.NewWalletGrantSender(f.engine).Sync_WalletGrant(context.Background(), f.player.ID(), "fill", math.MaxInt64-100); err != nil {
		t.Fatal(err)
	}
	f.setNow(expires + 600)
	before := f.snapshot(t)
	_, err := f.claim("new", 1, mailboxStart+7*24*3600)
	if !errors.Is(err, apperrors.ErrWalletOverflow) {
		t.Fatalf("err = %v, want wallet_overflow", err)
	}
	if got := f.snapshot(t); got != before || f.recorded(t, "new") || !f.recorded(t, "old") {
		t.Fatalf("the refusal wrote: %+v, was %+v", got, before)
	}
}

// 领取账本只落库、不下发。只断言邮件模块自己的字段：同一个 DAO 上还有别的模块的字段。
func TestMailboxLedgerIsNotSynced(t *testing.T) {
	for _, field := range db.PlayerDaoSyncFields() {
		if field.Name == "MailboxLedger" {
			t.Fatal("PlayerDao.MailboxLedger is synced: the claim ledger is server-side state")
		}
	}
}

// 这一版发不了的附件在发放入口被拒绝，什么也不写：种类没登记、没通过种类自己的校验（金币带了号、
// 宝箱号不存在）、或者种类合法但没有登记发放方式。端点解码时已经挡过一遍；这个入口也可能被别的
// 服务端代码直接调用，所以自己再判。没装 bag（没有联动）的工程里，写得完全正确的道具附件也在此列。
// 这一步排在账本之前：已到账邮件的重放带着发不了的附件，同样被拒绝。
func TestMailboxAttachmentThatCannotBeGrantedWritesNothing(t *testing.T) {
	f := newMailboxFixture(t)
	const expires = mailboxStart + 3600
	f.mustPay(t, "mail-1", 100, expires, 100)
	before := f.snapshot(t)
	mailboxTestChestGrants.Store(0)
	refused := map[string]gamemailbox.Attachment{
		"a type nobody registered":        {Type: "gem", ID: 1, Amount: 5},
		"no type":                         {Amount: 5},
		"coins with an id":                {Type: gamemailbox.TypeCoins, ID: 1001, Amount: 5},
		"refused by the type's validator": {Type: mailboxTestChest, ID: 9, Amount: 1},
		"a type with no grant":            {Type: mailboxTestVoucher, ID: 3, Amount: 2},
	}
	if !mailboxTestBagGlue {
		refused["an item without the bag glue"] = gamemailbox.Attachment{Type: "item", ID: 1001, Amount: 3}
	}
	for name, attachment := range refused {
		result, err := f.claimAs("mail-2", attachment, expires)
		if !errors.Is(err, apperrors.ErrMailboxAttachment) {
			t.Errorf("%s: %+v, err = %v, want mailbox_attachment", name, result, err)
		}
	}
	// 已在账本里的邮件带着发不了的附件重放：不确认，仍是 mailbox_attachment——附件的判断排在账本之前。
	for name, attachment := range map[string]gamemailbox.Attachment{
		"a type with no grant": {Type: mailboxTestVoucher, ID: 3, Amount: 2},
		"coins with an id":     {Type: gamemailbox.TypeCoins, ID: 1001, Amount: 100},
	} {
		if result, err := f.claimAs("mail-1", attachment, expires); !errors.Is(err, apperrors.ErrMailboxAttachment) {
			t.Errorf("a replay carrying %s = %+v, err = %v, want mailbox_attachment", name, result, err)
		}
	}
	if got := f.snapshot(t); got != before {
		t.Fatalf("refusals wrote: %+v, was %+v", got, before)
	}
	if f.recorded(t, "mail-2") {
		t.Fatal("a refused claim left a ledger record")
	}
	if mailboxTestChestGrants.Load() != 0 {
		t.Fatal("a chest the validator refused reached its Grant")
	}
	// 被拒绝的邮件没有被记成已领：换成发得了的附件，同一封照发。
	f.mustPay(t, "mail-2", 5, expires, 105)
}

// 登记了发放方式的种类走同一条路：Grant 在发放的那笔事务里恰好被调一次，账本记一条；
// 同一封再到达只读 Held、不再调 Grant，回的是这个种类此刻的持有量（不是首次发放时的那个数）；
// Grant 报错或提交被拒时，它已经写进去的东西跟着回滚，邮件不进账本、之后还能再领。
func TestMailboxRegisteredTypeIsGrantedOnceInTheClaimTransaction(t *testing.T) {
	f := newMailboxFixture(t)
	const expires = mailboxStart + 3600
	mailboxTestChestGrants.Store(0)
	mailboxTestChestHeldReads.Store(0)
	chest := func(id, amount int64) gamemailbox.Attachment {
		return gamemailbox.Attachment{Type: mailboxTestChest, ID: id, Amount: amount}
	}
	// 2 号箱 30 个：开出 60 个金币。持有量是宝箱自己报的那个数。
	result, err := f.claimAs("chest-mail", chest(2, 30), expires)
	if err != nil {
		t.Fatal(err)
	}
	if !result.Claimed || result.Held != 5060 {
		t.Fatalf("first claim = %+v, want a first grant reporting the chest's own holding 5060", result)
	}
	if got := f.snapshot(t); got.coins != 60 || got.ledger != 1 || got.commits != 1 {
		t.Fatalf("after the first claim: %+v, want 60 coins, one ledger record, one commit", got)
	}
	if grants, reads := mailboxTestChestGrants.Load(), mailboxTestChestHeldReads.Load(); grants != 1 || reads != 0 {
		t.Fatalf("the first claim called Grant %d times and Held %d times, want 1 and 0", grants, reads)
	}
	// 中间领了一封金币邮件，再重放宝箱那一封：不再发，回的是现在的持有量。
	f.mustPay(t, "coin-mail", 10, expires, 70)
	replay, err := f.claimAs("chest-mail", chest(2, 30), expires)
	if err != nil {
		t.Fatal(err)
	}
	if replay.Claimed || replay.Held != 5070 {
		t.Fatalf("replay = %+v, want Claimed=false with the chest's current holding 5070", replay)
	}
	if grants, reads := mailboxTestChestGrants.Load(), mailboxTestChestHeldReads.Load(); grants != 1 || reads != 1 {
		t.Fatalf("after the replay Grant was called %d times and Held %d times, want 1 and 1", grants, reads)
	}
	if got := f.snapshot(t); got.coins != 70 || got.ledger != 2 {
		t.Fatalf("the replay wrote: %+v, want 70 coins and two records", got)
	}
	// 3 号箱：Grant 先加了 15 个金币再报错。错误原样返回，金币与账本都回到原样。
	before := f.snapshot(t)
	if cursed, err := f.claimAs("cursed-mail", chest(3, 5), expires); !errors.Is(err, errMailboxTestChestCursed) {
		t.Fatalf("a failing Grant = %+v, err = %v, want the Grant's own error", cursed, err)
	}
	if mailboxTestChestGrants.Load() != 2 {
		t.Fatal("premise: the failing Grant was not reached")
	}
	if got := f.snapshot(t); got != before || f.recorded(t, "cursed-mail") {
		t.Fatalf("a failing Grant left writes behind: %+v, was %+v", got, before)
	}
	// 提交被拒：Grant 成功写了，整笔事务回滚；之后同一封还能领，这一次才算数。
	f.committer.reject.Store(true)
	if _, err := f.claimAs("late-mail", chest(1, 8), expires); err == nil {
		t.Fatal("a rejected commit reported success")
	}
	f.committer.reject.Store(false)
	if got := f.snapshot(t); got != before || f.recorded(t, "late-mail") {
		t.Fatalf("rollback left %+v, was %+v", got, before)
	}
	again, err := f.claimAs("late-mail", chest(1, 8), expires)
	if err != nil || !again.Claimed || again.Held != 5078 {
		t.Fatalf("claim after the rollback = %+v, err = %v, want a first grant reporting 5078", again, err)
	}
	if got := f.snapshot(t); got.coins != 78 || got.ledger != 3 {
		t.Fatalf("after the retried claim: %+v, want 78 coins and three records", got)
	}
}

// 发放方式的登记是程序结构的一部分：空名、缺 Grant 或 Held、重名、种类没在 game/mailbox 登记过，
// 都直接 panic，而且不改变已经登记的东西。
func TestMailboxRegisterGrantRefusesBadRegistrations(t *testing.T) {
	grant := playerentity.MailboxGrant{
		Grant: func(*playerentity.Player, gamemailbox.Attachment) (int64, error) { return 777, nil },
		Held:  func(*playerentity.Player, gamemailbox.Attachment) int64 { return 777 },
	}
	panics := func(register func()) (panicked bool) {
		defer func() { panicked = recover() != nil }()
		register()
		return false
	}
	for name, register := range map[string]func(){
		"empty name": func() { playerentity.RegisterMailboxGrant("", grant) },
		"no Grant": func() {
			playerentity.RegisterMailboxGrant(mailboxTestVoucher, playerentity.MailboxGrant{Held: grant.Held})
		},
		"no Held": func() {
			playerentity.RegisterMailboxGrant(mailboxTestVoucher, playerentity.MailboxGrant{Grant: grant.Grant})
		},
		"a type game/mailbox does not know": func() { playerentity.RegisterMailboxGrant("gem", grant) },
		"the built-in coins again":          func() { playerentity.RegisterMailboxGrant(gamemailbox.TypeCoins, grant) },
		"a registered grant once again":     func() { playerentity.RegisterMailboxGrant(mailboxTestChest, grant) },
	} {
		if !panics(register) {
			t.Errorf("%s: RegisterMailboxGrant did not panic", name)
		}
	}
	if !playerentity.MailboxGrantable(gamemailbox.TypeCoins) || !playerentity.MailboxGrantable(mailboxTestChest) {
		t.Fatal("a registered grant is not reported grantable")
	}
	if playerentity.MailboxGrantable(mailboxTestVoucher) || playerentity.MailboxGrantable("gem") || playerentity.MailboxGrantable("") {
		t.Fatal("a refused registration was recorded")
	}
	// 重名的登记没有顶掉内置的金币：金币邮件仍然经货币组件到账。
	f := newMailboxFixture(t)
	f.mustPay(t, "mail-1", 100, mailboxStart+3600, 100)
}
