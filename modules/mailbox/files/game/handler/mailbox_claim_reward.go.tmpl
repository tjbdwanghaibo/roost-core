package handler

import (
	"time"

	gamemailbox "{{MODULE}}/game/modules/mailbox"
	"{{MODULE}}/game/view"
)

// handlerMailboxClaimReward 把一封邮件的附件发给玩家，每封邮件至多一次。不对客户端开放：
// 由 MailboxClaim 端点在 mail 服务预留成功之后调用，mailID、附件、expiresAtUnix 都来自那次预留，
// 不来自客户端请求。
//
// 附件按（种类，号，数量）三个基本类型传：Nest 的参数不传结构体。attachmentType 是 gamemailbox.Type 的值
// （"coins"、"item"……），attachmentID 是种类内部的号（金币为 0）。
//
// nowUnixMilli 由 Nest 填这条消息冻结的业务时间——是发放执行的时刻，不是端点排队之前读的时刻。
// 过期准入必须用它：预留在过期前取得、排队到过期后才执行的请求，要按执行时刻判断。
// 邮件的过期时刻是 Unix 秒，这里按 mail 服务同样的取整（向下取到秒）换算后再比较。
// 规则本身见 game/components/mailbox 的 Component.Claim。
//
// durability=pipelined（维护者 2026-11-18）：回复在这笔记录 fsync 之后（实体锁在入队后先放），端点随即让 mail 服务
// CommitClaim。用缺省 async 的话回复只说明写进了 WAL 文件，整机掉电会丢掉已回复的发放而邮件已标成已领：
// 附件没到账、账本里也没有这封，没人会补发。
//
//roost:nest rollback=undo durability=pipelined
func handlerMailboxClaimReward(target view.IMailboxEntity, mailID string, attachmentType string, attachmentID int64, amount int64, expiresAtUnix int64, nowUnixMilli int64) (gamemailbox.ClaimResult, error) {
	attachment := gamemailbox.Attachment{Type: gamemailbox.Type(attachmentType), ID: attachmentID, Amount: amount}
	return target.Mailbox().Claim(mailID, attachment, expiresAtUnix, time.UnixMilli(nowUnixMilli).Unix())
}
