// Package mailbox 是邮件附件在本工程这一侧的约定：附件的字节是什么意思、有哪些种类，以及“这封邮件发过没有”
// 这件事可以记多久。mail 托管服务把附件当作不透明字节、保证每封只交付一次预留；字节里是什么奖励由游戏决定，
// 所以发件方（GM、活动、别的功能给玩家发奖励邮件）与领取方（MailboxClaim 端点）共用这个包，不各写一份。
//
// 附件的种类是一个登记点：金币内置，别的种类（道具……）由提供它的功能在自己的文件里用 init 登记
// （RegisterType）。这里只管“这样的附件合不合法”；“怎么发到玩家身上”登记在 Player 实体包
// （RegisterMailboxGrant），因为这个包不能认识实体。
//
// 发件方的标准写法是 SendTo（mailbox_send.go）：给一名玩家发一封带附件的邮件，附件先校验、幂等键必填。
//
// 除了 SendTo 那一次对 mail 服务的调用，这里只有纯函数，不读时钟、不碰实体，不 import 任何 controller 或实体包：
// 端点、Player 上的 Mailbox 组件、别的功能与测试都可以 import 它而不成环。
package mailbox

import (
	"{{MODULE}}/game/view"
	"bytes"
	"encoding/json"
	"fmt"
	"io"
	"sync"
)

// Type 是 view.MailboxAttachmentType（定义在 game/view，附件 MailboxAttachment 的字段要它）；种类常量留在这里。
type Type = view.MailboxAttachmentType

// TypeCoins 是货币附件：Amount 个金币，经货币模块到账。它是内置的种类，ID 必须为 0。
const TypeCoins Type = "coins"

// Attachment 是 view.MailboxAttachment（结构体定义在 game/view，这里留同名别名，组件与 handler 的写法不变）。
type Attachment = view.MailboxAttachment

// Coins 是 amount 个金币的附件，给发件方用：mailbox.SendTo(ctx, mailer, mailbox.Letter{..., Attachment: mailbox.Coins(100)})。
func Coins(amount int64) Attachment { return Attachment{Type: TypeCoins, Amount: amount} }

// Validator 判断一份本种类的附件合不合法，不合法时返回原因。它拿到的附件种类已经是登记的那个、
// 数量已经为正（这两条对所有种类成立，由 Validate 先判）；号的规则完全由它决定。
//
// 它必须是纯函数：发件方编码、列表、领取端点、发放事务都会调它，同一份附件每次的回答要一样。
// 所以不要在里面读配置表这类会变的数据——“这个道具号今天还在不在表里”留给发放的那一步去拒绝。
type Validator func(attachment Attachment) error

var (
	typesMu sync.RWMutex
	// types 是登记过的种类。金币内置；其余在各自文件的 init 里经 RegisterType 加进来。
	types = map[Type]Validator{TypeCoins: validateCoins}
)

// RegisterType 登记一种附件。只在 init 里调用：有哪些种类是程序结构的一部分，之后只读。
// 空名、nil、重名是写错了，直接 panic，不留到某封邮件领不了才发现。
//
// 登记只让这种附件“解得出来”。要能领，还要在 Player 实体包登记它的发放方式（RegisterMailboxGrant）；
// 只登记了这一半的种类，列表里不可领，领取答 mailbox_attachment、邮件保持未领。
func RegisterType(kind Type, validate Validator) {
	if kind == "" || validate == nil {
		panic("mailbox: RegisterType needs a type name and a validator")
	}
	typesMu.Lock()
	defer typesMu.Unlock()
	if _, taken := types[kind]; taken {
		panic(fmt.Sprintf("mailbox: attachment type %q is registered twice", kind))
	}
	types[kind] = validate
}

// Registered 报告这个种类登记过没有。
func Registered(kind Type) bool {
	typesMu.RLock()
	defer typesMu.RUnlock()
	_, known := types[kind]
	return known
}

// Validate 报告这份附件能不能作为奖励发放：种类登记过、数量为正、并且通过这个种类自己的校验。
// Encode、Decode 与发放入口（MailboxComponent.Claim）用的是同一个判断。
// 没登记的种类一律拒绝——包括别的进程版本认识、而这个进程没装对应功能的种类。
func Validate(attachment Attachment) error {
	typesMu.RLock()
	validate, known := types[attachment.Type]
	typesMu.RUnlock()
	if !known {
		return fmt.Errorf("mailbox: attachment type %q is not one this version can grant", attachment.Type)
	}
	if attachment.Amount <= 0 {
		return fmt.Errorf("mailbox: an amount of %d is not a grantable reward", attachment.Amount)
	}
	return validate(attachment)
}

// validateCoins 是金币的校验：金币没有号。带了号的金币附件不知道发件方想表达什么，不猜。
func validateCoins(attachment Attachment) error {
	if attachment.ID != 0 {
		return fmt.Errorf("mailbox: coins carry no id, got %d", attachment.ID)
	}
	return nil
}

// Encode 把附件编码成交给 mail 服务的字节（SendRequest.Attachment）。发不出去的附件在这里就拒绝，
// 不让一封领不了的邮件进玩家的邮箱。
func Encode(attachment Attachment) ([]byte, error) {
	if err := Validate(attachment); err != nil {
		return nil, err
	}
	return json.Marshal(attachment)
}

// Decode 解析附件字节。凡是这一版不能完整发放的都拒绝，绝不发一部分：
//
//   - 不是 JSON 对象、对象后面还有多余内容；
//   - 种类没登记（新版本发出的附件落到旧进程上，或者提供这个种类的功能没装）；
//   - 带有这一版不认识的字段（“金币外加别的东西”不能只发金币就把邮件标成已领）；
//   - 数量不是正数，或者没通过这个种类自己的校验（金币带了号、道具没有号……）。
//
// 被拒绝的附件怎么处理由领取端点决定：归还预留（CancelClaim）、答 mailbox_attachment，
// 邮件留在邮箱里保持未领——认识它的版本上线后还能领，而不是被旧进程吞掉。
func Decode(raw []byte) (Attachment, error) {
	decoder := json.NewDecoder(bytes.NewReader(raw))
	decoder.DisallowUnknownFields()
	var attachment Attachment
	if err := decoder.Decode(&attachment); err != nil {
		return Attachment{}, fmt.Errorf("mailbox: attachment is not a reward: %w", err)
	}
	if _, err := decoder.Token(); err != io.EOF {
		return Attachment{}, fmt.Errorf("mailbox: attachment has trailing data")
	}
	if err := Validate(attachment); err != nil {
		return Attachment{}, err
	}
	return attachment, nil
}

// ClaimResult 是 view.MailboxClaimResult（结构体定义在 game/view，这里留同名别名，组件与 handler 的写法不变）。
type ClaimResult = view.MailboxClaimResult

// ClaimWindowClosed 报告：过期时刻为 expiresAtUnix 的邮件，在 nowUnix 是否已经不能首次发放。
// 它是发放入口（MailboxComponent.Claim）的准入判断，边界与 mail 服务自己的一致
// （Envelope.Expired：nowUnix >= 过期时刻），所以“mail 服务不再给出新预留”与“游戏拒绝首次发放”是同一刻。
//
// mail 服务已经拒绝过期邮件的预留，游戏为什么还要判一次：过期之前取得的预留可能晚到（Nest 排队、
// Player 冷加载、重试）。如果它是一封已到账邮件的重放，而账本这时已经把这封邮件忘了，
// 只有这个判断能挡住第二次发放。所以它必须用发放**执行时**的业务时间，不能用调用方排队之前读的时间。
//
// 没有过期时刻（<= 0）的邮件无法放到时间轴上，这里不算关闭；发放入口另行拒绝这种请求（见 Claim）。
func ClaimWindowClosed(expiresAtUnix, nowUnix int64) bool {
	return expiresAtUnix > 0 && nowUnix >= expiresAtUnix
}

// LedgerPruneGraceSeconds 是邮件过期之后，账本还要记住“这封到过账”多久。
//
// 忘掉一条记录是安全的，当且仅当此后每一次到达账本的发放都会被 ClaimWindowClosed 拒绝。
// 在同一个进程上，这个时刻就是过期时刻。跨进程不是：宕机重启后 Player 可能落到业务时钟稍慢的进程上
// （App 允许进程启动时比部署的业务时间高水位慢 1 分钟），在那里晚到的重放还看得到窗口开着，
// 只能靠账本还记得。所以记录比准入多留这个时间差的若干倍。调大只是多留一会儿；
// 调到小于进程间的时钟差，重复发放的口子就重新打开。
const LedgerPruneGraceSeconds int64 = 10 * 60

// LedgerMayForget 报告：一条已到账的记录（邮件过期时刻 expiresAtUnix）在 nowUnix 能否从账本里清掉。
// 它就是准入判断往后挪 LedgerPruneGraceSeconds——用一个定义另一个正是全部的论证：
// 一条记录只有在这封邮件的首次发放一定被拒绝之后才会消失，哪怕换到慢这么多的时钟上。
//
// 账本的记忆以**邮件自己的过期时刻**为界（mail 服务随预留交回的 Claim.ExpiresAtUnix），
// 不以游戏这边自定的固定保留期为界：固定保留期要靠“它比 mail.send_ttl 长”来论证，而 send_ttl 是
// 另一个服务的配置，只要求为正，部署把邮件保留期调长是合法的，那时账本就会在邮件还能领的时候把它忘掉。
// 资产正确性不能绑在别的服务的配置上，只能绑在那个服务给出的权威时刻上，并在发放执行的地方判断。
// 同理，不能因为一次 CommitClaim 成功就删掉记录：确认之后同一预留的晚到重放仍可能到达。
//
// 没有过期时刻的记录不会被清掉（往不忘的方向错是安全的）；发放入口不会写出这种记录。
func LedgerMayForget(expiresAtUnix, nowUnix int64) bool {
	return ClaimWindowClosed(expiresAtUnix, nowUnix-LedgerPruneGraceSeconds)
}
