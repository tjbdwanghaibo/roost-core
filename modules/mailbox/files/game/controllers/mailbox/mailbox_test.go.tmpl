// 端点的三步串接在这里离线跑通：mail 服务是真实的 service/mail.Service（存储换成进程内的），
// Nest 是真实的引擎加替身提交器，端点收到的是与接入层相同的 playeraccess.Context。
// 没有 NATS / Redis / Mongo：跨进程的那一跳（BusClient）不在这一档里。

const (
	mailboxPlayerA int64 = 94001
	mailboxPlayerB int64 = 94002
	// mailboxEpoch 是用例的起点时刻（Unix 秒）。
	mailboxEpoch int64 = 1_800_000_000
	// mail 服务的码（service/mail 的 Code*），写死：这些是客户端协议的一部分。
	mailboxCodeExpired        int32 = 590106
	mailboxCodeAlreadyClaimed int32 = 590108
	mailboxCodeClaimHeld      int32 = 590109
	mailboxCodeRangeInvalid   int32 = 590112
)

// 测试自己登记两个种类，方式与正式的种类相同（只在 init 里；本包的 init 在 game/mailbox 与实体包之后跑）：
//
//   - mailboxTestVoucher 只登记了“合不合法”、没有登记发放方式的“券”：解得出来，但领不了。
//   - mailboxTestChest 两样都登记了：号是 1 到 3 的“宝箱”，开出 数量×号 个金币。它报的持有量故意
//     不是钱包余额（余额 + 5000），这样“回包里是这个种类自己的持有量”看得出来。
const (
	mailboxTestVoucher gamemailbox.Type = "mailbox_test_voucher"
	mailboxTestChest   gamemailbox.Type = "mailbox_test_chest"
)

// mailboxTestBagGlue 报告这个工程里有没有 mailbox 与 bag 的联动：联动自带的测试文件在 init 里把它置为 true。
// 它看的是“联动的文件在不在”，不问被测代码“道具登记了没有”——没有联动的工程里道具邮件必须领不了，
// 这件事不能因为被测代码把道具认了下来就不再检查。
var mailboxTestBagGlue bool

func init() {
	gamemailbox.RegisterType(mailboxTestVoucher, func(gamemailbox.Attachment) error { return nil })
	gamemailbox.RegisterType(mailboxTestChest, func(attachment gamemailbox.Attachment) error {
		if attachment.ID < 1 || attachment.ID > 3 {
			return fmt.Errorf("chest %d does not exist", attachment.ID)
		}
		return nil
	})
	gamemailbox.RegisterMailboxGrant(mailboxTestChest, gamemailbox.MailboxGrant{
		Grant: func(owner *playerentity.Player, attachment gamemailbox.Attachment) (int64, error) {
			balance, err := owner.WalletComp().Add(attachment.Amount * attachment.ID)
			return balance + 5000, err
		},
		Held: func(owner *playerentity.Player, _ gamemailbox.Attachment) int64 {
			return owner.WalletComp().Balance() + 5000
		},
	})
}

// mailboxEnvelopes 是进程内的信封存储（service/mail 自己的测试替身不导出）。Create 不覆盖。
type mailboxEnvelopes struct {
	mu    sync.Mutex
	items map[string]svcmail.Envelope
}

func (s *mailboxEnvelopes) Create(_ context.Context, envelope svcmail.Envelope) (bool, error) {
	s.mu.Lock()
	defer s.mu.Unlock()
	if _, exists := s.items[envelope.ID]; exists {
		return false, nil
	}
	s.items[envelope.ID] = envelope
	return true, nil
}

func (s *mailboxEnvelopes) Get(_ context.Context, id string) (svcmail.Envelope, bool, error) {
	s.mu.Lock()
	defer s.mu.Unlock()
	envelope, ok := s.items[id]
	return envelope, ok, nil
}

func (s *mailboxEnvelopes) GetMany(_ context.Context, ids []string) (map[string]svcmail.Envelope, error) {
	s.mu.Lock()
	defer s.mu.Unlock()
	out := make(map[string]svcmail.Envelope, len(ids))
	for _, id := range ids {
		if envelope, ok := s.items[id]; ok {
			out[id] = envelope
		}
	}
	return out, nil
}

// mailboxFaultyMail 在真实的 mail 服务前面注入两种故障：确认丢失（请求没到 mail 服务），
// 以及预留之后、发放之前的耽搁（afterReserve，用来把时钟拨过邮件的过期时刻）。
type mailboxFaultyMail struct {
	svcmail.Mail
	loseCommits  atomic.Int32
	afterReserve func()
}

func (m *mailboxFaultyMail) ReserveClaim(ctx context.Context, playerID int64, mailID string, scope string) (svcmail.Claim, error) {
	claim, err := m.Mail.ReserveClaim(ctx, playerID, mailID, scope)
	if err == nil && m.afterReserve != nil {
		m.afterReserve()
	}
	return claim, err
}

func (m *mailboxFaultyMail) CommitClaim(ctx context.Context, playerID int64, mailID string, token string) (svcmail.Entry, error) {
	if m.loseCommits.Load() > 0 {
		m.loseCommits.Add(-1)
		return svcmail.Entry{}, errors.New("injected: commit request lost")
	}
	return m.Mail.CommitClaim(ctx, playerID, mailID, token)
}

type mailboxEndpointGetter map[int64]entity.IThreadSafeEntity

func (g mailboxEndpointGetter) Get(_ context.Context, id int64, _ entity.EntityCategory) (entity.IThreadSafeEntity, error) {
	if e := g[id]; e != nil {
		return e, nil
	}
	return nil, fmt.Errorf("missing %d", id)
}

func (g mailboxEndpointGetter) GetMany(ctx context.Context, ids []int64, cats []entity.EntityCategory) ([]entity.IThreadSafeEntity, error) {
	out := make([]entity.IThreadSafeEntity, len(ids))
	for i, id := range ids {
		e, err := g.Get(ctx, id, cats[i])
		if err != nil {
			return nil, err
		}
		out[i] = e
	}
	return out, nil
}

// mailboxEndpointCommitter 是替身提交器：不落盘，一律接受。
type mailboxEndpointCommitter struct{}

func (mailboxEndpointCommitter) Commit(context.Context, dataengine.CommitRecord) error { return nil }

type mailboxEndpointFixture struct {
	controller *Controller
	service    *svcmail.Service
	mail       *mailboxFaultyMail
	engine     *nest.NestMgr
	player     *playerentity.Player
	nowMilli   atomic.Int64
	sends      int
}

// newMailboxEndpointFixture 起一个进程内的 mail 服务与一个 Nest，玩家 A 已进入游戏（有 Player 实体）。
// clock.SetSource 是进程级的：一个用例里只建一个 fixture。mail 服务与 Nest 读同一个业务时钟。
func newMailboxEndpointFixture(t *testing.T) *mailboxEndpointFixture {
	t.Helper()
	playerentity.RegisterEntity()
	handler.RegisterMailboxClaimRewardNestHandlers()
	handler.RegisterWalletGrantNestHandlers()
	f := &mailboxEndpointFixture{}
	f.nowMilli.Store(mailboxEpoch * 1000)
	clock.SetSource(func() time.Time { return time.UnixMilli(f.nowMilli.Load()) })
	t.Cleanup(func() { clock.SetSource(nil) })

	service, err := svcmail.New(svcmail.Config{
		Envelopes: &mailboxEnvelopes{items: map[string]svcmail.Envelope{}},
		Mailboxes: versionstore.NewMemoryStore[int64, svcmail.Mailbox](),
		Sends:     versionstore.NewMemoryStore[string, svcmail.SentRecord](),
	})
	if err != nil {
		t.Fatal(err)
	}
	f.service = service
	f.mail = &mailboxFaultyMail{Mail: service}

	id, err := entity.BuildEntityID(mailboxPlayerA, playerentity.EntityKindPlayer)
	if err != nil {
		t.Fatal(err)
	}
	built, err := entity.BuildEntity(&entity.EntityCreateParam{IsCreate: true, Id: id, Kind: playerentity.EntityKindPlayer})
	if err != nil {
		t.Fatal(err)
	}
	f.player = built.(*playerentity.Player)
	f.engine = nest.NewEngine(nest.NestOptionWithGetter(mailboxEndpointGetter{id: built}), nest.NestOptionWithTransactionCommitter(mailboxEndpointCommitter{}),
		nest.NestOptionWithWorkerPools(nest.WorkerPoolConfig{Workers: 2, QueueCap: 64}, nest.WorkerPoolConfig{}, nest.WorkerPoolConfig{}))
	if err := f.engine.Start(); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := f.engine.Shutdown(context.Background()); err != nil {
			t.Error(err)
		}
	})
	f.controller = newController(nil, f.engine, f.mail)
	return f
}

// advance 把业务时钟拨快若干秒。
func (f *mailboxEndpointFixture) advance(seconds int64) { f.nowMilli.Add(seconds * 1000) }

// send 给玩家发一封一小时后过期的邮件，返回邮件 id。
func (f *mailboxEndpointFixture) send(t *testing.T, to int64, subject string, attachment []byte) string {
	t.Helper()
	f.sends++
	envelope, err := f.service.Send(context.Background(), svcmail.SendRequest{
		Audience: svcmail.AudienceDirect, Recipients: []int64{to}, Subject: subject,
		Attachment: attachment, ExpiresInSeconds: 3600, RequestID: fmt.Sprintf("send-%d", f.sends),
	})
	if err != nil {
		t.Fatal(err)
	}
	return envelope.ID
}

