// 正常路径：列表里看到可领的金币邮件 → 领取 → 钱到账、mail 服务标成已领 → 列表不再可领；
// 已完整领过的邮件再领，答 mail 服务的“已领取”，不再发钱。
func TestMailboxClaimEndpointReservesGrantsAndCommits(t *testing.T) {
	f := newMailboxEndpointFixture(t)
	mailID := f.send(t, mailboxPlayerA, "level reward", mailboxCoins(t, 100))

	listed := f.list(t, mailboxPlayerA, "", 0)
	if listed.Code != 0 || len(listed.Mails) != 1 || listed.Unread != 1 {
		t.Fatalf("list = %+v", listed)
	}
	if got := listed.Mails[0]; got.MailID != mailID || got.Subject != "level reward" || !got.HasAttachment || !got.Claimable || got.ExpiresAtUnix != mailboxEpoch+3600 {
		t.Fatalf("listed mail = %+v", got)
	}
	// 列表与领取回包用同样的三个字段说附件是什么：种类、号（金币为 0）、数量。
	if got := listed.Mails[0]; got.AttachmentType != "coins" || got.AttachmentID != 0 || got.Amount != 100 {
		t.Fatalf("listed attachment = %+v, want 100 coins", got)
	}

	claimed := f.claim(t, mailboxPlayerA, mailID)
	if claimed.Code != 0 || claimed.AttachmentType != "coins" || claimed.AttachmentID != 0 || claimed.Amount != 100 || claimed.Held != 100 {
		t.Fatalf("claim = %+v, want 100 coins and a balance of 100", claimed)
	}
	if coins, ledger := f.wallet(t); coins != 100 || ledger != 1 {
		t.Fatalf("after the claim: coins=%d ledger=%d", coins, ledger)
	}
	if status := f.entry(t, mailboxPlayerA, mailID).Status; status != svcmail.StatusClaimed {
		t.Fatalf("the mail service holds the mail as %q, want claimed", status)
	}
	if after := f.list(t, mailboxPlayerA, "", 0); len(after.Mails) != 1 || after.Mails[0].Claimable || after.Mails[0].Status != "claimed" {
		t.Fatalf("list after the claim = %+v", after.Mails)
	}

	again := f.claim(t, mailboxPlayerA, mailID)
	if again.Code != mailboxCodeAlreadyClaimed || again.AttachmentType != "" || again.Amount != 0 || again.Held != 0 {
		t.Fatalf("second claim = %+v, want the mail service's already-claimed code", again)
	}
	if coins, _ := f.wallet(t); coins != 100 {
		t.Fatalf("a second claim changed the balance to %d", coins)
	}
}

// 三步领取留下的窗口：发放成功、CommitClaim 丢了。玩家拿到的是成功；邮件在 mail 服务那边仍是未领，
// 租约到期后重试用同一个 token 再预留一次、再来发放一次——账本认出这封邮件，不发第二笔，补上确认。
// 重试隔了很久（远超租约与账本的清理宽限、但邮件还没过期）、中间还领过别的邮件也一样：
// 账本记的是邮件自己的过期时刻，不是预留的租约。
func TestMailboxClaimEndpointRetryAfterLostCommitPaysOnce(t *testing.T) {
	f := newMailboxEndpointFixture(t)
	mailID := f.send(t, mailboxPlayerA, "level reward", mailboxCoins(t, 100))
	otherID := f.send(t, mailboxPlayerA, "another reward", mailboxCoins(t, 50))

	f.mail.loseCommits.Store(1)
	first := f.claim(t, mailboxPlayerA, mailID)
	if first.Code != 0 || first.Amount != 100 || first.Held != 100 {
		t.Fatalf("claim with a lost commit = %+v, want success: the coins are in the wallet", first)
	}
	token := f.entry(t, mailboxPlayerA, mailID).ClaimToken
	if status := f.entry(t, mailboxPlayerA, mailID).Status; status == svcmail.StatusClaimed || token == "" {
		t.Fatalf("premise: the commit was not lost (status %q, token %q)", status, token)
	}

	// 租约（30 秒）还没到期：mail 服务说有一次领取在途，端点原样转告，不发钱。
	held := f.claim(t, mailboxPlayerA, mailID)
	if held.Code != mailboxCodeClaimHeld {
		t.Fatalf("retry inside the lease = %+v, want the claim-held code", held)
	}

	// 20 分钟后（租约早已到期，邮件一小时后才过期）先领另一封——这次首次发放会顺手清理账本——再重试第一封。
	f.advance(20 * 60)
	if other := f.claim(t, mailboxPlayerA, otherID); other.Code != 0 || other.Amount != 50 || other.Held != 150 {
		t.Fatalf("claiming another mail = %+v", other)
	}
	retry := f.claim(t, mailboxPlayerA, mailID)
	if retry.Code != 0 || retry.AttachmentType != "coins" || retry.AttachmentID != 0 || retry.Amount != 100 || retry.Held != 150 {
		t.Fatalf("retry after the lease = %+v, want this mail's 100 coins reported and the balance still 150", retry)
	}
	if coins, ledger := f.wallet(t); coins != 150 || ledger != 2 {
		t.Fatalf("the retry paid again: coins=%d ledger=%d, want 150 and two records", coins, ledger)
	}
	entry := f.entry(t, mailboxPlayerA, mailID)
	if entry.Status != svcmail.StatusClaimed {
		t.Fatalf("the retry did not commit the mail: status %q", entry.Status)
	}
	if entry.ClaimToken != token {
		t.Fatalf("the retry was reserved under another token: %q, was %q", entry.ClaimToken, token)
	}
}

// 这一版解不出来的附件：归还预留、答 mailbox_attachment，邮件保持未领、不被占用，认识它的版本上线后还能领。
// 列表里它有附件但不可领、说不出是什么。三种：种类没登记；带着不认识的字段（道具写成了别的字段名）；
// 以及没装 bag（没有联动）的工程里一份写得完全正确的道具附件——道具这个种类由联动登记，没有它就是没登记。
// 装了联动的工程里最后一种是合法的，由联动自己的用例覆盖。
func TestMailboxClaimEndpointUnknownAttachmentIsReleasedAndStaysUnclaimed(t *testing.T) {
	f := newMailboxEndpointFixture(t)
	unknown := map[string]string{
		"a type nobody registered": `{"type":"gem","id":7,"amount":1}`,
		"unknown fields":           `{"type":"item","item_id":1002,"count":1}`,
	}
	if !mailboxTestBagGlue {
		unknown["an item without the bag glue"] = `{"type":"item","id":1001,"amount":3}`
	}
	wantCode, _ := errcode.ClientError(apperrors.ErrMailboxAttachment)
	for name, raw := range unknown {
		mailID := f.send(t, mailboxPlayerA, name, []byte(raw))
		if got := f.listed(t, mailboxPlayerA, mailID); !got.HasAttachment || got.Claimable || got.AttachmentType != "" || got.AttachmentID != 0 || got.Amount != 0 {
			t.Fatalf("%s: listed mail = %+v, want an attachment that is not claimable and not described", name, got)
		}
		refused := f.claim(t, mailboxPlayerA, mailID)
		if refused.Code != wantCode || refused.AttachmentType != "" || refused.Amount != 0 || refused.Held != 0 {
			t.Fatalf("%s: claim = %+v, want mailbox_attachment (%d)", name, refused, wantCode)
		}
		if coins, ledger := f.wallet(t); coins != 0 || ledger != 0 {
			t.Fatalf("%s: the refusal wrote: coins=%d ledger=%d", name, coins, ledger)
		}
		entry := f.entry(t, mailboxPlayerA, mailID)
		if entry.Status == svcmail.StatusClaimed {
			t.Fatalf("%s: a mail whose attachment could not be granted was marked claimed", name)
		}
		if entry.ClaimDeadlineUnix != 0 {
			t.Fatalf("%s: the reservation was not released: held until %d", name, entry.ClaimDeadlineUnix)
		}
		// 没有等租约：马上就能再预留。
		if _, err := f.service.ReserveClaim(context.Background(), mailboxPlayerA, mailID, ""); err != nil {
			t.Fatalf("%s: the mail is stuck after the refusal: %v", name, err)
		}
	}
}

// 解得出来、但种类没有登记发放方式的附件：列表里说得出它是什么（种类、号、数量），但不可领；
// 领取时发放入口拒绝，端点归还预留、答 mailbox_attachment，零写入，邮件保持未领。
func TestMailboxClaimEndpointTypeWithoutAGrantIsReleasedAndStaysUnclaimed(t *testing.T) {
	f := newMailboxEndpointFixture(t)
	mailID := f.send(t, mailboxPlayerA, "a voucher", []byte(`{"type":"mailbox_test_voucher","id":3,"amount":2}`))

	got := f.listed(t, mailboxPlayerA, mailID)
	if !got.HasAttachment || got.Claimable {
		t.Fatalf("listed mail = %+v, want an attachment that is not claimable", got)
	}
	if got.AttachmentType != "mailbox_test_voucher" || got.AttachmentID != 3 || got.Amount != 2 {
		t.Fatalf("listed attachment = %+v, want 2 of voucher 3", got)
	}

	wantCode, _ := errcode.ClientError(apperrors.ErrMailboxAttachment)
	refused := f.claim(t, mailboxPlayerA, mailID)
	if refused.Code != wantCode || refused.AttachmentType != "" || refused.Amount != 0 || refused.Held != 0 {
		t.Fatalf("claim = %+v, want mailbox_attachment (%d)", refused, wantCode)
	}
	if coins, ledger := f.wallet(t); coins != 0 || ledger != 0 {
		t.Fatalf("the refusal wrote: coins=%d ledger=%d", coins, ledger)
	}
	entry := f.entry(t, mailboxPlayerA, mailID)
	if entry.Status == svcmail.StatusClaimed || entry.ClaimDeadlineUnix != 0 {
		t.Fatalf("after the refusal the mail is %+v, want released and unclaimed", entry)
	}
	if _, err := f.service.ReserveClaim(context.Background(), mailboxPlayerA, mailID, ""); err != nil {
		t.Fatalf("the mail is stuck after the refusal: %v", err)
	}
}

// 登记了发放方式的种类经端点走同样的三步：列表里可领，说得出种类、号、数量；领取把这三样原样交给
// 发放入口，回包带回它们与这个种类自己报的持有量；确认丢失后的重试不再发，回的是此刻的持有量。
func TestMailboxClaimEndpointGrantsARegisteredType(t *testing.T) {
	f := newMailboxEndpointFixture(t)
	mailID := f.send(t, mailboxPlayerA, "a chest", []byte(`{"type":"mailbox_test_chest","id":2,"amount":30}`))
	coinMail := f.send(t, mailboxPlayerA, "pocket money", mailboxCoins(t, 10))

	got := f.listed(t, mailboxPlayerA, mailID)
	if !got.HasAttachment || !got.Claimable || got.AttachmentType != "mailbox_test_chest" || got.AttachmentID != 2 || got.Amount != 30 {
		t.Fatalf("listed mail = %+v, want claimable: 30 of chest 2", got)
	}

	// 2 号箱 30 个开出 60 个金币；确认丢了。
	f.mail.loseCommits.Store(1)
	claimed := f.claim(t, mailboxPlayerA, mailID)
	if claimed.Code != 0 || claimed.AttachmentType != "mailbox_test_chest" || claimed.AttachmentID != 2 || claimed.Amount != 30 || claimed.Held != 5060 {
		t.Fatalf("claim = %+v, want 30 of chest 2 and the chest's own holding 5060", claimed)
	}
	if coins, ledger := f.wallet(t); coins != 60 || ledger != 1 {
		t.Fatalf("after the claim: coins=%d ledger=%d, want 60 and one record", coins, ledger)
	}

	// 租约到期后先领一封金币邮件，再重试宝箱那一封：不再发，持有量是现在的。
	f.advance(60)
	if coins := f.claim(t, mailboxPlayerA, coinMail); coins.Code != 0 || coins.AttachmentType != "coins" || coins.Held != 70 {
		t.Fatalf("coin claim = %+v, want a balance of 70", coins)
	}
	retry := f.claim(t, mailboxPlayerA, mailID)
	if retry.Code != 0 || retry.AttachmentType != "mailbox_test_chest" || retry.AttachmentID != 2 || retry.Amount != 30 || retry.Held != 5070 {
		t.Fatalf("retry = %+v, want 30 of chest 2 reported and the chest's current holding 5070", retry)
	}
	if coins, ledger := f.wallet(t); coins != 70 || ledger != 2 {
		t.Fatalf("the retry granted again: coins=%d ledger=%d, want 70 and two records", coins, ledger)
	}
	if status := f.entry(t, mailboxPlayerA, mailID).Status; status != svcmail.StatusClaimed {
		t.Fatalf("the retry did not commit the mail: status %q", status)
	}
}

// 发放被拒时事务已回滚，端点归还预留并答对应的码。两种拒绝：
// 预留在过期前取得、发放排队到过期后才执行（按执行时刻拒绝，码与 mail 服务拒绝过期邮件相同）；
// 货币模块拒绝（余额溢出）——玩家花掉一些之后不用等租约就能再领。
func TestMailboxClaimEndpointRefusedGrantReleasesTheReservation(t *testing.T) {
	f := newMailboxEndpointFixture(t)
	late := f.send(t, mailboxPlayerA, "expires while queued", mailboxCoins(t, 100))
	f.mail.afterReserve = func() { f.advance(3600) } // 预留之后耽搁到邮件过期
	refused := f.claim(t, mailboxPlayerA, late)
	f.mail.afterReserve = nil
	if refused.Code != mailboxCodeExpired || refused.Amount != 0 || refused.Held != 0 {
		t.Fatalf("a grant that executed after the expiry = %+v, want the mail-expired code", refused)
	}
	if coins, ledger := f.wallet(t); coins != 0 || ledger != 0 {
		t.Fatalf("the refused grant wrote: coins=%d ledger=%d", coins, ledger)
	}
	if entry := f.entry(t, mailboxPlayerA, late); entry.ClaimDeadlineUnix != 0 || entry.Status == svcmail.StatusClaimed {
		t.Fatalf("after the refused grant the mail is %+v, want released and unclaimed", entry)
	}

	if _, err := sender.NewWalletGrantSender(f.engine).Sync_WalletGrant(context.Background(), f.player.ID(), "fill", math.MaxInt64); err != nil {
		t.Fatal(err)
	}
	full := f.send(t, mailboxPlayerA, "wallet is full", mailboxCoins(t, 1))
	wantCode, _ := errcode.ClientError(apperrors.ErrWalletOverflow)
	overflow := f.claim(t, mailboxPlayerA, full)
	if overflow.Code != wantCode {
		t.Fatalf("claim into a full wallet = %+v, want wallet_overflow (%d)", overflow, wantCode)
	}
	if coins, ledger := f.wallet(t); coins != math.MaxInt64 || ledger != 0 {
		t.Fatalf("the refused grant wrote: coins=%d ledger=%d", coins, ledger)
	}
	if entry := f.entry(t, mailboxPlayerA, full); entry.ClaimDeadlineUnix != 0 || entry.Status == svcmail.StatusClaimed {
		t.Fatalf("after the refused grant the mail is %+v, want released and unclaimed", entry)
	}
}

// 列表只有调用者自己的邮件，新的在前，按游标翻页；没有附件的邮件不可领；非法的页大小由 mail 服务拒绝。
func TestMailboxListEndpointPagesOnlyTheCallersMail(t *testing.T) {
	f := newMailboxEndpointFixture(t)
	first := f.send(t, mailboxPlayerA, "first", mailboxCoins(t, 10))
	f.advance(1)
	second := f.send(t, mailboxPlayerA, "second", nil)
	f.advance(1)
	third := f.send(t, mailboxPlayerA, "third", mailboxCoins(t, 30))
	other := f.send(t, mailboxPlayerB, "for someone else", mailboxCoins(t, 999))

	page := f.list(t, mailboxPlayerA, "", 2)
	if page.Code != 0 || len(page.Mails) != 2 || page.Unread != 3 || page.NextCursor == "" {
		t.Fatalf("first page = %+v", page)
	}
	if page.Mails[0].MailID != third || page.Mails[1].MailID != second {
		t.Fatalf("first page is not newest first: %+v", page.Mails)
	}
	if plain := page.Mails[1]; plain.HasAttachment || plain.Claimable || plain.AttachmentType != "" || plain.Amount != 0 {
		t.Fatalf("a mail without an attachment = %+v", plain)
	}
	if rich := page.Mails[0]; !rich.Claimable || rich.AttachmentType != "coins" || rich.Amount != 30 {
		t.Fatalf("a coin mail = %+v", rich)
	}
	rest := f.list(t, mailboxPlayerA, page.NextCursor, 2)
	if len(rest.Mails) != 1 || rest.Mails[0].MailID != first || rest.NextCursor != "" {
		t.Fatalf("second page = %+v", rest)
	}
	for _, mail := range append(page.Mails, rest.Mails...) {
		if mail.MailID == other {
			t.Fatal("another player's mail is in the list")
		}
	}
	if theirs := f.list(t, mailboxPlayerB, "", 0); len(theirs.Mails) != 1 || theirs.Mails[0].MailID != other {
		t.Fatalf("player B's list = %+v", theirs.Mails)
	}
	// 别人的邮件也领不了：预留按认证玩家判断归属。
	if stolen := f.claim(t, mailboxPlayerA, other); stolen.Code == 0 {
		t.Fatalf("player A claimed player B's mail: %+v", stolen)
	}
	if coins, _ := f.wallet(t); coins != 0 {
		t.Fatalf("claiming another player's mail paid %d coins", coins)
	}
	if bad := f.list(t, mailboxPlayerA, "", -1); bad.Code != mailboxCodeRangeInvalid || len(bad.Mails) != 0 {
		t.Fatalf("a negative limit = %+v, want the mail service's range code", bad)
	}
}

// 发件方的标准写法（gamemailbox.SendTo）与领取这一头接得上：发出去的信在收件人的列表里可领、领得到；
// 同一件事重发（同一个幂等键）不产生第二封，哪怕第一封已经领过——否则每次重试就是多发一份奖励。
// 换一个幂等键才是另一封。
func TestMailboxSendToLetterIsListedClaimedAndNeverSentTwice(t *testing.T) {
	f := newMailboxEndpointFixture(t)
	ctx := context.Background()
	letter := gamemailbox.Letter{
		To: mailboxPlayerA, Subject: "Race 7: rank 1", Body: "You finished first.",
		Attachment: gamemailbox.Coins(300), ExpiresInSeconds: 2 * 3600, RequestID: "activity:7:94001",
	}
	envelope, err := gamemailbox.SendTo(ctx, f.service, letter)
	if err != nil {
		t.Fatal(err)
	}
	listed := f.listed(t, mailboxPlayerA, envelope.ID)
	if listed.Subject != "Race 7: rank 1" || listed.Body != "You finished first." || !listed.Claimable || listed.ExpiresAtUnix != mailboxEpoch+2*3600 {
		t.Fatalf("listed = %+v", listed)
	}
	if listed.AttachmentType != "coins" || listed.Amount != 300 {
		t.Fatalf("listed attachment = %+v, want 300 coins", listed)
	}
	// 别的玩家的邮箱里没有它。
	if other := f.list(t, mailboxPlayerB, "", 0); len(other.Mails) != 0 {
		t.Fatalf("a direct letter reached another player: %+v", other.Mails)
	}
	// 领之前重发：还是那一封。
	if again, err := gamemailbox.SendTo(ctx, f.service, letter); err != nil || again.ID != envelope.ID {
		t.Fatalf("resend = %+v (%v), want the first mail %s", again, err, envelope.ID)
	}
	if claimed := f.claim(t, mailboxPlayerA, envelope.ID); claimed.Code != 0 || claimed.Amount != 300 || claimed.Held != 300 {
		t.Fatalf("claim = %+v, want 300 coins", claimed)
	}
	// 领过之后再重发（发件方的重试晚到了）：仍是那一封，列表里只有一封、已领、不可领。
	if again, err := gamemailbox.SendTo(ctx, f.service, letter); err != nil || again.ID != envelope.ID {
		t.Fatalf("resend after the claim = %+v (%v), want the first mail %s", again, err, envelope.ID)
	}
	after := f.list(t, mailboxPlayerA, "", 0)
	if len(after.Mails) != 1 || after.Mails[0].Claimable || after.Mails[0].Status != "claimed" {
		t.Fatalf("list after the resends = %+v, want the one claimed mail", after.Mails)
	}
	if coins, ledger := f.wallet(t); coins != 300 || ledger != 1 {
		t.Fatalf("the resends paid again: coins=%d ledger=%d", coins, ledger)
	}
	// 另一件事（另一个键）是另一封。
	letter.RequestID = "activity:8:94001"
	next, err := gamemailbox.SendTo(ctx, f.service, letter)
	if err != nil || next.ID == envelope.ID {
		t.Fatalf("a letter under another request id = %+v (%v), want a second mail", next, err)
	}
	if claimed := f.claim(t, mailboxPlayerA, next.ID); claimed.Code != 0 || claimed.Held != 600 {
		t.Fatalf("claim of the second mail = %+v, want the balance at 600", claimed)
	}
}
