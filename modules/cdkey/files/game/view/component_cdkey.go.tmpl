package view

import "fmt"

// Cdkey 是 Cdkey 组件对 game/ 下其它包公开的方法（实现在 game/components/cdkey，语义见那里）；只在宿主被 Nest 锁住期间调用。
type Cdkey interface {
	Prepare(raw string, nowUnixMilli int64) (CdkeyIntent, error)
	Complete(code, mailID string) (CdkeyIntent, error)
}

// CdkeyHolder 是“带有 Cdkey 组件”的小接口：只要这个组件的组件包、钩子与联动收它；实体接口（entity_<实体>.go，生成）嵌入它。
type CdkeyHolder interface{ Cdkey() Cdkey }

// CdkeyIntent 是兑换码的持久意图：码、模式（once 全服一次 / 每人一次）、奖励与邮件内容；Prepare 记下，Complete 发完后返回。
type CdkeyIntent struct {
	Code             string
	Mode             string
	Coins            int64
	Subject          string
	Body             string
	ExpiresInSeconds int64
	MailID           string
}

// ClaimKey 对同一码永久稳定。所有 game sid 必须使用同一 directory 命名空间，不能释放这些键。
func (intent CdkeyIntent) ClaimKey(playerID int64) string {
	if intent.Mode == "once" {
		return "cdkey:once:" + intent.Code
	}
	return fmt.Sprintf("cdkey:player:%d:%s", playerID, intent.Code)
}

// RequestID 同一玩家同一码永不改变；即使发件超时或进程重启，mail 服务仍恢复同一封邮件。
func (intent CdkeyIntent) RequestID(playerID int64) string {
	return fmt.Sprintf("cdkey:reward:%d:%s", playerID, intent.Code)
}
