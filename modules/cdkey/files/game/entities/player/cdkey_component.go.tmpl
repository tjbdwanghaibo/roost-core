package player

import (
	"{{MODULE}}/game/components/cdkey"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:Cdkey}}
const CompTypeCdkey entity.ComponentType = {{ID:component:Cdkey}}

// CdkeyComponent 是 game/components/cdkey 的组件在 Player 上的名字（生成接线与 handler 用它）；业务在那个包里。
type CdkeyComponent = cdkey.Component

type ICdkeyEntity interface {
	entity.IThreadSafeEntity
	CdkeyComp() *CdkeyComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeCdkey, cdkey.NewComponent)
}
