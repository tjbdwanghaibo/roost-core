package player

import (
	"{{MODULE}}/game/components/friends"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:Friends}}
const CompTypeFriends entity.ComponentType = {{ID:component:Friends}}

// FriendsComponent 是 game/components/friends 的组件在 Player 上的名字（生成接线与 handler 用它）；业务在那个包里。
type FriendsComponent = friends.Component

type IFriendsEntity interface {
	entity.IThreadSafeEntity
	FriendsComp() *FriendsComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeFriends, friends.NewComponent)
}
