package controllers

import (
	"fmt"
	"log/slog"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/infra/base/errcode"
	"github.com/tjbdwanghaibo/roost-core/infra/network/playeraccess"
	gamefriends "{{MODULE}}/game/components/friends"
	player "{{MODULE}}/game/entities/player"
	syncsender "{{MODULE}}/game/handler/syncsender"
	apperrors "{{MODULE}}/internal/errors"
	"{{MODULE}}/protocol/pb"
)

// HandleFriendsChange 的操作者只取已认证连接；按动作决定要不要对方在场（见 friendsChange）。
func (c *Controller) HandleFriendsChange(ctx *playeraccess.Context, req *pb.FriendsChangeRequest) (*pb.FriendsChangeResponse, error) {
	if ctx == nil || req == nil {
		return nil, fmt.Errorf("friends: context and request required")
	}
	err := c.friendsChange(ctx, req)
	out := &pb.FriendsChangeResponse{}
	if err != nil {
		out.Code, out.Reason = errcode.ClientError(err)
		if out.Code == errcode.CodeInternal {
			slog.ErrorContext(ctx.Context(), "friends: change failed", "player_id", ctx.PlayerID, "peer_id", req.PeerID, "err", err)
		}
	} else {
		slog.InfoContext(ctx.Context(), "friends: change completed", "player_id", ctx.PlayerID, "peer_id", req.PeerID, "action", req.Action)
	}
	return out, nil
}

// friendsChange 把拒绝申请、取消拉黑作为只改本人的单实体事务。
// 其余动作修改双边关系，要求双方在本进程有认证会话；不能因删除/拉黑就绕过归属检查冷加载对方档案。
// 离线、跨服关系需要独立的关系权威或归属路由，此模块不创建另一份 Player 来替代它。
func (c *Controller) friendsChange(ctx *playeraccess.Context, req *pb.FriendsChangeRequest) error {
	actor, err := entity.BuildEntityID(ctx.PlayerID, player.EntityKindPlayer)
	if err != nil {
		return err
	}
	peer, err := entity.BuildEntityID(req.PeerID, player.EntityKindPlayer)
	if err != nil {
		return err
	}
	switch req.Action {
	case gamefriends.FriendsReject, gamefriends.FriendsUnblock:
		return syncsender.NewFriendsOwnSender(c.nestClient).Sync_FriendsOwn(ctx.Context(), actor, peer, req.Action)
	}
	// ActiveSessions 来自本进程的已认证 TCP 会话，不信任客户端声称的 sid。
	transport, err := LookupPlayerTransport[interface{ ActiveSessions(int64) int }](c.registry)
	if err != nil || transport == nil || transport.ActiveSessions(ctx.PlayerID) == 0 || transport.ActiveSessions(req.PeerID) == 0 {
		return apperrors.ErrFriendsInvalid
	}
	return syncsender.NewFriendsChangeSender(c.nestClient).MultiSync_FriendsChange(ctx.Context(), actor, peer, req.Action)
}

func (c *Controller) HandleFriendsList(ctx *playeraccess.Context, req *pb.FriendsListRequest) (*pb.FriendsListResponse, error) {
	if ctx == nil || req == nil {
		return nil, fmt.Errorf("friends: context and request required")
	}
	id, err := entity.BuildEntityID(ctx.PlayerID, player.EntityKindPlayer)
	out := &pb.FriendsListResponse{}
	if err == nil {
		var s gamefriends.FriendsSnapshot
		s, err = syncsender.NewFriendsListSender(c.nestClient).Sync_FriendsList(ctx.Context(), id)
		out.Peers, out.Incoming, out.Blocked = s.Peers, s.Incoming, s.Blocked
	}
	if err != nil {
		out.Code, out.Reason = errcode.ClientError(err)
		if out.Code == errcode.CodeInternal {
			slog.ErrorContext(ctx.Context(), "friends: list failed", "player_id", ctx.PlayerID, "err", err)
		}
	}
	return out, nil
}
