type friendsGetter map[int64]entity.IThreadSafeEntity

func (g friendsGetter) Get(_ context.Context, id int64, _ entity.EntityCategory) (entity.IThreadSafeEntity, error) {
	if v := g[id]; v != nil {
		return v, nil
	}
	return nil, fmt.Errorf("missing %d", id)
}
func (g friendsGetter) GetMany(ctx context.Context, ids []int64, cats []entity.EntityCategory) ([]entity.IThreadSafeEntity, error) {
	out := make([]entity.IThreadSafeEntity, len(ids))
	for i, id := range ids {
		v, e := g.Get(ctx, id, cats[i])
		if e != nil {
			return nil, e
		}
		out[i] = v
	}
	return out, nil
}

type friendsCommitter struct {
	reject  atomic.Bool
	commits atomic.Int64
	mu      sync.Mutex
	touched []int64
}

func (c *friendsCommitter) Commit(_ context.Context, record dataengine.CommitRecord) error {
	if c.reject.Load() {
		return errors.New("injected commit rejection")
	}
	c.commits.Add(1)
	c.mu.Lock()
	c.touched = c.touched[:0]
	for _, mutation := range record.Mutations {
		c.touched = append(c.touched, mutation.Key.ID)
	}
	c.mu.Unlock()
	return nil
}

// lastTouched 是最近一笔提交写到的实体号（升序、去重；一个实体可以有不止一份 DAO）：用来断言“这笔事务没有写对方的档”。
func (c *friendsCommitter) lastTouched() []int64 {
	c.mu.Lock()
	defer c.mu.Unlock()
	out := slices.Clone(c.touched)
	slices.Sort(out)
	return slices.Compact(out)
}

type friendsFixture struct {
	engine  *nest.NestMgr
	getter  friendsGetter
	players []*player.Player
	commit  *friendsCommitter
	changes *syncsender.FriendsChangeSender
	lists   *syncsender.FriendsListSender
}

func newFriendsFixture(t *testing.T, n int) *friendsFixture {
	t.Helper()
	player.RegisterEntity()
	RegisterFriendsChangeNestHandlers()
	RegisterFriendsOwnNestHandlers()
	RegisterFriendsListNestHandlers()
	g := friendsGetter{}
	f := &friendsFixture{commit: &friendsCommitter{}, getter: g}
	for i := 0; i < n; i++ {
		id, e := entity.BuildEntityID(int64(98000+i), player.EntityKindPlayer)
		if e != nil {
			t.Fatal(e)
		}
		built, e := entity.BuildEntity(&entity.EntityCreateParam{IsCreate: true, Id: id, Kind: player.EntityKindPlayer})
		if e != nil {
			t.Fatal(e)
		}
		p := built.(*player.Player)
		f.players = append(f.players, p)
		g[id] = p
	}
	f.engine = nest.NewEngine(nest.NestOptionWithGetter(g), nest.NestOptionWithTransactionCommitter(f.commit), nest.NestOptionWithWorkerPools(nest.WorkerPoolConfig{Workers: 2, QueueCap: 64}, nest.WorkerPoolConfig{}, nest.WorkerPoolConfig{}))
	if e := f.engine.Start(); e != nil {
		t.Fatal(e)
	}
	t.Cleanup(func() {
		if e := f.engine.Shutdown(context.Background()); e != nil {
			t.Error(e)
		}
	})
	f.changes = syncsender.NewFriendsChangeSender(f.engine)
	f.lists = syncsender.NewFriendsListSender(f.engine)
	return f
}
func (f *friendsFixture) change(a, b int, action int32) error {
	return f.changes.MultiSync_FriendsChange(context.Background(), f.players[a].ID(), f.players[b].ID(), action)
}
func (f *friendsFixture) list(t *testing.T, i int) gamefriends.FriendsSnapshot {
	t.Helper()
	v, e := f.lists.Sync_FriendsList(context.Background(), f.players[i].ID())
	if e != nil {
		t.Fatal(e)
	}
	return v
}
func (f *friendsFixture) must(t *testing.T, a, b int, action int32) {
	t.Helper()
	if e := f.change(a, b, action); e != nil {
		t.Fatal(e)
	}
}
func TestFriendsApplyIsIdempotent(t *testing.T) {
	f := newFriendsFixture(t, 2)
	f.must(t, 0, 1, gamefriends.FriendsApply)
	f.must(t, 0, 1, gamefriends.FriendsApply)
	a, b := f.list(t, 0), f.list(t, 1)
	if len(a.Incoming) != 0 || len(b.Incoming) != 1 || b.Incoming[0] != 98000 || f.commit.commits.Load() != 1 {
		t.Fatalf("a=%+v b=%+v commits=%d", a, b, f.commit.commits.Load())
	}
}
func TestFriendsAcceptWritesBothAndClearsCrossedApplications(t *testing.T) {
	f := newFriendsFixture(t, 2)
	f.must(t, 0, 1, gamefriends.FriendsApply)
	f.must(t, 1, 0, gamefriends.FriendsApply)
	f.must(t, 1, 0, gamefriends.FriendsAccept)
	before := f.commit.commits.Load()
	f.must(t, 0, 1, gamefriends.FriendsAccept)
	a, b := f.list(t, 0), f.list(t, 1)
	if len(a.Peers) != 1 || a.Peers[0] != 98001 || len(b.Peers) != 1 || b.Peers[0] != 98000 || len(a.Incoming) != 0 || len(b.Incoming) != 0 || f.commit.commits.Load() != before {
		t.Fatalf("a=%+v b=%+v", a, b)
	}
}
func TestFriendsAcceptRequiresAnApplication(t *testing.T) {
	f := newFriendsFixture(t, 2)
	if e := f.change(0, 1, gamefriends.FriendsAccept); !errors.Is(e, apperrors.ErrFriendsApplicationMissing) {
		t.Fatal(e)
	}
	if f.commit.commits.Load() != 0 {
		t.Fatal("refusal wrote")
	}
}
func TestFriendsRemoveIsSymmetric(t *testing.T) {
	f := newFriendsFixture(t, 2)
	f.must(t, 0, 1, gamefriends.FriendsApply)
	f.must(t, 1, 0, gamefriends.FriendsAccept)
	f.must(t, 0, 1, gamefriends.FriendsRemove)
	if len(f.list(t, 0).Peers) != 0 || len(f.list(t, 1).Peers) != 0 {
		t.Fatal("one-sided removal")
	}
}
func TestFriendsBlockRemovesFriendshipAndDeniesEitherDirection(t *testing.T) {
	f := newFriendsFixture(t, 2)
	f.must(t, 0, 1, gamefriends.FriendsApply)
	f.must(t, 1, 0, gamefriends.FriendsAccept)
	f.must(t, 0, 1, gamefriends.FriendsBlock)
	before := f.commit.commits.Load()
	for _, pair := range [][2]int{{0, 1}, {1, 0}} {
		if e := f.change(pair[0], pair[1], gamefriends.FriendsApply); !errors.Is(e, apperrors.ErrFriendsBlocked) {
			t.Fatal(e)
		}
	}
	a, b := f.list(t, 0), f.list(t, 1)
	if len(a.Blocked) != 1 || len(b.Blocked) != 0 || len(a.Peers) != 0 || len(b.Peers) != 0 || f.commit.commits.Load() != before {
		t.Fatalf("a=%+v b=%+v", a, b)
	}
}
func TestFriendsUnblockDoesNotRestoreFriendship(t *testing.T) {
	f := newFriendsFixture(t, 2)
	f.must(t, 0, 1, gamefriends.FriendsBlock)
	f.must(t, 0, 1, gamefriends.FriendsUnblock)
	if len(f.list(t, 0).Blocked) != 0 || len(f.list(t, 0).Peers) != 0 {
		t.Fatal("unblock restored data")
	}
	f.must(t, 1, 0, gamefriends.FriendsApply)
	if len(f.list(t, 0).Incoming) != 1 {
		t.Fatal("unblock still rejects")
	}
}
func TestFriendsRejectOnlyConsumesTheReceivedApplication(t *testing.T) {
	f := newFriendsFixture(t, 2)
	f.must(t, 0, 1, gamefriends.FriendsApply)
	f.must(t, 1, 0, gamefriends.FriendsApply)
	f.must(t, 1, 0, gamefriends.FriendsReject)
	if len(f.list(t, 1).Incoming) != 0 || len(f.list(t, 0).Incoming) != 1 {
		t.Fatal("reject changed wrong side")
	}
}
func TestFriendsListsAreBounded(t *testing.T) {
	f := newFriendsFixture(t, 66)
	for i := 1; i <= 64; i++ {
		f.must(t, i, 0, gamefriends.FriendsApply)
	}
	before := f.commit.commits.Load()
	if e := f.change(65, 0, gamefriends.FriendsApply); !errors.Is(e, apperrors.ErrFriendsFull) {
		t.Fatal(e)
	}
	if len(f.list(t, 0).Incoming) != 64 || f.commit.commits.Load() != before {
		t.Fatal("incoming overflow wrote")
	}
	for i := 1; i <= 64; i++ {
		f.must(t, 0, i, gamefriends.FriendsAccept)
	}
	if e := f.change(0, 65, gamefriends.FriendsApply); !errors.Is(e, apperrors.ErrFriendsFull) {
		t.Fatal(e)
	}
	for i := 1; i <= 64; i++ {
		f.must(t, 0, i, gamefriends.FriendsBlock)
	}
	before = f.commit.commits.Load()
	if e := f.change(0, 65, gamefriends.FriendsBlock); !errors.Is(e, apperrors.ErrFriendsFull) {
		t.Fatal(e)
	}
	if len(f.list(t, 0).Blocked) != 64 || f.commit.commits.Load() != before {
		t.Fatal("blocked overflow wrote")
	}
}
func TestFriendsRejectedCommitRollsBackBothPlayers(t *testing.T) {
	f := newFriendsFixture(t, 2)
	f.must(t, 0, 1, gamefriends.FriendsApply)
	f.commit.reject.Store(true)
	if e := f.change(1, 0, gamefriends.FriendsAccept); e == nil {
		t.Fatal("commit accepted")
	}
	f.commit.reject.Store(false)
	if len(f.list(t, 0).Peers) != 0 || len(f.list(t, 1).Peers) != 0 || len(f.list(t, 1).Incoming) != 1 {
		t.Fatal("partial friendship survived")
	}
	f.must(t, 1, 0, gamefriends.FriendsAccept)
}
func TestFriendsInvalidAndMissingPeerWriteNothing(t *testing.T) {
	f := newFriendsFixture(t, 2)
	if e := f.change(0, 0, gamefriends.FriendsApply); e == nil {
		t.Fatal("self accepted")
	}
	if e := f.change(0, 1, 999); !errors.Is(e, apperrors.ErrFriendsInvalid) {
		t.Fatal(e)
	}
	missing, _ := entity.BuildEntityID(99999, player.EntityKindPlayer)
	if e := f.changes.MultiSync_FriendsChange(context.Background(), f.players[0].ID(), missing, gamefriends.FriendsApply); e == nil {
		t.Fatal("missing peer accepted")
	}
	if f.commit.commits.Load() != 0 {
		t.Fatal("invalid wrote")
	}
}

// 取消拉黑、拒绝申请只锁操作者：对方的档拿不到（不在线、不在本进程）也能做，提交里只有操作者一份档；
// 这条单实体入口不接受要改对方的动作。
func TestFriendsOwnSideActionsLockOnlyTheActor(t *testing.T) {
	f := newFriendsFixture(t, 2)
	own := syncsender.NewFriendsOwnSender(f.engine)
	actor, peer := f.players[0].ID(), f.players[1].ID()
	f.must(t, 0, 1, gamefriends.FriendsBlock)
	delete(f.getter, peer)
	if e := own.Sync_FriendsOwn(context.Background(), actor, peer, gamefriends.FriendsUnblock); e != nil {
		t.Fatalf("unblock without the peer: %v", e)
	}
	if s, touched := f.list(t, 0), f.commit.lastTouched(); len(s.Blocked) != 0 || !slices.Equal(touched, []int64{actor}) {
		t.Fatalf("unblock: %+v touched=%v", s, touched)
	}
	before := f.commit.commits.Load()
	for _, action := range []int32{gamefriends.FriendsApply, gamefriends.FriendsAccept, gamefriends.FriendsRemove, gamefriends.FriendsBlock, 999} {
		if e := own.Sync_FriendsOwn(context.Background(), actor, peer, action); !errors.Is(e, apperrors.ErrFriendsInvalid) {
			t.Fatalf("own-side entry accepted action %d: %v", action, e)
		}
	}
	if e := own.Sync_FriendsOwn(context.Background(), actor, actor, gamefriends.FriendsUnblock); !errors.Is(e, apperrors.ErrFriendsInvalid) {
		t.Fatalf("own-side entry accepted self: %v", e)
	}
	if e := own.Sync_FriendsOwn(context.Background(), actor, peer, gamefriends.FriendsReject); e != nil {
		t.Fatalf("reject with nothing to reject: %v", e)
	}
	if f.commit.commits.Load() != before {
		t.Fatal("refused or empty own-side action wrote")
	}
}

// 拒绝申请走单实体入口时同样只消费自己收到的那一条，申请人的档不参与。
func TestFriendsOwnSideRejectConsumesTheReceivedApplication(t *testing.T) {
	f := newFriendsFixture(t, 2)
	actor, peer := f.players[0].ID(), f.players[1].ID()
	f.must(t, 1, 0, gamefriends.FriendsApply)
	delete(f.getter, peer)
	if e := syncsender.NewFriendsOwnSender(f.engine).Sync_FriendsOwn(context.Background(), actor, peer, gamefriends.FriendsReject); e != nil {
		t.Fatalf("reject without the applicant: %v", e)
	}
	if s, touched := f.list(t, 0), f.commit.lastTouched(); len(s.Incoming) != 0 || !slices.Equal(touched, []int64{actor}) {
		t.Fatalf("reject: %+v touched=%v", s, touched)
	}
}

// 删除、拉黑只在对方名单里确实有操作者时才写对方的档：对没有关系的玩家，删除零写入，拉黑只写操作者自己的黑名单。
func TestFriendsRemoveAndBlockLeaveUnrelatedPeerUntouched(t *testing.T) {
	f := newFriendsFixture(t, 3)
	actor := f.players[0].ID()
	// 让对方的名单非空：DAO 对“非空名单里不存在的键”的删除也会登记修改，空名单测不出来。
	f.must(t, 1, 2, gamefriends.FriendsApply)
	f.must(t, 2, 1, gamefriends.FriendsAccept)
	f.must(t, 2, 1, gamefriends.FriendsApply)
	before := f.commit.commits.Load()
	f.must(t, 0, 1, gamefriends.FriendsRemove)
	if f.commit.commits.Load() != before {
		t.Fatal("removing a stranger wrote")
	}
	f.must(t, 0, 1, gamefriends.FriendsBlock)
	if touched := f.commit.lastTouched(); f.commit.commits.Load() != before+1 || !slices.Equal(touched, []int64{actor}) {
		t.Fatalf("blocking a stranger touched %v", touched)
	}
	f.must(t, 0, 1, gamefriends.FriendsBlock)
	if f.commit.commits.Load() != before+1 {
		t.Fatal("repeated block wrote")
	}
	if b := f.list(t, 1); len(b.Peers) != 1 || b.Peers[0] != 98002 {
		t.Fatalf("unrelated peer changed: %+v", b)
	}
}
