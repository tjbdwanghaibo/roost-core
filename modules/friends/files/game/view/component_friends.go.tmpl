package view

// Friends 是 Friends 组件对 game/ 下其它包公开的方法（实现在 game/components/friends，语义见那里）；只在宿主被 Nest 锁住期间调用。
type Friends interface {
	ChangeOwnSide(peerID int64, action int32) error
	Change(peer PlayerEntity, action int32) error
	Snapshot() FriendsSnapshot
}

// FriendsHolder 是“带有 Friends 组件”的小接口：只要这个组件的组件包、钩子与联动收它；实体接口（entity_<实体>.go，生成）嵌入它。
type FriendsHolder interface{ Friends() Friends }

type FriendsSnapshot struct{ Peers, Incoming, Blocked []int64 }
