package stamina

import (
	"errors"
	"time"

	"github.com/tjbdwanghaibo/roost-core/wiring/modulehost"
)

// Config 是体力模块的配置（清单的 config:，D19 B）：上限、硬顶、恢复周期、每日补满次数与价格。键、缺省值与范围
// 只写在这里的 tag 上，跨键规则写在 ValidateConfig。安装器把它们写进业务服务的配置（configs/service/config.<服务>.yaml
// 的 stamina: 段）；生成的 bootstrap 把它接进 App 的配置声明，`--check-config` 与 `roost config check` 查得出写错的值，
// 进程启动时在任何 Mod Start 之前按它装载一次（UseConfig）。没有装载过的进程（模块场景测试）读到的是这里的缺省值。
//
// rules.go（归工程所有）把它换成一次读写用的 StaminaRules；要按等级成长或接配置表时改那里。
type Config struct {
	Max              int64         `config:"stamina.max" default:"100" min:"0" example:"100" help:"自然恢复与花金币补满能到的上限"`
	HardCap          int64         `config:"stamina.hard_cap" default:"999" min:"0" example:"999" help:"发放（Grant）能到的硬顶，不小于 max；发放超出的部分截掉"`
	RegenInterval    time.Duration `config:"stamina.regen_interval" default:"5m" min:"0" example:"5m" help:"恢复 1 点体力要的时间（整毫秒）；0 表示不自然恢复（只能靠发放与购买，新玩家的体力是 0）。客户端按同一个周期推算当前体力"`
	RefillDailyLimit int32         `config:"stamina.refill_daily_limit" default:"3" min:"0" example:"3" help:"每个业务日能花金币补满的次数；0 表示不开放购买"`
	RefillPriceStep  int64         `config:"stamina.refill_price_step" default:"50" min:"0" example:"50" help:"补满的金币价格逐次递增的步长：当日第 n 次补满花 n 倍（缺省 50、100、150）；0 表示免费"`
}

// ValidateConfig 是跨键规则：硬顶不低于上限（否则发放能到的比自然恢复还低），恢复周期是整毫秒
// （状态里的恢复时钟按毫秒记，客户端按毫秒推算）。
func (c *Config) ValidateConfig(bool) error {
	var problems []error
	if c.HardCap < c.Max {
		problems = append(problems, errors.New("config: stamina.hard_cap must not be below stamina.max"))
	}
	if c.RegenInterval%time.Millisecond != 0 {
		problems = append(problems, errors.New("config: stamina.regen_interval must be a whole number of milliseconds"))
	}
	return errors.Join(problems...)
}

// currentConfig 是当前的配置。
var currentConfig modulehost.Value[Config]

// UseConfig 换上一份配置：进程启动时由 bootstrap 调一次；测试换配置时调它，结束时换回 CurrentConfig 读到的旧值。
func UseConfig(value Config) { currentConfig.Use(value) }

// CurrentConfig 返回当前的配置。
func CurrentConfig() Config { return currentConfig.Get() }
