package player

// 这个文件是体力的规则数据：上限、硬顶、恢复速率、每日可购买的补满次数与价格。它归工程所有，
// 数值策划要改的东西都在这里，StaminaComponent 里没有别的数。
//
// 模块不带配置表，所以缺省值直接写在下面两个函数里。工程接上自己的配置表之后改这两个函数的函数体，
// 例如（configs/generated 由 roost add table 与 roost generate 产出，读的是钉在本次请求上的配置快照）：
//
//	row, _ := generated.StaminaByID(1)
//	return StaminaRules{Max: row.Max, HardCap: row.HardCap, RegenMillis: row.RegenSeconds * 1000, RefillDailyLimit: row.RefillDailyLimit}
//
// 上限随等级成长时，从同一个实体上的别的组件取等级（两个函数都是组件的方法，就是为了能读到所属玩家），
// 例如装了 profile 模块：Max: 100 + 2*int64(component.owner.ProfileComp().Level())。
//
// 改规则时要知道的三件事：
//   - 客户端按同步下来的状态自己推算当前体力（公式在 db/def/stamina.go），要用同一份上限与恢复周期；
//     服务端改了而客户端没改，客户端显示的体力就和服务端判定的不一致。
//   - 规则在每次读写时取一次，立刻对所有玩家生效，不需要迁移存档。调高上限时：原来已满的玩家恢复时钟是停着的
//     （SettledAt 为 0），按公式直接到新上限；没满的玩家照常按周期恢复。调低上限时：超出新上限的体力不扣，
//     只是不再恢复。
//   - RegenMillis 不为正表示“不自然恢复”（只能靠发放与购买）；这时新玩家的体力是 0 而不是满。

// StaminaRules 是体力的一组规则数；一次读写里只取一次，前后用同一份。
type StaminaRules struct {
	// Max 是自然恢复与购买补满能到的上限。
	Max int64
	// HardCap 是发放（Grant）能到的硬顶，应不小于 Max；发放超出它的部分截掉。
	HardCap int64
	// RegenMillis 是恢复 1 点体力要的毫秒数。
	RegenMillis int64
	// RefillDailyLimit 是每个业务日能花金币补满的次数；不为正表示不开放购买。
	RefillDailyLimit int32
}

// staminaRules 返回这名玩家当前适用的规则。缺省：上限 100、硬顶 999、每 5 分钟恢复 1 点、每天能买 3 次补满。
func (component *StaminaComponent) staminaRules() StaminaRules {
	return StaminaRules{
		Max:              100,
		HardCap:          999,
		RegenMillis:      5 * 60 * 1000,
		RefillDailyLimit: 3,
	}
}

// staminaRefillPrice 返回当日第 nth 次（从 1 起）购买补满的金币价格。缺省逐次递增：50、100、150。
// 返回值不为正表示这一次免费（例如每天第一次免费就对 nth == 1 返回 0）。
// nth 不会超过 RefillDailyLimit；价格与补多少点无关，差 1 点没满也是这个价。
func (component *StaminaComponent) staminaRefillPrice(nth int32) int64 {
	return 50 * int64(nth)
}
