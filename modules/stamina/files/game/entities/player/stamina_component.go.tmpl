package player

import (
	"{{MODULE}}/game/components/stamina"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:Stamina}}
const CompTypeStamina entity.ComponentType = {{ID:component:Stamina}}

// StaminaComponent 是 game/components/stamina 的组件在 Player 上的名字（生成接线与 handler 用它）；业务在那个包里。
type StaminaComponent = stamina.Component

// IStaminaEntity 是 Nest handler 用这个组件时的窄实体接口；getter 由生成的 Entity 接线实现。
// 别的功能在自己的 handler 里要扣体力（进关卡、扫荡）或发体力时，目标接口里嵌入它即可：
// 两个组件在同一个实体上，体力与那个功能自己的状态在同一笔事务里提交或回滚。
type IStaminaEntity interface {
	entity.IThreadSafeEntity
	StaminaComp() *StaminaComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeStamina, stamina.NewComponent)
}
