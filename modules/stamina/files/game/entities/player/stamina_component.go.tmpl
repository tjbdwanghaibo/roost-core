package player

import (
	"fmt"
	"time"

	apperrors "{{MODULE}}/internal/errors"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/infra/base/clock"
)

//roost:component type={{ID:component:Stamina}}
const CompTypeStamina entity.ComponentType = {{ID:component:Stamina}}

// StaminaComponent 是玩家体力的业务逻辑。它不保存事务会改的状态：体力在 PlayerDao.Stamina 里，
// 经生成的 setter 修改，所以回滚只有 DAO 一处；不要在这里登记 undo。
//
// 体力随业务时间恢复，做法是惰性结算：没有定时器、没有心跳，每个入口先按“距上次结算过了多久”
// 算出此刻的体力（staminaSettle），再在这个数上判断与修改。规则数（上限、恢复速率、价格）都在
// stamina_rules.go 里。
type StaminaComponent struct {
	entity.ComponentBase
	owner *Player
}

// IStaminaEntity 是 Nest handler 用这个组件时的窄实体接口；getter 由生成的 Entity 接线实现。
// 别的功能在自己的 handler 里要扣体力（进关卡、扫荡）或发体力时，目标接口里嵌入它即可：
// 两个组件在同一个实体上，体力与那个功能自己的状态在同一笔事务里提交或回滚。
type IStaminaEntity interface {
	entity.IThreadSafeEntity
	StaminaComp() *StaminaComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeStamina, func(owner any, _ *entity.EntityCreateParam) (entity.ComponentInterfaceBase, error) {
		typed, ok := owner.(*Player)
		if !ok {
			return nil, fmt.Errorf("stamina component: owner %T is not *Player", owner)
		}
		return &StaminaComponent{owner: typed}, nil
	})
}

func (component *StaminaComponent) Name() string { return "stamina" }

// Owner 只在实体存活且被 Nest 锁住期间可用。
func (component *StaminaComponent) Owner() *Player { return component.owner }

// 下面是业务方法。不要在组件里加锁：Nest 锁住所属实体之后才进入业务 handler。
//
// 每个入口的 nowUnixMilli 都传所在 Nest handler 的最后一个参数（这条消息冻结的业务时间），
// 不要传 time.Now()、也不要传客户端给的时间：同一笔事务里的几次调用要看到同一个时刻。

// staminaSettle 把存着的 (value, settledAt) 结算到 nowUnixMilli：每过 regenMillis 恢复 1 点，到 max 为止。
// 返回此刻的体力与新的恢复时钟起点。它只做计算、不写任何字段，读和写都先经过它。
//
//   - 没满：起点只前进“整周期数 × 周期”，不足一个周期的时间留在起点之后，下次结算接着算。
//   - 满了（恢复到 max，或本来就不低于 max）：起点归 0，时钟停下；之后的时间不累计。
//   - 时钟回拨（now 不晚于起点）：一点不恢复、也不倒扣，起点不动——等业务时间重新走过起点再接着恢复。
//   - regenMillis 不为正：不自然恢复（也避免除以 0）。
//
// 恢复的点数先和“离上限还差多少”比较、再相加，所以隔了多少年都不会溢出。
func staminaSettle(value, settledAt, nowUnixMilli, max, regenMillis int64) (int64, int64) {
	if value >= max {
		return value, 0
	}
	if regenMillis <= 0 || nowUnixMilli <= settledAt {
		return value, settledAt
	}
	points := (nowUnixMilli - settledAt) / regenMillis
	if points >= max-value {
		return max, 0
	}
	return value + points, settledAt + points*regenMillis
}

// write 把一次修改的结果写回状态。before 与 settledAt 是 staminaSettle 的结果，after 是修改之后的体力。
// 恢复时钟的起点只有三种去向：改完不低于上限就停下（0）；从不低于上限扣到上限以下，从此刻重新计时；
// 本来就在恢复，沿用结算后的起点（保留零头）。
func (component *StaminaComponent) write(max, before, after, settledAt, nowUnixMilli int64) {
	switch {
	case after >= max:
		settledAt = 0
	case before >= max:
		settledAt = nowUnixMilli
	}
	state := component.owner.Dao().GetStamina()
	state.SetValue(after)
	state.SetSettledAt(settledAt)
}

// Current 返回 nowUnixMilli 这一刻的体力。只读，不写任何字段：结算结果不落回状态
// （下一次读写会从同一份状态算出同样的结果）。
func (component *StaminaComponent) Current(nowUnixMilli int64) int64 {
	rules := component.staminaRules()
	state := component.owner.Dao().GetStamina()
	value, _ := staminaSettle(state.GetValue(), state.GetSettledAt(), nowUnixMilli, rules.Max, rules.RegenMillis)
	return value
}

// Spend 扣 n 点体力，返回扣完之后的体力。n 不为正（stamina_invalid）或此刻的体力不够（stamina_short）
// 时拒绝，不写任何字段；不做“有多少扣多少”。
//
// 它不判重：调一次扣一次。调用方在自己的 handler 里先做完自己的检查，再调它，再写自己的状态——
// 任何一步返回错误，Nest 把整笔事务回滚，体力也退回去。
func (component *StaminaComponent) Spend(n, nowUnixMilli int64) (int64, error) {
	if n <= 0 {
		return 0, apperrors.ErrStaminaInvalid
	}
	rules := component.staminaRules()
	state := component.owner.Dao().GetStamina()
	value, settledAt := staminaSettle(state.GetValue(), state.GetSettledAt(), nowUnixMilli, rules.Max, rules.RegenMillis)
	if value < n {
		return 0, apperrors.ErrStaminaShort
	}
	component.write(rules.Max, value, value-n, settledAt, nowUnixMilli)
	return value - n, nil
}

// StaminaGrantResult 是一次发放的结果。
type StaminaGrantResult struct {
	// Granted 是实际加上的点数；被硬顶截掉一部分时小于请求的点数，已在硬顶时为 0。
	Granted int64
	// Value 是发放之后的体力。
	Value int64
}

// Grant 发 n 点体力（奖励、道具、GM）。发放可以超过上限，直到硬顶（StaminaRules.HardCap）为止；
// 超出硬顶的部分截掉，不拒绝——发体力常常是一笔更大的奖励里的一项（升级、通关、领邮件），
// 因为体力太多而让整笔奖励失败比丢掉溢出的几点更糟。实际加了多少在返回值的 Granted 里，
// 在意溢出的调用方自己据此处理。已在硬顶时 Granted 为 0，不写任何字段。
// 只有 n 不为正时拒绝（stamina_invalid），不写任何字段。
//
// 超过上限的体力不会被自然恢复“拉回”上限，只是不再恢复；扣回上限以下之后从那一刻重新计时。
// 它不判重：调一次发一次，“这一次发过没有”由调用方记在自己的状态里。
func (component *StaminaComponent) Grant(n, nowUnixMilli int64) (StaminaGrantResult, error) {
	if n <= 0 {
		return StaminaGrantResult{}, apperrors.ErrStaminaInvalid
	}
	rules := component.staminaRules()
	state := component.owner.Dao().GetStamina()
	value, settledAt := staminaSettle(state.GetValue(), state.GetSettledAt(), nowUnixMilli, rules.Max, rules.RegenMillis)
	granted := staminaGrantable(value, n, rules.HardCap)
	if granted == 0 {
		return StaminaGrantResult{Value: value}, nil
	}
	component.write(rules.Max, value, value+granted, settledAt, nowUnixMilli)
	return StaminaGrantResult{Granted: granted, Value: value + granted}, nil
}

// staminaGrantable 返回体力为 value 时发 n 点（n 为正）实际能加上多少：加到 hardCap 为止。
// 已经不低于硬顶时是 0——包括规则调低硬顶之后存着的体力比新硬顶还高的情况：不加，也不往回扣。
// 用减法比较：value + n 在 n 接近 int64 上限时会溢出成负数，绕过硬顶。
func staminaGrantable(value, n, hardCap int64) int64 {
	if value >= hardCap {
		return 0
	}
	if n > hardCap-value {
		return hardCap - value
	}
	return n
}

// StaminaRefillResult 是一次购买补满的结果。
type StaminaRefillResult struct {
	// Value 是补满之后的体力（就是上限）。
	Value int64
	// Cost 是这一次花掉的金币；Balance 是花完之后的余额。
	Cost    int64
	Balance int64
	// Count 是今天（业务日）已经买了几次，含这一次。
	Count int32
}

// Refill 花金币把体力补到上限。nowUnixMilli 是这条消息冻结的业务时间。
//
// 拒绝时不写任何字段、不扣金币：此刻的体力已不低于上限（stamina_full，包括靠自然恢复刚好满了的）；
// 今天的购买次数用完（stamina_refill_limit）；金币不够（货币模块的 wallet_short）。
// 价格由当日第几次购买决定（stamina_rules.go 的 staminaRefillPrice），与补多少点无关。
//
// “今天”是业务日（clock.BusinessDay：业务时区与每日重置时刻由部署配置决定，缺省 UTC 零点）。
// 次数按业务日惰性清零：存着的 RefillDay 比今天早就当作 0 次，这次购买把 RefillDay 改成今天。
// 业务日回拨（今天比 RefillDay 还早）时不清零，沿用存着的次数与日期——时钟往回拨不会多出购买次数。
//
// 扣金币与补体力在同一笔事务里：金币走货币组件的 Add（不留回执），提交被拒时两边一起回滚。
// 请求不带业务键：紧接着重发的请求不会重复扣钱（第一次成功之后体力已满，第二次得到 stamina_full）；
// 两次之间又消耗过体力的重发，会被当成新的一次购买。
func (component *StaminaComponent) Refill(nowUnixMilli int64) (StaminaRefillResult, error) {
	rules := component.staminaRules()
	state := component.owner.Dao().GetStamina()
	value, _ := staminaSettle(state.GetValue(), state.GetSettledAt(), nowUnixMilli, rules.Max, rules.RegenMillis)
	if value >= rules.Max {
		return StaminaRefillResult{}, apperrors.ErrStaminaFull
	}
	today := int64(clock.BusinessDay(time.UnixMilli(nowUnixMilli)))
	day, count := state.GetRefillDay(), state.GetRefillCount()
	if today > day {
		day, count = today, 0
	}
	if count >= rules.RefillDailyLimit {
		return StaminaRefillResult{}, apperrors.ErrStaminaRefillLimit
	}
	wallet := component.owner.WalletComp()
	cost, balance := staminaRefillCost(component.staminaRefillPrice(count+1)), wallet.Balance()
	if cost > 0 {
		// 先扣钱：它是最后一个可能拒绝的步骤，被拒时体力这边还一个字段都没写。
		// 免费的那一次不调货币组件（它拒绝 0 金额的加减）。
		var err error
		if balance, err = wallet.Add(-cost); err != nil {
			return StaminaRefillResult{}, err
		}
	}
	// 补满之后时钟停下（SettledAt 归 0）：之前攒的不足一个周期的时间作废，下一次消耗起重新计时。
	state.SetValue(rules.Max)
	state.SetSettledAt(0)
	state.SetRefillDay(day)
	state.SetRefillCount(count + 1)
	return StaminaRefillResult{Value: rules.Max, Cost: cost, Balance: balance, Count: count + 1}, nil
}

// staminaRefillCost 把规则给的价格变成这一次要扣的金币：不为正就是免费（0）。
// 规则表里填错成负数时不会变成“买一次倒找钱”。
func staminaRefillCost(price int64) int64 {
	if price < 0 {
		return 0
	}
	return price
}
