package shop

import (
	"{{MODULE}}/game/view"
	gamerules "{{MODULE}}/game/components/rules"
	"slices"

	generated "{{MODULE}}/configs/generated"
	"{{MODULE}}/protocol/msgid"
	"{{MODULE}}/protocol/pb"
)

func init() {
	gamerules.RegisterPlayerRules("shop", func(view.PlayerEntity) (*pb.RulePart, error) {
		snapshot := &pb.ShopRulesPush{}
		for _, row := range generated.ShopGoodsTable().Rows() {
			if row.Off {
				continue
			}
			snapshot.Goods = append(snapshot.Goods, &pb.ShopGoodsRule{ID: row.ID, ItemID: row.ItemID, ItemCount: row.ItemCount, Price: row.Price, Limit: row.Limit, LimitCount: row.LimitCount})
		}
		slices.SortFunc(snapshot.Goods, func(a, b *pb.ShopGoodsRule) int {
			if a.ID < b.ID {
				return -1
			}
			if a.ID > b.ID {
				return 1
			}
			return 0
		})
		payload, err := pb.MarshalShopRulesPush(snapshot)
		if err != nil {
			return nil, err
		}
		return &pb.RulePart{MessageID: msgid.MsgShopRules, Payload: payload}, nil
	})
}
