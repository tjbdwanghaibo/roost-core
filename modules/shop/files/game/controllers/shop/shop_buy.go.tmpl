package shop

import (
	"log/slog"

	"{{MODULE}}/game/playeraccess"
	"{{MODULE}}/protocol/pb"
)

// HandleShopBuy 是购买协议的入口；目标取认证会话的玩家（只能给自己买），
// 商品、价格、限购与请求键的去重都在 Nest handler 的锁内判断。
//
//roost:endpoint nest=ShopBuy
func (controller *Controller) HandleShopBuy(ctx *playeraccess.Context, req *pb.ShopBuyRequest) (*pb.ShopBuyResponse, error) {
	response, err := controller.dispatchShopBuy(ctx, req)
	// 只记录已确认的请求结果；带业务键的重放也会返回成功，不把日志当作资产流水。
	if err == nil && response != nil && response.Code == 0 && ctx != nil && req != nil {
		slog.InfoContext(ctx.Context(), "shop: buy completed", "player_id", ctx.PlayerID, "request_key", req.Key, "goods_id", req.GoodsID, "count", req.Count, "cost", response.Cost, "balance", response.Balance, "item_id", response.ItemID, "gained", response.Gained, "held", response.Held)
	}
	return response, err
}
