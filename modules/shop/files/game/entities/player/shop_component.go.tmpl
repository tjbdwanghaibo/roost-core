package player

import (
	"{{MODULE}}/game/components/shop"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:Shop}}
const CompTypeShop entity.ComponentType = {{ID:component:Shop}}

// ShopComponent 是 game/components/shop 的组件在 Player 上的名字（生成接线与 handler 用它）；业务在那个包里。
type ShopComponent = shop.Component

// IShopEntity 是 Nest handler 用这个组件时的窄实体接口；getter 由生成的 Entity 接线实现。
type IShopEntity interface {
	entity.IThreadSafeEntity
	ShopComp() *ShopComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeShop, shop.NewComponent)
}
