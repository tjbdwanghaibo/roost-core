// Package chat 是聊天在本工程这一侧的约定：有哪些频道、一条消息长什么样、谁能发谁能读。
// chat 托管服务是通用的（按频道存序号、执行工程交给它的政策），与游戏有关的规则都在这里；
// game 进程的端点与 chat 进程的 collaborators 都 import 它，两边因此用同一套规则与消息类型名。
package chat

import (
	"fmt"
	"sync"
	"unicode/utf8"

	svcchat "github.com/tjbdwanghaibo/roost-core/service/chat"
)

// TypeText 是登记给 chat 服务的唯一消息类型：UTF-8 文本，至多 MaxTextBytes 字节。
const TypeText svcchat.MessageType = "text"

// MaxTextBytes 是一条聊天的长度上限；chat 服务另有自己更宽的上限。
const MaxTextBytes = 256

// WorldChannelTarget 是世界频道的目标号：只有一个世界。分区的游戏把区号放在这里。
const WorldChannelTarget int64 = 1

// SystemActor 是系统消息在历史里带的标签，审计时看得出是游戏的哪一部分说的。
const SystemActor = "game"

// WorldChannel 是所有玩家说话的频道。
var WorldChannel = svcchat.Channel{Kind: svcchat.ChannelWorld, Target: WorldChannelTarget}

// PrivateChannel 是与 peer 的一对一会话（从发送者的角度寻址）。
func PrivateChannel(peer int64) svcchat.Channel {
	return svcchat.Channel{Kind: svcchat.ChannelPrivate, Target: peer}
}

// PlayerSender 把一名玩家报给 chat 服务。名字是显示用的快照；这里没有档案查询，用玩家号。
func PlayerSender(playerID int64) svcchat.Sender {
	return svcchat.Sender{RoleID: playerID, Name: fmt.Sprintf("player-%d", playerID)}
}

// ChannelOf 把协议里的频道种类与目标号换成频道。玩家能寻址世界、私聊与系统频道；
// 系统频道只能读（发布是特权入口，端点与 Allow 都拒绝玩家往里发）。
func ChannelOf(kind string, target int64) (svcchat.Channel, bool) {
	switch svcchat.ChannelKind(kind) {
	case svcchat.ChannelWorld:
		return WorldChannel, true
	case svcchat.ChannelPrivate:
		return PrivateChannel(target), true
	case svcchat.ChannelSystem:
		return svcchat.Channel{Kind: svcchat.ChannelSystem}, true
	default:
		return svcchat.Channel{}, false
	}
}

// ValidateText 是两个进程共用的消息体校验：chat 服务在发布时执行（经 BodyRegistry），
// 端点在调用总线之前执行，写坏的一行不用往返一次就被拒绝。
func ValidateText(body []byte) error {
	if len(body) == 0 {
		return fmt.Errorf("text is empty")
	}
	if len(body) > MaxTextBytes {
		return fmt.Errorf("text is %d bytes, limit %d", len(body), MaxTextBytes)
	}
	if !utf8.Valid(body) {
		return fmt.Errorf("text is not valid utf-8")
	}
	return nil
}

// Allow 是发布与读取共用的频道政策：世界频道与一对一私聊对每个已认证的玩家开放；
// 群组频道拒绝（本模块没有队伍或公会，要开放时按它们的成员关系授权）；其余种类不对玩家开放。
// 每一条拒绝都是写下来的决定，不是缺省。
func Allow(who svcchat.Sender, channel svcchat.Channel) error {
	switch channel.Kind {
	case svcchat.ChannelWorld:
		if channel.Target != WorldChannelTarget {
			return fmt.Errorf("world %d does not exist (this game has world %d)", channel.Target, WorldChannelTarget)
		}
		return nil
	case svcchat.ChannelPrivate:
		if channel.Target == who.RoleID {
			return fmt.Errorf("a private channel needs a peer other than the sender")
		}
		if channel.Target <= 0 {
			return fmt.Errorf("a private channel needs a peer")
		}
		return nil
	case svcchat.ChannelGroup:
		return fmt.Errorf("this game has no groups; grant group channels from party or guild membership")
	default:
		return fmt.Errorf("channel kind %q is not open to players", channel.Kind)
	}
}

// Presence 是本进程认为在线的玩家：世界频道的推送对象。进入游戏或用过聊天时加入，
// 最后一条连接关闭、或推送发现没有会话时移除。它按进程计：多个 game 进程的游戏要么各推各的在线玩家
// （每个进程都收到 chat 服务存下的消息才行），要么改为订阅 chat 服务的流，不要指望这份内存名单跨进程。
type Presence struct {
	mu      sync.RWMutex
	players map[int64]struct{}
}

// NewPresence 建一份空名单。
func NewPresence() *Presence { return &Presence{players: map[int64]struct{}{}} }

// processPresence 是本进程的世界频道在线名单。它是包级单例：一个进程只有一份，而用它的有两处——
// 端点（玩家出现时加入、推送时遍历）与连接关闭的回调（移除）。
var processPresence = NewPresence()

// DefaultPresence 返回本进程的在线名单。
func DefaultPresence() *Presence { return processPresence }

// Add 把玩家记为在线。
func (p *Presence) Add(playerID int64) {
	p.mu.Lock()
	defer p.mu.Unlock()
	p.players[playerID] = struct{}{}
}

// Remove 把玩家记为离线。
func (p *Presence) Remove(playerID int64) {
	p.mu.Lock()
	defer p.mu.Unlock()
	delete(p.players, playerID)
}

// Holds 报告玩家是否在名单里。
func (p *Presence) Holds(playerID int64) bool {
	p.mu.RLock()
	defer p.mu.RUnlock()
	_, ok := p.players[playerID]
	return ok
}

// Snapshot 返回在线玩家号的副本：推送时不持锁做网络写。
func (p *Presence) Snapshot() []int64 {
	p.mu.RLock()
	defer p.mu.RUnlock()
	out := make([]int64, 0, len(p.players))
	for id := range p.players {
		out = append(out, id)
	}
	return out
}
