//go:build protocoldef

package protocoldef

// ChatMessagePush 是送到在线玩家手里的一行聊天，也是历史返回的形状：客户端只处理一种。
// 系统消息（例如登录公告）的 FromID 为 0，FromName 是发言方的标签。
type ChatMessagePush struct {
	Kind     string `pb:"1"`
	Target   int64  `pb:"2"`
	Seq      int64  `pb:"3"`
	FromID   int64  `pb:"4"`
	FromName string `pb:"5"`
	Text     string `pb:"6"`
	System   bool   `pb:"7"`
}

//roost:protocol group=game handler=chat
type ChatMessageProtocol interface {
	//roost:msg id={{ID:protocol:ChatMessage}}
	ChatMessage() ChatMessagePush
}
