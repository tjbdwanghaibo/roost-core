package chat

import (
	"context"

	"github.com/tjbdwanghaibo/roost-core/framework/app"
	gamelogin "{{MODULE}}/game/modules/login"
)

// 这个文件是 chat 与 enter 两个模块的联动：两个都装着时才有。
//
// 玩家一进入游戏就加进本进程的世界频道在线名单，从这一刻起收得到世界与系统频道的推送。
// 没有这一步时，玩家要自己先发一句话或翻一次历史才算在线。离开名单不在这里：最后一条连接关闭、
// 或推送时发现没有会话，由 chat 的 controller 移除。
//
// 登录公告（“某某进入了世界”）不在这里发：发不发、说什么是工程的决定。要发就调 chat controller 的
// AnnounceWorld；每条公告都推给全体在线，登录潮里应合并成定时的一条（game-demo 的 game/announce：每秒至多
// 一条“N players entered …”，幂等键是进程起始时刻加批序号），不要每次登录一条。
func init() {
	gamelogin.OnEntered("chat", joinWorldOnEnter)
}

func joinWorldOnEnter(_ context.Context, _ *app.Registry, entered gamelogin.Entered) error {
	DefaultPresence().Add(entered.PlayerID)
	return nil
}
