package enter

import (
	stdcontext "context"
	"fmt"
	"log/slog"

	gameenter "{{MODULE}}/game/enter"
	player "{{MODULE}}/game/entities/player"
	syncsender "{{MODULE}}/game/handler/syncsender"
	lifecycle "{{MODULE}}/game/lifecycle"
	"{{MODULE}}/game/playeraccess"
	"{{MODULE}}/protocol/pb"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/infra/base/errcode"
)

// HandleEnterGame 是登录边界：保证已认证的玩家在任何玩法请求到达 Nest 之前有一个 Player。
// Nest handler 的目标必须是已存在的实体，新玩家没有，所以在它之前发来的玩法请求答 entity_not_found。
//
// 顺序由 gameenter.Enter 保证：
//
//	进入前检查  别的功能登记的检查（game/enter 的 OnEntering：单个玩家换服的“正在换服”“已经绑定到别的服”……）。
//	            任何一条拒绝，这一次进入到此为止：不加载也不创建 Player、不跑首次初始化、不跑进入钩子，
//	            客户端拿到那条检查的码。没有登记任何检查时这一步什么都不做。
//	load        下面的 loadAndInit，两步：
//	            1. GetOrCreate：只在持久层确认这个实体不存在时才创建；数据库、解码、超时错误原样返回，不当成“不存在”。
//	               删过档的实体（只剩墓碑）不再创建，客户端得到 entity_deleted，重试或重新登录都不会变。
//	            2. 首次初始化（EnterInit）：每次进入都发，不只在第 1 步新建时发——“做过没有”是档里的事实，
//	               所以新建之后、初始化之前崩溃或丢回包，下一次进入会补上；重复进入什么都不做。
//	            两步都可以并发、可以重试：同一名新玩家的两次登录最后拿到同一个实体，初始化只生效一次。
//	进入钩子    别的功能登记的钩子（game/enter 的 OnEntered：聊天上线、拉全服邮件……）。钩子失败只记日志，不让登录失败。
//
// 检查与钩子拿到的 claims 是会话的 claims（Entering.Claims / Entered.Claims）。工程改写这个端点时，
// 把自己的加载与初始化包成 load 交给 gameenter.Enter；不经 Enter 的写法见它的注释。
func (controller *Controller) HandleEnterGame(context *playeraccess.Context, request *pb.EnterGameRequest) (*pb.EnterGameResponse, error) {
	if context == nil || request == nil {
		return nil, fmt.Errorf("enter_game endpoint: context and request are required")
	}
	entering := gameenter.Entering{PlayerID: context.PlayerID}
	if context.Session != nil {
		// 认证器写进会话的 claims 原样带给检查与钩子：这里不解释它们，哪个键是什么意思由写它的认证器与读它的一方约定。
		entering.Claims = context.Session.Principal().Claims
	}
	entered, err := gameenter.Enter(context.Context(), controller.registry, entering, func(ctx stdcontext.Context) (gameenter.InitResult, error) {
		return controller.loadAndInit(ctx, context.PlayerID)
	})
	if err != nil {
		code, reason := errcode.ClientError(err)
		if code == errcode.CodeInternal {
			slog.Error("enter_game failed", "player_id", context.PlayerID, "err", err)
		}
		return &pb.EnterGameResponse{Code: code, Reason: reason}, nil
	}
	return &pb.EnterGameResponse{First: entered.First}, nil
}

// loadAndInit 加载或创建 Player，然后提交首次初始化。
func (controller *Controller) loadAndInit(ctx stdcontext.Context, playerID int64) (gameenter.InitResult, error) {
	entities, err := lifecycle.PlayerFromRegistry(controller.registry)
	if err != nil {
		return gameenter.InitResult{}, err
	}
	if _, _, err := entities.GetOrCreate(ctx, playerID); err != nil {
		return gameenter.InitResult{}, err
	}
	entityID, err := entity.BuildEntityID(playerID, player.EntityKindPlayer)
	if err != nil {
		return gameenter.InitResult{}, err
	}
	return syncsender.NewEnterInitSender(controller.nestClient).Sync_EnterInit(ctx, entityID)
}
