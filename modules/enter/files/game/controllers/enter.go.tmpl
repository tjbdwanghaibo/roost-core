// HandleEnterGame 是登录边界：保证已认证的玩家在任何玩法请求到达 Nest 之前有一个 Player。
// Nest handler 的目标必须是已存在的实体，新玩家没有，所以在它之前发来的玩法请求答 entity_not_found。
//
// 顺序由 gamelogin.Enter 保证（经 gamelogin.EnterSession 调它）：
//
//	进入前检查  别的功能登记的检查（game/enter 的 OnEntering：单个玩家换服的“正在换服”“已经绑定到别的服”……）。
//	            任何一条拒绝，这一次进入到此为止：不加载也不创建 Player、不跑首次初始化、不跑进入钩子，
//	            客户端拿到那条检查的码。没有登记任何检查时这一步什么都不做。
//	load        缺省是下面的 loadAndInit，两步（“先新建”的会话见本注释末尾）：
//	            1. GetOrCreate：只在持久层确认这个实体不存在时才创建；数据库、解码、超时错误原样返回，不当成“不存在”。
//	               删过档的实体（只剩墓碑）不再创建，客户端得到 entity_deleted，重试或重新登录都不会变。
//	            2. 首次初始化（EnterInit）：每次进入都发，不只在第 1 步新建时发——“做过没有”是档里的事实，
//	               所以新建之后、初始化之前崩溃或丢回包，下一次进入会补上；重复进入什么都不做。
//	            两步都可以并发、可以重试：同一名新玩家的两次登录最后拿到同一个实体，初始化只生效一次。
//	进入钩子    别的功能登记的钩子（game/enter 的 OnEntered：聊天上线、拉全服邮件……）。钩子失败只记日志，不让登录失败。
//
// 检查与钩子拿到的 claims 是会话的 claims（Entering.Claims / Entered.Claims）。工程改写这个端点时，
// 把自己的加载与初始化包成 load 交给 gamelogin.Enter；不经 Enter 的写法见它的注释。
//
// “先新建”的会话（gamelogin.CreateFirst：login 模块装着时，用进服票据握手的会话）由 gamelogin.EnterSession 把 load 换成 enterExisting：
// 只进入已经建成的玩家，没建成答 enter_need_create，不创建档、不做首次初始化——那是新建请求
// （HandleEnterCreate）的事，角色名的规则也在那里。别的会话仍是 loadAndInit，与没有这条路时相同。
func (controller *Controller) HandleEnterGame(context *playeraccess.Context, request *pb.EnterGameRequest) (*pb.EnterGameResponse, error) {
	if context == nil || request == nil {
		return nil, fmt.Errorf("enter_game endpoint: context and request are required")
	}
	entering := gamelogin.Entering{PlayerID: context.PlayerID, Session: context.Session}
	if context.Session != nil {
		// 认证器写进会话的 claims 原样带给检查与钩子：这里不解释它们，哪个键是什么意思由写它的认证器与读它的一方约定。
		entering.Claims = context.Session.Principal().Claims
	}
	entered, err := gamelogin.EnterSession(context.Context(), controller.registry, entering, gamelogin.Loads{
		LoadOrCreate: func(ctx stdcontext.Context) (gamelogin.InitResult, error) {
			return controller.enterLoadAndInit(ctx, context.PlayerID)
		},
		Existing: func(ctx stdcontext.Context) (gamelogin.InitResult, error) {
			return controller.enterExisting(ctx, context.PlayerID)
		},
	})
	if err != nil {
		code, reason := errcode.ClientError(err)
		if code == errcode.CodeInternal {
			slog.ErrorContext(context.Context(), "enter_game failed", "player_id", context.PlayerID, "err", err)
		}
		return &pb.EnterGameResponse{Code: code, Reason: reason}, nil
	}
	slog.InfoContext(context.Context(), "enter: player entered", "player_id", context.PlayerID, "first", entered.First)
	return &pb.EnterGameResponse{First: entered.First}, nil
}

// enterLoadAndInit 加载或创建 Player，然后提交首次初始化。
func (controller *Controller) enterLoadAndInit(ctx stdcontext.Context, playerID int64) (gamelogin.InitResult, error) {
	entities, err := player.LifecycleFromRegistry(controller.registry)
	if err != nil {
		return gamelogin.InitResult{}, err
	}
	if _, _, err := entities.GetOrCreate(ctx, playerID); err != nil {
		return gamelogin.InitResult{}, err
	}
	entityID, err := entity.BuildEntityID(playerID, player.EntityKindPlayer)
	if err != nil {
		return gamelogin.InitResult{}, err
	}
	result, err := syncsender.NewEnterInitSender(controller.nestClient).Sync_EnterInit(ctx, entityID)
	if err == nil && result.First {
		slog.InfoContext(ctx, "enter: first entry confirmed", "player_id", playerID)
	}
	return result, err
}

// enterExisting 是“先新建”的会话的 load：只进入已经建成的玩家。没有档直接答 enter_need_create（不创建）；
// 有档就在它的锁内问一次（EnterExisting）：没建成同样答 enter_need_create，建成了就是一次进入。
// 删过档的玩家与 loadAndInit 一样得到 entity_deleted。
func (controller *Controller) enterExisting(ctx stdcontext.Context, playerID int64) (gamelogin.InitResult, error) {
	entityID, found, err := controller.enterFind(ctx, playerID)
	if err != nil {
		return gamelogin.InitResult{}, err
	}
	if !found {
		return gamelogin.InitResult{}, gamelogin.ErrNeedCreate
	}
	return syncsender.NewEnterExistingSender(controller.nestClient).Sync_EnterExisting(ctx, entityID)
}

// HandleEnterCreate 是新建请求的端点：在本服把已认证的这名玩家建成（建档、起名、首次初始化）。
// 顺序与每一步被拒时留下了什么由 gamelogin.Create 保证（见它的注释）；这里只给出两个档操作：
//
//	Ensure  GetOrCreate：没有档就建一份空档，不做首次初始化。删过档的玩家得到 entity_deleted。
//	Commit  Nest handler EnterCreate：名字、初始发放与“建成了”的标记一笔事务。
//
// 应答的 Code 为 0 表示建成了；enter_created 表示早就建成了（什么都没改）。两种情况客户端都接着发 EnterGame。
// 哪条会话都可以发它：“先新建”的会话必须先发，别的会话（EnterGame 会代建）想带着名字建也可以发。
func (controller *Controller) HandleEnterCreate(context *playeraccess.Context, request *pb.EnterCreateRequest) (*pb.EnterCreateResponse, error) {
	if context == nil || request == nil {
		return nil, fmt.Errorf("enter_create endpoint: context and request are required")
	}
	creating := gamelogin.Creating{PlayerID: context.PlayerID, Name: request.Name}
	if context.Session != nil {
		creating.Claims = context.Session.Principal().Claims
	}
	err := gamelogin.Create(context.Context(), controller.registry, creating, gamelogin.CreateSteps{
		Ensure: func(ctx stdcontext.Context) error { return controller.enterEnsure(ctx, context.PlayerID) },
		Commit: func(ctx stdcontext.Context, name string) error {
			return controller.enterCommitCreate(ctx, context.PlayerID, name)
		},
	})
	if err != nil {
		code, reason := errcode.ClientError(err)
		if code == errcode.CodeInternal {
			slog.ErrorContext(context.Context(), "enter_create failed", "player_id", context.PlayerID, "err", err)
		}
		return &pb.EnterCreateResponse{Code: code, Reason: reason}, nil
	}
	return &pb.EnterCreateResponse{}, nil
}

// enterEnsure 保证玩家的档在：只在持久层确认这个实体不存在时才创建。
func (controller *Controller) enterEnsure(ctx stdcontext.Context, playerID int64) error {
	entities, err := player.LifecycleFromRegistry(controller.registry)
	if err != nil {
		return err
	}
	_, _, err = entities.GetOrCreate(ctx, playerID)
	return err
}

// enterCommitCreate 发新建的那一笔事务。
func (controller *Controller) enterCommitCreate(ctx stdcontext.Context, playerID int64, name string) error {
	entityID, err := entity.BuildEntityID(playerID, player.EntityKindPlayer)
	if err != nil {
		return err
	}
	err = syncsender.NewEnterCreateSender(controller.nestClient).Sync_EnterCreate(ctx, entityID, name)
	if err == nil {
		slog.InfoContext(ctx, "enter: player created", "player_id", playerID, "name", name)
	}
	return err
}

// 下面这一段是会话激活之后给客户端的告知（EnterStatus 推送）：本服能不能进、要不要先新建。
// 谁在会话激活时调 Announce 不归这个模块管：login 模块装着时由它的联动接上（认证器的会话激活通知）；
// 用自己的认证器的工程想要这条推送，在自己的激活回调里调它。没有人调，就没有这条推送，别的都不变。

// enterStatusTransport 是告知用到的玩家传输的两个方法（internal/access/player/tcp 发布的 Runtime，
// 嵌入 TCP 与独立 Gate 的 Game Ingress 都实现）。写成接口、按能力名取，理由同别的模块：传输包 import
// 构造这个 controller 的协议绑定，反过来 import 它就成环了。
type enterStatusTransport interface {
	PushSession(ctx context.Context, sessionID string, messageID uint32, value any) error
	CloseSessions(playerID int64, reason error) int
}

// StatusCloseDelay 是推出带码的拒绝之后、断开连接之前等的时间。推送只进发送队列，立刻断开会把还没写出的
// 那一帧一起丢掉；等这一小会儿让它先写出去。它不是保证：慢的连接仍可能收不到——客户端收不到就照常发
// EnterGame，得到的是同一个码。
const StatusCloseDelay = 300 * time.Millisecond

// errEnterStatusRefused 是告知之后断开连接时交给传输的原因。
var errEnterStatusRefused = errors.New("enter: this server does not serve the player; the session was closed after telling the client")

// Announce 在一条会话激活之后告诉客户端它该做什么（EnterStatus），entering 是这条会话的玩家与 claims，
// sessionID 是要推给的那条会话。
//
//   - 本服不该服务这名玩家（进入前检查拒绝——与 EnterGame 用的是同一组检查）：推那个码，然后断开这名玩家
//     在本进程的连接。传输没有“只断这一条会话”的入口，断的是这名玩家的全部会话——本服不该服务他，
//     他的哪条会话都一样。
//   - 该服务：推 need_create（“先新建”的会话且玩家没建成时为 true）。
//   - 判断不了（检查问不到权威、读档出错）：什么都不推，记一条 Warn。
//
// 它只是告知：不写任何状态，推送不成只记日志；客户端没收到就直接发 EnterGame，结论以那个请求为准。
// 调用方要在后台执行它并自己限量（它要读档，不能放在握手协程里），ctx 带上期限。
func Announce(ctx context.Context, registry *app.Registry, entering gamelogin.Entering, sessionID string) {
	controller, err := FromRegistry(registry)
	if err != nil {
		slog.Warn("enter: status not announced", "player_id", entering.PlayerID, "err", err)
		return
	}
	transport, err := LookupPlayerTransport[enterStatusTransport](registry)
	if err != nil {
		slog.Warn("enter: status not announced; the player tcp transport is not assembled", "player_id", entering.PlayerID, "err", err)
		return
	}
	enterAnnounce(ctx, registry, transport, entering, sessionID, func(ctx context.Context) (bool, error) {
		return controller.enterBuilt(ctx, entering.PlayerID)
	}, StatusCloseDelay)
}

// enterAnnounce 是 Announce 去掉“从 registry 取东西”之后的部分，测试直接调它。
func enterAnnounce(ctx context.Context, registry *app.Registry, transport enterStatusTransport, entering gamelogin.Entering, sessionID string,
	built func(context.Context) (bool, error), closeDelay time.Duration) {
	status, refused, err := gamelogin.Assess(ctx, registry, entering, built)
	if err != nil {
		slog.Warn("enter: status not announced; the client finds out from EnterGame", "player_id", entering.PlayerID, "err", err)
		return
	}
	push := &pb.EnterStatusPush{Code: status.Code, Reason: status.Reason, NeedCreate: status.NeedCreate}
	if err := transport.PushSession(ctx, sessionID, msgid.MsgEnterStatus, push); err != nil {
		slog.Info("enter: status push failed; the client finds out from EnterGame", "player_id", entering.PlayerID, "err", err)
	}
	if !refused {
		return
	}
	// 推送成不成都断开：本服不该服务他。等一小会儿让那一帧先写出去；期限到了也照样断开。
	if closeDelay > 0 {
		timer := time.NewTimer(closeDelay)
		select {
		case <-timer.C:
		case <-ctx.Done():
			timer.Stop()
		}
	}
	closed := transport.CloseSessions(entering.PlayerID, fmt.Errorf("%w (code %d)", errEnterStatusRefused, status.Code))
	slog.Info("enter: closed the sessions of a player this server does not serve", "player_id", entering.PlayerID, "code", status.Code, "closed", closed)
}

// enterBuilt 回答这名玩家建成了没有：没有档是 false；有档就在它的锁内读一次首次初始化的标记。只读。
func (controller *Controller) enterBuilt(ctx context.Context, playerID int64) (bool, error) {
	entityID, found, err := controller.enterFind(ctx, playerID)
	if err != nil || !found {
		return false, err
	}
	return syncsender.NewEnterBuiltSender(controller.nestClient).Sync_EnterBuilt(ctx, entityID)
}

// enterFind 加载玩家的档，不创建。found 为 false 表示持久层确认没有这个实体；别的错误（数据库、解码、超时、
// 删过档）原样返回，不当成“没有”。
func (controller *Controller) enterFind(ctx context.Context, playerID int64) (entityID int64, found bool, err error) {
	entities, err := player.LifecycleFromRegistry(controller.registry)
	if err != nil {
		return 0, false, err
	}
	if _, err := entities.Get(ctx, playerID); err != nil {
		if errors.Is(err, player.ErrNotFound) || errors.Is(err, engine.ErrEntityAggregateNotFound) {
			return 0, false, nil
		}
		return 0, false, err
	}
	entityID, err = entity.BuildEntityID(playerID, player.EntityKindPlayer)
	if err != nil {
		return 0, false, err
	}
	return entityID, true, nil
}
