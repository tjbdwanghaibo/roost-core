package player

import (
	"errors"
	"reflect"
	"testing"
)

func isolateFirstEnterHooks(t *testing.T) {
	t.Helper()
	firstEnterMu.Lock()
	saved := firstEnterHooks
	firstEnterHooks = map[string]FirstEnterHook{}
	firstEnterMu.Unlock()
	t.Cleanup(func() { firstEnterMu.Lock(); firstEnterHooks = saved; firstEnterMu.Unlock() })
}

func TestEnterFirstHooksRunInNameOrder(t *testing.T) {
	isolateFirstEnterHooks(t)
	var got []string
	owner := &Player{}
	for _, name := range []string{"z-last", "a-first"} {
		OnFirstEnter(name, func(p *Player, now int64) error {
			if p != owner || now != 123 {
				t.Fatalf("hook lost owner or frozen time: %p %d", p, now)
			}
			got = append(got, name)
			return nil
		})
	}
	if err := runFirstEnter(owner, 123); err != nil {
		t.Fatal(err)
	}
	if !reflect.DeepEqual(got, []string{"a-first", "z-last"}) {
		t.Fatalf("order = %v", got)
	}
}

func TestEnterFirstHookFailureStopsTheRemainingHooks(t *testing.T) {
	isolateFirstEnterHooks(t)
	refusal := errors.New("grant refused")
	OnFirstEnter("a", func(*Player, int64) error { return refusal })
	OnFirstEnter("b", func(*Player, int64) error { t.Fatal("called after a refusal"); return nil })
	if err := runFirstEnter(&Player{}, 123); !errors.Is(err, refusal) {
		t.Fatalf("error = %v", err)
	}
}

func TestEnterFirstHookDuplicateRegistrationIsRejected(t *testing.T) {
	isolateFirstEnterHooks(t)
	OnFirstEnter("reward", func(*Player, int64) error { return nil })
	defer func() {
		if recover() == nil {
			t.Fatal("duplicate registration accepted")
		}
	}()
	OnFirstEnter("reward", func(*Player, int64) error { return nil })
}
