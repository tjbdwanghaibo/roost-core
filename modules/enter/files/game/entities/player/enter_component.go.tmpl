package player

import (
	gamelogin "{{MODULE}}/game/login"
	db "{{MODULE}}/db"
	"{{MODULE}}/game/components/enter"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:Enter}}
const CompTypeEnter entity.ComponentType = {{ID:component:Enter}}

// EnterComponent 是进入组件 enter.Component 的类型别名，只为 Player 的生成接线命名。
// 初始化逻辑（Init / Existing / Create / Built）在 game/components/enter；这里只把 PlayerDao.Enter 与 Player 上的
// 钩子（enter_first.go 的 firstEnter、enter_hooks.go 的 OnFirstEnter / OnCreate）交给它。
type EnterComponent = enter.Component

// IEnterEntity 是 Nest handler 用这个组件时的窄实体接口；getter 由生成的 Entity 接线实现。
type IEnterEntity interface {
	entity.IThreadSafeEntity
	EnterComp() *EnterComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeEnter, enter.NewComponent)
}

// EnterState 实现 enter.Owner：只在 Player 被 Nest 锁住期间调用。
func (e *Player) EnterState() *db.EnterState { return e.Dao().GetEnter() }

// GrantFirstEnter 实现 enter.FirstEnterGranter：工程的 firstEnter（game/login/enter_first.go），然后是别的功能登记的钩子（gamelogin.OnFirstEnter）。
// Init 与 Create 都经它，所以两条路上发的东西一样；“只发一次”由组件在同一笔事务里置的标记保证。
func (e *Player) GrantFirstEnter(nowUnixMilli int64) error { return gamelogin.GrantFirstEnter(e, nowUnixMilli) }

// RunCreateHooks 实现 enter.CreateHooks：新建事务内的钩子（OnCreate）。
func (e *Player) RunCreateHooks(name string, nowUnixMilli int64) error { return gamelogin.RunCreateHooks(e, name, nowUnixMilli) }
