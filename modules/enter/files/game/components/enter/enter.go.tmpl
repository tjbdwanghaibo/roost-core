package enter

import (
	"fmt"

	db "{{MODULE}}/db"
	apperrors "{{MODULE}}/internal/errors"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

// InitResult 是首次初始化（Nest handler EnterInit）的结果。game/login 的 InitResult 是它的别名
// （放在组件包里，实体包接组件时不必 import game/login，game/login 因此可以 import 实体包而不成环）。
type InitResult struct {
	// First 为 true 表示这一次进入执行了首次初始化（新玩家）。
	First bool
	// FirstAtUnixMilli 是这名玩家首次初始化提交时的业务时间。首次与之后的每次进入都填同一个值，
	// 所以它可以当作“注册时间”用（例如全服邮件的“注册早于发送才收得到”）。
	FirstAtUnixMilli int64
}

// Owner 是进入组件的宿主：在自己的 DAO 里放一份 EnterState，并经这个方法交给组件
// （Player 的接线见 game/entities/player/enter_component.go）。组件不保存事务会改的状态：做过没有记在宿主 DAO 里，
// 经生成的 setter 修改，所以回滚只有 DAO 一处；不要在这里登记 undo。
type Owner interface {
	entity.IThreadSafeEntity
	EnterState() *db.EnterState
}

// FirstEnterGranter 是可选的宿主能力：首次初始化的发放（Player 上是工程的 firstEnter 与别的功能登记的
// OnFirstEnter 钩子）。没有实现它的宿主首次初始化不发任何东西。
type FirstEnterGranter interface {
	GrantFirstEnter(nowUnixMilli int64) error
}

// CreateHooks 是可选的宿主能力：新建事务内的钩子（Player 上是 OnCreate 登记的，例如把角色名写进档案）。
type CreateHooks interface {
	RunCreateHooks(name string, nowUnixMilli int64) error
}

// Component 是进入游戏时的初始化逻辑。实体包里的 EnterComponent 是它的类型别名，只为生成接线命名。
type Component struct {
	entity.ComponentBase
	owner Owner
}

// NewComponent 直接用作各实体的组件工厂；DAO 在实体构造时先于组件装好。
func NewComponent(value any, _ *entity.EntityCreateParam) (entity.ComponentInterfaceBase, error) {
	owner, ok := value.(Owner)
	if !ok {
		return nil, fmt.Errorf("enter component: owner %T does not implement enter.Owner", value)
	}
	return &Component{owner: owner}, nil
}

func (component *Component) Name() string { return "enter" }

// Owner 返回宿主，只在实体存活且被 Nest 锁住期间可用。
func (component *Component) Owner() Owner { return component.owner }

// Init 在“加载或创建”的进入里调用（EnterGame 的缺省那条路，每次进入都调）。首次初始化还没做过就执行
// firstEnter 并记下来，结果的 First 为 true；做过了就是一次普通的进入（entered）。
// 两种情况都带上首次初始化的时间（这名玩家的“注册时间”）。
//
// 不按“这次是不是新建的档”判断：建档与初始化是两步，中间进程崩了，这名玩家的档已经在、
// 初始化却没做。所以事实记在档里（PlayerDao.Enter.Initialized），每次进入都问一遍，
// 初始发放与这个标记在同一笔事务里：要么都提交，要么都回滚、下次进入再做。
func (component *Component) Init(nowUnixMilli int64) (InitResult, error) {
	state := component.owner.EnterState()
	if state.GetInitialized() {
		return component.entered(), nil
	}
	if err := component.grant(nowUnixMilli); err != nil {
		return InitResult{}, err
	}
	state.SetInitialized(true)
	state.SetFirstAt(nowUnixMilli)
	return InitResult{First: true, FirstAtUnixMilli: nowUnixMilli}, nil
}

// grant 是首次初始化的发放：工程自己的 firstEnter，然后是别的功能登记的钩子（OnFirstEnter）。
// Init 与 Create 都经它，所以两条路上发的东西一样；“只发一次”由调用方在同一笔事务里置的标记保证。
func (component *Component) grant(nowUnixMilli int64) error {
	if granter, ok := component.owner.(FirstEnterGranter); ok {
		return granter.GrantFirstEnter(nowUnixMilli)
	}
	return nil
}

// Existing 在“先新建”的会话的进入里调用：只进入已经建成的玩家。没建成（有档而首次初始化没做过——
// 上次新建到一半）返回 enter_need_create，不写任何字段；它与 Init 的区别只在这一句：这里不代建。
func (component *Component) Existing() (InitResult, error) {
	if !component.Built() {
		return InitResult{}, apperrors.ErrEnterNeedCreate
	}
	return component.entered(), nil
}

// entered 是已经建成的玩家的一次进入。经新建请求建成之后的第一次进入报 First=true 并清掉 Fresh，
// 所以依赖 First 的进入钩子在两条路上看到的一样：新玩家的第一次进入是 First，之后都不是。
// 清标记与这次进入的应答在同一笔事务里；应答丢了、客户端重发时 First 已经是 false——与“加载或创建”那条路
// 重发 EnterGame 的结果相同。
func (component *Component) entered() InitResult {
	state := component.owner.EnterState()
	result := InitResult{FirstAtUnixMilli: state.GetFirstAt()}
	if state.GetFresh() {
		state.SetFresh(false)
		result.First = true
	}
	return result
}

// Built 报告这名玩家建成了没有：首次初始化提交过。只读。
func (component *Component) Built() bool {
	return component.owner.EnterState().GetInitialized()
}

// Create 是新建请求（EnterCreate）的事务：把这名玩家建成。已经建成的返回 enter_created，不写任何字段。
//
// 顺序：事务内的新建钩子（OnCreate：名字写进档案）→ 首次初始化的发放（grant：firstEnter 与 OnFirstEnter 的钩子）→
// 记下“建成了”。任何一步返回错误整笔回滚，玩家仍是没建成，下一次新建请求从头再做，所以初始发放恰好发一次。
// 新建钩子排在发放之前：名字被拒时不必先发再撤。
func (component *Component) Create(name string, nowUnixMilli int64) error {
	if component.Built() {
		return apperrors.ErrEnterCreated
	}
	if hooks, ok := component.owner.(CreateHooks); ok {
		if err := hooks.RunCreateHooks(name, nowUnixMilli); err != nil {
			return err
		}
	}
	if err := component.grant(nowUnixMilli); err != nil {
		return err
	}
	state := component.owner.EnterState()
	state.SetInitialized(true)
	state.SetFirstAt(nowUnixMilli)
	state.SetFresh(true)
	return nil
}
