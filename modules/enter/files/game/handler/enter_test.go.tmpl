type enterGetter map[int64]entity.IThreadSafeEntity

func (g enterGetter) Get(_ context.Context, id int64, _ entity.EntityCategory) (entity.IThreadSafeEntity, error) {
	if e := g[id]; e != nil {
		return e, nil
	}
	return nil, fmt.Errorf("missing %d", id)
}

func (g enterGetter) GetMany(ctx context.Context, ids []int64, cats []entity.EntityCategory) ([]entity.IThreadSafeEntity, error) {
	out := make([]entity.IThreadSafeEntity, len(ids))
	for i, id := range ids {
		e, err := g.Get(ctx, id, cats[i])
		if err != nil {
			return nil, err
		}
		out[i] = e
	}
	return out, nil
}

// enterCommitter 是替身提交器：不落盘，reject 打开时拒绝提交，用来验证回滚。
type enterCommitter struct{ reject atomic.Bool }

func (c *enterCommitter) Commit(context.Context, dataengine.CommitRecord) error {
	if c.reject.Load() {
		return errors.New("injected rejection")
	}
	return nil
}

type enterFixture struct {
	engine    *nest.NestMgr
	player    *playerentity.Player
	inits     *sender.EnterInitSender
	committer *enterCommitter
	now       atomic.Int64
}

// newEnterFixture 用替身提交器起一个 Nest，玩家是一份全新的档。
// clock.SetSource 是进程级的：一个用例里只建一个 fixture。
func newEnterFixture(t *testing.T) *enterFixture {
	t.Helper()
	playerentity.RegisterEntity()
	RegisterEnterInitNestHandlers()
	f := &enterFixture{committer: &enterCommitter{}}
	f.now.Store(time.Date(2026, 11, 10, 9, 0, 0, 0, time.UTC).UnixMilli())
	clock.SetSource(func() time.Time { return time.UnixMilli(f.now.Load()) })
	t.Cleanup(func() { clock.SetSource(nil) })
	id, err := entity.BuildEntityID(94001, playerentity.EntityKindPlayer)
	if err != nil {
		t.Fatal(err)
	}
	built, err := entity.BuildEntity(&entity.EntityCreateParam{IsCreate: true, Id: id, Kind: playerentity.EntityKindPlayer})
	if err != nil {
		t.Fatal(err)
	}
	f.player = built.(*playerentity.Player)
	f.engine = nest.NewEngine(nest.NestOptionWithGetter(enterGetter{id: built}), nest.NestOptionWithTransactionCommitter(f.committer),
		nest.NestOptionWithWorkerPools(nest.WorkerPoolConfig{Workers: 2, QueueCap: 64}, nest.WorkerPoolConfig{}, nest.WorkerPoolConfig{}))
	if err := f.engine.Start(); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := f.engine.Shutdown(context.Background()); err != nil {
			t.Error(err)
		}
	})
	f.inits = sender.NewEnterInitSender(f.engine)
	return f
}

func (f *enterFixture) init() (bool, error) {
	return f.inits.Sync_EnterInit(context.Background(), f.player.ID())
}

// snapshot 在业务 worker 上持实体锁读记录。
func (f *enterFixture) snapshot(t *testing.T) (initialized bool, firstAt int64) {
	t.Helper()
	if err := f.engine.RunLocal(context.Background(), func() {
		f.player.GetMutex().Lock()
		defer f.player.GetMutex().Unlock()
		state := f.player.Dao().GetEnter()
		initialized, firstAt = state.GetInitialized(), state.GetFirstAt()
	}); err != nil {
		t.Fatal(err)
	}
	return initialized, firstAt
}

func TestEnterFirstTimeRunsTheInitialization(t *testing.T) {
	f := newEnterFixture(t)
	start := f.now.Load()
	first, err := f.init()
	if err != nil || !first {
		t.Fatalf("first enter: first=%v err=%v", first, err)
	}
	if initialized, firstAt := f.snapshot(t); !initialized || firstAt != start {
		t.Fatalf("initialized=%v firstAt=%d, want true and %d", initialized, firstAt, start)
	}
}

func TestEnterAgainDoesNothing(t *testing.T) {
	f := newEnterFixture(t)
	start := f.now.Load()
	if _, err := f.init(); err != nil {
		t.Fatal(err)
	}
	f.now.Add(int64(48 * time.Hour / time.Millisecond))
	for i := 0; i < 3; i++ {
		if first, err := f.init(); err != nil || first {
			t.Fatalf("enter %d after the first: first=%v err=%v", i+2, first, err)
		}
	}
	if _, firstAt := f.snapshot(t); firstAt != start {
		t.Fatalf("firstAt moved to %d, want %d", firstAt, start)
	}
}

// 初始化的提交被拒绝：标记一起回滚，下一次进入重新做。建档之后、初始化之前出事的玩家靠这条补上。
func TestEnterRejectedInitializationIsDoneOnTheNextEnter(t *testing.T) {
	f := newEnterFixture(t)
	f.committer.reject.Store(true)
	if _, err := f.init(); err == nil {
		t.Fatal("a rejected commit reported success")
	}
	if initialized, firstAt := f.snapshot(t); initialized || firstAt != 0 {
		t.Fatalf("rollback left initialized=%v firstAt=%d", initialized, firstAt)
	}
	f.committer.reject.Store(false)
	if first, err := f.init(); err != nil || !first {
		t.Fatalf("enter after the rollback: first=%v err=%v", first, err)
	}
}
