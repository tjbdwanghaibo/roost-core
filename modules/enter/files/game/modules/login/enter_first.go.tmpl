package login

import (
	"{{MODULE}}/game/event"
	"{{MODULE}}/game/view"
)

// firstEnter 是新玩家的初始化：这名玩家第一次进入游戏时执行一次，与“做过了”的标记同一笔事务。
//
// 这个文件归工程所有，初始发放就写在这里。同一个实体上别的组件直接调，例如：
//
//	if _, err := host.Wallet().Add(100); err != nil { // 装了 wallet 模块时：送 100 金币
//		return err
//	}
//
// 用不留回执的入口（wallet 的 Add）：只发一次由 Init 的标记保证。返回错误时整笔事务回滚，
// 这名玩家下次进入会再执行一遍，所以这里不要做事务之外的事（发消息、调别的服务）。
func firstEnter(host view.PlayerEntity, nowUnixMilli int64) error {
	_ = host
	_ = nowUnixMilli
	return nil
}

// GrantFirstEnter 是首次初始化的发放：工程自己的 firstEnter，然后在 Player 上发布实体事件 event.EnterFirst
// （别的功能在自己的组件或 Player 的方法上用 //roost:listen 监听，按 priority 排好顺序）。Player 的宿主方法
// GrantFirstEnter（game/entities/player/enter.go）经它实现 view.EnterHolder；Init 与 Create 都经它，所以两条路上发的东西一样。
// 监听返回的错误原样返回，交给 Nest 整笔回滚。
func GrantFirstEnter(host view.PlayerEntity, nowUnixMilli int64) error {
	if err := firstEnter(host, nowUnixMilli); err != nil {
		return err
	}
	return host.Publish(event.EnterFirst{NowUnixMilli: nowUnixMilli})
}
