package profile

import "{{MODULE}}/game/event"

// OnEnterFirst 在新玩家首次初始化的那笔事务里设初始 1 级（profile 把 enter 作为依赖时，初始等级与 Enter.Initialized
// 一起提交）。直接 BuildEntity 只是分配空 DAO，不是完成角色建档；默认值不能在构造函数里绕过 Nest 写持久字段。
// 初始等级不是一次升级：不发经验、不发布升级事件；重复进入由 Enter 的标记守卫。
//
// priority=20 保持改成事件之前的执行顺序：原来的首次初始化钩子按登记名字母序执行（activity、casual、profile、
// profile.attribute），初始等级排在属性之前，属性按写好的等级建立。
//
//roost:listen priority=20
func (component *Component) OnEnterFirst(ev event.EnterFirst) error {
	state := component.owner.Dao().GetProfile()
	if state.GetLevel() == 0 {
		state.SetLevel(1)
	}
	return nil
}
