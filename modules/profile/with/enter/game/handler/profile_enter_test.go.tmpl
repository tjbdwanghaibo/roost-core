package handler

import (
	"context"
	"sync/atomic"
	"testing"

	db "{{MODULE}}/db"
	player "{{MODULE}}/game/entities/player"
	sender "{{MODULE}}/game/handler/syncsender"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

var profileEnterLevelUps atomic.Int64

func init() {
	player.OnProfileLevelUp("zz_profile_enter_test", func(*player.ProfileComponent, int32, int32) error {
		profileEnterLevelUps.Add(1)
		return nil
	})
}

func profileEnter(t *testing.T, f *profileFixture) error {
	t.Helper()
	RegisterEnterInitNestHandlers()
	_, err := sender.NewEnterInitSender(f.engine).Sync_EnterInit(context.Background(), f.player.ID())
	return err
}
func TestWithProfileEnterStartsAtLevelOne(t *testing.T) {
	f := newProfileFixture(t)
	beforeHooks := profileEnterLevelUps.Load()
	if err := profileEnter(t, f); err != nil {
		t.Fatal(err)
	}
	if got := f.facts(t); got.level != 1 || got.exp != 0 || got.commits != 1 {
		t.Fatalf("initial profile=%+v", got)
	}
	if profileEnterLevelUps.Load() != beforeHooks {
		t.Fatal("initial level triggered an upgrade hook")
	}
	// 初始一级与升级一次不同：首个100经验之后是2级、返回升了1级。
	f.mustAddExp(t, 100, 1)
	if got := f.facts(t); got.level != 2 || got.exp != 0 {
		t.Fatalf("upgrade after creation=%+v", got)
	}
}
func TestWithProfileEnterReplayKeepsProgress(t *testing.T) {
	f := newProfileFixture(t)
	if err := profileEnter(t, f); err != nil {
		t.Fatal(err)
	}
	f.mustAddExp(t, 250, 2)
	before := f.facts(t)
	if err := profileEnter(t, f); err != nil {
		t.Fatal(err)
	}
	if got := f.facts(t); got != before || got.level != 3 || got.exp != 50 {
		t.Fatalf("reentry=%+v before=%+v", got, before)
	}
}
func TestWithProfileEnterRejectedCreationCanRetry(t *testing.T) {
	f := newProfileFixture(t)
	f.committer.reject.Store(true)
	if err := profileEnter(t, f); err == nil {
		t.Fatal("rejected creation accepted")
	}
	f.committer.reject.Store(false)
	if got := f.facts(t); got.level != 0 || got.exp != 0 || got.commits != 0 {
		t.Fatalf("rollback=%+v", got)
	}
	if err := profileEnter(t, f); err != nil {
		t.Fatal(err)
	}
	if got := f.facts(t); got.level != 1 || got.commits != 1 {
		t.Fatalf("retry=%+v", got)
	}
}
func TestWithProfileEnterReloadKeepsStoredLevel(t *testing.T) {
	f := newProfileFixture(t)
	if err := profileEnter(t, f); err != nil {
		t.Fatal(err)
	}
	f.mustAddExp(t, 250, 2)
	var raw []byte
	if err := f.engine.RunLocal(context.Background(), func() {
		f.player.GetMutex().Lock()
		defer f.player.GetMutex().Unlock()
		raw = f.player.Dao().Marshal()
	}); err != nil {
		t.Fatal(err)
	}
	stored := db.NewPlayerDao()
	if err := stored.RestorePersisted(raw, db.PlayerDaoSchemaVersion, 1); err != nil {
		t.Fatal(err)
	}
	loaded, err := entity.BuildEntity(&entity.EntityCreateParam{IsCreate: false, Id: f.player.ID(), Kind: player.EntityKindPlayer, Dao: map[string]entity.DaoInterface{db.PlayerDaoCollection: stored}})
	if err != nil {
		t.Fatal(err)
	}
	p := loaded.(*player.Player)
	var level int32
	var exp int64
	var initialized bool
	if err := f.engine.RunLocal(context.Background(), func() {
		p.GetMutex().Lock()
		defer p.GetMutex().Unlock()
		level = p.ProfileComp().Level()
		exp = p.ProfileComp().Exp()
		initialized = p.Dao().GetEnter().GetInitialized()
	}); err != nil {
		t.Fatal(err)
	}
	if level != 3 || exp != 50 || !initialized {
		t.Fatal("loaded profile was reset")
	}
}
