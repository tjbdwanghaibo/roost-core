package login

import (
	"{{MODULE}}/game/view"
)

// profile 把 enter 作为依赖，所有新角色的初始等级与 Enter.Initialized 在同一笔建档事务里写入。
// 直接 BuildEntity 只是分配空 DAO，不是完成角色建档。默认值不能在构造函数里绕过 Nest 写持久字段。
func init() {
	OnFirstEnter("profile", func(owner view.PlayerEntity, _ int64) error {
		state := owner.Dao().GetProfile()
		if state.GetLevel() == 0 {
			state.SetLevel(1)
		}
		// 初始等级不是一次升级，不发经验、不调用升级钩子；重复进入由 Enter 的事实守卫。
		return nil
	})
}
