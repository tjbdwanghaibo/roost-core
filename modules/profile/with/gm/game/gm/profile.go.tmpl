package gm

import (
	"context"
	"log/slog"

	player "{{MODULE}}/game/entities/player"
	syncsender "{{MODULE}}/game/handler/syncsender"

	"github.com/tjbdwanghaibo/roost-core/framework/app"
	"github.com/tjbdwanghaibo/roost-core/infra/observe/admin"
)

const CommandAddExp = "gm.player.add_exp"

func init() {
	Register(ProfileAddExpCommand(func(ctx context.Context, registry *app.Registry, full, amount int64) (int32, error) {
		client, err := nestClient(registry)
		if err != nil {
			return 0, err
		}
		return syncsender.NewProfileAddExpSender(client).Sync_ProfileAddExp(ctx, full, amount)
	}))
}

// ProfileAddExpCommand 共用解析与响应；项目需要额外事务参与者时，只替换 grant，不能在回调里直接改 DAO。
// grant 必须调用项目的 Nest Sender；不判重，未知结果不能盲目重试。
func ProfileAddExpCommand(grant func(context.Context, *app.Registry, int64, int64) (int32, error)) Definition {
	return Definition{Name: CommandAddExp, Description: "加经验：{player_id, amount, note}；不自动重试", Handler: func(ctx context.Context, registry *app.Registry, command admin.Command) (admin.Result, error) {
		payload, err := Decode[struct {
			Audit
			PlayerID int64 `json:"player_id"`
			Amount   int64 `json:"amount"`
		}](command)
		if err != nil {
			return admin.Result{}, err
		}
		unique, full, err := PlayerIDs(payload.PlayerID, player.EntityKindPlayer)
		if err != nil {
			return admin.Result{}, err
		}
		if payload.Amount <= 0 {
			return admin.Result{}, Invalid("amount must be positive")
		}
		if grant == nil {
			return admin.Result{}, Invalid("grant handler is required")
		}
		gained, err := grant(ctx, registry, full, payload.Amount)
		if err != nil {
			return admin.Result{}, err
		}
		if gained > 0 {
			slog.InfoContext(ctx, "profile: level gain confirmed", "player_id", unique, "trace_id", command.TraceID, "levels_gained", gained, "exp_granted", payload.Amount)
		}
		return admin.Result{Data: map[string]any{"player_id": unique, "entity_id": full, "levels_gained": gained}}, nil
	}}
}
