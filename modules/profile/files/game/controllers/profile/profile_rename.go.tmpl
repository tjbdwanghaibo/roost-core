package profile

import (
	"github.com/tjbdwanghaibo/roost-core/infra/base/errcode"
	"{{MODULE}}/game/playeraccess"
	profilelogic "{{MODULE}}/game/profile"
	"{{MODULE}}/protocol/pb"
)

// HandleProfileRename 是改名协议的入口；改的是认证会话的玩家，名字的规则在 Nest handler 的锁内校验，
// 被拒绝时业务码经生成的转交代码写进回包的 Code / Reason。
//
//roost:endpoint nest=ProfileRename
func (controller *Controller) HandleProfileRename(ctx *playeraccess.Context, req *pb.ProfileRenameRequest) (*pb.ProfileRenameResponse, error) {
	if ctx != nil && req != nil {
		if name, handled, err := profilelogic.Rename(ctx.Context(), controller.registry, ctx.PlayerID, req.Name); handled {
			response := &pb.ProfileRenameResponse{Name: name}
			if err != nil {
				response.Code, response.Reason = errcode.ClientError(err)
			}
			return response, nil
		}
	}
	return controller.dispatchProfileRename(ctx, req)
}
