package handler

import player "{{MODULE}}/game/entities/player"

// handlerProfileCard 在这名玩家的锁内读名片（名字与等级），值带出来，实体不带出来。不对客户端开放：
// 没有协议也没有端点，由服务端代码经生成的 Sender（syncsender.NewProfileCardSender）按玩家号调用——
// 匹配按等级计分、榜单与好友列表显示名字都用它。只读，不写任何字段，不产生提交。
//
// 名片里只有别的玩家也可以看的那一半（PlayerDao.Profile）；经验只给本人，这里不带。
//
//roost:nest
func handlerProfileCard(target player.IProfileEntity) (player.ProfileCard, error) {
	return target.ProfileComp().Card(), nil
}
