package profile

import (
	"context"
	"fmt"
	"github.com/tjbdwanghaibo/roost-core/framework/app"
)

// Renamer 是事务之外的可选正式改名入口；只在 init 登记，之后只读。
type Renamer func(context.Context, *app.Registry, int64, string) (string, error)

var rename Renamer

func RegisterRenamer(fn Renamer) {
	if fn == nil || rename != nil {
		panic("profile: invalid or duplicate renamer")
	}
	rename = fn
}
func Rename(ctx context.Context, r *app.Registry, id int64, name string) (string, bool, error) {
	if rename == nil {
		return "", false, nil
	}
	if r == nil {
		return "", true, fmt.Errorf("profile: registry required")
	}
	value, err := rename(ctx, r, id, name)
	return value, true, err
}

// HasRenamer 报告有没有登记事务之外的改名入口（装了 naming 时有）。没有时名字直接在事务里写进档案。
func HasRenamer() bool { return rename != nil }

// SwapRenamer 换掉已登记的改名入口并返回原来的（可以是 nil）。给场景测试临时换掉或去掉它用；
// 业务代码用 RegisterRenamer。
func SwapRenamer(fn Renamer) Renamer {
	previous := rename
	rename = fn
	return previous
}
