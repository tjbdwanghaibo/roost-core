)

// Profile 是驱动器对玩家档的三个写入，每个都是 Player 上的一笔 Nest 事务（game/handler 的
// RehomePrepare / RehomeCancel / RehomeArrive）。写成接口是因为这个包不能 import Nest 的 Sender
// （Sender 的包 import 各个功能的结果类型）；实现在 game/controllers/rehome.go。
type Profile interface {
	// Prepare 在一笔事务里核对规则与事务内的检查并记下换服意图。拒绝时什么都没写。按换服 ID 幂等。
	Prepare(ctx context.Context, move Move) error
	// Recheck 在一笔事务里把事务内的换服前检查再跑一遍（不看规则与冷却，不写任何东西）。
	// 驱动器在这名玩家安静下来之后、离开钩子之前调用：申请时通过的检查，到这时未必还成立。
	Recheck(ctx context.Context, move Move) error
	// Cancel 清掉这个换服 ID 的意图；档里的意图不是这个 ID 时什么都不做。
	Cancel(ctx context.Context, playerID int64, transferID string) error
	// Arrive 看一眼档里的意图：指向 sid（本服）的做到达，指向别的服的原样报回来。
	Arrive(ctx context.Context, playerID int64, sid int32) (ArriveResult, error)
}

// DriverConfig 是 Driver 的依赖。
type DriverConfig struct {
	Registry *app.Registry
	// Self 是本进程的 sid。
	Self      int32
	Directory Directory
	Residency Residency
	Profile   Profile
	// EntityID 把玩家号换成他的 Player 的完整 Entity ID。
	EntityID func(playerID int64) (int64, error)
	// Documents 搬他的文档（本服库 → 目标服库）；nil 时经 Registry 里的 DataEngine Mod（RegistryDocuments）。
	Documents Documents
}

// 一步的时间预算。受理之后的步骤在后台执行，用的是自己的预算，不是申请那条请求的。
const (
	// callBudget 是一次 Directory 调用或一笔 Nest 事务的上限。
	callBudget = 5 * time.Second
	// leaveBudget 是全部离开钩子合起来的上限。
	leaveBudget = 10 * time.Second
	// departBudget 是断开会话加交出实体的上限：交出要等这名玩家已准入的写入落库、WAL checkpoint 盖过它们。
	departBudget = 30 * time.Second
	// copyAttempts 是受理之后搬档最多做几次：复制可以原样重做，出错（含提交应答丢失、结果未知）先重做，
	// 拿到确定的结果再往下走。
	copyAttempts = 3
	// replyGrace 是受理之后、断开会话之前留给“已受理”这条应答写到客户端的时间。应答丢了也不影响结果
	// （客户端断线后重新选角就知道），所以它只是让客户端多数时候能先看到应答。
	replyGrace = 500 * time.Millisecond
	// retryCeiling 是结果未知时两次重发之间等待的上限。
	retryCeiling = 30 * time.Second
)

// Driver 把一次换服从申请走到结论。它没有自己的状态：在途的换服记在 Residency 的迁出表里，
// 所以一个进程里有几个 Driver 都指向同一张表也无妨。
//
// 顺序（源服一侧；到达在目标服，见 Arrive）：
//
//	申请的请求里：
//	  读绑定      Directory.Binding：拿到绑定代数；已经在换服答 rehome_moving，不归本服答 rehome_elsewhere
//	  打标记      Residency.Reserve：“离开中”。从这里起本进程对这名玩家的进入与后台步骤都答“换服中”
//	  换服前检查  登记的事务外检查（OnApplying）
//	  记意图      Profile.Prepare：规则、事务内检查、PlayerDao.Rehome 的意图，同一笔事务
//	  发起        Directory.Begin：account 登记换服、占住目标服的名额
//	  —— 到这里答复“已受理”（Ticket）。前面任何一步不成：撤标记、清意图，答复拒绝的原因 ——
//	后台：
//	  安静下来    Residency.Quiesce：断开会话，等标记之前已经准入的请求执行完
//	  复核        Profile.Recheck：事务内的换服前检查再跑一遍
//	  离开钩子    登记的 OnLeaving：这时读到的事实不会再被他自己的请求改掉
//	  交出        Residency.Depart：交出实体，屏障保持
//	  搬档        Documents.Copy(overwrite)：他的 dbscope=sid 文档从本服库复制到目标服库
//	  提交        Directory.Commit：account 改绑到目标服
//	  落定        Residency.Settle(Committed)：迁出表记“已迁走”；Documents.Drop 删掉本服库里的那几份
//
// 受理之后每一步失败的去向：
//
//   - 安静不下来（在途的请求在预算内没有执行完）、复核不过、离开钩子失败、交出失败（实体被占用、超时）、
//     搬档失败（写目标库失败；复制在一个 Mongo 事务里，失败时目标库没有半份）：
//     Directory.Abort，然后 Settle(Aborted)（撤屏障与标记、
//     断开仍连着的会话）、清意图。玩家留在本服，可以再申请。
//   - Commit 明确说没有改绑（这个 ID 已被运维中止）：同上。
//   - Commit 明确拒绝（目标服在此期间被删除或并入别的服、名额没了）：先 Abort，再同上。
//   - Commit 或 Abort 结果未知（超时、account 不可用）：标记与屏障都保持，原样重发，直到 account 给出结论；
//     以它的回答为准——Abort 得到“已经提交”就按已提交落定。期间这名玩家在哪个服都进不去，
//     因为没有人知道他归谁。
//   - 进程在受理之后崩溃：迁出表没了，account 上换服仍在途。重启后这名玩家再来进入本服时，
//     Admit 发现“在途、源服是本服、表里没有”，从离开钩子起把后台部分重做一遍（Resume）。
//   - 进程停机：后台部分在 Background 里执行（game/managers 的 rehome manager 启停，D22）。停机时它取消在途步骤的 ctx：
//     每一步、每一次重发之间的等待都看这个 ctx，被取消的步骤**不按失败处理**（不中止、不撤屏障），只是停下——
//     与在那一刻崩溃相同，重启之后按上一条接着做。停机期间新的申请答可重试（Background 不在时不受理）。
//
// 提交之前实体已经交出、文档已经搬到目标库：从交出成立到提交之间没有任何进程能写这名玩家；提交之后只有目标服能写。
// 中止时（撤屏障之前）删掉这次写到目标库的副本。
type Driver struct {
	registry  *app.Registry
	self      int32
	directory Directory
	residency Residency
	profile   Profile
	documents Documents
	entityID  func(playerID int64) (int64, error)

	// background 执行受理之后的后台部分（Background，由 game/managers 的 rehome manager 启停）。
	background backgroundRunner

	// 下面几项给测试替换：换服 ID 的来源、结果未知时两次重发之间怎么等（ctx 结束时提前返回）、应答的宽限。
	newID func() string
	wait  func(ctx context.Context, attempt int)
	grace time.Duration
}

// NewDriver 检查依赖齐全并返回 Driver。
func NewDriver(config DriverConfig) (*Driver, error) {
	switch {
	case config.Self <= 0:
		return nil, fmt.Errorf("rehome driver: sid is %d", config.Self)
	case config.Directory == nil || config.Residency == nil || config.Profile == nil || config.EntityID == nil:
		return nil, errors.New("rehome driver: directory, residency, profile and entity id are required")
	}
	documents := config.Documents
	if documents == nil {
		documents = RegistryDocuments(config.Registry)
	}
	driver := &Driver{
		registry: config.Registry, self: config.Self, directory: config.Directory,
		residency: config.Residency, profile: config.Profile, documents: documents, entityID: config.EntityID,
		background: registryBackground{registry: config.Registry},
		wait: func(ctx context.Context, attempt int) {
			pause(ctx, min(time.Second<<min(attempt, 5), retryCeiling))
		},
		grace: replyGrace,
	}
	driver.newID = func() string {
		var random [12]byte
		_, _ = rand.Read(random[:])
		return "rh" + strconv.FormatInt(int64(config.Self), 10) + "-" + hex.EncodeToString(random[:])
	}
	return driver, nil
}

// Self 是这个 Driver 所在进程的 sid。
func (d *Driver) Self() int32 { return d.self }

// pause 等 wait 那么久，ctx 先结束就提前返回。
func pause(ctx context.Context, wait time.Duration) {
	timer := time.NewTimer(wait)
	defer timer.Stop()
	select {
	case <-timer.C:
	case <-ctx.Done():
	}
}

// spawn 把一个后台步骤交给 Background。交不出去（进程在停机、manager 没有登记）时不执行，记一条日志：
// 与进程在这一刻崩溃相同，迁出表随进程没了，重启之后这名玩家再来进入时由 Admit 接着做（Resume）。
func (d *Driver) spawn(move Move, step string, run func(ctx context.Context)) {
	if err := d.background.Go(run); err != nil {
		slog.Warn("rehome: a background step was not started; the transfer is picked up again when the player enters after a restart",
			"player_id", move.PlayerID, "transfer_id", move.ID, "step", step, "err", err)
	}
}

// stopped 报告后台步骤是不是因为 Background 停了才结束（ctx 被取消）：这时不按失败处理，只是停下，记一条日志。
func stopped(ctx context.Context, move Move, step string) bool {
	if ctx.Err() == nil {
		return false
	}
	slog.Info("rehome: stopping with the process; the transfer is picked up again when the player enters after a restart",
		"player_id", move.PlayerID, "transfer_id", move.ID, "step", step)
	return true
}

// Apply 申请一次换服，走到“已受理”为止并返回 Ticket；其后的步骤在后台继续，结论不经它返回。
// 协议端点与服务端入口（GM、运维）都调它，区别只在 Request.Operator。
//
// 返回的错误：
//
//   - rehome_refused：目标不是另一个服、规则或登记的检查否决、account 拒绝发起（目标服不存在、没开、
//     账号在那里已有角色……）。rehome_cooldown：冷却中。检查给了自己的业务码时是那个码。
//   - rehome_moving：这名玩家已经有一次换服在途。rehome_elsewhere：他不归本服。
//   - retryable：没有执行，可以原样再申请（account 一时问不到）。
//   - 其余：发起的结果未知。标记留着，后台在向 account 要结论，期间再申请会得到 rehome_moving。
//
// 任何一种错误返回时玩家都留在本服、档里没有留下这一次的意图（清不掉的留给下一次进入对账）。
func (d *Driver) Apply(ctx context.Context, request Request) (Ticket, error) {
	if ctx == nil {
		ctx = context.Background()
	}
	playerID := request.PlayerID
	if playerID <= 0 {
		return Ticket{}, fmt.Errorf("rehome: player id %d is not valid", playerID)
	}
	if request.To <= 0 || request.To == d.self {
		return Ticket{}, refused(nil, fmt.Sprintf("target server %d is not another server (this is %d)", request.To, d.self))
	}
	entityID, err := d.entityID(playerID)
	if err != nil {
		return Ticket{}, fmt.Errorf("rehome: %w", err)
	}
	// 受理之后的步骤要有人做：后台执行者不在（manager 没登记、进程在停机）时什么都不做，答可重试。
	if err := d.background.Ready(); err != nil {
		slog.Error("rehome: refusing to start a transfer; nobody would carry it after it is accepted", "player_id", playerID, "err", err)
		return Ticket{}, errcode.Wrap(errcode.ErrRetryable, err, "player_id", playerID)
	}
	binding, err := d.directory.Binding(ctx, playerID)
	switch {
	case classify(err) == answerRefused:
		return Ticket{}, errcode.Wrap(apperrors.ErrRehomeRefused, err, "player_id", playerID)
	case err != nil:
		return Ticket{}, errcode.Wrap(errcode.ErrRetryable, err, "player_id", playerID)
	case binding.Transfer != nil:
		return Ticket{}, Moving(playerID, binding.Transfer.To)
	case binding.ServingServerID != d.self:
		return Ticket{}, Elsewhere(playerID, binding.ServingServerID)
	}
	if where, tracked := d.residency.Where(playerID); tracked && !where.Moving {
		// 迁出表记着他从本进程换走过，account 说他现在归本服：他换回来了，先把旧记录与屏障撤掉。
		returned, err := readmit(ctx, d.residency, d.self, where, binding)
		if err != nil {
			return Ticket{}, errcode.Wrap(errcode.ErrRetryable, err, "player_id", playerID)
		}
		if !returned {
			return Ticket{}, Elsewhere(playerID, where.Move.To)
		}
	}
	move := Move{
		PlayerID: playerID, EntityID: entityID, ID: d.newID(),
		From: d.self, To: request.To, Epoch: binding.BindEpoch, Operator: request.Operator,
	}
	if err := d.residency.Reserve(move); err != nil {
		return Ticket{}, err
	}
	if err := runApplying(ctx, d.registry, move); err != nil {
		d.withdraw(ctx, move, false)
		return Ticket{}, refused(err, "refused by a check")
	}
	if err := d.profile.Prepare(ctx, move); err != nil {
		// 事务的结果也可能是未知的（等结果超时、稍后仍然提交）：意图按 ID 清一次，清不到也无妨。
		d.withdraw(ctx, move, true)
		return Ticket{}, err
	}
	// 发起带上开头读到的绑定代数与换服尝试序号：读到之后 account 上有别的发起或中止落了地，这个请求就过期了
	// （answerStale）。序号也是“中止拿确定结论”的依据——见 beginUnknown。
	begun, err := d.directory.Begin(ctx, playerID, svcaccount.TransferRequest{
		ID: move.ID, FromSID: d.self, To: move.To, ExpectEpoch: move.Epoch, ExpectSeq: binding.TransferSeq, Note: request.Note,
	})
	kind := classify(err)
	if kind == answerStale || kind == answerInProgress {
		// 拒绝带回了当前绑定：开头读到之后他已经被换去了别的服（运维在别处提交了一次）。
		// 这时不能只撤标记了事——本服不该再为他服务，按“已迁走”落定。
		if bound(begun) && judge(move, d.self, begun) == standingGone {
			move.To = begun.ServingServerID
			d.spawn(move, "settle gone", func(ctx context.Context) { d.settleGone(ctx, move, nil) })
			return Ticket{}, Elsewhere(playerID, move.To)
		}
	}
	switch kind {
	case answerDone:
	case answerInProgress:
		d.withdraw(ctx, move, true)
		return Ticket{}, Moving(playerID, 0)
	case answerStale, answerRefused:
		d.withdraw(ctx, move, true)
		return Ticket{}, errcode.Wrap(apperrors.ErrRehomeRefused, err, "player_id", playerID, "to", move.To)
	default:
		return Ticket{}, d.beginUnknown(ctx, move, err)
	}
	slog.Info("rehome: accepted", "player_id", playerID, "transfer_id", move.ID, "from", move.From, "to", move.To, "operator", move.Operator)
	d.spawn(move, "carry", func(ctx context.Context) { d.carry(ctx, move) })
	return Ticket{ID: move.ID, From: move.From, To: move.To}, nil
}

// Resume 把一次已经在 account 登记、却没有在本进程里走完的换服接着做完：从离开钩子起重做后台部分。
// 用在源服重启之后（迁出表没了，account 上换服仍在途）。表里已经有这名玩家时什么都不做——有人正在做。
func (d *Driver) Resume(move Move) error {
	if move.EntityID == 0 {
		entityID, err := d.entityID(move.PlayerID)
		if err != nil {
			return fmt.Errorf("rehome: %w", err)
		}
		move.EntityID = entityID
	}
	if err := d.background.Ready(); err != nil {
		return err
	}
	if err := d.residency.Reserve(move); err != nil {
		return err
	}
	slog.Info("rehome: resuming a transfer this process did not finish", "player_id", move.PlayerID, "transfer_id", move.ID, "to", move.To)
	d.spawn(move, "carry", func(ctx context.Context) { d.carry(ctx, move) })
	return nil
}

// beginUnknown 处理发起的结果未知：直接中止这个 ID 拿确定结论。account 对一个没发起成的 ID 也接受中止，
// 并从此不让它再发起，所以中止成了就能肯定地说“没有换服在途”。这个结论不会过期：account 每记下一次中止
// 就把换服尝试序号加 1，那个迟到的发起带的是旧序号，之后这名玩家再换几次服、再中止几次，它都发起不了。
// 连中止的结果也不知道时，标记留着，后台接着问。
//
// “中止成了”本身不是结论（account 对不认识的 ID 也答成功）：结论是中止带回的绑定——他仍绑定在本服、
// 这个 ID 不在途，才撤标记、答可重试。带回的绑定说他归别的服时按“已迁走”落定；判断不了的与中止未知同样处理。
func (d *Driver) beginUnknown(ctx context.Context, move Move, beginErr error) error {
	aborting, cancel := context.WithTimeout(context.WithoutCancel(ctx), callBudget)
	binding, abortErr := d.directory.Abort(aborting, move.PlayerID, move.ID, "the outcome of begin is unknown")
	verdict := standingUnknown
	if classify(abortErr) != answerUnknown {
		verdict = d.verdict(aborting, move, binding)
	}
	cancel()
	switch verdict {
	case standingStays, standingReturned:
		d.withdraw(ctx, move, true)
		return errcode.Wrap(errcode.ErrRetryable, beginErr, "player_id", move.PlayerID)
	case standingGone:
		move.To = binding.ServingServerID
		d.spawn(move, "settle gone", func(ctx context.Context) { d.settleGone(ctx, move, nil) })
		return Elsewhere(move.PlayerID, move.To)
	}
	slog.Error("rehome: the outcome of begin is unknown and so is the abort; asking until the account service answers",
		"player_id", move.PlayerID, "transfer_id", move.ID, "begin_err", beginErr, "abort_err", abortErr)
	d.spawn(move, "abandon", func(ctx context.Context) { d.abandon(ctx, move, Kept, "the outcome of begin is unknown") })
	// 不带业务码地答回去（%v，不是 %w）：这不是 account 的某一种拒绝，客户端不该看到它的码。
	return fmt.Errorf("rehome: begin transfer %s of player %d: outcome unknown: %v", move.ID, move.PlayerID, beginErr)
}

// carry 是受理之后的后台部分：安静下来 → 复核 → 离开钩子 → 交出 → 提交 → 落定。
//
// 为什么是这个顺序：申请时的检查（事务内、事务外）只说明“那一刻可以换”。从那一刻到交出实体之间，
// 这名玩家的状态还会变——标记之前已经准入的请求还在执行（它可能正在加入一个公会），别的服务的通知还在路上。
// 所以先让他安静下来（Quiesce：断开会话，等标记之前准入的请求执行完；标记之后的新请求从 Reserve 起就被
// 写闸门拒绝），再做两件事：把事务内的检查重跑一遍（Recheck，读的是他自己的档，这时已经没有他自己的请求会改它），
// 然后跑离开钩子（事务外：可以去问别的服务里关于他的权威事实）。任何一步不成都中止这一次换服。
// 之后才交出实体、提交。
//
// 安静之后仍会变的只有“不经本进程里他自己的请求”的那些事——别的玩家、别的服务主动改他的状态。
// 它们拦不住，也不该由这里拦：需要的功能在离开钩子里向权威问清楚，并接受“问过之后又变了”要靠权威那一侧处理。
func (d *Driver) carry(ctx context.Context, move Move) {
	if d.grace > 0 {
		pause(ctx, d.grace)
	}
	if stopped(ctx, move, "reply grace") {
		return
	}
	quiescing, cancel := context.WithTimeout(ctx, departBudget)
	err := d.residency.Quiesce(quiescing, move)
	cancel()
	if err != nil {
		if stopped(ctx, move, "quiesce") {
			return
		}
		slog.Warn("rehome: the player's running requests did not finish; aborting", "player_id", move.PlayerID, "transfer_id", move.ID, "err", err)
		d.abandon(ctx, move, Aborted, "requests admitted before the move did not finish")
		return
	}
	rechecking, cancel := context.WithTimeout(ctx, callBudget)
	err = d.profile.Recheck(rechecking, move)
	cancel()
	if err != nil {
		if stopped(ctx, move, "recheck") {
			return
		}
		slog.Warn("rehome: a check that passed when the move was applied for no longer holds; aborting", "player_id", move.PlayerID, "transfer_id", move.ID, "err", err)
		d.abandon(ctx, move, Aborted, fmt.Sprintf("recheck: %v", err))
		return
	}
	leaving, cancel := context.WithTimeout(ctx, leaveBudget)
	err = runLeaving(leaving, d.registry, move)
	cancel()
	if err != nil {
		if stopped(ctx, move, "leave hooks") {
			return
		}
		slog.Warn("rehome: a leave hook refused; aborting", "player_id", move.PlayerID, "transfer_id", move.ID, "err", err)
		d.abandon(ctx, move, Aborted, err.Error())
		return
	}
	departing, cancel := context.WithTimeout(ctx, departBudget)
	err = d.residency.Depart(departing, move)
	cancel()
	if err != nil {
		if stopped(ctx, move, "depart") {
			return
		}
		slog.Warn("rehome: the player did not leave this process; aborting", "player_id", move.PlayerID, "transfer_id", move.ID, "err", err)
		d.abandon(ctx, move, Aborted, "the source server could not hand the player off")
		return
	}
	// 搬档：account 仍把他绑在本服（换服在途），只有本服写过他——目标库里别的版本是旧副本，覆盖。复制在一个 Mongo
	// 事务里，不会留半份；但出错不等于什么都没写：提交应答丢了（结果未知）时目标库里可能已经有了整份副本
	// （RV-20261114-01）。所以先重做（幂等，已写进去的答 already_present），拿到确定的结果就照常改绑；一直拿不到
	// 才中止，并且撤屏障之前按最后一次给出的清单删掉目标库里可能写进去的副本。
	copied, err := d.copyDocuments(ctx, move)
	if err != nil {
		if stopped(ctx, move, "copy documents") {
			return
		}
		slog.Warn("rehome: the player's documents were not copied to the target server; aborting", "player_id", move.PlayerID, "transfer_id", move.ID,
			"to", move.To, "documents_maybe_written", len(copied.Documents), "err", err)
		verdict, binding := d.conclude(ctx, move, false, "the player's documents could not be copied to the target server")
		if verdict != standingStays {
			// 他归别的服，或换走又换回：可能写进去的那份不能当作“已搬过”去删本服的档，按没搬过落定。
			d.finish(ctx, move, verdict, binding, Aborted)
			return
		}
		d.finishCopied(ctx, move, verdict, binding, Aborted, &copied)
		return
	}
	verdict, binding := d.conclude(ctx, move, true, "")
	d.finishCopied(ctx, move, verdict, binding, Aborted, &copied)
}

// copyDocuments 把他的文档复制到目标服的库（覆盖旧副本），出错时重做，最多 copyAttempts 次。成功返回确定的清单；
// 都失败时返回最后一个错误，以及各次出错里列出过的、可能已经写进目标库的文档（core 在结果未知时列出；
// 冲突与读源库失败是确定没写的，不列）。Background 停了时提前返回。
func (d *Driver) copyDocuments(ctx context.Context, move Move) (Copied, error) {
	var maybe Copied
	var err error
	for attempt := 0; attempt < copyAttempts; attempt++ {
		if attempt > 0 {
			if ctx.Err() != nil {
				break
			}
			slog.Warn("rehome: copying the player's documents failed; redoing the copy", "player_id", move.PlayerID, "transfer_id", move.ID,
				"to", move.To, "attempt", attempt, "err", err)
			d.wait(ctx, attempt-1)
		}
		copying, cancel := context.WithTimeout(ctx, departBudget)
		var copied Copied
		copied, err = d.documents.Copy(copying, move.EntityID, move.To, true)
		cancel()
		if err == nil {
			return copied, nil
		}
		if len(copied.Documents) > 0 {
			maybe = copied
		}
	}
	return maybe, err
}

// abandon 把一次换服中止到底：向 account 要到结论为止，再按结论落定。stays 是玩家留在本服时用哪种结论
// （受理之前是 Kept，受理之后是 Aborted）。
func (d *Driver) abandon(ctx context.Context, move Move, stays Outcome, reason string) {
	verdict, binding := d.conclude(ctx, move, false, reason)
	d.finish(ctx, move, verdict, binding, stays)
}

// finish 是没有搬过档的 finishCopied。
func (d *Driver) finish(ctx context.Context, move Move, verdict standing, binding svcaccount.RoleBinding, stays Outcome) {
	d.finishCopied(ctx, move, verdict, binding, stays, nil)
}

// finish 按 conclude 的结论落定：
//
//   - 他归别的服：按已提交落定——屏障保持（没交出过的补交），迁出表记下他现在的服，意图不动
//     （它跟着档走，由目标服到达时清）。不论这一次是提交成的，还是之后又换去了第三个服。
//   - 这一次没有成、他仍在本服：按 stays 落定（撤屏障与标记），清意图。
//   - 他换走之后又换回了本服：撤掉旧屏障与记录（Kept：不动他的连接），清掉这一次留下的意图。
//
// 搬档（copied 非 nil 表示这一次已经把文档复制到了 copied.To）：归别的服时删掉本服库里的那几份（settleGone）；
// 没有成、他仍在本服时，撤屏障之前删掉写到目标库的副本；换走又换回时本服库里已经是目标服搬回来的新版本，不动。
// verdict 是 standingUnknown 只有一种可能：Background 停了，conclude 没问到结论就返回——这时什么都不落定。
func (d *Driver) finishCopied(ctx context.Context, move Move, verdict standing, binding svcaccount.RoleBinding, stays Outcome, copied *Copied) {
	switch verdict {
	case standingUnknown:
		stopped(ctx, move, "conclude")
	case standingGone:
		move.To = binding.ServingServerID
		d.settleGone(ctx, move, copied)
		slog.Info("rehome: the player is bound to another server; this process keeps its fence", "player_id", move.PlayerID,
			"transfer_id", move.ID, "from", move.From, "to", move.To, "bind_epoch", binding.BindEpoch)
	case standingReturned:
		if !d.settle(ctx, move, Kept) {
			return
		}
		d.cancelIntent(ctx, move)
		slog.Info("rehome: the player moved away and back before this transfer was settled here; this process serves him again",
			"player_id", move.PlayerID, "transfer_id", move.ID, "bind_epoch", binding.BindEpoch)
	default:
		if copied != nil && !d.dropDocuments(ctx, move, *copied, copied.To, "the copy on the target server of a transfer that did not happen") {
			return
		}
		if !d.settle(ctx, move, stays) {
			return
		}
		d.cancelIntent(ctx, move)
		slog.Warn("rehome: the transfer did not rebind the player; he stays on this server", "player_id", move.PlayerID, "transfer_id", move.ID)
	}
}

// settleGone 把“他归别的服（move.To）”落定：迁出表记已迁走、屏障保持（没交出过的补交），然后处理本服库里他的文档。
// copied 是这一次搬过的档：删掉本服库里的那几份。没搬过（运维在别处提交、本进程没走到搬档）时先把本服的文档复制到
// 他现在的服——那里没有才写；已有别的版本说明那边已经有他的数据（或新建了他），不覆盖、也不删本服的，记错误留给运维。
// 只在后台调用。
func (d *Driver) settleGone(ctx context.Context, move Move, copied *Copied) {
	if !d.settle(ctx, move, Committed) {
		return
	}
	if copied == nil {
		for attempt := 0; ; attempt++ {
			if stopped(ctx, move, "copy documents of a player bound elsewhere") {
				return
			}
			copying, cancel := context.WithTimeout(ctx, departBudget)
			late, err := d.documents.Copy(copying, move.EntityID, move.To, false)
			cancel()
			if err == nil {
				copied = &late
				break
			}
			if errors.Is(err, ErrCopyConflict) {
				slog.Error("rehome: the player is bound to another server that already holds a different version of his documents; "+
					"this server's copy is kept for an operator to reconcile", "player_id", move.PlayerID, "transfer_id", move.ID, "to", move.To, "err", err)
				return
			}
			slog.Warn("rehome: copying the documents of a player bound elsewhere failed; retrying", "player_id", move.PlayerID, "transfer_id", move.ID,
				"to", move.To, "attempt", attempt+1, "err", err)
			d.wait(ctx, attempt)
		}
	}
	d.dropDocuments(ctx, move, *copied, d.self, "this server's documents of a player bound elsewhere")
}

// dropDocuments 删掉 sid 库里 copied 记下的文档，直到成功（版本条件下删不到不算失败）。只在后台、屏障保持时调用。
// Background 停了（ctx 被取消）时返回 false，没删完的留给重启之后。
func (d *Driver) dropDocuments(ctx context.Context, move Move, copied Copied, sid int32, what string) bool {
	if len(copied.Documents) == 0 {
		return true
	}
	for attempt := 0; ; attempt++ {
		if stopped(ctx, move, "drop documents") {
			return false
		}
		dropping, cancel := context.WithTimeout(ctx, callBudget)
		err := d.documents.Drop(dropping, copied, sid)
		cancel()
		if err == nil {
			return true
		}
		slog.Warn("rehome: dropping documents failed; retrying", "what", what, "player_id", move.PlayerID, "transfer_id", move.ID,
			"sid", sid, "attempt", attempt+1, "err", err)
		d.wait(ctx, attempt)
	}
}

// conclude 向 account 要这一次换服的结论。commit 为 true 时去提交，否则去中止；结果未知就原样重发，
// 直到 account 明确回答。只在后台调用。
//
// 结论不从错误码推断（见 Directory 的注释）：account 一旦明确回答——照做了、stale、in-progress、拒绝——
// 就按它带回的当前绑定判定（judge）。于是应答丢失之后重发得到的“不认识这个 ID”不会被读成“当年没有提交”：
// 他归别的服就是归别的服。提交被拒绝而这一次仍在途时（目标服在此期间没了、名额没了），转去中止。
// 返回的 standing 只会是 standingStays、standingGone 或 standingReturned；Background 停了（ctx 被取消）时
// 不再问，返回 standingUnknown，调用方什么都不落定。
func (d *Driver) conclude(ctx context.Context, move Move, commit bool, reason string) (standing, svcaccount.RoleBinding) {
	for attempt := 0; ; attempt++ {
		if ctx.Err() != nil {
			return standingUnknown, svcaccount.RoleBinding{}
		}
		calling, cancel := context.WithTimeout(ctx, callBudget)
		var binding svcaccount.RoleBinding
		var err error
		if commit {
			binding, err = d.directory.Commit(calling, move.PlayerID, move.ID)
		} else {
			binding, err = d.directory.Abort(calling, move.PlayerID, move.ID, reason)
		}
		verdict := standingUnknown
		if classify(err) != answerUnknown {
			verdict, binding = d.verdictAndBinding(calling, move, binding)
		}
		cancel()
		switch {
		case verdict == standingStays, verdict == standingGone, verdict == standingReturned:
			return verdict, binding
		case verdict == standingInFlight && commit:
			// account 明确不肯提交、而这一次仍在途：由我们中止。
			slog.Warn("rehome: commit refused while the transfer is still in flight; aborting", "player_id", move.PlayerID, "transfer_id", move.ID, "err", err)
			commit, reason = false, fmt.Sprintf("commit refused: %v", err)
			attempt = -1
			continue
		}
		if ctx.Err() != nil {
			return standingUnknown, svcaccount.RoleBinding{}
		}
		slog.Warn("rehome: outcome unknown; sending the same request again", "player_id", move.PlayerID, "transfer_id", move.ID,
			"commit", commit, "attempt", attempt+1, "err", err)
		d.wait(ctx, attempt)
	}
}

// bound 报告一份 RoleBinding 是不是真的带回了绑定（写入在拒绝时可能什么都没带回）。
func bound(binding svcaccount.RoleBinding) bool {
	return binding.PlayerID != 0 || binding.ServingServerID != 0
}

// verdict 是 verdictAndBinding 只要结论的写法。
func (d *Driver) verdict(ctx context.Context, move Move, binding svcaccount.RoleBinding) standing {
	verdict, _ := d.verdictAndBinding(ctx, move, binding)
	return verdict
}

// verdictAndBinding 按一次写入带回的绑定判定；没带回就读一次。读不到是 standingUnknown；
// account 说没有这个角色时没有什么可保护的，按“留在本服”处理。
func (d *Driver) verdictAndBinding(ctx context.Context, move Move, binding svcaccount.RoleBinding) (standing, svcaccount.RoleBinding) {
	if !bound(binding) {
		read, err := d.directory.Binding(ctx, move.PlayerID)
		switch {
		case errors.Is(err, svcaccount.ErrRoleMissing):
			return standingStays, svcaccount.RoleBinding{}
		case err != nil:
			return standingUnknown, svcaccount.RoleBinding{}
		}
		binding = read
	}
	return judge(move, d.self, binding), binding
}

// settle 落定结论，直到成功：撤屏障会因为实体正被占用而失败，失败时标记与屏障都还在，重试就是了。只在后台调用。
// Background 停了（ctx 被取消）时返回 false：没落定的留给重启之后（迁出表随进程没了）。
func (d *Driver) settle(ctx context.Context, move Move, outcome Outcome) bool {
	for attempt := 0; ; attempt++ {
		if stopped(ctx, move, "settle") {
			return false
		}
		settling, cancel := context.WithTimeout(ctx, departBudget)
		err := d.residency.Settle(settling, move, outcome)
		cancel()
		if err == nil {
			return true
		}
		slog.Warn("rehome: settling failed; retrying", "player_id", move.PlayerID, "transfer_id", move.ID, "outcome", outcome, "attempt", attempt+1, "err", err)
		d.wait(ctx, attempt)
	}
}

// withdraw 是受理之前的退路：撤标记，需要时清意图。在申请的请求里调用，所以只试一次；
// 标记撤不掉时转到后台去撤，不让请求等。
func (d *Driver) withdraw(ctx context.Context, move Move, intent bool) {
	settling, cancel := context.WithTimeout(context.WithoutCancel(ctx), callBudget)
	err := d.residency.Settle(settling, move, Kept)
	cancel()
	if err != nil {
		slog.Warn("rehome: the leaving mark was not withdrawn; retrying in the background", "player_id", move.PlayerID, "transfer_id", move.ID, "err", err)
		d.spawn(move, "withdraw", func(ctx context.Context) { d.settle(ctx, move, Kept) })
	}
	if intent {
		d.cancelIntent(context.WithoutCancel(ctx), move)
	}
}

// cancelIntent 清掉档里这一次的意图。清不掉只记日志：它不是栅栏，下一次进入时会对账清掉。
// ctx 是后台步骤的（停机时取消）或申请请求的（调用方去掉了它的取消）；这一笔另有 callBudget 的期限。
func (d *Driver) cancelIntent(ctx context.Context, move Move) {
	ctx, cancel := context.WithTimeout(ctx, callBudget)
	defer cancel()
	if err := d.profile.Cancel(ctx, move.PlayerID, move.ID); err != nil {
		slog.Warn("rehome: the intent was not cleared; the next enter reconciles it", "player_id", move.PlayerID, "transfer_id", move.ID, "err", err)
	}
}
