package player

import (
	"{{MODULE}}/game/components/rehome"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:Rehome}}
const CompTypeRehome entity.ComponentType = {{ID:component:Rehome}}

// RehomeComponent 是 game/components/rehome 的组件在 Player 上的名字（生成接线与 handler 用它）；业务在那个包里。
type RehomeComponent = rehome.Component

// IRehomeEntity 是 Nest handler 用这个组件时的窄实体接口；getter 由生成的 Entity 接线实现。
type IRehomeEntity interface {
	entity.IThreadSafeEntity
	RehomeComp() *RehomeComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeRehome, rehome.NewComponent)
}
