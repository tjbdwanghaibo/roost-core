	f.expectEvents(t, "abort 94301 t-1", "close 94301: rehome: the player is changing servers", "handoff 7094301")
	if where, tracked := f.residency.Where(rehomePlayer); !tracked || where.Moving || where.Move.To != 1001 {
		t.Fatalf("the table says %+v (%v), want departed to 1001", where, tracked)
	}
}

// 中止之后撤屏障失败（实体正被占用）：标记与屏障都保持，重试到撤掉为止，然后才清意图。
func TestRehomeReleaseBusyIsRetriedBeforeTheMarkIsWithdrawn(t *testing.T) {
	f := newRehomeFixture(t)
	f.directory.commits = []error{svcaccount.ErrTransferStale}
	f.releaseErrs = []error{errors.New("entity unload busy"), errors.New("entity unload busy")}
	if _, err := f.apply(); err != nil {
		t.Fatal(err)
	}
	f.events.take()
	f.driver.wait = func(int) {
		f.waits++
		if where, tracked := f.residency.Where(rehomePlayer); !tracked || !where.Moving {
			t.Errorf("while the release is failing the table says %+v (%v), want moving", where, tracked)
		}
	}
	f.runBackground()
	f.expectEvents(t, "close 94301: rehome: the player is changing servers", "handoff 7094301", "commit 94301 t-1",
		"release 7094301", "release 7094301", "release 7094301",
		"close 94301: rehome: the server change was aborted; select the role again", "cancel 94301 t-1")
	if f.waits != 2 {
		t.Fatalf("waited %d times between the releases, want 2", f.waits)
	}
	f.expectFree(t)
}

// 迁出表本身：同一名玩家同一时刻只有一次换服；换服中答 rehome_moving，已迁走答 rehome_elsewhere 并带目标；
// 没打标记不能离开；落定只认同一个换服 ID；已迁走的记录只有“换回来”才删。
func TestRehomeResidencyTableHoldsOneMovePerPlayer(t *testing.T) {
	f := newRehomeFixture(t)
	table := f.residency
	move := Move{PlayerID: rehomePlayer, EntityID: rehomeEntity, ID: "t-1", From: 1000, To: 1001, Epoch: 3}
	if _, tracked := table.Where(rehomePlayer); tracked {
		t.Fatal("an empty table knows the player")
	}
	if err := table.Depart(context.Background(), move); err == nil {
		t.Fatal("a move that was not reserved departed")
	}
	if err := table.Reserve(move); err != nil {
		t.Fatal(err)
	}
	other := Move{PlayerID: rehomePlayer, EntityID: rehomeEntity, ID: "t-2", From: 1000, To: 1002, Epoch: 3}
	if err := table.Reserve(other); !errors.Is(err, apperrors.ErrRehomeMoving) {
		t.Fatalf("a second reservation: err = %v, want rehome_moving", err)
	}
	// 另一个 ID 的落定碰不到这一次。
	if err := table.Settle(context.Background(), other, Kept); err != nil {
		t.Fatal(err)
	}
	if where, tracked := table.Where(rehomePlayer); !tracked || !where.Moving || where.Move != move {
		t.Fatalf("table says %+v (%v), want the first move still in flight", where, tracked)
	}
	if err := table.Depart(context.Background(), move); err != nil {
		t.Fatal(err)
	}
	f.now = f.now.Add(time.Minute)
	if err := table.Settle(context.Background(), move, Committed); err != nil {
		t.Fatal(err)
	}
	where, tracked := table.Where(rehomePlayer)
	if !tracked || where.Moving || where.Move != move || !where.Since.Equal(f.now) {
		t.Fatalf("table says %+v (%v), want departed with the time it settled", where, tracked)
	}
	err := table.Reserve(other)
	if sid, ok := OwnerSID(err); !errors.Is(err, apperrors.ErrRehomeElsewhere) || !ok || sid != 1001 {
		t.Fatalf("reserving a departed player: err = %v (owner %d %v), want rehome_elsewhere with 1001", err, sid, ok)
	}
	f.expectEvents(t, "close 94301: rehome: the player is changing servers", "handoff 7094301")
	// 换回来：撤屏障、删记录，不动他的连接。
	if err := table.Settle(context.Background(), move, Kept); err != nil {
		t.Fatal(err)
	}
	f.expectEvents(t, "release 7094301")
	f.expectFree(t)
	// 另一名玩家互不影响。
	if err := table.Reserve(Move{PlayerID: 94302, ID: "t-3", From: 1000, To: 1001}); err != nil {
		t.Fatal(err)
	}
	f.expectFree(t)
}

// Binding 的回答：换服中的、刚迁走的由迁出表直接回答，不问 account；表里没有的问 Directory。
// “已迁走”的记录旧了之后向 account 核对：仍在别处就答 account 说的；已经换回本服就撤掉旧屏障、答本服；
// account 问不到时按表回答。表里没有又问不到是错误。
func TestRehomeBindingAnswersFromTheTableThenTheDirectory(t *testing.T) {
	f := newRehomeFixture(t)
	asked := func() (Directory, error) { return f.directory, nil }
	locateNow := func() (int32, bool, error) {
		return locate(context.Background(), f.residency, asked, rehomeSelf, rehomePlayer, f.now)
	}
	// 不在表里：问 Directory。
	f.directory.binding.ServingServerID = 1002
	if sid, moving, err := locateNow(); err != nil || sid != 1002 || moving {
		t.Fatalf("not in the table: %d %v %v, want 1002 from the directory", sid, moving, err)
	}
	f.directory.binding.Transfer = &svcaccount.RoleTransfer{ID: "x", From: 1002, To: 1003}
	if sid, moving, err := locateNow(); err != nil || sid != 1002 || !moving {
		t.Fatalf("in transfer per the directory: %d %v %v, want 1002 moving", sid, moving, err)
	}
	f.directory.binding.Transfer = nil
	f.directory.bindingErr = errRehomeLost
	if _, _, err := locateNow(); !errors.Is(err, errRehomeLost) {
		t.Fatalf("not in the table and the directory is away: err = %v", err)
	}
	f.directory.bindingErr = nil
	f.expectEvents(t, "binding 94301", "binding 94301", "binding 94301")

	// 换服中：表直接回答，仍绑定在本服。
	move := Move{PlayerID: rehomePlayer, EntityID: rehomeEntity, ID: "t-1", From: 1000, To: 1001, Epoch: 3}
	if err := f.residency.Reserve(move); err != nil {
		t.Fatal(err)
	}
	if sid, moving, err := locateNow(); err != nil || sid != 1000 || !moving {
		t.Fatalf("moving: %d %v %v, want 1000 moving", sid, moving, err)
	}
	// 已迁走，记录还新（29 秒）：表直接回答目标。
	if err := f.residency.Depart(context.Background(), move); err != nil {
		t.Fatal(err)
	}
	if err := f.residency.Settle(context.Background(), move, Committed); err != nil {
		t.Fatal(err)
	}
	f.events.take()
	f.now = f.now.Add(29 * time.Second)
	if sid, moving, err := locateNow(); err != nil || sid != 1001 || moving {
		t.Fatalf("just departed: %d %v %v, want 1001", sid, moving, err)
	}
	f.expectEvents(t)

	// 记录旧了（30 秒）：核对。他又从 1001 换去了 1002——答 account 说的。
	f.now = f.now.Add(time.Second)
	f.directory.binding.ServingServerID, f.directory.binding.BindEpoch = 1002, 5
	if sid, moving, err := locateNow(); err != nil || sid != 1002 || moving {
		t.Fatalf("departed long ago and moved on: %d %v %v, want 1002", sid, moving, err)
	}
	// account 问不到：按表回答。
	f.directory.bindingErr = errRehomeLost
	if sid, moving, err := locateNow(); err != nil || sid != 1001 || moving {
		t.Fatalf("departed long ago and the directory is away: %d %v %v, want 1001 from the table", sid, moving, err)
	}
	f.directory.bindingErr = nil
	// account 说他归本服，但代数只比发起时大 1，证明不了他换回来过：屏障不撤，仍按表回答。
	f.directory.binding.ServingServerID, f.directory.binding.BindEpoch = 1000, 4
	if sid, moving, err := locateNow(); err != nil || sid != 1001 || moving {
		t.Fatalf("an epoch that does not prove a return: %d %v %v, want 1001 from the table", sid, moving, err)
	}
	f.expectEvents(t, "binding 94301", "binding 94301", "binding 94301")
	if _, tracked := f.residency.Where(rehomePlayer); !tracked {
		t.Fatal("the record was dropped on an epoch that does not prove a return")
	}
	// 换回来了（代数 5 = 3 + 2）：撤屏障、删记录，答本服。
	f.directory.binding.BindEpoch = 5
	if sid, moving, err := locateNow(); err != nil || sid != 1000 || moving {
		t.Fatalf("returned: %d %v %v, want 1000", sid, moving, err)
	}
	f.expectEvents(t, "binding 94301", "release 7094301")
	f.expectFree(t)
}
