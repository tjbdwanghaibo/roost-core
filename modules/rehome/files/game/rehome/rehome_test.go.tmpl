}

// 提交被明确拒绝（目标服在此期间被并入别的服）：account 上换服仍在途，由源服中止，然后按中止落定。
// 中止时 account 说“已经提交”（运维人工提交了）：按已提交落定，屏障不撤。
func TestRehomeCommitRefusedIsAbortedAndAnAbortFindingItCommittedSettlesCommitted(t *testing.T) {
