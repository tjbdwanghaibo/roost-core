	// 离开钩子失败而中止，account 却说这个 ID 已经提交：他归目标服了。实体还没交出过，这里补交；意图不清。
	OnLeaving("battle", func(context.Context, *app.Registry, Move) error { return errors.New("not now") })
	f.directory.aborts = []error{fmt.Errorf("%w: transfer t-1 is already committed", svcaccount.ErrTransferStale)}
