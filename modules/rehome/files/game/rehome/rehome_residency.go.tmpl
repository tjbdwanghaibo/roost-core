// Outcome 是一次换服对本进程（源服）来说的结论。
type Outcome uint8

const (
	// Kept：这名玩家归本服，而且他的连接不必动——换服没有发起成，或者他后来又换回了本服。
	// 撤掉迁出表的记录与实体的屏障，别的不碰。
	Kept Outcome = iota + 1
	// Aborted：换服被受理之后中止了，玩家归本服。撤掉记录与屏障，并断开他此刻仍连着的会话：
	// 客户端在被受理之后只认一个信号——连接断开，然后重新选角看角色在哪个服。
	Aborted
	// Committed：account 已经把他改绑到目标服。屏障保持到进程退出，迁出表记下他去了哪。
	Committed
)

// Whereabouts 是迁出表对一名玩家的回答。
type Whereabouts struct {
	// Move 是让他离开本进程的那一次换服（ID、目标服、发起时的绑定代数）。
	Move Move
	// Moving 为 true 表示换服还没有结论：本进程不为他服务，他最后归哪个服也还不知道。
	// 为 false 表示已经改绑：他归 Move.To。
	Moving bool
	// Since 是这条记录落定的时刻（系统时间）：Moving 时是打上标记的时刻，否则是得知已经改绑的时刻。
	Since time.Time
}

// Residency 回答“本进程还替不替这名玩家写”，并执行让他离开本进程的那几步。它带着迁出表。
//
// 缺省实现是 LocalResidency。工程有自己的驻留表（按玩家记着谁在本进程、做闲置卸载）时，让那张表实现这个接口
// 并以 ResidencyCapability 发布到 Registry：迁出表与驻留表要在同一把锁下看，才不会一边说“在本服”一边说“已迁走”。
//
// 一次换服按这个顺序调用，同一名玩家同一时刻只有一次：
//
//	Reserve → （发起成了）Quiesce → [复核与离开钩子] → Depart → Settle(Committed 或 Aborted)
//	Reserve → （没发起成）Settle(Kept)
//
// 之后这名玩家若又换回本服，调用方在发现时再 Settle(Kept) 一次，把旧记录与屏障撤掉。
type Residency interface {
	// Reserve 给这名玩家打上“离开中”的标记：从这一刻起 Where 回答“换服中”，**他新的业务请求在准入处被拒**
	// （接入边界的写闸门、后台步骤的准入、进入前检查都看这张表）。它在向 account 发起之前调用，
	// 所以 account 那边一有换服在途，本进程就已经不再替他开始任何新的事。
	// 表里已经有这名玩家时拒绝：换服在途答 Moving，已经迁走答 Elsewhere。只做一次加锁读写，不等待。
	Reserve(move Move) error
	// Quiesce 把这名玩家在本进程里安静下来：断开他的会话，并等到**标记之前已经准入的请求全部执行完**。
	// 成功返回之后，本进程里没有任何代表他的请求在执行，新的也进不来——离开钩子从这一刻起读到的事实
	// （他自己的档、别的服务里他的状态）不会再被本进程里他自己的请求改掉。在 ctx 之内等不到就返回错误，
	// 调用方中止换服。会等待，不能在 Nest 业务 worker 上调用。可以重复调用。
	Quiesce(ctx context.Context, move Move) error
	// Depart 让这名玩家离开本进程：把实体的写权交出去（已准入的写入落库、从内存卸载、之后写到它的事务被拒绝）。
	// 成功返回之后本进程不再写他，调用方才可以让 account 改绑。
	// 失败是确定的“没有离开”：实体照常可写，调用方中止换服。会等待，不能在 Nest 业务 worker 上调用。
	// 对已经离开的玩家再调一次是安全的。
	Depart(ctx context.Context, move Move) error
	// Settle 落定结论（见 Outcome）。撤屏障会等待、可能因为实体正被占用而失败——此时记录与屏障都保持，
	// 返回错误，调用方重试。表里没有这一次换服时什么都不做。
	Settle(ctx context.Context, move Move, outcome Outcome) error
	// Where 回答迁出表里有没有这名玩家。只读、不等待，可以在任何地方调用。
	Where(playerID int64) (Whereabouts, bool)
}

// ResidencyCapability 是工程发布自己的 Residency 用的能力名。没有发布时用 LocalResidency。
const ResidencyCapability app.ModName = "game.rehome.residency"

var (
	localsMu sync.Mutex
	locals   = map[*app.Registry]*LocalResidency{}
)

// ResidencyOf 取这个进程的 Residency：工程发布了自己的就用它，否则用这个 Registry 的 LocalResidency
// （一个进程一张迁出表，第一次用到时建）。
func ResidencyOf(registry *app.Registry) Residency {
	if own, ok := app.Lookup[Residency](registry, ResidencyCapability); ok && own != nil {
		return own
	}
	localsMu.Lock()
	defer localsMu.Unlock()
	local := locals[registry]
	if local == nil {
		local = NewLocalResidency(registry)
		locals[registry] = local
		publishGate(registry, local)
	}
	return local
}

// writeGateCapability 是 internal/access/player 的 WriteGateCapability：接入边界在每个玩家请求到达 handler 之前
// 问一次的写闸门。按名字发布、按方法匹配（AdmitMessage），理由与玩家传输相同——这个包不能 import 接入层。
const writeGateCapability app.ModName = "access.player.write_gate"

// publishGate 把缺省的迁出表发布成接入边界的写闸门：表里的玩家（离开中、已迁走）发来的请求在到达 handler 之前被拒，
// 连接随之关闭（接入层对闸门的拒绝就是这样处理的），客户端重新选角。
//
// 工程已经发布了自己的写闸门时这里什么都不发布（一个进程只有一个）：那个闸门要自己拒绝迁出表里的玩家——
// 在它的 AdmitMessage 里调本包的 AdmitMessage(registry, playerID, messageID)。用自己的 Residency 的工程
// （game-demo 的驻留表）本来就走不到这里，它的闸门与迁出表是同一个东西。
func publishGate(registry *app.Registry, local *LocalResidency) {
	if registry == nil {
		return
	}
	if err := registry.Register(writeGateCapability, local); err != nil {
		slog.Warn("rehome: this project publishes its own player write gate; it must refuse the players in the emigrant table itself (rehome.AdmitMessage)", "err", err)
	}
}

// AdmitMessage 回答接入边界：这名玩家的这条消息现在能不能在本进程处理。迁出表里的玩家一律拒绝
// （离开中 rehome_moving，已迁走 rehome_elsewhere），除了 ExemptFromGate 登记过的消息。
// 给有自己的写闸门的工程在闸门里调用；缺省的迁出表自己就是闸门。
func AdmitMessage(registry *app.Registry, playerID int64, messageID uint32) error {
	return admitMessage(ResidencyOf(registry), playerID, messageID)
}

func admitMessage(residency Residency, playerID int64, messageID uint32) error {
	if gateExempt(messageID) {
		return nil
	}
	where, tracked := residency.Where(playerID)
	switch {
	case !tracked:
		return nil
	case where.Moving:
		return Moving(playerID, where.Move.To)
	}
	return Elsewhere(playerID, where.Move.To)
}

var (
	gateMu      sync.RWMutex
	gateExempts = map[uint32]struct{}{}
)

// ExemptFromGate 登记一条不受写闸门约束的消息：它自己会检查迁出表、并给客户端一个带码的回答，
// 闸门若先把连接关掉，客户端反而不知道原因。进入游戏的那条消息就是（rehome 与 enter 的联动登记它：
// 进入前检查回答 rehome_moving / rehome_elsewhere）。只在 init 里调用。
func ExemptFromGate(messageID uint32) {
	gateMu.Lock()
	defer gateMu.Unlock()
	gateExempts[messageID] = struct{}{}
}

func gateExempt(messageID uint32) bool {
	gateMu.RLock()
	defer gateMu.RUnlock()
	_, exempt := gateExempts[messageID]
	return exempt
}

// RegistryResidency 返回一个每次用到时才从 Registry 取的 Residency（ResidencyOf）。Driver 用它而不是在
// 建 Driver 时取一次：协议绑定建 Driver 的时刻早于业务服务发布自己的驻留表，取早了会拿到缺省的那一张，
// 之后 Driver 与 Binding 就各看各的表。
func RegistryResidency(registry *app.Registry) Residency {
	return registryResidency{registry: registry}
}

type registryResidency struct{ registry *app.Registry }

func (r registryResidency) Reserve(move Move) error { return ResidencyOf(r.registry).Reserve(move) }
func (r registryResidency) Quiesce(ctx context.Context, move Move) error {
	return ResidencyOf(r.registry).Quiesce(ctx, move)
}
func (r registryResidency) Depart(ctx context.Context, move Move) error {
	return ResidencyOf(r.registry).Depart(ctx, move)
}
func (r registryResidency) Settle(ctx context.Context, move Move, outcome Outcome) error {
	return ResidencyOf(r.registry).Settle(ctx, move, outcome)
}
func (r registryResidency) Where(playerID int64) (Whereabouts, bool) {
	return ResidencyOf(r.registry).Where(playerID)
}

// 断开会话时给连接的原因。
var (
	// ErrSessionRehoming：这名玩家正在换服，本进程不再为他服务。
	ErrSessionRehoming = errors.New("rehome: the player is changing servers")
	// ErrSessionRehomeAborted：换服被中止了，请重新选角。
	ErrSessionRehomeAborted = errors.New("rehome: the server change was aborted; select the role again")
)

// playerTCPCapability 是 internal/access/player/tcp 的 Name：玩家 TCP 传输发布 Runtime 用的能力名。
// 按名字取、写成接口，因为传输包 import 协议绑定、协议绑定 import controller——这个包不能反过来 import 它。
const playerTCPCapability app.ModName = "access.player.tcp"

// sessionCloser 是玩家传输上按玩家断开会话、问他还有几条会话的入口（gateway.PlayerRuntime）。
type sessionCloser interface {
	CloseSessions(playerID int64, reason error) int
	ActiveSessions(playerID int64) int
}

// quiescePoll 是等会话收尾时两次查看之间的间隔。
const quiescePoll = 10 * time.Millisecond

// entityHandOff 是 DataEngine Mod 上交出实体的入口（wiring/dataengine 的 Mod.HandOffEntity）。
type entityHandOff interface {
	HandOffEntity(ctx context.Context, entityID int64) (*wiringde.EntityHandOff, error)
}

// Copied 是一次搬档的结果（wiring/dataengine 的 EntityCopy）：源服库里这名玩家的每份 dbscope=sid 文档、复制到哪个服。
type Copied = wiringde.EntityCopy

// ErrCopyConflict：目标服的库里已有这名玩家的另一个版本，不覆盖时拒绝（wiring/dataengine 的 ErrEntityCopyConflict）。
var ErrCopyConflict = wiringde.ErrEntityCopyConflict

// Documents 是换服的搬档（维护者 2026-11-13：本地实体的 DAO 缺省 dbscope=sid，物理库 <库>_<sid> 每个服一个；
// 玩家换到别的服，他的文档要从本服的库搬到目标服的库，目标服才能加载他）。两个动作都只在本进程已经交出这名玩家的
// 实体（Residency.Depart 成功、屏障保持）时可做，都可以原样重做；Driver 决定什么时候做哪一个：
//
//   - 交出之后、提交之前：Copy(overwrite=true) 复制到目标服。account 仍把他绑在本服，只有本服写过他，
//     目标库里别的版本只能是以前留下的旧副本，整文档覆盖。失败即中止。
//   - 提交之后：Drop(复制结果, 本服) 删掉本服库里的那些文档（版本仍是复制时的才删）：本服不再预加载他，按 ID
//     也加载不到他。没复制过就被改绑的（运维在别处提交）先 Copy(overwrite=false)：目标库里没有才写，已有别的
//     版本是冲突，本服的文档留着、记错误，由运维处理。
//   - 中止之后（撤屏障之前）：Drop(复制结果, 目标服) 删掉这次写到目标库的副本（目标服没写过才删）。
//
// 只搬 dbscope=sid 的 DAO；global 的 DAO 各服共用、不动（没有 sid DAO 时两个动作什么都不做）。两侧物理库名按本进程的
// dataengine.databases 换算，前提是两个服把同一个逻辑库映射到同一个 Mongo 上的同一个前缀。
type Documents interface {
	Copy(ctx context.Context, entityID int64, to int32, overwrite bool) (Copied, error)
	Drop(ctx context.Context, copied Copied, sid int32) error
}

// documentMover 是 DataEngine Mod 上搬档的入口（wiring/dataengine 的 Mod）。
type documentMover interface {
	CopyHandedOffEntity(ctx context.Context, entityID int64, to int32, overwrite bool) (wiringde.EntityCopy, error)
	DropEntityCopy(ctx context.Context, copied wiringde.EntityCopy, sid int32) (int, error)
}

// RegistryDocuments 返回经 Registry 里 DataEngine Mod 搬档的 Documents（每次用到时才取：DataEngine 在协议绑定之后才发布）。
func RegistryDocuments(registry *app.Registry) Documents { return registryDocuments{registry: registry} }

type registryDocuments struct{ registry *app.Registry }

func (r registryDocuments) mover() (documentMover, error) {
	engine, ok := app.Lookup[documentMover](r.registry, mods.ModDataEngine)
	if !ok || engine == nil {
		return nil, fmt.Errorf("rehome: capability %q not found; the player's documents cannot be moved without the dataengine mod", mods.ModDataEngine)
	}
	return engine, nil
}

func (r registryDocuments) Copy(ctx context.Context, entityID int64, to int32, overwrite bool) (Copied, error) {
	engine, err := r.mover()
	if err != nil {
		return Copied{}, err
	}
	return engine.CopyHandedOffEntity(ctx, entityID, to, overwrite)
}

func (r registryDocuments) Drop(ctx context.Context, copied Copied, sid int32) error {
	engine, err := r.mover()
	if err != nil {
		return err
	}
	_, err = engine.DropEntityCopy(ctx, copied, sid)
	return err
}

// LocalResidency 是 Residency 的缺省实现，给没有自己的驻留表的工程用：
//
//   - 写闸门：它自己就是接入边界的写闸门（AdmitMessage），第一次用到时发布（publishGate）：表里的玩家
//     发来的请求在到达 handler 之前被拒。
//   - 断开会话与排空（Quiesce）：按能力名取玩家 TCP 传输，CloseSessions 之后等 ActiveSessions 归零。
//     这就是“标记之前已经准入的请求都执行完了”，依据是传输的两条性质：一条连接的读循环**串行**分发请求
//     （同一时刻至多一个在执行，没有每请求一个 goroutine）；会话要等读循环退出——也就是那个请求的 handler
//     返回、它的 Nest 事务已经提交或失败——之后才从按玩家的会话表里摘掉。断开会取消连接的 context，
//     还在等别的服务应答的 handler 因此很快返回；它发出去的请求在那个服务上是否生效，由离开钩子去问那个服务。
//     进程里没有玩家传输（不接玩家的进程）就没有会话可断、也没有请求可等。
//     有两种情形不在这个保证里：推送失败时被传输提前摘掉的连接（它的 handler 可能还没返回，context 已取消），
//     以及独立 Gate 部署下经 Game Ingress 转来的请求（那里的会话表不是这张，没有核对过）。
//   - 交出实体：DataEngine Mod 的 HandOffEntity，屏障保持到 Release 或进程退出。
//   - 迁出表：进程内的一张表，玩家 → 这一次换服、是否仍在换服、交出的句柄。它不持久：进程重启之后
//     表是空的，这名玩家归谁由 account 回答（Driver.Admit、Binding 都会去问）。
//
// 表里的记录只在玩家换回本服时删除，所以它随“从本进程换走的玩家数”增长，进程重启清空。
//
// 锁：mu 只保护表，从不跨等待持有。
type LocalResidency struct {
	now func() time.Time
	// closeSessions 与 handOff 是两个外部动作，测试替换它们；缺省实现按能力名从 Registry 取。
	closeSessions  func(playerID int64, reason error) int
	activeSessions func(playerID int64) int
	handOff        func(ctx context.Context, entityID int64) (release func(context.Context) error, err error)

	mu        sync.Mutex
	emigrants map[int64]*emigrant
}

// emigrant 是迁出表的一行。
type emigrant struct {
	move   Move
	moving bool
	since  time.Time
	// release 非空表示实体已经交出、屏障由它撤销。
	release func(context.Context) error
}

// NewLocalResidency 建一张空的迁出表。传输与 DataEngine 在第一次用到时才从 registry 取：
// 它们都在这张表之后才发布。
func NewLocalResidency(registry *app.Registry) *LocalResidency {
	return &LocalResidency{
		now: time.Now, //glsvet:system-clock the emigrant table is a process-local cache, not business state
		closeSessions: func(playerID int64, reason error) int {
			transport, ok := app.Lookup[sessionCloser](registry, playerTCPCapability)
			if !ok || transport == nil {
				return 0
			}
			return transport.CloseSessions(playerID, reason)
		},
		activeSessions: func(playerID int64) int {
			transport, ok := app.Lookup[sessionCloser](registry, playerTCPCapability)
			if !ok || transport == nil {
				return 0
			}
			return transport.ActiveSessions(playerID)
		},
		handOff: func(ctx context.Context, entityID int64) (func(context.Context) error, error) {
			engine, ok := app.Lookup[entityHandOff](registry, mods.ModDataEngine)
			if !ok || engine == nil {
				return nil, fmt.Errorf("rehome: capability %q not found; the entity cannot be handed off without the dataengine mod", mods.ModDataEngine)
			}
			handed, err := engine.HandOffEntity(ctx, entityID)
			if err != nil {
				return nil, err
			}
			return handed.Release, nil
		},
		emigrants: map[int64]*emigrant{},
	}
}

func (r *LocalResidency) Reserve(move Move) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	if existing := r.emigrants[move.PlayerID]; existing != nil {
		if existing.moving {
			return Moving(move.PlayerID, existing.move.To)
		}
		return Elsewhere(move.PlayerID, existing.move.To)
	}
	r.emigrants[move.PlayerID] = &emigrant{move: move, moving: true, since: r.now()}
	return nil
}

// AdmitMessage 让迁出表直接充当接入边界的写闸门（internal/access/player 的 WriteGate）。
func (r *LocalResidency) AdmitMessage(playerID int64, messageID uint32) error {
	return admitMessage(r, playerID, messageID)
}

func (r *LocalResidency) Quiesce(ctx context.Context, move Move) error {
	if !r.holds(move) {
		return fmt.Errorf("rehome: transfer %s of player %d was not reserved", move.ID, move.PlayerID)
	}
	r.closeSessions(move.PlayerID, ErrSessionRehoming)
	// 会话从表里摘掉 = 它的读循环退出了 = 它正在执行的那个请求已经返回（见类型注释）。
	// 写闸门从 Reserve 起就在拒绝新请求，所以归零之后不会再有；期间新建的连接发不出业务请求，一并断开。
	ticker := time.NewTicker(quiescePoll)
	defer ticker.Stop()
	for r.activeSessions(move.PlayerID) > 0 {
		select {
		case <-ctx.Done():
			return fmt.Errorf("rehome: requests of player %d admitted before the move are still running: %w", move.PlayerID, ctx.Err())
		case <-ticker.C:
			r.closeSessions(move.PlayerID, ErrSessionRehoming)
		}
	}
	return nil
}

func (r *LocalResidency) Depart(ctx context.Context, move Move) error {
	if !r.holds(move) {
		return fmt.Errorf("rehome: transfer %s of player %d was not reserved", move.ID, move.PlayerID)
	}
	// Quiesce 之后握手进来的连接发不出业务请求，但握手本身会登记自身视图的订阅：连接上还有订阅时，
	// 卸载之后框架会为订阅者把实体重新读回内存。所以交出之前再断开一次。
	r.closeSessions(move.PlayerID, ErrSessionRehoming)
	release, err := r.handOff(ctx, move.EntityID)
	if err != nil {
		return fmt.Errorf("rehome: hand off player %d: %w", move.PlayerID, err)
	}
	r.mu.Lock()
	defer r.mu.Unlock()
	if entry := r.emigrants[move.PlayerID]; entry != nil && entry.move.ID == move.ID {
		entry.release = release
	}
	return nil
}

func (r *LocalResidency) Settle(ctx context.Context, move Move, outcome Outcome) error {
	if outcome == Committed {
		return r.settleCommitted(ctx, move)
	}
	r.mu.Lock()
	entry := r.emigrants[move.PlayerID]
	if entry == nil || entry.move.ID != move.ID {
		r.mu.Unlock()
		return nil
	}
	release := entry.release
	r.mu.Unlock()
	if release != nil {
		// 撤屏障之前它先把交出期间被读回内存的实例卸载掉（那个实例可能落后于库）；卸载不掉就失败，屏障保持。
		if err := release(ctx); err != nil {
			return fmt.Errorf("rehome: release player %d: %w", move.PlayerID, err)
		}
	}
	r.mu.Lock()
	if current := r.emigrants[move.PlayerID]; current == entry {
		delete(r.emigrants, move.PlayerID)
	}
	r.mu.Unlock()
	if outcome == Aborted {
		r.closeSessions(move.PlayerID, ErrSessionRehomeAborted)
	}
	return nil
}

// settleCommitted 把这名玩家记成“已迁走”。正常情况下实体在 Depart 时已经交出；没有交出就被改绑的
// （运维在源服中止到一半时人工提交）在这里补交——补不上时返回错误、记录照样落定：
// 他已经不归本服，进入与后台步骤都要按“在别的服”回答，调用方重试直到屏障立起来。
func (r *LocalResidency) settleCommitted(ctx context.Context, move Move) error {
	r.mu.Lock()
	entry := r.emigrants[move.PlayerID]
	if entry == nil || entry.move.ID != move.ID {
		entry = &emigrant{move: move}
		r.emigrants[move.PlayerID] = entry
	}
	if entry.moving || entry.since.IsZero() {
		entry.moving, entry.since = false, r.now()
	}
	if move.To > 0 {
		// 调用方按 account 的当前绑定告诉我们他现在的服：它可能已经不是这一次换服的目标。
		entry.move.To = move.To
	}
	handed := entry.release != nil
	r.mu.Unlock()
	if handed {
		return nil
	}
	r.closeSessions(move.PlayerID, ErrSessionRehoming)
	release, err := r.handOff(ctx, move.EntityID)
	if err != nil {
		return fmt.Errorf("rehome: player %d is bound to server %d but was not handed off: %w", move.PlayerID, move.To, err)
	}
	r.mu.Lock()
	entry.release = release
	r.mu.Unlock()
	return nil
}

func (r *LocalResidency) Where(playerID int64) (Whereabouts, bool) {
	r.mu.Lock()
	defer r.mu.Unlock()
	entry := r.emigrants[playerID]
	if entry == nil {
		return Whereabouts{}, false
	}
	return Whereabouts{Move: entry.move, Moving: entry.moving, Since: entry.since}, true
}

// holds 报告表里是不是正记着这一次换服。
func (r *LocalResidency) holds(move Move) bool {
	r.mu.Lock()
	defer r.mu.Unlock()
	entry := r.emigrants[move.PlayerID]
	return entry != nil && entry.move.ID == move.ID
}
