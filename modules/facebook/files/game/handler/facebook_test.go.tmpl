// 收件箱：记下之后本人能查到，恰好到期那一刻起查不到；提交失败不留记录；已过期的邀请、不是实体号的来源、没有邀请人
// 不记也不写；别人的收件箱看不到。
func TestFacebookInviteIsListedUntilItExpires(t *testing.T) {
	f := newFacebookFixture(t)
	source := f.inbox(t, 90001)
	expireAt := f.now.Load() + 60000
	f.commit.reject.Store(true)
	if _, err := sender.NewFacebookNoteSender(f.engine).Sync_FacebookNote(context.Background(), f.inbox(t, 102), source, 101, expireAt); err == nil {
		t.Fatal("note admitted despite rejected commit")
	}
	f.commit.reject.Store(false)
	if got := f.invites(t, 102); len(got) != 0 {
		t.Fatalf("rejected note kept: %+v", got)
	}
	if !f.note(t, 102, source, 101, expireAt) {
		t.Fatal("valid invitation not noted")
	}
	want := []view.FacebookInvite{{Source: source, From: 101, ExpireAt: expireAt}}
	if got := f.invites(t, 102); !reflect.DeepEqual(got, want) {
		t.Fatalf("listed=%+v want=%+v", got, want)
	}
	if got := f.invites(t, 103); len(got) != 0 {
		t.Fatalf("another player sees the invite: %+v", got)
	}
	before := f.facts(t)
	if f.note(t, 102, source, 101, f.now.Load()) || f.note(t, 102, 0, 101, expireAt) || f.note(t, 102, source, 0, expireAt) {
		t.Fatal("expired invitation, invalid source or missing inviter noted")
	}
	f.unchanged(t, before)
	f.now.Add(59999)
	if got := f.invites(t, 102); len(got) != 1 {
		t.Fatalf("invite dropped before its deadline: %+v", got)
	}
	f.now.Add(1)
	if got := f.invites(t, 102); len(got) != 0 {
		t.Fatalf("invite listed at its deadline: %+v", got)
	}
}

// 收件箱有界：至多 MaxInvites 条，记满时新的不记、已有的可以续期；过期的在下一次记录时清掉并让出名额。
func TestFacebookInvitesAreBoundedAndPruned(t *testing.T) {
	f := newFacebookFixture(t)
	expireAt := f.now.Load() + 60000
	for i := int64(1); i <= inbox.MaxInvites; i++ {
		if !f.note(t, 102, f.inbox(t, 92000+i), 101, expireAt) {
			t.Fatalf("invite %d refused", i)
		}
	}
	before := f.facts(t)
	if f.note(t, 102, f.inbox(t, 92999), 101, expireAt) {
		t.Fatal("invite beyond the bound accepted")
	}
	f.unchanged(t, before)
	if !f.note(t, 102, f.inbox(t, 92001), 103, expireAt+5) {
		t.Fatal("renewal refused when full")
	}
	if got := f.invites(t, 102); len(got) != inbox.MaxInvites || got[0].From != 103 || got[0].ExpireAt != expireAt+5 {
		t.Fatalf("after renewal: %d invites, first=%+v", len(got), got[0])
	}
	f.now.Store(expireAt + 5)
	if !f.note(t, 102, f.inbox(t, 92999), 101, expireAt+60000) {
		t.Fatal("expired invites did not release capacity")
	}
	var kept int
	if err := f.engine.RunLocal(context.Background(), func() {
		v := f.values[f.inbox(t, 102)].(*facebookentity.Facebook)
		v.GetMutex().Lock()
		defer v.GetMutex().Unlock()
		kept = v.Dao().InvitesLen()
	}); err != nil {
		t.Fatal(err)
	}
	if kept != 1 {
		t.Fatalf("expired invites retained: %d", kept)
	}
}

// 迟到的旧告知（过期更早）不缩短已经续期的邀请，也不写。
func TestFacebookLateNoticeDoesNotShortenRenewal(t *testing.T) {
	f := newFacebookFixture(t)
	source := f.inbox(t, 90001)
	expiry := f.now.Load() + 60000
	f.note(t, 102, source, 101, expiry+1000)
	before := f.facts(t)
	if !f.note(t, 102, source, 103, expiry) {
		t.Fatal("late notice of a renewed invite reported as not recorded")
	}
	f.unchanged(t, before)
	if got := f.invites(t, 102); len(got) != 1 || got[0].ExpireAt != expiry+1000 || got[0].From != 101 {
		t.Fatalf("late notice replaced renewal: %+v", got)
	}
}

// 记录是一次 Remote 写：提交记录里是 Facebook 的 Remote 变化（经生成的 BuildRemoteCommitLocked 冻结），不是本地实体写。
func TestFacebookNoteCommitsARemoteWrite(t *testing.T) {
	f := newFacebookFixture(t)
	f.note(t, 102, f.inbox(t, 90001), 101, f.now.Load()+60000)
	f.commit.lastMu.Lock()
	record := dataengine.CloneCommitRecord(f.commit.last)
	f.commit.lastMu.Unlock()
	remote := 0
	for _, mutation := range record.Mutations {
		if mutation.Remote == nil {
			t.Fatalf("local mutation in a facebook note: %+v", mutation)
		}
		remote++
	}
	if remote != 1 {
		t.Fatalf("note record has %d remote mutations: %+v", remote, record)
	}
}

// facebookRemote 在离线场景里替代外部锁与权威存储，仍用生成的 BuildRemoteCommitLocked 冻结事务内的 Facebook 变化。
// 它不验证跨进程租约、Redis 锁、Mongo 投影或进程崩溃恢复。
type facebookRemote struct {
	entity.IRemoteEntityManager
	values   facebookGetter
	locks    map[int64]*sync.Mutex
	versions map[int64]*uint64
}

func (m facebookRemote) PrepareRemoteWriteBatch(_ context.Context, ids []int64) (entity.RemoteWriteBatch, error) {
	ordered := slices.Clone(ids)
	slices.Sort(ordered)
	for _, id := range ordered {
		m.locks[id].Lock()
	}
	return &facebookBatch{manager: m, ids: ordered}, nil
}

type facebookBatch struct {
	manager facebookRemote
	ids     []int64
	commits []entity.RemoteCommit
}

func (b *facebookBatch) EntityIDs() []int64 { return b.ids }
func (b *facebookBatch) FinalizeLocked(outcome entity.RemoteTransactionOutcome) error {
	for _, id := range b.ids {
		participant := b.manager.values[id].(entity.IRemoteCommitParticipant)
		if !participant.HasRemoteCommitLocked(outcome) {
			continue
		}
		lease := entity.RemoteWriteLease{EntityID: id, OwnerSID: 1, Mode: entity.RemoteWriteSharedLock, State: entity.RemoteOwnershipShared, BaseVersion: *b.manager.versions[id], MarkerEpoch: 1, LockFence: 1, RouteEpoch: 1}
		commit, err := participant.BuildRemoteCommitLocked(lease, outcome)
		if err != nil {
			return err
		}
		for i := range commit.Snapshots {
			snapshot := &commit.Snapshots[i]
			snapshot.BaseVersion = commit.BaseVersion
			snapshot.StateVersion = commit.NextVersion
			snapshot.MarkerEpoch = commit.MarkerEpoch
			snapshot.RouteEpoch = commit.RouteEpoch
		}
		b.commits = append(b.commits, commit)
	}
	return nil
}
func (b *facebookBatch) Commits() []entity.RemoteCommit { return b.commits }
func (b *facebookBatch) Commit(context.Context) ([]entity.RemoteCommitReceipt, error) {
	for _, commit := range b.commits {
		if err := b.manager.values[commit.EntityID].(entity.IRemoteCommitParticipant).AcknowledgeRemoteCommit(commit); err != nil {
			return nil, err
		}
		*b.manager.versions[commit.EntityID] = commit.NextVersion
	}
	return nil, nil
}
func (b *facebookBatch) Abort(context.Context, error) error { return nil }
func (b *facebookBatch) Indeterminate(context.Context, error) error {
	return fmt.Errorf("unexpected indeterminate facebook fixture commit")
}
func (b *facebookBatch) Close(context.Context) error {
	for i := len(b.ids) - 1; i >= 0; i-- {
		b.manager.locks[b.ids[i]].Unlock()
	}
	return nil
}

func (f *facebookFixture) facts(t *testing.T) map[int64]bson.M {
	t.Helper()
	out := map[int64]bson.M{}
	var decodeErr error
	err := f.engine.RunLocal(context.Background(), func() {
		for id, value := range f.values {
			value.GetMutex().Lock()
			raw := value.(*facebookentity.Facebook).Dao().Marshal()
			value.GetMutex().Unlock()
			var doc bson.M
			decoder := bson.NewDecoder(bson.NewDocumentReader(bytes.NewReader(raw)))
			decoder.DefaultDocumentM()
			if err := decoder.Decode(&doc); err != nil {
				decodeErr = err
				return
			}
			out[id] = doc
		}
	})
	if err != nil {
		t.Fatal(err)
	}
	if decodeErr != nil {
		t.Fatal(decodeErr)
	}
	return out
}
func (f *facebookFixture) unchanged(t *testing.T, before map[int64]bson.M) {
	t.Helper()
	if after := f.facts(t); !reflect.DeepEqual(before, after) {
		t.Fatalf("facebook changed after a refused note: before=%v after=%v", before, after)
	}
}

// NewEngine 会复制包级注册；其他模块场景可能已经登记同一个正式 handler。
// 未登记时装到当前实例，不清全局表，也不吞掉重复登记以外的错误。
func registerFacebookTestHandler(engine *nest.NestMgr, name nest.HandlerName, invoke nest.BaseHandler, meta nest.HandlerMeta) {
	if nest.GetHandler(name) == nil {
		engine.MustRegisterHandlerWithMeta(name, invoke, meta)
	}
}
