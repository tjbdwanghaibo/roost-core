// 场景用正式 Nest 引擎与生成的 DAO / Sender；提交器、Remote 外部锁与权威回执是内存替身（facebookRemote），
// 不宣称 Redis 锁、Mongo 投影或跨进程已经通过——那些由 scripts/test-alliance-e2e.sh 的 TestAllianceE2ESocialTeamInvite 验。

type facebookGetter map[int64]entity.IThreadSafeEntity

func (g facebookGetter) Get(_ context.Context, id int64, _ entity.EntityCategory) (entity.IThreadSafeEntity, error) {
	if v := g[id]; v != nil {
		return v, nil
	}
	return nil, fmt.Errorf("facebook fixture: missing %d", id)
}
func (g facebookGetter) GetMany(ctx context.Context, ids []int64, cats []entity.EntityCategory) ([]entity.IThreadSafeEntity, error) {
	out := make([]entity.IThreadSafeEntity, len(ids))
	for i, id := range ids {
		v, err := g.Get(ctx, id, cats[i])
		if err != nil {
			return nil, err
		}
		out[i] = v
	}
	return out, nil
}

type facebookCommitter struct {
	reject atomic.Bool
	calls  atomic.Int32
	lastMu sync.Mutex
	last   dataengine.CommitRecord
}

func (c *facebookCommitter) Commit(_ context.Context, record dataengine.CommitRecord) error {
	c.calls.Add(1)
	c.lastMu.Lock()
	c.last = dataengine.CloneCommitRecord(record)
	c.lastMu.Unlock()
	if c.reject.Load() {
		return errors.New("facebook commit rejected")
	}
	return nil
}

type facebookFixture struct {
	engine *nest.NestMgr
	values facebookGetter
	commit *facebookCommitter
	now    atomic.Int64
}

func newFacebookFixture(t *testing.T) *facebookFixture {
	t.Helper()
	facebookentity.RegisterEntity()
	f := &facebookFixture{values: facebookGetter{}, commit: &facebookCommitter{}}
	remote := facebookRemote{values: f.values, locks: map[int64]*sync.Mutex{}, versions: map[int64]*uint64{}}
	for unique := int64(101); unique <= 103; unique++ {
		id := f.inbox(t, unique)
		built, err := entity.BuildEntity(&entity.EntityCreateParam{IsCreate: true, Id: id, Kind: facebookentity.EntityKindFacebook})
		if err != nil {
			t.Fatal(err)
		}
		f.values[id] = built
		remote.locks[id] = &sync.Mutex{}
		remote.versions[id] = new(uint64)
	}
	f.now.Store(1000000)
	clock.SetSource(func() time.Time { return time.UnixMilli(f.now.Load()) })
	t.Cleanup(func() { clock.SetSource(nil) })
	f.engine = nest.NewEngine(nest.NestOptionWithRemoteEntityManager(remote), nest.NestOptionWithGetter(f.values), nest.NestOptionWithTransactionCommitter(f.commit), nest.NestOptionWithWorkerPools(nest.WorkerPoolConfig{Workers: 2, QueueCap: 64}, nest.WorkerPoolConfig{}, nest.WorkerPoolConfig{}))
	registerFacebookTestHandler(f.engine, handlerNameFacebookNote, invokeFacebookNote, nest.HandlerMeta{Rollback: nest.RollbackUndo, Durability: nest.DurabilityAsync})
	registerFacebookTestHandler(f.engine, handlerNameFacebookInvites, invokeFacebookInvites, nest.HandlerMeta{Rollback: nest.RollbackState, Durability: nest.DurabilityMemory})
	if err := f.engine.Start(); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := f.engine.Shutdown(context.Background()); err != nil {
			t.Error(err)
		}
	})
	return f
}

