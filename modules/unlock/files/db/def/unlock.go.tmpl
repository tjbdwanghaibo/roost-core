package dbdef

// UnlockState 只记录各功能首次认证的事实，不复制当前配置开关。
type UnlockState struct {
	Records map[int64]*UnlockStamp `store:"1"`
}

// RecordedAt 是第一次成功建立认证记录的业务时刻；OccurredAt 是可信来源证明的原始时刻。
// 只知道当前状态时 OccurredAt 为 0（未知）；单位都是 Unix 毫秒。
type UnlockStamp struct {
	RecordedAt int64 `store:"1"`
	OccurredAt int64 `store:"2"`
}
