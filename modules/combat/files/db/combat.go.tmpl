package db

import (
	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/framework/nest"
	"github.com/tjbdwanghaibo/roost-core/gameplay/skill/combatcomponent"
)

// CombatDAO 保持正式DAO指针身份；由安装器追加到Player声明，生成lifecycle加载与Aggregate提交。
type CombatDAO = combatcomponent.CombatDao

const CombatDAOCollection = combatcomponent.CollectionName

// 组件 DAO 跟随宿主实体的 dbscope（维护者 2026-11-13）：与 Player 的主 DAO 同库同范围。
func NewCombatDAO() *CombatDAO {
	return combatcomponent.NewCombatDaoIn(0, PlayerDaoDBName, (&PlayerDao{}).DbScope())
}

var _ entity.DaoInterface = (*CombatDAO)(nil)
var _ entity.PersistedDaoLoader = (*CombatDAO)(nil)
var _ nest.MutationParticipant = (*CombatDAO)(nil)
