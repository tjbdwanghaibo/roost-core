package player

import (
	"{{MODULE}}/game/components/combat"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:Combat}}
const CompTypeCombat entity.ComponentType = {{ID:component:Combat}}

// CombatComponent 是 game/components/combat 的组件在 Player 上的名字（生成接线与 handler 用它）；业务在那个包里。
type CombatComponent = combat.Component

type ICombatEntity interface {
	entity.IThreadSafeEntity
	CombatComp() *CombatComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeCombat, combat.NewComponent)
}
