package handler

import (
	"github.com/tjbdwanghaibo/roost-core/infra/base/fctx"

	combat "{{MODULE}}/game/components/combat"
	"{{MODULE}}/game/view"
)

// handlerCombatTick 仅供本服有界驱动调用，没有客户端协议；同一代际重复拍为时间幂等。
//
//roost:nest rollback=undo durability=strict
func handlerCombatTick(source, peer view.ICombatEntity, epoch uint64) error {
	c, err := combat.Of(source)
	if err != nil {
		return err
	}
	other, err := combat.Of(peer)
	if err != nil {
		return err
	}
	return c.Tick(other, epoch, fctx.Now())
}
