type combatGetter map[int64]entity.IThreadSafeEntity

func (g combatGetter) Get(_ context.Context, id int64, _ entity.EntityCategory) (entity.IThreadSafeEntity, error) {
	if p := g[id]; p != nil {
		return p, nil
	}
	return nil, fmt.Errorf("unknown %d", id)
}

func (g combatGetter) GetMany(ctx context.Context, ids []int64, cats []entity.EntityCategory) ([]entity.IThreadSafeEntity, error) {
	out := make([]entity.IThreadSafeEntity, len(ids))
	for i, id := range ids {
		p, err := g.Get(ctx, id, cats[i])
		if err != nil {
			return nil, err
		}
		out[i] = p
	}
	return out, nil
}

type combatCommitter struct {
	reject  atomic.Bool
	commits atomic.Int64
	block   atomic.Pointer[combatCommitBlock]
}

type combatCommitBlock struct{ entered, release chan struct{} }

func (c *combatCommitter) Commit(context.Context, dataengine.CommitRecord) error {
	c.commits.Add(1)
	if block := c.block.Swap(nil); block != nil {
		close(block.entered)
		<-block.release
	}
	if c.reject.Load() {
		return errors.New("combat commit rejected")
	}
	return nil
}

type combatFixture struct {
	engine   *nest.NestMgr
	players  []*player.Player
	getter   combatGetter
	commit   *combatCommitter
	now      atomic.Int64
	registry *app.Registry
	stop     func(context.Context) error
}

func newCombatFixture(t *testing.T) *combatFixture {
	t.Helper()
	player.RegisterEntity()
	RegisterCombatReadyNestHandlers()
	RegisterCombatCastNestHandlers()
	RegisterCombatStepNestHandlers()
	RegisterCombatLeaveNestHandlers()
	RegisterCombatTickNestHandlers()
	f := &combatFixture{getter: combatGetter{}, commit: &combatCommitter{}, registry: app.NewRegistry(viper.New())}
	f.now.Store(time.Date(2026, 11, 12, 0, 0, 0, 0, time.UTC).UnixMilli())
	clock.SetSource(func() time.Time { return time.UnixMilli(f.now.Load()) })
	t.Cleanup(func() { clock.SetSource(nil) })
	for i := range 3 {
		id, err := entity.BuildEntityID(int64(98201+i), player.EntityKindPlayer)
		if err != nil {
			t.Fatal(err)
		}
		e, err := entity.BuildEntity(&entity.EntityCreateParam{IsCreate: true, Id: id, Kind: player.EntityKindPlayer})
		if err != nil {
			t.Fatal(err)
		}
		f.players = append(f.players, e.(*player.Player))
		f.getter[id] = e
	}
	f.engine = nest.NewEngine(nest.NestOptionWithGetter(f.getter), nest.NestOptionWithTransactionCommitter(f.commit), nest.NestOptionWithWorkerPools(nest.WorkerPoolConfig{Workers: 2, QueueCap: 64}, nest.WorkerPoolConfig{}, nest.WorkerPoolConfig{}))
	f.engine.MustRegisterHandlerWithMeta(nest.NewHandlerName("combatFixtureAction"), func(_ []entity.IThreadSafeEntity, p []any, _ ...nest.HandlerOption) (any, error) {
		return nil, p[0].(func() error)()
	}, nest.HandlerMeta{Rollback: nest.RollbackUndo, Durability: nest.DurabilityStrict})
	if err := f.engine.Start(); err != nil {
		t.Fatal(err)
	}
	if err := f.registry.Register("nest", nest.Client(f.engine)); err != nil {
		t.Fatal(err)
	}
	stopSkills, err := skillbook.Start(f.registry)
	if err != nil {
		t.Fatal(err)
	}
	stopCombat, err := gamecombat.Start(f.registry)
	if err != nil {
		t.Fatal(err)
	}
	f.stop = stopCombat
	t.Cleanup(func() {
		if err := stopCombat(context.Background()); err != nil {
			t.Error(err)
		}
		if err := stopSkills(context.Background()); err != nil {
			t.Error(err)
		}
		for _, p := range f.players {
			p.CombatComp().OnDestroy(0)
			p.ActorComp().OnDestroy(0)
		}
		if err := f.engine.Shutdown(context.Background()); err != nil {
			t.Error(err)
		}
	})
	f.must(t, func() error {
		for i, p := range f.players {
			if err := p.ActorComp().Body().Enter(actor.Environment{ID: 1, Space: actor.Nowhere{}}, spatial.Point{X: int64(i * 100)}, 0); err != nil {
				return err
			}
		}
		return nil
	})
	return f
}

func (f *combatFixture) ids() []int64 {
	out := make([]int64, len(f.players))
	for i, p := range f.players {
		out[i] = p.ID()
	}
	return out
}

func (f *combatFixture) action(fn func() error) error {
	_, err := f.engine.RequestMulti(context.Background(), nest.NewHandlerName("combatFixtureAction"), f.ids(), nest.NewParams(fn))
	return err
}

func (f *combatFixture) must(t *testing.T, fn func() error) {
	t.Helper()
	if err := f.action(fn); err != nil {
		t.Fatal(err)
	}
}

func (f *combatFixture) read(t *testing.T, fn func()) {
	t.Helper()
	if err := f.engine.RunLocal(context.Background(), func() {
		for _, p := range f.players {
			p.GetMutex().Lock()
		}
		defer func() {
			for i := len(f.players) - 1; i >= 0; i-- {
				f.players[i].GetMutex().Unlock()
			}
		}()
		fn()
	}); err != nil {
		t.Fatal(err)
	}
}

