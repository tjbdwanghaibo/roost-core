// reload 走真实附加DAO加载工厂；只替身化存储读写，不把旧组件复用为“恢复”。
func (f *combatFixture) reload(t *testing.T) {
	t.Helper()
	type saved struct {
		id              int64
		primary, combat []byte
		schema          uint32
	}
	values := make([]saved, 2)
	var saveErr error
	f.read(t, func() {
		for i := range 2 {
			p := f.players[i]
			v := &values[i]
			v.id = p.ID()
			v.primary = p.Dao().Marshal()
			v.combat, v.schema, saveErr = p.CombatComp().Core().Dao().MarshalPersisted()
			if saveErr != nil {
				return
			}
		}
	})
	if saveErr != nil {
		t.Fatal(saveErr)
	}
	for i, v := range values {
		old := f.players[i]
		old.CombatComp().OnDestroy(0)
		old.ActorComp().OnDestroy(0)
		primary := db.NewPlayerDao()
		if err := primary.RestorePersisted(v.primary, db.PlayerDaoSchemaVersion, 0); err != nil {
			t.Fatal(err)
		}
		combat := db.NewCombatDAO()
		combat.SetId(v.id)
		if err := combat.RestorePersisted(v.combat, v.schema, 0); err != nil {
			t.Fatal(err)
		}
		value, err := entity.BuildEntity(&entity.EntityCreateParam{IsCreate: false, Id: v.id, Kind: player.EntityKindPlayer, Dao: map[string]entity.DaoInterface{db.PlayerDaoCollection: primary, db.CombatDAOCollection: combat}})
		if err != nil {
			t.Fatal(err)
		}
		p := value.(*player.Player)
		if p.CombatComp().Core().Dao() != combat {
			t.Fatal("loaded CombatDAO identity changed")
		}
		f.players[i] = p
		f.getter[v.id] = p
	}
	f.must(t, func() error {
		for i := range 2 {
			if err := f.players[i].ActorComp().Body().Enter(actor.Environment{ID: 1, Space: actor.Nowhere{}}, spatial.Point{X: int64(i * 100)}, 0); err != nil {
				return err
			}
		}
		return nil
	})
}

