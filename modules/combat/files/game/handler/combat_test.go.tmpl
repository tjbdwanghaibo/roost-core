	}
	f.commit.reject.Store(false)
	f.mustStep(t, 3)
	if move, cast := f.gates(t, 1); !move || !cast {
		t.Fatal("loaded buff failed to expire")
	}
}

func TestCombatStopWaitsForActualQueuedTransaction(t *testing.T) {
	f := newCombatFixture(t)
	f.pair(t)
	f.mustCast(t, 0, 1, 2, "bolt")
	f.now.Add(200)
	block := &combatCommitBlock{entered: make(chan struct{}), release: make(chan struct{})}
	var release sync.Once
	t.Cleanup(func() { release.Do(func() { close(block.release) }) })
	f.commit.block.Store(block)
	var epoch uint64
	f.read(t, func() { epoch = f.players[0].Dao().GetCombatPrivate().GetEpoch() })
	if !gamecombat.Queue(f.players[0].ID(), f.players[1].ID(), epoch) {
		t.Fatal("queue refused")
	}
	select {
	case <-block.entered:
	case <-time.After(time.Second):
		t.Fatal("queued transaction not entered")
	}
	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
	defer cancel()
	if err := f.stop(ctx); !errors.Is(err, context.DeadlineExceeded) {
		t.Fatalf("stop returned before settle: %v", err)
	}
	if _, err := gamecombat.Program("skill.{{PROJECT}}.combat.bolt"); err != nil {
		t.Fatal("timed out stop released runtime")
	}
	if gamecombat.Queue(f.players[0].ID(), f.players[1].ID(), epoch) {
		t.Fatal("stopping service accepted work")
	}
	release.Do(func() { close(block.release) })
	if err := f.stop(context.Background()); err != nil {
		t.Fatal(err)
	}
	if f.health(t, 1) != 90 {
		t.Fatal("stop lost committed delayed hit")
	}
	if _, err := gamecombat.Program("skill.{{PROJECT}}.combat.bolt"); err == nil {
		t.Fatal("settled stop retained runtime")
	}
}
