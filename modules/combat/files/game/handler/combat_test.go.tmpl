func (f *combatFixture) snapshot(t *testing.T) []string {
	out := []string{}
	var readErr error
	f.read(t, func() {
		for _, p := range f.players {
			raw, err := p.Dao().CaptureRollbackState()
			if err != nil {
				readErr = err
				return
			}
			// BSON map 序列化顺序无意义；解码为map后规范JSON比较全部字段，不忽略任何业务状态。
			var value bson.M
			decoder := bson.NewDecoder(bson.NewDocumentReader(bytes.NewReader(raw)))
			decoder.DefaultDocumentM()
			if err = decoder.Decode(&value); err != nil {
				readErr = err
				return
			}
			raw, err = json.Marshal(value)
			if err != nil {
				readErr = err
				return
			}
			out = append(out, string(raw))
			raw, err = p.CombatComp().Core().Dao().CaptureRollbackState()
			if err != nil {
				readErr = err
				return
			}
			out = append(out, string(raw))
		}
	})
	if readErr != nil {
		t.Fatal(readErr)
	}
	return out
}

