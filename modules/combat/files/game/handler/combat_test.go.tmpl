func TestCombatRejectedCastRollsBackBindingsHealthAndCooldown(t *testing.T) {
	f := newCombatFixture(t)
	f.pair(t)
	before := f.snapshot(t)
	f.commit.reject.Store(true)
	if _, err := f.cast(0, 1, 2, "strike"); err == nil {
		t.Fatal("commit accepted")
	}
	if !reflect.DeepEqual(before, f.snapshot(t)) {
		t.Fatal("rejected cast leaked")
	}
	f.commit.reject.Store(false)
	if r := f.mustCast(t, 0, 1, 2, "strike"); r.PeerHealth != 90 {
		t.Fatal("rejected cast consumed cooldown")
	}
}

