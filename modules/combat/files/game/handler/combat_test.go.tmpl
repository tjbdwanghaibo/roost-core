func TestCombatAliasDAOIsRegisteredAndRoundTrips(t *testing.T) {
	f := newCombatFixture(t)
	f.pair(t)
	f.mustCast(t, 0, 1, 2, "strike")
	var count int
	var raw []byte
	var version uint32
	var readErr error
	f.read(t, func() {
		f.players[1].RangeDao(func(d entity.DaoInterface) {
			if d.CollName() == "combat_state" {
				count++
			}
		})
		raw, version, readErr = f.players[1].CombatComp().Core().Dao().MarshalPersisted()
	})
	if count != 1 || readErr != nil {
		t.Fatalf("combat DAO registered %d %v", count, readErr)
	}
	restored := db.NewCombatDAO()
	restored.SetId(f.players[1].ID())
	if err := restored.RestorePersisted(raw, version, 0); err != nil {
		t.Fatal(err)
	}
	again, _, err := restored.MarshalPersisted()
	if err != nil || !reflect.DeepEqual(raw, again) {
		t.Fatal("combat persisted round trip")
	}
}

func TestCombatProtocolUsesSessionAndReportsBusinessCodes(t *testing.T) {
	f := newCombatFixture(t)
	c, err := controller.FromRegistry(f.registry)
	if err != nil {
		t.Fatal(err)
	}
	for i := range 2 {
		r, err := c.HandleCombatReady(&playeraccess.Context{PlayerID: int64(98201 + i)}, &pb.CombatReadyRequest{Sequence: 1, Ready: true})
		if err != nil || r == nil || r.Code != 0 {
			t.Fatalf("ready protocol %+v %v", r, err)
		}
	}
	r, err := c.HandleCombatCast(&playeraccess.Context{PlayerID: 98201}, &pb.CombatCastRequest{Sequence: 2, PeerID: 98202, SkillID: "skill.{{PROJECT}}.combat.strike"})
	if err != nil || r == nil || r.Code != 0 || r.PeerHealth != 90 {
		t.Fatalf("cast protocol %+v %v", r, err)
	}
	r, err = c.HandleCombatCast(&playeraccess.Context{PlayerID: 98202}, &pb.CombatCastRequest{Sequence: 2, PeerID: 98202, SkillID: "skill.{{PROJECT}}.combat.strike"})
	code, _ := errcode.ClientError(apperrors.ErrCombatInvalid)
	if err != nil || r == nil || r.Code != code {
		t.Fatalf("session protocol %+v %v", r, err)
	}
}

func TestCombatConcurrentReplaySharesOneReceipt(t *testing.T) {
	f := newCombatFixture(t)
	f.pair(t)
	var wg sync.WaitGroup
	errs := make(chan error, 8)
	for range 8 {
		wg.Add(1)
		go func() {
			defer wg.Done()
			_, err := f.cast(0, 1, 2, "strike")
			errs <- err
		}()
	}
	wg.Wait()
	close(errs)
	for err := range errs {
		if err != nil {
			t.Fatal(err)
		}
	}
	if f.health(t, 1) != 90 {
		t.Fatal("concurrent double damage")
	}
}

