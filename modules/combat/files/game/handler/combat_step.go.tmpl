package handler

import (
	"github.com/tjbdwanghaibo/roost-core/infra/base/fctx"

	combat "{{MODULE}}/game/components/combat"
	"{{MODULE}}/game/view"
	apperrors "{{MODULE}}/internal/errors"
	"{{MODULE}}/protocol/pb"
)

// handlerCombatStep 声明参与者后才接触Host；失败返回Nest，两个CombatDAO与PlayerDAO一起回滚。
//
//roost:nest rollback=undo
func handlerCombatStep(source, peer view.ICombatEntity, request *pb.CombatStepRequest) (*pb.CombatStepResponse, error) {
	if request == nil {
		return nil, apperrors.ErrCombatInvalid
	}
	c, err := combat.Of(source)
	if err != nil {
		return nil, err
	}
	other, err := combat.Of(peer)
	if err != nil {
		return nil, err
	}
	r, err := c.Step(other, request.Sequence, fctx.Now())
	if err != nil {
		return nil, err
	}
	return &pb.CombatStepResponse{Sequence: r.Sequence, CastID: r.CastID, Health: r.Health, PeerHealth: r.PeerHealth, Alive: r.Alive, PeerAlive: r.PeerAlive, Pending: r.Pending, Ended: r.Ended}, nil
}
