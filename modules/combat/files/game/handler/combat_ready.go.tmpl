package handler

import (
	player "{{MODULE}}/game/entities/player"
	apperrors "{{MODULE}}/internal/errors"
	"{{MODULE}}/protocol/pb"
)

// handlerCombatReady 声明参与者后才接触Host；失败返回Nest，两个CombatDAO与PlayerDAO一起回滚。
//
//roost:nest rollback=undo durability=strict
func handlerCombatReady(source player.ICombatEntity, request *pb.CombatReadyRequest) (*pb.CombatReadyResponse, error) {
	if request == nil {
		return nil, apperrors.ErrCombatInvalid
	}
	r, err := source.CombatComp().Ready(request.Sequence, request.Ready)
	if err != nil {
		return nil, err
	}
	return &pb.CombatReadyResponse{Sequence: r.Sequence, CastID: r.CastID, Health: r.Health, PeerHealth: r.PeerHealth, Alive: r.Alive, PeerAlive: r.PeerAlive, Pending: r.Pending, Ended: r.Ended}, nil
}
