package handler

import (
	player "{{MODULE}}/game/entities/player"
	apperrors "{{MODULE}}/internal/errors"
	"{{MODULE}}/protocol/pb"
)

// handlerCombatLeave 声明参与者后才接触Host；失败返回Nest，两个CombatDAO与PlayerDAO一起回滚。
//
//roost:nest rollback=undo durability=strict
func handlerCombatLeave(source, peer player.ICombatEntity, request *pb.CombatLeaveRequest) (*pb.CombatLeaveResponse, error) {
	if request == nil {
		return nil, apperrors.ErrCombatInvalid
	}
	r, err := source.CombatComp().Leave(peer.CombatComp(), request.Sequence)
	if err != nil {
		return nil, err
	}
	return &pb.CombatLeaveResponse{Sequence: r.Sequence, CastID: r.CastID, Health: r.Health, PeerHealth: r.PeerHealth, Alive: r.Alive, PeerAlive: r.PeerAlive, Pending: r.Pending, Ended: r.Ended}, nil
}
