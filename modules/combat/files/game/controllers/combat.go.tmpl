			out, err = sender.NewCombatLeaveSender(c.nestClient).MultiSync_CombatLeave(ctx.Context(), id, peer, req)
		}
	}
	if err != nil {
		code, reason := errcode.ClientError(err)
		if code == errcode.CodeInternal || code == apperrors.ErrCombatBoundary.Code() {
			slog.ErrorContext(ctx.Context(), "combat: leave failed", "player_id", ctx.PlayerID, "sequence", req.Sequence, "err", err)
