package combat

import (
	"fmt"
	"log/slog"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/infra/base/errcode"

	player "{{MODULE}}/game/entities/player"
	sender "{{MODULE}}/game/handler/syncsender"
	"{{MODULE}}/game/playeraccess"
	apperrors "{{MODULE}}/internal/errors"
	"{{MODULE}}/protocol/pb"
)

// HandleCombatReady 只信认证会话里的source；同意位由双方各自的认证Ready请求写入。
func (c *Controller) HandleCombatReady(ctx *playeraccess.Context, req *pb.CombatReadyRequest) (*pb.CombatReadyResponse, error) {
	if ctx == nil || req == nil {
		return nil, fmt.Errorf("combat: context and request required")
	}
	id, err := entity.BuildEntityID(ctx.PlayerID, player.EntityKindPlayer)
	var out *pb.CombatReadyResponse
	if err == nil {
		out, err = sender.NewCombatReadySender(c.nestClient).Sync_CombatReady(ctx.Context(), id, req)
	}
	if err != nil {
		code, reason := errcode.ClientError(err)
		if code == errcode.CodeInternal || code == apperrors.ErrCombatBoundary.Code() {
			slog.ErrorContext(ctx.Context(), "combat: ready failed", "player_id", ctx.PlayerID, "sequence", req.Sequence, "err", err)
		}
		return &pb.CombatReadyResponse{Code: code, Reason: reason}, nil
	}
	if out != nil && out.Code == 0 {
		slog.InfoContext(ctx.Context(), "combat: ready confirmed", "player_id", ctx.PlayerID, "sequence", req.Sequence, "ready", req.Ready)
	}
	return out, nil
}
