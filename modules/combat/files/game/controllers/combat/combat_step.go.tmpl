package combat

import (
	"fmt"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/infra/base/errcode"

	player "{{MODULE}}/game/entities/player"
	sender "{{MODULE}}/game/handler/syncsender"
	"{{MODULE}}/game/playeraccess"
	"{{MODULE}}/protocol/pb"
)

// HandleCombatStep 只信认证会话里的source；同意位由双方各自的认证Ready请求写入。
func (c *Controller) HandleCombatStep(ctx *playeraccess.Context, req *pb.CombatStepRequest) (*pb.CombatStepResponse, error) {
	if ctx == nil || req == nil {
		return nil, fmt.Errorf("combat: context and request required")
	}
	id, err := entity.BuildEntityID(ctx.PlayerID, player.EntityKindPlayer)
	var out *pb.CombatStepResponse
	if err == nil {
		var peer int64
		peer, err = entity.BuildEntityID(req.PeerID, player.EntityKindPlayer)
		if err == nil {
			out, err = sender.NewCombatStepSender(c.nestClient).MultiSync_CombatStep(ctx.Context(), id, peer, req)
		}
	}
	if err != nil {
		code, reason := errcode.ClientError(err)
		return &pb.CombatStepResponse{Code: code, Reason: reason}, nil
	}
	return out, nil
}
