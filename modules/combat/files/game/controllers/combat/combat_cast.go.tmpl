package combat

import (
	"fmt"
	"log/slog"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/infra/base/errcode"

	player "{{MODULE}}/game/entities/player"
	sender "{{MODULE}}/game/handler/syncsender"
	"github.com/tjbdwanghaibo/roost-core/infra/network/playeraccess"
	apperrors "{{MODULE}}/internal/errors"
	"{{MODULE}}/protocol/pb"
)

// HandleCombatCast 只信认证会话里的source；同意位由双方各自的认证Ready请求写入。
func (c *Controller) HandleCombatCast(ctx *playeraccess.Context, req *pb.CombatCastRequest) (*pb.CombatCastResponse, error) {
	if ctx == nil || req == nil {
		return nil, fmt.Errorf("combat: context and request required")
	}
	id, err := entity.BuildEntityID(ctx.PlayerID, player.EntityKindPlayer)
	var out *pb.CombatCastResponse
	if err == nil {
		var peer int64
		peer, err = entity.BuildEntityID(req.PeerID, player.EntityKindPlayer)
		if err == nil {
			out, err = sender.NewCombatCastSender(c.nestClient).MultiSync_CombatCast(ctx.Context(), id, peer, req)
		}
	}
	if err != nil {
		code, reason := errcode.ClientError(err)
		if code == errcode.CodeInternal || code == apperrors.ErrCombatBoundary.Code() {
			slog.ErrorContext(ctx.Context(), "combat: cast failed", "player_id", ctx.PlayerID, "sequence", req.Sequence, "err", err)
		}
		return &pb.CombatCastResponse{Code: code, Reason: reason}, nil
	}
	return out, nil
}
