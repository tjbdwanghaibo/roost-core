func TestSkillbookStartsTheGameCatalog(t *testing.T) {
	registry := app.NewRegistry(viper.New())
	stop, err := Start(registry)
	if err != nil {
		t.Fatal(err)
	}
	defer stop(context.Background())
	ids, warnings, err := Read(registry)
	// 默认数据和 game-demo 都保留这一份工程自有的 fireball 定义。
	if err != nil || !slices.Contains(ids, "skill.{{PROJECT}}.fireball") || !slices.IsSorted(ids) || len(slices.Compact(slices.Clone(ids))) != len(ids) || warnings != 0 {
		t.Fatalf("catalog = %v, warnings %d, err %v", ids, warnings, err)
	}
}

func TestSkillbookCompileEnvironmentRunsHooksBeforeDigest(t *testing.T) {
	original := compileEnvironmentHooks
	compileEnvironmentHooks = map[string]func(*skill.CompileEnvironment){}
	t.Cleanup(func() { compileEnvironmentHooks = original })
	var order []string
	OnCompileEnvironment("z-last", func(environment *skill.CompileEnvironment) {
		order = append(order, "z")
		environment.Digest = "must-be-recomputed"
	})
	OnCompileEnvironment("a-first", func(_ *skill.CompileEnvironment) { order = append(order, "a") })
	first, second := CompileEnvironment(), CompileEnvironment()
	if !reflect.DeepEqual(order, []string{"a", "z", "a", "z"}) || first.Digest != skill.AuthorityDigest(first) || second.Digest != first.Digest {
		t.Fatalf("unstable environment: hooks=%v first=%s second=%s", order, first.Digest, second.Digest)
	}
}

func TestSkillbookSortsAndCopiesTheResponse(t *testing.T) {
	registry := app.NewRegistry(viper.New())
	_, err := start(registry, func() (*skills.Catalog, error) {
		return &skills.Catalog{
			Programs:    map[string]*skill.Program{"shield": nil, "dash": nil},
			Diagnostics: map[string][]skill.Diagnostic{"dash.json": {{Severity: skill.DiagnosticWarning}}},
		}, nil
	})
	if err != nil {
		t.Fatal(err)
	}
	ids, warnings, err := Read(registry)
	if err != nil || !reflect.DeepEqual(ids, []string{"dash", "shield"}) || warnings != 1 {
		t.Fatalf("%v %d %v", ids, warnings, err)
	}
	ids[0] = "changed by caller"
	again, _, err := Read(registry)
	if err != nil || !reflect.DeepEqual(again, []string{"dash", "shield"}) {
		t.Fatalf("shared result: %v %v", again, err)
	}
}

func TestSkillbookCompileFailurePublishesNothing(t *testing.T) {
	registry := app.NewRegistry(viper.New())
	failure := errors.New("invalid skill definition")
	stop, err := start(registry, func() (*skills.Catalog, error) { return nil, failure })
	if stop != nil || !errors.Is(err, failure) {
		t.Fatalf("compile result: %v, stop set %v", err, stop != nil)
	}
	if _, _, err := Read(registry); err == nil {
		t.Fatal("failed catalog was published")
	}
}

func TestSkillbookRejectsMissingInputs(t *testing.T) {
	if _, err := Start(nil); err == nil {
		t.Fatal("nil registry accepted")
	}
	registry := app.NewRegistry(viper.New())
	if stop, err := start(registry, func() (*skills.Catalog, error) { return nil, nil }); err == nil || stop != nil {
		t.Fatal("nil catalog accepted")
	}
	if _, _, err := Read(nil); err == nil {
		t.Fatal("nil registry read succeeded")
	}
}

func TestSkillbookDuplicateStartPreservesTheRunningCatalog(t *testing.T) {
	registry := app.NewRegistry(viper.New())
	stop, err := Start(registry)
	if err != nil {
		t.Fatal(err)
	}
	defer stop(context.Background())
	before, _, err := Read(registry)
	if err != nil {
		t.Fatal(err)
	}
	if duplicate, err := Start(registry); err == nil || duplicate != nil {
		t.Fatal("duplicate start accepted")
	}
	ids, _, err := Read(registry)
	if err != nil || !reflect.DeepEqual(ids, before) {
		t.Fatalf("running catalog lost: %v %v", ids, err)
	}
}

func TestSkillbookStopClosesReadsAndCanBeRepeated(t *testing.T) {
	registry := app.NewRegistry(viper.New())
	stop, err := Start(registry)
	if err != nil {
		t.Fatal(err)
	}
	if err := stop(context.Background()); err != nil {
		t.Fatal(err)
	}
	if _, _, err := Read(registry); err == nil {
		t.Fatal("stopped catalog can still be read")
	}
	if err := stop(context.Background()); err != nil {
		t.Fatal(err)
	}
}

func TestSkillbookReturnsTheStartupProgramAndChecksItsDigest(t *testing.T) {
	registry := app.NewRegistry(viper.New())
	stop, err := Start(registry)
	if err != nil {
		t.Fatal(err)
	}
	defer stop(context.Background())
	id := "skill.{{PROJECT}}.fireball"
	program, err := LookupProgram(registry, id)
	if err != nil || skill.Inspect(program).ID != id {
		t.Fatalf("lookup %v %v", program, err)
	}
	resolver, err := Resolver(registry)
	if err != nil {
		t.Fatal(err)
	}
	resolved, err := resolver.ResolveProgram(id, skill.Inspect(program).Identity.GameplayDigest)
	if err != nil || resolved != program {
		t.Fatalf("resolver %v", err)
	}
	if _, err := resolver.ResolveProgram(id, "other-version"); !errors.Is(err, skill.ErrCheckpointProgram) {
		t.Fatal("wrong digest accepted", err)
	}
	if _, err := LookupProgram(registry, "missing"); !errors.Is(err, skill.ErrCheckpointProgram) {
		t.Fatal("unknown program", err)
	}
	stop(context.Background())
	if _, err := resolver.ResolveProgram(id, skill.Inspect(program).Identity.GameplayDigest); err == nil {
		t.Fatal("stopped resolver remained live")
	}
}
func TestSkillbookOwnsThePublishedProgramMap(t *testing.T) {
	compiled, err := skills.CompileAll(CompileEnvironment())
	if err != nil {
		t.Fatal(err)
	}
	registry := app.NewRegistry(viper.New())
	stop, err := start(registry, func() (*skills.Catalog, error) { return compiled, nil })
	if err != nil {
		t.Fatal(err)
	}
	defer stop(context.Background())
	id := "skill.{{PROJECT}}.fireball"
	expected := compiled.Programs[id]
	delete(compiled.Programs, id)
	actual, err := LookupProgram(registry, id)
	if err != nil || actual != expected {
		t.Fatal("shared program map", err)
	}
}
