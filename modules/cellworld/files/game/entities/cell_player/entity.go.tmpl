package cell_player

import (
	"errors"
	"fmt"
	"time"

	db "{{MODULE}}/db"
	"{{MODULE}}/game/modules/cellworldhost"
	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/gameplay/cellworld"
	"github.com/tjbdwanghaibo/roost-core/gameplay/heartbeat"
)

const EntityKindCellPlayer entity.EntityKind = {{ID:entity:CellPlayer}}

// ICellPlayerEntity is the lock-safe business view used by Nest handlers.
type ICellPlayerEntity interface{ entity.IThreadSafeEntity }

// CellPlayer 是玩家在分区场景里的那一部分（gameplay/cellworld 的 CellPlayer）：玩家站在哪个格，那个格的 Cell
// 进程上就有一个它，位置、速度、HP、伤害去重表与交接进度都在它的 DAO 上（CellPlayerDao），跨格交接时整份带走，
// ID 不变（BuildEntityID(玩家 ID, CellPlayer)）。Player 本身留在自己 sid 的 Base 进程，不迁移。
//
// 只由分区场景的 Node 在 Nest handler 里建（EntityManager.Create，handler 内即 CreateInScope：事务回滚即撤销），
// Param 是 cellworldhost.CellMode；由 Node 在提交后销毁；不经 lifecycle，普通场景里从不存在。`noPersist=true
// lifetime=ephemeral`：Cell 进程崩溃后由 Base 按 Player 的快照重建。不同步：客户端看到的是 Base 进程上的 Sync mirror。
// 没有业务规则，所以没有组件：方法只把 cellworld.Actor 接到 DAO 映射与格心跳上。
//
// Category：Other（与工程里走格的怪物同档），在 Scene（World）之后加锁——Node 的 handler 一律先锁 Scene、再锁角色。
//
//roost:entity id={{ID:entity:CellPlayer}} entityKind=EntityKindCellPlayer category=entity.EntityCategoryOther noPersist=true lifetime=ephemeral service={{GAME_SERVICE}}
type CellPlayer struct {
	*entity.EntityBase
	entity.ComponentManager
	entity.DaoManager
	dao *db.CellPlayerDao `dao:"cell_player"`

	// host / cell 是格内心跳 cell.actor（Node.ActorBeat）：OnInitFinish 登记、StartCell 启动、SetCellPeriod 换档。
	host *heartbeat.Host
	cell *heartbeat.Reg
}

// OnInitFinish 登记格内心跳（不启动：Node 在装好状态的那笔事务里 StartCell，提交后生效）。只接受分区场景的 Node
// 建出的实例：别的路径建出的 CellPlayer 没有格可待。
func (a *CellPlayer) OnInitFinish(param *entity.EntityCreateParam) error {
	if param == nil || !cellworldhost.IsCellMode(param.Param) {
		return fmt.Errorf("cell player %d: only the partitioned scene creates cell players", a.ID())
	}
	driver := cellworldhost.Heartbeat()
	if driver == nil {
		return fmt.Errorf("cell player %d: this process runs no partitioned scene", a.ID())
	}
	a.host = driver.NewHost(a)
	reg, err := cellworldhost.RegisterActorBeat(a.host, a)
	if err != nil {
		return fmt.Errorf("cell player %d: %w", a.ID(), err)
	}
	a.cell = reg
	return nil
}

// OnDestroy 让格内心跳离开驱动。
func (a *CellPlayer) OnDestroy(entity.EntityDestroyReason) {
	if a.host != nil {
		a.host.OnDestroy()
	}
}

// CellState / SetCellState / StartCell / SetCellPeriod 实现 cellworld.Actor，只在本实体的 Nest 锁内调用。
func (a *CellPlayer) CellState() cellworld.ActorState {
	return cellworldhost.ReadActor(a.dao, a.ID(), cellworld.KindPlayer)
}

func (a *CellPlayer) SetCellState(st cellworld.ActorState) { cellworldhost.WriteActor(a.dao, st) }

func (a *CellPlayer) StartCell() error {
	if a.cell == nil {
		return errors.New("cell player: no cell beat")
	}
	return a.cell.Start()
}

func (a *CellPlayer) SetCellPeriod(period time.Duration) error {
	if a.cell == nil {
		return errors.New("cell player: no cell beat")
	}
	return a.cell.SetPeriod(period)
}

var _ cellworld.Actor = (*CellPlayer)(nil)
