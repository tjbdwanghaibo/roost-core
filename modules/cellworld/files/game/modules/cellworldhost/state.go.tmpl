// 实体一侧的接线：本进程的 cellworld.Node 装在哪里、格心跳怎么登记、Actor 的 DAO 与 cellworld.ActorState、Player 的
// DAO 与 cellworld.BaseState 怎么互相映射。实体包（模块自带的 scene_actor、工程自己的 Player / 走格的怪物 / 场景）
// 引用这里，这里不引用任何实体包。共享授权、迁移与恢复契约见 core 的 gameplay/cellworld/README.md。
// 没有装 Node 的进程（普通场景）这里的函数都不会被调用，或者调用了什么都不做。

// installed 是本进程的 Node 与心跳驱动；scene 是分区场景的 Scene ID（Player 的快照位置记在 SavedSceneID = 它之下）。
// 服务在 Init 里建好 Runtime 之后 Install、Shutdown 时 Uninstall；实体的格内心跳在回调里读它，没装（或已卸）时什么都不做。
var (
	installed atomic.Pointer[installation]
	scene     atomic.Int64
)

type installation struct {
	node   *cellworld.Node
	driver *heartbeat.Driver
}

// Install 装上本进程的 Node、分区场景的 Scene ID 与格内心跳用的驱动（SceneActor 从它取心跳宿主；工程自己的实体
// 用自己的宿主）。一个进程一个；要在 Runtime.Start 之前装，Node 一开始投递就会建 SceneActor。
func Install(n *cellworld.Node, sceneID int64, driver *heartbeat.Driver) {
	scene.Store(sceneID)
	installed.Store(&installation{node: n, driver: driver})
}

// Uninstall 卸下 n（只卸自己装的那一个）。
func Uninstall(n *cellworld.Node) {
	if cur := installed.Load(); cur != nil && cur.node == n {
		installed.CompareAndSwap(cur, nil)
	}
}

// Node 是本进程的 Node；不是分区进程时为 nil。
func Node() *cellworld.Node {
	if cur := installed.Load(); cur != nil {
		return cur.node
	}
	return nil
}

// Heartbeat 是 Install 给的心跳驱动；没装 Node 时为 nil。
func Heartbeat() *heartbeat.Driver {
	if cur := installed.Load(); cur != nil {
		return cur.driver
	}
	return nil
}

// SceneID 是分区场景的 Scene ID（Install 时给出）。
func SceneID() int64 { return scene.Load() }

// CellMode 是分区场景的 Node 在 handler 里新建 SceneActor / 走格的怪物时的 EntityCreateParam.Param：实体据此登记
// 格内心跳（cell.actor），走格的怪物也据此不启动自己的 AI / 移动（格的心跳代替它们）。
type CellMode struct{}

// IsCellMode 报告 param 是不是 CellMode。
func IsCellMode(param any) bool {
	_, ok := param.(CellMode)
	return ok
}

// ErrNoNode 是本进程没有装 Node（不是分区进程，或已经卸下）。
var ErrNoNode = errors.New("cellworldhost: this process runs no partitioned scene")

// RegisterActorBeat 在 host 上登记格内心跳 "cell.actor"（周期取 Node 配置，Node.ActorBeat 推进位置、回写与交接）。
// 只登记不启动：Node 在装好状态的那笔事务里调 Actor.StartCell，提交后生效；换档由 Actor.SetCellPeriod 做。
// 没装 Node 时返回 ErrNoNode；Node 卸下之后已登记的心跳什么都不做。
func RegisterActorBeat(host *heartbeat.Host, owner cellworld.Actor) (*heartbeat.Reg, error) {
	node := Node()
	if node == nil {
		return nil, ErrNoNode
	}
	return host.Register("cell.actor", node.Config().Period, func(beat heartbeat.Beat) error {
		if n := Node(); n != nil {
			return n.ActorBeat(owner, time.Now(), beat.Elapsed)
		}
		return nil
	})
}

// RegisterBaseBeat 在 host 上登记 Base 的路由心跳 "cell.base"（周期是 Node 配置的 WatchPeriod，Node.BaseBeat 做看门狗
// 与租约续期），由 Node 在玩家进场时经 BasePlayer.StartBase 启动。本进程不跑分区场景时返回 (nil, nil)：Player 在
// 普通场景里照常装载，没有这个心跳。
func RegisterBaseBeat(host *heartbeat.Host, owner cellworld.BasePlayer) (*heartbeat.Reg, error) {
	node := Node()
	if node == nil {
		return nil, nil
	}
	return host.Register("cell.base", node.Config().WatchPeriod, func(heartbeat.Beat) error {
		if n := Node(); n != nil {
			return n.BaseBeat(owner, time.Now())
		}
		return nil
	})
}

