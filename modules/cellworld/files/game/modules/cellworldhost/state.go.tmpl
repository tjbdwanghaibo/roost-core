// ReadBase 从 Player 的 DAO 读出分区路由状态。快照位置取 PosX / PosY（实时，随 witness 更新）；HP 与快照版本取持久的
// CellHP / CellSnapEpoch / CellSnapSeq：Base 重启后 Enter 以它们为准重建 SceneActor。面板与 Real 已确认的序号
// （CellPanelAcked）也持久：序号跨 Base 重启单调。Base 重启后重新装载的 Player 不在世界里、实时位置是零（PosX / PosY
// 不持久）：这时快照位置取持久的 SavedPosX / SavedPosY——条件是它记在这个分区场景之下（SavedSceneID == sceneID，
// sceneID 是本进程的分区场景 Scene ID），否则留零，Enter 取出生点。
func ReadBase(d BaseDao, sceneID int64) cellworld.BaseState {
	x, y := d.GetPosX(), d.GetPosY()
	if !d.GetCellInWorld() && x == 0 && y == 0 && sceneID != 0 && d.GetSavedSceneID() == sceneID {
		x, y = d.GetSavedPosX(), d.GetSavedPosY()
	}
	return cellworld.BaseState{
		Recovery: readRecovery(d.GetCellworldBase().GetRecovery()),
		Actor:    d.GetCellActor(), InWorld: d.GetCellInWorld(),
		Cell: d.GetCellOwner(), Epoch: d.GetCellEpoch(),
		X: x, Y: y, HP: int32(d.GetCellHP()),
		SnapVer:   cellworld.Version{Epoch: d.GetCellSnapEpoch(), Seq: d.GetCellSnapSeq()},
		IntentSeq: d.GetCellIntentSeq(), VX: d.GetCellVX(), VY: d.GetCellVY(),
		AttackSeq:  d.GetCellAttackSeq(),
		LastViewAt: d.GetCellViewAt(), LastEnterAt: d.GetCellEnterAt(), LastLeaseAt: d.GetCellLeaseAt(),
		EnterHint: d.GetCellHint(), LostEpoch: d.GetCellLostEpoch(), LostAt: d.GetCellLostAt(),
		Shown: d.GetCellShown(), Entry: d.GetCellEntry(),
		Panel: cellworld.Panel{
			MaxHP: int32(d.GetCellMaxHP()), Attack: int32(d.GetCellAttack()), Power: int32(d.GetCellPower()), Ver: d.GetCellPanelVer(),
		},
		PanelAcked: d.GetCellPanelAcked(), PanelSentAt: d.GetCellPanelSentAt(), PanelSince: d.GetCellPanelSince(),
		PanelUnknown: d.GetCellPanelUnknown(),
		GroupSentAt:  d.GetCellGroupSentAt(), GroupSyncAt: d.GetCellGroupSyncAt(),
		GroupViewID: d.GetCellGroupViewID(), GroupViewVer: d.GetCellGroupViewVer(),
	}
}

// WriteBase 把 st 写进 Player 的 DAO（生成 setter：回滚即还原；持久字段随这笔事务进 WAL）。快照版本前进（Base 接受了
// 一次回写）时，同一笔事务里把位置写进持久的 SavedPosX / SavedPosY / SavedSceneID：回写是“固定时机”，witness 不是——
// 实时位置只写不持久的 PosX / PosY。sceneID 是分区场景的 Scene ID。
func WriteBase(d BaseDao, st cellworld.BaseState, sceneID int64) {
	state := d.GetCellworldBase()
	writeRecovery(state.GetRecovery(), st.Recovery, state.SetRecovery)
	snapshot := st.SnapVer != (cellworld.Version{Epoch: d.GetCellSnapEpoch(), Seq: d.GetCellSnapSeq()})
	d.SetCellActor(st.Actor)
	d.SetCellInWorld(st.InWorld)
	d.SetCellOwner(st.Cell)
	d.SetCellEpoch(st.Epoch)
	d.SetPosX(st.X)
	d.SetPosY(st.Y)
	d.SetCellHP(int64(st.HP))
	d.SetCellSnapEpoch(st.SnapVer.Epoch)
	d.SetCellSnapSeq(st.SnapVer.Seq)
	d.SetCellIntentSeq(st.IntentSeq)
	d.SetCellVX(st.VX)
	d.SetCellVY(st.VY)
	d.SetCellAttackSeq(st.AttackSeq)
	d.SetCellViewAt(st.LastViewAt)
	d.SetCellEnterAt(st.LastEnterAt)
	d.SetCellLeaseAt(st.LastLeaseAt)
	d.SetCellHint(st.EnterHint)
	d.SetCellLostEpoch(st.LostEpoch)
	d.SetCellLostAt(st.LostAt)
	d.SetCellShown(st.Shown)
	d.SetCellEntry(st.Entry)
	d.SetCellMaxHP(int64(st.Panel.MaxHP))
	d.SetCellAttack(int64(st.Panel.Attack))
	d.SetCellPower(int64(st.Panel.Power))
	d.SetCellPanelVer(st.Panel.Ver)
	d.SetCellPanelAcked(st.PanelAcked)
	d.SetCellPanelSentAt(st.PanelSentAt)
	d.SetCellPanelSince(st.PanelSince)
	d.SetCellPanelUnknown(st.PanelUnknown)
	d.SetCellGroupSentAt(st.GroupSentAt)
	d.SetCellGroupSyncAt(st.GroupSyncAt)
	d.SetCellGroupViewID(st.GroupViewID)
	d.SetCellGroupViewVer(st.GroupViewVer)
	if snapshot {
		d.SetSavedSceneID(sceneID)
		d.SetSavedPosX(st.X)
		d.SetSavedPosY(st.Y)
	}
}

// DeathReceipt 是 Player 对 target 记下的最后一条命（cellworld.BasePlayer.CellDeathReceipt）；s 是 PlayerDao.CellworldBase。
// 回执与 SettleDeath 的奖励在同一笔 Player 事务里提交（缺省 async）：重复投递的死亡事实只结算一次。
func DeathReceipt(s *db.CellworldBaseState, target int64) uint64 {
	v, _ := s.GetDeathReceipts(target)
	return v
}

// RecordDeathReceipt 记下 target 的这一条命（cellworld.BasePlayer.RecordCellDeathReceipt）。表里没有 target 且已有
// limit 条时拒绝：Node 不确认这条死亡，等容量（见 CellWorld README“死亡与复活”）。
func RecordDeathReceipt(s *db.CellworldBaseState, target int64, life uint64, limit int) error {
	if _, known := s.GetDeathReceipts(target); !known && s.DeathReceiptsLen() >= limit {
		return fmt.Errorf("cellworld: death receipt capacity exhausted")
	}
	s.SetDeathReceiptsKey(target, life)
	return nil
}

func readOwner(v *db.CellOwnership) (cellworld.OwnerGrant, *cellworld.PendingOwner, bool) {
	if v == nil {
		return cellworld.OwnerGrant{}, nil, false
	}
	grant := cellworld.OwnerGrant{ID: v.GetID(), Epoch: v.GetEpoch(), Process: cellworld.OwnerProcess{SID: v.GetSID(), Incarnation: v.GetIncarnation()}}
	var pending *cellworld.PendingOwner
	if v.GetPendingToken() != "" {
		pending = &cellworld.PendingOwner{Token: v.GetPendingToken(), Transfer: cellworld.OwnerTransfer{ID: v.GetTransferID(), Target: v.GetTransferTarget(), Epoch: v.GetTransferEpoch()}}
	}
	return grant, pending, v.GetCloseEntry()
}

func writeOwner(d CellDao, st cellworld.ActorState) {
	old, pending, closed := readOwner(d.GetCellOwnership())
	samePending := pending == nil && st.Pending == nil || pending != nil && st.Pending != nil && *pending == *st.Pending
	if old == st.Grant && closed == st.CloseEntry && samePending {
		return
	}
	v := &db.CellOwnership{}
	v.SetID(st.Grant.ID)
	v.SetEpoch(st.Grant.Epoch)
	v.SetSID(st.Grant.Process.SID)
	v.SetIncarnation(st.Grant.Process.Incarnation)
	v.SetCloseEntry(st.CloseEntry)
	if st.Pending != nil {
		v.SetPendingToken(st.Pending.Token)
		v.SetTransferID(st.Pending.Transfer.ID)
		v.SetTransferTarget(st.Pending.Transfer.Target)
		v.SetTransferEpoch(st.Pending.Transfer.Epoch)
	}
	d.SetCellOwnership(v)
}

func readRecovery(d *db.CellRecovery) cellworld.RecoveryState {
	if d == nil {
		return cellworld.RecoveryState{}
	}
	s := cellworld.RecoveryState{Revision: d.GetRevision()}
	d.RangeEffects(func(_ int, e db.CellEffect) bool {
		s.Effects = append(s.Effects, cellworld.TimedEffect{Key: e.GetKey(), Stacks: e.GetStacks(), Value: e.GetValue(), ExpiresAt: e.GetExpiresAt()})
		return true
	})
	d.RangeCooldowns(func(_ int, c db.CellCooldown) bool {
		s.Cooldowns = append(s.Cooldowns, cellworld.Cooldown{Key: c.GetKey(), ReadyAt: c.GetReadyAt()})
		return true
	})
	return s
}

// writeRecovery 只在内容变化时整份替换恢复快照（写进 DAO 的值不原地改：回滚的逆操作引用旧值）。
func writeRecovery(stored *db.CellRecovery, s cellworld.RecoveryState, set func(*db.CellRecovery)) {
	old := readRecovery(stored)
	if old.Revision == s.Revision && slices.Equal(old.Effects, s.Effects) && slices.Equal(old.Cooldowns, s.Cooldowns) {
		return
	}
	value := &db.CellRecovery{}
	value.SetRevision(s.Revision)
	effects := make([]db.CellEffect, len(s.Effects))
	for i, e := range s.Effects {
		effects[i].SetKey(e.Key)
		effects[i].SetStacks(e.Stacks)
		effects[i].SetValue(e.Value)
		effects[i].SetExpiresAt(e.ExpiresAt)
	}
	value.SetEffects(effects)
	cooldowns := make([]db.CellCooldown, len(s.Cooldowns))
	for i, c := range s.Cooldowns {
		cooldowns[i].SetKey(c.Key)
		cooldowns[i].SetReadyAt(c.ReadyAt)
	}
	value.SetCooldowns(cooldowns)
	set(value)
}

func readDeath(d *db.CellDeath) *cellworld.DeathFact {
	if d == nil {
		return nil
	}
	v := &cellworld.DeathFact{}
	v.ID = d.GetID()
	v.Target = d.GetTarget()
	v.Life = d.GetLife()
	v.Hit.Attacker = d.GetAttacker()
	v.Hit.Seq = d.GetSequence()
	v.Hit.ID = d.GetHitID()
	v.RewardBase = d.GetRewardBase()
	v.ReplySID = d.GetReplySID()
	v.Damage = d.GetDamage()
	v.At = d.GetAt()
	v.State.Kind = cellworld.EntityKind(d.GetKind())
	v.State.Base = d.GetBase()
	v.State.X = d.GetX()
	v.State.Y = d.GetY()
	v.State.VX = d.GetVX()
	v.State.VY = d.GetVY()
	v.State.Ver.Epoch = d.GetEpoch()
	v.State.Ver.Seq = d.GetStateSeq()
	v.State.Idle = d.GetIdle()
	v.State.Panel.MaxHP = d.GetMaxHP()
	v.State.Panel.Attack = d.GetAttack()
	v.State.Panel.Power = d.GetPower()
	v.State.Panel.Ver = d.GetPanelVer()
	v.State.ID = v.Target
	v.State.Life = v.Life
	return v
}

func writeDeath(d CellDao, v *cellworld.DeathFact) {
	old := readDeath(d.GetCellDeath())
	if v == nil {
		if old != nil {
			d.SetCellDeath(nil)
		}
		return
	}
	if old != nil && *old == *v {
		return
	}
	value := &db.CellDeath{}
	value.SetID(v.ID)
	value.SetTarget(v.Target)
	value.SetLife(v.Life)
	value.SetAttacker(v.Hit.Attacker)
	value.SetSequence(v.Hit.Seq)
	value.SetHitID(v.Hit.ID)
	value.SetRewardBase(v.RewardBase)
	value.SetReplySID(v.ReplySID)
	value.SetDamage(v.Damage)
	value.SetAt(v.At)
	value.SetKind(int32(v.State.Kind))
	value.SetBase(v.State.Base)
	value.SetX(v.State.X)
	value.SetY(v.State.Y)
	value.SetVX(v.State.VX)
	value.SetVY(v.State.VY)
	value.SetEpoch(v.State.Ver.Epoch)
	value.SetStateSeq(v.State.Ver.Seq)
	value.SetIdle(v.State.Idle)
	value.SetMaxHP(v.State.Panel.MaxHP)
	value.SetAttack(v.State.Panel.Attack)
	value.SetPower(v.State.Panel.Power)
	value.SetPanelVer(v.State.Panel.Ver)
	d.SetCellDeath(value)
}
