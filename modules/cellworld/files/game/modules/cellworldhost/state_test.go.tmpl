type nullCommitter struct{}

func (nullCommitter) Commit(context.Context, nest.CommitRecord) error { return nil }

func sampleActor(id int64, kind cellworld.EntityKind, seq uint64) cellworld.ActorState {
	st := cellworld.ActorState{
		EntityState: cellworld.EntityState{ID: id, Kind: kind, Base: 1000, Life: 17, X: 2990, Y: 1500, VX: 120, VY: -30, HP: 70,
			Ver: cellworld.Version{Epoch: 3, Seq: seq}, Idle: kind == cellworld.KindNPC,
			Panel: cellworld.Panel{MaxHP: 120, Attack: 14, Power: 40, Ver: seq}},
		Recovery: cellworld.RecoveryState{Revision: 5, Effects: []cellworld.TimedEffect{{Key: "attack", Stacks: 2, Value: 7, ExpiresAt: 2000000000000}}, Cooldowns: []cellworld.Cooldown{{Key: "dash", ReadyAt: 2000000000001}}},
		Role:     cellworld.RoleFrozen, LastInput: 9,
		Grant:   cellworld.OwnerGrant{ID: "owner", Epoch: 2, Process: cellworld.OwnerProcess{SID: 101, Incarnation: "startup"}},
		Pending: &cellworld.PendingOwner{Token: "operation", Transfer: cellworld.OwnerTransfer{ID: "transfer", Target: 102, Epoch: 3}}, CloseEntry: true,
		Applied:    []cellworld.AppliedHit{{Hit: cellworld.HitID{Attacker: 77, Seq: 1, ID: "first"}, At: 100}, {Hit: cellworld.HitID{Attacker: 78, Seq: 4, ID: "second"}, At: 200}},
		Handoff:    &cellworld.HandoffState{ID: "transfer", Target: cellworld.CellID{Col: 1}, Epoch: 3, StartedAt: 300, LastSent: 400},
		RetryAfter: 5, LeaseUntil: 6, WritebackAt: 7, Entry: 8, FracX: 640, FracY: -250,
	}
	st.SpawnGeneration = 4
	deathState := st.EntityState
	deathState.HP = 0
	st.Death = &cellworld.DeathFact{ID: "death", Target: id, Life: 17, Hit: cellworld.HitID{Attacker: 77, Seq: 3, ID: "hit"}, RewardBase: 1000, ReplySID: 101, Damage: 70, At: 1700000000000, State: deathState}
	st.DeathNextAt = 41
	st.DeathAcked = true
	return st
}

// 映射就是整份状态：写进去的每个字段都读得回来；读出的是副本，改它不碰 DAO；回到 Real 时交接与去重表清掉。
func TestCellworldActorStateRoundTripsThroughTheCellPlayerDAO(t *testing.T) {
	for _, kind := range []cellworld.EntityKind{cellworld.KindPlayer, cellworld.KindNPC} {
		dao := db.NewCellPlayerDao()
		want := sampleActor(42, kind, 10)
		cellworldhost.WriteActor(dao, want)
		if got := cellworldhost.ReadActor(dao, 42, kind); !reflect.DeepEqual(got, want) {
			t.Fatalf("kind %d read back\n got %+v\nwant %+v", kind, got, want)
		}
		got := cellworldhost.ReadActor(dao, 42, kind)
		got.Applied[0].At, got.Handoff.Epoch = 999, 999
		got.Pending.Token = "changed"
		got.Recovery.Effects[0].Stacks = 99
		got.Recovery.Cooldowns[0].ReadyAt = 99
		got.Death.Damage = 1
		if again := cellworldhost.ReadActor(dao, 42, kind); !reflect.DeepEqual(again, want) {
			t.Fatalf("kind %d: a read copy reached the DAO: %+v", kind, again)
		}
		real := want
		real.Role, real.Handoff, real.Applied, real.Death, real.Pending = cellworld.RoleReal, nil, nil, nil, nil
		cellworldhost.WriteActor(dao, real)
		if got := cellworldhost.ReadActor(dao, 42, kind); !reflect.DeepEqual(got, real) {
			t.Fatalf("kind %d after clearing\n got %+v\nwant %+v", kind, got, real)
		}
	}
}

// 心跳或 handler 的事务失败时，格内状态经生成 setter 的逆操作整份还原：状态放在生成 DAO 里就是为了这个。
func TestCellworldActorStateRollsBackWithTheTransaction(t *testing.T) {
	dao := db.NewCellPlayerDao()
	before := sampleActor(42, cellworld.KindPlayer, 10)
	cellworldhost.WriteActor(dao, before)
	failure := errors.New("install failed after the write")
	_, err := nest.RunIsolatedTransaction(context.Background(), nullCommitter{}, "cell_state_rollback", func() (any, error) {
		next := sampleActor(42, cellworld.KindPlayer, 11)
		next.X, next.HP, next.Role = 3100, 50, cellworld.RoleReal
		next.FracX, next.FracY = -999, 1
		next.Applied = append(next.Applied, cellworld.AppliedHit{Hit: cellworld.HitID{Attacker: 79, Seq: 1}, At: 500})
		next.Handoff, next.Death = nil, nil
		next.Recovery.Revision = 6
		cellworldhost.WriteActor(dao, next)
		return nil, failure
	})
	if !errors.Is(err, failure) {
		t.Fatalf("transaction: %v", err)
	}
	if got := cellworldhost.ReadActor(dao, 42, cellworld.KindPlayer); !reflect.DeepEqual(got, before) {
		t.Fatalf("not restored\n got %+v\nwant %+v", got, before)
	}
}

// Base 一侧：实时位置写不持久的 PosX / PosY；持久的快照位置（SavedPosX / SavedPosY / SavedSceneID）只在 Base 接受一次
// 回写、快照版本前进时写——固定时机，不是每份 witness。
func TestCellworldBaseStateWritesTheSnapshotPositionOnlyOnAWriteBack(t *testing.T) {
	const sceneID = 12345
	dao := &baseDao{}
	st := cellworld.BaseState{Actor: 7, InWorld: true, Cell: 1001, Epoch: 2, X: 2900, Y: 1500, HP: 100, IntentSeq: 3, VX: 100, VY: -4, AttackSeq: 4,
		LastViewAt: 11, LastEnterAt: 12, LastLeaseAt: 13, EnterHint: 1002, LostEpoch: 1, LostAt: 14, Shown: true,
		Panel: cellworld.Panel{MaxHP: 110, Attack: 12, Power: 35, Ver: 2}, PanelAcked: 1, PanelSentAt: 50, PanelSince: 40, PanelUnknown: true,
		GroupSentAt: 60, GroupSyncAt: 70, GroupViewID: 9001, GroupViewVer: 3, Entry: 80,
		Recovery: cellworld.RecoveryState{Revision: 2, Effects: []cellworld.TimedEffect{{Key: "shield", Stacks: 1, Value: 3, ExpiresAt: 9}}}}
	cellworldhost.WriteBase(dao, st, sceneID)
	if got := cellworldhost.ReadBase(dao, sceneID); !reflect.DeepEqual(got, st) {
		t.Fatalf("read back\n got %+v\nwant %+v", got, st)
	}
	if dao.savedScene != 0 || dao.savedX != 0 {
		t.Fatalf("a witness wrote the stored position: scene %d x %d", dao.savedScene, dao.savedX)
	}
	st.X, st.Y, st.HP, st.SnapVer = 3010, 1520, 80, cellworld.Version{Epoch: 2, Seq: 40}
	cellworldhost.WriteBase(dao, st, sceneID)
	if dao.savedScene != sceneID || dao.savedX != 3010 || dao.savedY != 1520 || dao.hp != 80 || dao.snapSeq != 40 {
		t.Fatalf("a write-back did not reach the stored fields: %+v", *dao)
	}
	st.X = 3050
	cellworldhost.WriteBase(dao, st, sceneID)
	if dao.savedX != 3010 {
		t.Fatalf("a witness after the write-back moved the stored position to %d", dao.savedX)
	}
}

// Base 重启后重新装载的 Player 不在世界里、实时位置是零：进场位置取持久的快照位置，只有记在这个分区场景之下才算。
func TestCellworldReloadedBaseEntersAtItsSavedPosition(t *testing.T) {
	const sceneID = 12345
	reloaded := func(savedScene int64) *baseDao {
		return &baseDao{savedScene: savedScene, savedX: 1200, savedY: 1450, hp: 70}
	}
	if got := cellworldhost.ReadBase(reloaded(sceneID), sceneID); got.InWorld || got.X != 1200 || got.Y != 1450 || got.HP != 70 {
		t.Fatalf("a reloaded player reads %+v, want its saved position (1200, 1450) and hp 70", got)
	}
	if got := cellworldhost.ReadBase(reloaded(999), sceneID); got.X != 0 || got.Y != 0 {
		t.Fatalf("a position saved under another scene was used: %+v", got)
	}
	inWorld := reloaded(sceneID)
	inWorld.inWorld, inWorld.x, inWorld.y = true, 5, 6
	if got := cellworldhost.ReadBase(inWorld, sceneID); got.X != 5 || got.Y != 6 {
		t.Fatalf("a player in the world read its saved position instead of the live one: %+v", got)
	}
}

// 死亡回执：同一目标再记覆盖；表满时新目标被拒（Node 不确认这条死亡），已有目标照常更新。
func TestCellworldDeathReceiptsRefuseANewTargetWhenFull(t *testing.T) {
	state := &db.CellworldBaseState{}
	if err := cellworldhost.RecordDeathReceipt(state, 1, 3, 2); err != nil {
		t.Fatal(err)
	}
	if err := cellworldhost.RecordDeathReceipt(state, 2, 5, 2); err != nil {
		t.Fatal(err)
	}
	if err := cellworldhost.RecordDeathReceipt(state, 3, 1, 2); err == nil {
		t.Fatal("a third target was recorded past the limit of 2")
	}
	if err := cellworldhost.RecordDeathReceipt(state, 1, 4, 2); err != nil {
		t.Fatalf("a known target was refused when full: %v", err)
	}
	if got := cellworldhost.DeathReceipt(state, 1); got != 4 {
		t.Fatalf("receipt for 1 = %d, want 4", got)
	}
	if got := cellworldhost.DeathReceipt(state, 3); got != 0 {
		t.Fatalf("receipt for the refused target = %d, want 0", got)
	}
}

// 安装时追加在 PlayerDao 末尾的 CellworldBase：死亡回执与恢复快照在 Player 的事务里写，事务失败整份还原；提交后经正式
// 持久编码再水合仍在（Base 重启后靠它们：重复的死亡不再发奖、Buff / 冷却照常恢复）。
func TestCellworldPlayerStateRollsBackAndSurvivesTheStoredForm(t *testing.T) {
	player.RegisterEntity()
	id, err := entity.BuildEntityID(41, player.EntityKindPlayer)
	if err != nil {
		t.Fatal(err)
	}
	dao := db.NewPlayerDao()
	dao.SetId(id)
	// The minimal module-only host lacks session fields; the recipe and game-demo
	// exercise the same tests on their real generated PlayerDao.
	basePlayer := func(d *db.PlayerDao) cellworld.BasePlayer {
		if _, ok := any((*player.Player)(nil)).(cellworld.BasePlayer); !ok {
			return nil
		}
		e, err := entity.BuildEntity(&entity.EntityCreateParam{Id: id, Kind: player.EntityKindPlayer, Dao: map[string]entity.DaoInterface{db.PlayerDaoCollection: d}})
		if err != nil { t.Fatal(err) }
		return e.(cellworld.BasePlayer)
	}
	p := basePlayer(dao)
	conn := func(revision uint64) cellworld.SessionState {
		return cellworld.SessionState{BaseSession: cellworld.BaseSession{SessionID: []string{"", "account1", "account2"}[revision], ConnectionID: []string{"", "nonce1", "nonce2"}[revision], Admission: revision}, OfflineAt: int64(revision)}
	}
	recovery := func(revision uint64) *db.CellRecovery {
		r := &db.CellRecovery{}
		r.SetRevision(revision)
		effects := make([]db.CellEffect, 1)
		effects[0].SetKey("shield")
		effects[0].SetStacks(2)
		effects[0].SetExpiresAt(2000000000000)
		r.SetEffects(effects)
		return r
	}
	write := func(target int64, life uint64, revision uint64, fail error) error {
		t.Helper()
		_, err := nest.RunIsolatedTransaction(context.Background(), nullCommitter{}, "cellworld_player_state", func() (any, error) {
			if err := cellworldhost.RecordDeathReceipt(dao.GetCellworldBase(), target, life, 8); err != nil {
				return nil, err
			}
			if p != nil {
				st := p.BaseState()
				st.Session = conn(revision)
				p.SetBaseState(st)
			}
			dao.GetCellworldBase().SetRecovery(recovery(revision))
			return nil, fail
		})
		return err
	}
	if err := write(781, 9, 1, nil); err != nil {
		t.Fatal(err)
	}
	failure := errors.New("the reward failed after the receipt")
	if err := write(782, 3, 2, failure); !errors.Is(err, failure) {
		t.Fatalf("transaction: %v", err)
	}
	state := dao.GetCellworldBase()
	if _, ok := state.GetDeathReceipts(782); ok || state.GetRecovery().GetRevision() != 1 {
		t.Fatalf("a failed transaction left its receipt or recovery behind: receipts %d, revision %d", state.DeathReceiptsLen(), state.GetRecovery().GetRevision())
	}
	restored := db.NewPlayerDao()
	restored.SetId(id)
	if err := restored.RestorePersisted(dao.MarshalPersist(dataengine.AllFields), db.PlayerDaoSchemaVersion, 1); err != nil {
		t.Fatal(err)
	}
	if p != nil {
		if got := p.BaseState().Session; got != conn(1) {
			t.Fatalf("session was not restored by rollback: %+v", got)
		}
		if got := basePlayer(restored).BaseState().Session; got != (cellworld.SessionState{}) {
			t.Fatalf("session survived restore: %+v", got)
		}
		for _, field := range []string{"CellSocketIDs", "CellSessionID", "CellConnectionID", "CellAdmission", "CellOfflineAt"} {
			if _, ok := dataengine.SyncFieldByName(db.PlayerDaoSyncFields(), field); ok {
				t.Fatalf("private connection field %s is exposed to clients", field)
			}
		}
	}
	again := restored.GetCellworldBase()
	if cellworldhost.DeathReceipt(again, 781) != 9 || again.GetRecovery().GetRevision() != 1 || again.GetRecovery().EffectsLen() != 1 {
		t.Fatalf("the stored form lost the receipt or the recovery: receipt %d, recovery %+v", cellworldhost.DeathReceipt(again, 781), again.GetRecovery())
	}
}

// CellPlayer 只由装了 Node 的进程以 CellMode 建出：没有 Node、不是 CellMode 都拒绝；建出之后格内心跳已登记、可以启动与
// 换档，状态经模块的映射读写。Node 卸下之后 Base 心跳不再登记。
func TestCellworldCellPlayerNeedsTheInstalledNode(t *testing.T) {
	cell_player.RegisterEntity()
	id, err := entity.BuildEntityID(31, cell_player.EntityKindCellPlayer)
	if err != nil {
		t.Fatal(err)
	}
	create := func(param any) error {
		p := &entity.EntityCreateParam{IsCreate: true, Id: id, Kind: cell_player.EntityKindCellPlayer, Category: entity.EntityCategoryOther, Param: param}
		a, err := cell_player.NewCellPlayer(p)
		if err != nil {
			return err
		}
		return a.OnInitFinish(p)
	}
	if err := create(cellworldhost.CellMode{}); err == nil {
		t.Fatal("a cell player was created on a process with no Node")
	}
	if reg, err := cellworldhost.RegisterBaseBeat(nil, nil); reg != nil || err != nil {
		t.Fatalf("base beat without a Node = %v, %v; want nothing", reg, err)
	}
	node := testNode(t)
	driver := heartbeat.NewDriver(heartbeat.Config{Name: "cellworld-state-test"})
	cellworldhost.Install(node, 77, driver)
	defer cellworldhost.Uninstall(node)
	if cellworldhost.Node() != node || cellworldhost.SceneID() != 77 || cellworldhost.Heartbeat() != driver {
		t.Fatal("Install did not publish the node, scene and driver")
	}
	if err := create(struct{}{}); err == nil {
		t.Fatal("a cell player was created without CellMode")
	}
	p := &entity.EntityCreateParam{IsCreate: true, Id: id, Kind: cell_player.EntityKindCellPlayer, Category: entity.EntityCategoryOther, Param: cellworldhost.CellMode{}}
	a, err := cell_player.NewCellPlayer(p)
	if err != nil {
		t.Fatal(err)
	}
	if err := a.OnInitFinish(p); err != nil {
		t.Fatalf("cell player with the installed node: %v", err)
	}
	if err := a.StartCell(); err != nil {
		t.Fatal(err)
	}
	if err := a.SetCellPeriod(100 * time.Millisecond); err != nil {
		t.Fatal(err)
	}
	want := sampleActor(id, cellworld.KindPlayer, 3)
	a.SetCellState(want)
	if got := a.CellState(); !reflect.DeepEqual(got, want) {
		t.Fatalf("cell player state\n got %+v\nwant %+v", got, want)
	}
	a.OnDestroy(entity.DestroyReasonCommon)
	cellworldhost.Uninstall(testNode(t)) // 只卸自己装的那一个
	if cellworldhost.Node() != node {
		t.Fatal("Uninstall of another node took this one down")
	}
	cellworldhost.Uninstall(node)
	if cellworldhost.Node() != nil || cellworldhost.Heartbeat() != nil {
		t.Fatal("Uninstall left the node installed")
	}
	if err := create(cellworldhost.CellMode{}); err == nil {
		t.Fatal("a cell player was created after the node was uninstalled")
	}
}

type idleNest struct{ nest.Client }

type idleTransport struct{}

func (idleTransport) Publish(string, []byte) error { return nil }
func (idleTransport) Subscribe(string, func([]byte)) (func() error, error) {
	return func() error { return nil }, nil
}

// testNode 是只做 Base 的 Node（不托管格，不运行）：只用来给 Install 与心跳登记一个真实的配置。
func testNode(t *testing.T) *cellworld.Node {
	t.Helper()
	grid, err := cellworld.NewGrid(cellworld.GridConfig{Cols: 1, Rows: 1, CellSize: 1000, GhostBand: 100, Hysteresis: 10, Owners: map[cellworld.CellID]int32{{}: 9}})
	if err != nil {
		t.Fatal(err)
	}
	node, err := cellworld.NewNode(cellworld.NodeConfig{World: "statetest", SID: 8, Grid: grid, Transport: idleTransport{}, Nest: idleNest{},
		Destroy: func(context.Context, entity.IThreadSafeEntity) error { return nil }, Scene: 77, ViewRadius: 50,
		PlayerEntity: func(actor int64) int64 { return actor }})
	if err != nil {
		t.Fatal(err)
	}
	return node
}

