package managers

import (
	"context"
	"testing"
	"time"

	"{{MODULE}}/game/cellworldhost"

	"github.com/spf13/viper"
	"github.com/tjbdwanghaibo/roost-core/framework/app"
	kitmanager "github.com/tjbdwanghaibo/roost-core/wiring/manager"
)

// cellworld manager 的场景：经 ManagerMod 起停（与生成的 bootstrap 相同），Start 之前没有 Host、Start 不启动任何 Node，
// Start 之后 Host 已发布、等服务交 Node；停了之后 Host 关闭，再交 Node 被拒绝。Host 排空服务没停下的 Node、Start 没有 Host
// 时拒绝的场景在 game/cellworldhost（TestCellworldHostStopsTheNodeTheServiceLeftRunning、TestCellworldStartNeedsTheManagerHost）。
func TestCellworldHostManagerPublishesTheHostAndClosesItOnStop(t *testing.T) {
	registry := app.NewRegistry(viper.New())
	mod := kitmanager.NewManagerMod(NewCellWorldHost())
	if err := mod.Provide(registry); err != nil {
		t.Fatal(err)
	}
	if _, ok := app.Lookup[*cellworldhost.Host](registry, cellworldhost.HostCapability); ok {
		t.Fatal("the Node host was published before the manager started")
	}
	if err := mod.Start(); err != nil {
		t.Fatal(err)
	}
	host, ok := app.Lookup[*cellworldhost.Host](registry, cellworldhost.HostCapability)
	if !ok || host == nil || host.Closed() {
		t.Fatal("the started manager did not publish an open Node host")
	}
	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
	defer cancel()
	if err := mod.StopWithContext(ctx); err != nil {
		t.Fatalf("stopping the manager mod: %v", err)
	}
	if !host.Closed() {
		t.Fatal("the manager stopped but its Node host still takes a Node")
	}
}
