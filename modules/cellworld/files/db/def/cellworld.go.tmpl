package dbdef

// CellworldBaseState 是模块追加在 PlayerDao 末尾的状态（PlayerDao.CellworldBase，存储键 cellworld_base，持久、不同步）：
// Player 作为 Base 要跨重启保住的两样。Recovery 是 Buff / 冷却的恢复快照（SceneActor 回写时一起写，Base 重启后 Enter 按它
// 重建）；DeathReceipts 是死亡回执（被击杀实体 → 那一条命的 Life），与 SettleDeath 的奖励在同一笔 strict 事务提交，重复投递
// 的死亡只结算一次。其余 Base 字段（路由、快照位置、面板）由工程在 PlayerDao 里声明，见 cellworldhost.BaseDao。
type CellworldBaseState struct {
	Recovery      *CellRecovery    `store:"1"`
	DeathReceipts map[int64]uint64 `store:"2"`
}

// cellworld 模块的嵌套类型：cellworld.ActorState / BaseState 里不是标量的那几样，在 DAO 里各占一个字段。
// 承载 Actor 状态的 DAO（模块自带的 SceneActorDao，工程自己让它在分区场景里走格的实体，例如 game-demo 的 MonsterDao）
// 与 Player 的 Base 状态都用这几个类型；game/modules/cellworldhost 的 ReadActor / WriteActor / ReadBase / WriteBase
// 是它们与 cellworld 值之间唯一的一份映射。存储键发布后不要改。

// CellHit 是一条已结算伤害的去重记录（cellworld.AppliedHit）。
type CellHit struct {
	Attacker int64  `store:"attacker"`
	Seq      uint64 `store:"seq"`
	ID       string `store:"id"`
	At       int64  `store:"at"`
}

// CellHandoff 是冻结中的交接（cellworld.HandoffState）。时间是系统时间 UnixNano。
type CellHandoff struct {
	ID        string `store:"id"`
	Col       int32  `store:"col"`
	Row       int32  `store:"row"`
	Epoch     uint64 `store:"epoch"`
	StartedAt int64  `store:"started_at"`
	LastSent  int64  `store:"last_sent"`
}

// CellOwnership 对应 cellworld 的授权与待确认操作，不传给客户端。
type CellOwnership struct {
	ID             string `store:"id"`
	Epoch          uint64 `store:"epoch"`
	SID            int32  `store:"sid"`
	Incarnation    string `store:"incarnation"`
	CloseEntry     bool   `store:"closed"`
	PendingToken   string `store:"pending"`
	TransferID     string `store:"transfer"`
	TransferTarget int32  `store:"target"`
	TransferEpoch  uint64 `store:"transfer_epoch"`
}

// CellRecovery 是限时状态的可恢复表示；绝对 UTC 毫秒截止在停机期间照常流逝。
type CellRecovery struct {
	Revision  uint64         `store:"v"`
	Effects   []CellEffect   `store:"e"`
	Cooldowns []CellCooldown `store:"c"`
}

// CellEffect 是一条限时效果（cellworld.TimedEffect）。
type CellEffect struct {
	Key       string `store:"k"`
	Stacks    int32  `store:"s"`
	Value     int64  `store:"v"`
	ExpiresAt int64  `store:"e"`
}

// CellCooldown 是一条冷却（cellworld.Cooldown）。
type CellCooldown struct {
	Key     string `store:"k"`
	ReadyAt int64  `store:"r"`
}

// CellDeath 是尚在完成持久死亡 / 奖励确认的临时代理状态。权威事实在共享 OwnerRegistry。
type CellDeath struct {
	ID         string `store:"1"`
	Target     int64  `store:"2"`
	Life       uint64 `store:"3"`
	Attacker   int64  `store:"4"`
	Sequence   uint64 `store:"5"`
	HitID      string `store:"6"`
	RewardBase int32  `store:"7"`
	ReplySID   int32  `store:"8"`
	Damage     int32  `store:"9"`
	At         int64  `store:"10"`
	Kind       int32  `store:"11"`
	Base       int32  `store:"12"`
	X          int64  `store:"13"`
	Y          int64  `store:"14"`
	VX         int64  `store:"15"`
	VY         int64  `store:"16"`
	Epoch      uint64 `store:"17"`
	StateSeq   uint64 `store:"18"`
	Idle       bool   `store:"19"`
	MaxHP      int32  `store:"20"`
	Attack     int32  `store:"21"`
	Power      int32  `store:"22"`
	PanelVer   uint64 `store:"23"`
}
