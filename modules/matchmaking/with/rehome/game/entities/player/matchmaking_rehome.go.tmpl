package player

import (
	apperrors "{{MODULE}}/internal/errors"
	gamerehome "{{MODULE}}/game/rehome"
)

func init() {
	OnRehomeApplying("matchmaking", func(p *Player, _ gamerehome.Move, _ int64) error {
		if p.Dao().GetMatchmaking().GetPhase() != "" {
			return apperrors.ErrMatchmakingBusy
		}
		return nil
	})
	OnMatchmakingStarting("rehome", func(p *Player) error {
		if p.Dao().GetRehome().GetPendingID() != "" {
			return apperrors.ErrMatchmakingBusy
		}
		return nil
	})
}
