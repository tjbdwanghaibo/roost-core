package matchmaking

import (
	"fmt"
	"math"
	"slices"
	"sort"
	"sync"
	teamcomp "{{MODULE}}/game/components/team"
	"{{MODULE}}/game/view"

	apperrors "{{MODULE}}/internal/errors"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

// Owner 是 Matchmaking 组件的宿主：整个 Player（组件运行钩子时要把宿主交给钩子）。只在实体被 Nest 锁住期间使用。
type Owner = view.PlayerEntity

type Component struct {
	entity.ComponentBase
	owner Owner
}

func init() {
	// 单排也必须挡住建队 / 接受邀请；检查与 Team、Player 修改处于同一笔事务。
	// 匹配终态未 Clear 前仍保留屏障，不能凭客户端丢回包或进程重启解除。
	teamcomp.OnTeamJoining("matchmaking", func(p view.PlayerEntity) error {
		if p.Dao().GetMatchmaking().GetPhase() != "" {
			return apperrors.ErrMatchmakingBusy
		}
		return nil
	})
}

// NewComponent 是组件工厂；Player 在 game/entities/player/matchmaking_component.go 登记它。
func NewComponent(value any, _ *entity.EntityCreateParam) (entity.ComponentInterfaceBase, error) {
	owner, ok := value.(Owner)
	if !ok {
		return nil, fmt.Errorf("matchmaking component: owner %T does not implement matchmaking.Owner", value)
	}
	return &Component{owner: owner}, nil
}

// 匹配阶段的取值定义在 game/view（MatchSnapshot.Terminal 要用），这里留同名常量。
const (
	MatchPreparing   = view.MatchPreparing
	MatchDispatching = view.MatchDispatching
	MatchQueued      = view.MatchQueued
	MatchCancelling  = view.MatchCancelling
	MatchMatched     = view.MatchMatched
	MatchCancelled   = view.MatchCancelled
	MatchExpired     = view.MatchExpired
)

// MatchSnapshot 是 view.MatchSnapshot（结构体定义在 game/view，这里留同名别名，组件与 handler 的写法不变）。
type MatchSnapshot = view.MatchSnapshot

func (c *Component) Name() string { return "matchmaking" }
func (c *Component) Snapshot() MatchSnapshot {
	d := c.owner.Dao().GetMatchmaking()
	s := MatchSnapshot{Sequence: d.GetSequence(), Key: d.GetKey(), Leader: d.GetLeader(), TeamID: d.GetTeamID(), SID: d.GetSID(), Phase: d.GetPhase(), TicketID: d.GetTicketID(), MatchID: d.GetMatchID(), RoomID: d.GetRoomID(), Deadline: d.GetDeadline()}
	d.RangeMembers(func(_ int, id int64) bool { s.Members = append(s.Members, id); return true })
	return s
}

// OnMatchmakingStarting 的真实消费者为 rehome：检查和意图写入必须在同一 Player 事务里。
var matchmakingChecks = struct {
	sync.RWMutex
	hooks map[string]func(view.PlayerEntity) error
}{hooks: map[string]func(view.PlayerEntity) error{}}

func OnMatchmakingStarting(name string, check func(view.PlayerEntity) error) {
	if name == "" || check == nil {
		panic("matchmaking: invalid check")
	}
	matchmakingChecks.Lock()
	defer matchmakingChecks.Unlock()
	if matchmakingChecks.hooks[name] != nil {
		panic("matchmaking: duplicate check " + name)
	}
	matchmakingChecks.hooks[name] = check
}
func (c *Component) checkStart() error {
	matchmakingChecks.RLock()
	names := make([]string, 0, len(matchmakingChecks.hooks))
	for n := range matchmakingChecks.hooks {
		names = append(names, n)
	}
	sort.Strings(names)
	checks := make([]func(view.PlayerEntity) error, 0, len(names))
	for _, n := range names {
		checks = append(checks, matchmakingChecks.hooks[n])
	}
	matchmakingChecks.RUnlock()
	for _, check := range checks {
		if err := check(c.owner); err != nil {
			return err
		}
	}
	return nil
}

// BeginMatching 由 solo 或 Team+Players handler 调用；请求者必须在声明的组中，重复请求不重新申请外部票。
func BeginMatching(group []*Component, leader, sequence, teamID int64, sid int32, now int64) (MatchSnapshot, error) {
	if len(group) == 0 || len(group) > 8 || leader <= 0 || sequence <= 0 || sid <= 0 || now < 0 || now > math.MaxInt64-60000 {
		return MatchSnapshot{}, apperrors.ErrMatchmakingInvalid
	}
	ids := make([]int64, 0, len(group))
	var first *Component
	for _, v := range group {
		id := entity.GetUniqueIDFromEntityID(v.owner.ID())
		ids = append(ids, id)
		if id == leader {
			first = v
		}
	}
	slices.Sort(ids)
	if first == nil || len(slices.Compact(slices.Clone(ids))) != len(ids) {
		return MatchSnapshot{}, apperrors.ErrMatchmakingInvalid
	}
	key := fmt.Sprintf("%d:%d", leader, sequence)
	previous := first.Snapshot()
	if previous.Key == key {
		if previous.TeamID != teamID || previous.SID != sid || !slices.Equal(previous.Members, ids) {
			return MatchSnapshot{}, apperrors.ErrMatchmakingStale
		}
		return previous, nil
	}
	if previous.Sequence == math.MaxInt64 || sequence != previous.Sequence+1 {
		return MatchSnapshot{}, apperrors.ErrMatchmakingStale
	}
	for _, v := range group {
		c := v
		d := c.owner.Dao().GetMatchmaking()
		if d.GetPhase() != "" || d.GetSequence() == math.MaxInt64 || c.owner.Team().TeamID() != teamID {
			return MatchSnapshot{}, apperrors.ErrMatchmakingBusy
		}
		if err := c.checkStart(); err != nil {
			return MatchSnapshot{}, err
		}
	}
	for _, v := range group {
		d := v.owner.Dao().GetMatchmaking()
		d.SetSequence(d.GetSequence() + 1)
		d.SetKey(key)
		d.SetLeader(leader)
		d.SetTeamID(teamID)
		d.SetMembers(slices.Clone(ids))
		d.SetSID(sid)
		d.SetPhase(MatchPreparing)
		d.SetDeadline(now + 60000)
	}
	return first.Snapshot(), nil
}

// MatchUpdate 只能由可信服务端构造，客户端只能发协议中允许的动作。组内每个成员必须仍属于该意图。
type MatchUpdate struct {
	Key, Action, TicketID, MatchID string
	RoomID                         int64
	Now                            int64
}

func UpdateMatching(group []*Component, u MatchUpdate) (MatchSnapshot, error) {
	if len(group) == 0 || u.Key == "" {
		return MatchSnapshot{}, apperrors.ErrMatchmakingInvalid
	}
	s := group[0].Snapshot()
	ids := make([]int64, 0, len(group))
	for _, v := range group {
		p := v.Snapshot()
		ids = append(ids, entity.GetUniqueIDFromEntityID(v.owner.ID()))
		if p.Key != u.Key || p.Phase != s.Phase || p.TicketID != s.TicketID || p.MatchID != s.MatchID || p.RoomID != s.RoomID {
			return MatchSnapshot{}, apperrors.ErrMatchmakingStale
		}
	}
	slices.Sort(ids)
	if !slices.Equal(ids, s.Members) {
		return MatchSnapshot{}, apperrors.ErrMatchmakingInvalid
	}
	phase := s.Phase
	switch u.Action {
	case "dispatch":
		if phase != MatchPreparing {
			return MatchSnapshot{}, apperrors.ErrMatchmakingStale
		}
		phase = MatchDispatching
	case "bind":
		if u.TicketID == "" || s.Terminal() || (s.TicketID != "" && s.TicketID != u.TicketID) {
			return MatchSnapshot{}, apperrors.ErrMatchmakingStale
		}
		if phase != MatchDispatching && phase != MatchCancelling && phase != MatchQueued {
			return MatchSnapshot{}, apperrors.ErrMatchmakingStale
		}
		if phase != MatchCancelling {
			phase = MatchQueued
		}
	case "cancel":
		if s.Terminal() {
			return s, nil
		}
		if phase == MatchPreparing {
			phase = MatchCancelled
		} else {
			phase = MatchCancelling
		}
	case "cancelled", "expired":
		if s.Terminal() {
			if s.Phase == u.Action {
				return s, nil
			}
			return MatchSnapshot{}, apperrors.ErrMatchmakingStale
		}
		phase = u.Action
	case "abandon":
		// 没有绑定过 Ticket 的意图从未成为候选。到期后允许收尾；迟到回包的 bind 会因终态拒绝。
		if s.TicketID != "" || u.Now < s.Deadline || s.Terminal() {
			return MatchSnapshot{}, apperrors.ErrMatchmakingStale
		}
		phase = MatchExpired
	case "matched":
		if u.MatchID == "" || u.RoomID <= 0 || s.TicketID == "" {
			return MatchSnapshot{}, apperrors.ErrMatchmakingInvalid
		}
		if s.Terminal() {
			if s.Phase == MatchMatched && s.MatchID == u.MatchID && s.RoomID == u.RoomID {
				return s, nil
			}
			return MatchSnapshot{}, apperrors.ErrMatchmakingStale
		}
		phase = MatchMatched
	default:
		return MatchSnapshot{}, apperrors.ErrMatchmakingInvalid
	}
	for _, v := range group {
		d := v.owner.Dao().GetMatchmaking()
		d.SetPhase(phase)
		if u.Action == "bind" {
			d.SetTicketID(u.TicketID)
		}
		if u.Action == "matched" {
			d.SetMatchID(u.MatchID)
			d.SetRoomID(u.RoomID)
		}
	}
	return group[0].Snapshot(), nil
}

// Clear 保留个人递增序号。匹配成功必须先在锁外核对 Room 已关闭，然后按 Key 做 CAS。
func (c *Component) Clear(key string) error {
	s := c.Snapshot()
	if s.Key != key || !s.Terminal() {
		return apperrors.ErrMatchmakingStale
	}
	d := c.owner.Dao().GetMatchmaking()
	d.SetKey("")
	d.SetLeader(0)
	d.SetTeamID(0)
	d.SetMembers(nil)
	d.SetSID(0)
	d.SetPhase("")
	d.SetTicketID("")
	d.SetMatchID("")
	d.SetRoomID(0)
	d.SetDeadline(0)
	return nil
}
