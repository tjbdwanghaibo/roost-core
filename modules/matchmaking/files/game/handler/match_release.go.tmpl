package handler

import (
	"slices"

	apperrors "{{MODULE}}/internal/errors"
	"{{MODULE}}/game/view"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:nest rollback=undo
func handlerMatchRelease(target view.TeamEntity, members []view.IMatchmakingEntity, key string) error {
	if target.Dao().GetMatchKey() != key {
		return nil
	}
	ids := make([]int64, 0, len(members))
	for _, member := range members {
		s := member.Matchmaking().Snapshot()
		if s.Key != key || !s.Terminal() || s.TeamID != target.ID() {
			return apperrors.ErrMatchmakingStale
		}
		ids = append(ids, entity.GetUniqueIDFromEntityID(member.ID()))
	}
	slices.Sort(ids)
	if !slices.Equal(ids, target.TeamRoster().Info().Members) {
		return apperrors.ErrMatchmakingStale
	}
	return target.TeamRoster().ReleaseMatch(key)
}
