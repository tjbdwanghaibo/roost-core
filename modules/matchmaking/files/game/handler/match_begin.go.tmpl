package handler

import (
	gamematchmaking "{{MODULE}}/game/components/matchmaking"
	"{{MODULE}}/game/view"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/infra/base/clock"
)

//roost:nest rollback=undo durability=strict
func handlerMatchBegin(member view.IMatchmakingEntity, sequence int64, sid int32) (gamematchmaking.MatchSnapshot, error) {
	component, err := gamematchmaking.Of(member)
	if err != nil {
		return gamematchmaking.MatchSnapshot{}, err
	}
	return gamematchmaking.BeginMatching([]*gamematchmaking.Component{component}, entity.GetUniqueIDFromEntityID(member.ID()), sequence, 0, sid, clock.UnixMilli())
}
