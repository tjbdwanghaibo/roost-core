package handler

import (
	player "{{MODULE}}/game/entities/player"

	gamematchmaking "{{MODULE}}/game/components/matchmaking"
	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/infra/base/clock"
)

//roost:nest rollback=undo durability=strict
func handlerMatchBegin(member player.IMatchmakingEntity, sequence int64, sid int32) (gamematchmaking.MatchSnapshot, error) {
	return gamematchmaking.BeginMatching([]*player.MatchmakingComponent{member.MatchmakingComp()}, entity.GetUniqueIDFromEntityID(member.ID()), sequence, 0, sid, clock.UnixMilli())
}
