package handler

import (
	"slices"

	apperrors "{{MODULE}}/internal/errors"
	player "{{MODULE}}/game/entities/player"
	gamematchmaking "{{MODULE}}/game/components/matchmaking"
	team "{{MODULE}}/game/entities/team"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/infra/base/clock"
)

//roost:nest rollback=undo durability=strict
func handlerMatchTeamBegin(target team.ITeamEntity, members []player.IMatchmakingEntity, leader, sequence int64, sid int32) (gamematchmaking.MatchSnapshot, error) {
	t := target.TeamEntity()
	info := t.TeamRoster().Info()
	ids := make([]int64, 0, len(members))
	for _, m := range members {
		ids = append(ids, entity.GetUniqueIDFromEntityID(m.ID()))
	}
	slices.Sort(ids)
	if info.Leader != leader || !slices.Equal(ids, info.Members) {
		return gamematchmaking.MatchSnapshot{}, apperrors.ErrMatchmakingStale
	}
	for _, member := range ids {
		if info.SIDs[member] != sid {
			return gamematchmaking.MatchSnapshot{}, apperrors.ErrMatchmakingInvalid
		}
	}
	s, err := gamematchmaking.BeginMatching(player.MatchmakingComps(members), leader, sequence, t.ID(), sid, clock.UnixMilli())
	if err != nil {
		return gamematchmaking.MatchSnapshot{}, err
	}
	if !s.Terminal() {
		if err := t.TeamRoster().HoldMatch(s.Key); err != nil {
			return gamematchmaking.MatchSnapshot{}, err
		}
	}
	return s, nil
}
