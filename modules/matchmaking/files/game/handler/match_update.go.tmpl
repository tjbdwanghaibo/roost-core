package handler

import (
	gamematchmaking "{{MODULE}}/game/components/matchmaking"
	"{{MODULE}}/game/view"
)

//roost:nest rollback=undo durability=strict
func handlerMatchUpdate(members []view.IMatchmakingEntity, change gamematchmaking.MatchUpdate) (gamematchmaking.MatchSnapshot, error) {
	group, err := gamematchmaking.Group(members)
	if err != nil {
		return gamematchmaking.MatchSnapshot{}, err
	}
	return gamematchmaking.UpdateMatching(group, change)
}
