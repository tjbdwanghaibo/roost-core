package player

import (
	"{{MODULE}}/game/components/matchmaking"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:Matchmaking}}
const CompTypeMatchmaking entity.ComponentType = {{ID:component:Matchmaking}}

// MatchmakingComponent 是 game/components/matchmaking 的组件在 Player 上的名字（生成接线与 handler 用它）；业务在那个包里。
type MatchmakingComponent = matchmaking.Component

type IMatchmakingEntity interface {
	entity.IThreadSafeEntity
	MatchmakingComp() *MatchmakingComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeMatchmaking, matchmaking.NewComponent)
}

// MatchmakingComps 把 Nest 交来的一组玩家换成组件（matchmaking.BeginMatching / UpdateMatching 收组件）。
func MatchmakingComps(members []IMatchmakingEntity) []*MatchmakingComponent {
	out := make([]*MatchmakingComponent, len(members))
	for i, member := range members {
		out[i] = member.MatchmakingComp()
	}
	return out
}
