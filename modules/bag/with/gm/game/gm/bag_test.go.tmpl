package gm

import (
	"context"
	"encoding/json"
	"os"
	"path/filepath"
	"testing"

	"{{MODULE}}/configs/schema"
	player "{{MODULE}}/game/entities/player"
	"{{MODULE}}/game/handler"

	"github.com/tjbdwanghaibo/roost-core/framework/configdata"
	"github.com/tjbdwanghaibo/roost-core/framework/entity"
