package player

import (
	db "{{MODULE}}/db"
	"{{MODULE}}/game/components/bag"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:Bag}}
const CompTypeBag entity.ComponentType = {{ID:component:Bag}}

// BagComponent 是共用背包组件 bag.Component 的类型别名，只为 Player 的生成接线命名。
// 背包业务（Add / Remove / Count / Has）与道具规则全部在 game/components/bag；这里只把 PlayerDao.Bag 交给它。
type BagComponent = bag.Component

// IBagEntity 是 Nest handler 用这个组件时的窄实体接口；getter 由生成的 Entity 接线实现。
// 别的功能在自己的 handler 里要发道具或扣道具时，目标接口里嵌入它即可（同一个实体、同一笔事务）。
type IBagEntity interface {
	entity.IThreadSafeEntity
	BagComp() *BagComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeBag, bag.NewComponent)
}

// BagState 实现 bag.Owner：只在 Player 被 Nest 锁住期间调用。
func (e *Player) BagState() *db.BagState { return e.Dao().GetBag() }
