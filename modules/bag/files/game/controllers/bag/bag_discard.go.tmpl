package bag

import (
	"log/slog"

	"github.com/tjbdwanghaibo/roost-core/infra/network/playeraccess"
	"{{MODULE}}/protocol/pb"
)

// HandleBagDiscard 是丢弃协议的入口；目标取认证会话的玩家（只能丢自己的道具），
// 数量与持有量在 Nest handler 的锁内校验。
//
//roost:endpoint nest=BagDiscard
func (controller *Controller) HandleBagDiscard(ctx *playeraccess.Context, req *pb.BagDiscardRequest) (*pb.BagDiscardResponse, error) {
	response, err := controller.dispatchBagDiscard(ctx, req)
	// 只记录已确认的请求结果；带业务键的重放也会返回成功，不把日志当作资产流水。
	if err == nil && response != nil && response.Code == 0 && ctx != nil && req != nil {
		slog.InfoContext(ctx.Context(), "bag: discard completed", "player_id", ctx.PlayerID, "item_id", response.ItemID, "count", req.Count, "left", response.Left)
	}
	return response, err
}
