package dbdef

// RoomDao 只存房间事实；客户端经带成员检查的 PB 查询读快照，不直接订阅整份 DAO。
// Closed 是终态；空房第一次等待成员与最后一名成员离开后的空房是不同的状态。
//
//roost:dao coll=room db=main dbscope=sid
type RoomDao struct {
	Capacity  int32               `dao:"nosync" store:"1"`
	Closed    bool                `dao:"nosync" store:"2"`
	HostID    int64               `dao:"nosync" store:"3"`
	EpochSeed uint64              `dao:"nosync" store:"4"`
	Seats     map[int64]*RoomSeat `dao:"nosync,map=fast" store:"5"`
}

// RoomSeat 的代际来自房间的持久 seed：离开后再入也不复用，旧断线通知不能伤及新席位。
// Slot 为 1 起算的稳定座位号，不依赖 map 的遍历顺序；断线仍占座，清理策略由玩法决定。
type RoomSeat struct {
	Slot       int32  `store:"1"`
	Epoch      uint64 `store:"2"`
	Connected  bool   `store:"3"`
	Connection string `store:"4"`
}
