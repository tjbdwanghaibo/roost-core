package room

import (
	"fmt"
	"log/slog"

	"github.com/tjbdwanghaibo/roost-core/infra/base/errcode"
	syncsender "{{MODULE}}/game/handler/syncsender"
	"github.com/tjbdwanghaibo/roost-core/infra/network/playeraccess"
	roomlogic "{{MODULE}}/game/room"
	"{{MODULE}}/protocol/pb"
)

// HandleRoomClose 只把认证会话的玩家号交给 Nest；PB 没有可伪造的操作者字段。
func (controller *Controller) HandleRoomClose(ctx *playeraccess.Context, req *pb.RoomCloseRequest) (*pb.RoomCloseResponse, error) {
	if ctx == nil || ctx.PlayerID <= 0 || req == nil {
		return nil, fmt.Errorf("room: authenticated context and request are required")
	}
	response := &pb.RoomCloseResponse{}
	connection, err := roomlogic.ConnectionKey(ctx.Session)
	var id int64
	if err == nil {
		id, err = roomlogic.EntityID(req.RoomID)
	}
	if err == nil {
		err = syncsender.NewRoomCloseSender(controller.nestClient).Sync_RoomClose(ctx.Context(), id, ctx.PlayerID, req.Epoch, connection)
	}
	if err != nil {
		response.Code, response.Reason = errcode.ClientError(err)
		if response.Code == errcode.CodeInternal {
			slog.ErrorContext(ctx.Context(), "room close failed", "room_id", req.RoomID, "player_id", ctx.PlayerID, "err", err)
		}
	}
	if err == nil {
		slog.InfoContext(ctx.Context(), "room: close completed", "player_id", ctx.PlayerID, "room_id", req.RoomID)
	}
	return response, nil
}
