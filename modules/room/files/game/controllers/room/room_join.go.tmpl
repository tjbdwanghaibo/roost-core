package room

import (
	"fmt"
	"log/slog"

	"github.com/tjbdwanghaibo/roost-core/infra/base/errcode"
	roomentity "{{MODULE}}/game/entities/room"
	syncsender "{{MODULE}}/game/handler/syncsender"
	"github.com/tjbdwanghaibo/roost-core/infra/network/playeraccess"
	roomlogic "{{MODULE}}/game/room"
	"{{MODULE}}/protocol/pb"
)

// HandleRoomJoin 只把认证会话的玩家号交给 Nest；PB 没有可伪造的操作者字段。
func (controller *Controller) HandleRoomJoin(ctx *playeraccess.Context, req *pb.RoomJoinRequest) (*pb.RoomJoinResponse, error) {
	if ctx == nil || ctx.PlayerID <= 0 || req == nil {
		return nil, fmt.Errorf("room: authenticated context and request are required")
	}
	response := &pb.RoomJoinResponse{}
	connection, err := roomlogic.ConnectionKey(ctx.Session)
	var id int64
	if err == nil {
		id, err = roomlogic.EntityID(req.RoomID)
	}
	if err == nil {
		var result roomentity.RoomSnapshot
		result, err = syncsender.NewRoomJoinSender(controller.nestClient).Sync_RoomJoin(ctx.Context(), id, ctx.PlayerID, connection)
		if err == nil {
			response.Info = roomInfo(req.RoomID, result)
		}
	}
	if err != nil {
		response.Code, response.Reason = errcode.ClientError(err)
		if response.Code == errcode.CodeInternal {
			slog.ErrorContext(ctx.Context(), "room join failed", "room_id", req.RoomID, "player_id", ctx.PlayerID, "err", err)
		}
	}
	if err == nil && response.Info != nil {
		slog.InfoContext(ctx.Context(), "room: join completed", "player_id", ctx.PlayerID, "room_id", req.RoomID, "host_id", response.Info.HostID)
	}
	return response, nil
}
