		roomlogic.PresenceFromRegistry(controller.registry).Forget(req.RoomID, ctx.PlayerID)
		slog.InfoContext(ctx.Context(), "room: leave completed", "player_id", ctx.PlayerID, "room_id", req.RoomID)
	}
	return response, nil
}

// HandleRoomReconnect 只把认证会话的玩家号交给 Nest；PB 没有可伪造的操作者字段。
func (controller *Controller) HandleRoomReconnect(ctx *playeraccess.Context, req *pb.RoomReconnectRequest) (*pb.RoomReconnectResponse, error) {
	if ctx == nil || ctx.PlayerID <= 0 || req == nil {
		return nil, fmt.Errorf("room: authenticated context and request are required")
	}
	response := &pb.RoomReconnectResponse{}
	connection, err := roomlogic.ConnectionKey(ctx.Session)
	var id int64
	if err == nil {
		id, err = roomlogic.EntityID(req.RoomID)
	}
	if err == nil {
		var result view.RoomSnapshot
		result, err = syncsender.NewRoomReconnectSender(controller.nestClient).Sync_RoomReconnect(ctx.Context(), id, ctx.PlayerID, req.Epoch, connection)
		if err == nil {
			response.Info = roomInfo(req.RoomID, result)
			// 换了连接：登记新连接（同房间的旧连接登记随之撤掉）。
			roomlogic.PresenceFromRegistry(controller.registry).Track(req.RoomID, ctx.PlayerID, connection, result.Epoch)
		}
	}
	if err != nil {
		response.Code, response.Reason = errcode.ClientError(err)
		if response.Code == errcode.CodeInternal {
			slog.ErrorContext(ctx.Context(), "room reconnect failed", "room_id", req.RoomID, "player_id", ctx.PlayerID, "err", err)
		}
	}
	if err == nil {
		slog.InfoContext(ctx.Context(), "room: reconnect completed", "player_id", ctx.PlayerID, "room_id", req.RoomID)
	}
	return response, nil
}

// HandleRoomView 只把认证会话的玩家号交给 Nest；PB 没有可伪造的操作者字段。
func (controller *Controller) HandleRoomView(ctx *playeraccess.Context, req *pb.RoomViewRequest) (*pb.RoomViewResponse, error) {
	if ctx == nil || ctx.PlayerID <= 0 || req == nil {
		return nil, fmt.Errorf("room: authenticated context and request are required")
	}
	response := &pb.RoomViewResponse{}
	connection, err := roomlogic.ConnectionKey(ctx.Session)
	var id int64
	if err == nil {
		id, err = roomlogic.EntityID(req.RoomID)
	}
	if err == nil {
		var result view.RoomSnapshot
		result, err = syncsender.NewRoomViewSender(controller.nestClient).Sync_RoomView(ctx.Context(), id, ctx.PlayerID, connection)
		if err == nil {
			response.Info = roomInfo(req.RoomID, result)
		}
