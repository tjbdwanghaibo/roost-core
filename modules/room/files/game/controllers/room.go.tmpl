func (controller *Controller) HandleRoomLeave(ctx *playeraccess.Context, req *pb.RoomLeaveRequest) (*pb.RoomLeaveResponse, error) {
	if ctx == nil || ctx.PlayerID <= 0 || req == nil {
		return nil, fmt.Errorf("room: authenticated context and request are required")
	}
	response := &pb.RoomLeaveResponse{}
	connection, err := roomlogic.ConnectionKey(ctx.Session)
	var id int64
	if err == nil {
		id, err = roomlogic.EntityID(req.RoomID)
	}
	if err == nil {
		err = syncsender.NewRoomLeaveSender(controller.nestClient).Sync_RoomLeave(ctx.Context(), id, ctx.PlayerID, req.Epoch, connection)
	}
	if err != nil {
		response.Code, response.Reason = errcode.ClientError(err)
		if response.Code == errcode.CodeInternal {
			slog.ErrorContext(ctx.Context(), "room leave failed", "room_id", req.RoomID, "player_id", ctx.PlayerID, "err", err)
		}
