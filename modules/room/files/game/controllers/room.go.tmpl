package controllers

import (
	"fmt"
	"log/slog"

	"github.com/tjbdwanghaibo/roost-core/infra/base/errcode"
	"github.com/tjbdwanghaibo/roost-core/infra/network/playeraccess"
	syncsender "{{MODULE}}/game/handler/syncsender"
	roomlogic "{{MODULE}}/game/modules/room"
	"{{MODULE}}/game/view"
	"{{MODULE}}/protocol/pb"
)

// HandleRoomClose 只把认证会话的玩家号交给 Nest；PB 没有可伪造的操作者字段。
func (controller *Controller) HandleRoomClose(ctx *playeraccess.Context, req *pb.RoomCloseRequest) (*pb.RoomCloseResponse, error) {
	if ctx == nil || ctx.PlayerID <= 0 || req == nil {
		return nil, fmt.Errorf("room: authenticated context and request are required")
	}
	response := &pb.RoomCloseResponse{}
	connection, err := roomlogic.ConnectionKey(ctx.Session)
	var id int64
	if err == nil {
		id, err = roomlogic.EntityID(req.RoomID)
	}
	if err == nil {
		err = syncsender.NewRoomCloseSender(controller.nestClient).Sync_RoomClose(ctx.Context(), id, ctx.PlayerID, req.Epoch, connection)
	}
	if err != nil {
		response.Code, response.Reason = errcode.ClientError(err)
		if response.Code == errcode.CodeInternal {
			slog.ErrorContext(ctx.Context(), "room close failed", "room_id", req.RoomID, "player_id", ctx.PlayerID, "err", err)
		}
	}
	if err == nil {
		roomlogic.PresenceFromRegistry(controller.registry).ForgetRoom(req.RoomID)
		slog.InfoContext(ctx.Context(), "room: close completed", "player_id", ctx.PlayerID, "room_id", req.RoomID)
	}
	return response, nil
}

func roomInfo(roomID int64, snapshot view.RoomSnapshot) *pb.RoomInfo {
	out := &pb.RoomInfo{RoomID: roomID, Capacity: snapshot.Capacity, HostID: snapshot.HostID, Epoch: snapshot.Epoch}
	for _, seat := range snapshot.Seats {
		out.Seats = append(out.Seats, pb.RoomSeat{PlayerID: seat.PlayerID, Slot: seat.Slot, Connected: seat.Connected})
	}
	return out
}

// HandleRoomJoin 只把认证会话的玩家号交给 Nest；PB 没有可伪造的操作者字段。
func (controller *Controller) HandleRoomJoin(ctx *playeraccess.Context, req *pb.RoomJoinRequest) (*pb.RoomJoinResponse, error) {
	if ctx == nil || ctx.PlayerID <= 0 || req == nil {
		return nil, fmt.Errorf("room: authenticated context and request are required")
	}
	response := &pb.RoomJoinResponse{}
	connection, err := roomlogic.ConnectionKey(ctx.Session)
	var id int64
	if err == nil {
		id, err = roomlogic.EntityID(req.RoomID)
	}
	if err == nil {
		var result view.RoomSnapshot
		result, err = syncsender.NewRoomJoinSender(controller.nestClient).Sync_RoomJoin(ctx.Context(), id, ctx.PlayerID, connection)
		if err == nil {
			response.Info = roomInfo(req.RoomID, result)
			// 提交成功之后登记这条连接：它关了，房间自己断线（game/modules/room/room_presence.go）。
			roomlogic.PresenceFromRegistry(controller.registry).Track(req.RoomID, ctx.PlayerID, connection, result.Epoch)
		}
	}
	if err != nil {
		response.Code, response.Reason = errcode.ClientError(err)
		if response.Code == errcode.CodeInternal {
			slog.ErrorContext(ctx.Context(), "room join failed", "room_id", req.RoomID, "player_id", ctx.PlayerID, "err", err)
		}
	}
	if err == nil && response.Info != nil {
		slog.InfoContext(ctx.Context(), "room: join completed", "player_id", ctx.PlayerID, "room_id", req.RoomID, "host_id", response.Info.HostID)
	}
	return response, nil
}

