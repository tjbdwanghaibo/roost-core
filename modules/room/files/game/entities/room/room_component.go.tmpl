package room

import (
	"{{MODULE}}/game/components/room"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:Room}}
const CompTypeRoom entity.ComponentType = {{ID:component:Room}}

// RoomComponent 是 game/components/room 的组件在 Room 上的名字（生成接线与 handler 用它）；业务在那个包里。
type RoomComponent = room.Component

type IRoomEntity interface {
	entity.IThreadSafeEntity
	RoomComp() *RoomComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeRoom, room.NewComponent)
}
