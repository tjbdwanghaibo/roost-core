package handler

import (
	roomlogic "{{MODULE}}/game/modules/room"
	"{{MODULE}}/game/view"
)

// handlerRoomClose 在 Room 的 Nest 锁内处理。持久事实提交成功后才向调用者确认。
// 成功时在提交之后撤掉这间房的全部连接登记（见 game/modules/room/room_presence.go）。
//
//roost:nest rollback=undo
func handlerRoomClose(target view.IRoomEntity, playerID int64, epoch uint64, connection string) error {
	if err := target.Room().Close(playerID, epoch, connection); err != nil {
		return err
	}
	roomlogic.ForgetRoomCommitted(target.UniqueID())
	return nil
}
