package handler

import "{{MODULE}}/game/view"

// handlerRoomJoin 在 Room 的 Nest 锁内处理。持久事实提交成功后才向调用者确认。
//
//roost:nest rollback=undo durability=strict
func handlerRoomJoin(target view.IRoomEntity, playerID int64, connection string) (view.RoomSnapshot, error) {
	return target.Room().Join(playerID, connection)
}
