func TestRoomLastLeaveClosesAndCannotReopen(t *testing.T) {
	f := newRoomFixture(t, 2)
	f.join(t, 101)
	f.leave(t, 101, 1)
	f.leave(t, 101, 1)
	if _, err := f.joins.Sync_RoomJoin(context.Background(), f.id, 102, fmt.Sprintf("connection-%d", 102)); !errors.Is(err, apperrors.ErrRoomClosed) {
		t.Fatal(err)
	}
	if err := f.open.Sync_RoomOpen(context.Background(), f.id, 2); !errors.Is(err, apperrors.ErrRoomClosed) {
		t.Fatal(err)
	}
	f.locked(t, func() {
		if f.value.Dao().GetHostID() != 0 || !f.value.Dao().GetClosed() || f.value.Dao().SeatsLen() != 0 {
			t.Error("last leave did not close")
		}
	})
}
func TestRoomReconnectFencesOldDisconnectAndLeave(t *testing.T) {
	f := newRoomFixture(t, 2)
	f.join(t, 101)
	got, err := f.reconnects.Sync_RoomReconnect(context.Background(), f.id, 101, 1, "new-connection")
	if err != nil || got.Epoch != 2 {
		t.Fatalf("%+v %v", got, err)
	}
	changed, err := f.disconnects.Sync_RoomDisconnect(context.Background(), f.id, 101, 1)
	if err != nil || changed {
		t.Fatalf("stale disconnect: %v %v", changed, err)
	}
	if err := f.leaves.Sync_RoomLeave(context.Background(), f.id, 101, 1, "connection-101"); !errors.Is(err, apperrors.ErrRoomStaleEpoch) {
		t.Fatal(err)
	}
	if err := f.leaves.Sync_RoomLeave(context.Background(), f.id, 101, 2, "connection-101"); !errors.Is(err, apperrors.ErrRoomStaleEpoch) {
		t.Fatalf("old connection guessed new epoch: %v", err)
	}
	if _, err := f.joins.Sync_RoomJoin(context.Background(), f.id, 101, "connection-101"); !errors.Is(err, apperrors.ErrRoomStaleEpoch) {
		t.Fatalf("late old join: %v", err)
	}
	if _, err := f.views.Sync_RoomView(context.Background(), f.id, 101, "connection-101"); !errors.Is(err, apperrors.ErrRoomStaleEpoch) {
		t.Fatalf("late old view: %v", err)
	}
	replay, err := f.reconnects.Sync_RoomReconnect(context.Background(), f.id, 101, 1, "new-connection")
	if err != nil || replay.Epoch != 2 {
		t.Fatalf("lost reconnect reply: %+v %v", replay, err)
	}
	if got := f.view(t, 101, "new-connection"); len(got.Seats) != 1 || !got.Seats[0].Connected || got.Epoch != 2 {
		t.Fatal(got)
	}
}
func TestRoomDisconnectKeepsSeatAndHost(t *testing.T) {
	f := newRoomFixture(t, 2)
	f.join(t, 101)
	f.join(t, 102)
	changed, err := f.disconnects.Sync_RoomDisconnect(context.Background(), f.id, 101, 1)
	if err != nil || !changed {
		t.Fatalf("%v %v", changed, err)
	}
	changed, err = f.disconnects.Sync_RoomDisconnect(context.Background(), f.id, 101, 1)
	if err != nil || changed {
		t.Fatalf("repeat: %v %v", changed, err)
	}
	got := f.view(t, 101)
	if got.HostID != 101 || len(got.Seats) != 2 || got.Seats[0].Connected {
		t.Fatal(got)
	}
	replay := f.join(t, 101)
	if replay.Epoch != 1 || replay.Seats[0].Connected {
		t.Fatal("Join silently replaced the disconnected generation")
	}
	got, err = f.reconnects.Sync_RoomReconnect(context.Background(), f.id, 101, 1, "new-connection")
	if err != nil || got.Epoch != 3 || !got.Seats[0].Connected {
		t.Fatalf("%+v %v", got, err)
	}
}
func TestRoomConcurrentReconnectHasOneWinner(t *testing.T) {
	f := newRoomFixture(t, 2)
	f.join(t, 101)
	var wg sync.WaitGroup
	type outcome struct {
		key string
		err error
	}
	results := make(chan outcome, 2)
	for i := range 2 {
		key := fmt.Sprintf("competing-%d", i)
		wg.Go(func() {
			_, err := f.reconnects.Sync_RoomReconnect(context.Background(), f.id, 101, 1, key)
			results <- outcome{key: key, err: err}
		})
	}
	wg.Wait()
	close(results)
	wins, stale := 0, 0
	var winner string
	for result := range results {
		err := result.err
		if err == nil {
			winner = result.key
			wins++
		} else if errors.Is(err, apperrors.ErrRoomStaleEpoch) {
			stale++
		} else {
			t.Fatal(err)
		}
	}
	if wins != 1 || stale != 1 || f.view(t, 101, winner).Epoch != 2 {
		t.Fatalf("wins=%d stale=%d", wins, stale)
	}
}
func TestRoomLeaveAndRejoinNeverReusesGeneration(t *testing.T) {
	f := newRoomFixture(t, 2)
	f.join(t, 101)
	f.join(t, 102)
	f.leave(t, 101, 1)
	got := f.join(t, 101)
	if got.Epoch != 3 || got.HostID != 102 {
		t.Fatal(got)
	}
	if err := f.leaves.Sync_RoomLeave(context.Background(), f.id, 101, 1, "connection-101"); !errors.Is(err, apperrors.ErrRoomStaleEpoch) {
		t.Fatal(err)
	}
	changed, err := f.disconnects.Sync_RoomDisconnect(context.Background(), f.id, 101, 1)
	if err != nil || changed {
		t.Fatalf("%v %v", changed, err)
	}
}
func TestRoomOnlyTheCurrentHostCanClose(t *testing.T) {
	f := newRoomFixture(t, 2)
	f.join(t, 101)
	f.join(t, 102)
	before := f.document(t)
	if err := f.closes.Sync_RoomClose(context.Background(), f.id, 102, 2, "connection-102"); !errors.Is(err, apperrors.ErrRoomNotHost) {
		t.Fatal(err)
	}
	if err := f.closes.Sync_RoomClose(context.Background(), f.id, 101, 9, "connection-101"); !errors.Is(err, apperrors.ErrRoomStaleEpoch) {
		t.Fatal(err)
	}
	f.unchanged(t, before)
	if err := f.closes.Sync_RoomClose(context.Background(), f.id, 101, 1, "connection-101"); err != nil {
		t.Fatal(err)
	}
	if _, err := f.joins.Sync_RoomJoin(context.Background(), f.id, 103, fmt.Sprintf("connection-%d", 103)); !errors.Is(err, apperrors.ErrRoomClosed) {
		t.Fatal(err)
	}
	f.locked(t, func() {
		if f.value.Dao().SeatsLen() != 0 || f.value.Dao().GetHostID() != 0 {
			t.Error("close retained members")
		}
	})
}
func TestRoomViewIsMembersOnlyAndDetached(t *testing.T) {
	// 只读入口仍经正式 Nest 持锁；元数据不声明写事务的回滚和刷盘策略。
	{
		raw, err := os.ReadFile("room_view_nest_gen.go")
		if err != nil {
			t.Fatal(err)
		}
		if !strings.Contains(string(raw), "invokeRoomView, nest.HandlerMeta{})") {
			t.Fatal("RoomView read-only metadata regressed")
		}
	}

	f := newRoomFixture(t, 2)
	f.join(t, 101)
	f.join(t, 102)
	if _, err := f.views.Sync_RoomView(context.Background(), f.id, 103, fmt.Sprintf("connection-%d", 103)); !errors.Is(err, apperrors.ErrRoomNotMember) {
		t.Fatal(err)
	}
	got := f.view(t, 101)
	got.Seats[0].PlayerID = 999
	if again := f.view(t, 102); again.Epoch != 2 || again.Seats[0].PlayerID != 101 {
		t.Fatal(again)
	}
}
func TestRoomRejectedJoinRollsBackSeatHostAndSeed(t *testing.T) {
	f := newRoomFixture(t, 2)
	before := f.document(t)
	f.commit.reject.Store(true)
	if _, err := f.joins.Sync_RoomJoin(context.Background(), f.id, 101, fmt.Sprintf("connection-%d", 101)); err == nil {
		t.Fatal("commit rejection acknowledged")
	}
	f.unchanged(t, before)
	f.commit.reject.Store(false)
	if got := f.join(t, 101); got.HostID != 101 || got.Epoch != 1 {
		t.Fatal(got)
	}
}
