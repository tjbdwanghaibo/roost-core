func TestRoomStoredStateRetainsConnectionFence(t *testing.T) {
	f := newRoomFixture(t, 2)
	f.join(t, 101)
	f.join(t, 102)
	if _, err := f.reconnects.Sync_RoomReconnect(context.Background(), f.id, 101, 1, "new-connection"); err != nil {
		t.Fatal(err)
	}
	raw := f.document(t)
	restored := newRoomFixture(t, 0)
	var decodeErr error
	restored.locked(t, func() { decodeErr = restored.value.Dao().Unmarshal(raw) })
	if decodeErr != nil {
		t.Fatal(decodeErr)
	}
	if got := restored.view(t, 101, "new-connection"); got.Epoch != 3 || got.HostID != 101 || len(got.Seats) != 2 {
		t.Fatal(got)
	}
	changed, err := restored.disconnects.Sync_RoomDisconnect(context.Background(), restored.id, 101, 1)
	if err != nil || changed {
		t.Fatalf("stale close after reload: %v %v", changed, err)
	}
	got, err := restored.reconnects.Sync_RoomReconnect(context.Background(), restored.id, 101, 3, "next-connection")
	if err != nil || got.Epoch != 4 {
		t.Fatalf("%+v %v", got, err)
	}
}

