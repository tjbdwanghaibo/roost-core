	raw, err := bson.Marshal(bson.M{"_id": f.id, "_schema": int32(1), "1": int32(2), "4": int64(math.MaxInt64)})
	if err != nil {
		t.Fatal(err)
	}
	f.locked(t, func() { err = f.value.Dao().Unmarshal(raw) })
	if err != nil {
		t.Fatal(err)
