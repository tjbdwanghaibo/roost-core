type roomGetter map[int64]entity.IThreadSafeEntity

func (g roomGetter) Get(_ context.Context, id int64, _ entity.EntityCategory) (entity.IThreadSafeEntity, error) {
	if value := g[id]; value != nil {
		return value, nil
	}
	return nil, fmt.Errorf("missing room %d", id)
}
func (g roomGetter) GetMany(ctx context.Context, ids []int64, cats []entity.EntityCategory) ([]entity.IThreadSafeEntity, error) {
	out := make([]entity.IThreadSafeEntity, len(ids))
	for i, id := range ids {
		value, err := g.Get(ctx, id, cats[i])
		if err != nil {
			return nil, err
		}
		out[i] = value
	}
	return out, nil
}

// 只验证事务契约，不模拟 Mongo 持久性。reject 在提交阶段拒绝，不能只测 handler 返回错误。
type roomCommitter struct{ reject atomic.Bool }

func (c *roomCommitter) Commit(context.Context, dataengine.CommitRecord) error {
	if c.reject.Load() {
		return errors.New("injected room commit failure")
	}
	return nil
}

type roomFixture struct {
	engine      *nest.NestMgr
	value       *room.Room
	commit      *roomCommitter
	id          int64
	open        *sender.RoomOpenSender
	joins       *sender.RoomJoinSender
	views       *sender.RoomViewSender
	leaves      *sender.RoomLeaveSender
	reconnects  *sender.RoomReconnectSender
	disconnects *sender.RoomDisconnectSender
	closes      *sender.RoomCloseSender
}

func newRoomFixture(t *testing.T, capacity int32, registrations ...func(*nest.NestMgr) error) *roomFixture {
	t.Helper()
	room.RegisterEntity()
	id, err := entity.BuildEntityID(74001, room.EntityKindRoom)
	if err != nil {
		t.Fatal(err)
	}
	built, err := entity.BuildEntity(&entity.EntityCreateParam{IsCreate: true, Id: id, Kind: room.EntityKindRoom})
	if err != nil {
		t.Fatal(err)
	}
	f := &roomFixture{value: built.(*room.Room), id: id, commit: &roomCommitter{}}
	f.engine = nest.NewEngine(nest.NestOptionWithGetter(roomGetter{id: built}), nest.NestOptionWithTransactionCommitter(f.commit),
		nest.NestOptionWithWorkerPools(nest.WorkerPoolConfig{Workers: 2, QueueCap: 64}, nest.WorkerPoolConfig{}, nest.WorkerPoolConfig{}))
	for _, register := range []func(*nest.NestMgr) error{RegisterRoomOpenNestHandlersOn, RegisterRoomJoinNestHandlersOn, RegisterRoomViewNestHandlersOn, RegisterRoomLeaveNestHandlersOn, RegisterRoomReconnectNestHandlersOn, RegisterRoomDisconnectNestHandlersOn, RegisterRoomCloseNestHandlersOn} {
		if err := register(f.engine); err != nil {
			t.Fatal(err)
		}
	}
	for _, register := range registrations {
		if err := register(f.engine); err != nil {
			t.Fatal(err)
		}
	}
	if err := f.engine.Start(); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := f.engine.Shutdown(context.Background()); err != nil {
			t.Error(err)
		}
	})
	f.open = sender.NewRoomOpenSender(f.engine)
	f.joins = sender.NewRoomJoinSender(f.engine)
	f.views = sender.NewRoomViewSender(f.engine)
	f.leaves = sender.NewRoomLeaveSender(f.engine)
	f.reconnects = sender.NewRoomReconnectSender(f.engine)
	f.disconnects = sender.NewRoomDisconnectSender(f.engine)
	f.closes = sender.NewRoomCloseSender(f.engine)
	if capacity != 0 {
		if err := f.open.Sync_RoomOpen(context.Background(), id, capacity); err != nil {
			t.Fatal(err)
		}
	}
	return f
}
func (f *roomFixture) join(t *testing.T, playerID int64) room.RoomSnapshot {
	t.Helper()
	value, err := f.joins.Sync_RoomJoin(context.Background(), f.id, playerID, fmt.Sprintf("connection-%d", playerID))
	if err != nil {
		t.Fatal(err)
	}
	return value
}
func (f *roomFixture) view(t *testing.T, playerID int64, connection ...string) room.RoomSnapshot {
	t.Helper()
	key := fmt.Sprintf("connection-%d", playerID)
	if len(connection) > 0 {
		key = connection[0]
	}
	value, err := f.views.Sync_RoomView(context.Background(), f.id, playerID, key)
	if err != nil {
		t.Fatal(err)
	}
	return value
}
func (f *roomFixture) leave(t *testing.T, playerID int64, epoch uint64) {
	t.Helper()
	if err := f.leaves.Sync_RoomLeave(context.Background(), f.id, playerID, epoch, fmt.Sprintf("connection-%d", playerID)); err != nil {
		t.Fatal(err)
	}
}
func (f *roomFixture) locked(t *testing.T, fn func()) {
	t.Helper()
	if err := f.engine.RunLocal(context.Background(), func() { f.value.GetMutex().Lock(); defer f.value.GetMutex().Unlock(); fn() }); err != nil {
		t.Fatal(err)
	}
}
func (f *roomFixture) document(t *testing.T) []byte {
	t.Helper()
	var raw []byte
	f.locked(t, func() { raw = f.value.Dao().Marshal() })
	return raw
}

// BSON map 顺序不参与断言；比较解码后的字段，包括公开快照不会带出的 seed / closed。
func (f *roomFixture) unchanged(t *testing.T, before []byte) {
	t.Helper()
	decode := func(raw []byte) bson.M {
		decoder := bson.NewDecoder(bson.NewDocumentReader(bytes.NewReader(raw)))
		decoder.DefaultDocumentM()
		var document bson.M
		if err := decoder.Decode(&document); err != nil {
			t.Fatal(err)
		}
		return document
	}
	a, b := decode(before), decode(f.document(t))
	if !reflect.DeepEqual(a, b) {
		t.Fatalf("room changed after rejected operation: before=%v after=%v", a, b)
	}
}

func TestRoomOpenIsBoundedAndIdempotent(t *testing.T) {
	f := newRoomFixture(t, 0)
	before := f.document(t)
	for _, capacity := range []int32{0, 65} {
		if err := f.open.Sync_RoomOpen(context.Background(), f.id, capacity); !errors.Is(err, apperrors.ErrRoomInvalid) {
			t.Fatalf("capacity %d: %v", capacity, err)
		}
	}
	f.unchanged(t, before)
	if _, err := f.joins.Sync_RoomJoin(context.Background(), f.id, 101, fmt.Sprintf("connection-%d", 101)); !errors.Is(err, apperrors.ErrRoomUnopened) {
		t.Fatal(err)
	}
	if err := f.open.Sync_RoomOpen(context.Background(), f.id, 2); err != nil {
		t.Fatal(err)
	}
	f.join(t, 101)
	before = f.document(t)
	if err := f.open.Sync_RoomOpen(context.Background(), f.id, 2); err != nil {
		t.Fatal(err)
	}
	if err := f.open.Sync_RoomOpen(context.Background(), f.id, 3); !errors.Is(err, apperrors.ErrRoomInvalid) {
		t.Fatal(err)
	}
	f.unchanged(t, before)
}
func TestRoomJoinHasStableSeatsHostAndReplay(t *testing.T) {
	f := newRoomFixture(t, 4)
	a := f.join(t, 101)
	b := f.join(t, 102)
	replay := f.join(t, 101)
	if a.Epoch != 1 || b.Epoch != 2 || replay.Epoch != 1 || replay.HostID != 101 || replay.Capacity != 4 {
		t.Fatalf("%+v %+v %+v", a, b, replay)
	}
	if want := []room.SeatSnapshot{{PlayerID: 101, Slot: 1, Connected: true}, {PlayerID: 102, Slot: 2, Connected: true}}; !reflect.DeepEqual(replay.Seats, want) {
		t.Fatalf("seats=%+v", replay.Seats)
	}
}
