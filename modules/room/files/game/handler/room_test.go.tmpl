	before := f.document(t)
	if _, err := f.joins.Sync_RoomJoin(context.Background(), f.id, 101, "connection-101"); !errors.Is(err, apperrors.ErrRoomInvalid) {
		t.Fatal(err)
	}
	f.unchanged(t, before)
}
