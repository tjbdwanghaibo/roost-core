			t.Fatal(err)
		}
	}
	f.unchanged(t, before)
	if got := f.join(t, 101); got.Epoch != 1 || got.Seats[0].Slot != 1 {
		t.Fatal(got)
	}
}
func TestRoomFullRejectionDoesNotConsumeGeneration(t *testing.T) {
