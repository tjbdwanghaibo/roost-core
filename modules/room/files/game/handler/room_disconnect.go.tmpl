package handler

import room "{{MODULE}}/game/entities/room"

// handlerRoomDisconnect 在 Room 的 Nest 锁内处理。持久事实提交成功后才向调用者确认。
//
//roost:nest rollback=undo durability=strict
func handlerRoomDisconnect(target room.IRoomEntity, playerID int64, epoch uint64) bool {
	return target.RoomComp().Disconnect(playerID, epoch)
}
