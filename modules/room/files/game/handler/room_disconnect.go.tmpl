package handler

import "{{MODULE}}/game/view"

// handlerRoomDisconnect 在 Room 的 Nest 锁内处理。它只改不落库的在线标记（RoomDao.Online，nopersist），
// 没有持久事实要提交；返回 true 表示这次把席位标成了断线。
//
//roost:nest rollback=undo
func handlerRoomDisconnect(target view.IRoomEntity, playerID int64, epoch uint64) bool {
	return target.Room().Disconnect(playerID, epoch)
}
