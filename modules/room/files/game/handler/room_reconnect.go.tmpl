package handler

import "{{MODULE}}/game/view"

// handlerRoomReconnect 在 Room 的 Nest 锁内处理。持久事实提交成功后才向调用者确认。
//
//roost:nest rollback=undo durability=strict
func handlerRoomReconnect(target view.IRoomEntity, playerID int64, epoch uint64, connection string) (view.RoomSnapshot, error) {
	return target.Room().Reconnect(playerID, epoch, connection)
}
