package handler

import (
	"github.com/tjbdwanghaibo/roost-core/infra/base/fctx"

	"{{MODULE}}/game/activity"
	"{{MODULE}}/game/entities/player"
)

// ActivityComplete 接可靠后台工作的完成事实；调用方须验证业务任务确实成功。
//
//roost:nest rollback=undo durability=strict
func handlerActivityComplete(target player.IActivityEntity, token activity.Token) error {
	c := target.ActivityComp()
	if err := c.Host().Complete(token, fctx.NowMilli()); err != nil {
		return err
	}
	return c.Rearm()
}
