// 正式 Nest + 生成 DAO/定时器。提交器可拒绝；BSON 冷恢复不等于真实 Mongo 恢复验收。
type activityGetter struct {
	values map[int64]entity.IThreadSafeEntity
}

func (g *activityGetter) Get(_ context.Context, id int64, _ entity.EntityCategory) (entity.IThreadSafeEntity, error) {
	v := g.values[id]
	if v == nil {
		return nil, fmt.Errorf("missing %d", id)
	}
	return v, nil
}

func (g *activityGetter) GetMany(ctx context.Context, ids []int64, cats []entity.EntityCategory) ([]entity.IThreadSafeEntity, error) {
	out := make([]entity.IThreadSafeEntity, len(ids))
	for i, id := range ids {
		v, e := g.Get(ctx, id, cats[i])
		if e != nil {
			return nil, e
		}
		out[i] = v
	}
	return out, nil
}

type activityCommitter struct{ reject atomic.Bool }

func (c *activityCommitter) Commit(context.Context, dataengine.CommitRecord) error {
	if c.reject.Load() {
		return errors.New("injected activity commit failure")
	}
	return nil
}

type activityFixture struct {
	engine  *nest.NestMgr
	getter  *activityGetter
	commit  *activityCommitter
	now     atomic.Int64
	players []*player.Player
}

var activityTestHandler = nest.NewHandlerName("test_activity_transaction")

func newActivityFixture(t *testing.T) *activityFixture {
	t.Helper()
	registerActivityTestHooks()
	player.RegisterEntity()
	f := &activityFixture{getter: &activityGetter{values: map[int64]entity.IThreadSafeEntity{}}, commit: &activityCommitter{}}
	f.now.Store(1900000000000)
	clock.SetSource(func() time.Time { return time.UnixMilli(f.now.Load()) })
	t.Cleanup(func() { clock.SetSource(nil) })
	for i := range 2 {
		id, err := entity.BuildEntityID(int64(79101+i), player.EntityKindPlayer)
		if err != nil {
			t.Fatal(err)
		}
		value, err := entity.BuildEntity(&entity.EntityCreateParam{IsCreate: true, Id: id, Kind: player.EntityKindPlayer})
		if err != nil {
			t.Fatal(err)
		}
		p := value.(*player.Player)
		f.players = append(f.players, p)
		f.getter.values[id] = p
	}
	f.engine = nest.NewEngine(nest.NestOptionWithGetter(f.getter), nest.NestOptionWithTransactionCommitter(f.commit), nest.NestOptionWithWorkerPools(nest.WorkerPoolConfig{Workers: 2, QueueCap: 64}, nest.WorkerPoolConfig{}, nest.WorkerPoolConfig{}))
	err := f.engine.RegisterHandlerWithMeta(activityTestHandler, func(es []entity.IThreadSafeEntity, params []any, _ ...nest.HandlerOption) (any, error) {
		p := es[0].(*player.Player)
		if err := params[0].(func(*player.Player) error)(p); err != nil {
			return nil, err
		}
		return nil, p.ActivityComp().Rearm()
	}, nest.HandlerMeta{Rollback: nest.RollbackUndo, Durability: nest.DurabilityStrict})
	if err != nil {
		t.Fatal(err)
	}
	if err = f.engine.RegisterHandlerWithMeta(nest.NewHandlerName("handlerTickPlayer{{TIMER_COMPONENT}}"), func(es []entity.IThreadSafeEntity, _ []any, _ ...nest.HandlerOption) (any, error) {
		return handlerTickPlayer{{TIMER_COMPONENT}}(es[0].(player.I{{TIMER_COMPONENT}}Entity))
	}, nest.HandlerMeta{Rollback: nest.RollbackUndo, Durability: nest.DurabilityStrict}); err != nil {
		t.Fatal(err)
	}
	if err = f.engine.Start(); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := f.engine.Shutdown(context.Background()); err != nil {
			t.Error(err)
		}
		for _, p := range f.players {
			p.{{TIMER_COMPONENT}}Comp().OnDestroy(0)
		}
	})
	return f
}

func (f *activityFixture) call(index int, run func(*player.Player) error) error {
	_, err := f.engine.Request(context.Background(), activityTestHandler, f.players[index].ID(), nest.NewParams(run))
	return err
}

func (f *activityFixture) do(t *testing.T, index int, run func(activity.Host) error) {
	t.Helper()
	if err := f.call(index, func(p *player.Player) error { return run(p.ActivityComp().Host()) }); err != nil {
		t.Fatal(err)
	}
}

func (f *activityFixture) view(t *testing.T, index int) activity.Snapshot {
	t.Helper()
	var out activity.Snapshot
	f.do(t, index, func(h activity.Host) error {
		v, e := h.Views()
		if e != nil {
			return e
		}
		if len(v) != 1 {
			return fmt.Errorf("views=%v", v)
		}
		out = v[0]
		return nil
	})
	return out
}

func (f *activityFixture) tick(index int) error {
	_, err := syncsender.NewTickPlayer{{TIMER_COMPONENT}}GenSender(f.engine).Sync_TickPlayer{{TIMER_COMPONENT}}(context.Background(), f.players[index].ID())
	return err
}

func activityRule() activity.Definition {
	return activity.Definition{ID: 1, Version: 1, Scope: "player", Trigger: "fixed", StartMilli: 1900000000000, WarmupMillis: 1000, OpenMillis: 2000, Repeat: "none", Catchup: "queue"}
}

func (f *activityFixture) activate(t *testing.T, index int, d activity.Definition) {
	t.Helper()
	f.do(t, index, func(h activity.Host) error {
		if _, err := h.Activate(d, d.Event, f.now.Load(), f.now.Load()); err != nil {
			return err
		}
		return h.Advance(f.now.Load())
	})
}

var activityHooksOnce sync.Once

func registerActivityTestHooks() {
	activityHooksOnce.Do(func() {
		activity.Register("test_pending", activity.Hooks{Enter: func(c activity.Context) (bool, error) {
			return c.Snapshot.Token.Phase == activity.Initializing || c.Snapshot.Token.Phase == activity.Settling, nil
		}})
		activity.Register("test_unlock", activity.Hooks{Eligible: func(owner entity.IThreadSafeEntity, event string) bool { return event == "level.20" }})
		activity.Register("test_error", activity.Hooks{Enter: func(c activity.Context) (bool, error) {
			if c.Snapshot.Token.Phase == activity.Settling {
				// 钩子在出错前也改了 DAO，错误必须回滚这部分与阶段/定时器一起。
				c.Owner.(*player.Player).Dao().GetActivity().SetCursor(99)
				return false, errors.New("settlement failed")
			}
			return false, nil
		}})
		activity.Register("test_flow", activity.Hooks{Flow: func(c activity.Context) (activity.Flow, error) { return activity.Flow{Name: "match"}, nil }})
	})
}

func TestActivityFivePhasesAndDeadline(t *testing.T) {
	f := newActivityFixture(t)
	f.activate(t, 0, activityRule())
	if v := f.view(t, 0); v.Token.Phase != activity.Warmup {
		t.Fatalf("warmup=%+v", v)
	}
	f.now.Add(1000)
	if err := f.tick(0); err != nil {
		t.Fatal(err)
	}
	open := f.view(t, 0)
	if open.Token.Phase != activity.Open {
		t.Fatalf("open=%+v", open)
	}
	f.now.Add(2000)
	if err := f.call(0, func(p *player.Player) error { return p.ActivityComp().Host().CheckOpen(open.Token, f.now.Load()) }); !errors.Is(err, activity.ErrClosed) {
		t.Fatalf("deadline admission=%v", err)
	}
	if err := f.tick(0); err != nil {
		t.Fatal(err)
	}
	if v := f.view(t, 0); v.Token.Phase != activity.Ended || v.CompletedThrough != 1 {
		t.Fatalf("ended=%+v", v)
	}
}

func TestActivityAsyncInitializationAndSettlement(t *testing.T) {
	f := newActivityFixture(t)
	d := activityRule()
	d.Logic = "test_pending"
	f.activate(t, 0, d)
	initial := f.view(t, 0)
	if initial.Token.Phase != activity.Initializing || !initial.Pending {
		t.Fatalf("initial=%+v", initial)
	}
	f.now.Add(9000)
	f.do(t, 0, func(h activity.Host) error { return h.Advance(f.now.Load()) })
	if v := f.view(t, 0); v.Token != initial.Token || !v.Pending {
		t.Fatalf("deadline forged completion=%+v", v)
	}
	f.do(t, 0, func(h activity.Host) error { return h.Complete(initial.Token, f.now.Load()) })
	settling := f.view(t, 0)
	if settling.Token.Phase != activity.Settling || !settling.Pending {
		t.Fatalf("settling=%+v", settling)
	}
	f.do(t, 0, func(h activity.Host) error { return h.Complete(settling.Token, f.now.Load()) })
	if err := f.call(0, func(p *player.Player) error { return p.ActivityComp().Host().Complete(settling.Token, f.now.Load()) }); !errors.Is(err, activity.ErrStale) {
		t.Fatalf("late completion=%v", err)
	}
}

func TestActivityZeroWarmupAndEmptySettlement(t *testing.T) {
	f := newActivityFixture(t)
