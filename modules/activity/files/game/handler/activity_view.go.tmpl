package handler

import (
	"{{MODULE}}/game/components/activity"
	"{{MODULE}}/game/view"
	"{{MODULE}}/protocol/pb"
)

// ActivityView 是客户端查看自己活动的协议背后的事务：先按当前时间对账，再返回快照。
// 活动组件也挂在 ActivityWorld、Alliance 上（同一个组件），参数写 view.IActivityEntity，target=Player 指明锁的是 Player
// （归属服务、生成的 Sender 与 endpoint 都按它寻址）。
//
//roost:nest rollback=undo durability=strict target=Player
func handlerActivityView(target view.IActivityEntity, request *pb.ActivityViewRequest) (*pb.ActivityViewResponse, error) {
	c, err := activity.Of(target)
	if err != nil {
		return nil, err
	}
	if err := c.Reconcile("", 0); err != nil {
		return nil, err
	}
	values, err := c.Host().Views()
	if err != nil {
		return nil, err
	}
	result := &pb.ActivityViewResponse{}
	for _, v := range values {
		result.Activities = append(result.Activities, &pb.ActivityState{Definition: v.Token.Definition, Generation: v.Token.Generation, Cycle: v.Token.Cycle, Phase: int32(v.Token.Phase), Flow: v.Flow, FlowVersion: v.Token.FlowVersion, Start: v.Start, OpenAt: v.OpenAt, CloseAt: v.CloseAt, Pending: v.Pending, Version: v.Version})
	}
	return result, nil
}
