package activity

import (
	"{{MODULE}}/game/view"
	"fmt"
	"time"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/framework/nest/entitytimer"
	"github.com/tjbdwanghaibo/roost-core/infra/base/fctx"

	"{{MODULE}}/db"
)

// Owner 是活动组件的宿主。Player、全服和联盟只提供各自的 DAO 与归属，
// 组件不依赖具体 Entity 类型，也不另存一份可变活动状态。
type Owner interface {
	entity.IThreadSafeEntity
	ActivityBook() *db.ActivityBook
	ActivityScope() string
}

// createdOwner 提供已持久化的创建事实；没有它的宿主由可信业务入口显式传入。
type createdOwner interface {
	ActivityCreatedAt() int64
}

// deadlineOwner 是有持久定时器的宿主（Player 使用 entitytimer）：建 / 删唤醒节点的适配，节点挂在宿主的定时器组件上，
// 与当前 DAO 同事务。期限与节点号的记账（ActivityBook 的 NextDue / TimerID）在组件里（Rearm）。Remote 宿主没有此接口，
// 期限只存在持久 NextDue 里，由权威服务扫描。
type deadlineOwner interface {
	ArmActivityDeadline(at time.Time) int64
	CancelActivityDeadline(id int64)
}

// Component 是三种宿主共用的组件实现。实体包中的类型别名仅供模块安装器接线，
// 不复制 Reconcile/Rearm。所有业务方法都在宿主 Entity 的 Nest 事务中调用。
type Component struct {
	entity.ComponentBase
	owner Owner
}

// NewComponent 直接用作各实体的组件工厂；DAO 在 Entity 构造时先于组件装载。
func NewComponent(value any, _ *entity.EntityCreateParam) (entity.ComponentInterfaceBase, error) {
	owner, ok := value.(Owner)
	if !ok {
		return nil, fmt.Errorf("activity: owner %T does not implement activity.Owner", value)
	}
	return &Component{owner: owner}, nil
}

func (c *Component) Name() string { return "activity" }

// Host 供业务直接调用 Activate/Complete/MoveFlow；修改成功后调用 Rearm。
func (c *Component) Host() Host {
	return Host{Owner: c.owner, Scope: c.owner.ActivityScope(), Book: c.owner.ActivityBook()}
}

// PlayerCreatedAt 由别的功能（装了 enter 时是 game/login/activity_enter.go）在 init 里设置：Player 的创建时间锚点。
// 没设置时 Player 的 ActivityCreatedAt 返回 0（按首次活动时间算）。经 view 收宿主，game/activity 不引用实体包。
var PlayerCreatedAt func(view.PlayerEntity) int64

func (c *Component) Reconcile(event string, createdAt int64) error {
	if createdAt == 0 {
		if owner, ok := c.owner.(createdOwner); ok {
			createdAt = owner.ActivityCreatedAt()
		}
	}
	host := c.Host()
	definitions, err := Definitions(host.Scope)
	if err != nil {
		return err
	}
	if err = host.Reconcile(definitions, event, createdAt, fctx.NowMilli()); err != nil {
		return err
	}
	return c.Rearm()
}

func (c *Component) Rearm() error {
	host := c.Host()
	due, err := host.NextDeadline(fctx.NowMilli())
	if err != nil {
		return err
	}
	book := host.Book
	owner, ok := c.owner.(deadlineOwner)
	if !ok {
		book.SetNextDue(due)
		return nil
	}
	if due == book.GetNextDue() && (due == 0 || book.GetTimerID() != 0) {
		return nil
	}
	book.SetNextDue(due)
	if book.GetTimerID() != 0 {
		owner.CancelActivityDeadline(book.GetTimerID())
		book.SetTimerID(0)
	}
	if due == 0 {
		return nil
	}
	id := owner.ArmActivityDeadline(time.UnixMilli(due))
	if id == 0 {
		return fmt.Errorf("activity: failed to arm deadline")
	}
	book.SetTimerID(id)
	return nil
}

// OnDeadline 是宿主定时器上活动唤醒节点的回调（Player 的定时器组件把到期的节点交给它）：不是当前节点（已被重新武装
// 替换）的直接收掉；否则推进到触发时刻并重新武装下一个期限。entitytimer 的回调没有 error 返回值；panic 由正式 Nest
// 回滚整笔事务，包含节点删除和业务修改。不能吞错后返回 0，否则失败的初始化/结算会永久丢失唤醒。本边界有生成工程回滚用例。
func (c *Component) OnDeadline(fire entitytimer.Fire) time.Duration {
	if c.owner.ActivityBook().GetTimerID() != fire.ID {
		return 0
	}
	if err := c.Host().Advance(fire.Now.UnixMilli()); err != nil {
		panic(fmt.Errorf("activity timer: %w", err))
	}
	if err := c.Rearm(); err != nil {
		panic(fmt.Errorf("activity timer: %w", err))
	}
	return 0
}
