package activity

import (
	"encoding/json"
	"fmt"
	"time"

	"github.com/tjbdwanghaibo/roost-core/infra/base/clock"

	generated "{{MODULE}}/configs/generated"
)

// 日历/时区与规则一起冻结，后续进程调整时区不会改变已激活的时间线。
type frozenRule struct {
	Definition
	Zone      string
	DayOffset int64
}

const maxMillis int64 = 32503680000000 // 3000-01-01；限制输入同时防止时间乘加溢出。
func Validate(d Definition) error {
	invalid := func() error { return fmt.Errorf("%w: definition %d", ErrRule, d.ID) }
	if d.ID < 1 || d.ID > MaxDefinitions || d.Version <= 0 || d.Disabled {
		return invalid()
	}
	if d.Scope != "player" && d.Scope != "world" && d.Scope != "alliance" {
		return invalid()
	}
	if d.WarmupMillis < 0 || d.OpenMillis <= 0 || d.OpenMillis > 366*86400000 || d.WarmupMillis > 366*86400000 || d.DelayMillis < 0 || d.DelayMillis > 366*86400000 || d.StartMilli < 0 || d.StartMilli >= maxMillis || d.UntilMilli < 0 || d.UntilMilli >= maxMillis || d.MaxCycles < 0 {
		return invalid()
	}
	switch d.Trigger {
	case "fixed":
		if d.StartMilli <= 0 || d.DelayMillis != 0 {
			return invalid()
		}
	case "created":
	case "event":
		if d.Event == "" || d.Logic == "" {
			return invalid()
		}
	default:
		return invalid()
	}
	if d.Catchup != "queue" && d.Catchup != "skip_empty" || d.Catchup == "skip_empty" && d.Logic != "" {
		return invalid()
	}
	span := d.WarmupMillis + d.OpenMillis
	switch d.Repeat {
	case "none":
		if d.Period != 0 || d.MaxCycles > 1 {
			return invalid()
		}
	case "interval":
		if d.Period < span || d.Period > 366*86400000 {
			return invalid()
		}
	case "daily", "weekly":
		// IANA 日历可能有 DST，具体相邻期还会校验；表层只接受有界日/周间隔。
		if d.Period < 1 || d.Period > 366 {
			return invalid()
		}
	default:
		return invalid()
	}
	return nil
}

func Definitions(scope string) ([]Definition, error) {
	var rows []Definition
	for _, d := range generated.ActivityTable().Rows() {
		if d.Disabled || d.Scope != scope {
			continue
		}
		if err := Validate(d); err != nil {
			return nil, err
		}
		rows = append(rows, d)
	}
	return rows, nil
}

func freeze(d Definition) (frozenRule, string, error) {
	if err := Validate(d); err != nil {
		return frozenRule{}, "", err
	}
	calendar := clock.ProcessCalendar()
	r := frozenRule{d, calendar.Location().String(), calendar.DayStartOffset().Milliseconds()}
	raw, err := json.Marshal(r)
	return r, string(raw), err
}

func decode(raw string) (frozenRule, error) {
	var rule frozenRule
	if err := json.Unmarshal([]byte(raw), &rule); err != nil {
		return rule, fmt.Errorf("%w: frozen configuration: %v", ErrRule, err)
	}
	if err := Validate(rule.Definition); err != nil {
		return rule, err
	}
	if rule.DayOffset < 0 || rule.DayOffset >= 86400000 {
		return rule, ErrRule
	}
	return rule, nil
}

func (r frozenRule) start(anchor, cycle int64) (int64, error) {
	if anchor <= 0 || anchor >= maxMillis || cycle < 1 {
		return 0, ErrRule
	}
	var next int64
	switch r.Repeat {
	case "none":
		if cycle != 1 {
			return 0, ErrRule
		}
		next = anchor
	case "interval":
		if cycle-1 > (maxMillis-anchor)/r.Period {
			return 0, ErrRule
		}
		next = anchor + (cycle-1)*r.Period
	case "daily", "weekly":
		days := r.Period
		if r.Repeat == "weekly" {
			days *= 7
		}
		if cycle-1 > 366000/days {
			return 0, ErrRule
		}
		location, err := time.LoadLocation(r.Zone)
		if err != nil {
			return 0, fmt.Errorf("%w: timezone: %v", ErrRule, err)
		}
		// 先取锚点的业务日期，再按日期加日数，最后加日界偏移。不能加 N*24h。
		base := time.UnixMilli(anchor).In(location).Add(-time.Duration(r.DayOffset) * time.Millisecond)
		midnight := time.Date(base.Year(), base.Month(), base.Day()+int((cycle-1)*days), 0, 0, 0, 0, location)
		next = midnight.Add(time.Duration(r.DayOffset) * time.Millisecond).UnixMilli()
		if cycle == 1 && next != anchor {
			return 0, fmt.Errorf("%w: calendar anchor must be the business day boundary", ErrRule)
		}
	}
	if next <= 0 || next >= maxMillis || next > maxMillis-r.WarmupMillis-r.OpenMillis {
		return 0, ErrRule
	}
	return next, nil
}

func (r frozenRule) window(anchor, cycle int64) (start, open, close int64, err error) {
	start, err = r.start(anchor, cycle)
	if err != nil {
		return
	}
	open = start + r.WarmupMillis
	close = open + r.OpenMillis
	if r.Repeat != "none" {
		next, e := r.start(anchor, cycle+1)
		if e != nil {
			return 0, 0, 0, e
		}
		if next < close {
			return 0, 0, 0, fmt.Errorf("%w: overlapping cycles", ErrRule)
		}
	}
	if r.UntilMilli != 0 && close > r.UntilMilli {
		close = r.UntilMilli
		if close <= open {
			return 0, 0, 0, ErrRule
		}
	}
	return
}

func (r frozenRule) next(anchor, cycle int64) (int64, bool, error) {
	if r.Repeat == "none" || r.MaxCycles != 0 && cycle >= r.MaxCycles {
		return 0, false, nil
	}
	next, err := r.start(anchor, cycle+1)
	if err != nil {
		return 0, false, err
	}
	if r.UntilMilli != 0 && next+r.WarmupMillis >= r.UntilMilli {
		return 0, false, nil
	}
	return next, true, nil
}

func (r frozenRule) calendarAnchor(at int64) (int64, error) {
	location, err := time.LoadLocation(r.Zone)
	if err != nil {
		return 0, fmt.Errorf("%w: timezone: %v", ErrRule, err)
	}
	calendar, err := clock.NewCalendar(location, time.Duration(r.DayOffset)*time.Millisecond)
	if err != nil {
		return 0, err
	}
	now := time.UnixMilli(at)
	start := calendar.DayStart(now)
	if start.Equal(now) {
		return at, nil
	}
	return calendar.NextDayStart(now).UnixMilli(), nil
}
