package player

import (
	"time"

	"github.com/tjbdwanghaibo/roost-core/framework/nest/entitytimer"
)

const ActivityDeadline int32 = {{ID:timer:ActivityDeadline}}

func (c *{{TIMER_COMPONENT}}Component) registerActivityTimers(handlers *entitytimer.Handlers) {
	handlers.Register(ActivityDeadline, c.onActivityDeadline)
}

// onActivityDeadline 把到期的活动唤醒节点交给活动组件（game/activity 的 OnDeadline）。
func (c *{{TIMER_COMPONENT}}Component) onActivityDeadline(fire entitytimer.Fire) time.Duration {
	return c.Owner().ActivityComp().OnDeadline(fire)
}

// ArmActivityDeadline / CancelActivityDeadline 是活动组件（game/activity）唤醒节点的适配：节点挂在 Player 的定时器组件上，
// 期限与节点号的记账在组件里。
func (p *Player) ArmActivityDeadline(at time.Time) int64 {
	return p.{{TIMER_COMPONENT}}Comp().New{{TIMER_COMPONENT}}At(at, ActivityDeadline, 0, 0, nil)
}

func (p *Player) CancelActivityDeadline(id int64) {
	p.{{TIMER_COMPONENT}}Comp().Remove{{TIMER_COMPONENT}}(id)
}
