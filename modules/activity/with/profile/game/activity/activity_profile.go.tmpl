package activity

import (
	"{{MODULE}}/game/view"
	gameprofile "{{MODULE}}/game/components/profile"
)

// 业务登记的 Eligible 在已更新等级的同一 Player 事务里读取真值；不是传一个客户端等级。
func init() {
	gameprofile.OnProfileLevelUp("activity", func(host view.PlayerEntity, from, to int32) error {
		return host.Activity().Reconcile("profile.level_up", 0)
	})
}
