package activity

import (
	"context"

	"github.com/tjbdwanghaibo/roost-core/framework/app"
	"github.com/tjbdwanghaibo/roost-core/framework/entity"

	"{{MODULE}}/game/activity"
	gameenter "{{MODULE}}/game/enter"
	"{{MODULE}}/game/entities/player"
	syncsender "{{MODULE}}/game/handler/syncsender"
)

// 进入回调失败只会记日志；下一次进入/操作仍按持久时间线恢复，不假装离线准点结算。
// entered.PlayerID 是会话里的玩家号；Nest 的目标是完整实体号，先换算再发，否则定位不到 Player。
func init() {
	gameenter.OnEntered("activity", func(ctx context.Context, registry *app.Registry, entered gameenter.Entered) error {
		c, err := FromRegistry(registry)
		if err != nil {
			return err
		}
		target, err := entity.BuildEntityID(entered.PlayerID, player.EntityKindPlayer)
		if err != nil {
			return err
		}
		views, err := syncsender.NewActivityEventSender(c.NestClient()).Sync_ActivityEvent(ctx, target, "", entered.FirstAtUnixMilli)
		if err != nil {
			return err
		}
		return activity.ResumePending(ctx, registry, views, func(ctx context.Context, token activity.Token) error {
			return syncsender.NewActivityCompleteSender(c.NestClient()).Sync_ActivityComplete(ctx, target, token)
		})
	})
}
