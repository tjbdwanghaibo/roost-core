func TestEquipmentFullReturnRollsBackUnequip(t *testing.T) {
	f := newEquipmentFixture(t)
	f.grant(t, 1001, 1)
	f.mustEquip(t, 1001)
	f.grant(t, 1001, 2)
	before := f.snapshot(t)
	if _, err := f.unequip(2); !errors.Is(err, apperrors.ErrBagStackFull) {
		t.Fatalf("full %v", err)
	}
	if !reflect.DeepEqual(before, f.snapshot(t)) {
		t.Fatal("full lost equipment")
	}
}
func TestEquipmentFailedReplacementRestoresNewItem(t *testing.T) {
	f := newEquipmentFixture(t)
	f.grant(t, 1002, 1)
