func TestEquipmentCommitFailureRestoresBagAndSlots(t *testing.T) {
	f := newEquipmentFixture(t)
	f.grant(t, 1003, 1)
	before := f.snapshot(t)
	f.committer.reject.Store(true)
	if _, err := f.equip(1003); err == nil {
		t.Fatal("commit accepted")
	}
	if !reflect.DeepEqual(before, f.snapshot(t)) {
		t.Fatal("equipment commit leaked")
	}
	f.committer.reject.Store(false)
	f.mustEquip(t, 1003)
}
func TestEquipmentHookFailureRestoresBagAndSlots(t *testing.T) {
	f := newEquipmentFixture(t)
	f.grant(t, 1003, 1)
	before := f.snapshot(t)
	equipmentRejectHook.Store(true)
	t.Cleanup(func() { equipmentRejectHook.Store(false) })
	if _, err := f.equip(1003); err == nil {
		t.Fatal("hook accepted")
	}
	if !reflect.DeepEqual(before, f.snapshot(t)) {
		t.Fatal("equipment hook leaked")
	}
}
func TestEquipmentConcurrentDuplicateConsumesOne(t *testing.T) {
	f := newEquipmentFixture(t)
	f.grant(t, 1003, 2)
	var wg sync.WaitGroup
	errs := make(chan error, 8)
	for range 8 {
		wg.Add(1)
		go func() { defer wg.Done(); _, err := f.equip(1003); errs <- err }()
	}
	wg.Wait()
	close(errs)
	for err := range errs {
		if err != nil {
			t.Fatal(err)
		}
	}
	if s := f.snapshot(t); s.Bag[1003] != 1 || len(s.Worn) != 1 {
		t.Fatalf("concurrent %+v", s)
	}
}
func TestEquipmentProtocolReturnsBusinessCodes(t *testing.T) {
	f := newEquipmentFixture(t)
	reg := app.NewRegistry(viper.New())
	if err := reg.Register("nest", nest.Client(f.engine)); err != nil {
		t.Fatal(err)
	}
	c, err := controller.FromRegistry(reg)
	if err != nil {
		t.Fatal(err)
	}
	ctx := &playeraccess.Context{PlayerID: 98104}
	r, err := c.HandleEquipmentEquip(ctx, &pb.EquipmentEquipRequest{ItemID: 1003})
	code, _ := errcode.ClientError(apperrors.ErrBagShort)
	if err != nil || r == nil || r.Code != code {
		t.Fatalf("protocol rejection %+v %v", r, err)
	}
	f.grant(t, 1003, 1)
	r, err = c.HandleEquipmentEquip(ctx, &pb.EquipmentEquipRequest{ItemID: 1003})
	if err != nil || r == nil || r.Code != 0 || r.Slot != 1 {
		t.Fatalf("protocol equip %+v %v", r, err)
	}
	u, err := c.HandleEquipmentUnequip(ctx, &pb.EquipmentUnequipRequest{Slot: 1})
	if err != nil || u == nil || u.Code != 0 || !u.Found || u.ItemID != 1003 {
		t.Fatalf("protocol unequip %+v %v", u, err)
	}
}
func TestEquipmentInvalidRuleFailsBeforeBagWrite(t *testing.T) {
	f := newEquipmentFixture(t)
	f.grant(t, 1003, 1)
	before := f.snapshot(t)
	equipmentLoad(t, []schema.EquipmentItem{{ItemID: 1003, Slot: 33, HP: 5}})
	if _, err := f.equip(1003); !errors.Is(err, apperrors.ErrEquipmentItemInvalid) {
		t.Fatalf("rule %v", err)
	}
	if !reflect.DeepEqual(before, f.snapshot(t)) {
		t.Fatal("rule wrote")
	}
}
func TestEquipmentNilPieceIsAnEmptySlot(t *testing.T) {
	f := newEquipmentFixture(t)
	f.write(t, func() { f.player.Dao().GetEquipment().SetSlots(map[int32]*db.GearPiece{1: nil}) })
	if r := f.mustUnequip(t, 1); r.Found {
		t.Fatal("nil piece found")
	}
	f.grant(t, 1003, 1)
	f.mustEquip(t, 1003)
	if s := f.snapshot(t); s.Worn[1][0] != 1003 {
		t.Fatal("nil slot unusable")
	}
}
