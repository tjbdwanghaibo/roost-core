}
func TestEquipmentInvalidItemAndSlotReject(t *testing.T) {
	f := newEquipmentFixture(t)
	if _, err := f.equip(999); !errors.Is(err, apperrors.ErrEquipmentItemInvalid) {
		t.Fatalf("item %v", err)
	}
	for _, slot := range []int32{-1, 0, 33} {
		if _, err := f.unequip(slot); !errors.Is(err, apperrors.ErrEquipmentSlotInvalid) {
			t.Fatalf("slot %v", err)
		}
	}
}
func TestEquipmentInvalidLevelRejects(t *testing.T) {
	f := newEquipmentFixture(t)
	f.grant(t, 1003, 1)
	before := f.snapshot(t)
	for _, level := range []int32{0, -1, 10001} {
		err := f.action(func() error { _, _, err := f.player.EquipmentComp().Equip(1003, level); return err })
		if !errors.Is(err, apperrors.ErrEquipmentLevelInvalid) {
			t.Fatalf("level %v", err)
		}
	}
	if !reflect.DeepEqual(before, f.snapshot(t)) {
		t.Fatal("level wrote")
	}
