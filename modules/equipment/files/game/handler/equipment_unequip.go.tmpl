package handler

import (
	"{{MODULE}}/game/view"
	apperrors "{{MODULE}}/internal/errors"
	"{{MODULE}}/protocol/pb"
)

// 所有错误交还 Nest，背包、穿戴及属性联动整笔回滚。
//
//roost:nest rollback=undo
func handlerEquipmentUnequip(target view.IEquipmentEntity, request *pb.EquipmentUnequipRequest) (*pb.EquipmentUnequipResponse, error) {
	if request == nil {
		return nil, apperrors.ErrEquipmentSlotInvalid
	}
	item, found, err := target.Equipment().Unequip(request.Slot)
	if err != nil {
		return nil, err
	}
	return &pb.EquipmentUnequipResponse{ItemID: item, Found: found}, nil
}
