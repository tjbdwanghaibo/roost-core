package player

import (
	"{{MODULE}}/game/components/equipment"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:Equipment}}
const CompTypeEquipment entity.ComponentType = {{ID:component:Equipment}}

// EquipmentComponent 是 game/components/equipment 的组件在 Player 上的名字（生成接线与 handler 用它）；业务在那个包里。
type EquipmentComponent = equipment.Component

type IEquipmentEntity interface {
	entity.IThreadSafeEntity
	EquipmentComp() *EquipmentComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeEquipment, equipment.NewComponent)
}
