package equipment

import (
	"log/slog"

	"github.com/tjbdwanghaibo/roost-core/infra/network/playeraccess"
	"{{MODULE}}/protocol/pb"
)

// 玩家身份仅来自已认证会话；控制器通过正式 Nest Sender 取得 Player 执行权。
//
//roost:endpoint nest=EquipmentUnequip
func (c *Controller) HandleEquipmentUnequip(ctx *playeraccess.Context, req *pb.EquipmentUnequipRequest) (*pb.EquipmentUnequipResponse, error) {
	response, err := c.dispatchEquipmentUnequip(ctx, req)
	// 只记录已确认的请求结果；带业务键的重放也会返回成功，不把日志当作资产流水。
	if err == nil && response != nil && response.Code == 0 && ctx != nil && req != nil {
		slog.InfoContext(ctx.Context(), "equipment: unequip completed", "player_id", ctx.PlayerID, "slot", req.Slot, "item_id", response.ItemID, "found", response.Found)
	}
	return response, err
}
