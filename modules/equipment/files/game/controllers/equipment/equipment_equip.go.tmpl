package equipment

import (
	"log/slog"

	"github.com/tjbdwanghaibo/roost-core/infra/network/playeraccess"
	"{{MODULE}}/protocol/pb"
)

// 玩家身份仅来自已认证会话；控制器通过正式 Nest Sender 取得 Player 执行权。
//
//roost:endpoint nest=EquipmentEquip
func (c *Controller) HandleEquipmentEquip(ctx *playeraccess.Context, req *pb.EquipmentEquipRequest) (*pb.EquipmentEquipResponse, error) {
	response, err := c.dispatchEquipmentEquip(ctx, req)
	// 只记录已确认的请求结果；带业务键的重放也会返回成功，不把日志当作资产流水。
	if err == nil && response != nil && response.Code == 0 && ctx != nil && req != nil {
		slog.InfoContext(ctx.Context(), "equipment: equip completed", "player_id", ctx.PlayerID, "item_id", req.ItemID, "slot", response.Slot, "replaced", response.Replaced)
	}
	return response, err
}
