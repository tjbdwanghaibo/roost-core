package terrain

import (
	"{{MODULE}}/game/view"
	db "{{MODULE}}/db"
	"encoding/json"
	"fmt"
	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"math"
	logic "{{MODULE}}/game/terrain"
)

// Owner 是 Terrain 组件的宿主（Player 的接线见 game/entities/player/terrain_component.go）：只列组件用得到的
// DAO 与别的组件（view 的小接口）。只在实体被 Nest 锁住期间使用。
type Owner interface {
	entity.IThreadSafeEntity
	Dao() *db.PlayerDao
	view.ActorHolder
}

type Component struct {
	entity.ComponentBase
	owner Owner
}

// NewComponent 是组件工厂；Player 在 game/entities/player/terrain_component.go 登记它。
func NewComponent(value any, _ *entity.EntityCreateParam) (entity.ComponentInterfaceBase, error) {
	owner, ok := value.(Owner)
	if !ok {
		return nil, fmt.Errorf("terrain component: owner %T does not implement terrain.Owner", value)
	}
	return &Component{owner: owner}, nil
}

func (*Component) Name() string { return "terrain" }

// Check在Player锁内判重与授权。场景/距离不因重发跳过，异payload永远不能冒领旧应答。
func (c *Component) Check(command view.TerrainCommand, sceneID int64) (view.TerrainResult, bool, error) {
	body := c.owner.Actor().Body()
	if body.Map.SceneID() != sceneID || !logic.WithinReach(body.Position(), logic.CommandPoint(command)) {
		return logic.Result{}, false, logic.ErrDenied
	}
	state := c.owner.Dao().GetTerrainLedger()
	seq := state.GetSequence()
	if command.Sequence == seq {
		if state.GetDigest() != logic.CommandDigest(command) {
			return logic.Result{}, false, logic.ErrSequence
		}
		var result logic.Result
		if err := json.Unmarshal(state.GetReplyAll(), &result); err != nil {
			return result, false, err
		}
		result.Duplicate = true
		return result, true, nil
	}
	if seq == math.MaxInt64 || command.Sequence != seq+1 {
		return logic.Result{}, false, logic.ErrSequence
	}
	return logic.Result{}, false, nil
}
func (c *Component) BuildingCount() int32 {
	return c.owner.Dao().GetTerrainLedger().GetBuildings()
}
func (c *Component) Record(command view.TerrainCommand, result view.TerrainResult, delta int32) error {
	state := c.owner.Dao().GetTerrainLedger()
	next := state.GetBuildings() + delta
	if next < 0 || next > logic.MaxBuildings {
		return logic.ErrFull
	}
	raw, err := json.Marshal(result)
	if err != nil {
		return err
	}
	state.SetSequence(command.Sequence)
	state.SetDigest(logic.CommandDigest(command))
	state.SetReply(raw)
	if delta != 0 {
		state.SetBuildings(next)
	}
	return nil
}

func (c *Component) Sequence() int64 { return c.owner.Dao().GetTerrainLedger().GetSequence() }
