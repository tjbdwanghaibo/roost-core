package player

import (
	"{{MODULE}}/game/components/terrain"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:Terrain}}
const CompTypeTerrain entity.ComponentType = {{ID:component:Terrain}}

// TerrainComponent 是 game/components/terrain 的组件在 Player 上的名字（生成接线与 handler 用它）；业务在那个包里。
type TerrainComponent = terrain.Component

type ITerrainEntity interface {
	IActorEntity
	TerrainComp() *TerrainComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeTerrain, terrain.NewComponent)
}
