	sceneentity "{{MODULE}}/game/entities/scene"
	building "{{MODULE}}/game/entities/terrain_building"
	chunk "{{MODULE}}/game/entities/terrain_chunk"
	sender "{{MODULE}}/game/handler/syncsender"
	"{{MODULE}}/game/lifecycle"
