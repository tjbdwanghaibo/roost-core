package terrain

import (
	"context"
	"fmt"
	"github.com/tjbdwanghaibo/roost-core/framework/app"
	core "github.com/tjbdwanghaibo/roost-core/gameplay/terrain"
	"github.com/tjbdwanghaibo/roost-core/infra/base/errcode"
	"log/slog"
	"{{MODULE}}/game/playeraccess"
	logic "{{MODULE}}/game/terrain"
	runtime "{{MODULE}}/game/terrain/service"
	"{{MODULE}}/protocol/pb"
)

type Controller struct {
	registry *app.Registry
	runtime  *runtime.Runtime
}

func FromRegistry(registry *app.Registry) (*Controller, error) {
	r, err := runtime.FromRegistry(registry)
	if err != nil {
		return nil, err
	}
	return &Controller{registry: registry, runtime: r}, nil
}
func (c *Controller) Registry() *app.Registry { return c.registry }
func (c *Controller) Execute(ctx context.Context, playerID int64, command logic.Command) (logic.Result, error) {
	result, err := c.runtime.Execute(ctx, playerID, command)
	if err == nil {
		if world, lookupErr := c.runtime.World(command.SceneID); lookupErr == nil {
			result.ProjectionPending = world.Failures() != 0
		}
	}
	if err == nil && (command.Op == "build" || command.Op == "remove") {
		slog.InfoContext(ctx, "terrain: building edit confirmed", "player_id", playerID, "scene_id", command.SceneID, "op", command.Op, "sequence", command.Sequence, "building_id", result.BuildingID, "duplicate", result.Duplicate, "standing", result.Standing)
	}
	return result, err
}
func editResult(result logic.Result) *pb.TerrainEditResult {
	return &pb.TerrainEditResult{ProjectionPending: result.ProjectionPending, Sequence: result.Sequence, Duplicate: result.Duplicate, Changed: result.Changed, BuildingID: result.BuildingID, Standing: result.Standing}
}
func (c *Controller) HandleTerrainBrush(ctx *playeraccess.Context, request *pb.TerrainBrushRequest) (*pb.TerrainBrushResponse, error) {
	if ctx == nil || ctx.PlayerID <= 0 || request == nil {
		return nil, fmt.Errorf("terrain: authenticated request required")
	}
	// 入参预检挡住转成 uint16 / byte 会被截断的取值；与规则里的不合规是同一个业务码。
	if request.Op != "raise" && request.Op != "lower" && request.Op != "paint" || request.Strength < 0 || request.Strength > 20 || request.Material < 0 || request.Material > 4 {
		code, reason := refusal(ctx, request.SceneID, logic.ErrInvalid)
		return &pb.TerrainBrushResponse{Code: code, Reason: reason}, nil
	}
	result, err := c.Execute(ctx.Context(), ctx.PlayerID, logic.Command{SceneID: request.SceneID, Sequence: request.Sequence, Op: request.Op, X: request.X, Y: request.Y, Radius: request.Radius, Strength: uint16(request.Strength), Material: byte(request.Material)})
	if err != nil {
		code, reason := refusal(ctx, request.SceneID, err)
		return &pb.TerrainBrushResponse{Code: code, Reason: reason}, nil
	}
	return &pb.TerrainBrushResponse{Result: editResult(result)}, nil
}
func (c *Controller) HandleTerrainBuild(ctx *playeraccess.Context, request *pb.TerrainBuildRequest) (*pb.TerrainBuildResponse, error) {
	if ctx == nil || ctx.PlayerID <= 0 || request == nil {
		return nil, fmt.Errorf("terrain: authenticated request required")
	}
	result, err := c.Execute(ctx.Context(), ctx.PlayerID, logic.Command{SceneID: request.SceneID, Sequence: request.Sequence, Op: "build", X: request.X, Y: request.Y})
	if err != nil {
		code, reason := refusal(ctx, request.SceneID, err)
		return &pb.TerrainBuildResponse{Code: code, Reason: reason}, nil
	}
	return &pb.TerrainBuildResponse{Result: editResult(result)}, nil
}
