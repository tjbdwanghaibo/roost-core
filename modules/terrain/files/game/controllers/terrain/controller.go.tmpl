	if ctx == nil || ctx.PlayerID <= 0 || request == nil {
		return nil, fmt.Errorf("terrain: authenticated request required")
	}
	result, err := c.Execute(ctx.Context(), ctx.PlayerID, logic.Command{SceneID: request.SceneID, Sequence: request.Sequence, Op: "remove", X: request.X, Y: request.Y})
	if err != nil {
		code, reason := refusal(ctx, request.SceneID, err)
		return &pb.TerrainRemoveResponse{Code: code, Reason: reason}, nil
	}
	return &pb.TerrainRemoveResponse{Result: editResult(result)}, nil
