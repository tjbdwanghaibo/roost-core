func (c *Controller) HandleTerrainQuery(ctx *playeraccess.Context, request *pb.TerrainQueryRequest) (*pb.TerrainQueryResponse, error) {
	if ctx == nil || ctx.PlayerID <= 0 || request == nil {
		return nil, fmt.Errorf("terrain: authenticated request required")
	}
	state, err := c.runtime.Query(ctx.Context(), ctx.PlayerID, request.SceneID, core.ChunkKey{X: request.X, Y: request.Y})
	if err != nil {
		code, reason := errcode.ClientError(err)
		return &pb.TerrainQueryResponse{Code: code, Reason: reason}, nil
	}
	heights := make([]uint32, len(state.Heights))
	for i, value := range state.Heights {
		heights[i] = uint32(value)
	}
	return &pb.TerrainQueryResponse{LastSequence: state.LastSequence, Chunk: &pb.TerrainChunkInfo{SceneID: request.SceneID, X: state.Key.X, Y: state.Key.Y, BaseRevision: state.BaseRevision, Version: state.Version, Heights: heights, Materials: state.Materials}}, nil
}
