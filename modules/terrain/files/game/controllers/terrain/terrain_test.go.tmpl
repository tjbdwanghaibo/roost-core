func TestTerrainMutationsDetectReplayAndSceneGuardRegression(t *testing.T) {
	dir, err := os.Getwd()
	if err != nil {
		t.Fatal(err)
	}
	path, err := filepath.Abs(filepath.Join(dir, "../../components/terrain/terrain.go"))
	if err != nil {
		t.Fatal(err)
	}
	source, err := os.ReadFile(path)
	if err != nil {
		t.Fatal(err)
	}
	cases := []struct{ before, after, test, marker string }{
		{"if command.Sequence == seq {", "if command.Sequence == seq && false {", "TestTerrainDuplicateEditIsReadOnly", "duplicate edit did not recover"},
		{"body.Map.SceneID() != sceneID", "false", "TestTerrainCrossSceneAuthorityIsCheckedInsideTransaction", "cross-scene edit accepted"},
	}
	for _, c := range cases {
		if strings.Count(string(source), c.before) != 1 {
			t.Fatal("mutation anchor changed")
		}
		scratch := t.TempDir()
		replacement := filepath.Join(scratch, "mutant.go")
		if err := os.WriteFile(replacement, []byte(strings.Replace(string(source), c.before, c.after, 1)), 0644); err != nil {
			t.Fatal(err)
		}
		raw, _ := json.Marshal(map[string]map[string]string{"Replace": {path: replacement}})
		overlay := filepath.Join(scratch, "overlay.json")
		if err := os.WriteFile(overlay, raw, 0644); err != nil {
			t.Fatal(err)
		}
		ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
		compile := exec.CommandContext(ctx, "go", "test", "-mod=mod", "-overlay", overlay, "-run", "^$", ".")
		compile.Env = append(os.Environ(), "GOWORK=off")
		if out, err := compile.CombinedOutput(); err != nil {
			cancel()
			t.Fatalf("mutant did not compile: %v\n%s", err, out)
		}
		command := exec.CommandContext(ctx, "go", "test", "-mod=mod", "-count=1", "-overlay", overlay, "-run", "^"+c.test+"$", ".")
		command.Env = append(os.Environ(), "GOWORK=off")
		out, err := command.CombinedOutput()
		cancel()
		if err == nil || !strings.Contains(string(out), c.marker) {
			t.Fatalf("mutant survived: %v\n%s", err, out)
		}
	}
}

