func (f *terrainFixture) player(fn func(*player.Player)) {
	f.t.Helper()
	id, _ := entity.BuildEntityID(terrainPlayer, player.EntityKindPlayer)
	if err := f.engine.RunLocal(context.Background(), func() {
		value := f.access.Manager().Get(id).(*player.Player)
		value.GetMutex().Lock()
		defer value.GetMutex().Unlock()
		fn(value)
	}); err != nil {
		f.t.Fatal(err)
	}
}
func (f *terrainFixture) ledger(seq int64, count int32) {
	f.t.Helper()
	f.player(func(p *player.Player) {
		s := p.Dao().GetTerrainLedger()
		if s.GetSequence() != seq || s.GetBuildings() != count || s.ReplyLen() > 256 {
			f.t.Errorf("ledger seq=%d buildings=%d reply=%d", s.GetSequence(), s.GetBuildings(), s.ReplyLen())
		}
	})
}
func (f *terrainFixture) open(id int64) {
	f.t.Helper()
	path, err := runtime.DefaultPack()
	if err != nil {
		f.t.Fatal(err)
	}
	f.t.Cleanup(func() { os.Remove(path) })
	if _, err := f.runtime.Open(context.Background(), id, path); err != nil {
		f.t.Fatal(err)
	}
}

type terrainDoc struct {
	raw     []byte
	schema  uint32
	version uint64
}
type terrainAggregate struct {
	id        int64
	kind      entity.EntityKind
	documents map[string]terrainDoc
}

// persistedSnapshot只准备整文档，不AcceptMutation；生成DAO和手写附加DAO走相同正式接口。
func (f *terrainFixture) persistedSnapshot(dao entity.DaoInterface, owner int64) dataengine.Mutation {
	f.t.Helper()
	participant, ok := dao.(nest.MutationParticipant)
	if !ok {
		f.t.Errorf("DAO %T has no persistence participant", dao)
		return dataengine.Mutation{}
	}
	mutation, err := participant.PrepareMutation(nest.PersistChange{Mask: dataengine.AllFields})
	if err != nil {
		f.t.Error(err)
		return dataengine.Mutation{}
	}
	version := dao.(interface{ DirtyTracker() *dataengine.Tracker }).DirtyTracker().Version()
	if mutation.Kind != dataengine.MutationPut || mutation.Key.ID != owner || mutation.Key.ID != dao.Id() || mutation.Key.Database != dao.DbName() || mutation.Key.Resource != dao.CollName() || mutation.Schema != dao.(dataengine.Descriptor).SchemaVersion() || mutation.ExpectedVersion != version || mutation.NextVersion != version+1 || len(mutation.Data) == 0 {
		f.t.Errorf("invalid full persistence snapshot for %T: key=%+v schema=%d version=%d/%d", dao, mutation.Key, mutation.Schema, mutation.ExpectedVersion, mutation.NextVersion)
	}
	return mutation
}

// 初次Player持久写必须带齐尚无文档的附加DAO；精确比较每个键，不能把合法的完整聚合当成多写。
func (f *terrainFixture) editMutationKeys(site bool) map[dataengine.DocumentKey]bool {
	f.t.Helper()
	want := map[dataengine.DocumentKey]bool{}
	f.player(func(p *player.Player) {
		p.RangeDao(func(dao entity.DaoInterface) {
			m := f.persistedSnapshot(dao, p.ID())
			if dao == p.Dao() || m.ExpectedVersion == 0 {
				want[m.Key] = true
			}
		})
	})
	keys := []core.ChunkKey{{X: 0, Y: 0}, {X: 1, Y: 0}, {X: 0, Y: 1}, {X: 1, Y: 1}}
	actual := f.world(2).Keys()
	if len(actual) != 4 {
		f.t.Fatalf("four-chunk fixture has %d keys", len(actual))
	}
	for _, key := range keys {
		if !slices.Contains(actual, key) {
			f.t.Fatalf("four-chunk fixture missing %v", key)
		}
		unique, _ := logic.ChunkUnique(2, key)
		id, _ := entity.BuildEntityID(unique, chunk.EntityKindTerrainChunk)
		want[dataengine.DocumentKey{Database: db.TerrainChunkDaoDBName, Resource: db.TerrainChunkDaoCollection, ID: id}] = true
	}
	if site {
		unique, _ := logic.SiteUnique(2, 63, 63)
		id, _ := entity.BuildEntityID(unique, building.EntityKindTerrainBuilding)
		want[dataengine.DocumentKey{Database: db.TerrainBuildingDaoDBName, Resource: db.TerrainBuildingDaoCollection, ID: id}] = true
	}
	return want
}
func (f *terrainFixture) assertMutationKeys(record dataengine.CommitRecord, want map[dataengine.DocumentKey]bool) {
	f.t.Helper()
	if record.Durability != dataengine.DurabilityStrict || len(record.Mutations) != len(want) {
		f.t.Fatalf("aggregate durability=%v documents=%d want=%d", record.Durability, len(record.Mutations), len(want))
	}
	for _, mutation := range record.Mutations {
		if !want[mutation.Key] {
			f.t.Fatalf("unexpected or repeated aggregate document %+v", mutation.Key)
		}
		delete(want, mutation.Key)
	}
	if len(want) != 0 {
		f.t.Fatalf("missing aggregate documents %+v", want)
	}
}

func (f *terrainFixture) documents() []terrainAggregate {
	f.t.Helper()
	var out []terrainAggregate
	if err := f.engine.RunLocal(context.Background(), func() {
		f.access.Manager().Range(func(value entity.IThreadSafeEntity) bool {
			if value.GetEntityKind() == sceneentity.EntityKindScene {
				return true
			}
			value.GetMutex().Lock()
			defer value.GetMutex().Unlock()
			a := terrainAggregate{id: value.ID(), kind: value.GetEntityKind(), documents: map[string]terrainDoc{}}
			value.(entity.Guardable).RangeDao(func(dao entity.DaoInterface) {
				mutation := f.persistedSnapshot(dao, a.id)
				a.documents[dao.CollName()] = terrainDoc{mutation.Data, mutation.Schema, mutation.ExpectedVersion}
			})
			out = append(out, a)
			return true
		})
	}); err != nil {
		f.t.Fatal(err)
	}
	return out
}
func (f *terrainFixture) restart() {
	f.t.Helper()
	saved := f.documents()
	f.shutdown()
	f.access = entity.NewManagerAccess(entity.NewEntityManager())
	for _, a := range saved {
		daos := map[string]entity.DaoInterface{}
		for _, builder := range entity.GetEntityBuilderParam(a.kind).DaoBuilders {
			d := builder()
			d.SetId(a.id)
			doc := a.documents[d.CollName()]
			if err := d.(entity.PersistedDaoLoader).RestorePersisted(doc.raw, doc.schema, doc.version); err != nil {
				f.t.Fatal(err)
			}
			daos[d.CollName()] = d
		}
		value, err := entity.BuildEntity(&entity.EntityCreateParam{Id: a.id, Kind: a.kind, Dao: daos})
		if err != nil {
			f.t.Fatal(err)
		}
		f.access.Manager().Add(value)
	}
	f.start()
}

func TestTerrainDefaultPackFeedsSceneAndActorWalker(t *testing.T) {
	f := newTerrainFixture(t)
	world := f.world(2)
	if world.Meta().Chunks() != 4 || world.View.Len() != 4 {
		t.Fatal("default pack not preloaded")
	}
	f.player(func(p *player.Player) {
		env := p.ActorComp().Body().Environment()
		if env.Surface != world.Walker || env.ID != world.SceneID {
			t.Fatal("actor did not enter terrain surface")
		}
	})
	if _, _, err := f.scenes.IDs(0, 1); err != nil {
		t.Fatal("plain scene replaced")
	}
	if world.Blocked(spatial.Point{X: 6000, Y: 6000}) {
		t.Fatal("default spawn blocked")
	}
}
func TestTerrainBrushCommitsFourChunksAndPlayerLedger(t *testing.T) {
	f := newTerrainFixture(t)
	want := f.editMutationKeys(false)
	result := f.must(brush(1))
	record := f.commit.record()
	if result.Changed == 0 {
		t.Fatal("brush changed no points")
	}
	f.assertMutationKeys(record, want)
	for _, key := range f.world(2).Keys() {
		if f.query(key).Version != 2 {
			t.Fatalf("chunk %v not changed", key)
		}
	}
	f.ledger(1, 0)
}
func TestTerrainDuplicateEditIsReadOnly(t *testing.T) {
	f := newTerrainFixture(t)
	a := f.must(brush(1))
	writes := f.commit.writes.Load()
	b, err := f.execute(brush(1))
	if err != nil || !b.Duplicate || b.Changed != a.Changed || f.commit.writes.Load() != writes {
		t.Fatalf("duplicate edit did not recover: %+v %v", b, err)
	}
	f.ledger(1, 0)
}
func TestTerrainSequenceRejectsDifferentPayloadOldAndGap(t *testing.T) {
	f := newTerrainFixture(t)
	f.must(brush(1))
	writes := f.commit.writes.Load()
	bad := brush(1)
	bad.Strength = 3
	if _, err := f.execute(bad); !errors.Is(err, logic.ErrSequence) {
		t.Fatalf("digest=%v", err)
	}
	if _, err := f.execute(brush(3)); !errors.Is(err, logic.ErrSequence) {
		t.Fatalf("gap=%v", err)
	}
	f.must(brush(2))
	if _, err := f.execute(brush(1)); !errors.Is(err, logic.ErrSequence) {
		t.Fatalf("old seq=%v", err)
	}
	if f.commit.writes.Load() != writes+1 {
		t.Fatal("rejected sequence wrote")
	}
}
func TestTerrainCrossSceneAuthorityIsCheckedInsideTransaction(t *testing.T) {
	f := newTerrainFixture(t)
	f.open(3)
	bad := brush(1)
	bad.SceneID = 3
	writes := f.commit.writes.Load()
	if _, err := f.execute(bad); !errors.Is(err, logic.ErrDenied) {
		t.Fatalf("cross-scene edit accepted: %v", err)
	}
	if f.commit.writes.Load() != writes {
		t.Fatal("cross-scene wrote")
	}
}
func TestTerrainRejectsFarAndMalformedBrushes(t *testing.T) {
	f := newTerrainFixture(t)
	writes := f.commit.writes.Load()
	bad := brush(1)
	bad.X = 10000
	if _, err := f.execute(bad); !errors.Is(err, logic.ErrDenied) {
		t.Fatalf("distance=%v", err)
	}
	bad = brush(1)
	bad.Radius = logic.MaxRadius + 1
	if _, err := f.execute(bad); !errors.Is(err, logic.ErrInvalid) {
		t.Fatalf("large brush=%v", err)
	}
	bad = brush(1)
	bad.X = -1
	if _, err := f.execute(bad); !errors.Is(err, logic.ErrInvalid) {
		t.Fatalf("negative coordinate=%v", err)
	}
	// 出生点受保护说的是“这块地”，不是“你没有权限”：与越权分开答。
	bad = brush(1)
	bad.X = 6000
	bad.Y = 6000
	if _, err := f.execute(bad); !errors.Is(err, logic.ErrSite) || errors.Is(err, logic.ErrDenied) {
		t.Fatalf("spawn edit=%v", err)
	}
	bad = build(1)
	bad.X = 6000
	bad.Y = 6000
	if _, err := f.execute(bad); !errors.Is(err, logic.ErrSite) || errors.Is(err, logic.ErrDenied) {
		t.Fatalf("spawn building=%v", err)
	}
	if f.commit.writes.Load() != writes {
		t.Fatal("invalid edited")
	}
}
func TestTerrainMapCoordinatesHaveIndependentPersistentIDs(t *testing.T) {
	f := newTerrainFixture(t)
	f.must(brush(1))
	f.open(3)
	f.move(terrainPlayer, 2, 3)
	state, err := f.runtime.Query(context.Background(), terrainPlayer, 3, core.ChunkKey{X: 1, Y: 1})
	if err != nil || state.Heights[0] != 100 {
		t.Fatalf("maps shared edits: %+v %v", state, err)
	}
	a, _ := logic.ChunkUnique(2, core.ChunkKey{})
	b, _ := logic.ChunkUnique(3, core.ChunkKey{})
	x, _ := logic.SiteUnique(2, 1, 1)
	y, _ := logic.SiteUnique(3, 1, 1)
	if a == b || x == y {
		t.Fatal("scene identity collision")
	}
}
func TestTerrainBuildingLocksFourChunksSiteAndLedger(t *testing.T) {
	f := newTerrainFixture(t)
	want := f.editMutationKeys(true)
	result := f.must(build(1))
	record := f.commit.record()
	if !result.Standing || result.BuildingID == 0 {
		t.Fatalf("building result=%+v", result)
	}
	f.assertMutationKeys(record, want)
	if !f.world(2).Blocked(spatial.Point{X: 6300, Y: 6300}) {
		t.Fatal("committed building does not block Walker")
	}
	f.ledger(1, 1)
}
func TestTerrainBuildingOverlapAndForeignRemovalAreRejected(t *testing.T) {
	f := newTerrainFixture(t)
	f.must(build(1))
	writes := f.commit.writes.Load()
	if _, err := f.controller.Execute(context.Background(), terrainPlayer+1, build(1)); !errors.Is(err, logic.ErrOccupied) {
		t.Fatalf("overlap=%v", err)
	}
	command := build(1)
	command.Op = "remove"
	if _, err := f.controller.Execute(context.Background(), terrainPlayer+1, command); !errors.Is(err, logic.ErrDenied) {
		t.Fatalf("foreign removal=%v", err)
	}
	if f.commit.writes.Load() != writes {
		t.Fatal("rejected building operation wrote")
	}
	f.ledger(1, 1)
}
