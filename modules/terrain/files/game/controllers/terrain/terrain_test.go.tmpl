func TestTerrainRemoveReleasesLotsWithoutRestoringOldHeight(t *testing.T) {
	f := newTerrainFixture(t)
	command := brush(1)
	command.X = 6300
	command.Y = 6300
	f.must(command)
	f.must(build(2))
	before := f.query(core.ChunkKey{})
	command = build(3)
	command.Op = "remove"
	f.must(command)
	after := f.query(core.ChunkKey{})
	if !slices.Equal(before.Heights, after.Heights) || f.world(2).Blocked(spatial.Point{X: 6300, Y: 6300}) || len(after.Lots) != 0 {
		t.Fatal("remove changed ground or kept occupancy")
	}
	f.ledger(3, 0)
}
func TestTerrainBrushCommitFailureRollsBackAllTargetsAndView(t *testing.T) {
	f := newTerrainFixture(t)
	f.commit.reject.Store(true)
	if _, err := f.execute(brush(1)); err == nil {
		t.Fatal("rejected brush succeeded")
	}
	f.commit.reject.Store(false)
	for _, key := range f.world(2).Keys() {
		state := f.query(key)
		_, version, _ := f.world(2).View.Chunk(key)
		if state.Version != 1 || version != 1 {
			t.Fatal("partial rollback or uncommitted overlay")
		}
	}
	f.ledger(0, 0)
	f.must(brush(1))
