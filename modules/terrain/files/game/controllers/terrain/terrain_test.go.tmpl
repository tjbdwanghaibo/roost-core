func TestTerrainColdRestoreKeepsEditsLotsBuildingsAndSequence(t *testing.T) {
	f := newTerrainFixture(t)
	command := brush(1)
	command.X = 5800
	command.Y = 5800
	f.must(command)
	built := f.must(build(2))
	before := f.query(core.ChunkKey{})
	f.restart()
	after := f.query(core.ChunkKey{})
	if !slices.Equal(before.Heights, after.Heights) || !f.world(2).Blocked(spatial.Point{X: 6300, Y: 6300}) {
		t.Fatal("cold state lost")
	}
	writes := f.commit.writes.Load()
	result, err := f.execute(build(2))
	if err != nil || !result.Duplicate || result.BuildingID != built.BuildingID || f.commit.writes.Load() != writes {
		t.Fatalf("cold replay=%+v %v", result, err)
	}
	f.ledger(2, 1)
	unique, _ := logic.ChunkUnique(2, core.ChunkKey{})
	full, _ := entity.BuildEntityID(unique, chunk.EntityKindTerrainChunk)
	wrong := db.NewTerrainChunkDao()
	wrong.SetId(full + 1)
	if _, err := entity.BuildEntity(&entity.EntityCreateParam{Id: full, Kind: chunk.EntityKindTerrainChunk, Dao: map[string]entity.DaoInterface{wrong.CollName(): wrong}}); err == nil {
		t.Fatal("cold aggregate accepted a mismatched DAO identity")
	}
	// 一份形状合法但建筑占地缺半边的冷档：必须在Scene对客户端开放之前拒绝。
	for _, aggregate := range f.documents() {
		if aggregate.id != full {
			continue
		}
		document := aggregate.documents["terrain_chunk"]
		var stored bson.M
		if err := bson.Unmarshal(document.raw, &stored); err != nil {
			t.Fatal(err)
		}
		unique3, _ := logic.ChunkUnique(3, core.ChunkKey{})
		full3, _ := entity.BuildEntityID(unique3, chunk.EntityKindTerrainChunk)
		stored["_id"], stored["1"] = full3, int64(3)
		raw, err := bson.Marshal(stored)
		if err != nil {
			t.Fatal(err)
		}
		broken := db.NewTerrainChunkDao()
		broken.SetId(full3)
		if err := broken.RestorePersisted(raw, document.schema, document.version); err != nil {
			t.Fatal(err)
		}
		value, err := entity.BuildEntity(&entity.EntityCreateParam{Id: full3, Kind: chunk.EntityKindTerrainChunk, Dao: map[string]entity.DaoInterface{broken.CollName(): broken}})
		if err != nil {
			t.Fatal(err)
		}
		f.access.Manager().Add(value)
		path, err := runtime.DefaultPack()
		if err != nil {
			t.Fatal(err)
		}
		defer os.Remove(path)
		if _, err := f.runtime.Open(context.Background(), 3, path); err == nil {
			t.Fatal("incomplete footprint opened")
		}
		if _, _, err := f.scenes.IDs(0, 3); err == nil {
			t.Fatal("failed terrain was exposed as a scene")
		}
	}

}
