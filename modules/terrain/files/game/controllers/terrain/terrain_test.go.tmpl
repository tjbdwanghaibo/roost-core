// terrainErrorLogs 数 Error 及以上的日志条数：正常拒绝客户端已经拿到码，不应该再留下 Error。
type terrainErrorLogs struct{ count atomic.Int64 }

func (h *terrainErrorLogs) Enabled(context.Context, slog.Level) bool { return true }
func (h *terrainErrorLogs) Handle(_ context.Context, record slog.Record) error {
	if record.Level >= slog.LevelError {
		h.count.Add(1)
	}
	return nil
}
func (h *terrainErrorLogs) WithAttrs([]slog.Attr) slog.Handler { return h }
func (h *terrainErrorLogs) WithGroup(string) slog.Handler      { return h }
func captureTerrainErrors(t *testing.T) *terrainErrorLogs {
	t.Helper()
	logs := &terrainErrorLogs{}
	previous := slog.Default()
	slog.SetDefault(slog.New(logs))
	t.Cleanup(func() {
		slog.SetDefault(previous)
		log.SetOutput(os.Stderr)
		log.SetFlags(log.LstdFlags)
	})
	return logs
}

// 每种正常拒绝各有一个业务码，经PB端点答在Code/Reason里：不返回error、不写、不消耗序号、不记Error。
func TestTerrainEndpointsAnswerEachRefusalWithItsOwnCode(t *testing.T) {
	f := newTerrainFixture(t)
	logs := captureTerrainErrors(t)
	owner := &playeraccess.Context{PlayerID: terrainPlayer}
	other := &playeraccess.Context{PlayerID: terrainPlayer + 1}
	start := f.commit.writes.Load()
	codes := map[string]int32{}
	for name, def := range map[string]*errcode.IntError{"invalid": logic.ErrInvalid, "denied": logic.ErrDenied, "sequence": logic.ErrSequence, "occupied": logic.ErrOccupied, "site": logic.ErrSite, "full": logic.ErrFull} {
		code, reason := errcode.ClientError(def)
		if code <= errcode.FrameworkCodeLast || reason == "" {
			t.Fatalf("%s: code %d reason %q is not a business refusal", name, code, reason)
		}
		for prior, used := range codes {
			if used == code {
				t.Fatalf("%s and %s share code %d", name, prior, code)
			}
		}
		codes[name] = code
	}
	refused := func(name, want string, code int32, reason string, result *pb.TerrainEditResult, err error) {
		t.Helper()
		if err != nil || code != codes[want] || reason == "" || result != nil {
			t.Fatalf("%s: code=%d reason=%q result=%+v err=%v, want terrain_%s (%d)", name, code, reason, result, err, want, codes[want])
		}
	}
	brushRequest := func(seq int64) *pb.TerrainBrushRequest {
		return &pb.TerrainBrushRequest{SceneID: 2, Sequence: seq, Op: "raise", X: 6400, Y: 6400, Radius: 150, Strength: 2}
	}
	// 请求不合规：端点预检与规则校验是同一个码。
	bad := brushRequest(1)
	bad.Op = "dig"
	b, err := f.controller.HandleTerrainBrush(owner, bad)
	refused("unknown op", "invalid", b.Code, b.Reason, b.Result, err)
	bad = brushRequest(1)
	bad.Strength = 21
	b, err = f.controller.HandleTerrainBrush(owner, bad)
	refused("strength above the limit", "invalid", b.Code, b.Reason, b.Result, err)
	bad = brushRequest(1)
	bad.Radius = 401
	b, err = f.controller.HandleTerrainBrush(owner, bad)
	refused("radius above the limit", "invalid", b.Code, b.Reason, b.Result, err)
	q, err := f.controller.HandleTerrainQuery(owner, &pb.TerrainQueryRequest{SceneID: 2, X: 9, Y: 9})
	refused("query outside the map", "invalid", q.Code, q.Reason, nil, err)
	if q.Chunk != nil {
		t.Fatal("refused query returned a chunk")
	}
	// 与“玩家是谁、在哪”有关。
	bad = brushRequest(1)
	bad.X = 10000
	b, err = f.controller.HandleTerrainBrush(owner, bad)
	refused("too far", "denied", b.Code, b.Reason, b.Result, err)
	bad = brushRequest(1)
	bad.SceneID = 9
	b, err = f.controller.HandleTerrainBrush(owner, bad)
	refused("not a terrain scene", "denied", b.Code, b.Reason, b.Result, err)
	// 序号错了：按应答去重查 LastSequence，从它的下一个接着发。
	b, err = f.controller.HandleTerrainBrush(owner, brushRequest(3))
	refused("sequence gap", "sequence", b.Code, b.Reason, b.Result, err)
	q, err = f.controller.HandleTerrainQuery(owner, &pb.TerrainQueryRequest{SceneID: 2})
	if err != nil || q.Code != 0 || q.LastSequence != 0 {
		t.Fatalf("query after the sequence refusal: %+v %v", q, err)
	}
	if f.commit.writes.Load() != start {
		t.Fatalf("refused edits wrote %d times", f.commit.writes.Load()-start)
	}
	built, err := f.controller.HandleTerrainBuild(owner, &pb.TerrainBuildRequest{SceneID: 2, Sequence: q.LastSequence + 1, X: 6300, Y: 6300})
	if err != nil || built.Code != 0 || !built.Result.Standing {
		t.Fatalf("build with the queried sequence: %+v %v", built, err)
	}
	writes := f.commit.writes.Load()
	// 这里不能建 / 不能刷：有建筑、出生点受保护。
	o, err := f.controller.HandleTerrainBuild(other, &pb.TerrainBuildRequest{SceneID: 2, Sequence: 1, X: 6300, Y: 6300})
	refused("overlapping building", "occupied", o.Code, o.Reason, o.Result, err)
	b, err = f.controller.HandleTerrainBrush(owner, brushRequest(2))
	refused("brush under a building", "occupied", b.Code, b.Reason, b.Result, err)
	o, err = f.controller.HandleTerrainBuild(owner, &pb.TerrainBuildRequest{SceneID: 2, Sequence: 2, X: 6000, Y: 6000})
	refused("building on the spawn point", "site", o.Code, o.Reason, o.Result, err)
	rm, err := f.controller.HandleTerrainRemove(other, &pb.TerrainRemoveRequest{SceneID: 2, Sequence: 1, X: 6300, Y: 6300})
	refused("removing someone else's building", "denied", rm.Code, rm.Reason, rm.Result, err)
	if f.commit.writes.Load() != writes {
		t.Fatal("a refused request wrote")
	}
	f.ledger(1, 1)
	if logs.count.Load() != 0 {
		t.Fatalf("normal refusals logged %d errors", logs.count.Load())
	}
	// 拒绝没有消耗序号，同一条连接上接着发下一个序号成功。
	rm, err = f.controller.HandleTerrainRemove(owner, &pb.TerrainRemoveRequest{SceneID: 2, Sequence: 2, X: 6300, Y: 6300})
	if err != nil || rm.Code != 0 || rm.Result.Standing {
		t.Fatalf("remove after refusals: %+v %v", rm, err)
	}
}

