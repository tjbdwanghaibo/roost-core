const terrainPlayer int64 = 97101

type terrainCommit struct {
	writes atomic.Int64
	reject atomic.Bool
	mu     sync.Mutex
	last   dataengine.CommitRecord
}

func (c *terrainCommit) Commit(_ context.Context, record dataengine.CommitRecord) error {
	if c.reject.Load() {
		return errors.New("terrain injected commit failure")
	}
	c.mu.Lock()
	c.last = record
	c.mu.Unlock()
	c.writes.Add(1)
	return nil
}
func (c *terrainCommit) record() dataengine.CommitRecord {
	c.mu.Lock()
	defer c.mu.Unlock()
	return c.last
}

type terrainFixture struct {
	t          *testing.T
	controller *Controller
	runtime    *runtime.Runtime
	access     *entity.ManagerAccess
	engine     *nest.NestMgr
	sync       *entitysync.Manager
	scenes     *scenes.Manager
	change     *scenecontroller.Controller
	commit     *terrainCommit
	registry   *app.Registry
	stop       func(context.Context) error
	registers  []func(*nest.NestMgr) error
}

// 提交器和同步传输是内存替身；其余为正式Pack/实体/DAO/Nest/场景/Walker/controller链。
func newTerrainFixture(t *testing.T) *terrainFixture {
	t.Helper()
	return newTerrainFixtureWith(t, nil)
}
func newTerrainFixtureWith(t *testing.T, registers []func(*nest.NestMgr) error) *terrainFixture {
	t.Helper()
	player.RegisterEntity()
	sceneentity.RegisterEntity()
	chunk.RegisterEntity()
	building.RegisterEntity()
	f := &terrainFixture{t: t, access: entity.NewManagerAccess(entity.NewEntityManager()), commit: &terrainCommit{}, registers: registers}
	for _, id := range []int64{terrainPlayer, terrainPlayer + 1} {
		if _, err := f.access.Create(&entity.EntityCreateParam{IsCreate: true, UniqueID: id, Kind: player.EntityKindPlayer}); err != nil {
			t.Fatal(err)
		}
	}
	f.start()
	t.Cleanup(f.shutdown)
	return f
}
func (f *terrainFixture) start() {
	t := f.t
	t.Helper()
	var err error
	f.sync, err = entitysync.NewManager(entitysync.ManagerConfig{Transport: entitysync.TransportFunc(func(context.Context, entitysync.SessionID, []byte) error { return nil })})
	if err != nil {
		t.Fatal(err)
	}
	f.engine = nest.NewEngine(nest.NestOptionWithGetter(f.access), nest.NestOptionWithTransactionCommitter(f.commit), nest.NestOptionWithEntitySync(f.sync), nest.NestOptionWithWorkerPools(nest.WorkerPoolConfig{Workers: 2, QueueCap: 64}, nest.WorkerPoolConfig{}, nest.WorkerPoolConfig{}))
	for _, register := range append([]func(*nest.NestMgr) error{handler.RegisterSceneChangeNestHandlersOn, handler.RegisterSceneCloseNestHandlersOn, handler.RegisterSceneDrainNestHandlersOn, handler.RegisterTerrainNestHandlersOn}, f.registers...) {
		if err := register(f.engine); err != nil {
			t.Fatal(err)
		}
	}
	if err := f.engine.Start(); err != nil {
		t.Fatal(err)
	}
	cfg := viper.New()
	cfg.Set("sid", 1000)
	f.registry = app.NewRegistry(cfg)
	for name, value := range map[app.ModName]any{mods.ModNest: f.engine, mods.ModEntityRuntime: f.access, mods.ModEntitySync: f.sync} {
		if err := f.registry.Register(name, value); err != nil {
			t.Fatal(err)
		}
	}
	// 协议注册先于 Scene / Terrain 的 Start，不能用提前启动的夹具掩盖接线错误。
	f.controller, err = FromRegistry(f.registry)
	if err != nil {
		t.Fatal(err)
	}
	f.change, err = scenecontroller.FromRegistry(f.registry)
	if err != nil {
		t.Fatal(err)
	}
	if _, err := f.controller.Execute(context.Background(), terrainPlayer, logic.Command{SceneID: 2, Sequence: 1, Op: "build"}); err == nil {
		t.Fatal("terrain request accepted before runtime started")
	}
	if _, err := scenes.Start(f.registry); err != nil {
		t.Fatal(err)
	}
	f.scenes, err = scenes.FromRegistry(f.registry)
	if err != nil {
		t.Fatal(err)
	}
	f.stop, err = runtime.Start(f.registry)
	if err != nil {
		t.Fatal(err)
	}
	f.runtime, err = runtime.FromRegistry(f.registry)
	if err != nil {
		t.Fatal(err)
	}
	for _, id := range []int64{terrainPlayer, terrainPlayer + 1} {
		if err := f.sync.OpenSession(entitysync.SessionID(id)); err != nil {
			t.Fatal(err)
		}
		f.move(id, 0, 2)
	}
}
func (f *terrainFixture) move(playerID, from, to int64) {
	f.t.Helper()
	if response, err := f.change.HandleSceneChange(&playeraccess.Context{PlayerID: playerID}, &pb.SceneChangeRequest{FromID: from, ToID: to}); err != nil || response.Code != 0 {
		f.t.Fatalf("scene change %d -> %d: %+v %v", from, to, response, err)
	}
}
func (f *terrainFixture) shutdown() {
	f.commit.reject.Store(false)
	// Stop的成员排空由scene正式生命周期执行；失败保留诊断，不能跳过资源释放错误。
	if err := f.scenes.Stop(context.Background()); err != nil {
		f.t.Error(err)
	}
	if f.stop != nil {
		if err := f.stop(context.Background()); err != nil {
			f.t.Error(err)
		}
	}
	if err := f.engine.Shutdown(context.Background()); err != nil {
		f.t.Error(err)
	}
	if err := f.sync.Close(context.Background()); err != nil {
		f.t.Error(err)
	}
	f.access.Manager().Range(func(value entity.IThreadSafeEntity) bool {
		if p, ok := value.(*player.Player); ok {
			p.ActorComp().OnDestroy(entity.DestroyReasonCommon)
		}
		value.OnDestroy(entity.DestroyReasonCommon)
		return true
	})
}
func (f *terrainFixture) world(id int64) *logic.World {
	f.t.Helper()
	world, err := f.runtime.World(id)
	if err != nil {
		f.t.Fatal(err)
	}
	return world
}
