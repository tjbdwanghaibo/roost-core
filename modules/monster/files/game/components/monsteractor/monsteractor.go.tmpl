package monsteractor

import (
	"fmt"
	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/framework/nest"
	"github.com/tjbdwanghaibo/roost-core/gameplay/heartbeat"
	"github.com/tjbdwanghaibo/roost-core/gameplay/movement"
	"github.com/tjbdwanghaibo/roost-core/infra/base/spatial"
	"math"
	"time"
	"{{MODULE}}/game/modules/actor"
	rules "{{MODULE}}/game/modules/monster"
	"{{MODULE}}/game/modules/monster/patrol"
	"{{MODULE}}/game/view"
)

// CreateParams 由Manager在实体可见之前提供，只含不可变规则及已提交空间的感知/投递能力。
type CreateParams struct {
	Spec    rules.Spec
	Sense   func(spatial.Point, int64) []rules.Candidate
	Respawn func(int64)
}
//roost:component type={{ID:component:MonsterActor}}
const CompTypeMonsterActor entity.ComponentType = {{ID:component:MonsterActor}}

// init 登记组件工厂：Monster 结构体里 comp:"monsteractor.CompTypeMonsterActor" 的字段经它创建组件。
func init() {
	entity.RegisterComponentFactory(CompTypeMonsterActor, NewComponent)
}

// Owner 是 MonsterActor 组件的宿主：view 的 MonsterEntity。
// 只在实体被 Nest 锁住期间使用。
type Owner = view.MonsterEntity

type Component struct {
	entity.ComponentBase
	owner   Owner
	body    *actor.Body
	params  CreateParams
	respawn *heartbeat.Reg
}

// NewComponent 是组件工厂（上面的 init 登记）。
func NewComponent(value any, _ *entity.EntityCreateParam) (entity.ComponentInterfaceBase, error) {
	owner, ok := value.(Owner)
	if !ok {
		return nil, fmt.Errorf("monster_actor component: owner %T does not implement monsteractor.Owner", value)
	}
	return &Component{owner: owner}, nil
}

func (c *Component) Name() string      { return "monster_actor" }
func (c *Component) Body() *actor.Body { return c.body }
func (c *Component) OnInitFinish(param *entity.EntityCreateParam, _ bool) error {
	if param == nil {
		return fmt.Errorf("monster: create params required")
	}
	params, ok := param.Param.(CreateParams)
	if !ok {
		return fmt.Errorf("monster: use service.Spawn")
	}
	if err := params.Spec.Validate(); err != nil {
		return err
	}
	c.params = params
	var err error
	// The commit observer publishes this nested DAO state; no setter-side publish.
	fields := movement.BindXY(func() movement.XYStore { return c.owner.Dao().GetActor() }, nil)
	c.body, err = actor.New(c.owner, actor.Config{Fields: fields, Hooks: actor.Hooks{AfterTick: c.tick}})
	if err != nil {
		return err
	}
	c.respawn, err = c.body.Host.Register("monster.respawn", time.Second, c.respawnTick)
	if err != nil {
		c.body.Close()
		return err
	}
	return nil
}
func (c *Component) OnDestroy(entity.EntityDestroyReason) {
	if c.body != nil {
		c.body.Close()
	}
}

// Spawn 由Monster+Scene同一事务调用。已经存活则幂等；失败后隐藏尸体的重刷心跳仍在，下一拍重试。
func (c *Component) Spawn(env actor.Environment, at spatial.Point, now int64) error {
	dao := c.owner.Dao()
	v, b := dao.GetVitals(), dao.GetBrain()
	if b.GetRetired() {
		return fmt.Errorf("monster: retired")
	}
	if v.GetHP() > 0 {
		return nil
	}
	if v.GetLifeSeq() > 0 && now < b.GetRespawnAt() {
		return fmt.Errorf("monster: respawn not due")
	}
	if v.GetLifeSeq() >= math.MaxInt64 {
		return fmt.Errorf("monster: life sequence exhausted")
	}
	if err := c.body.Enter(env, at, 0); err != nil {
		return err
	}
	v.SetTemplate(c.params.Spec.Template)
	v.SetHP(c.params.Spec.HP)
	v.SetLifeSeq(v.GetLifeSeq() + 1)
	b.SetHomeX(at.X)
	b.SetHomeY(at.Y)
	b.SetTarget(0)
	b.SetCorner(0)
	b.SetRespawnAt(0)
	c.respawn.Stop()
	return nil
}

// Damage 必须与Scene同时持锁；amount由可信战斗规则算出，expectedLife拒绝上一命的迟到攻击。
// 返回 true 表示死亡；死亡隐藏但保留Scene成员槽位，退休时才Depart。重复同命攻击由combat自己的账本判重。
func (c *Component) Damage(expectedLife uint64, amount, now int64) (bool, error) {
	v, b := c.owner.Dao().GetVitals(), c.owner.Dao().GetBrain()
	if amount <= 0 || expectedLife != v.GetLifeSeq() || v.GetHP() <= 0 || b.GetRetired() {
		return false, fmt.Errorf("monster: invalid damage or stale life")
	}
	if amount < v.GetHP() {
		v.SetHP(v.GetHP() - amount)
		return false, nil
	}
	if now > math.MaxInt64-c.params.Spec.RespawnDelay.Milliseconds() {
		return false, fmt.Errorf("monster: respawn time overflow")
	}
	if err := c.body.Leave(); err != nil {
		return false, err
	}
	v.SetHP(0)
	b.SetTarget(0)
	b.SetRespawnAt(now + c.params.Spec.RespawnDelay.Milliseconds())
	if err := c.respawn.Start(); err != nil {
		return false, err
	}
	return true, nil
}

// Retire 不再重生；服务端随后在事务外从正式实体Manager移除。
func (c *Component) Retire() error {
	if err := c.body.Leave(); err != nil {
		return err
	}
	c.owner.Dao().GetBrain().SetRetired(true)
	c.respawn.Stop()
	return nil
}
func (c *Component) respawnTick(beat heartbeat.Beat) error {
	v, b := c.owner.Dao().GetVitals(), c.owner.Dao().GetBrain()
	if b.GetRetired() || v.GetHP() > 0 {
		c.respawn.Stop()
		return nil
	}
	if beat.Now.UnixMilli() >= b.GetRespawnAt() && c.params.Respawn != nil {
		id := c.owner.ID()
		nest.AfterCommit(func() { c.params.Respawn(id) })
	}
	return nil
}
func (c *Component) tick(body *actor.Body, _ heartbeat.Beat) error {
	if c.owner.Dao().GetVitals().GetHP() <= 0 || !body.CanMove() {
		return nil
	}
	// Already inside the owner's Nest transaction. An ordinary patrol needs no transient AI runner.
	return c.Decide(c.owner.Dao().GetVitals().GetLifeSeq())
}

// Decide 是持锁的单拍动作入口；LifeSeq检查也适用于未来排队的AI命令。
func (c *Component) Decide(expectedLife uint64) error {
	v, b := c.owner.Dao().GetVitals(), c.owner.Dao().GetBrain()
	if v.GetLifeSeq() != expectedLife || v.GetHP() <= 0 || b.GetRetired() {
		return fmt.Errorf("monster: stale life")
	}
	if !c.body.CanMove() {
		return nil
	}
	var candidates []rules.Candidate
	if c.params.Sense != nil {
		candidates = c.params.Sense(c.body.Position(), c.params.Spec.SenseRadius)
	}
	target := rules.Nearest(c.body.Position(), c.params.Spec.SenseRadius, candidates)
	if target != 0 {
		if b.GetTarget() == target && c.body.Move.Moving() {
			return nil
		}
		if err := c.body.Follow(target, c.params.Spec.Speed, 2); err != nil {
			return err
		}
		b.SetTarget(target)
		return nil
	}
	if b.GetTarget() != 0 {
		c.body.Stop()
		b.SetTarget(0)
	}
	if c.body.Move.Moving() {
		return nil
	}
	home := spatial.Point{X: b.GetHomeX(), Y: b.GetHomeY()}
	corners := patrol.AroundCenter(home, c.params.Spec.PatrolHalf)
	index := int(b.GetCorner()) % len(corners)
	if index < 0 {
		return fmt.Errorf("monster: invalid patrol cursor")
	}
	// Only the DAO owns the cursor. A refused start returns the Body's error to Nest.
	next, err := patrol.StartNext(corners[:], index, func(at spatial.Point) error {
		return c.body.Walk([]spatial.Point{at}, c.params.Spec.Speed)
	})
	if err != nil {
		return err
	}
	b.SetCorner(int32(next % len(corners)))
	return nil
}

// Snapshot 是 view.MonsterSnapshot（结构体定义在 game/view，这里留同名别名，组件与 handler 的写法不变）。
type Snapshot = view.MonsterSnapshot

func (c *Component) Snapshot() Snapshot {
	v := c.owner.Dao().GetVitals()
	p := c.body.Position()
	return Snapshot{ID: c.owner.ID(), LifeSeq: v.GetLifeSeq(), HP: v.GetHP(), Template: v.GetTemplate(), SceneID: c.body.Map.SceneID(), X: p.X, Y: p.Y}
}

func (c *Component) SpawnPoint() spatial.Point { return c.params.Spec.At }
