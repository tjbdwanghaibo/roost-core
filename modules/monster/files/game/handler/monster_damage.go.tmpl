package handler

import (
	"fmt"
	monster "{{MODULE}}/game/entities/monster"
	scene "{{MODULE}}/game/entities/scene"
)

//roost:nest rollback=undo durability=async
func handlerMonsterDamage(target monster.IMonsterEntity, area scene.ISceneEntity, expected monster.Target, expectedLife uint64, amount int64, nowUnixMilli int64) (monster.Snapshot, error) {
	if err := expected.Check(target, area); err != nil {
		return monster.Snapshot{}, err
	}
	c := target.MonsterActorComp()
	if c.Body().Map.SceneID() != area.ID() {
		return monster.Snapshot{}, fmt.Errorf("monster: different scene")
	}
	_, err := c.Damage(expectedLife, amount, nowUnixMilli)
	if err != nil {
		return monster.Snapshot{}, err
	}
	return c.Snapshot(), nil
}
