func TestMonsterFailedDecisionRollsBackCursorAndMovement(t *testing.T) {
	f := newMonsterFixture(t)
	m := f.spawn(rules.DefaultSpec())
	failure := errors.New("later transaction failed")
	err := f.run(m, func(e entity.IThreadSafeEntity) error {
		m := e.(*monster.Monster)
		if err := m.MonsterActorComp().Body().Tick(heartbeat.Beat{Now: time.UnixMilli(f.now.Load()), Elapsed: 200 * time.Millisecond}); err != nil {
			return err
		}
		return failure
	})
	if !errors.Is(err, failure) {
		t.Fatal(err)
	}
	f.must(m, func(m *monster.Monster) error {
		if m.Dao().GetBrain().GetCorner() != 0 || m.MonsterActorComp().Body().Move.Moving() {
			t.Fatal("AI survived rollback")
		}
		return nil
	})
	f.tick(m)
	f.tick(m)
	if f.snapshot(m).X <= 80 {
		t.Fatal("retry could not act")
	}
}
