func TestMonsterRealHeartbeatPatrolAndRespawn(t *testing.T) {
	f := newMonsterFixture(t)
	clock.SetSource(nil)
	spec := rules.DefaultSpec()
	spec.RespawnDelay = time.Second
	m := f.spawn(spec)
	if err := gameheartbeat.Driver.Bind(f.engine, f.access.Manager().Get); err != nil {
		t.Fatal(err)
	}
	if err := gameheartbeat.Driver.Start(); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := gameheartbeat.Driver.Stop(context.Background()); err != nil {
			t.Error(err)
		}
	})
	deadline := time.Now().Add(4 * time.Second)
	moved := false
	for time.Now().Before(deadline) {
		if f.snapshot(m).X > 80 {
			moved = true
			break
		}
		time.Sleep(5 * time.Millisecond)
	}
	if !moved {
		t.Fatal("real heartbeat did not patrol")
	}
	if _, err := f.manager.Damage(context.Background(), m.ID(), 1, 100); err != nil {
		t.Fatal(err)
	}
	deadline = time.Now().Add(4 * time.Second)
	for time.Now().Before(deadline) {
		if s := f.snapshot(m); s.LifeSeq == 2 && s.HP == 100 {
			return
		}
		time.Sleep(5 * time.Millisecond)
	}
	t.Fatal("real heartbeat did not respawn")
}
