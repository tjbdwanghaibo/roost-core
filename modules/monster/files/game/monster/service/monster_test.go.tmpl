func TestMonsterRootedStopsAndResumesPatrol(t *testing.T) {
	f := newMonsterFixture(t)
	m := f.spawn(rules.DefaultSpec())
	f.must(m, func(m *monster.Monster) error {
		return m.MonsterActorComp().Body().States.Add(actor.Rooted, state.Source{Kind: 1, ID: 1})
	})
	f.tick(m)
	f.tick(m)
	if f.snapshot(m).X != 80 {
		t.Fatal("rooted moved")
	}
	f.must(m, func(m *monster.Monster) error {
		return m.MonsterActorComp().Body().States.Remove(actor.Rooted, state.Source{Kind: 1, ID: 1})
	})
	f.tick(m)
	f.tick(m)
	if f.snapshot(m).X <= 80 {
		t.Fatal("root never resumed")
	}
}
func TestMonsterChasesPublishedPlayerWithoutRestartingSlowFollow(t *testing.T) {
	f := newMonsterFixture(t)
