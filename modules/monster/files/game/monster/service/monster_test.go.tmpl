type monsterCommit struct{}

func (monsterCommit) Commit(context.Context, dataengine.CommitRecord) error { return nil }

type monsterFixture struct {
	t        *testing.T
	access   *entity.ManagerAccess
	engine   *nest.NestMgr
	sync     *entitysync.Manager
	scenes   *sceneservice.Manager
	manager  *Manager
	registry *app.Registry
	now      atomic.Int64
}

var monsterTestHandler = nest.NewHandlerName("module_monster.test")

func newMonsterFixture(t *testing.T) *monsterFixture {
	t.Helper()
	monster.RegisterEntity()
	sceneentity.RegisterEntity()
	player.RegisterEntity()
	f := &monsterFixture{t: t, access: entity.NewManagerAccess(entity.NewEntityManager())}
	f.now.Store(1800000000000)
	clock.SetSource(func() time.Time { return time.UnixMilli(f.now.Load()) })
	t.Cleanup(func() { clock.SetSource(nil) })
	var err error
	f.sync, err = entitysync.NewManager(entitysync.ManagerConfig{Transport: entitysync.TransportFunc(func(context.Context, entitysync.SessionID, []byte) error { return nil })})
	if err != nil {
		t.Fatal(err)
	}
	f.engine = nest.NewEngine(nest.NestOptionWithGetter(f.access), nest.NestOptionWithTransactionCommitter(monsterCommit{}), nest.NestOptionWithEntitySync(f.sync), nest.NestOptionWithWorkerPools(nest.WorkerPoolConfig{Workers: 2, QueueCap: 64}, nest.WorkerPoolConfig{}, nest.WorkerPoolConfig{}))
	for _, register := range []func(*nest.NestMgr) error{handler.RegisterMonsterSpawnNestHandlersOn, handler.RegisterMonsterDamageNestHandlersOn, handler.RegisterMonsterRemoveNestHandlersOn, handler.RegisterMonsterInspectNestHandlersOn, handler.RegisterSceneChangeNestHandlersOn, handler.RegisterSceneCloseNestHandlersOn, handler.RegisterSceneDrainNestHandlersOn} {
		if err := register(f.engine); err != nil {
			t.Fatal(err)
		}
	}
	f.engine.MustRegisterHandlerWithMeta(monsterTestHandler, func(es []entity.IThreadSafeEntity, p []any, _ ...nest.HandlerOption) (any, error) {
		return nil, p[0].(func(entity.IThreadSafeEntity) error)(es[0])
	}, nest.HandlerMeta{Rollback: nest.RollbackUndo, Durability: nest.DurabilityAsync})
	if err := f.engine.Start(); err != nil {
		t.Fatal(err)
	}
	cfg := viper.New()
	cfg.Set("sid", 1000)
	f.registry = app.NewRegistry(cfg)
	for key, value := range map[app.ModName]any{mods.ModNest: f.engine, mods.ModEntityRuntime: f.access, mods.ModEntitySync: f.sync} {
		if err := f.registry.Register(key, value); err != nil {
			t.Fatal(err)
		}
	}
	stopActor, err := actor.Start(f.registry)
	if err != nil {
		t.Fatal(err)
	}
	if _, err := sceneservice.Start(f.registry); err != nil {
		t.Fatal(err)
	}
	f.scenes, err = sceneservice.FromRegistry(f.registry)
	if err != nil {
		t.Fatal(err)
	}
	f.manager, err = newManager(f.access, f.engine, f.scenes, 1000)
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := f.manager.Stop(context.Background()); err != nil {
			t.Error(err)
		}
		if err := stopActor(context.Background()); err != nil {
			t.Error(err)
		}
		if err := f.engine.Shutdown(context.Background()); err != nil {
			t.Error(err)
		}
		f.sync.Close(context.Background())
		f.access.Manager().Range(func(e entity.IThreadSafeEntity) bool { e.OnDestroy(entity.DestroyReasonCommon); return true })
	})
	return f
}
func (f *monsterFixture) spawn(spec rules.Spec) *monster.Monster {
	f.t.Helper()
	id, err := f.manager.Spawn(context.Background(), 1, spec)
	if err != nil {
		f.t.Fatal(err)
	}
	return f.access.Manager().Get(id).(*monster.Monster)
}
func (f *monsterFixture) run(e entity.IThreadSafeEntity, fn func(entity.IThreadSafeEntity) error) error {
	_, err := f.engine.Request(context.Background(), monsterTestHandler, e.ID(), nest.NewParams(fn))
	return err
}
func (f *monsterFixture) must(m *monster.Monster, fn func(*monster.Monster) error) {
	f.t.Helper()
	if err := f.run(m, func(e entity.IThreadSafeEntity) error { return fn(e.(*monster.Monster)) }); err != nil {
		f.t.Fatal(err)
	}
}
func (f *monsterFixture) snapshot(m *monster.Monster) monster.Snapshot {
	var out monster.Snapshot
	f.must(m, func(m *monster.Monster) error { out = m.MonsterActorComp().Snapshot(); return nil })
	return out
}
func (f *monsterFixture) tick(m *monster.Monster) {
	f.now.Add(200)
	f.must(m, func(m *monster.Monster) error {
		return m.MonsterActorComp().Body().Tick(heartbeat.Beat{Now: time.UnixMilli(f.now.Load()), Elapsed: 200 * time.Millisecond})
	})
}
func (f *monsterFixture) area() *sceneentity.Scene {
	_, id, err := f.scenes.IDs(0, 1)
	if err != nil {
		f.t.Fatal(err)
	}
	return f.access.Manager().Get(id).(*sceneentity.Scene)
}
func (f *monsterFixture) player() *player.Player {
	f.t.Helper()
	built, err := f.access.Create(&entity.EntityCreateParam{IsCreate: true, UniqueID: 1001, Kind: player.EntityKindPlayer})
	if err != nil {
		f.t.Fatal(err)
	}
	p := built.(*player.Player)
	if err := f.sync.OpenSession(entitysync.SessionID(p.UniqueID())); err != nil {
		f.t.Fatal(err)
	}
	c, err := scenecontroller.FromRegistry(f.registry)
	if err != nil {
		f.t.Fatal(err)
	}
