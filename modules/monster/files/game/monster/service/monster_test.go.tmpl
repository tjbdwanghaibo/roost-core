var monsterRemoveReplyLost = errors.New("injected lost remove reply")

type monsterLostRemoveClient struct {
	nest.Client
	lost bool
}

func (c *monsterLostRemoveClient) RequestMulti(ctx context.Context, name nest.HandlerName, ids []int64, args nest.Params, opts ...nest.SendOpt) (any, error) {
	result, err := c.Client.RequestMulti(ctx, name, ids, args, opts...)
	if err == nil && name == nest.NewHandlerName("handlerMonsterRemove") && !c.lost {
		c.lost = true
		return nil, monsterRemoveReplyLost
	}
	return result, err
}
func TestMonsterDrainRetriesWhenRemoveCommittedButReplyWasLost(t *testing.T) {
	f := newMonsterFixture(t)
	if err := f.manager.Stop(context.Background()); err != nil {
		t.Fatal(err)
	}
	if _, err := Start(f.registry); err != nil {
		t.Fatal(err)
	}
	manager, err := FromRegistry(f.registry)
	if err != nil {
		t.Fatal(err)
	}
	f.manager = manager
	area := f.area()
	ids := manager.IDs()
	if len(ids) != 1 {
		t.Fatal(ids)
	}
	id := ids[0]
	manager.operations.Lock()
	manager.client = &monsterLostRemoveClient{Client: f.engine}
	manager.operations.Unlock()
	if err := f.scenes.Drain(context.Background(), 1); !errors.Is(err, monsterRemoveReplyLost) {
		t.Fatal("remove reply fault was not reached", err)
	}
	if err := f.run(area, func(entity.IThreadSafeEntity) error {
		if area.Dao().MembersLen() != 0 {
			return errors.New("remove did not commit before lost reply")
		}
		return nil
	}); err != nil {
		t.Fatal(err)
	}
	if f.access.Manager().Get(id) == nil || len(manager.IDs()) != 1 {
		t.Fatal("unknown result destroyed or forgot the monster")
	}
	if err := f.scenes.Drain(context.Background(), 1); err != nil {
		t.Fatal("retry failed", err)
	}
	if f.access.Manager().Get(id) != nil || len(manager.IDs()) != 0 {
		t.Fatal("drain retry leaked retired lifecycle record")
	}
	if f.access.Manager().Get(area.ID()) != nil {
		t.Fatal("drain retry retained empty scene")
	}
}
func TestMonsterDestroyRejectsAReplacementEntityInstance(t *testing.T) {
	f := newMonsterFixture(t)
	old := f.spawn(rules.DefaultSpec())
	id, unique := old.ID(), old.UniqueID()
	if err := f.manager.lives.Destroy(context.Background(), old, entity.DestroyReasonCommon, false); err != nil {
		t.Fatal(err)
	}
	replacement, err := f.manager.lives.CreateMonster(context.Background(), unique, monster.CreateParams{Spec: rules.DefaultSpec()})
	if err != nil {
		t.Fatal(err)
	}
	// 只在夹具中清理失效记录；正式管理器拒绝接管另一实例，不能删掉新生命周期。
	defer func() {
		f.manager.operations.Lock()
		delete(f.manager.records, id)
		f.manager.operations.Unlock()
	}()
	sent := false
	f.manager.client = &monsterInterleavingClient{Client: f.engine, name: nest.NewHandlerName("handlerMonsterRemove"), before: func([]int64) error { sent = true; return nil }}
	if err := f.manager.Destroy(context.Background(), id); err == nil {
		t.Fatal("replacement lifecycle was accepted")
	}
	if sent {
		t.Fatal("known replacement reached Nest instead of early refusal")
	}
	if f.access.Manager().Get(id) != replacement {
		t.Fatal("replacement entity was destroyed")
	}
	f.must(replacement, func(m *monster.Monster) error {
		if m.Dao().GetBrain().GetRetired() {
			return errors.New("replacement lifecycle was retired")
		}
		return nil
	})
}

// monsterInterleavingClient 只安排确定交错，转发仍走真实 Nest；不替换业务 handler 或生命周期。
type monsterInterleavingClient struct {
	nest.Client
	name      nest.HandlerName
	before    func([]int64) error
	completed chan error
}

func (c *monsterInterleavingClient) RequestMulti(ctx context.Context, name nest.HandlerName, ids []int64, args nest.Params, opts ...nest.SendOpt) (any, error) {
	matched := name == c.name && c.before != nil
	if matched {
		before := c.before
		c.before = nil
		if err := before(ids); err != nil {
			return nil, err
		}
	}
	result, err := c.Client.RequestMulti(ctx, name, ids, args, opts...)
	if matched && c.completed != nil {
		c.completed <- err
	}
	return result, err
}

// checkMonsterReplacement 固定在服务已选定记录、正式 Sender 尚未投递之间替换一个实例。
// 每个调用者是独立场景，覆盖初生/异步重刷/伤害/退出分别遇到 Monster 或 Scene 同ID重建。
func checkMonsterReplacement(t *testing.T, operation string, replaceScene bool) {
	t.Helper()
	f := newMonsterFixture(t)
	ctx := context.Background()
	area := f.area()
	var original *monster.Monster
	var id int64
	if operation != "Spawn" {
		original = f.spawn(rules.DefaultSpec())
		id = original.ID()
		if operation == "Respawn" {
			if _, err := f.manager.Damage(ctx, id, 1, 100); err != nil {
				t.Fatal(err)
			}
			f.now.Add(6000)
		}
	}
	var checked *monster.Monster
	var checkedArea *sceneentity.Scene
	var before monster.Snapshot
	var memberBefore bool
	name := "handlerMonster" + operation
	if operation == "Respawn" {
		name = "handlerMonsterSpawn"
	}
	if operation == "Destroy" {
		name = "handlerMonsterRemove"
	}
	done := make(chan error, 1)
	hook := &monsterInterleavingClient{Client: f.engine, name: nest.NewHandlerName(name), completed: done}
	hook.before = func(ids []int64) error {
		id = ids[0]
		original = f.access.Manager().Get(id).(*monster.Monster)
		checked, checkedArea = original, area
		if replaceScene {
			unique, config := area.UniqueID(), area.Config()
			if err := f.access.Destroy(ctx, area, entity.DestroyReasonCommon, false); err != nil {
				return err
			}
			made, err := f.access.Create(&entity.EntityCreateParam{IsCreate: true, UniqueID: unique, Kind: sceneentity.EntityKindScene, Param: sceneentity.CreateParams{Config: config, Manager: f.sync, PlayerKind: player.EntityKindPlayer, Loaded: f.access.Manager().Get}})
			if err != nil {
				return err
			}
			checkedArea = made.(*sceneentity.Scene)
			if err := f.run(checkedArea, func(entity.IThreadSafeEntity) error { return checkedArea.Admit(id) }); err != nil {
				return err
			}
		} else {
			unique := original.UniqueID()
			if err := sender.NewMonsterRemoveSender(f.engine).MultiSync_MonsterRemove(ctx, id, area.ID(), original.Target(area)); err != nil {
				return err
			}
			if err := f.manager.lives.Destroy(ctx, original, entity.DestroyReasonCommon, false); err != nil {
				return err
			}
			made, err := f.manager.lives.CreateMonster(ctx, unique, monster.CreateParams{Spec: rules.DefaultSpec()})
			if err != nil {
				return err
			}
			checked = made
			if _, err := sender.NewMonsterSpawnSender(f.engine).MultiSync_MonsterSpawn(ctx, id, area.ID(), checked.Target(area)); err != nil {
				return err
			}
		}
		before = f.snapshot(checked)
		return f.run(checkedArea, func(entity.IThreadSafeEntity) error { _, memberBefore = checkedArea.Dao().GetMembers(id); return nil })
	}
	f.manager.operations.Lock()
	f.manager.client = hook
	f.manager.operations.Unlock()
	// 外部重建的实例不属于原管理器；夹具只撤销旧记录，不让清理接管新实例。
	defer func() { f.manager.operations.Lock(); delete(f.manager.records, id); f.manager.operations.Unlock() }()
	var err error
	switch operation {
	case "Spawn":
		_, err = f.manager.Spawn(ctx, 1, rules.DefaultSpec())
	case "Damage":
		_, err = f.manager.Damage(ctx, id, 1, 10)
	case "Destroy":
		err = f.manager.Destroy(ctx, id)
	case "Respawn":
		f.manager.offer(id)
		select {
		case err = <-done:
		case <-time.After(3 * time.Second):
			t.Fatal("respawn queue did not dispatch")
		}
	default:
		t.Fatal("unknown operation", operation)
	}
	if checked == nil {
		t.Fatal("replacement interleaving was not reached", err)
	}
	if err == nil || !strings.Contains(err.Error(), "lifecycle instance changed") {
		t.Fatalf("stale %s was not rejected: %v", operation, err)
	}
	f.must(checked, func(m *monster.Monster) error {
		if m.MonsterActorComp().Snapshot() != before || m.Dao().GetBrain().GetRetired() {
			return errors.New("replacement transaction changed monster")
		}
		return nil
	})
	if err := f.run(checkedArea, func(entity.IThreadSafeEntity) error {
		_, memberAfter := checkedArea.Dao().GetMembers(id)
		if memberAfter != memberBefore {
			return errors.New("replacement transaction changed scene membership")
		}
		return nil
	}); err != nil {
		t.Fatal(err)
	}
}
