package monster

import (
	"{{MODULE}}/game/components/monsteractor"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/gameplay/movement"
)

//roost:component type={{ID:component:MonsterActor}}
const CompTypeMonsterActor entity.ComponentType = {{ID:component:MonsterActor}}

// MonsterActorComponent 是 game/components/monsteractor 的组件在 Monster 上的名字（生成接线与 handler 用它）；业务在那个包里。
type MonsterActorComponent = monsteractor.Component

// CreateParams 是 Monster 的创建参数（定义在组件包，Manager 在实体可见之前提供）。
type CreateParams = monsteractor.CreateParams

// MapBasic / MoveComponent 是场景与移动框架要的实体方法，取自 MonsterActor 组件的 Body。
func (m *Monster) MapBasic() *movement.MapBasic  { return m.MonsterActorComp().Body().Map }
func (m *Monster) MoveComponent() *movement.Move { return m.MonsterActorComp().Body().Move }

type IMonsterEntity interface {
	entity.IThreadSafeEntity
	MonsterActorComp() *MonsterActorComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeMonsterActor, monsteractor.NewComponent)
}
