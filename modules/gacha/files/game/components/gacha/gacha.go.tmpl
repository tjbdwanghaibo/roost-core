package gacha

import (
	gamebag "{{MODULE}}/game/components/bag"
	"{{MODULE}}/game/view"
	"fmt"
	"math"
	"math/rand/v2"

	"{{MODULE}}/configs/schema"
	db "{{MODULE}}/db"
	apperrors "{{MODULE}}/internal/errors"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

// Owner 是 Gacha 组件的宿主（Player 的接线见 game/entities/player/gacha_component.go）：只列组件用得到的
// DAO 与别的组件（view 的小接口）。只在实体被 Nest 锁住期间使用。
type Owner interface {
	entity.IThreadSafeEntity
	Dao() *db.PlayerDao
	view.BagHolder
	view.WalletHolder
}

// Component 只持有所属玩家；业务状态和回执全在 DAO，由 Nest 统一提交与回滚。
// 业务入口只能在持有 Player 锁的 Nest 事务里调用，错误必须原样交还 Nest，不可吞掉。
type Component struct {
	entity.ComponentBase
	owner Owner
}

// NewComponent 是组件工厂；Player 在 game/entities/player/gacha_component.go 登记它。
func NewComponent(value any, _ *entity.EntityCreateParam) (entity.ComponentInterfaceBase, error) {
	owner, ok := value.(Owner)
	if !ok {
		return nil, fmt.Errorf("gacha component: owner %T does not implement gacha.Owner", value)
	}
	return &Component{owner: owner}, nil
}

func (component *Component) Name() string   { return "gacha" }
func (component *Component) Owner() Owner { return component.owner }

const GachaReceiptWindow = 64
const GachaMaxPools = 64

// GachaResult 是 view.GachaResult（结构体定义在 game/view，这里留同名别名，组件与 handler 的写法不变）。
type GachaResult = view.GachaResult

func gachaKeyValid(key string) bool {
	if len(key) < 1 || len(key) > 64 {
		return false
	}
	for _, c := range []byte(key) {
		if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '-' || c == '_' || c == ':') {
			return false
		}
	}
	return true
}

// Draw 用同一笔事务扣费、发奖、更新保底并记回执；中途背包或提交拒绝时，必须由 Nest 整笔回滚。
// 随机结果只在成功回执中成为持久事实；被拒绝的尝试没有结果，重试可以重新抽样。
// 重放先于配置查询，因此下架/热更后仍回放原结果；同键换池或次数拒绝。窗口外旧键视为新请求。
func (component *Component) Draw(key string, poolID, count int64) (GachaResult, error) {
	return component.draw(key, poolID, count, false)
}

// DrawFree 是不扣金币的单抽：掉落、保底、背包检查、回执与 Draw 共用同一段代码和同一个请求键窗口，
// 只是不调用货币组件（Cost 为 0，Balance 是当时的余额；不触发消费钩子）。池的 Price 对它不起作用。
// 免费的次数规则（每日一次、活动送几次）属于调用方：先调它，Replayed 为真时原样返回、不再记次数；
// 否则再判自己的次数，超了就返回错误，Nest 把这次抽卡一起回滚。同一个键用过付费抽卡再来免费（或反过来）按键冲突拒绝。
func (component *Component) DrawFree(key string, poolID int64) (GachaResult, error) {
	return component.draw(key, poolID, 1, true)
}

func (component *Component) draw(key string, poolID, count int64, free bool) (GachaResult, error) {
	if !gachaKeyValid(key) {
		return GachaResult{}, apperrors.ErrGachaKeyInvalid
	}
	ledger := component.owner.Dao().GetGachaLedger()
	if old, ok := ledger.GetReceipts(key); ok {
		if old.GetPoolID() != poolID || old.GetCount() != count || old.GetFree() != free {
			return GachaResult{}, apperrors.ErrGachaKeyConflict
		}
		items := make([]int64, old.ItemsLen())
		old.RangeItems(func(index int, value int64) bool { items[index] = value; return true })
		return GachaResult{Cost: old.GetCost(), Balance: old.GetBalance(), Items: items, Misses: old.GetMisses(), Replayed: true}, nil
	}
	if count != 1 && count != 10 {
		return GachaResult{}, apperrors.ErrGachaCountInvalid
	}
	pool, drops, total, err := gachaRules(poolID)
	if err != nil {
		return GachaResult{}, err
	}
	if (!free && pool.Price > math.MaxInt64/count) || ledger.GetNextSeq() == math.MaxInt64 {
		return GachaResult{}, apperrors.ErrGachaOverflow
	}
	state := component.owner.Dao().GetGacha()
	misses, exists := state.GetMisses(poolID)
	if !exists && state.MissesLen() >= GachaMaxPools {
		return GachaResult{}, apperrors.ErrGachaPoolLimit
	}
	if misses < 0 || misses == math.MaxInt64 {
		return GachaResult{}, apperrors.ErrGachaPoolInvalid
	}
	// 在抽样之前保守检查每种候选奖品最多来 count 个时也能收下，且有足够新种类槽位。
	// 否则玩家可先塞满低价值道具，利用拒绝零扣费反复尝试直到抽中高价值道具。免费单抽同样检查。
	if err := component.checkGachaCapacity(drops, count); err != nil {
		return GachaResult{}, err
	}
	cost, balance := int64(0), component.owner.Wallet().Balance()
	if !free {
		cost = pool.Price * count
		if balance, err = component.owner.Wallet().Add(-cost); err != nil {
			return GachaResult{}, err
		}
	}
	items := make([]int64, 0, count)
	for i := int64(0); i < count; i++ {
		var itemID int64
		if misses+1 >= pool.PityAfter {
			itemID = pool.PityItemID
		} else {
			itemID = gachaPick(drops, rand.Int64N(total))
		}
		if _, err := component.owner.Bag().Add(itemID, 1); err != nil {
			return GachaResult{}, err
		}
		if itemID == pool.PityItemID {
			misses = 0
		} else {
			misses++
		}
		items = append(items, itemID)
	}
	state.SetMissesKey(poolID, misses)
	if ledger.ReceiptsLen() >= GachaReceiptWindow {
		var oldest string
		var seq int64
		ledger.RangeReceipts(func(key string, r *db.GachaReceipt) bool {
			if oldest == "" || r.GetSeq() < seq {
				oldest, seq = key, r.GetSeq()
			}
			return true
		})
		ledger.DelReceiptsKey(oldest)
	}
	seq := ledger.GetNextSeq() + 1
	ledger.SetNextSeq(seq)
	receipt := &db.GachaReceipt{}
	receipt.SetPoolID(poolID)
	receipt.SetCount(count)
	receipt.SetCost(cost)
	receipt.SetBalance(balance)
	receipt.SetItems(items)
	receipt.SetMisses(misses)
	receipt.SetSeq(seq)
	receipt.SetFree(free)
	ledger.SetReceiptsKey(key, receipt)
	return GachaResult{Cost: cost, Balance: balance, Items: append([]int64(nil), items...), Misses: misses}, nil
}

// checkGachaCapacity 保守按所有候选奖励预留空间，不消耗随机数、不写 DAO。
// 也包含零权重的保底项；因此空间不足时可能拒绝一个实际能放下的随机结果，换来无可操纵的重抽窗口。
func (component *Component) checkGachaCapacity(drops []schema.GachaDrop, count int64) error {
	seen := map[int64]bool{}
	newKinds := 0
	for _, row := range drops {
		if seen[row.ItemID] {
			continue
		}
		seen[row.ItemID] = true
		maxStack, ok := gamebag.ItemRule(row.ItemID)
		if !ok {
			return apperrors.ErrBagItemInvalid
		}
		if maxStack <= 0 || maxStack > gamebag.MaxStack {
			maxStack = gamebag.MaxStack
		}
		held := component.owner.Bag().Count(row.ItemID)
		if held > maxStack || count > maxStack-held {
			return apperrors.ErrBagStackFull
		}
		if held == 0 {
			newKinds++
		}
	}
	if component.owner.Dao().GetBag().ItemsLen()+min(newKinds, int(count)) > gamebag.MaxKinds {
		return apperrors.ErrBagKindsFull
	}
	return nil
}
