// 免费单抽不动金币：一个金币都没有也能抽；道具、保底、回执与付费单抽一样记。样例池 1 是 3 抽保底 1002。
func TestGachaFreeDrawGrantsWithoutCharging(t *testing.T) {
	f := newGachaFixture(t, 0)
	r := f.mustFree(t, "free-1", 1)
	if r.Replayed || r.Cost != 0 || r.Balance != 0 || r.Misses != 1 || !reflect.DeepEqual(r.Items, []int64{1001}) {
		t.Fatalf("first free result %+v", r)
	}
	f.mustFree(t, "free-2", 1)
	if r = f.mustFree(t, "free-3", 1); r.Cost != 0 || r.Misses != 0 || !reflect.DeepEqual(r.Items, []int64{1002}) {
		t.Fatalf("third free draw did not apply pity: %+v", r)
	}
	if s := f.snapshot(t); s.Coins != 0 || s.Items[1001] != 2 || s.Items[1002] != 1 || s.Misses[1] != 0 || s.Receipts != 3 || s.Sequence != 3 {
		t.Fatalf("free facts %+v", s)
	}
}

// 同键重发返回原结果、零写入，并标明是重放：每日免费次数这类规则靠它判断这次算不算新用掉一次。付费入口的重放同样标明。
func TestGachaReplayIsReportedToTheCaller(t *testing.T) {
	f := newGachaFixture(t, 100)
	first := f.mustFree(t, "daily-free", 1)
	before := f.snapshot(t)
	again := f.mustFree(t, "daily-free", 1)
	if first.Replayed || !again.Replayed {
		t.Fatalf("replay flags: first %v, again %v", first.Replayed, again.Replayed)
	}
	again.Replayed = false
	if !reflect.DeepEqual(first, again) || !reflect.DeepEqual(before, f.snapshot(t)) {
		t.Fatalf("free replay changed result or state: first %+v again %+v", first, again)
	}
	paid, err := f.component("paid", 1, 1, false)
	if err != nil || paid.Replayed || paid.Cost != 10 {
		t.Fatalf("paid draw %+v %v", paid, err)
	}
	if paid, err = f.component("paid", 1, 1, false); err != nil || !paid.Replayed || paid.Cost != 10 || f.snapshot(t).Coins != 90 {
		t.Fatalf("paid replay %+v %v", paid, err)
	}
}

// 免费与付费的回执不互通：同一个键换一种抽法按键冲突拒绝，付费结果不会当成免费重放，免费结果也不会当成付费重放。
func TestGachaFreeAndPaidKeysDoNotCross(t *testing.T) {
	f := newGachaFixture(t, 100)
	f.mustDraw(t, "paid", 1, 1)
	f.refuseFree(t, apperrors.ErrGachaKeyConflict, "paid", 1)
	f.mustFree(t, "free", 1)
	f.refuse(t, apperrors.ErrGachaKeyConflict, "free", 1, 1)
	f.refuseFree(t, apperrors.ErrGachaKeyConflict, "free", 2)
}

// 免费单抽的拒绝与付费一样发生在写入之前：非法键、未知或关闭的池、背包放不下候选道具都零写入。
func TestGachaFreeDrawRefusesBeforeWriting(t *testing.T) {
	f := newGachaFixture(t, 0)
	f.refuseFree(t, apperrors.ErrGachaKeyInvalid, "", 1)
	f.refuseFree(t, apperrors.ErrGachaPoolInvalid, "a", 99)
	f.refuseFree(t, apperrors.ErrGachaPoolInvalid, "b", 4)
	f.grant(t, 1002, 999999)
	f.refuseFree(t, apperrors.ErrBagStackFull, "c", 1)
}

// 不要保底：PityAfter 填上限 1000000，PityItemID 填池里一个普通道具。走不到上限，零权重的道具永远不会被强制给出；
// 对照样例池 1（3 抽保底 1002）的十连必出 1002。超过上限的 PityAfter 整池拒绝。
func TestGachaPityAtTheUpperBoundIsNeverForced(t *testing.T) {
	f := newGachaFixture(t, 1000)
	gachaLoad(t,
		append(gachaPools(), schema.GachaPool{ID: 5, Price: 10, PityAfter: 1000000, PityItemID: 1001}, schema.GachaPool{ID: 6, Price: 10, PityAfter: 1000001, PityItemID: 1001}),
		append(gachaDrops(), schema.GachaDrop{ID: 6, PoolID: 5, ItemID: 1001, Weight: 1}, schema.GachaDrop{ID: 7, PoolID: 5, ItemID: 1002, Weight: 0}, schema.GachaDrop{ID: 8, PoolID: 6, ItemID: 1001, Weight: 1}))
	r := f.mustDraw(t, "no-pity", 5, 10)
	if r.Cost != 100 || !reflect.DeepEqual(r.Items, []int64{1001, 1001, 1001, 1001, 1001, 1001, 1001, 1001, 1001, 1001}) {
		t.Fatalf("no-pity ten %+v", r)
	}
	if free := f.mustFree(t, "no-pity-free", 5); !reflect.DeepEqual(free.Items, []int64{1001}) {
		t.Fatalf("no-pity free %+v", free)
	}
	f.refuse(t, apperrors.ErrGachaPoolInvalid, "too-far", 6, 1)
}
