// 用例独立加载 item/gacha_pool/gacha_drop 三张表，不借用其他模块的测试。两处进程配置都恢复。
// 有些用例故意直接装无效数据，验证组件能在 schema 校验之外拒绝坏的跨表关联。
func gachaLoad(t *testing.T, pools []schema.GachaPool, drops []schema.GachaDrop) {
	t.Helper()
	dir := t.TempDir()
	rows := map[string]any{"item": []schema.Item{{ID: 1001, Name: "a"}, {ID: 1002, Name: "b"}, {ID: 1003, Name: "c"}}, "gacha_pool": pools, "gacha_drop": drops}
	for name, data := range rows {
		raw, err := json.Marshal(data)
		if err != nil {
			t.Fatal(err)
		}
		if err := os.WriteFile(filepath.Join(dir, name+".json"), raw, 0600); err != nil {
			t.Fatal(err)
		}
	}
	reg := configdata.NewRegistry()
	configdata.MustRegisterTable(reg, configdata.TableDef[int64, schema.Item]{Name: "item", File: "item.json", Key: func(r schema.Item) int64 { return r.ID }})
	configdata.MustRegisterTable(reg, configdata.TableDef[int64, schema.GachaPool]{Name: "gacha_pool", File: "gacha_pool.json", Key: func(r schema.GachaPool) int64 { return r.ID }})
	configdata.MustRegisterTable(reg, configdata.TableDef[int64, schema.GachaDrop]{Name: "gacha_drop", File: "gacha_drop.json", Key: func(r schema.GachaDrop) int64 { return r.ID }})
	previous, config := configdata.DefaultStore(), fctx.RuntimeConfig()
	t.Cleanup(func() { configdata.SetDefaultStore(previous); fctx.SetRuntimeConfig(config) })
	if _, err := configdata.NewStore(reg, dir).Load(context.Background()); err != nil {
		t.Fatal(err)
	}
}

type gachaSnapshot struct {
	Coins         int64
	Items, Misses map[int64]int64
	Receipts      int
	Sequence      int64
}

func (f *gachaFixture) snapshot(t *testing.T) gachaSnapshot {
	out := gachaSnapshot{Items: map[int64]int64{}, Misses: map[int64]int64{}}
	f.local(t, func() {
		d := f.player.Dao()
		out.Coins = d.GetWallet().GetCoins()
		out.Receipts = d.GetGachaLedger().ReceiptsLen()
		out.Sequence = d.GetGachaLedger().GetNextSeq()
		d.GetBag().RangeItems(func(k, v int64) bool { out.Items[k] = v; return true })
		d.GetGacha().RangeMisses(func(k, v int64) bool { out.Misses[k] = v; return true })
	})
	return out
}
func (f *gachaFixture) draw(key string, pool, count int64) (*pb.GachaDrawResponse, error) {
	return sender.NewGachaDrawSender(f.engine).Sync_GachaDraw(context.Background(), f.player.ID(), &pb.GachaDrawRequest{Key: key, PoolID: pool, Count: count})
}
func (f *gachaFixture) mustDraw(t *testing.T, key string, pool, count int64) *pb.GachaDrawResponse {
	t.Helper()
	r, err := f.draw(key, pool, count)
	if err != nil {
		t.Fatal(err)
	}
	return r
}
func (f *gachaFixture) refuse(t *testing.T, want error, key string, pool, count int64) {
	t.Helper()
	before := f.snapshot(t)
	if _, err := f.draw(key, pool, count); !errors.Is(err, want) {
		t.Fatalf("refusal = %v, want %v", err, want)
	}
	if after := f.snapshot(t); !reflect.DeepEqual(before, after) {
		t.Fatalf("refusal wrote: before %+v after %+v", before, after)
	}
}
func (f *gachaFixture) grant(t *testing.T, id, count int64) {
	t.Helper()
	if _, err := sender.NewBagGrantSender(f.engine).Sync_BagGrant(context.Background(), f.player.ID(), id, count); err != nil {
		t.Fatal(err)
	}
}
func TestGachaSingleChargesAndGrants(t *testing.T) {
	f := newGachaFixture(t, 100)
	r := f.mustDraw(t, "one", 1, 1)
	if r.Cost != 10 || r.Balance != 90 || r.Misses != 1 || !reflect.DeepEqual(r.Items, []int64{1001}) {
		t.Fatalf("single result %+v", r)
	}
	s := f.snapshot(t)
	if s.Coins != 90 || s.Items[1001] != 1 || s.Receipts != 1 || s.Misses[1] != 1 {
		t.Fatalf("single facts %+v", s)
	}
}
func TestGachaTenAppliesPityInsideTheSameTransaction(t *testing.T) {
	f := newGachaFixture(t, 1000)
	r := f.mustDraw(t, "ten", 1, 10)
	want := []int64{1001, 1001, 1002, 1001, 1001, 1002, 1001, 1001, 1002, 1001}
	if r.Cost != 100 || r.Balance != 900 || r.Misses != 1 || !reflect.DeepEqual(r.Items, want) {
		t.Fatalf("ten result %+v", r)
	}
	s := f.snapshot(t)
	if s.Items[1001] != 7 || s.Items[1002] != 3 || s.Receipts != 1 {
		t.Fatalf("ten facts %+v", s)
	}
}
