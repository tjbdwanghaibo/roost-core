func TestGachaConcurrentDuplicateChargesOnce(t *testing.T) {
	f := newGachaFixture(t, 100)
	var wg sync.WaitGroup
	errs := make(chan error, 8)
	for range 8 {
		wg.Add(1)
		go func() { defer wg.Done(); _, err := f.draw("same", 1, 1); errs <- err }()
	}
	wg.Wait()
	close(errs)
	for err := range errs {
		if err != nil {
			t.Fatal(err)
		}
	}
	s := f.snapshot(t)
	if s.Coins != 90 || s.Items[1001] != 1 || s.Receipts != 1 {
		t.Fatalf("concurrent facts %+v", s)
	}
}

