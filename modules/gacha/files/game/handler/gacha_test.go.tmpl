func TestGachaProtocolBoundaryUsesSessionAndReturnsCodes(t *testing.T) {
	f := newGachaFixture(t, 100)
	reg := app.NewRegistry(viper.New())
	if err := reg.Register("nest", nest.Client(f.engine)); err != nil {
		t.Fatal(err)
	}
	ctl, err := controller.FromRegistry(reg)
	if err != nil {
		t.Fatal(err)
	}
	ctx := &playeraccess.Context{PlayerID: 98101}
	response, err := ctl.HandleGachaDraw(ctx, &pb.GachaDrawRequest{Key: "a", PoolID: 1, Count: 2})
	code, _ := errcode.ClientError(apperrors.ErrGachaCountInvalid)
	if err != nil || response == nil || response.Code != code {
		t.Fatalf("protocol refusal %+v %v", response, err)
	}
	response, err = ctl.HandleGachaDraw(ctx, &pb.GachaDrawRequest{Key: "a", PoolID: 1, Count: 1})
	if err != nil || response == nil || response.Code != 0 || response.Balance != 90 {
		t.Fatalf("protocol success %+v %v", response, err)
	}
}

