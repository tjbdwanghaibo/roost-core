func TestGachaCommitRejectionRollsBackThenRetries(t *testing.T) {
	f := newGachaFixture(t, 1000)
	before := f.snapshot(t)
	f.committer.reject.Store(true)
	if _, err := f.draw("a", 1, 10); err == nil {
		t.Fatal("commit accepted")
	}
	if !reflect.DeepEqual(before, f.snapshot(t)) {
		t.Fatal("rejected draw leaked facts")
	}
	f.committer.reject.Store(false)
	r := f.mustDraw(t, "a", 1, 10)
	if r.Balance != 900 || f.snapshot(t).Receipts != 1 {
		t.Fatal("retry did not apply exactly once")
	}
}
func TestGachaReceiptWindowEvictsOnlyTheOldest(t *testing.T) {
	f := newGachaFixture(t, 1000)
	for i := 1; i <= 65; i++ {
		f.mustDraw(t, fmt.Sprintf("k%d", i), 1, 1)
	}
	s := f.snapshot(t)
	if s.Receipts != 64 || s.Sequence != 65 || s.Coins != 350 {
		t.Fatalf("window %+v", s)
	}
	f.mustDraw(t, "k2", 1, 1)
	if !reflect.DeepEqual(s, f.snapshot(t)) {
		t.Fatal("retained key wrote")
	}
	f.mustDraw(t, "k1", 1, 1)
	if after := f.snapshot(t); after.Coins != 340 || after.Sequence != 66 || after.Receipts != 64 {
		t.Fatalf("eviction %+v", after)
	}
}
