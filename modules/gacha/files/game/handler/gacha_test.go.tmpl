func TestGachaReplayReturnsOriginalWithoutWrites(t *testing.T) {
	f := newGachaFixture(t, 100)
	first := f.mustDraw(t, "a", 1, 1)
	f.mustDraw(t, "b", 1, 1)
	before := f.snapshot(t)
	again := f.mustDraw(t, "a", 1, 1)
	if !reflect.DeepEqual(first, again) || !reflect.DeepEqual(before, f.snapshot(t)) {
		t.Fatal("replay changed result or state")
	}
}
