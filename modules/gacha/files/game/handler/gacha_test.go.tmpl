type gachaGetter map[int64]entity.IThreadSafeEntity

func (g gachaGetter) Get(_ context.Context, id int64, _ entity.EntityCategory) (entity.IThreadSafeEntity, error) {
	if e := g[id]; e != nil {
		return e, nil
	}
	return nil, fmt.Errorf("missing %d", id)
}
func (g gachaGetter) GetMany(ctx context.Context, ids []int64, cats []entity.EntityCategory) ([]entity.IThreadSafeEntity, error) {
	out := make([]entity.IThreadSafeEntity, len(ids))
	for i, id := range ids {
		e, err := g.Get(ctx, id, cats[i])
		if err != nil {
			return nil, err
		}
		out[i] = e
	}
	return out, nil
}

type gachaCommitter struct{ reject atomic.Bool }

func (c *gachaCommitter) Commit(context.Context, dataengine.CommitRecord) error {
	if c.reject.Load() {
		return errors.New("injected rejection")
	}
	return nil
}

type gachaFixture struct {
	engine    *nest.NestMgr
	player    *playerentity.Player
	committer *gachaCommitter
	now       atomic.Int64
}

func newGachaFixture(t *testing.T, coins int64) *gachaFixture {
	t.Helper()
	playerentity.RegisterEntity()
	RegisterGachaDrawNestHandlers()
	RegisterWalletGrantNestHandlers()
	RegisterBagGrantNestHandlers()
	gachaLoad(t, gachaPools(), gachaDrops())
	f := &gachaFixture{committer: &gachaCommitter{}}
	f.now.Store(time.Date(2026, 11, 12, 0, 0, 0, 0, time.UTC).UnixMilli())
	clock.SetSource(func() time.Time { return time.UnixMilli(f.now.Load()) })
	t.Cleanup(func() { clock.SetSource(nil) })
	id, err := entity.BuildEntityID(98101, playerentity.EntityKindPlayer)
	if err != nil {
		t.Fatal(err)
	}
	built, err := entity.BuildEntity(&entity.EntityCreateParam{IsCreate: true, Id: id, Kind: playerentity.EntityKindPlayer})
	if err != nil {
		t.Fatal(err)
	}
	f.player = built.(*playerentity.Player)
	f.engine = nest.NewEngine(nest.NestOptionWithGetter(gachaGetter{id: built}), nest.NestOptionWithTransactionCommitter(f.committer), nest.NestOptionWithWorkerPools(nest.WorkerPoolConfig{Workers: 2, QueueCap: 64}, nest.WorkerPoolConfig{}, nest.WorkerPoolConfig{}))
	f.engine.MustRegisterHandlerWithMeta(nest.NewHandlerName("gachaTestSetup"), func(_ []entity.IThreadSafeEntity, params []any, _ ...nest.HandlerOption) (any, error) {
		params[0].(func())()
		return nil, nil
	}, nest.HandlerMeta{Rollback: nest.RollbackUndo, Durability: nest.DurabilityStrict})
	// 服务端入口没有协议：场景经一个测试用的事务 handler 调组件，错误交还 Nest 回滚，与业务 handler 的用法一样。
	f.engine.MustRegisterHandlerWithMeta(nest.NewHandlerName("gachaTestComponent"), func(es []entity.IThreadSafeEntity, params []any, _ ...nest.HandlerOption) (any, error) {
		target := es[0].(*playerentity.Player).GachaComp()
		if params[3].(bool) {
			return target.DrawFree(params[0].(string), params[1].(int64))
		}
		return target.Draw(params[0].(string), params[1].(int64), params[2].(int64))
	}, nest.HandlerMeta{Rollback: nest.RollbackUndo, Durability: nest.DurabilityStrict})
	if err := f.engine.Start(); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := f.engine.Shutdown(context.Background()); err != nil {
			t.Error(err)
		}
	})
	if coins > 0 {
		if _, err := sender.NewWalletGrantSender(f.engine).Sync_WalletGrant(context.Background(), id, "gacha-seed", coins); err != nil {
			t.Fatal(err)
		}
	}
	return f
}

// local 只在业务 worker 持实体锁读写夹具前置状态，场景的动作仍走正式生成 Sender。
func (f *gachaFixture) local(t *testing.T, fn func()) {
	t.Helper()
	if err := f.engine.RunLocal(context.Background(), func() { f.player.GetMutex().Lock(); defer f.player.GetMutex().Unlock(); fn() }); err != nil {
		t.Fatal(err)
	}
}

