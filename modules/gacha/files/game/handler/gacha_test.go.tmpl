	f := newGachaFixture(t, 100)
	if _, err := sender.NewGachaDrawSender(f.engine).Sync_GachaDraw(context.Background(), f.player.ID(), nil); !errors.Is(err, apperrors.ErrGachaKeyInvalid) {
