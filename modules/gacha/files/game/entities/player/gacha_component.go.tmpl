package player

import (
	"{{MODULE}}/game/components/gacha"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:Gacha}}
const CompTypeGacha entity.ComponentType = {{ID:component:Gacha}}

// GachaComponent 是 game/components/gacha 的组件在 Player 上的名字（生成接线与 handler 用它）；业务在那个包里。
type GachaComponent = gacha.Component

type IGachaEntity interface {
	entity.IThreadSafeEntity
	GachaComp() *GachaComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeGacha, gacha.NewComponent)
}
