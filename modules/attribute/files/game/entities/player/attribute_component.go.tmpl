package player

import (
	db "{{MODULE}}/db"
	"{{MODULE}}/game/components/attribute"
	gameattr "{{MODULE}}/game/gameplay/attribute"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:Attribute}}
const CompTypeAttribute entity.ComponentType = {{ID:component:Attribute}}

// AttributeComponent 是共用属性组件 attribute.Component 的类型别名，只为 Player 的生成接线命名。
// 分层与成长全部在 game/components/attribute；这里只把 PlayerDao 的三层、档案等级与装备层来源交给它，
// 并把档案升级接到 LevelUp。
type AttributeComponent = attribute.Component
type IAttributeEntity interface {
	entity.IThreadSafeEntity
	AttributeComp() *AttributeComponent
}

// Gear 是装备层在 Container 里的选择器，见 attribute.Gear。
var Gear = attribute.Gear

func init() {
	entity.RegisterComponentFactory(CompTypeAttribute, attribute.NewComponent)
	OnProfileLevelUp("attribute", func(c *ProfileComponent, from, to int32) error { return c.Owner().AttributeComp().LevelUp(to - from) })
}

// 下面的方法实现 attribute.Owner 与可选的装备层来源；只在 Player 被 Nest 锁住期间（或装载时）调用。

func (e *Player) AttributeBase() *db.AttributeValues  { return e.Dao().GetAttributeBase() }
func (e *Player) AttributeGear() *db.AttributeValues  { return e.Dao().GetAttributeGear() }
func (e *Player) AttributeFinal() *db.AttributeValues { return e.Dao().GetAttributeFinal() }

// AttributeLevel 是档案等级：基础层没有记录时按它派生。
func (e *Player) AttributeLevel() int32 { return e.ProfileComp().Level() }

// CollectAttributeGear 汇总 OnAttributeGear 登记的装备层来源（attribute_gear.go）。
func (e *Player) CollectAttributeGear() (*gameattr.Combat, error) { return attributeGear(e) }
