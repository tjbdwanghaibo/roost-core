package player

import (
	"fmt"
	"math"
	"sort"
	"sync"

	gameattr "{{MODULE}}/game/gameplay/attribute"
	apperrors "{{MODULE}}/internal/errors"
)

// AttributeGearHook 是可选模块的装备层来源；只读同一 Player。登记仅启动期，失败阻止刷新和关联业务提交。
type AttributeGearHook func(*Player) (*gameattr.Combat, error)

var attributeGearMu sync.RWMutex
var attributeGearHooks = map[string]AttributeGearHook{}

func OnAttributeGear(name string, hook AttributeGearHook) {
	if name == "" || hook == nil {
		panic("attribute: gear source needs name and function")
	}
	attributeGearMu.Lock()
	defer attributeGearMu.Unlock()
	if _, ok := attributeGearHooks[name]; ok {
		panic(fmt.Sprintf("attribute: duplicate gear source %q", name))
	}
	attributeGearHooks[name] = hook
}
func attributeGear(owner *Player) (*gameattr.Combat, error) {
	attributeGearMu.RLock()
	names := make([]string, 0, len(attributeGearHooks))
	for n := range attributeGearHooks {
		names = append(names, n)
	}
	sort.Strings(names)
	hooks := make([]AttributeGearHook, len(names))
	for i, n := range names {
		hooks[i] = attributeGearHooks[n]
	}
	attributeGearMu.RUnlock()
	out := &gameattr.Combat{}
	for _, hook := range hooks {
		p, err := hook(owner)
		if err != nil {
			return nil, err
		}
		if !attributeSafe(p) || out.HP > math.MaxInt64/4-p.HP || out.Attack > math.MaxInt64/4-p.Attack {
			return nil, apperrors.ErrAttributeOverflow
		}
		out.SetHP(out.HP + p.HP)
		out.SetAttack(out.Attack + p.Attack)
	}
	out.Update()
	return out, nil
}
