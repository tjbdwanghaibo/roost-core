func TestAttributeReloadRebuildsDerivedLayersWithoutBaseWrite(t *testing.T) {
	f := newAttributeFixture(t)
	if _, err := f.exp(100); err != nil {
		t.Fatal(err)
	}
	f.write(t, func() { f.player.Dao().GetAttributeFinal().SetValues(nil) })
	before := f.snapshot(t).Base
	f.local(t, func() {
		if err := f.player.AttributeComp().OnInitFinish(nil, false); err != nil {
			t.Fatal(err)
		}
	})
	if r := f.get(t); r.HP != 110 || r.Power != 35 {
		t.Fatalf("reload %+v", r)
	}
	if !reflect.DeepEqual(before, f.snapshot(t).Base) {
		t.Fatal("reload persisted")
	}
}
