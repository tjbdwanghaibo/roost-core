package attribute

// Combat 是工程自己的属性 profile：字段、属性名和公式由业务维护，ID/掩码/Setter/Update 由正式生成器产出。
//
//roost:attribute index=1 max=64
type Combat struct {
	// HP 与 Attack 只由业务设置，升级增加基础值。
	HP     int64 `attr:"hp"`
	Attack int64 `attr:"attack"`
	// Power 由公式推导，SetDirectAttr 拒绝直接写入。
	Power int64 `attr:"power"`

	// dirtyMask 是生成器要求的脏位字段。
	dirtyMask uint64
}

// _Power 的下划线标记推导公式，参数名标记依赖；合并各层直接属性后只运行一次。
func (c *Combat) _Power(Attack int64, HP int64) int64 {
	return Attack*2 + HP/10
}

// LevelUp 批量增加基础值。调用组件先做溢出校验；不按等级循环占住业务 worker。
func (c *Combat) LevelUp(levels int32) uint64 {
	if c == nil || levels <= 0 {
		return 0
	}
	before := c.DirtyMask()
	c.SetHP(c.HP + int64(levels)*10)
	c.SetAttack(c.Attack + int64(levels)*2)
	c.Update()
	return c.DirtyMask() &^ before
}

// ForLevel 给尚无持久基础记录的玩家生成默认值。
func ForLevel(level int32) *Combat {
	profile := &Combat{}
	profile.SetHP(100 + int64(level)*10)
	profile.SetAttack(10 + int64(level)*2)
	profile.Update()
	return profile
}
