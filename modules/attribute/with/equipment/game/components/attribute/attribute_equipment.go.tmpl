package attribute

import (
	"{{MODULE}}/game/event"
	rules "{{MODULE}}/game/modules/equipment"
	gameattr "{{MODULE}}/game/modules/gameplay/attribute"
	"{{MODULE}}/game/view"
	apperrors "{{MODULE}}/internal/errors"
)

// 仅安装 attribute 与 equipment 时生成。装备层来源（OnAttributeGear，扩展提供方，保留登记方式）在加载重建与穿脱时
// 共用同一规则，不保留组件外可变缓存；穿脱后的重算是下面组件上的事件监听。
func init() {
	OnAttributeGear("equipment", func(owner view.PlayerEntity) (*gameattr.Combat, error) {
		p := &gameattr.Combat{}
		var invalid bool
		owner.Equipment().RangeWorn(func(_ int32, itemID int64, level int32) bool {
			_, attack, hp, ok := rules.Lookup(itemID)
			if !ok {
				return true
			} // 已移除的规则不再提供属性，但穿戴事实保留，迁移由工程负责。
			if level < 1 || level > rules.MaxLevel {
				invalid = true
				return false
			}
			p.SetAttack(p.Attack + attack*int64(level))
			p.SetHP(p.HP + hp*int64(level))
			return true
		})
		if invalid {
			return nil, apperrors.ErrEquipmentLevelInvalid
		}
		p.Update()
		return p, nil
	})
}

// OnEquipmentChanged 在穿脱装备的同一笔事务里重算装备层与最终属性；返回错误时穿戴、背包与属性一起回滚。
//
// 缺省优先级：改成事件之前 equipment 的变化钩子只有 attribute 一个模块登记，没有别的模块监听需要排序。
//
//roost:listen
func (c *Component) OnEquipmentChanged(ev event.EquipmentChanged) error {
	return c.RefreshGear()
}
