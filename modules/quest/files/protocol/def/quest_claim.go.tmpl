//go:build protocoldef

package protocoldef

// QuestClaim 领取一个已完成的每日任务今天的奖励；金币在同一笔事务里到账，每个任务每个业务日只能领一次。
//
// 任务的当日记录不在这条协议里，经玩家自身视图同步（PlayerDao.Quest：Day、Progress、Claimed）。
// 客户端显示与判断“能不能领”之前必须比对 Day：服务端只在新的一天第一次推进任务时才清零，
// 跨天之后、第一次推进之前，客户端手里仍是上一个业务日的记录。Day 不等于当前业务日时，
// 按“今天全部任务进度为 0、都没领”显示；此时对昨天做完没领的任务发这条请求会被拒绝（quest_incomplete）。
// 当前业务日由客户端按服务器时间与部署的业务时区、每日重置时刻（time.business_timezone /
// time.business_day_start）推算。
type QuestClaimRequest struct {
	// QuestID 是任务表里的任务号。
	QuestID int64 `pb:"1"`
}

// QuestClaimResponse 的 Code 非 0 时是拒绝：任务号不存在（quest_unknown）、今天还没做完（quest_incomplete）、
// 今天已经领过（quest_claimed），或发奖被货币模块拒绝（wallet_overflow）。拒绝时什么都没有改。
type QuestClaimResponse struct {
	Code   int32  `pb:"1"`
	Reason string `pb:"2"`
	// QuestID 是领到奖的任务号，Reward 是这次到账的金币数，Balance 是到账后的余额。
	QuestID int64 `pb:"3"`
	Reward  int64 `pb:"4"`
	Balance int64 `pb:"5"`
}

//roost:protocol group=game handler=quest
type QuestClaimProtocol interface {
	//roost:msg id={{ID:protocol:QuestClaim}}
	QuestClaim(QuestClaimRequest) QuestClaimResponse
}
