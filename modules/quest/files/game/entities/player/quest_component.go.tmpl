package player

import (
	"fmt"
	"time"

	db "{{MODULE}}/db"
	apperrors "{{MODULE}}/internal/errors"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/infra/base/clock"
)

//roost:component type={{ID:component:Quest}}
const CompTypeQuest entity.ComponentType = {{ID:component:Quest}}

// QuestComponent 是每日任务的业务逻辑。它不保存事务会改的状态：当日记录在 PlayerDao.Quest 里，
// 经生成的 setter 修改，所以回滚只有 DAO 一处；不要在这里登记 undo。
type QuestComponent struct {
	entity.ComponentBase
	owner *Player
}

// IQuestEntity 是 Nest handler 用这个组件时的窄实体接口；getter 由生成的 Entity 接线实现。
// 别的功能在自己的 handler 里要推进任务时，目标接口里嵌入它即可（同一个实体、同一笔事务）。
type IQuestEntity interface {
	entity.IThreadSafeEntity
	QuestComp() *QuestComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeQuest, func(owner any, _ *entity.EntityCreateParam) (entity.ComponentInterfaceBase, error) {
		typed, ok := owner.(*Player)
		if !ok {
			return nil, fmt.Errorf("quest component: owner %T is not *Player", owner)
		}
		return &QuestComponent{owner: typed}, nil
	})
}

func (component *QuestComponent) Name() string { return "quest" }

// Owner 只在实体存活且被 Nest 锁住期间可用。
func (component *QuestComponent) Owner() *Player { return component.owner }

// 下面是业务方法。不要在组件里加锁：Nest 锁住所属实体之后才进入业务 handler。

// QuestClaimResult 是一次领奖的结果。
type QuestClaimResult struct {
	Reward  int64
	Balance int64
}

// Advance 把任务 questID 的当日进度推进 n 次，返回推进后的进度。nowUnixMilli 是这条消息冻结的业务时间
// （handler 的最后一个参数，原样传进来；不要自己取墙上时间）。
//
// 它是给服务端别的功能调的：同一个实体上的组件在自己的业务方法里调
// component.owner.QuestComp().Advance(QuestDailyCheckin, 1, nowUnixMilli)，进度与那个功能的写入
// 在同一笔事务里提交或回滚。不在 Player 事务里的调用方走 Nest handler QuestAdvance。
//
//   - 先清零再推进：这是新的一个业务日的第一次推进时，先清空上一个业务日的进度与领奖记录。
//   - 进度封顶在任务表里的目标次数；已经完成（包括已经领过奖）的任务再推进什么都不写，也不报错，
//     所以调用方不用先查“做完没有”。
//   - 任务号不在任务表里（quest_unknown）、n 不为正（quest_count_invalid）时拒绝，拒绝前不写任何字段。
//     调用方不想让自己的业务因此失败时可以丢掉这个错误：组件在拒绝之前什么都没改。
//
// 它不判重，调一次推进一次。“这件事算过没有”由调用方保证：通常调用方那一次业务本身只会成功一次
// （签到一天一次、一笔消费一个业务键），跟着它在同一笔事务里推进即可。
func (component *QuestComponent) Advance(questID, n, nowUnixMilli int64) (int64, error) {
	definition, ok := questDefinition(questID)
	if !ok {
		return 0, apperrors.ErrQuestUnknown
	}
	if n <= 0 {
		return 0, apperrors.ErrQuestCountInvalid
	}
	state := component.owner.Dao().GetQuest()
	questRollOver(state, questToday(nowUnixMilli))
	progress, _ := state.GetProgress(questID)
	if progress >= definition.Target {
		return progress, nil
	}
	// 用减法比较：progress + n 在 n 接近 int64 上限时会溢出成负数，绕过封顶。
	if n >= definition.Target-progress {
		progress = definition.Target
	} else {
		progress += n
	}
	state.SetProgressKey(questID, progress)
	return progress, nil
}

// Claim 领取任务 questID 今天的奖励。nowUnixMilli 是这条消息冻结的业务时间。
//
// 拒绝时不写任何字段：任务号不在任务表里（quest_unknown）、今天已经领过（quest_claimed）、
// 今天还没做完（quest_incomplete）。记录还停在更早的业务日时，今天的进度就是零：昨天做完没领的，
// 今天不能补领，这里也不替它清零（清零只发生在推进时）。
//
// “今天领过没有”记在任务自己的状态里（Claimed），所以发奖用货币组件的 Add、不占货币的去重窗口；
// 领奖记录与余额在同一笔事务里，任何一步被拒绝（例如余额溢出）都一起回滚。先发钱、后记领奖：
// 发钱被拒时这里还什么都没写。
func (component *QuestComponent) Claim(questID, nowUnixMilli int64) (QuestClaimResult, error) {
	definition, ok := questDefinition(questID)
	if !ok {
		return QuestClaimResult{}, apperrors.ErrQuestUnknown
	}
	state := component.owner.Dao().GetQuest()
	if questToday(nowUnixMilli) > state.GetDay() {
		return QuestClaimResult{}, apperrors.ErrQuestIncomplete
	}
	if claimed, _ := state.GetClaimed(questID); claimed {
		return QuestClaimResult{}, apperrors.ErrQuestClaimed
	}
	if progress, _ := state.GetProgress(questID); progress < definition.Target {
		return QuestClaimResult{}, apperrors.ErrQuestIncomplete
	}
	balance, err := component.owner.WalletComp().Add(definition.Reward)
	if err != nil {
		return QuestClaimResult{}, err
	}
	state.SetClaimedKey(questID, true)
	return QuestClaimResult{Reward: definition.Reward, Balance: balance}, nil
}

// questToday 把业务时间换成业务日（YYYYMMDD）。业务时区与每日重置时刻由部署配置决定，缺省 UTC 零点；
// 不要用毫秒数除以一天自己算。
func questToday(nowUnixMilli int64) int64 {
	return int64(clock.BusinessDay(time.UnixMilli(nowUnixMilli)))
}

// questRollOver 是惰性清零：today 比记录所属的业务日新时，清空进度与领奖记录并把记录改到 today。
//
// 只在 today 更新时才清，不是“不相等就清”：业务时间倒退（运维把时钟拨回、改了业务时区）时记录留在
// 较新的那一天继续用。否则倒退回去能再领一遍，时间走回来又领一遍。
func questRollOver(state *db.QuestState, today int64) {
	if today <= state.GetDay() {
		return
	}
	state.SetDay(today)
	state.SetProgress(nil)
	state.SetClaimed(nil)
}
