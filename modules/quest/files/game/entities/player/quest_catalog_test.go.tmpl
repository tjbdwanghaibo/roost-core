package player

import "testing"

// 任务表里的每一条都要能用：目标次数与奖励为正。工程改了任务表之后这条用例替它把关；
// 任务表换成配置表之后，把这里换成检查自己的表（或删掉，改由配置校验保证）。
func TestQuestCatalogEntriesAreUsable(t *testing.T) {
	if len(questCatalog) == 0 {
		t.Fatal("the quest catalog is empty")
	}
	for questID := range questCatalog {
		if questID <= 0 {
			t.Errorf("quest %d: the quest id must be positive", questID)
		}
		if _, ok := questDefinition(questID); !ok {
			t.Errorf("quest %d: target and reward must be positive, got %+v", questID, questCatalog[questID])
		}
	}
}

// 填错的行按“没有这条任务”处理：目标次数不为正的任务不用做就能领，奖励不为正的任务领不到东西。
func TestQuestCatalogRefusesUnusableEntries(t *testing.T) {
	const zeroTarget, negativeTarget, zeroReward, negativeReward, fine = 9001, 9002, 9003, 9004, 9005
	questCatalog[zeroTarget] = QuestDefinition{Target: 0, Reward: 5}
	questCatalog[negativeTarget] = QuestDefinition{Target: -1, Reward: 5}
	questCatalog[zeroReward] = QuestDefinition{Target: 2, Reward: 0}
	questCatalog[negativeReward] = QuestDefinition{Target: 2, Reward: -5}
	questCatalog[fine] = QuestDefinition{Target: 2, Reward: 5}
	t.Cleanup(func() {
		for _, questID := range []int64{zeroTarget, negativeTarget, zeroReward, negativeReward, fine} {
			delete(questCatalog, questID)
		}
	})
	for _, questID := range []int64{zeroTarget, negativeTarget, zeroReward, negativeReward} {
		if definition, ok := questDefinition(questID); ok {
			t.Errorf("quest %d: an unusable entry %+v was accepted", questID, definition)
		}
	}
	if definition, ok := questDefinition(fine); !ok || definition.Target != 2 || definition.Reward != 5 {
		t.Errorf("a usable entry was refused or changed: %+v, %v", definition, ok)
	}
	if _, ok := questDefinition(9999); ok {
		t.Error("a quest id that is not in the catalog was accepted")
	}
}
