// 样例任务表里的数在这里写死，不引用被测代码的常量与任务表：表改错了这些用例要变红。
// 工程把任务表换成自己的之后，按自己的表改这几个数。
const (
	questTestCheckin = 1 // 做 1 次，奖 20
	questTestSpend   = 2 // 做 3 次，奖 30
	questTestBattle  = 3 // 做 10 次，奖 100
	questTestUnknown = 999
)

// 测试替身自己带一份，不借用别的模块的测试文件：那些文件归工程所有，可能被改。
type questGetter map[int64]entity.IThreadSafeEntity

func (g questGetter) Get(_ context.Context, id int64, _ entity.EntityCategory) (entity.IThreadSafeEntity, error) {
	if e := g[id]; e != nil {
		return e, nil
	}
	return nil, fmt.Errorf("missing %d", id)
}

func (g questGetter) GetMany(ctx context.Context, ids []int64, cats []entity.EntityCategory) ([]entity.IThreadSafeEntity, error) {
	out := make([]entity.IThreadSafeEntity, len(ids))
	for i, id := range ids {
		e, err := g.Get(ctx, id, cats[i])
		if err != nil {
			return nil, err
		}
		out[i] = e
	}
	return out, nil
}

// questCommitter 是替身提交器：不落盘，reject 打开时拒绝提交，用来验证回滚；commits 数提交成功的次数。
// 没有任何写入的请求不会走到提交器，所以“这次请求零写入”就是 commits 没有变。
type questCommitter struct {
	reject  atomic.Bool
	commits atomic.Int64
}

func (c *questCommitter) Commit(context.Context, dataengine.CommitRecord) error {
	if c.reject.Load() {
		return errors.New("injected rejection")
	}
	c.commits.Add(1)
	return nil
}

type questFixture struct {
	engine    *nest.NestMgr
	player    *playerentity.Player
	claimTo   *sender.QuestClaimSender
	advanceTo *sender.QuestAdvanceSender
	committer *questCommitter
	now       atomic.Int64
}

// newQuestFixture 用替身提交器起一个 Nest，业务时钟由用例拨：任务按业务日切分（缺省是 UTC 零点）。
// clock.SetSource 是进程级的：一个用例里只建一个 fixture，后建的会顶掉前一个的时钟。
func newQuestFixture(t *testing.T) *questFixture {
	t.Helper()
	playerentity.RegisterEntity()
	RegisterQuestClaimNestHandlers()
	RegisterQuestAdvanceNestHandlers()
	f := &questFixture{committer: &questCommitter{}}
	f.now.Store(time.Date(2026, 11, 10, 9, 0, 0, 0, time.UTC).UnixMilli())
	clock.SetSource(func() time.Time { return time.UnixMilli(f.now.Load()) })
	t.Cleanup(func() { clock.SetSource(nil) })
	id, err := entity.BuildEntityID(96001, playerentity.EntityKindPlayer)
	if err != nil {
		t.Fatal(err)
	}
	built, err := entity.BuildEntity(&entity.EntityCreateParam{IsCreate: true, Id: id, Kind: playerentity.EntityKindPlayer})
	if err != nil {
		t.Fatal(err)
	}
	f.player = built.(*playerentity.Player)
	f.engine = nest.NewEngine(nest.NestOptionWithGetter(questGetter{id: built}), nest.NestOptionWithTransactionCommitter(f.committer),
		nest.NestOptionWithWorkerPools(nest.WorkerPoolConfig{Workers: 2, QueueCap: 64}, nest.WorkerPoolConfig{}, nest.WorkerPoolConfig{}))
	if err := f.engine.Start(); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := f.engine.Shutdown(context.Background()); err != nil {
			t.Error(err)
		}
	})
	f.claimTo = sender.NewQuestClaimSender(f.engine)
	f.advanceTo = sender.NewQuestAdvanceSender(f.engine)
	return f
}

// setClock 把业务时间拨到一个确定的时刻；pass 往后拨一段。
func (f *questFixture) setClock(at time.Time) { f.now.Store(at.UnixMilli()) }
func (f *questFixture) pass(d time.Duration)  { f.now.Add(int64(d / time.Millisecond)) }

// advance 走服务端推进的 handler，返回推进后的进度。
func (f *questFixture) advance(questID, n int64) (int64, error) {
	return f.advanceTo.Sync_QuestAdvance(context.Background(), f.player.ID(), questID, n)
}

func (f *questFixture) mustAdvance(t *testing.T, questID, n, want int64) {
	t.Helper()
	got, err := f.advance(questID, n)
	if err != nil {
		t.Fatalf("advance quest %d by %d: %v", questID, n, err)
	}
	if got != want {
		t.Fatalf("advance quest %d by %d: progress = %d, want %d", questID, n, got, want)
	}
}

// claim 走客户端协议对应的 handler。
func (f *questFixture) claim(questID int64) (*pb.QuestClaimResponse, error) {
	return f.claimTo.Sync_QuestClaim(context.Background(), f.player.ID(), &pb.QuestClaimRequest{QuestID: questID})
}

func (f *questFixture) mustClaim(t *testing.T, questID, wantReward, wantBalance int64) {
	t.Helper()
	response, err := f.claim(questID)
	if err != nil {
		t.Fatalf("claim quest %d: %v", questID, err)
	}
	if response.QuestID != questID || response.Reward != wantReward || response.Balance != wantBalance {
		t.Fatalf("claim quest %d: response = %+v, want reward %d and balance %d", questID, response, wantReward, wantBalance)
	}
}

// locked 在业务 worker 上持实体锁执行 body。
func (f *questFixture) locked(t *testing.T, body func()) {
	t.Helper()
	if err := f.engine.RunLocal(context.Background(), func() {
		f.player.GetMutex().Lock()
		defer f.player.GetMutex().Unlock()
		body()
	}); err != nil {
		t.Fatal(err)
	}
}

// questFacts 是每日任务模块自己的全部事实：当日记录、余额、货币回执数与成功提交的次数。
type questFacts struct {
	day      int64
	progress map[int64]int64
	claimed  map[int64]bool
	coins    int64
	receipts int
	commits  int64
}

func (facts questFacts) String() string {
	// fmt 按键的顺序打印 map，空 map 与 nil 打印出来一样，所以字符串相等就是事实相等。
	return fmt.Sprintf("day=%d progress=%v claimed=%v coins=%d wallet-receipts=%d commits=%d",
		facts.day, facts.progress, facts.claimed, facts.coins, facts.receipts, facts.commits)
}

func (f *questFixture) facts(t *testing.T) questFacts {
	t.Helper()
	got := questFacts{progress: map[int64]int64{}, claimed: map[int64]bool{}}
	f.locked(t, func() {
		state := f.player.Dao().GetQuest()
		got.day = state.GetDay()
		state.RangeProgress(func(questID, progress int64) bool {
			got.progress[questID] = progress
			return true
		})
		state.RangeClaimed(func(questID int64, claimed bool) bool {
			got.claimed[questID] = claimed
			return true
		})
		got.coins = f.player.Dao().GetWallet().GetCoins()
		got.receipts = f.player.Dao().GetWalletLedger().ReceiptsLen()
	})
	got.commits = f.committer.commits.Load()
	return got
}

// want 断言事实恰好是 want：多一个键、少一个键、数不同都算错。
func (f *questFixture) want(t *testing.T, when string, want questFacts) {
	t.Helper()
	if got := f.facts(t); got.String() != want.String() {
		t.Fatalf("%s:\n got  %v\n want %v", when, got, want)
	}
}

func TestQuestAdvanceAccumulatesAndCapsAtTheTarget(t *testing.T) {
	f := newQuestFixture(t)
	f.mustAdvance(t, questTestSpend, 2, 2)
	f.want(t, "after two of three", questFacts{day: 20261110, progress: map[int64]int64{2: 2}, commits: 1})
	// 多推进的部分不算：进度封顶在目标次数 3。
	f.mustAdvance(t, questTestSpend, 5, 3)
	f.mustAdvance(t, questTestBattle, 4, 4)
	// 一次推进的次数再大也只是封顶，不会溢出成负数绕过去。
	f.mustAdvance(t, questTestBattle, math.MaxInt64, 10)
	f.want(t, "after capping", questFacts{day: 20261110, progress: map[int64]int64{2: 3, 3: 10}, commits: 4})
}

// 已完成、已领奖的任务再推进是无害的空操作：不报错、返回原进度、没有提交。
func TestQuestAdvanceOnAFinishedOrClaimedQuestWritesNothing(t *testing.T) {
	f := newQuestFixture(t)
	f.mustAdvance(t, questTestCheckin, 1, 1)
	f.mustAdvance(t, questTestCheckin, 1, 1)
	f.want(t, "advancing a finished quest", questFacts{day: 20261110, progress: map[int64]int64{1: 1}, commits: 1})
	f.mustClaim(t, questTestCheckin, 20, 20)
	f.mustAdvance(t, questTestCheckin, 7, 1)
	f.want(t, "advancing a claimed quest", questFacts{day: 20261110, progress: map[int64]int64{1: 1}, claimed: map[int64]bool{1: true}, coins: 20, commits: 2})
}

func TestQuestAdvanceRefusalsWriteNothing(t *testing.T) {
	f := newQuestFixture(t)
	for _, questID := range []int64{questTestUnknown, 0, -1} {
		if _, err := f.advance(questID, 1); !errors.Is(err, apperrors.ErrQuestUnknown) {
			t.Fatalf("advance quest %d: err = %v, want quest_unknown", questID, err)
		}
	}
	for _, n := range []int64{0, -1, math.MinInt64} {
		if _, err := f.advance(questTestSpend, n); !errors.Is(err, apperrors.ErrQuestCountInvalid) {
			t.Fatalf("advance by %d: err = %v, want quest_count_invalid", n, err)
		}
	}
	f.want(t, "refusals on a fresh player", questFacts{})
	// 被拒绝的推进也不触发清零：跨天之后记录仍是昨天的。
	f.mustAdvance(t, questTestSpend, 2, 2)
	f.pass(24 * time.Hour)
	if _, err := f.advance(questTestUnknown, 1); !errors.Is(err, apperrors.ErrQuestUnknown) {
		t.Fatalf("err = %v, want quest_unknown", err)
	}
	if _, err := f.advance(questTestSpend, 0); !errors.Is(err, apperrors.ErrQuestCountInvalid) {
		t.Fatalf("err = %v, want quest_count_invalid", err)
	}
	f.want(t, "refusals on the next day", questFacts{day: 20261110, progress: map[int64]int64{2: 2}, commits: 1})
}

func TestQuestClaimPaysTheRewardIntoTheWallet(t *testing.T) {
	f := newQuestFixture(t)
	f.mustAdvance(t, questTestSpend, 3, 3)
	f.mustClaim(t, questTestSpend, 30, 30)
	f.mustAdvance(t, questTestCheckin, 1, 1)
	f.mustClaim(t, questTestCheckin, 20, 50)
	// 发奖不占货币的去重窗口：领没领过记在任务自己的状态里。
	f.want(t, "after two claims", questFacts{day: 20261110, progress: map[int64]int64{1: 1, 2: 3}, claimed: map[int64]bool{1: true, 2: true}, coins: 50, commits: 4})
}

func TestQuestClaimTwiceOnTheSameDayWritesNothing(t *testing.T) {
	f := newQuestFixture(t)
	f.mustAdvance(t, questTestSpend, 3, 3)
	f.mustClaim(t, questTestSpend, 30, 30)
	f.pass(3 * time.Hour) // 同一个业务日
	for attempt := 0; attempt < 2; attempt++ {
		if _, err := f.claim(questTestSpend); !errors.Is(err, apperrors.ErrQuestClaimed) {
			t.Fatalf("attempt %d: err = %v, want quest_claimed", attempt, err)
		}
	}
	f.want(t, "after repeated claims", questFacts{day: 20261110, progress: map[int64]int64{2: 3}, claimed: map[int64]bool{2: true}, coins: 30, commits: 2})
}

func TestQuestClaimUnfinishedWritesNothing(t *testing.T) {
	f := newQuestFixture(t)
	// 从未推进过任何任务。
	if _, err := f.claim(questTestSpend); !errors.Is(err, apperrors.ErrQuestIncomplete) {
		t.Fatalf("err = %v, want quest_incomplete", err)
	}
	f.want(t, "claim on a fresh player", questFacts{})
	// 差一次没做完；别的任务做完了也不能替它领。
	f.mustAdvance(t, questTestSpend, 2, 2)
	f.mustAdvance(t, questTestCheckin, 1, 1)
	if _, err := f.claim(questTestSpend); !errors.Is(err, apperrors.ErrQuestIncomplete) {
		t.Fatalf("err = %v, want quest_incomplete", err)
	}
	if _, err := f.claim(questTestBattle); !errors.Is(err, apperrors.ErrQuestIncomplete) {
		t.Fatalf("err = %v, want quest_incomplete", err)
	}
	f.want(t, "claim one short of the target", questFacts{day: 20261110, progress: map[int64]int64{1: 1, 2: 2}, commits: 2})
}

func TestQuestClaimUnknownQuestWritesNothing(t *testing.T) {
	f := newQuestFixture(t)
	f.mustAdvance(t, questTestCheckin, 1, 1)
	for _, questID := range []int64{questTestUnknown, 0, -1} {
		if _, err := f.claim(questID); !errors.Is(err, apperrors.ErrQuestUnknown) {
			t.Fatalf("claim quest %d: err = %v, want quest_unknown", questID, err)
		}
	}
	f.want(t, "after unknown claims", questFacts{day: 20261110, progress: map[int64]int64{1: 1}, commits: 1})
}

// 发奖被货币模块拒绝（余额放不下）时领奖记录也不写：之后腾出余额还能领。
func TestQuestClaimRefusedByTheWalletWritesNothing(t *testing.T) {
	f := newQuestFixture(t)
	RegisterWalletGrantNestHandlers()
	RegisterWalletSpendNestHandlers()
	if _, err := sender.NewWalletGrantSender(f.engine).Sync_WalletGrant(context.Background(), f.player.ID(), "fill", math.MaxInt64-10); err != nil {
		t.Fatal(err)
	}
	f.mustAdvance(t, questTestCheckin, 1, 1)
	if _, err := f.claim(questTestCheckin); !errors.Is(err, apperrors.ErrWalletOverflow) {
		t.Fatalf("err = %v, want wallet_overflow", err)
	}
	f.want(t, "after the wallet refused", questFacts{day: 20261110, progress: map[int64]int64{1: 1}, coins: math.MaxInt64 - 10, receipts: 1, commits: 2})
	if _, err := sender.NewWalletSpendSender(f.engine).Sync_WalletSpend(context.Background(), f.player.ID(), &pb.WalletSpendRequest{Key: "room", Amount: 1000}); err != nil {
		t.Fatal(err)
	}
	f.mustClaim(t, questTestCheckin, 20, math.MaxInt64-10-1000+20)
}

// 惰性清零发生在只推进、不领奖的路径上：新的一天第一次推进先清空昨天的进度与领奖记录，再记这一次。
func TestQuestNewDayClearsProgressAndClaimsBeforeAdvancing(t *testing.T) {
	f := newQuestFixture(t)
	f.setClock(time.Date(2026, 11, 10, 23, 59, 59, 999_000_000, time.UTC)) // 业务日的最后一毫秒
	f.mustAdvance(t, questTestCheckin, 1, 1)
	f.mustClaim(t, questTestCheckin, 20, 20)
	f.mustAdvance(t, questTestSpend, 2, 2)
	f.mustAdvance(t, questTestBattle, 4, 4)
	f.want(t, "end of day one", questFacts{day: 20261110, progress: map[int64]int64{1: 1, 2: 2, 3: 4}, claimed: map[int64]bool{1: true}, coins: 20, commits: 4})

	f.pass(time.Millisecond) // 下一个业务日的第一毫秒
	// 昨天的 2 次不带过来：今天从 0 起推进 1 次；别的任务的进度和领奖记录一起清掉，钱不动。
	f.mustAdvance(t, questTestSpend, 1, 1)
	f.want(t, "first advance of day two", questFacts{day: 20261111, progress: map[int64]int64{2: 1}, coins: 20, commits: 5})
	// 昨天领过的任务今天做完可以再领一次。
	f.mustAdvance(t, questTestCheckin, 1, 1)
	f.mustClaim(t, questTestCheckin, 20, 40)
	f.want(t, "claim on day two", questFacts{day: 20261111, progress: map[int64]int64{1: 1, 2: 1}, claimed: map[int64]bool{1: true}, coins: 40, commits: 7})
}

// 昨天做完没领的今天不能补领。被拒的领取不清零：跨天后没有新的推进时，记录（也就是客户端经同步
// 看到的）仍是昨天的，Day 还是昨天——客户端靠比对 Day 知道这份记录已经过期。
func TestQuestFinishedYesterdayCannotBeClaimedToday(t *testing.T) {
	f := newQuestFixture(t)
	f.mustAdvance(t, questTestSpend, 3, 3)
	f.pass(24 * time.Hour)
	if _, err := f.claim(questTestSpend); !errors.Is(err, apperrors.ErrQuestIncomplete) {
		t.Fatalf("err = %v, want quest_incomplete", err)
	}
	f.want(t, "stale record after the refused claim", questFacts{day: 20261110, progress: map[int64]int64{2: 3}, commits: 1})
	// 今天重新做完才能领。
	f.mustAdvance(t, questTestSpend, 3, 3)
	f.mustClaim(t, questTestSpend, 30, 30)
	f.want(t, "after finishing again today", questFacts{day: 20261111, progress: map[int64]int64{2: 3}, claimed: map[int64]bool{2: true}, coins: 30, commits: 3})
}

// 任务记录与货币在同一笔事务里：提交被拒绝时进度、领奖记录、清零与钱一起回滚，之后还能照常再做。
func TestQuestRejectedCommitRollsBackProgressClaimsAndCoins(t *testing.T) {
	f := newQuestFixture(t)
	f.mustAdvance(t, questTestCheckin, 1, 1)
	f.mustClaim(t, questTestCheckin, 20, 20)
	f.mustAdvance(t, questTestSpend, 2, 2)
	dayOne := questFacts{day: 20261110, progress: map[int64]int64{1: 1, 2: 2}, claimed: map[int64]bool{1: true}, coins: 20, commits: 3}

	f.committer.reject.Store(true)
	if _, err := f.advance(questTestSpend, 1); err == nil {
		t.Fatal("a rejected commit reported success")
	}
	f.committer.reject.Store(false)
	f.want(t, "rolled-back advance", dayOne)

	f.mustAdvance(t, questTestSpend, 1, 3)
	f.committer.reject.Store(true)
	if _, err := f.claim(questTestSpend); err == nil {
		t.Fatal("a rejected commit reported success")
	}
	f.committer.reject.Store(false)
	dayOne.progress[2] = 3
	dayOne.commits = 4
	f.want(t, "rolled-back claim", dayOne)
	// 回滚后同一天还能领：上一次没有生效。
	f.mustClaim(t, questTestSpend, 30, 50)
	dayOne.claimed[2] = true
	dayOne.coins = 50
	dayOne.commits = 5
	f.want(t, "claim after the rollback", dayOne)

	// 跨天后的第一次推进连同清零一起回滚：记录整份退回昨天的样子。
	f.pass(24 * time.Hour)
	f.committer.reject.Store(true)
	if _, err := f.advance(questTestBattle, 1); err == nil {
		t.Fatal("a rejected commit reported success")
	}
	f.committer.reject.Store(false)
	f.want(t, "rolled-back day rollover", dayOne)
	f.mustAdvance(t, questTestBattle, 1, 1)
	f.want(t, "day rollover after the rollback", questFacts{day: 20261111, progress: map[int64]int64{3: 1}, coins: 50, commits: 6})
}

// 业务时间倒退（时钟被拨回）不清零也不能再领一遍：记录留在较新的那一天继续用。
func TestQuestClockGoingBackwardsDoesNotReopenClaims(t *testing.T) {
	f := newQuestFixture(t)
	f.mustAdvance(t, questTestCheckin, 1, 1)
	f.mustClaim(t, questTestCheckin, 20, 20)
	f.pass(-24 * time.Hour)
	f.mustAdvance(t, questTestCheckin, 1, 1)
	if _, err := f.claim(questTestCheckin); !errors.Is(err, apperrors.ErrQuestClaimed) {
		t.Fatalf("err = %v, want quest_claimed", err)
	}
	f.mustAdvance(t, questTestSpend, 1, 1)
	f.want(t, "after the clock went back a day", questFacts{day: 20261110, progress: map[int64]int64{1: 1, 2: 1}, claimed: map[int64]bool{1: true}, coins: 20, commits: 3})
}

// “哪一天”跟部署配置的业务日走，不是 UTC 自然日：每日 05:00 重置时，凌晨 04:59 还算前一天。
func TestQuestDayFollowsTheConfiguredBusinessDay(t *testing.T) {
	f := newQuestFixture(t)
	calendar, err := clock.NewCalendar(nil, 5*time.Hour)
	if err != nil {
		t.Fatal(err)
	}
	previous := clock.ProcessCalendar()
	clock.SetCalendar(calendar)
	t.Cleanup(func() { clock.SetCalendar(previous) })

	f.setClock(time.Date(2026, 11, 10, 23, 0, 0, 0, time.UTC))
	f.mustAdvance(t, questTestSpend, 2, 2)
	// UTC 已经是 11 日，业务日还是 10 日：进度接着算。
	f.setClock(time.Date(2026, 11, 11, 4, 59, 59, 999_000_000, time.UTC))
	f.mustAdvance(t, questTestSpend, 1, 3)
	f.mustClaim(t, questTestSpend, 30, 30)
	f.want(t, "before the reset time", questFacts{day: 20261110, progress: map[int64]int64{2: 3}, claimed: map[int64]bool{2: true}, coins: 30, commits: 3})
	// 05:00 起是新的业务日。
	f.pass(time.Millisecond)
	f.mustAdvance(t, questTestSpend, 1, 1)
	f.want(t, "after the reset time", questFacts{day: 20261111, progress: map[int64]int64{2: 1}, coins: 30, commits: 4})
}

// 当日记录不随天数增长：做上两百天，进度与领奖记录各自至多是任务表的条数，每天照常发奖，
// 也不占货币的去重窗口（它只留最近 128 次，按天递增的键会把它占满）。
func TestQuestRecordStaysBoundedOverManyDays(t *testing.T) {
	f := newQuestFixture(t)
	const days = 200
	for day := 1; day <= days; day++ {
		f.mustAdvance(t, questTestCheckin, 1, 1)
		f.mustAdvance(t, questTestSpend, 3, 3)
		f.mustAdvance(t, questTestBattle, 10, 10)
		for _, questID := range []int64{questTestCheckin, questTestSpend, questTestBattle} {
			if _, err := f.claim(questID); err != nil {
				t.Fatalf("day %d quest %d: %v", day, questID, err)
			}
		}
		// 表里没有的任务号进不了记录。
		if _, err := f.advance(questTestUnknown+int64(day), 1); !errors.Is(err, apperrors.ErrQuestUnknown) {
			t.Fatalf("day %d: err = %v, want quest_unknown", day, err)
		}
		if day < days {
			f.pass(24 * time.Hour)
		}
	}
	lastDay := int64(clock.Calendar{}.BusinessDay(time.UnixMilli(f.now.Load())))
	f.want(t, "after 200 days", questFacts{
		day:      lastDay,
		progress: map[int64]int64{1: 1, 2: 3, 3: 10},
		claimed:  map[int64]bool{1: true, 2: true, 3: true},
		coins:    days * 150,
		commits:  days * 6,
	})
}

// 组件在拒绝之前什么都不写，不靠事务回滚兜底：别的功能在自己的事务里调 Advance、丢掉它的错误继续提交时，
// 任务记录不会留下半截写入。这里不经 Nest、持实体锁直接调组件，没有回滚替它擦掉。
func TestQuestComponentRefusesBeforeWritingAnything(t *testing.T) {
	f := newQuestFixture(t)
	RegisterWalletGrantNestHandlers()
	now := f.now.Load()
	tomorrow := now + int64(24*time.Hour/time.Millisecond)
	f.mustAdvance(t, questTestCheckin, 1, 1)
	f.mustClaim(t, questTestCheckin, 20, 20)
	f.mustAdvance(t, questTestSpend, 3, 3)
	f.mustAdvance(t, questTestBattle, 4, 4)
	// 把余额填到再也放不下 30 金币：做完的任务 2 领奖会被货币模块拒绝。
	if _, err := sender.NewWalletGrantSender(f.engine).Sync_WalletGrant(context.Background(), f.player.ID(), "fill", math.MaxInt64-40); err != nil {
		t.Fatal(err)
	}
	before := questFacts{
		day:      20261110,
		progress: map[int64]int64{1: 1, 2: 3, 3: 4},
		claimed:  map[int64]bool{1: true},
		coins:    math.MaxInt64 - 20,
		receipts: 1,
		commits:  5,
	}
	f.want(t, "before the refusals", before)
	f.locked(t, func() {
		quests := f.player.QuestComp()
		if _, err := quests.Advance(questTestUnknown, 1, tomorrow); !errors.Is(err, apperrors.ErrQuestUnknown) {
			t.Errorf("advance an unknown quest: err = %v", err)
		}
		if _, err := quests.Advance(questTestBattle, 0, tomorrow); !errors.Is(err, apperrors.ErrQuestCountInvalid) {
			t.Errorf("advance by zero: err = %v", err)
		}
		if _, err := quests.Claim(questTestUnknown, now); !errors.Is(err, apperrors.ErrQuestUnknown) {
			t.Errorf("claim an unknown quest: err = %v", err)
		}
		if _, err := quests.Claim(questTestBattle, now); !errors.Is(err, apperrors.ErrQuestIncomplete) {
			t.Errorf("claim an unfinished quest: err = %v", err)
		}
		if _, err := quests.Claim(questTestCheckin, now); !errors.Is(err, apperrors.ErrQuestClaimed) {
			t.Errorf("claim twice: err = %v", err)
		}
		if _, err := quests.Claim(questTestSpend, now); !errors.Is(err, apperrors.ErrWalletOverflow) {
			t.Errorf("claim into a full wallet: err = %v", err)
		}
		if _, err := quests.Claim(questTestSpend, tomorrow); !errors.Is(err, apperrors.ErrQuestIncomplete) {
			t.Errorf("claim yesterday's quest: err = %v", err)
		}
	})
	f.want(t, "after refusals without a transaction", before)
}

// Quest 下发给玩家本人：客户端靠它显示进度，靠其中的 Day 判断记录是不是今天的。
// 只断言任务模块自己的字段：同一个 DAO 上还有别的模块的字段。
func TestQuestRecordIsSyncedToThePlayer(t *testing.T) {
	synced := map[string]bool{}
	for _, field := range db.PlayerDaoSyncFields() {
		synced[field.Name] = true
	}
	if !synced["Quest"] {
		t.Fatal("PlayerDao.Quest is not synced: the player would not see quest progress")
	}
}
