package handler

import (
	"context"
	"errors"
	"testing"
	"time"

	sender "{{MODULE}}/game/handler/syncsender"
	apperrors "{{MODULE}}/internal/errors"
	"{{MODULE}}/protocol/pb"
)

// newWithQuestCheckinFixture 是每日任务的 fixture 再接上签到的 handler：两个模块都装着时才有这个文件。
// 签到的 handler 在起 Nest 之前登记。
func newWithQuestCheckinFixture(t *testing.T) (*questFixture, func() error) {
	t.Helper()
	RegisterCheckinClaimNestHandlers()
	f := newQuestFixture(t)
	claims := sender.NewCheckinClaimSender(f.engine)
	return f, func() error {
		_, err := claims.Sync_CheckinClaim(context.Background(), f.player.ID(), &pb.CheckinClaimRequest{})
		return err
	}
}

// 今天签到成功，“签到一次”这条每日任务就完成了，可以领奖；被拒绝的第二次签到不再推进；
// 第二天签到时任务先清零再推进，又可以做一遍。金币数：签到第 1 天 10、任务奖 20、第 2 天签到 20。
func TestWithQuestCheckinAdvancesTheDailyQuest(t *testing.T) {
	f, checkin := newWithQuestCheckinFixture(t)
	today := f.facts(t).day
	if err := checkin(); err != nil {
		t.Fatal(err)
	}
	facts := f.facts(t)
	if facts.progress[questTestCheckin] != 1 || len(facts.progress) != 1 || facts.coins != 10 || facts.commits != 1 {
		t.Fatalf("after the check-in: %v, want quest 1 at 1/1, 10 coins, one commit", facts)
	}
	if facts.day <= today {
		t.Fatalf("the quest record was not moved to today: day=%d", facts.day)
	}
	today = facts.day
	f.mustClaim(t, questTestCheckin, 20, 30)

	f.pass(3 * time.Hour)
	if err := checkin(); !errors.Is(err, apperrors.ErrCheckinDone) {
		t.Fatalf("second check-in: err = %v, want checkin_done", err)
	}
	if facts := f.facts(t); facts.progress[questTestCheckin] != 1 || !facts.claimed[questTestCheckin] || facts.coins != 30 || facts.commits != 2 {
		t.Fatalf("a refused check-in changed the quest record: %v", facts)
	}

	f.pass(24 * time.Hour)
	if err := checkin(); err != nil {
		t.Fatal(err)
	}
	facts = f.facts(t)
	if facts.day != today+1 || facts.progress[questTestCheckin] != 1 || len(facts.claimed) != 0 || facts.coins != 50 {
		t.Fatalf("day 2: %v, want day %d, quest 1 at 1/1 and unclaimed, 50 coins", facts, today+1)
	}
	f.mustClaim(t, questTestCheckin, 20, 70)
}

// 签到的提交被拒：签到与任务进度一起回滚，没有“任务算了、签到没成”的中间状态；之后重签两边都成。
func TestWithQuestCheckinRollsBackTogether(t *testing.T) {
	f, checkin := newWithQuestCheckinFixture(t)
	before := f.facts(t)
	f.committer.reject.Store(true)
	if err := checkin(); err == nil {
		t.Fatal("a rejected commit reported success")
	}
	f.want(t, "after the rejected check-in", before)
	if _, err := f.claim(questTestCheckin); !errors.Is(err, apperrors.ErrQuestIncomplete) {
		t.Fatalf("claiming the quest after the rolled-back check-in: err = %v, want quest_incomplete", err)
	}
	f.committer.reject.Store(false)
	if err := checkin(); err != nil {
		t.Fatal(err)
	}
	f.mustClaim(t, questTestCheckin, 20, 30)
}

// 任务已经做完（别处推进过）再签到：签到照常成功，任务进度不再变。
func TestWithQuestCheckinOnAFinishedQuestStillChecksIn(t *testing.T) {
	f, checkin := newWithQuestCheckinFixture(t)
	f.mustAdvance(t, questTestCheckin, 1, 1)
	if err := checkin(); err != nil {
		t.Fatalf("check-in with the quest already finished: %v", err)
	}
	if facts := f.facts(t); facts.progress[questTestCheckin] != 1 || facts.coins != 10 {
		t.Fatalf("after the check-in: %v, want quest 1 still at 1/1 and 10 coins", facts)
	}
}
