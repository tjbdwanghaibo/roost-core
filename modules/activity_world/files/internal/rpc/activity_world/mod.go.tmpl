package activity_world

import (
	"context"
	"fmt"

	"github.com/spf13/viper"
	"github.com/tjbdwanghaibo/roost-core/framework/app"
	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/framework/nest"
	"github.com/tjbdwanghaibo/roost-core/infra/network/bus"
	"github.com/tjbdwanghaibo/roost-core/wiring/mods"

	host "{{MODULE}}/game/entities/activity_world"
	"{{MODULE}}/game/modules/activity"
)

// Mod 是 activity_world RPC 的属主装配：Start 里先建档、再注册 RPC，最后把恢复扫描交给
// manager 发布的 activity.ScanHost（维护者 D22：后台循环做成 manager，由 manager Mod 统一启停）。扫描的协程归 manager，
// 本 Mod 不再自己起停它；它依赖 manager Mod，因而在 manager 之后启动、之前停止。
type Mod struct {
	service  *Service
	registry *app.Registry
}

func NewMod(service *Service) *Mod { return &Mod{service: service} }

func (m *Mod) Name() app.ModName { return CapabilityName }

func (m *Mod) DependsOn() []app.ModName {
	return []app.ModName{mods.ModNats, mods.ModNest, mods.ModRemoteEntity, mods.ModConfigData, mods.ModManager}
}

func (m *Mod) OptionalDependsOn() []app.ModName {
	return []app.ModName{mods.ModRemoteEntityPreload}
}

func (m *Mod) Init(*viper.Viper) error {
	if m.service == nil {
		return fmt.Errorf("activity_world: nil service")
	}
	return nil
}

func (m *Mod) Provide(r *app.Registry) error {
	m.registry = r
	return mods.RegisterAll(r, OwnerCapabilities(m.service)...)
}

func (m *Mod) Start() error {
	var identity app.ServiceIdentity
	if err := app.LoadConfig(m.registry.Config(), &identity); err != nil {
		return err
	}
	remote, ok := app.Lookup[entity.IRemoteEntityManager](m.registry, mods.ModRemoteEntity)
	if !ok {
		return fmt.Errorf("activity_world: remote manager missing")
	}
	owned, ok := remote.(entity.RemoteOwnedEntityLister)
	if !ok {
		return fmt.Errorf("activity_world: owned entity listing missing")
	}
	client, ok := app.Lookup[nest.Client](m.registry, mods.ModNest)
	if !ok {
		return fmt.Errorf("activity_world: Nest missing")
	}
	transport, ok := app.Lookup[bus.IBus](m.registry, mods.ModBus)
	if !ok {
		return fmt.Errorf("activity_world: bus missing")
	}
	m.service.client = client
	m.service.owners = remote
	m.service.sid = identity.Sid
	if err := m.bootstrap(identity.Sid); err != nil {
		return err
	}
	if err := RegisterHandlers(transport, m.service); err != nil {
		return err
	}
	scans, ok := app.Lookup[*activity.ScanHost](m.registry, activity.ScanCapability("world"))
	if !ok || scans == nil {
		return fmt.Errorf("activity_world: the recovery scan has no host; add gamemanagers.NewWorldActivityScan() to Managers() in this service's managers.go")
	}
	return scans.Start(owned, host.EntityKindActivityWorld, func(ctx context.Context, id int64) error {
		views, err := m.service.Pulse(ctx, id, "", 0)
		if err != nil {
			return err
		}
		return activity.ResumePending(ctx, m.registry, views, func(ctx context.Context, token activity.Token) error { return m.service.Complete(ctx, id, token) })
	})
}

// Stop 没有要停的：RPC handler 随总线停，恢复扫描归 manager（见 Mod 的注释）。
func (m *Mod) Stop() {}
