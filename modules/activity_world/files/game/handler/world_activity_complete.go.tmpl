package handler

import (
	"github.com/tjbdwanghaibo/roost-core/infra/base/fctx"

	"{{MODULE}}/game/activity"
	"{{MODULE}}/game/entities/activity_world"
)

//roost:nest rollback=undo durability=strict
func handlerWorldActivityComplete(target activity_world.IWorldActivityEntity, token activity.Token) error {
	c := target.WorldActivityComp()
	if err := c.Host().Complete(token, fctx.NowMilli()); err != nil {
		return err
	}
	return c.Rearm()
}
