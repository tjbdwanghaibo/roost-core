package handler

import (
	"{{MODULE}}/game/components/activity"
	"{{MODULE}}/game/view"
)

// WorldActivityPulse 只能由权威服务登记；所有权由 RPC 和 Nest 的 Remote 提交再次校验。
//
//roost:nest rollback=undo durability=strict
func handlerWorldActivityPulse(target view.ActivityWorldEntity, event string, createdAt int64) ([]activity.Snapshot, error) {
	c, err := activity.Of(target)
	if err != nil {
		return nil, err
	}
	if err := c.Reconcile(event, createdAt); err != nil {
		return nil, err
	}
	return c.Host().Views()
}
