package handler

import (
	"{{MODULE}}/game/activity"
	"{{MODULE}}/game/entities/activity_world"
)

// WorldActivityPulse 只能由权威服务登记；所有权由 RPC 和 Nest 的 Remote 提交再次校验。
//
//roost:nest rollback=undo durability=strict
func handlerWorldActivityPulse(target activity_world.IWorldActivityEntity, event string, createdAt int64) ([]activity.Snapshot, error) {
	c := target.WorldActivityComp()
	if err := c.Reconcile(event, createdAt); err != nil {
		return nil, err
	}
	return c.Host().Views()
}
