package handler

import (
	"github.com/tjbdwanghaibo/roost-core/infra/base/fctx"

	"{{MODULE}}/game/modules/activity"
	"{{MODULE}}/game/view"
)

//roost:nest rollback=undo durability=strict
func handlerWorldActivityInit(target view.ActivityWorldEntity, createdAt int64) error {
	if createdAt <= 0 || createdAt > fctx.NowMilli() {
		return activity.ErrRule
	}
	dao := target.Dao()
	if dao.GetCreatedAt() != 0 && dao.GetCreatedAt() != createdAt {
		return activity.ErrStale
	}
	dao.SetCreatedAt(createdAt)
	return target.Activity().Reconcile("", createdAt)
}
