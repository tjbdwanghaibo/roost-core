package activity_world

import (
	"github.com/tjbdwanghaibo/roost-core/framework/entity"

	"{{MODULE}}/db"
	"{{MODULE}}/game/activity"
	"{{MODULE}}/game/view"
)

//roost:component type={{ID:component:WorldActivity}}
const CompTypeWorldActivity entity.ComponentType = {{ID:component:WorldActivity}}

// WorldActivityComponent 是同一个 activity.Component 的类型别名，只为当前实体的生成接线命名。
// 活动业务全部在共用组件中；这里仅提供宿主状态与归属。
type WorldActivityComponent = activity.Component

type IWorldActivityEntity interface {
	entity.IThreadSafeEntity
	WorldActivityComp() *WorldActivityComponent
	Dao() *db.ActivityWorldDao
}

// Activity 是 ActivityWorld 的活动组件在 game/view 里的名字（view.ActivityHolder）：活动的钩子与联动只认它。
// 组件类型名按实体区分（WorldActivity），生成器按这个手写访问器把 ActivityHolder 嵌进 view.ActivityWorldEntity。
func (e *ActivityWorld) Activity() view.Activity { return e.WorldActivityComp() }

func init() {
	entity.RegisterComponentFactory(CompTypeWorldActivity, activity.NewComponent)
}

func (e *ActivityWorld) ActivityBook() *db.ActivityBook { return e.Dao().GetActivityWorld() }
func (e *ActivityWorld) ActivityScope() string          { return "world" }

func (e *ActivityWorld) ActivityCreatedAt() int64 { return e.Dao().GetCreatedAt() }
