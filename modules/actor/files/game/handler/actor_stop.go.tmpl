package handler

import (
	"{{MODULE}}/game/view"
	"{{MODULE}}/protocol/pb"
)

//roost:nest rollback=undo durability=async
func handlerActorStop(target view.IActorEntity, request *pb.ActorStopRequest) (*pb.ActorStopResponse, error) {
	m := target.Actor()
	m.Stop()
	pos := m.Position()
	return &pb.ActorStopResponse{X: pos.X, Y: pos.Y}, nil
}
