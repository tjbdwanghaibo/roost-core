package actor

import (
	"{{MODULE}}/game/view"
	"errors"
	"fmt"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/gameplay/movement"
	"github.com/tjbdwanghaibo/roost-core/infra/base/errcode"
	"github.com/tjbdwanghaibo/roost-core/infra/base/spatial"

	"{{MODULE}}/game/actor"
	apperrors "{{MODULE}}/internal/errors"
)

// Owner 是 Actor 组件的宿主：整个 Player（组件运行钩子时要把宿主交给钩子）。只在实体被 Nest 锁住期间使用。
type Owner = view.PlayerEntity

type Component struct {
	entity.ComponentBase
	owner Owner
	body  *actor.Body
}

// NewComponent 是组件工厂；Player 在 game/entities/player/actor_component.go 登记它。
func NewComponent(value any, _ *entity.EntityCreateParam) (entity.ComponentInterfaceBase, error) {
	owner, ok := value.(Owner)
	if !ok {
		return nil, fmt.Errorf("actor component: owner %T does not implement actor.Owner", value)
	}
	return &Component{owner: owner}, nil
}

func (component *Component) Name() string      { return "actor" }
func (component *Component) Owner() Owner    { return component.owner }
func (component *Component) Body() *actor.Body { return component.body }
func (component *Component) OnInitFinish(*entity.EntityCreateParam, bool) error {
	body, err := actor.New(component.owner, actor.Config{Fields: actorFields{component.owner}, Save: component.save, Hooks: component.hooks()})
	component.body = body
	return err
}
func (component *Component) OnDestroy(entity.EntityDestroyReason) {
	if component.body != nil {
		component.body.Close()
	}
}

// MoveRefusal 把 Body.Walk / Follow 的正常拒绝换成带业务码的错误，必须在同一把实体锁内、紧接着失败的那次调用使用：
// 不在空间里答 actor_not_placed，在空间里但被定身答 actor_rooted，路径点超限答 actor_path_too_long。
// 原错误保留在链上（errors.Is(err, actor.ErrCannotMove) 仍成立）。别的错误原样返回，端点按内部错误处理并记日志。
func (component *Component) MoveRefusal(err error) error {
	switch {
	case errors.Is(err, movement.ErrNotInScene):
		return errcode.Wrap(apperrors.ErrActorNotPlaced, err)
	case errors.Is(err, actor.ErrCannotMove):
		if !component.body.Map.InScene() {
			return errcode.Wrap(apperrors.ErrActorNotPlaced, err)
		}
		return errcode.Wrap(apperrors.ErrActorRooted, err)
	case errors.Is(err, actor.ErrPathTooLong):
		return errcode.Wrap(apperrors.ErrActorPathTooLong, err)
	}
	return err
}
func (component *Component) SavedPosition() (int64, spatial.Point, movement.Facing) {
	saved := component.owner.Dao().GetActorSaved()
	return saved.GetSceneID(), spatial.Point{X: saved.GetX(), Y: saved.GetY()}, movement.Facing(saved.GetFacing())
}
func (component *Component) save(id int64, p spatial.Point, facing movement.Facing) error {
	saved := component.owner.Dao().GetActorSaved()
	saved.SetSceneID(id)
	saved.SetX(p.X)
	saved.SetY(p.Y)
	saved.SetFacing(int32(facing))
	return nil
}

type actorFields struct{ owner view.PlayerEntity }

func (f actorFields) SceneID() int64     { return f.owner.Dao().GetActor().GetSceneID() }
func (f actorFields) SetSceneID(v int64) { f.owner.Dao().GetActor().SetSceneID(v) }
func (f actorFields) Pos() spatial.Point {
	s := f.owner.Dao().GetActor()
	return spatial.Point{X: s.GetX(), Y: s.GetY()}
}
func (f actorFields) SetPos(v spatial.Point) { s := f.owner.Dao().GetActor(); s.SetX(v.X); s.SetY(v.Y) }
func (f actorFields) Facing() movement.Facing {
	return movement.Facing(f.owner.Dao().GetActor().GetFacing())
}
func (f actorFields) SetFacing(v movement.Facing) { f.owner.Dao().GetActor().SetFacing(int32(v)) }
