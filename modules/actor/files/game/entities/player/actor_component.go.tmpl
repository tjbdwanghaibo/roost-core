package player

import (
	"github.com/tjbdwanghaibo/roost-core/gameplay/movement"
	"{{MODULE}}/game/components/actor"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:Actor}}
const CompTypeActor entity.ComponentType = {{ID:component:Actor}}

// ActorComponent 是 game/components/actor 的组件在 Player 上的名字（生成接线与 handler 用它）；业务在那个包里。
type ActorComponent = actor.Component

type IActorEntity interface {
	entity.IThreadSafeEntity
	ActorComp() *ActorComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeActor, actor.NewComponent)
}

// MapBasic / MoveComponent 让 Player 满足 gameplay/movement 的宿主接口（移动走 actor 组件的 Body）。
func (e *Player) MapBasic() *movement.MapBasic  { return e.ActorComp().Body().Map }
func (e *Player) MoveComponent() *movement.Move { return e.ActorComp().Body().Move }

// NewActorPlayerSyncPacker 是 Player 实体注解 subjectPacker= 指向的名字（必须在实体包里）；实现在 game/components/actor。
func NewActorPlayerSyncPacker(value entity.IThreadSafeEntity) entity.SubjectSyncPacker {
	return actor.NewActorPlayerSyncPacker(value)
}
