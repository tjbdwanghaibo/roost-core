package naming

import (
	"context"
	"crypto/sha256"
	"errors"
	"fmt"
	"github.com/tjbdwanghaibo/roost-core/framework/app"
	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/framework/nest"
	"github.com/tjbdwanghaibo/roost-core/infra/base/errcode"
	"github.com/tjbdwanghaibo/roost-core/service/directory"
	"log/slog"
	"strings"
	player "{{MODULE}}/game/entities/player"
	gamenaming "{{MODULE}}/game/components/naming"
	syncsender "{{MODULE}}/game/handler/syncsender"
	profile "{{MODULE}}/game/components/profile"
	apperrors "{{MODULE}}/internal/errors"
)

// Controller 不保存可变业务状态。所有在途事实在 Player；每次重试可使用新 Controller。
type Controller struct {
	names   directory.Directory
	profile namingProfile
}
type namingProfile interface {
	Begin(context.Context, int64, string, string) (gamenaming.NamingTicket, error)
	Step(context.Context, int64, int64, string, int32, string, string) (gamenaming.NamingTicket, error)
}
type nestProfile struct {
	begin *syncsender.NamingBeginSender
	step  *syncsender.NamingStepSender
}

func (p nestProfile) Begin(ctx context.Context, id int64, op, name string) (gamenaming.NamingTicket, error) {
	return p.begin.Sync_NamingBegin(ctx, id, op, name)
}
func (p nestProfile) Step(ctx context.Context, id, seq int64, op string, action int32, key, token string) (gamenaming.NamingTicket, error) {
	return p.step.Sync_NamingStep(ctx, id, seq, op, action, key, token)
}
func FromRegistry(r *app.Registry) (*Controller, error) {
	if r == nil {
		return nil, fmt.Errorf("naming: registry required")
	}
	names, ok := app.Lookup[directory.Directory](r, app.ModName("service.directory"))
	if !ok || names == nil {
		return nil, fmt.Errorf("naming: directory capability missing")
	}
	client, ok := app.Lookup[nest.Client](r, app.ModName("nest"))
	if !ok || client == nil {
		return nil, fmt.Errorf("naming: nest capability missing")
	}
	return &Controller{names: names, profile: nestProfile{syncsender.NewNamingBeginSender(client), syncsender.NewNamingStepSender(client)}}, nil
}
func init() {
	profile.RegisterRenamer(func(ctx context.Context, r *app.Registry, id int64, name string) (string, error) {
		c, err := FromRegistry(r)
		if err != nil {
			return "", err
		}
		// 旧协议没有请求键，以目标名构成固定键；同目标重发恢复同一笔。新协议允许业务自带键。
		return c.Rename(ctx, id, fmt.Sprintf("%x", sha256.Sum256([]byte(name))), name)
	})
}

// Rename 是正式服务端入口；只允许事务之外调用，会等待目录与 Nest。
func (c *Controller) Rename(ctx context.Context, playerID int64, operation, name string) (string, error) {
	id, err := entity.BuildEntityID(playerID, player.EntityKindPlayer)
	if err != nil {
		return "", err
	}
	ticket, err := c.profile.Begin(ctx, id, operation, name)
	if err != nil {
		return "", err
	}
	result, err := c.resume(ctx, id, ticket)
	if err == nil {
		// 不记录 Ticket：里面有占名凭据。重试也可能返回完成，用请求键关联同一笔操作。
		slog.InfoContext(ctx, "naming: rename completed", "player_id", playerID, "request_key", operation, "old_name", strings.TrimPrefix(ticket.OldKey, "player-name/"), "name", result)
	} else if !errors.Is(err, directory.ErrKeyTaken) && !errors.Is(err, apperrors.ErrNamingBusy) && !errors.Is(err, apperrors.ErrNamingInvalid) {
		slog.WarnContext(ctx, "naming: rename unresolved", "player_id", playerID, "request_key", operation, "started_phase", ticket.Phase, "code", errcode.CodeOf(err))
	}
	return result, err
}
