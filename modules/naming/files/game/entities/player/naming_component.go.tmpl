package player

import (
	apperrors "{{MODULE}}/internal/errors"
	"{{MODULE}}/game/components/naming"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:Naming}}
const CompTypeNaming entity.ComponentType = {{ID:component:Naming}}

// NamingComponent 是 game/components/naming 的组件在 Player 上的名字（生成接线与 handler 用它）；业务在那个包里。
type NamingComponent = naming.Component

type INamingEntity interface {
	entity.IThreadSafeEntity
	NamingComp() *NamingComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeNaming, naming.NewComponent)
}

// CheckProfileRenameRequest 禁止旧的本地 ProfileRename Sender 绕过目录。
// ProfileComponent.Rename 是可信事务内写入原语；正式业务入口必须走命名协调器。
func (e *Player) CheckProfileRenameRequest() error { return apperrors.ErrNamingRequired }
