package view

// Naming 是 Naming 组件对 game/ 下其它包公开的方法（实现在 game/components/naming，语义见那里）；只在宿主被 Nest 锁住期间调用。
type Naming interface {
	Ticket() NamingTicket
	Begin(operation, name string) (NamingTicket, error)
	Step(seq int64, operation string, action int32, key, token string) (NamingTicket, error)
}

// NamingHolder 是“带有 Naming 组件”的小接口：只要这个组件的组件包、钩子与联动收它；实体接口（entity_<实体>.go，生成）嵌入它。
type NamingHolder interface{ Naming() Naming }

// NamingTicket 是锁外可持有的快照，目录 RPC 只能拿快照，不能拿 Player。
type NamingTicket struct {
	Seq                                           int64
	Operation, Target                             string
	Phase                                         int32
	ClaimKey, ClaimToken, Owner, OldKey, OldOwner string
}
