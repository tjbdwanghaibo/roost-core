package turn

import (
	"github.com/tjbdwanghaibo/roost-core/framework/nest/entitytimer"
	"{{MODULE}}/game/components/room"
	"{{MODULE}}/game/view"
	"fmt"
	"math"
	"time"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/infra/base/fctx"
	db "{{MODULE}}/db"
	apperrors "{{MODULE}}/internal/errors"
)

const (
	TurnWaiting int32 = iota
	TurnRunning
	TurnFinished
)

// Owner 是 Turn 组件的宿主（Room 的接线见 game/entities/room/turn_component.go）：view 的 RoomEntity。
// 只在实体被 Nest 锁住期间使用。回合期限的定时节点挂在 Room 的定时组件上（生成代码，在实体包里），
// 由实体包的 ArmTurnDeadline / CancelTurnDeadline 适配，与回合事实同一笔事务提交。
type Owner interface {
	view.RoomEntity
	// ArmTurnDeadline 在 at 建一个 TurnDeadline 节点，返回节点 ID（0 表示没建成）。
	ArmTurnDeadline(at time.Time) int64
	// CancelTurnDeadline 删掉节点 id；节点已不在时什么也不做。
	CancelTurnDeadline(id int64)
}

// Component 只处理回合次序，不替游戏定义攻击、伤害或胜负。业务 handler 可以先修改
// 同一 Room 的玩法 DAO，再调用 End；玩法结果、命令回执、下一回合与定时器随同一事务提交。
// 所有方法只在 Nest 持有 Room 锁时调用；组件不缓存需要回滚的状态。
type Component struct {
	entity.ComponentBase
	owner Owner
}

// NewComponent 是组件工厂；Room 在 game/entities/room/turn_component.go 登记它。
func NewComponent(value any, _ *entity.EntityCreateParam) (entity.ComponentInterfaceBase, error) {
	owner, ok := value.(Owner)
	if !ok {
		return nil, fmt.Errorf("turn component: owner %T does not implement turn.Owner", value)
	}
	return &Component{owner: owner}, nil
}

// TurnSnapshot 是 view.TurnSnapshot（结构体定义在 game/view，这里留同名别名，组件与 handler 的写法不变）。
type TurnSnapshot = view.TurnSnapshot

func (component *Component) Name() string { return "turn" }

func (component *Component) authorize(playerID int64, epoch uint64, connection string) error {
	seat, err := component.owner.Room().Member(playerID, epoch)
	if err != nil {
		return err
	}
	if !room.ValidConnection(connection) || !seat.GetConnected() || seat.GetConnection() != connection {
		return apperrors.ErrRoomStaleEpoch
	}
	return nil
}

// Start 只允许当前房主开局，至少两名在座成员。相同规则重试返回当前状态，不重置序号、期限或名单。
// 每回合 1 秒～1 小时、总计 1～10000 回合；上层可以收窄，不允许客户端改服务端时间。
func (component *Component) Start(playerID int64, epoch uint64, connection string, turnMillis, maxTurns int64) (TurnSnapshot, error) {
	if err := component.authorize(playerID, epoch, connection); err != nil {
		return TurnSnapshot{}, err
	}
	dao := component.owner.Dao()
	if dao.GetHostID() != playerID {
		return TurnSnapshot{}, apperrors.ErrRoomNotHost
	}
	if turnMillis < 1000 || turnMillis > 3600000 || maxTurns < 1 || maxTurns > 10000 {
		return TurnSnapshot{}, apperrors.ErrTurnInvalid
	}
	state := dao.GetTurn()
	if state.GetStatus() != TurnWaiting {
		if state.GetTurnMillis() != turnMillis || state.GetMaxTurns() != maxTurns {
			return TurnSnapshot{}, apperrors.ErrTurnInvalid
		}
		return component.snapshot(playerID), nil
	}
	seats := component.owner.Room().Snapshot(playerID).Seats
	if len(seats) < 2 {
		return TurnSnapshot{}, apperrors.ErrTurnInvalid
	}
	players := make([]*db.TurnPlayer, 0, len(seats))
	for _, seat := range seats {
		p := &db.TurnPlayer{}
		p.SetPlayerID(seat.PlayerID)
		players = append(players, p)
	}
	state.SetPlayers(players)
	state.SetStatus(TurnRunning)
	state.SetRound(1)
	state.SetActive(0)
	state.SetMaxTurns(maxTurns)
	state.SetTurnMillis(turnMillis)
	if err := component.arm(fctx.NowMilli()); err != nil {
		return TurnSnapshot{}, err
	}
	return component.snapshot(playerID), nil
}

// End 的序号是每个玩家自己的成功命令序号，从 1 起连续递增；回合号必须与当前回合一致。
// 重放最后一条成功命令只返回当前快照，不再执行推进；上层玩法要先用 CheckEnd 判重，再改玩法 DAO。
func (component *Component) End(playerID int64, epoch uint64, connection string, round, sequence int64) (TurnSnapshot, error) {
	replay, err := component.CheckEnd(playerID, epoch, connection, round, sequence)
	if err != nil {
		return TurnSnapshot{}, err
	}
	if replay {
		return component.snapshot(playerID), nil
	}
	state := component.owner.Dao().GetTurn()
	player, _ := state.GetPlayers(int(state.GetActive()))
	player.SetSequence(sequence)
	player.SetLastRound(round)
	component.owner.CancelTurnDeadline(state.GetTimerID())
	component.advance()
	if state.GetStatus() == TurnRunning {
		if err := component.arm(fctx.NowMilli()); err != nil {
			return TurnSnapshot{}, err
		}
	}
	return component.snapshot(playerID), nil
}

// CheckEnd 必须与实际玩法修改和 End 同处一笔 Nest 事务。replay=true 时不能再执行游戏动作。
// 先校验可信连接与成员资格，再检查回执：旧连接即使带上正确序号也不能重放。
func (component *Component) CheckEnd(playerID int64, epoch uint64, connection string, round, sequence int64) (replay bool, err error) {
	if err = component.authorize(playerID, epoch, connection); err != nil {
		return false, err
	}
	if round <= 0 || sequence <= 0 {
		return false, apperrors.ErrTurnSequence
	}
	state := component.owner.Dao().GetTurn()
	var participant *db.TurnPlayer
	state.RangePlayers(func(_ int, p *db.TurnPlayer) bool {
		if p.GetPlayerID() == playerID {
			participant = p
			return false
		}
		return true
	})
	if participant == nil {
		return false, apperrors.ErrTurnNotActor
	}
	if sequence == participant.GetSequence() && round == participant.GetLastRound() {
		return true, nil
	}
	if participant.GetSequence() == math.MaxInt64 || sequence != participant.GetSequence()+1 {
		return false, apperrors.ErrTurnSequence
	}
	if state.GetStatus() != TurnRunning {
		return false, apperrors.ErrTurnNotRunning
	}
	actor, _ := state.GetPlayers(int(state.GetActive()))
	if round != state.GetRound() || actor.GetPlayerID() != playerID {
		return false, apperrors.ErrTurnNotActor
	}
	if fctx.NowMilli() >= state.GetDeadline() {
		return false, apperrors.ErrTurnExpired
	}
	return false, nil
}

func (component *Component) View(playerID int64, epoch uint64, connection string) (TurnSnapshot, error) {
	if err := component.authorize(playerID, epoch, connection); err != nil {
		return TurnSnapshot{}, err
	}
	return component.snapshot(playerID), nil
}

// advance 至多前进一回合；离线很久也不追帧。离开的参与者跳过，后来加入的人不进入本场名单。
// 关闭房间或仍在座的参与者不足两人时结束；无需为不同玩法向 Room 注入隐蔽生命周期钩子。
func (component *Component) advance() {
	dao := component.owner.Dao()
	state := dao.GetTurn()
	present := 0
	state.RangePlayers(func(_ int, p *db.TurnPlayer) bool {
		if _, ok := dao.GetSeats(p.GetPlayerID()); ok {
			present++
		}
		return true
	})
	if dao.GetClosed() || present < 2 || state.GetRound() >= state.GetMaxTurns() {
		state.SetStatus(TurnFinished)
		state.SetDeadline(0)
		state.SetTimerID(0)
		return
	}
	next := int(state.GetActive())
	for range state.PlayersLen() {
		next = (next + 1) % state.PlayersLen()
		p, _ := state.GetPlayers(next)
		if _, ok := dao.GetSeats(p.GetPlayerID()); ok {
			break
		}
	}
	state.SetActive(int32(next))
	state.SetRound(state.GetRound() + 1)
}

func (component *Component) arm(now int64) error {
	state := component.owner.Dao().GetTurn()
	if now <= 0 || now > math.MaxInt64-state.GetTurnMillis() {
		return apperrors.ErrTurnInvalid
	}
	deadline := now + state.GetTurnMillis()
	id := component.owner.ArmTurnDeadline(time.UnixMilli(deadline))
	if id == 0 {
		return fmt.Errorf("turn: cannot create deadline timer")
	}
	state.SetDeadline(deadline)
	state.SetTimerID(id)
	return nil
}

func (component *Component) snapshot(playerID int64) TurnSnapshot {
	state := component.owner.Dao().GetTurn()
	result := TurnSnapshot{Status: state.GetStatus(), Round: state.GetRound(), Deadline: state.GetDeadline(), MaxTurns: state.GetMaxTurns(), TurnMillis: state.GetTurnMillis(), Timeouts: state.GetTimeouts()}
	state.RangePlayers(func(_ int, p *db.TurnPlayer) bool {
		result.Players = append(result.Players, p.GetPlayerID())
		if p.GetPlayerID() == playerID {
			result.Sequence = p.GetSequence()
		}
		return true
	})
	if state.GetStatus() == TurnRunning {
		p, _ := state.GetPlayers(int(state.GetActive()))
		result.ActorID = p.GetPlayerID()
	}
	return result
}

// OnDeadline 是 TurnDeadline 节点到期的业务：节点 ID 与期限都对得上才算一次超时并推进回合；返回下一次期限的间隔（0 表示不续）。
// Room 的定时组件在实体包里登记回调并转到这里（game/entities/room/turn_timers.go）。
func (component *Component) OnDeadline(fire entitytimer.Fire) time.Duration {
	state := component.owner.Dao().GetTurn()
	// 节点 ID 与期限共同校验。主动结束已经换过节点，旧投递不会消费下一回合。
	if state.GetStatus() != TurnRunning || fire.ID != state.GetTimerID() || fire.Deadline.UnixMilli() != state.GetDeadline() {
		return 0
	}
	state.SetTimeouts(state.GetTimeouts() + 1)
	component.advance()
	if state.GetStatus() != TurnRunning {
		return 0
	}
	now := fire.Now.UnixMilli()
	if now > math.MaxInt64-state.GetTurnMillis() {
		state.SetStatus(TurnFinished)
		state.SetDeadline(0)
		state.SetTimerID(0)
		return 0
	}
	state.SetDeadline(now + state.GetTurnMillis())
	// 回调续期从实际触发时刻起算，错过的若干回合不会集中执行。
	return time.Duration(state.GetTurnMillis()) * time.Millisecond
}
