package handler

import room "{{MODULE}}/game/entities/room"

// handlerTurnStart 在 Room 的同一笔持久事务中处理，成功提交后才回复。
//
//roost:nest rollback=undo durability=strict
func handlerTurnStart(target room.ITurnEntity, playerID int64, epoch uint64, connection string, turnMillis, maxTurns int64) (room.TurnSnapshot, error) {
	return target.TurnComp().Start(playerID, epoch, connection, turnMillis, maxTurns)
}
