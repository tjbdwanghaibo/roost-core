func (f *turnFixture) locked(t *testing.T, fn func()) {
	t.Helper()
	if err := f.engine.RunLocal(context.Background(), func() { f.value.GetMutex().Lock(); defer f.value.GetMutex().Unlock(); fn() }); err != nil {
		t.Fatal(err)
	}
}
func (f *turnFixture) document(t *testing.T) []byte {
	t.Helper()
	var raw []byte
	f.locked(t, func() { raw = f.value.Dao().Marshal() })
	return raw
}
func (f *turnFixture) timers(t *testing.T) int {
	t.Helper()
	n := 0
	f.locked(t, func() { n = len(f.value.{{TIMER_COMPONENT}}Comp().{{TIMER_COMPONENT}}s()) })
	return n
}
func (f *turnFixture) unchanged(t *testing.T, before []byte) {
	t.Helper()
	decode := func(raw []byte) bson.M {
		d := bson.NewDecoder(bson.NewDocumentReader(bytes.NewReader(raw)))
		d.DefaultDocumentM()
		var value bson.M
		if err := d.Decode(&value); err != nil {
			t.Fatal(err)
		}
		return value
	}
	if !reflect.DeepEqual(decode(before), decode(f.document(t))) {
		t.Fatal("rejected/replayed command changed persisted state")
	}
}

func TestTurnStartAndReplayKeepOneDeadline(t *testing.T) {
	f := newTurnFixture(t, 2)
	v := f.start(t, 8)
	if v.Status != 1 || v.Round != 1 || v.ActorID != 101 || v.Deadline != 1900000001000 || v.MaxTurns != 8 || v.TurnMillis != 1000 || !reflect.DeepEqual(v.Players, []int64{101, 102}) || f.timers(t) != 1 {
		t.Fatalf("start: %+v", v)
	}
	before := f.document(t)
	f.now.Add(400)
	f.start(t, 8)
	f.unchanged(t, before)
}
