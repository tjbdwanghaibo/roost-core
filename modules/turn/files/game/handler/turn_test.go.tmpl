func TestTurnReloadKeepsSequenceAndFiresOverdueOnce(t *testing.T) {
	f := newTurnFixture(t, 2)
	f.start(t, 8)
	f.end(t, 101, 1, 1)
	raw := f.document(t)
	f.now.Add(100000)
	restored := db.NewRoomDao()
	if err := restored.Unmarshal(raw); err != nil {
		t.Fatal(err)
	}
	// 模拟持久字节水合：新实例初始化前载入 DAO，旧实例退出期限索引。
	f.value.{{TIMER_COMPONENT}}Comp().OnDestroy(entity.EntityDestroyReason(0))
	value, err := entity.BuildEntity(&entity.EntityCreateParam{IsCreate: false, Id: f.id, Kind: room.EntityKindRoom, Dao: map[string]entity.DaoInterface{db.RoomDaoCollection: restored}})
	if err != nil {
		t.Fatal(err)
	}
	f.value = value.(*room.Room)
	f.getter.value = value
	f.tick(t)
	v := f.view(t)
	if v.Round != 3 || v.ActorID != 101 || v.Sequence != 1 || v.Timeouts != 1 || v.Deadline != 1900000101000 {
		t.Fatalf("restore: %+v", v)
	}
	before := f.document(t)
	f.end(t, 101, 1, 1)
	f.tick(t)
	f.unchanged(t, before)
}
