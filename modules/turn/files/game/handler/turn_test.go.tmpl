// 本模块独立的替身与场景，不依赖 room 的测试辅助函数。只验证事务与 BSON 恢复，不宣称 Mongo 落盘。
type turnGetter struct{ value entity.IThreadSafeEntity }

func (g *turnGetter) Get(_ context.Context, id int64, _ entity.EntityCategory) (entity.IThreadSafeEntity, error) {
	if g.value != nil && g.value.ID() == id {
		return g.value, nil
	}
	return nil, fmt.Errorf("missing turn room %d", id)
}
func (g *turnGetter) GetMany(ctx context.Context, ids []int64, cats []entity.EntityCategory) ([]entity.IThreadSafeEntity, error) {
	values := make([]entity.IThreadSafeEntity, len(ids))
	for i, id := range ids {
		v, err := g.Get(ctx, id, cats[i])
		if err != nil {
			return nil, err
		}
		values[i] = v
	}
	return values, nil
}

type turnCommitter struct{ reject atomic.Bool }

func (c *turnCommitter) Commit(context.Context, dataengine.CommitRecord) error {
	if c.reject.Load() {
		return errors.New("injected turn commit failure")
	}
	return nil
}

type turnFixture struct {
	engine *nest.NestMgr
	value  *room.Room
	getter *turnGetter
	commit *turnCommitter
	now    atomic.Int64
	id     int64
	starts *sender.TurnStartSender
	ends   *sender.TurnEndSender
	views  *sender.TurnViewSender
}

func newTurnFixture(t *testing.T, players int) *turnFixture {
	t.Helper()
	room.RegisterEntity()
	f := &turnFixture{commit: &turnCommitter{}}
	f.now.Store(1900000000000)
	clock.SetSource(func() time.Time { return time.UnixMilli(f.now.Load()) })
	t.Cleanup(func() { clock.SetSource(nil) })
	var err error
	f.id, err = entity.BuildEntityID(75001, room.EntityKindRoom)
	if err != nil {
		t.Fatal(err)
	}
	value, err := entity.BuildEntity(&entity.EntityCreateParam{IsCreate: true, Id: f.id, Kind: room.EntityKindRoom})
	if err != nil {
		t.Fatal(err)
	}
	f.value = value.(*room.Room)
	f.getter = &turnGetter{value: value}
	f.engine = nest.NewEngine(nest.NestOptionWithGetter(f.getter), nest.NestOptionWithTransactionCommitter(f.commit), nest.NestOptionWithWorkerPools(nest.WorkerPoolConfig{Workers: 2, QueueCap: 64}, nest.WorkerPoolConfig{}, nest.WorkerPoolConfig{}))
	for _, register := range []func(*nest.NestMgr) error{RegisterRoomOpenNestHandlersOn, RegisterRoomJoinNestHandlersOn, RegisterRoomLeaveNestHandlersOn, RegisterRoomReconnectNestHandlersOn, RegisterRoomCloseNestHandlersOn, RegisterTurnStartNestHandlersOn, RegisterTurnEndNestHandlersOn, RegisterTurnViewNestHandlersOn, RegisterTickRoom{{TIMER_COMPONENT}}GenNestHandlersOn} {
		if err := register(f.engine); err != nil {
			t.Fatal(err)
		}
	}
	if err := f.engine.Start(); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := f.engine.Shutdown(context.Background()); err != nil {
			t.Error(err)
		}
		f.value.{{TIMER_COMPONENT}}Comp().OnDestroy(entity.EntityDestroyReason(0))
	})
	f.starts = sender.NewTurnStartSender(f.engine)
	f.ends = sender.NewTurnEndSender(f.engine)
	f.views = sender.NewTurnViewSender(f.engine)
	if err := sender.NewRoomOpenSender(f.engine).Sync_RoomOpen(context.Background(), f.id, 4); err != nil {
		t.Fatal(err)
	}
	for i := 0; i < players; i++ {
		f.join(t, int64(101+i))
	}
	return f
}
