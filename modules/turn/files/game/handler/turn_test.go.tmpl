func TestTurnEndMovesOnceAndRenewsFromNow(t *testing.T) {
	f := newTurnFixture(t, 2)
	f.start(t, 8)
	f.now.Add(300)
	v := f.end(t, 101, 1, 1)
	if v.Round != 2 || v.ActorID != 102 || v.Sequence != 1 || v.Deadline != 1900000001300 || f.timers(t) != 1 {
		t.Fatalf("end: %+v", v)
	}
	v = f.end(t, 102, 2, 1)
	if v.Round != 3 || v.ActorID != 101 || v.Sequence != 1 {
		t.Fatalf("second: %+v", v)
	}
}
