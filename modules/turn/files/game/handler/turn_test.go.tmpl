func TestTurnRejectsInvalidRulesAndRuleChanges(t *testing.T) {
	f := newTurnFixture(t, 2)
	before := f.document(t)
	for _, rules := range [][2]int64{{999, 8}, {3600001, 8}, {1000, 0}, {1000, 10001}} {
		_, err := f.starts.Sync_TurnStart(context.Background(), f.id, 101, 1, "c101", rules[0], rules[1])
		if !errors.Is(err, apperrors.ErrTurnInvalid) {
			t.Fatal(err)
		}
	}
	f.unchanged(t, before)
	f.start(t, 8)
	before = f.document(t)
	_, err := f.starts.Sync_TurnStart(context.Background(), f.id, 101, 1, "c101", 2000, 8)
	if !errors.Is(err, apperrors.ErrTurnInvalid) {
		t.Fatal(err)
	}
	f.unchanged(t, before)
}
