package handler

import "{{MODULE}}/game/view"

// handlerTurnView 在 Room 的 Nest 锁内只读对局快照，不推进回合或执行持久化。
//
//roost:nest durability=memory
func handlerTurnView(target view.ITurnEntity, playerID int64, epoch uint64, connection string) (view.TurnSnapshot, error) {
	return target.Turn().View(playerID, epoch, connection)
}
