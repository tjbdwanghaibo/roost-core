package handler

import "{{MODULE}}/game/view"

// handlerTurnEnd 在 Room 的同一笔持久事务中处理，成功提交后才回复。
//
//roost:nest rollback=undo durability=strict
func handlerTurnEnd(target view.ITurnEntity, playerID int64, epoch uint64, connection string, round, sequence int64) (view.TurnSnapshot, error) {
	return target.Turn().End(playerID, epoch, connection, round, sequence)
}
