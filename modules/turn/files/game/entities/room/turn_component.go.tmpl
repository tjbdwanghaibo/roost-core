package room

import (
	"{{MODULE}}/game/components/turn"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:Turn}}
const CompTypeTurn entity.ComponentType = {{ID:component:Turn}}

// TurnComponent 是 game/components/turn 的组件在 Room 上的名字（生成接线与 handler 用它）；业务在那个包里。
type TurnComponent = turn.Component

type ITurnEntity interface {
	entity.IThreadSafeEntity
	TurnComp() *TurnComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeTurn, turn.NewComponent)
}
