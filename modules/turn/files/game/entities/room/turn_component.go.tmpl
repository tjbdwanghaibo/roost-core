package room

import (
	"fmt"
	"math"
	"time"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/infra/base/fctx"
	db "{{MODULE}}/db"
	apperrors "{{MODULE}}/internal/errors"
)

//roost:component type={{ID:component:Turn}}
const CompTypeTurn entity.ComponentType = {{ID:component:Turn}}

const (
	TurnWaiting int32 = iota
	TurnRunning
	TurnFinished
)

// TurnComponent 只处理回合次序，不替游戏定义攻击、伤害或胜负。业务 handler 可以先修改
// 同一 Room 的玩法 DAO，再调用 End；玩法结果、命令回执、下一回合与定时器随同一事务提交。
// 所有方法只在 Nest 持有 Room 锁时调用；组件不缓存需要回滚的状态。
type TurnComponent struct {
	entity.ComponentBase
	owner *Room
}

type ITurnEntity interface {
	entity.IThreadSafeEntity
	TurnComp() *TurnComponent
}

type TurnSnapshot struct {
	Status     int32
	Round      int64
	ActorID    int64
	Deadline   int64
	MaxTurns   int64
	TurnMillis int64
	Timeouts   int64
	Sequence   int64
	Players    []int64
}

func init() {
	entity.RegisterComponentFactory(CompTypeTurn, func(owner any, _ *entity.EntityCreateParam) (entity.ComponentInterfaceBase, error) {
		room, ok := owner.(*Room)
		if !ok {
			return nil, fmt.Errorf("turn component: owner %T is not *Room", owner)
		}
		return &TurnComponent{owner: room}, nil
	})
}
func (component *TurnComponent) Name() string { return "turn" }

func (component *TurnComponent) authorize(playerID int64, epoch uint64, connection string) error {
	seat, err := component.owner.RoomComp().member(playerID, epoch)
	if err != nil {
		return err
	}
	if !validRoomConnection(connection) || !seat.GetConnected() || seat.GetConnection() != connection {
		return apperrors.ErrRoomStaleEpoch
	}
	return nil
}

// Start 只允许当前房主开局，至少两名在座成员。相同规则重试返回当前状态，不重置序号、期限或名单。
// 每回合 1 秒～1 小时、总计 1～10000 回合；上层可以收窄，不允许客户端改服务端时间。
func (component *TurnComponent) Start(playerID int64, epoch uint64, connection string, turnMillis, maxTurns int64) (TurnSnapshot, error) {
	if err := component.authorize(playerID, epoch, connection); err != nil {
		return TurnSnapshot{}, err
	}
	dao := component.owner.Dao()
	if dao.GetHostID() != playerID {
		return TurnSnapshot{}, apperrors.ErrRoomNotHost
	}
	if turnMillis < 1000 || turnMillis > 3600000 || maxTurns < 1 || maxTurns > 10000 {
		return TurnSnapshot{}, apperrors.ErrTurnInvalid
	}
	state := dao.GetTurn()
	if state.GetStatus() != TurnWaiting {
		if state.GetTurnMillis() != turnMillis || state.GetMaxTurns() != maxTurns {
			return TurnSnapshot{}, apperrors.ErrTurnInvalid
		}
		return component.snapshot(playerID), nil
	}
	seats := component.owner.RoomComp().snapshot(playerID).Seats
	if len(seats) < 2 {
		return TurnSnapshot{}, apperrors.ErrTurnInvalid
	}
	players := make([]*db.TurnPlayer, 0, len(seats))
	for _, seat := range seats {
		p := &db.TurnPlayer{}
		p.SetPlayerID(seat.PlayerID)
		players = append(players, p)
	}
	state.SetPlayers(players)
	state.SetStatus(TurnRunning)
	state.SetRound(1)
	state.SetActive(0)
	state.SetMaxTurns(maxTurns)
	state.SetTurnMillis(turnMillis)
	if err := component.arm(fctx.NowMilli()); err != nil {
		return TurnSnapshot{}, err
	}
	return component.snapshot(playerID), nil
}

// End 的序号是每个玩家自己的成功命令序号，从 1 起连续递增；回合号必须与当前回合一致。
// 重放最后一条成功命令只返回当前快照，不再执行推进；上层玩法要先用 CheckEnd 判重，再改玩法 DAO。
func (component *TurnComponent) End(playerID int64, epoch uint64, connection string, round, sequence int64) (TurnSnapshot, error) {
	replay, err := component.CheckEnd(playerID, epoch, connection, round, sequence)
	if err != nil {
		return TurnSnapshot{}, err
	}
	if replay {
		return component.snapshot(playerID), nil
	}
	state := component.owner.Dao().GetTurn()
	player, _ := state.GetPlayers(int(state.GetActive()))
	player.SetSequence(sequence)
	player.SetLastRound(round)
	component.owner.{{TIMER_COMPONENT}}Comp().Remove{{TIMER_COMPONENT}}(state.GetTimerID())
	component.advance()
	if state.GetStatus() == TurnRunning {
		if err := component.arm(fctx.NowMilli()); err != nil {
			return TurnSnapshot{}, err
		}
	}
	return component.snapshot(playerID), nil
}

// CheckEnd 必须与实际玩法修改和 End 同处一笔 Nest 事务。replay=true 时不能再执行游戏动作。
// 先校验可信连接与成员资格，再检查回执：旧连接即使带上正确序号也不能重放。
func (component *TurnComponent) CheckEnd(playerID int64, epoch uint64, connection string, round, sequence int64) (replay bool, err error) {
	if err = component.authorize(playerID, epoch, connection); err != nil {
		return false, err
	}
	if round <= 0 || sequence <= 0 {
		return false, apperrors.ErrTurnSequence
	}
	state := component.owner.Dao().GetTurn()
	var participant *db.TurnPlayer
	state.RangePlayers(func(_ int, p *db.TurnPlayer) bool {
		if p.GetPlayerID() == playerID {
			participant = p
			return false
		}
		return true
	})
	if participant == nil {
		return false, apperrors.ErrTurnNotActor
	}
	if sequence == participant.GetSequence() && round == participant.GetLastRound() {
		return true, nil
	}
	if participant.GetSequence() == math.MaxInt64 || sequence != participant.GetSequence()+1 {
		return false, apperrors.ErrTurnSequence
	}
	if state.GetStatus() != TurnRunning {
		return false, apperrors.ErrTurnNotRunning
	}
	actor, _ := state.GetPlayers(int(state.GetActive()))
	if round != state.GetRound() || actor.GetPlayerID() != playerID {
		return false, apperrors.ErrTurnNotActor
	}
	if fctx.NowMilli() >= state.GetDeadline() {
		return false, apperrors.ErrTurnExpired
	}
	return false, nil
}

func (component *TurnComponent) View(playerID int64, epoch uint64, connection string) (TurnSnapshot, error) {
	if err := component.authorize(playerID, epoch, connection); err != nil {
		return TurnSnapshot{}, err
	}
	return component.snapshot(playerID), nil
}

// advance 至多前进一回合；离线很久也不追帧。离开的参与者跳过，后来加入的人不进入本场名单。
// 关闭房间或仍在座的参与者不足两人时结束；无需为不同玩法向 Room 注入隐蔽生命周期钩子。
func (component *TurnComponent) advance() {
	dao := component.owner.Dao()
	state := dao.GetTurn()
	present := 0
	state.RangePlayers(func(_ int, p *db.TurnPlayer) bool {
		if _, ok := dao.GetSeats(p.GetPlayerID()); ok {
			present++
		}
		return true
	})
	if dao.GetClosed() || present < 2 || state.GetRound() >= state.GetMaxTurns() {
		state.SetStatus(TurnFinished)
		state.SetDeadline(0)
		state.SetTimerID(0)
		return
	}
	next := int(state.GetActive())
	for range state.PlayersLen() {
		next = (next + 1) % state.PlayersLen()
		p, _ := state.GetPlayers(next)
		if _, ok := dao.GetSeats(p.GetPlayerID()); ok {
			break
		}
	}
	state.SetActive(int32(next))
	state.SetRound(state.GetRound() + 1)
}

func (component *TurnComponent) arm(now int64) error {
	state := component.owner.Dao().GetTurn()
	if now <= 0 || now > math.MaxInt64-state.GetTurnMillis() {
		return apperrors.ErrTurnInvalid
	}
	deadline := now + state.GetTurnMillis()
	id := component.owner.{{TIMER_COMPONENT}}Comp().New{{TIMER_COMPONENT}}At(time.UnixMilli(deadline), TurnDeadline, 0, 0, nil)
	if id == 0 {
		return fmt.Errorf("turn: cannot create deadline timer")
	}
	state.SetDeadline(deadline)
	state.SetTimerID(id)
	return nil
}

func (component *TurnComponent) snapshot(playerID int64) TurnSnapshot {
	state := component.owner.Dao().GetTurn()
	result := TurnSnapshot{Status: state.GetStatus(), Round: state.GetRound(), Deadline: state.GetDeadline(), MaxTurns: state.GetMaxTurns(), TurnMillis: state.GetTurnMillis(), Timeouts: state.GetTimeouts()}
	state.RangePlayers(func(_ int, p *db.TurnPlayer) bool {
		result.Players = append(result.Players, p.GetPlayerID())
		if p.GetPlayerID() == playerID {
			result.Sequence = p.GetSequence()
		}
		return true
	})
	if state.GetStatus() == TurnRunning {
		p, _ := state.GetPlayers(int(state.GetActive()))
		result.ActorID = p.GetPlayerID()
	}
	return result
}
