package turn

import (
	"{{MODULE}}/game/view"
	"{{MODULE}}/protocol/pb"
)

func turnInfo(value view.TurnSnapshot) *pb.TurnInfo {
	return &pb.TurnInfo{Status: value.Status, Round: value.Round, ActorID: value.ActorID, Deadline: value.Deadline, MaxTurns: value.MaxTurns, TurnMillis: value.TurnMillis, Timeouts: value.Timeouts, Sequence: value.Sequence, Players: value.Players}
}
