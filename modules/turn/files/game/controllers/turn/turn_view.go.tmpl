package turn

import (
	"fmt"
	"github.com/tjbdwanghaibo/roost-core/infra/base/errcode"
	"log/slog"
	room "{{MODULE}}/game/entities/room"
	syncsender "{{MODULE}}/game/handler/syncsender"
	"{{MODULE}}/game/playeraccess"
	roomlogic "{{MODULE}}/game/room"
	"{{MODULE}}/protocol/pb"
)

// HandleTurnView 只信任认证上下文中的玩家号与连接身份，PB 不携带操作者或服务器时间。
func (controller *Controller) HandleTurnView(ctx *playeraccess.Context, req *pb.TurnViewRequest) (*pb.TurnViewResponse, error) {
	if ctx == nil || ctx.PlayerID <= 0 || req == nil {
		return nil, fmt.Errorf("turn: authenticated context and request are required")
	}
	response := &pb.TurnViewResponse{}
	connection, err := roomlogic.ConnectionKey(ctx.Session)
	var id int64
	if err == nil {
		id, err = roomlogic.EntityID(req.RoomID)
	}
	if err == nil {
		var result room.TurnSnapshot
		result, err = syncsender.NewTurnViewSender(controller.nestClient).Sync_TurnView(ctx.Context(), id, ctx.PlayerID, req.Epoch, connection)
		if err == nil {
			response.Info = turnInfo(result)
		}
	}
	if err != nil {
		response.Code, response.Reason = errcode.ClientError(err)
		if response.Code == errcode.CodeInternal {
			slog.Error("turn view failed", "room_id", req.RoomID, "player_id", ctx.PlayerID, "err", err)
		}
	}
	return response, nil
}
