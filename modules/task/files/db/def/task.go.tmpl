package dbdef

// TaskState 的每日记录按 BusinessDay 惰性清零；周记录按该业务日所在周的周一清零。
// 客户端用 Day / Weekly.Day 判断是否过期；Permanent 永不清零。
// ID 空间限制为 1..4096，退役任务保留事实，防止同号重新上架重复领奖。
type TaskState struct {
	Day       int64           `store:"1"`
	Progress  map[int64]int64 `store:"2"`
	Claimed   map[int64]bool  `store:"3"`
	Weekly    TaskPeriodState `store:"4"`
	Permanent TaskPeriodState `store:"5"`
}

type TaskPeriodState struct {
	// Day 对周任务为周一的 YYYYMMDD，对永久任务恒为 0。
	Day      int64           `store:"1"`
	Progress map[int64]int64 `store:"2"`
	Claimed  map[int64]bool  `store:"3"`
}
