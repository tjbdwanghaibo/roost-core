package player

import (
	"fmt"
	"sync"

	apperrors "{{MODULE}}/internal/errors"
)

// TaskReward 与邮件附件一样表达一种资产：Kind / ID / Count；不为这个值类型引入 mail 服务依赖。
type TaskReward struct {
	Kind      string
	ID, Count int64
}
type TaskRewardHandler struct {
	Validate func(TaskReward) error
	Grant    func(*Player, TaskReward) error
}

var taskRewardMu sync.RWMutex
var taskRewards = map[string]TaskRewardHandler{}

// RegisterTaskReward 由联动在 init 登记。Grant 只改同一个 Player，不能做 I/O。
func RegisterTaskReward(kind string, handler TaskRewardHandler) {
	if kind == "" || handler.Validate == nil || handler.Grant == nil {
		panic("task: reward handler incomplete")
	}
	taskRewardMu.Lock()
	defer taskRewardMu.Unlock()
	if _, ok := taskRewards[kind]; ok {
		panic(fmt.Sprintf("task: duplicate reward %q", kind))
	}
	taskRewards[kind] = handler
}
func taskRewardHandler(kind string) (TaskRewardHandler, bool) {
	taskRewardMu.RLock()
	defer taskRewardMu.RUnlock()
	handler, ok := taskRewards[kind]
	return handler, ok
}
func validateTaskReward(reward TaskReward) error {
	handler, ok := taskRewardHandler(reward.Kind)
	if !ok || reward.Count <= 0 {
		return apperrors.ErrTaskUnknown
	}
	return handler.Validate(reward)
}
func grantTaskReward(owner *Player, reward TaskReward) error {
	if err := validateTaskReward(reward); err != nil {
		return err
	}
	handler, _ := taskRewardHandler(reward.Kind)
	return handler.Grant(owner, reward)
}
func init() {
	RegisterTaskReward("coins", TaskRewardHandler{
		Validate: func(reward TaskReward) error {
			if reward.ID != 0 {
				return apperrors.ErrTaskUnknown
			}
			return nil
		},
		Grant: func(owner *Player, reward TaskReward) error {
			_, err := owner.WalletComp().Add(reward.Count)
			return err
		},
	})
}
