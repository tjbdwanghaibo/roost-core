func TestTaskCatalogEntriesAreUsable(t *testing.T) {
	previousStore, previousConfig := configdata.DefaultStore(), fctx.RuntimeConfig()
	t.Cleanup(func() { configdata.SetDefaultStore(previousStore); fctx.SetRuntimeConfig(previousConfig) })
	registry := configdata.NewRegistry()
	if err := generated.RegisterGeneratedConfigData(registry); err != nil {
		t.Fatal(err)
	}
	if _, err := configdata.NewStore(registry, "../../../configs/data").Load(context.Background()); err != nil {
		t.Fatal(err)
	}
	if len(generated.TaskTable().Rows()) == 0 {
		t.Fatal("empty task table")
	}
	for _, row := range generated.TaskTable().Rows() {
		if _, ok := taskDefinition(row.ID); !ok {
			t.Fatalf("invalid row: %+v", row)
		}
	}
	// 命名常量指的是缺省任务表里的那三行：名字要与那一行的事件对得上（3 号是副本领奖，不是“战斗”）。
	for id, event := range map[int64]string{TaskDailyCheckin: "checkin.claimed", TaskDailySpend: "wallet.spent", TaskDailyDungeon: "dungeon.claimed"} {
		row, ok := taskDefinition(id)
		if !ok || row.Event != event || row.Period != TaskPeriodDaily {
			t.Fatalf("task %d = %+v (found %v), want the daily %q task", id, row, ok, event)
		}
	}
}

func TestTaskCatalogRefusesUnusableEntries(t *testing.T) {
	row := TaskDefinition{ID: 10, Event: "battle", Period: "daily", Target: 2, RewardKind: "coins", RewardCount: 5}
	if !taskRowUsable(row) {
		t.Fatal("valid row refused")
	}
	invalid := []TaskDefinition{row, row, row, row, row, row, row, row}
	invalid[0].Target = 0
	invalid[1].Target = -1
	invalid[2].RewardCount = 0
	invalid[3].RewardCount = -1
	invalid[4].ID = 4097
	invalid[5].Period = "hourly"
	invalid[6].RewardKind = "missing"
	invalid[7].RewardID = 1
	for _, bad := range invalid {
		if taskRowUsable(bad) {
			t.Fatalf("invalid row accepted: %+v", bad)
		}
	}
}

func TestTaskConfigRejectsInvalidPeriodsAndNonpositiveTargets(t *testing.T) {
	header := "id,event,period,target,previous,reward_kind,reward_id,reward_count,disabled\n"
	for _, sample := range []struct{ row, field string }{
		{"10,win,hourly,2,0,coins,0,7,false\n", "period"},
		{"10,win,daily,0,0,coins,0,7,false\n", "target"},
	} {
		rows, err := generated.ConvertTaskCSV(strings.NewReader(header + sample.row))
		if err != nil {
			t.Fatal(err)
		}
		dir := t.TempDir()
		entries, err := os.ReadDir("../../../configs/data")
		if err != nil {
			t.Fatal(err)
		}
		for _, entry := range entries {
			if entry.IsDir() || filepath.Ext(entry.Name()) != ".json" || entry.Name() == "_manifest.json" {
				continue
			}
			raw, err := os.ReadFile(filepath.Join("../../../configs/data", entry.Name()))
			if err != nil {
				t.Fatal(err)
			}
			if err := os.WriteFile(filepath.Join(dir, entry.Name()), raw, 0600); err != nil {
				t.Fatal(err)
			}
		}
		raw, err := json.Marshal(rows)
		if err != nil {
			t.Fatal(err)
		}
		if err := os.WriteFile(filepath.Join(dir, "task.json"), raw, 0600); err != nil {
			t.Fatal(err)
		}
		registry := configdata.NewRegistry()
		if err := generated.RegisterGeneratedConfigData(registry); err != nil {
			t.Fatal(err)
		}
		if _, err := configdata.NewStore(registry, dir).Load(context.Background()); err == nil || !strings.Contains(err.Error(), sample.field) {
			t.Fatalf("invalid %s config accepted or wrong rejection: %v", sample.field, err)
		}
	}
}
