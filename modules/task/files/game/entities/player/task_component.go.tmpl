package player

import (
	"{{MODULE}}/game/components/task"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

// TaskComponent 是 game/components/task 的组件在 Player 上的名字（生成接线与 handler 用它）；业务在那个包里。
// 类型号 task.CompTypeTask 与工厂登记在组件包里（模块清单的 component_package）；下面的别名与窄接口暂留给现有 handler。
type TaskComponent = task.Component

// ITaskEntity 是 Nest handler 用这个组件时的窄实体接口；getter 由生成的 Entity 接线实现。
// 别的功能在自己的 handler 里要推进任务时，目标接口里嵌入它即可（同一个实体、同一笔事务）。
type ITaskEntity interface {
	entity.IThreadSafeEntity
	TaskComp() *TaskComponent
}
