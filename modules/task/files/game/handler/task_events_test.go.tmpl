// 测试自己的任务表通过实际生成的 CSV/JSON 校验与请求快照装载，不给业务代码留测试开关。
func taskRows(t *testing.T, rows ...schema.Task) {
	t.Helper()
	dir := t.TempDir()
	// 同时拷贝已安装的表，确保联动里的 bag / shop 仍能读取各自规则。
	entries, err := os.ReadDir("../../configs/data")
	if err != nil {
		t.Fatal(err)
	}
	for _, entry := range entries {
		if entry.IsDir() || filepath.Ext(entry.Name()) != ".json" || entry.Name() == "_manifest.json" {
			continue
		}
		raw, err := os.ReadFile(filepath.Join("../../configs/data", entry.Name()))
		if err != nil {
			t.Fatal(err)
		}
		if err := os.WriteFile(filepath.Join(dir, entry.Name()), raw, 0600); err != nil {
			t.Fatal(err)
		}
	}
	raw, err := json.Marshal(rows)
	if err != nil {
		t.Fatal(err)
	}
	if err := os.WriteFile(filepath.Join(dir, "task.json"), raw, 0600); err != nil {
		t.Fatal(err)
	}
	registry := configdata.NewRegistry()
	if err := generated.RegisterGeneratedConfigData(registry); err != nil {
		t.Fatal(err)
	}
	if _, err := configdata.NewStore(registry, dir).Load(context.Background()); err != nil {
		t.Fatal(err)
	}
}
func taskRow(id int64, event, period string) schema.Task {
	return schema.Task{ID: id, Event: event, Period: period, Target: 2, RewardKind: "coins", RewardCount: 7}
}
func (f *taskFixture) report(event string, n int64) error {
	return sender.NewTaskReportSender(f.engine).Sync_TaskReport(context.Background(), f.player.ID(), event, n)
}

func TestTaskReportAdvancesOnlyMatchingEvents(t *testing.T) {
	f := newTaskFixture(t)
	taskRows(t, taskRow(10, "win", "daily"), taskRow(11, "win", "daily"), taskRow(12, "visit", "daily"))
	if err := f.report("win", 1); err != nil {
		t.Fatal(err)
	}
	facts := f.facts(t)
	if len(facts.progress) != 2 || facts.progress[10] != 1 || facts.progress[11] != 1 || facts.commits != 1 {
		t.Fatalf("events=%v", facts)
	}
	before := f.facts(t)
	if err := f.report("unknown", 1); err != nil {
		t.Fatal(err)
	}
	f.want(t, "unknown", before)
	if err := f.report("win", 0); !errors.Is(err, apperrors.ErrTaskCountInvalid) {
		t.Fatalf("count err=%v", err)
	}
	f.want(t, "zero", before)
}
func TestTaskWeeklyResetsOnlyAtBusinessMonday(t *testing.T) {
	f := newTaskFixture(t)
	taskRows(t, taskRow(10, "win", "weekly"))
	calendar, err := clock.NewCalendar(nil, 5*time.Hour)
	if err != nil {
		t.Fatal(err)
	}
	previous := clock.ProcessCalendar()
	clock.SetCalendar(calendar)
	t.Cleanup(func() { clock.SetCalendar(previous) })
	f.setClock(time.Date(2026, 11, 15, 23, 0, 0, 0, time.UTC))
	f.mustAdvance(t, 10, 2, 2)
	f.mustClaim(t, 10, 7, 7)
	f.setClock(time.Date(2026, 11, 16, 4, 59, 59, 999000000, time.UTC))
	if _, err := f.claim(10); !errors.Is(err, apperrors.ErrTaskClaimed) {
		t.Fatalf("early reset: %v", err)
	}
	f.pass(time.Millisecond)
	if _, err := f.claim(10); !errors.Is(err, apperrors.ErrTaskIncomplete) {
		t.Fatalf("stale week: %v", err)
	}
	f.mustAdvance(t, 10, 1, 1)
	if facts := f.periodFacts(t, true); facts.day != 20261116 || len(facts.claimed) != 0 {
		t.Fatalf("week=%v", facts)
	}
	f.mustAdvance(t, 10, 1, 2)
	f.mustClaim(t, 10, 7, 14)
}
func TestTaskWeeklyRollbackDoesNotReopenClaim(t *testing.T) {
	f := newTaskFixture(t)
	taskRows(t, taskRow(10, "win", "weekly"))
	f.mustAdvance(t, 10, 2, 2)
	f.mustClaim(t, 10, 7, 7)
	f.pass(-7 * 24 * time.Hour)
	f.mustAdvance(t, 10, 1, 2)
	if _, err := f.claim(10); !errors.Is(err, apperrors.ErrTaskClaimed) {
		t.Fatalf("clock replay=%v", err)
	}
}
func TestTaskPermanentClaimSurvivesDaysAndRetirement(t *testing.T) {
	f := newTaskFixture(t)
	row := taskRow(10, "win", "permanent")
	taskRows(t, row)
	f.mustAdvance(t, 10, 2, 2)
	f.mustClaim(t, 10, 7, 7)
	row.Disabled = true
	taskRows(t, row)
	if _, err := f.claim(10); !errors.Is(err, apperrors.ErrTaskUnknown) {
		t.Fatalf("disabled=%v", err)
	}
	f.pass(90 * 24 * time.Hour)
	row.Disabled = false
	taskRows(t, row)
	f.mustAdvance(t, 10, 1, 2)
	if _, err := f.claim(10); !errors.Is(err, apperrors.ErrTaskClaimed) {
		t.Fatalf("retired replay=%v", err)
	}
	if facts := f.periodFacts(t, false); len(facts.progress) != 1 || len(facts.claimed) != 1 || facts.day != 0 {
		t.Fatalf("permanent facts changed: %v", facts)
	}
}
func TestTaskChainWaitsForClaimAndDoesNotReuseEvent(t *testing.T) {
	f := newTaskFixture(t)
	a, b := taskRow(10, "win", "permanent"), taskRow(11, "win", "permanent")
	b.Previous = 10
	taskRows(t, a, b)
	if _, err := f.advance(11, 2); !errors.Is(err, apperrors.ErrTaskIncomplete) {
		t.Fatalf("locked=%v", err)
	}
	if err := f.report("win", 9); err != nil {
		t.Fatal(err)
	}
	if _, err := f.claim(11); !errors.Is(err, apperrors.ErrTaskIncomplete) {
		t.Fatalf("same event traversed chain: %v", err)
	}
	f.mustClaim(t, 10, 7, 7)
	if _, err := f.claim(11); !errors.Is(err, apperrors.ErrTaskIncomplete) {
		t.Fatalf("inherited progress=%v", err)
	}
	if err := f.report("win", 2); err != nil {
		t.Fatal(err)
	}
	f.mustClaim(t, 11, 7, 14)
}
func TestTaskInvalidChainWritesNothing(t *testing.T) {
	f := newTaskFixture(t)
	a, b, c := taskRow(10, "win", "daily"), taskRow(11, "win", "daily"), taskRow(12, "win", "permanent")
	a.Previous = 11
	b.Previous = 10
	c.Previous = 11
	taskRows(t, a, b, c)
	before := f.facts(t)
	if err := f.report("win", 2); err != nil {
		t.Fatal(err)
	}
	f.want(t, "invalid chain", before)
	for _, id := range []int64{10, 11, 12} {
		if _, err := f.advance(id, 2); !errors.Is(err, apperrors.ErrTaskUnknown) {
			t.Fatalf("cycle=%d err=%v", id, err)
		}
	}
	a.Previous = 13
	taskRows(t, a)
	if _, err := f.advance(10, 2); !errors.Is(err, apperrors.ErrTaskUnknown) {
		t.Fatalf("missing predecessor=%v", err)
	}
}
func TestTaskPeriodResetAndRewardRollBack(t *testing.T) {
	f := newTaskFixture(t)
	taskRows(t, taskRow(10, "win", "weekly"))
	f.mustAdvance(t, 10, 2, 2)
	f.committer.reject.Store(true)
	if _, err := f.claim(10); err == nil {
		t.Fatal("rejected claim accepted")
	}
	f.committer.reject.Store(false)
	f.mustClaim(t, 10, 7, 7)
	f.pass(7 * 24 * time.Hour)
	f.committer.reject.Store(true)
	if err := f.report("win", 1); err == nil {
		t.Fatal("rejected reset accepted")
	}
	f.committer.reject.Store(false)
	if facts := f.periodFacts(t, true); facts.day != 20261109 || facts.progress[10] != 2 || !facts.claimed[10] {
		t.Fatalf("rollback=%v", facts)
	}
	f.mustAdvance(t, 10, 1, 1)
}
func TestTaskStateIDBoundSurvivesTableChurn(t *testing.T) {
	f := newTaskFixture(t)
	taskRows(t, taskRow(4096, "win", "permanent"))
	f.mustAdvance(t, 4096, 2, 2)
	f.mustClaim(t, 4096, 7, 7)
	for _, id := range []int64{0, 4097, 999999} {
		if _, err := f.advance(id, 1); !errors.Is(err, apperrors.ErrTaskUnknown) {
			t.Fatalf("outside identity space=%d %v", id, err)
		}
	}
	taskRows(t, taskRow(10, "win", "permanent"))
	f.mustAdvance(t, 10, 2, 2)
	taskRows(t, taskRow(4096, "win", "permanent"))
	if _, err := f.claim(4096); !errors.Is(err, apperrors.ErrTaskClaimed) {
		t.Fatalf("churn reopened=%v", err)
	}
	if facts := f.periodFacts(t, false); len(facts.progress) != 2 || len(facts.claimed) != 1 {
		t.Fatalf("unexpected record growth: %v", facts)
	}
}
func TestTaskRewardResponseNamesItsAsset(t *testing.T) {
	f := newTaskFixture(t)
	f.mustAdvance(t, 1, 1, 1)
	response, err := f.claim(1)
	if err != nil {
		t.Fatal(err)
	}
	if response.RewardKind != "coins" || response.RewardID != 0 || response.Reward != 20 || response.Balance != 20 {
		t.Fatalf("reward=%+v", response)
	}
}
func TestTaskUnknownRewardCannotCreateProgress(t *testing.T) {
	f := newTaskFixture(t)
	row := taskRow(10, "win", "daily")
	row.RewardKind = "not-installed"
	taskRows(t, row)
	if err := f.report("win", 1); err != nil {
		t.Fatal(err)
	}
	f.want(t, "unsupported reward", taskFacts{})
	if _, err := f.advance(10, 1); !errors.Is(err, apperrors.ErrTaskUnknown) {
		t.Fatalf("unregistered reward=%v", err)
	}
}

func (f *taskFixture) periodFacts(t *testing.T, weekly bool) taskFacts {
	t.Helper()
	facts := taskFacts{progress: map[int64]int64{}, claimed: map[int64]bool{}}
	f.locked(t, func() {
		state := f.player.Dao().GetTask().GetWeekly()
		if !weekly {
			state = f.player.Dao().GetTask().GetPermanent()
		}
		facts.day = state.GetDay()
		state.RangeProgress(func(id, n int64) bool { facts.progress[id] = n; return true })
		state.RangeClaimed(func(id int64, claimed bool) bool { facts.claimed[id] = claimed; return true })
	})
	return facts
}
