package task

import (
	"sync/atomic"

	"github.com/tjbdwanghaibo/roost-core/framework/configdata"

	"{{MODULE}}/configs/schema"
	generated "{{MODULE}}/configs/generated"
)

// 任务号、事件、目标与奖励都只在任务表（configs/table/task.csv）里，代码里不给某一行起名字：
// 工程换表之后不留下指向不存在的行的常量。这里只有与表无关的上限与周期名。
const (
	TaskMaxID           int64 = 4096
	TaskPeriodDaily           = "daily"
	TaskPeriodWeekly          = "weekly"
	TaskPeriodPermanent       = "permanent"
)

// TaskDefinition 直接使用任务配置行。同一条 Nest 消息读取同一份配置快照。
type TaskDefinition = schema.Task

func taskRowUsable(row TaskDefinition) bool {
	if row.Disabled || row.ID < 1 || row.ID > TaskMaxID || row.Target <= 0 || row.Event == "" || row.Previous < 0 || row.Previous > TaskMaxID {
		return false
	}
	switch row.Period {
	case TaskPeriodDaily, TaskPeriodWeekly, TaskPeriodPermanent:
	default:
		return false
	}
	return validateTaskReward(TaskReward{Kind: row.RewardKind, ID: row.RewardID, Count: row.RewardCount}) == nil
}

// taskIndex 随不可变配置表建立一次；请求只查事件索引，不在每次消费时扫描全表、重走前置链。
// 旧请求仍持有自己的表快照。热更期间两个快照交错时最多重建索引，不混用任务定义。
type taskIndex struct {
	table       *configdata.Table[int64, schema.Task]
	definitions map[int64]TaskDefinition
	events      map[string][]TaskDefinition
}

var currentTaskIndex atomic.Pointer[taskIndex]

func taskDefinitions() *taskIndex {
	table := generated.TaskTable()
	if cached := currentTaskIndex.Load(); cached != nil && cached.table == table {
		return cached
	}
	index := &taskIndex{table: table, definitions: map[int64]TaskDefinition{}, events: map[string][]TaskDefinition{}}
	rows := map[int64]TaskDefinition{}
	for _, row := range table.Rows() {
		rows[row.ID] = row
	}
	// visiting/valid/invalid 标记既发现环，也让每个前置只校验一次。
	const (
		visiting = 1
		valid    = 2
		invalid  = 3
	)
	states := map[int64]int{}
	var validate func(int64) bool
	validate = func(id int64) bool {
		if state := states[id]; state != 0 {
			return state == valid
		}
		row, exists := rows[id]
		if !exists || !taskRowUsable(row) {
			states[id] = invalid
			return false
		}
		states[id] = visiting
		if row.Previous != 0 {
			previous := rows[row.Previous]
			if (previous.Period != row.Period && previous.Period != TaskPeriodPermanent) || !validate(row.Previous) {
				states[id] = invalid
				return false
			}
		}
		states[id] = valid
		index.definitions[id] = row
		return true
	}
	for _, row := range table.Rows() {
		if validate(row.ID) {
			index.events[row.Event] = append(index.events[row.Event], row)
		}
	}
	currentTaskIndex.Store(index)
	return index
}

func taskDefinition(id int64) (TaskDefinition, bool) {
	row, ok := taskDefinitions().definitions[id]
	return row, ok
}
