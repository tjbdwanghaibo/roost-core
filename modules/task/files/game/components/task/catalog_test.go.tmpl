// 工程自己的任务表（configs/table/task.csv 经 roost generate 转成的 configs/data/task.json）装载之后，
// 每一行没有停用的任务都可用（能推进、能领）。停用行（Disabled）本身合法、只是不可用，跳过；不断言表里有哪几行：
// 那张表归工程所有。其余场景用模块自带的样例表，不读这张表。
func TestTaskCatalogEntriesAreUsable(t *testing.T) {
	previousStore, previousConfig := configdata.DefaultStore(), fctx.RuntimeConfig()
	t.Cleanup(func() { configdata.SetDefaultStore(previousStore); fctx.SetRuntimeConfig(previousConfig) })
	registry := configdata.NewRegistry()
	if err := generated.RegisterGeneratedConfigData(registry); err != nil {
		t.Fatal(err)
	}
	if _, err := configdata.NewStore(registry, "../../../configs/data").Load(context.Background()); err != nil {
		t.Fatal(err)
	}
	if len(generated.TaskTable().Rows()) == 0 {
		t.Fatal("empty task table")
	}
	for _, row := range generated.TaskTable().Rows() {
		if row.Disabled {
			continue
		}
		if _, ok := taskDefinition(row.ID); !ok {
			t.Fatalf("task %d in configs/table/task.csv is not usable (bad id, event, period, reward, or an unusable predecessor): %+v", row.ID, row)
		}
	}
}

func TestTaskCatalogRefusesUnusableEntries(t *testing.T) {
	row := TaskDefinition{ID: 10, Event: "battle", Period: "daily", Target: 2, RewardKind: "coins", RewardCount: 5}
	if !taskRowUsable(row) {
		t.Fatal("valid row refused")
	}
	invalid := []TaskDefinition{row, row, row, row, row, row, row, row}
	invalid[0].Target = 0
	invalid[1].Target = -1
	invalid[2].RewardCount = 0
	invalid[3].RewardCount = -1
	invalid[4].ID = 4097
	invalid[5].Period = "hourly"
	invalid[6].RewardKind = "missing"
	invalid[7].RewardID = 1
	for _, selector := range []struct {
		kind string
		id   int64
	}{{"", 7}, {"goods", 0}, {"item", -1}, {"typo", 1}, {"item", 1}} {
		bad := row // battle 没有任何可验证的对象来源
		bad.ObjectKind, bad.ObjectID = selector.kind, selector.id
		invalid = append(invalid, bad)
	}
	held := row
	held.Mode, held.Event, held.ObjectKind, held.ObjectID = "held", "bag.held", "item", 1001
	if heldItems == nil && taskRowUsable(held) {
		t.Fatal("held row accepted without bag")
	}
	badMode, wrongKind, wrongEvent, missingID := held, held, held, held
	badMode.Mode, wrongKind.ObjectKind, wrongEvent.Event, missingID.ObjectID = "typo", "goods", "shop.bought", 0
	invalid = append(invalid, badMode, wrongKind, wrongEvent, missingID)
	for _, bad := range invalid {
		if taskRowUsable(bad) {
			t.Fatalf("invalid row accepted: %+v", bad)
		}
	}
}

func TestTaskConfigRejectsInvalidPeriodsAndNonpositiveTargets(t *testing.T) {
	previousStore, previousConfig := configdata.DefaultStore(), fctx.RuntimeConfig()
	t.Cleanup(func() { configdata.SetDefaultStore(previousStore); fctx.SetRuntimeConfig(previousConfig) })
	dir := t.TempDir()
	entries, err := os.ReadDir("../../../configs/data")
	if err != nil {
		t.Fatal(err)
	}
	for _, entry := range entries {
		if entry.IsDir() || filepath.Ext(entry.Name()) != ".json" || entry.Name() == "_manifest.json" {
			continue
		}
		raw, err := os.ReadFile(filepath.Join("../../../configs/data", entry.Name()))
		if err != nil {
			t.Fatal(err)
		}
		if err := os.WriteFile(filepath.Join(dir, entry.Name()), raw, 0600); err != nil {
			t.Fatal(err)
		}
	}
	registry := configdata.NewRegistry()
	if err := generated.RegisterGeneratedConfigData(registry); err != nil {
		t.Fatal(err)
	}
	store := configdata.NewStore(registry, dir)
	const header = "id,event,period,target,previous,reward_kind,reward_id,reward_count,disabled"
	const row = "10,shop.bought,daily,2,0,coins,0,7,false"
	reloadCSV := func(csv string) error {
		t.Helper()
		rows, err := generated.ConvertTaskCSV(strings.NewReader(csv))
		if err != nil {
			t.Fatal(err)
		}
		raw, err := json.Marshal(rows)
		if err != nil {
			t.Fatal(err)
		}
		if err := os.WriteFile(filepath.Join(dir, "task.json"), raw, 0600); err != nil {
			t.Fatal(err)
		}
		_, err = store.Reload(context.Background())
		return err
	}
	if err := reloadCSV(header + ",object_kind,object_id\n" + row + ",goods,1\n"); err != nil {
		t.Fatal(err)
	}
	if rows := generated.TaskTable().Rows(); len(rows) != 1 || rows[0].ObjectKind != "goods" || rows[0].ObjectID != 1 {
		t.Fatalf("selector lost by converter: %+v", rows)
	}
	if len(taskDefinitions().events["shop.bought"]) != 0 {
		t.Fatal("object row in anonymous index")
	}
	if err := reloadCSV(header + "\n" + row + "\n"); err != nil {
		t.Fatalf("legacy CSV reload: %v", err)
	}
	idx := taskDefinitions()
	if rows := idx.events["shop.bought"]; len(rows) != 1 || rows[0].ID != 10 || rows[0].Mode != "" || rows[0].ObjectKind != "" || rows[0].ObjectID != 0 || len(idx.objects) != 0 {
		t.Fatalf("reloaded legacy row is not anonymous: %+v", rows)
	}
	for _, sample := range []struct{ row, field string }{
		{"10,win,hourly,2,0,coins,0,7,false\n", "period"},
		{"10,win,daily,0,0,coins,0,7,false\n", "target"},
	} {
		if err := reloadCSV(header + "\n" + sample.row); err == nil || !strings.Contains(err.Error(), sample.field) {
			t.Fatalf("invalid %s config accepted or wrong rejection: %v", sample.field, err)
		}
	}
}
