package task

import (
	"{{MODULE}}/game/components/bag"
	"{{MODULE}}/game/view"
	apperrors "{{MODULE}}/internal/errors"
)

func init() {
	heldItems = &heldItemSource{
		valid: func(itemID, target int64) bool {
			_, ok := bag.ItemRule(itemID)
			// 单品的入账上限调低后，合法存量可能仍高于新上限。持有判定不覆盖 Count。
			return ok && target > 0 && target <= bag.MaxStack
		},
		count: func(owner Owner, itemID int64) int64 { return owner.Bag().Count(itemID) },
	}
	RegisterTaskReward("item", TaskRewardHandler{
		Validate: func(reward TaskReward) error {
			if reward.ID <= 0 {
				return apperrors.ErrTaskUnknown
			}
			return nil
		},
		Grant: func(owner view.PlayerEntity, reward TaskReward) error {
			_, err := owner.Bag().Add(reward.ID, reward.Count)
			return err
		},
	})
}
