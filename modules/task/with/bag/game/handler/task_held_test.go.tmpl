// 真实的工程奖励扩展点：发奖时同一 Player 上的同步回调可合法推进另一个任务。
func init() {
	task.RegisterTaskReward("test_held_callback", task.TaskRewardHandler{
		Validate: func(task.TaskReward) error { return nil },
		Grant: func(owner view.PlayerEntity, reward task.TaskReward) error {
			if _, err := owner.Wallet().Add(reward.Count); err != nil {
				return err
			}
			return owner.Task().Report("reward.received", 1, fctx.NowMilli())
		},
	})
}

func taskHeldRow(id int64) schema.Task {
	row := taskRow(id, "bag.held", "daily")
	row.Mode, row.ObjectKind, row.ObjectID, row.Target = "held", "item", 1001, 3
	return row
}

func taskGrant(t *testing.T, f *taskFixture, id, n int64) {
	t.Helper()
	RegisterBagGrantNestHandlers()
	if _, err := sender.NewBagGrantSender(f.engine).Sync_BagGrant(context.Background(), f.player.ID(), id, n); err != nil {
		t.Fatal(err)
	}
}

func taskDiscard(t *testing.T, f *taskFixture, id, n int64) {
	t.Helper()
	RegisterBagDiscardNestHandlers()
	if _, err := sender.NewBagDiscardSender(f.engine).Sync_BagDiscard(context.Background(), f.player.ID(), &pb.BagDiscardRequest{ItemID: id, Count: n}); err != nil {
		t.Fatal(err)
	}
}

func taskClaimRefused(t *testing.T, f *taskFixture, id int64, want error) {
	t.Helper()
	before := f.facts(t)
	if _, err := f.claim(id); !errors.Is(err, want) {
		t.Fatalf("claim task %d: got %v, want %v", id, err, want)
	}
	f.want(t, "refused claim", before)
}

func testHeldBagAtClaim(t *testing.T) {
	f := newTaskFixture(t)
	held, unknown, oversized, outOfBounds := taskHeldRow(10), taskHeldRow(11), taskHeldRow(12), taskHeldRow(4097)
	unknown.ObjectID, oversized.Target = -1, math.MaxInt64
	taskRows(t, held, unknown, oversized, outOfBounds)
	taskGrant(t, f, 1002, 10) // 同类但不是同一件道具。
	for _, id := range []int64{11, 12, 4097} {
		taskClaimRefused(t, f, id, apperrors.ErrTaskUnknown)
	}
	before := f.facts(t)
	if err := f.report("bag.held", math.MaxInt64); err != nil {
		t.Fatal(err)
	}
	if _, err := f.advance(10, math.MaxInt64); !errors.Is(err, apperrors.ErrTaskIncomplete) {
		t.Fatalf("anonymous advance: %v", err)
	}
	f.want(t, "progress injection", before)
	taskClaimRefused(t, f, 10, apperrors.ErrTaskIncomplete)
	taskGrant(t, f, 1001, 3)
	taskDiscard(t, f, 1001, 1)
	taskClaimRefused(t, f, 10, apperrors.ErrTaskIncomplete)
	taskGrant(t, f, 1001, 1)
	f.mustClaim(t, 10, 7, 7) // Day 尚未初始化，之前没有一次有效任务推进。
	if got := f.facts(t); got.day != 20261110 || len(got.progress) != 0 || !got.claimed[10] || taskHeld(t, f, 1001) != 3 {
		t.Fatalf("held claim wrote progress or consumed the item: %v", got)
	}
	taskClaimRefused(t, f, 10, apperrors.ErrTaskClaimed)
}

// 只改 item.json，不碰 task.json；没有缓存跨配置快照的道具有效性。
func testHeldBagReload(t *testing.T) {
	f := newTaskFixture(t)
	// 从当前目录选取未使用的号，避免与工程自带道具重名。
	var id int64 = 1
	for {
		if _, found := generated.ItemByID(id); !found {
			break
		}
		id++
	}
	held := taskHeldRow(10)
	held.ObjectID = id
	dir, store := taskRows(t, held)
	taskClaimRefused(t, f, 10, apperrors.ErrTaskUnknown)
	path := filepath.Join(dir, "item.json")
	original, err := os.ReadFile(path)
	if err != nil {
		t.Fatal(err)
	}
	var rows []json.RawMessage
	if err := json.Unmarshal(original, &rows); err != nil {
		t.Fatal(err)
	}
	item, err := json.Marshal(schema.Item{ID: id, Name: "held-reload-item", MaxStack: 9})
	if err != nil {
		t.Fatal(err)
	}
	added, err := json.Marshal(append(rows, item))
	if err != nil {
		t.Fatal(err)
	}
	reload := func(data []byte) {
		t.Helper()
		if err := os.WriteFile(path, data, 0600); err != nil {
			t.Fatal(err)
		}
		if _, err := store.Reload(context.Background()); err != nil {
			t.Fatal(err)
		}
	}
	reload(added)
	taskGrant(t, f, id, 3)
	reload(original) // 有存量但道具已下架，此时行无效。
	taskClaimRefused(t, f, 10, apperrors.ErrTaskUnknown)
	reload(added)
	f.mustClaim(t, 10, 7, 7)
}

func testHeldBagRollover(t *testing.T) {
	f := newTaskFixture(t)
	held := taskHeldRow(10)
	held.RewardKind, held.RewardID, held.RewardCount = "item", 1001, 2
	other := taskRow(11, "win", "daily")
	taskRows(t, held, other)
	f.mustAdvance(t, 11, 2, 2)
	f.mustClaim(t, 11, 7, 7)
	f.pass(24 * time.Hour)
	taskGrant(t, f, 1001, 99)
	taskClaimRefused(t, f, 10, apperrors.ErrBagStackFull)
	if taskHeld(t, f, 1001) != 99 {
		t.Fatal("rejected grant changed bag")
	}
	taskDiscard(t, f, 1001, 2)
	before := f.facts(t)
	f.committer.reject.Store(true)
	if _, err := f.claim(10); err == nil {
		t.Fatal("rejected commit accepted")
	}
	f.committer.reject.Store(false)
	f.want(t, "rejected rollover", before)
	if taskHeld(t, f, 1001) != 97 {
		t.Fatal("reward survived rejected rollover")
	}
	f.mustClaim(t, 10, 2, 7)
	if got := f.facts(t); got.day != 20261111 || len(got.progress) != 0 || len(got.claimed) != 1 || !got.claimed[10] || taskHeld(t, f, 1001) != 99 {
		t.Fatalf("rollover did not replace yesterday's facts: %v", got)
	}
	f.pass(-24 * time.Hour)
	taskClaimRefused(t, f, 10, apperrors.ErrTaskClaimed)
	f.pass(48 * time.Hour)
	f.mustAdvance(t, 11, 1, 1) // 新周期已建立，前一天的 claimed 已被惰性清掉。
	f.pass(-24 * time.Hour)
	taskClaimRefused(t, f, 10, apperrors.ErrTaskIncomplete)
}

func testHeldBagPredecessor(t *testing.T) {
	f := newTaskFixture(t)
	held, previous := taskHeldRow(10), taskRow(11, "win", "daily")
	held.Previous = 11
	taskRows(t, held, previous)
	taskGrant(t, f, 1001, 3)
	f.mustAdvance(t, 11, 2, 2)
	taskClaimRefused(t, f, 10, apperrors.ErrTaskIncomplete)
	f.mustClaim(t, 11, 7, 7)
	f.mustClaim(t, 10, 7, 14)
	f.pass(24 * time.Hour)
	taskClaimRefused(t, f, 10, apperrors.ErrTaskIncomplete) // 昨天领过不是今天已解锁。
	f.mustAdvance(t, 11, 2, 2)
	f.mustClaim(t, 11, 7, 21)
	f.mustClaim(t, 10, 7, 28)
}

func testHeldRewardCallback(t *testing.T) {
	f := newTaskFixture(t)
	held := taskHeldRow(10)
	held.RewardKind = "test_held_callback"
	received := taskRow(11, "reward.received", "daily")
	taskRows(t, held, received)
	f.mustAdvance(t, 11, 2, 2)
	f.pass(24 * time.Hour)
	taskGrant(t, f, 1001, 3)
	f.mustClaim(t, 10, 7, 7)
	if got := f.facts(t); got.day != 20261111 || len(got.progress) != 1 || got.progress[11] != 1 || !got.claimed[10] {
		t.Fatalf("reward callback progress lost: %v", got)
	}
}
