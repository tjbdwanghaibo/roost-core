package task

import (
	"{{MODULE}}/game/view"
	gamecheckin "{{MODULE}}/game/components/checkin"
)

// 首次业务事实与任务进度在同一笔事务里提交；事件提供方负责去重。
func init() {
	gamecheckin.OnCheckinClaimed("task", func(owner view.PlayerEntity, _ gamecheckin.CheckinResult, now int64) error {
		return owner.Task().Report("checkin.claimed", 1, now)
	})
}
