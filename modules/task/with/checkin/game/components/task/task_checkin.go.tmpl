package task

import "{{MODULE}}/game/event"

// OnCheckinClaimed 把今天签到成功作为 "checkin.claimed" 事件推进任务（每次记 1 次），与签到同一笔事务提交；
// 事件提供方负责去重（同一业务日只随成功的签到发布一次）。
//
// 缺省优先级：改成事件之前 checkin 的签到钩子只有 task 一个模块登记，没有别的模块监听需要排序。
//
//roost:listen
func (c *Component) OnCheckinClaimed(ev event.CheckinClaimed) error {
	return c.Report("checkin.claimed", 1, ev.NowUnixMilli)
}
