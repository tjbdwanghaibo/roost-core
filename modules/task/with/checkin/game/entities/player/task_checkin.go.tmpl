package player

import (
	"errors"

	apperrors "{{MODULE}}/internal/errors"
)

// 这个文件是 task 与 checkin 两个模块的联动：两个都装着时才有。
//
// 今天签到成功，就把每日任务“签到一次”（TaskDailyCheckin）推进一次，与签到在同一笔事务里：
// 签到提交了进度就在，签到回滚进度一起回滚，所以不用另外判重——一个业务日只有一次成功的签到。
//
// 任务表里已经没有这条任务（工程删了或换了号）时什么都不做：不能因为任务表改了就让玩家签不了到。
// 别的错误原样返回，签到随之回滚。要换成别的任务号、或一次签到推进多个任务，改这个文件。
func init() {
	OnCheckinClaimed("task", func(owner *Player, _ CheckinResult, nowUnixMilli int64) error {
		if _, err := owner.TaskComp().Advance(TaskDailyCheckin, 1, nowUnixMilli); err != nil && !errors.Is(err, apperrors.ErrTaskUnknown) {
			return err
		}
		return nil
	})
}
