package task

import "{{MODULE}}/game/event"

// OnDungeonClaimed 把副本第一次领奖作为 "dungeon.claimed" 事件推进任务（每局记 1 次），与领奖同一笔事务提交；
// 事件提供方负责去重（重复领取不发布）。
//
// 缺省优先级：改成事件之前 dungeon 的领奖钩子只有 task 一个模块登记，没有别的模块监听需要排序。
//
//roost:listen
func (c *Component) OnDungeonClaimed(ev event.DungeonClaimed) error {
	return c.Report("dungeon.claimed", 1, ev.NowUnixMilli)
}
