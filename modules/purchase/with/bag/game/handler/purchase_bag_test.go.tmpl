package handler

import (
	"context"
	"encoding/json"
	"os"
	"path/filepath"
	"testing"

	"{{MODULE}}/configs/schema"
	"{{MODULE}}/game/purchase"

	"github.com/tjbdwanghaibo/roost-core/framework/configdata"
	"github.com/tjbdwanghaibo/roost-core/infra/base/fctx"
)

func newPurchaseBag(t *testing.T) *purchaseFixture {
	t.Helper()
	purchaseBagLoadItems(t)
	return newPurchaseFixture(t)
}
func purchaseItemGrant() purchase.Grant {
	g := purchaseTestGrant(1)
	g.Reward = purchase.Reward{Kind: "item", ID: 1001, Count: 3}
	return g
}
func purchaseBagCount(t *testing.T, f *purchaseFixture) int64 {
	t.Helper()
	var count int64
	if err := f.engine.RunLocal(context.Background(), func() {
		f.target.GetMutex().Lock()
		defer f.target.GetMutex().Unlock()
		count = f.target.BagComp().Count(1001)
	}); err != nil {
		t.Fatal(err)
	}
	return count
}
func TestWithPurchaseBagGrantAndReplay(t *testing.T) {
	f := newPurchaseBag(t)
	first, err := f.apply(purchaseItemGrant())
	if err != nil {
		t.Fatal(err)
	}
	again, err := f.apply(purchaseItemGrant())
	if err != nil || first != again || purchaseBagCount(t, f) != 3 {
		t.Fatalf("replay=%+v first=%+v count=%d err=%v", again, first, purchaseBagCount(t, f), err)
	}
	f.expect(t, 1, 0, 1)
}
func TestWithPurchaseBagUnknownItemLeavesCursor(t *testing.T) {
	f := newPurchaseBag(t)
	g := purchaseItemGrant()
	g.Reward.ID = 999999
	if _, err := f.apply(g); err == nil {
		t.Fatal("unknown item accepted")
	}
	f.expect(t, 0, 0, 0)
	if purchaseBagCount(t, f) != 0 {
		t.Fatal("bag changed")
	}
}
func TestWithPurchaseBagOverflowLeavesCursor(t *testing.T) {
	f := newPurchaseBag(t)
	g := purchaseItemGrant()
	g.Reward.Count = 1000000
	if _, err := f.apply(g); err == nil {
		t.Fatal("overflow accepted")
	}
	f.expect(t, 0, 0, 0)
	if purchaseBagCount(t, f) != 0 {
		t.Fatal("bag changed")
	}
}
func TestWithPurchaseBagCommitFailureRollsBackBoth(t *testing.T) {
	f := newPurchaseBag(t)
	f.committer.reject.Store(true)
	if _, err := f.apply(purchaseItemGrant()); err == nil {
		t.Fatal("commit failure hidden")
	}
	f.expect(t, 0, 0, 0)
	if purchaseBagCount(t, f) != 0 {
		t.Fatal("bag changed")
	}
	f.committer.reject.Store(false)
	if _, err := f.apply(purchaseItemGrant()); err != nil {
		t.Fatal(err)
	}
	if purchaseBagCount(t, f) != 3 {
		t.Fatal("retry did not grant exactly once")
	}
	f.expect(t, 1, 0, 1)
}

// purchaseBagLoadItems 装载这组联动自带的道具表（1001 药水单种上限 99、1002 体力券单种上限 999），不读工程的
// configs/data：工程按 bag README 的“复用方式”换了道具表之后，这些场景照样成立。表按 bag 生成代码的
// 名字与键类型登记（item、int64），只登记这一张；测试结束时把进程级的缺省 Store 与配置快照换回。
func purchaseBagLoadItems(t *testing.T) {
	t.Helper()
	raw, err := json.Marshal([]schema.Item{{ID: 1001, Name: "potion", MaxStack: 99}, {ID: 1002, Name: "stamina ticket", MaxStack: 999}})
	if err != nil {
		t.Fatal(err)
	}
	dir := t.TempDir()
	if err := os.WriteFile(filepath.Join(dir, "item.json"), raw, 0o644); err != nil {
		t.Fatal(err)
	}
	registry := configdata.NewRegistry()
	if err := configdata.RegisterTable(registry, configdata.TableDef[int64, schema.Item]{
		Name: configdata.Name("item"), File: "item.json",
		Key: func(row schema.Item) int64 { return row.ID },
	}); err != nil {
		t.Fatal(err)
	}
	previousStore, previousConfig := configdata.DefaultStore(), fctx.RuntimeConfig()
	t.Cleanup(func() {
		configdata.SetDefaultStore(previousStore)
		fctx.SetRuntimeConfig(previousConfig)
	})
	if _, err := configdata.NewStore(registry, dir).Load(context.Background()); err != nil {
		t.Fatal(err)
	}
}
