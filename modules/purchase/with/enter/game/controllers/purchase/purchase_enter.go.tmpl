package purchase

import (
	"context"

	gamelogin "{{MODULE}}/game/login"
	"{{MODULE}}/game/purchase"

	"github.com/tjbdwanghaibo/roost-core/framework/app"
)

// 进入钩子在初始化事务之后、实体锁外执行。失败由 enter 记日志；玩家可用 PurchaseCollect 再领，不阻断进入。
func init() {
	gamelogin.OnEntered("purchase", func(ctx context.Context, registry *app.Registry, entered gamelogin.Entered) error {
		controller, err := FromRegistry(registry)
		if err != nil {
			return err
		}
		return collectOnEnter(ctx, controller, entered)
	})
}

type purchaseCollector interface {
	Collect(context.Context, int64) ([]purchase.Receipt, error)
}

func collectOnEnter(ctx context.Context, collector purchaseCollector, entered gamelogin.Entered) error {
	_, err := collector.Collect(ctx, entered.PlayerID)
	return err
}
