package controllers

import (
	"context"

	"github.com/tjbdwanghaibo/roost-core/framework/app"
	gamelogin "{{MODULE}}/game/modules/login"
	"{{MODULE}}/game/modules/purchase"
)

// 进入钩子在初始化事务之后、实体锁外执行。失败由 enter 记日志；玩家可用 PurchaseCollect 再领，不阻断进入。
func init() {
	gamelogin.OnEntered("purchase", func(ctx context.Context, registry *app.Registry, entered gamelogin.Entered) error {
		deps, err := purchaseDepsFromRegistry(registry)
		if err != nil {
			return err
		}
		return purchaseCollectOnEnter(ctx, deps, entered)
	})
}

type purchaseCollector interface {
	Collect(context.Context, int64) ([]purchase.Receipt, error)
}

func purchaseCollectOnEnter(ctx context.Context, collector purchaseCollector, entered gamelogin.Entered) error {
	_, err := collector.Collect(ctx, entered.PlayerID)
	return err
}
