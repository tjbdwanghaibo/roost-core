package purchase

import (
	"context"
	"fmt"
	"sync/atomic"
	"testing"

	player "{{MODULE}}/game/entities/player"
	"{{MODULE}}/game/handler"
	syncsender "{{MODULE}}/game/handler/syncsender"
	"{{MODULE}}/game/purchase"

	"github.com/tjbdwanghaibo/roost-core/framework/dataengine"
	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/framework/nest"
)

type purchaseGetter map[int64]entity.IThreadSafeEntity

func (g purchaseGetter) Get(_ context.Context, id int64, _ entity.EntityCategory) (entity.IThreadSafeEntity, error) {
	if target := g[id]; target != nil {
		return target, nil
	}
	return nil, fmt.Errorf("missing %d", id)
}
func (g purchaseGetter) GetMany(ctx context.Context, ids []int64, categories []entity.EntityCategory) ([]entity.IThreadSafeEntity, error) {
	targets := make([]entity.IThreadSafeEntity, len(ids))
	for i, id := range ids {
		target, err := g.Get(ctx, id, categories[i])
		if err != nil {
			return nil, err
		}
		targets[i] = target
	}
	return targets, nil
}

type purchaseCommitter struct {
	reject  atomic.Bool
	commits atomic.Int64
}

func (c *purchaseCommitter) Commit(context.Context, dataengine.CommitRecord) error {
	if c.reject.Load() {
		return fmt.Errorf("injected purchase commit failure")
	}
	c.commits.Add(1)
	return nil
}

type purchaseFixture struct {
	engine    *nest.NestMgr
	target    *player.Player
	committer *purchaseCommitter
	sender    *syncsender.PurchaseGrantSender
}

func newPurchaseFixture(t *testing.T) *purchaseFixture {
	t.Helper()
	player.RegisterEntity()
	handler.RegisterPurchaseGrantNestHandlers()
	id, err := entity.BuildEntityID(98801, player.EntityKindPlayer)
	if err != nil {
		t.Fatal(err)
	}
	target, err := entity.BuildEntity(&entity.EntityCreateParam{IsCreate: true, Id: id, Kind: player.EntityKindPlayer})
	if err != nil {
		t.Fatal(err)
	}
	f := &purchaseFixture{target: target.(*player.Player), committer: &purchaseCommitter{}}
	f.engine = nest.NewEngine(nest.NestOptionWithGetter(purchaseGetter{id: target}), nest.NestOptionWithTransactionCommitter(f.committer), nest.NestOptionWithWorkerPools(nest.WorkerPoolConfig{Workers: 2, QueueCap: 64}, nest.WorkerPoolConfig{}, nest.WorkerPoolConfig{}))
	if err := f.engine.Start(); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := f.engine.Shutdown(context.Background()); err != nil {
			t.Error(err)
		}
	})
	f.sender = syncsender.NewPurchaseGrantSender(f.engine)
	return f
}
func purchaseTestGrant(seq uint64) purchase.Grant {
	return purchase.Grant{Sequence: seq, OrderID: fmt.Sprintf("order-%d", seq), PlayerID: 98801, ProductID: "coins_100", Digest: fmt.Sprintf("digest-%d", seq), Reward: purchase.Reward{Kind: "coins", Count: 100}}
}
func (f *purchaseFixture) apply(grant purchase.Grant) (purchase.Receipt, error) {
	return f.sender.Sync_PurchaseGrant(context.Background(), f.target.ID(), grant)
}
func (f *purchaseFixture) facts(t *testing.T) (uint64, int64) {
	t.Helper()
	var sequence uint64
	var coins int64
	if err := f.engine.RunLocal(context.Background(), func() {
		f.target.GetMutex().Lock()
		defer f.target.GetMutex().Unlock()
		sequence = f.target.Dao().GetPurchase().GetApplied()
		coins = f.target.WalletComp().Balance()
	}); err != nil {
		t.Fatal(err)
	}
	return sequence, coins
}
func (f *purchaseFixture) expect(t *testing.T, sequence uint64, coins, commits int64) {
	t.Helper()
	gotSeq, gotCoins := f.facts(t)
	if gotSeq != sequence || gotCoins != coins || f.committer.commits.Load() != commits {
		t.Fatalf("facts seq=%d coins=%d commits=%d", gotSeq, gotCoins, f.committer.commits.Load())
	}
}
