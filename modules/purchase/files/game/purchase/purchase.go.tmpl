// Package purchase 定义付款后的发货事实。platform 与 game 共用，不依赖 Entity，也不在这里修改玩家。
package purchase

import (
	"context"
	"fmt"
	"strings"

	"{{MODULE}}/game/view"
	apperrors "{{MODULE}}/internal/errors"

	svcplatform "github.com/tjbdwanghaibo/roost-core/service/platform"
)

// BatchLimit 是单次进入或补领处理的订单数；更多订单由下一次调用继续，不丢弃、不一次读全量。
const BatchLimit = 32

// Reward、Grant、Receipt 的定义在 game/view（view.PurchaseGrantReward / PurchaseGrant / PurchaseReceipt），
// 这里留同名别名：组件接口 view.Purchase 的 Apply 收发货快照、返回回执，handler 与平台侧照旧写 purchase.Grant。
type (
	Reward  = view.PurchaseGrantReward
	Grant   = view.PurchaseGrant
	Receipt = view.PurchaseReceipt
)

// ValidateGrant 检查一份发货快照是否完整（原 Grant.Validate；方法跟着类型进了 view，
// 这里要用工程错误码与平台的订单号上限，view 不引用它们，所以改成函数）。
func ValidateGrant(g Grant) error {
	if g.Sequence == 0 || g.PlayerID <= 0 || strings.TrimSpace(g.OrderID) == "" || len(g.OrderID) > svcplatform.MaxOrderIDBytes || g.Digest == "" || g.ProductID == "" || g.Reward.Kind == "" || g.Reward.Count <= 0 {
		return apperrors.ErrPurchaseInvalid
	}
	return nil
}

// Queue 的待发事实必须持久且按玩家连续编号。Ack 只能在 Nest 已确认发货且平台投递已终结后调用。
type Queue interface {
	Record(context.Context, svcplatform.Order) (Grant, error)
	Pending(context.Context, int64, int) ([]Grant, error)
	Ack(context.Context, Grant) error
}

func sameOrder(grant Grant, order svcplatform.Order) error {
	if grant.OrderID != order.OrderID || grant.PlayerID != order.PlayerID || grant.ProductID != order.ProductID || grant.Digest != order.PayloadDigest {
		return fmt.Errorf("%w: queued grant differs from platform order", svcplatform.ErrOrderMismatch)
	}
	return nil
}
