package player

import (
	"{{MODULE}}/game/components/purchase"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:Purchase}}
const CompTypePurchase entity.ComponentType = {{ID:component:Purchase}}

// PurchaseComponent 是 game/components/purchase 的组件在 Player 上的名字（生成接线与 handler 用它）；业务在那个包里。
type PurchaseComponent = purchase.Component

type IPurchaseEntity interface {
	entity.IThreadSafeEntity
	PurchaseComp() *PurchaseComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypePurchase, purchase.NewComponent)
}
