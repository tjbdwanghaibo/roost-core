// leaderboardFakeRank 是 rank 客户端的内存替身，按 service/rank 写明的语义实现本模块用到的部分：
// 三种合并方式、每个玩家最近 8 个请求号的去重环、Tie 为 0 时填提交先后、分高在前同分 Tie 小在前、
// 条数必须在 [1, 200]。它让“提交 → 查前 N → 查自己”能离线跑通，并记下端点交给 rank 的榜与条数。
//
// 它的边界：这是照接口文档写的替身，不是 rank 服务本身——真实的 Redis 脚本、跨进程调用、
// 并发下的 compare-and-swap 都不在这里；那些由 roost-core 的 service/rank 自己的测试覆盖。
type leaderboardFakeRank struct {
	mu     sync.Mutex
	boards map[svcrank.Board]map[int64]*leaderboardFakeRow
	clock  int64

	// 记下每次调用用的榜与 Page 收到的条数：端点不该读别的榜，也不该把超限的条数交给 rank。
	seenBoards []svcrank.Board
	pageLimits []int
	rankOwners []int64

	// 让下一次读失败 / 让 Rank 回答“找到但名次 0”（真实服务在两次读之间这一行被删掉时的回答）。
	pageErr  error
	rankErr  error
	vanished bool
}

type leaderboardFakeRow struct {
	value int64
	tie   int64
	ring  []string
}

func newLeaderboardFakeRank() *leaderboardFakeRank {
	return &leaderboardFakeRank{boards: make(map[svcrank.Board]map[int64]*leaderboardFakeRow)}
}

func (fake *leaderboardFakeRank) Submit(_ context.Context, board svcrank.Board, score svcrank.Score, mode svcrank.UpdateMode, requestID string) (svcrank.Entry, error) {
	fake.mu.Lock()
	defer fake.mu.Unlock()
	fake.seenBoards = append(fake.seenBoards, board)
	if err := board.Validate(); err != nil {
		return svcrank.Entry{}, err
	}
	if score.OwnerID == 0 {
		return svcrank.Entry{}, svcrank.ErrOwnerInvalid
	}
	if mode == svcrank.UpdateAdd && requestID == "" {
		return svcrank.Entry{}, svcrank.ErrRequestInvalid
	}
	fake.clock++
	if score.Tie == 0 {
		score.Tie = fake.clock
	}
	rows := fake.boards[board]
	if rows == nil {
		rows = make(map[int64]*leaderboardFakeRow)
		fake.boards[board] = rows
	}
	row := rows[score.OwnerID]
	if row != nil && requestID != "" {
		for _, applied := range row.ring {
			if applied == requestID {
				return fake.entryLocked(board, score.OwnerID), nil
			}
		}
	}
	switch {
	case row == nil:
		row = &leaderboardFakeRow{value: score.Value, tie: score.Tie}
		rows[score.OwnerID] = row
	case mode == svcrank.UpdateSet:
		row.value, row.tie = score.Value, score.Tie
	case mode == svcrank.UpdateMax:
		// 分数更高才换；相同分数保留较早的 Tie，重复提交不会把人往后挪。
		if score.Value > row.value {
			row.value, row.tie = score.Value, score.Tie
		}
	case mode == svcrank.UpdateAdd:
		row.value, row.tie = row.value+score.Value, score.Tie
	default:
		return svcrank.Entry{}, svcrank.ErrScoreInvalid
	}
	if requestID != "" {
		row.ring = append(row.ring, requestID)
		if len(row.ring) > 8 {
			row.ring = row.ring[len(row.ring)-8:]
		}
	}
	return fake.entryLocked(board, score.OwnerID), nil
}

// orderedLocked 是一张榜按名次排好的玩家号：分高在前，同分 Tie 小在前，再同按玩家号小在前。
func (fake *leaderboardFakeRank) orderedLocked(board svcrank.Board) []int64 {
	rows := fake.boards[board]
	owners := make([]int64, 0, len(rows))
	for owner := range rows {
		owners = append(owners, owner)
	}
	sort.Slice(owners, func(i, j int) bool {
		a, b := rows[owners[i]], rows[owners[j]]
		if a.value != b.value {
			return a.value > b.value
		}
		if a.tie != b.tie {
			return a.tie < b.tie
		}
		return owners[i] < owners[j]
	})
	return owners
}

func (fake *leaderboardFakeRank) entryLocked(board svcrank.Board, ownerID int64) svcrank.Entry {
	for index, owner := range fake.orderedLocked(board) {
		if owner == ownerID {
			row := fake.boards[board][owner]
			return svcrank.Entry{Rank: int64(index) + 1, Score: svcrank.Score{OwnerID: owner, Value: row.value, Tie: row.tie}}
		}
	}
	return svcrank.Entry{}
}

func (fake *leaderboardFakeRank) Page(_ context.Context, board svcrank.Board, offset, limit int) (svcrank.Page, error) {
	fake.mu.Lock()
	defer fake.mu.Unlock()
	fake.seenBoards = append(fake.seenBoards, board)
	fake.pageLimits = append(fake.pageLimits, limit)
	if fake.pageErr != nil {
		return svcrank.Page{}, fake.pageErr
	}
	if offset < 0 || limit <= 0 || limit > 200 {
		return svcrank.Page{}, fmt.Errorf("%w: offset %d limit %d", svcrank.ErrRangeInvalid, offset, limit)
	}
	owners := fake.orderedLocked(board)
	page := svcrank.Page{Total: int64(len(owners))}
	for index := offset; index < len(owners) && index < offset+limit; index++ {
		row := fake.boards[board][owners[index]]
		page.Entries = append(page.Entries, svcrank.Entry{
			Rank: int64(index) + 1, Score: svcrank.Score{OwnerID: owners[index], Value: row.value, Tie: row.tie},
		})
	}
	return page, nil
}

func (fake *leaderboardFakeRank) Rank(_ context.Context, board svcrank.Board, ownerID int64) (svcrank.Entry, bool, error) {
	fake.mu.Lock()
	defer fake.mu.Unlock()
	fake.seenBoards = append(fake.seenBoards, board)
	fake.rankOwners = append(fake.rankOwners, ownerID)
	if fake.rankErr != nil {
		return svcrank.Entry{}, false, fake.rankErr
	}
	row := fake.boards[board][ownerID]
	if row == nil {
		return svcrank.Entry{}, false, nil
	}
	if fake.vanished {
		return svcrank.Entry{Rank: 0, Score: svcrank.Score{OwnerID: ownerID, Value: row.value, Tie: row.tie}}, true, nil
	}
	return fake.entryLocked(board, ownerID), true, nil
}

