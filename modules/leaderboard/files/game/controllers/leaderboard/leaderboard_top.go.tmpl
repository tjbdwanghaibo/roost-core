package leaderboard

import (
	"fmt"
	"log/slog"

	gameleaderboard "{{MODULE}}/game/leaderboard"
	"github.com/tjbdwanghaibo/roost-core/infra/network/playeraccess"
	"{{MODULE}}/protocol/pb"

	"github.com/tjbdwanghaibo/roost-core/infra/base/errcode"
)

// HandleLeaderboardTop 读榜头，连同调用者自己的位置：跨进程的类型化调用，不涉及 Entity 锁。
// 读哪张榜由服务端定（gameleaderboard.CurrentBoard），请求只带条数，条数收进上限之后才交给 rank 服务。
//
// 榜头说不了不在这一页上的人的事，而“我在哪”是客户端画榜时真正要问的，所以回包里带上调用者自己的位置：
// 他就在这一页上时取那一行（同一次读取，榜头与“我”不会互相矛盾）；不在时再向 rank 读一次他的名次，
// 这两次读可以相差一瞬。没上榜不是错误。第二次读失败时整条请求按失败回答，不回半截数据——
// 回一个“没上榜”等于把读失败说成事实。
func (controller *Controller) HandleLeaderboardTop(context *playeraccess.Context, request *pb.LeaderboardTopRequest) (*pb.LeaderboardTopResponse, error) {
	if context == nil || request == nil {
		return nil, fmt.Errorf("leaderboard_top endpoint: context and request are required")
	}
	board := gameleaderboard.CurrentBoard()
	page, err := controller.ranking.Page(context.Context(), board, 0, gameleaderboard.TopLimit(request.Limit))
	if err != nil {
		return leaderboardTopFailure(context.PlayerID, "page", err), nil
	}
	response := &pb.LeaderboardTopResponse{Total: page.Total}
	onPage := false
	for _, entry := range page.Entries {
		response.Rows = append(response.Rows, pb.LeaderboardRow{
			Rank: entry.Rank, PlayerID: entry.Score.OwnerID, Score: entry.Score.Value,
		})
		if entry.Score.OwnerID == context.PlayerID && !onPage {
			onPage = true
			standing := gameleaderboard.StandingOf(entry, true)
			response.MyOnBoard, response.MyRank, response.MyScore = standing.OnBoard, standing.Rank, standing.Score
		}
	}
	if onPage {
		return response, nil
	}
	entry, found, err := controller.ranking.Rank(context.Context(), board, context.PlayerID)
	if err != nil {
		return leaderboardTopFailure(context.PlayerID, "own standing", err), nil
	}
	standing := gameleaderboard.StandingOf(entry, found)
	response.MyOnBoard, response.MyRank, response.MyScore = standing.OnBoard, standing.Rank, standing.Score
	return response, nil
}

// leaderboardTopFailure 把 rank 服务的失败换成回包：带码的原样给客户端，不带码的记日志、回内部错误。
func leaderboardTopFailure(playerID int64, step string, err error) *pb.LeaderboardTopResponse {
	code, reason := errcode.ClientError(err)
	if code == errcode.CodeInternal {
		slog.Error("leaderboard_top failed", "player_id", playerID, "step", step, "err", err)
	}
	return &pb.LeaderboardTopResponse{Code: code, Reason: reason}
}
