// leaderboardSubmitCall 是替身记下的一次 Submit：本模块交给 rank 服务的全部内容。
type leaderboardSubmitCall struct {
	board     svcrank.Board
	score     svcrank.Score
	mode      svcrank.UpdateMode
	requestID string
}

// leaderboardRecordingRank 是 rank 客户端的记录式替身：只记下 Submit 收到了什么、回答预先给定的结果。
// 它不模拟榜的行为；这里测的是“本模块向 rank 发了什么、对回答做了什么”。
type leaderboardRecordingRank struct {
	calls []leaderboardSubmitCall
	entry svcrank.Entry
	err   error
}

func (fake *leaderboardRecordingRank) Submit(_ context.Context, board svcrank.Board, score svcrank.Score, mode svcrank.UpdateMode, requestID string) (svcrank.Entry, error) {
	fake.calls = append(fake.calls, leaderboardSubmitCall{board: board, score: score, mode: mode, requestID: requestID})
	return fake.entry, fake.err
}

func (fake *leaderboardRecordingRank) Remove(context.Context, svcrank.Board, int64) error {
	return errors.New("leaderboard test: Remove is not part of this module")
}

func (fake *leaderboardRecordingRank) Page(context.Context, svcrank.Board, int, int) (svcrank.Page, error) {
	return svcrank.Page{}, errors.New("leaderboard test: Page is not used by Submit")
}

func (fake *leaderboardRecordingRank) Rank(context.Context, svcrank.Board, int64) (svcrank.Entry, bool, error) {
	return svcrank.Entry{}, false, errors.New("leaderboard test: Rank is not used by Submit")
}

func (fake *leaderboardRecordingRank) Around(context.Context, svcrank.Board, int64, int) (svcrank.Page, error) {
	return svcrank.Page{}, errors.New("leaderboard test: Around is not part of this module")
}

func (fake *leaderboardRecordingRank) Size(context.Context, svcrank.Board) (int64, error) {
	return 0, errors.New("leaderboard test: Size is not part of this module")
}

// leaderboardRegistryWith 建一个只发布了 rank 能力的 Registry，与 ClientMod 在真实进程里发布的名字相同。
func leaderboardRegistryWith(t *testing.T, client svcrank.Rank) *app.Registry {
	t.Helper()
	registry := app.NewRegistry(nil)
	if err := registry.Register(svcrank.CapabilityName, client); err != nil {
		t.Fatal(err)
	}
	return registry
}

// 这个文件的用例只按名字引用榜的规则（BoardID、CurrentSeason、MinScore、MaxScore、DefaultTop、MaxTop），
// 工程改了 leaderboard_board.go 之后不用动它；规则具体是多少由 leaderboard_board_test.go 钉住。

func TestLeaderboardCurrentBoardIsTheBoardOfTheCurrentSeason(t *testing.T) {
	season := CurrentSeason()
	if season <= 0 {
		t.Fatalf("CurrentSeason() = %d, must be positive", season)
	}
	if CurrentBoard() != Board(season) {
		t.Fatalf("CurrentBoard() = %+v, want Board(%d) = %+v", CurrentBoard(), season, Board(season))
	}
	// 不同周期是不同的榜，而且只差在周期上：换周期不该换榜名或范围。
	next := Board(season + 1)
	if next.Season != season+1 {
		t.Fatalf("Board(%d).Season = %d: the season the caller names must be the board's season", season+1, next.Season)
	}
	next.Season = season
	if next != Board(season) {
		t.Fatalf("Board(%d) and Board(%d) differ in more than the season: %+v vs %+v", season+1, season, Board(season+1), Board(season))
	}
}

func TestLeaderboardValidateScoreAcceptsExactlyTheRange(t *testing.T) {
	for _, total := range []int64{MinScore, MaxScore} {
		if err := ValidateScore(total); err != nil {
			t.Errorf("total %d (an end of the range) refused: %v", total, err)
		}
	}
	for _, total := range []int64{MinScore - 1, MaxScore + 1} {
		err := ValidateScore(total)
		if err == nil {
			t.Errorf("total %d (just outside the range) accepted", total)
			continue
		}
		if !errors.Is(err, svcrank.ErrScoreInvalid) {
			t.Errorf("total %d: error %v does not carry the score-invalid code", total, err)
		}
	}
}

func TestLeaderboardTopLimitIsClampedIntoOneToMaxTop(t *testing.T) {
	for _, c := range []struct {
		requested int32
		want      int
	}{
		{0, DefaultTop}, {-1, DefaultTop}, {-2147483648, DefaultTop},
		{1, 1}, {MaxTop, MaxTop},
		{MaxTop + 1, MaxTop}, {2147483647, MaxTop},
	} {
		if got := TopLimit(c.requested); got != c.want {
			t.Errorf("TopLimit(%d) = %d, want %d", c.requested, got, c.want)
		}
	}
	// 收进范围之后的每个值都是 rank 服务肯收的条数。
	for requested := int32(-2); requested <= MaxTop+2; requested++ {
		if got := TopLimit(requested); got < 1 || got > MaxTop || got > svcrank.MaxPageSize {
			t.Fatalf("TopLimit(%d) = %d, outside [1, %d]", requested, got, MaxTop)
		}
	}
}

func TestLeaderboardStandingIsOffBoardUnlessFoundWithARank(t *testing.T) {
	entry := svcrank.Entry{Rank: 3, Score: svcrank.Score{OwnerID: 1001, Value: 70}}
	if got := StandingOf(entry, true); got != (Standing{OnBoard: true, Rank: 3, Score: 70}) {
		t.Fatalf("found at rank 3: %+v", got)
	}
	if got := StandingOf(svcrank.Entry{}, false); got != (Standing{}) {
		t.Fatalf("not found: %+v", got)
	}
	// 没找到时不管 entry 里有什么，回答都是全零：客户端不该看到“没上榜、70 分”。
	if got := StandingOf(entry, false); got != (Standing{}) {
		t.Fatalf("not found but an entry was passed: %+v", got)
	}
	// rank 服务在读分数与读名次之间这一行被删掉时回名次 0。
	vanished := svcrank.Entry{Rank: 0, Score: svcrank.Score{OwnerID: 1001, Value: 70}}
	if got := StandingOf(vanished, true); got != (Standing{}) {
		t.Fatalf("found with rank 0 must read as off the board: %+v", got)
	}
}

func TestLeaderboardSubmitSendsASnapshotWithMaxAndNoRequestID(t *testing.T) {
	fake := &leaderboardRecordingRank{entry: svcrank.Entry{Rank: 4, Score: svcrank.Score{OwnerID: 1001, Value: MinScore + 119}}}
	standing, err := Submit(context.Background(), leaderboardRegistryWith(t, fake), 1001, MinScore+119)
	if err != nil {
		t.Fatal(err)
	}
	if standing != (Standing{OnBoard: true, Rank: 4, Score: MinScore + 119}) {
		t.Fatalf("standing = %+v", standing)
	}
	if len(fake.calls) != 1 {
		t.Fatalf("rank received %d submits, want 1", len(fake.calls))
	}
	call := fake.calls[0]
	if call.board != CurrentBoard() {
		t.Errorf("board = %+v, want the current season's board %+v", call.board, CurrentBoard())
	}
	if call.mode != svcrank.UpdateMax {
		t.Errorf("mode = %q: a total is a snapshot and must be submitted with max, never add or set", call.mode)
	}
	if call.score.OwnerID != 1001 || call.score.Value != MinScore+119 {
		t.Errorf("score = %+v, want owner 1001 value %d", call.score, MinScore+119)
	}
	if call.score.Tie != 0 {
		t.Errorf("tie = %d: it must stay zero so the rank service stamps the time the score was reached", call.score.Tie)
	}
	if len(call.score.Brief) != 0 {
		t.Errorf("brief = %q: the board stores no display data", call.score.Brief)
	}
	// 快照加 UpdateMax 本身幂等；带请求号会让 rank 对没变的分数也写一次（记进去重环）。
	if call.requestID != "" {
		t.Errorf("request id = %q, want none", call.requestID)
	}
}

func TestLeaderboardSubmitSeasonGoesToTheSeasonTheCallerNamed(t *testing.T) {
	fake := &leaderboardRecordingRank{entry: svcrank.Entry{Rank: 1, Score: svcrank.Score{OwnerID: 1001, Value: MinScore}}}
	registry := leaderboardRegistryWith(t, fake)
	// 调用方按它记账用的周期提交：不管现在是哪个周期，分数进的是它说的那一期的榜。
	other := CurrentSeason() + 3
	standing, err := SubmitSeason(context.Background(), registry, other, 1001, MinScore)
	if err != nil {
		t.Fatal(err)
	}
	if standing != (Standing{OnBoard: true, Rank: 1, Score: MinScore}) {
		t.Fatalf("standing = %+v", standing)
	}
	if len(fake.calls) != 1 || fake.calls[0].board != Board(other) || fake.calls[0].board == CurrentBoard() {
		t.Fatalf("calls = %+v, want one submit to Board(%d) = %+v", fake.calls, other, Board(other))
	}
	if call := fake.calls[0]; call.mode != svcrank.UpdateMax || call.requestID != "" || call.score.Value != MinScore {
		t.Fatalf("SubmitSeason must submit exactly like Submit: %+v", call)
	}
	// 周期号不为正在发出调用之前被拒：0 多半是调用方忘了取。
	for _, season := range []int64{0, -1} {
		if _, err := SubmitSeason(context.Background(), registry, season, 1001, MinScore); !errors.Is(err, svcrank.ErrBoardInvalid) {
			t.Errorf("season %d: error %v, want it to carry the board-invalid code", season, err)
		}
	}
	if len(fake.calls) != 1 {
		t.Fatalf("a refused season reached the rank service: %+v", fake.calls)
	}
}

func TestLeaderboardSubmitRefusesBadInputBeforeCallingRank(t *testing.T) {
	fake := &leaderboardRecordingRank{}
	registry := leaderboardRegistryWith(t, fake)
	type refusal struct {
		name     string
		playerID int64
		total    int64
		want     error
	}
	for _, c := range []refusal{
		{"player zero", 0, MinScore, svcrank.ErrOwnerInvalid},
		{"negative player", -5, MinScore, svcrank.ErrOwnerInvalid},
		{"total below the range", 1001, MinScore - 1, svcrank.ErrScoreInvalid},
		{"total far below the range", 1001, MinScore - 11, svcrank.ErrScoreInvalid},
		{"total above the range", 1001, MaxScore + 1, svcrank.ErrScoreInvalid},
	} {
		standing, err := Submit(context.Background(), registry, c.playerID, c.total)
		if err == nil {
			t.Errorf("%s: accepted", c.name)
			continue
		}
		if !errors.Is(err, c.want) {
			t.Errorf("%s: error %v, want it to carry %v", c.name, err, c.want)
		}
		if standing != (Standing{}) {
			t.Errorf("%s: a refusal returned standing %+v", c.name, standing)
		}
	}
	if len(fake.calls) != 0 {
		t.Fatalf("refused submits reached the rank service %d times: %+v", len(fake.calls), fake.calls)
	}
	// 边界内侧：范围两端的总分都能提交。
	for _, total := range []int64{MinScore, MaxScore} {
		if _, err := Submit(context.Background(), registry, 1001, total); err != nil {
			t.Fatalf("total %d (an end of the range): %v", total, err)
		}
	}
	if len(fake.calls) != 2 {
		t.Fatalf("the legal submits reached rank %d times", len(fake.calls))
	}
}

func TestLeaderboardSubmitReturnsRankFailureToTheCaller(t *testing.T) {
	fake := &leaderboardRecordingRank{
		// 失败时 rank 可能仍带回一个值；调用方不该把它当成榜上的位置。
		entry: svcrank.Entry{Rank: 9, Score: svcrank.Score{OwnerID: 1001, Value: MinScore}},
		err:   svcrank.ErrConflict,
	}
	standing, err := Submit(context.Background(), leaderboardRegistryWith(t, fake), 1001, MinScore)
	if !errors.Is(err, svcrank.ErrConflict) {
		t.Fatalf("error = %v, want the rank service's own error so the caller can log and move on", err)
	}
	if standing != (Standing{}) {
		t.Fatalf("a failed submit returned standing %+v", standing)
	}
	if len(fake.calls) != 1 {
		t.Fatalf("Submit called rank %d times; retrying is the caller's decision", len(fake.calls))
	}
}

func TestLeaderboardSubmitNeedsTheRankCapability(t *testing.T) {
	if _, err := Submit(context.Background(), nil, 1001, MinScore); err == nil {
		t.Fatal("a nil registry was accepted")
	}
	_, err := Submit(context.Background(), app.NewRegistry(nil), 1001, MinScore)
	if err == nil {
		t.Fatal("a registry without the rank client was accepted")
	}
	if !strings.Contains(err.Error(), "uses") {
		t.Fatalf("error %q does not say how to get the capability (services.<service>.uses)", err)
	}
	if _, err := Client(leaderboardRegistryWith(t, &leaderboardRecordingRank{})); err != nil {
		t.Fatalf("a registry with the rank client: %v", err)
	}
}
