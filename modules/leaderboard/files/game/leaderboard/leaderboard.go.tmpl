// Package leaderboard 是排行榜在本工程这一侧的约定：有哪些榜、一分是什么、多少分算合法、
// 怎么把玩家报给 rank 托管服务，以及服务端别的功能提交分数的唯一入口 Submit。
//
// rank 服务只给数字排名，不关心数字代表什么（它是通用的：榜名、周期、合并方式都由调用方每次带上）。
// 与游戏有关的决定都在这个文件里；端点（game/controllers/leaderboard）与提交分数的功能都 import 它，
// 因此读榜和写榜用的是同一张榜的同一份定义。
//
// 本模块没有自己的状态：玩家的总分由产生分数的功能保存在它自己的状态里，榜只是那个数的投影。
package leaderboard

import (
	"context"
	"fmt"

	"github.com/tjbdwanghaibo/roost-core/framework/app"
	svcrank "github.com/tjbdwanghaibo/roost-core/service/rank"
)

// 总分榜：本模块唯一的榜。
//
//   - 范围：全服一张（ScopeGlobal）。分区的游戏改成 ScopeServer 并把区号放进 ScopeID。
//   - 周期：只有一个周期 CurrentSeason。rank 服务不会自己换周期，也不在总线上开放清榜：
//     换周期是运维动作——改 CurrentSeason 后发版，新榜从空开始，旧榜原样留在 rank 里。
//     总分若是终身累计，玩家在新周期的第一次提交就是他的终身总分；要让新周期从 0 起算，
//     由持有总分的功能按周期分开存，这里不替它决定。
//   - 排序：分高的在前；同分时先达到这个分数的在前（rank 服务把首次达到的时间记作 Tie，
//     UpdateMax 对相同分数保留较早的 Tie），不是玩家号小的在前。
const (
	TotalBoardID        = "total"
	CurrentSeason int64 = 1
)

// TotalBoard 是总分榜在 rank 服务里的身份。读与写都用它，榜名不从客户端收。
func TotalBoard() svcrank.Board {
	return svcrank.Board{ID: TotalBoardID, Scope: svcrank.ScopeGlobal, Season: CurrentSeason}
}

// 总分的合法范围，两端都含。
//
//   - 下限 1：0 分等于“还没有成绩”，不上榜——否则榜尾是一长串什么都没做过的玩家。
//   - 上限一万亿：远高于正常玩法能到的数，只用来挡住算错的值（溢出、单位弄错）。
//     榜只升不降（见 Submit），一个错的大数提交上去之后，后面正确的提交压不下来。
const (
	MinScore int64 = 1
	MaxScore int64 = 1_000_000_000_000
)

// ValidateScore 检查一个总分能不能上榜。
func ValidateScore(total int64) error {
	if total < MinScore || total > MaxScore {
		return fmt.Errorf("%w: total score %d is outside [%d, %d]", svcrank.ErrScoreInvalid, total, MinScore, MaxScore)
	}
	return nil
}

// 查前 N 名的条数：不填按 DefaultTop，上限 MaxTop。上限低于 rank 服务自己的页上限
// （svcrank.MaxPageSize），是这个游戏一屏榜单的长度，不是服务的能力边界。
const (
	DefaultTop = 10
	MaxTop     = 50
)

// TopLimit 把客户端要的条数收进 [1, MaxTop]：0 或负数按 DefaultTop，超过 MaxTop 按 MaxTop。
// 收而不拒：客户端多要只是少拿几行，没有哪种取值值得让这条只读请求失败；
// 但也绝不把 0 原样交给下游当“不限”。
func TopLimit(requested int32) int {
	if requested <= 0 {
		return DefaultTop
	}
	if requested > MaxTop {
		return MaxTop
	}
	return int(requested)
}

// PlayerScore 把一名玩家的总分报给 rank 服务：榜上的所有者就是玩家号。
// Tie 留 0，由 rank 服务填提交时刻（业务时钟），于是同分先到者在前。
// Brief 留空：榜不保存名字、头像这类显示资料——它们会变，存在榜上就是过期的快照；
// 客户端按玩家号另取。
func PlayerScore(playerID, total int64) svcrank.Score {
	return svcrank.Score{OwnerID: playerID, Value: total}
}

// MaxRequestKeyBytes 是幂等键的长度上限。rank 服务把每个玩家最近几个键存在榜的记录里，
// 键不设上限就是让调用方决定那条记录有多大。
const MaxRequestKeyBytes = 128

// Standing 是一名玩家在总分榜上的位置。OnBoard 为 false 时 Rank 与 Score 都是 0。
type Standing struct {
	OnBoard bool
	Rank    int64
	Score   int64
}

// StandingOf 把 rank 服务对“这个玩家在哪”的回答换成 Standing。
// 没找到是“没上榜”；找到但名次不是正数也按没上榜回答——rank 服务在读分数与读名次之间
// 这一行被删掉时会回名次 0，“在榜上、第 0 名”不是一个能给客户端的答案。
func StandingOf(entry svcrank.Entry, found bool) Standing {
	if !found || entry.Rank <= 0 {
		return Standing{}
	}
	return Standing{OnBoard: true, Rank: entry.Rank, Score: entry.Score.Value}
}

// Client 取 rank 服务的客户端（业务服务在 roost.yaml 里 uses: [rank] 时由 ClientMod 发布）。
// 端点在启动时取一次；Submit 每次调用取一次（一次带读锁的查表）。
func Client(registry *app.Registry) (svcrank.Rank, error) {
	if registry == nil {
		return nil, fmt.Errorf("leaderboard: app registry is required")
	}
	client, ok := app.Lookup[svcrank.Rank](registry, svcrank.CapabilityName)
	if !ok || client == nil {
		return nil, fmt.Errorf("leaderboard: capability %q not found; list rank under services.<service>.uses in roost.yaml", svcrank.CapabilityName)
	}
	return client, nil
}

// Submit 把玩家当前的总分提交到总分榜，返回提交之后他在榜上的位置。
// 它不对客户端开放（没有协议）：只给服务端别的功能在自己的分数变动之后调用。
//
// # total 是什么
//
// total 是玩家**当前总分的快照**，不是“这次加了多少”。总分由调用方保存在自己的状态里
// （例如 Player 上的一个字段），并在调用方自己的事务里变动；这里用 UpdateMax 把榜抬到这个数。
// 因此重复提交、乱序到达的旧快照都不会多加分，也不会把榜拉低。
// 不提供“加 delta”的入口：rank 服务只记每个玩家最近 8 个请求键（防重发的环，不是账本），
// 拿它给增量去重，同一件事在 8 次别的提交之后重放就会再加一次。
// 这也意味着总分必须只增不减；会下降的分数（天梯分）不能用这张榜的这个入口。
//
// # 幂等键怎么取
//
// requestKey 是“产生这个总分的那件事”的业务键：局号、订单号、任务号，例如 "dungeon:<局号>"。
// 同一件事的每次重试都用同一个键，不同的事用不同的键；不要用时间戳、随机数（重试就对不上了）。
// 它必填，长度不超过 MaxRequestKeyBytes 字节。
// 交给 rank 服务的请求号是“键@总分”：同一个键带同一个总分的重发在 rank 那边直接返回已存的结果；
// 同一个键带更高的总分（那件事重放时玩家的总分已经因为别的事涨了）照常把榜抬上去——
// 所以即使键取得不好（比如每次都一样），榜也不会停在第一次提交的数上。
//
// # 重复提交会怎样
//
// 什么都不会多：键相同、总分相同，rank 服务认出重发，不写；键已经被挤出最近 8 个，
// 或者键不同但总分没变、变小，UpdateMax 发现不比已存的高，不写。两种情况都返回榜上现有的位置。
// 正确性靠的是“快照 + 只升不降”，不是那个只记 8 个的环。
//
// # 提交失败调用方该怎么办
//
// 榜在另一个进程里，Submit 与调用方改总分的事务不是原子的，也不可能是。约定是：
//
//   - 先在自己的事务里把总分改好并提交，事务把**当前总分**带回来（首次与重放都带），
//     再在事务之外（端点里）调 Submit。不要在 Nest handler 里调：handler 里不等网络。
//   - 提交与否不以“这一次是否真的加了分”为条件。重放发现分已经加过，恰恰是
//     “上次可能没报上榜”的那种情况，照样提交当前总分。
//   - Submit 返回错误时不要回滚、不要让玩家的这次操作失败，也不要想办法“补一个差值”：
//     记一条 Warn 日志，继续。这时的状态是“分已经加了、榜上还没到”，是可恢复的方向——
//     用同一个键重试这次调用，或者等这名玩家下一次分数变动，下一个快照会把它带上。
//   - 参数被拒（总分越界、玩家号或键不合法）返回的是带码错误（svcrank.ErrScoreInvalid /
//     ErrOwnerInvalid / ErrRequestInvalid），此时没有向 rank 发出任何调用；这是调用方的缺陷，重试没有用。
func Submit(ctx context.Context, registry *app.Registry, playerID, total int64, requestKey string) (Standing, error) {
	if playerID <= 0 {
		return Standing{}, fmt.Errorf("%w: leaderboard submit needs a positive player id, got %d", svcrank.ErrOwnerInvalid, playerID)
	}
	if err := ValidateScore(total); err != nil {
		return Standing{}, err
	}
	if requestKey == "" {
		return Standing{}, fmt.Errorf("%w: leaderboard submit needs the business key of what produced the score", svcrank.ErrRequestInvalid)
	}
	if len(requestKey) > MaxRequestKeyBytes {
		return Standing{}, fmt.Errorf("%w: request key is %d bytes, limit %d", svcrank.ErrRequestInvalid, len(requestKey), MaxRequestKeyBytes)
	}
	client, err := Client(registry)
	if err != nil {
		return Standing{}, err
	}
	entry, err := client.Submit(ctx, TotalBoard(), PlayerScore(playerID, total), svcrank.UpdateMax, fmt.Sprintf("%s@%d", requestKey, total))
	if err != nil {
		return Standing{}, fmt.Errorf("leaderboard submit: player %d total %d: %w", playerID, total, err)
	}
	return StandingOf(entry, true), nil
}
