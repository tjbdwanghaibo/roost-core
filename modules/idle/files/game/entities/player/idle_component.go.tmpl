package player

import (
	"{{MODULE}}/game/components/idle"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:Idle}}
const CompTypeIdle entity.ComponentType = {{ID:component:Idle}}

// IdleComponent 是 game/components/idle 的组件在 Player 上的名字（生成接线与 handler 用它）；业务在那个包里。
type IdleComponent = idle.Component

type IIdleEntity interface {
	entity.IThreadSafeEntity
	IdleComp() *IdleComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeIdle, idle.NewComponent)
}
