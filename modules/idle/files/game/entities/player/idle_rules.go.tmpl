package player

// IdleRules 是工程自己的收益数据。变更对尚未结算的整个区间生效，不追溯重算已领取的回执。
// 客户端只能估算展示，真实时间与规则由服务器确定。
type IdleRules struct{ PeriodMillis, CoinsPerPeriod, OfflineCapMillis, RewardCap int64 }

// idleRules 缺省每分钟1金币，最多累计8小时/480金币；可按玩家等级在这里返回不同规则。
func (component *IdleComponent) idleRules() IdleRules {
	return IdleRules{PeriodMillis: 60000, CoinsPerPeriod: 1, OfflineCapMillis: 28800000, RewardCap: 480}
}
