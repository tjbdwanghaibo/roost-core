type idleGetter map[int64]entity.IThreadSafeEntity

func (g idleGetter) Get(_ context.Context, id int64, _ entity.EntityCategory) (entity.IThreadSafeEntity, error) {
	if e := g[id]; e != nil {
		return e, nil
	}
	return nil, fmt.Errorf("missing %d", id)
}
func (g idleGetter) GetMany(ctx context.Context, ids []int64, cats []entity.EntityCategory) ([]entity.IThreadSafeEntity, error) {
	out := make([]entity.IThreadSafeEntity, len(ids))
	for i, id := range ids {
		e, err := g.Get(ctx, id, cats[i])
		if err != nil {
			return nil, err
		}
		out[i] = e
	}
	return out, nil
}

type idleCommitter struct{ reject atomic.Bool }

func (c *idleCommitter) Commit(context.Context, dataengine.CommitRecord) error {
	if c.reject.Load() {
		return errors.New("injected rejection")
	}
	return nil
}

type idleFixture struct {
	engine    *nest.NestMgr
	player    *playerentity.Player
	committer *idleCommitter
	now       atomic.Int64
}

func newIdleFixture(t *testing.T, coins int64) *idleFixture {
	t.Helper()
	playerentity.RegisterEntity()
	RegisterIdleClaimNestHandlers()
	RegisterWalletGrantNestHandlers()
	f := &idleFixture{committer: &idleCommitter{}}
	f.now.Store(time.Date(2026, 11, 12, 0, 0, 0, 0, time.UTC).UnixMilli())
	clock.SetSource(func() time.Time { return time.UnixMilli(f.now.Load()) })
	t.Cleanup(func() { clock.SetSource(nil) })
	id, err := entity.BuildEntityID(98102, playerentity.EntityKindPlayer)
	if err != nil {
		t.Fatal(err)
	}
	built, err := entity.BuildEntity(&entity.EntityCreateParam{IsCreate: true, Id: id, Kind: playerentity.EntityKindPlayer})
	if err != nil {
		t.Fatal(err)
	}
	f.player = built.(*playerentity.Player)
	f.engine = nest.NewEngine(nest.NestOptionWithGetter(idleGetter{id: built}), nest.NestOptionWithTransactionCommitter(f.committer), nest.NestOptionWithWorkerPools(nest.WorkerPoolConfig{Workers: 2, QueueCap: 64}, nest.WorkerPoolConfig{}, nest.WorkerPoolConfig{}))
	f.engine.MustRegisterHandlerWithMeta(nest.NewHandlerName("idleTestSetup"), func(_ []entity.IThreadSafeEntity, params []any, _ ...nest.HandlerOption) (any, error) {
		params[0].(func())()
		return nil, nil
	}, nest.HandlerMeta{Rollback: nest.RollbackUndo, Durability: nest.DurabilityStrict})
	if err := f.engine.Start(); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := f.engine.Shutdown(context.Background()); err != nil {
			t.Error(err)
		}
	})
	if coins > 0 {
		if _, err := sender.NewWalletGrantSender(f.engine).Sync_WalletGrant(context.Background(), id, "idle-seed", coins); err != nil {
			t.Fatal(err)
		}
	}
	return f
}

// local 只在业务 worker 持实体锁读写夹具前置状态，场景的动作仍走正式生成 Sender。
func (f *idleFixture) local(t *testing.T, fn func()) {
	t.Helper()
	if err := f.engine.RunLocal(context.Background(), func() { f.player.GetMutex().Lock(); defer f.player.GetMutex().Unlock(); fn() }); err != nil {
		t.Fatal(err)
	}
}

type idleSnapshot struct {
	Coins, Settled, Sequence, Reward, Balance, ReceiptAt int64
	Initialized, Capped                                  bool
}

func (f *idleFixture) snapshot(t *testing.T) idleSnapshot {
	var out idleSnapshot
	f.local(t, func() {
		d := f.player.Dao()
		s, r := d.GetIdle(), d.GetIdleReceipt()
		out = idleSnapshot{Coins: d.GetWallet().GetCoins(), Settled: s.GetSettledAt(), Sequence: s.GetSequence(), Reward: r.GetReward(), Balance: r.GetBalance(), ReceiptAt: r.GetSettledAt(), Initialized: s.GetInitialized(), Capped: r.GetCapped()}
	})
	return out
}
func (f *idleFixture) claim(seq int64) (*pb.IdleClaimResponse, error) {
	return sender.NewIdleClaimSender(f.engine).Sync_IdleClaim(context.Background(), f.player.ID(), &pb.IdleClaimRequest{Sequence: seq})
}
func (f *idleFixture) mustClaim(t *testing.T, seq int64) *pb.IdleClaimResponse {
	t.Helper()
	r, err := f.claim(seq)
	if err != nil {
		t.Fatal(err)
	}
	return r
}
func (f *idleFixture) refuse(t *testing.T, seq int64, want error) {
	t.Helper()
	before := f.snapshot(t)
	if _, err := f.claim(seq); !errors.Is(err, want) {
		t.Fatalf("refusal %v want %v", err, want)
	}
	if !reflect.DeepEqual(before, f.snapshot(t)) {
		t.Fatal("refusal changed facts")
	}
}
func TestIdleFirstClaimStartsWithoutRetroactiveReward(t *testing.T) {
	f := newIdleFixture(t, 7)
	r := f.mustClaim(t, 1)
	if r.Reward != 0 || r.Balance != 7 || r.SettledAt != f.now.Load() || r.Sequence != 1 || r.Capped {
		t.Fatalf("first %+v", r)
	}
}
func TestIdleElapsedPeriodsPayCoins(t *testing.T) {
	f := newIdleFixture(t, 7)
	f.mustClaim(t, 1)
	f.now.Add(125000)
	r := f.mustClaim(t, 2)
	if r.Reward != 2 || r.Balance != 9 || r.SettledAt != f.now.Load()-5000 || r.Capped {
		t.Fatalf("elapsed %+v", r)
	}
}
func TestIdleFractionalTimeIsPreserved(t *testing.T) {
	f := newIdleFixture(t, 0)
	start := f.now.Load()
	f.mustClaim(t, 1)
	f.now.Add(30000)
	if r := f.mustClaim(t, 2); r.Reward != 0 || r.SettledAt != start {
		t.Fatalf("fraction %+v", r)
	}
	f.now.Add(30000)
	if r := f.mustClaim(t, 3); r.Reward != 1 || r.Balance != 1 {
		t.Fatalf("combined fraction %+v", r)
	}
}
func TestIdleOfflineCapDropsOldOverflow(t *testing.T) {
	f := newIdleFixture(t, 0)
	f.mustClaim(t, 1)
	f.now.Add(24*60*60*1000 + 30000)
	r := f.mustClaim(t, 2)
	if r.Reward != 480 || r.Balance != 480 || !r.Capped || r.SettledAt != f.now.Load() {
		t.Fatalf("cap %+v", r)
	}
	if r := f.mustClaim(t, 3); r.Reward != 0 || r.Balance != 480 {
		t.Fatalf("overflow replayed %+v", r)
	}
	f.now.Add(60000)
	if r := f.mustClaim(t, 4); r.Reward != 1 || r.Balance != 481 {
		t.Fatalf("after cap %+v", r)
	}
}
func TestIdleDuplicateReturnsOriginalAfterTimeMoves(t *testing.T) {
	f := newIdleFixture(t, 0)
	f.mustClaim(t, 1)
	f.now.Add(60000)
	first := f.mustClaim(t, 2)
	before := f.snapshot(t)
	f.now.Add(60000)
	again := f.mustClaim(t, 2)
	if !reflect.DeepEqual(first, again) || !reflect.DeepEqual(before, f.snapshot(t)) {
		t.Fatal("duplicate changed result or facts")
	}
}
func TestIdleStaleAndSkippedSequencesAreRejected(t *testing.T) {
	f := newIdleFixture(t, 0)
	f.mustClaim(t, 1)
	f.mustClaim(t, 2)
	f.refuse(t, 1, apperrors.ErrIdleSequence)
	f.refuse(t, 4, apperrors.ErrIdleSequence)
}
func TestIdleInvalidSequenceIsRejected(t *testing.T) {
	f := newIdleFixture(t, 0)
	for _, seq := range []int64{0, -1, 2, math.MaxInt64} {
		f.refuse(t, seq, apperrors.ErrIdleSequence)
	}
}
func TestIdleRejectedInitializationCanBeRetried(t *testing.T) {
	f := newIdleFixture(t, 0)
	before := f.snapshot(t)
	f.committer.reject.Store(true)
	if _, err := f.claim(1); err == nil {
		t.Fatal("commit accepted")
	}
	if !reflect.DeepEqual(before, f.snapshot(t)) {
		t.Fatal("initialization leaked")
	}
	f.committer.reject.Store(false)
	if r := f.mustClaim(t, 1); r.Reward != 0 {
		t.Fatal("retry accrued from rejected origin")
	}
}
func TestIdleRejectedPayoutRollsBackCursorAndCoins(t *testing.T) {
	f := newIdleFixture(t, 0)
	f.mustClaim(t, 1)
	f.now.Add(120000)
	before := f.snapshot(t)
	f.committer.reject.Store(true)
	if _, err := f.claim(2); err == nil {
		t.Fatal("commit accepted")
	}
	if !reflect.DeepEqual(before, f.snapshot(t)) {
		t.Fatal("rejected payout leaked")
	}
	f.committer.reject.Store(false)
	if r := f.mustClaim(t, 2); r.Reward != 2 || r.Balance != 2 {
		t.Fatalf("retry %+v", r)
	}
}
func TestIdleClockRollbackCannotDoublePay(t *testing.T) {
	f := newIdleFixture(t, 0)
	f.mustClaim(t, 1)
	f.now.Add(120000)
	f.mustClaim(t, 2)
	f.now.Add(-60000)
	f.refuse(t, 3, apperrors.ErrIdleClockBack)
	f.now.Add(120000)
	if r := f.mustClaim(t, 3); r.Reward != 1 || r.Balance != 3 {
		t.Fatalf("clock recovery %+v", r)
	}
}
func TestIdleWalletOverflowPreservesUnclaimedTime(t *testing.T) {
	f := newIdleFixture(t, math.MaxInt64)
	f.mustClaim(t, 1)
	f.now.Add(60000)
	f.refuse(t, 2, apperrors.ErrWalletOverflow)
}
func TestIdleNilRequestRefuses(t *testing.T) {
	f := newIdleFixture(t, 0)
	if _, err := sender.NewIdleClaimSender(f.engine).Sync_IdleClaim(context.Background(), f.player.ID(), nil); !errors.Is(err, apperrors.ErrIdleSequence) {
		t.Fatalf("nil request %v", err)
	}
}
func TestIdleConcurrentDuplicatePaysOnce(t *testing.T) {
	f := newIdleFixture(t, 0)
	f.mustClaim(t, 1)
	f.now.Add(60000)
	var wg sync.WaitGroup
	errs := make(chan error, 8)
	for range 8 {
		wg.Add(1)
		go func() { defer wg.Done(); _, err := f.claim(2); errs <- err }()
	}
	wg.Wait()
	close(errs)
	for err := range errs {
		if err != nil {
			t.Fatal(err)
		}
	}
	s := f.snapshot(t)
	if s.Coins != 1 || s.Sequence != 2 {
		t.Fatalf("concurrent %+v", s)
	}
}
func TestIdleSequenceExhaustionFailsClosed(t *testing.T) {
	f := newIdleFixture(t, 0)
	f.mustClaim(t, 1)
	f.write(t, func() { f.player.Dao().GetIdle().SetSequence(math.MaxInt64) })
	f.refuse(t, 1, apperrors.ErrIdleSequence)
}

func TestIdleProtocolBoundaryUsesServerTimeAndReturnsCodes(t *testing.T) {
	f := newIdleFixture(t, 0)
	reg := app.NewRegistry(viper.New())
	if err := reg.Register("nest", nest.Client(f.engine)); err != nil {
		t.Fatal(err)
	}
	ctl, err := controller.FromRegistry(reg)
	if err != nil {
		t.Fatal(err)
	}
	ctx := &playeraccess.Context{PlayerID: 98102}
	response, err := ctl.HandleIdleClaim(ctx, &pb.IdleClaimRequest{Sequence: 2})
	code, _ := errcode.ClientError(apperrors.ErrIdleSequence)
	if err != nil || response == nil || response.Code != code {
		t.Fatalf("protocol refusal %+v %v", response, err)
	}
	response, err = ctl.HandleIdleClaim(ctx, &pb.IdleClaimRequest{Sequence: 1})
	if err != nil || response == nil || response.Code != 0 || response.SettledAt != f.now.Load() {
		t.Fatalf("protocol success %+v %v", response, err)
	}
}

// write 用实例内的事务 handler 构造边界存档，不能在只读 RunLocal 中写持久 DAO。
func (f *idleFixture) write(t *testing.T, fn func()) {
	t.Helper()
	if _, err := f.engine.Request(context.Background(), nest.NewHandlerName("idleTestSetup"), f.player.ID(), nest.NewParams(fn)); err != nil {
		t.Fatal(err)
	}
}
