package view

// Idle 是 Idle 组件对 game/ 下其它包公开的方法（实现在 game/components/idle，语义见那里）；只在宿主被 Nest 锁住期间调用。
type Idle interface {
	Claim(sequence, nowUnixMilli int64) (IdleResult, error)
}

// IdleHolder 是“带有 Idle 组件”的小接口：只要这个组件的组件包、钩子与联动收它；实体接口（entity_<实体>.go，生成）嵌入它。
type IdleHolder interface{ Idle() Idle }

// IdleResult 是最后一次成功领取的回包。首次领取只初始化起点，Reward 为0。
type IdleResult struct {
	Reward, Balance, SettledAt, Sequence int64
	Capped                               bool
}
