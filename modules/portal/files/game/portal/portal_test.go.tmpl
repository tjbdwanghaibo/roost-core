// portalVerifier 是场景里 account 的身份校验：开发登录走工程里真实的那一个（登录模块写进工程的，绑定到一份
// 写了 login.dev_token 的 account 配置上）；另有一个只在场景里存在的渠道 "store"，它像真正的平台那样只认
// 凭据——凭据是 "receipt-of-<用户>"，确认的身份是凭据里的用户，不是请求里随手填的 open_id。
func portalVerifier(t *testing.T) svcaccount.IdentityVerifier {
	t.Helper()
	dev := accountcollaborators.Verifier()
	bound, ok := dev.(wiringaccount.RegistryBound)
	if !ok {
		t.Fatal("the project's identity verifier no longer reads its config from the registry; the development login cannot be switched on for this scenario")
	}
	cfg := viper.New()
	cfg.Set("login.dev_token", portalDevToken)
	if err := bound.BindRegistry(app.NewRegistry(cfg)); err != nil {
		t.Fatal(err)
	}
	return svcaccount.VerifierFunc(func(ctx context.Context, identity svcaccount.Identity) (svcaccount.Verified, error) {
		if identity.Channel != "store" {
			return dev.Verify(ctx, identity)
		}
		user, ok := strings.CutPrefix(identity.Credential, "receipt-of-")
		if !ok || user == "" {
			return svcaccount.Verified{}, fmt.Errorf("%w: the store does not know this receipt", svcaccount.ErrIdentityDenied)
		}
		return svcaccount.Verified{Channel: "store", OpenID: user}, nil
	})
}

// newPortalWorld 建一套 account（1000、1001 两个开放的服）与一个入口。mutate 改入口的参数：区服目录、推荐规则。
func newPortalWorld(t *testing.T, mutate ...func(*Options)) *portalWorld {
	t.Helper()
	w := &portalWorld{t: t, stores: portalStores{
		accounts: versionstore.NewMemoryStore[string, svcaccount.Account](),
		roles:    versionstore.NewMemoryStore[int64, svcaccount.Role](),
		slots:    versionstore.NewMemoryStore[string, svcaccount.Slot](),
	}}
	w.now.Store(time.Unix(1_800_000_000, 0).UnixMilli())
	names, err := directory.New(versionstore.NewMemoryStore[string, directory.Entry](), directory.Config{
		Normalize: directory.NormalizeLower, DefaultTTL: time.Minute, Now: w.clock,
	})
	if err != nil {
		t.Fatal(err)
	}
	w.service, err = svcaccount.New(svcaccount.Config{
		Accounts:      w.stores.accounts,
		Roles:         w.stores.roles,
		Servers:       versionstore.NewMemoryStore[int32, svcaccount.GameServer](),
		Names:         names,
		Slots:         w.stores.slots,
		Verifier:      portalVerifier(t),
		Allocator:     w,
		NameRules:     accountcollaborators.NameRules(),
		SessionSecret: portalSessionKey,
		SessionTTL:    30 * time.Minute,
		Now:           w.clock,
		SystemNow:     w.clock,
	})
	if err != nil {
		t.Fatal(err)
	}
	for _, sid := range []int32{1000, 1001} {
		w.upsert(sid, svcaccount.ServerOpen)
	}
	w.accounts = &portalRecordingAccounts{Accounts: w.service, calls: map[string]int{}}
	options := Options{Accounts: w.accounts}
	for _, change := range mutate {
		change(&options)
	}
	if w.portal, err = New(options); err != nil {
		t.Fatal(err)
	}
	w.engine = portalEngine(t, w.portal)
	return w
}

func (w *portalWorld) upsert(sid int32, status svcaccount.ServerStatus) {
	w.t.Helper()
	if _, err := w.service.UpsertServer(context.Background(), svcaccount.GameServer{ID: sid, Name: fmt.Sprintf("s%d", sid), Status: status}); err != nil {
		w.t.Fatal(err)
	}
}

// portalEngine 把入口的路由装进真实的路由引擎：与 web Mod 用的是同一个引擎与同一个登记器。
func portalEngine(t *testing.T, portal *Portal) http.Handler {
	t.Helper()
	engine := httpserver.NewEngine()
	if err := portal.RegisterRoutes(webroute.NewRegistrar(engine)); err != nil {
		t.Fatal(err)
	}
	return engine
}

// portalAddrs 建一个静态目录，写错了直接让用例失败。
func portalAddrs(t *testing.T, addrs map[int32]string) Directory {
	t.Helper()
	static, err := NewStaticDirectory(addrs)
	if err != nil {
		t.Fatal(err)
	}
	return static
}

// portalReply 是一次 HTTP 调用的结果。
type portalReply struct {
	status int
	raw    string
	body   map[string]any
}

// code 是错误响应里的业务码；成功响应里没有，返回 0。
func (reply portalReply) code() int {
	code, _ := reply.body["code"].(float64)
	return int(code)
}

func (reply portalReply) text(key string) string {
	value, _ := reply.body[key].(string)
	return value
}

func (reply portalReply) number(key string) int64 {
	value, _ := reply.body[key].(float64)
	return int64(value)
}

// portalSend 向 engine 发一个请求体。
func portalSend(t *testing.T, engine http.Handler, method, path string, body []byte) portalReply {
	t.Helper()
	request := httptest.NewRequest(method, "http://portal.test:8081"+path, bytes.NewReader(body))
	request.Header.Set("Content-Type", "application/json")
	recorder := httptest.NewRecorder()
	engine.ServeHTTP(recorder, request)
	reply := portalReply{status: recorder.Code, raw: recorder.Body.String(), body: map[string]any{}}
	if strings.HasPrefix(strings.TrimSpace(reply.raw), "{") {
		if err := json.Unmarshal(recorder.Body.Bytes(), &reply.body); err != nil {
			t.Fatalf("%s %s answered a body that is not JSON: %q", method, path, reply.raw)
		}
	}
	return reply
}

func portalPost(t *testing.T, engine http.Handler, path string, payload map[string]any) portalReply {
	t.Helper()
	body, err := json.Marshal(payload)
	if err != nil {
		t.Fatal(err)
	}
	return portalSend(t, engine, http.MethodPost, path, body)
}

func (w *portalWorld) post(path string, payload map[string]any) portalReply {
	w.t.Helper()
	return portalPost(w.t, w.engine, path, payload)
}

// login 走一次开发登录，要求成功，返回账号票据。
func (w *portalWorld) login(openID string) string {
	w.t.Helper()
	reply := w.post("/portal/login", map[string]any{"channel": "dev", "open_id": openID, "credential": portalDevToken})
	if reply.status != http.StatusOK || reply.body["ok"] != true || reply.text("account_ticket") == "" {
		w.t.Fatalf("development login of %s: %d %s", openID, reply.status, reply.raw)
	}
	return reply.text("account_ticket")
}

// servers 取清单，要求成功，返回 服号 -> 那一项、推荐的服号。同时核对清单按服号升序。
func (w *portalWorld) servers(ticket string) (map[int]map[string]any, int) {
	w.t.Helper()
	reply := w.post("/portal/servers", map[string]any{"account_ticket": ticket})
	if reply.status != http.StatusOK || reply.body["ok"] != true {
		w.t.Fatalf("server list: %d %s", reply.status, reply.raw)
	}
	list, ok := reply.body["servers"].([]any)
	if !ok {
		w.t.Fatalf("the response has no server list: %s", reply.raw)
	}
	if _, present := reply.body["recommended_server_id"]; !present {
		w.t.Fatalf("the response has no recommended_server_id (0 means none): %s", reply.raw)
	}
	servers := map[int]map[string]any{}
	previous := 0
	for _, item := range list {
		entry, _ := item.(map[string]any)
		sid, _ := entry["server_id"].(float64)
		if int(sid) <= previous {
			w.t.Fatalf("the server list is not in ascending order of server id: %s", reply.raw)
		}
		previous = int(sid)
		servers[int(sid)] = entry
	}
	return servers, int(reply.number("recommended_server_id"))
}

// enter 要一张进 sid 的进服票据，要求成功，返回整个响应。
func (w *portalWorld) enter(ticket string, sid int) portalReply {
	w.t.Helper()
	reply := w.post("/portal/enter", map[string]any{"account_ticket": ticket, "server_id": sid})
	if reply.status != http.StatusOK || !strings.HasPrefix(reply.text("ticket"), "enter:et1.") {
		w.t.Fatalf("enter server %d: %d %s", sid, reply.status, reply.raw)
	}
	return reply
}

// handshake 把进服的握手票据交给登录模块的认证器（握手那一侧直接问 account，不经入口）。
func (w *portalWorld) handshake(ticket string) (playerID int64, isNew bool) {
	w.t.Helper()
	principal, err := gamelogin.Authenticator{Accounts: w.service}.Authenticate(context.Background(), ticket)
	if err != nil {
		w.t.Fatalf("the handshake ticket from /portal/enter was refused by the authenticator: %v", err)
	}
	return principal.PlayerID, principal.Claims[svcaccount.NewRoleClaim] == "1"
}

func (w *portalWorld) ban(accountID string) {
	w.t.Helper()
	if _, _, err := w.stores.accounts.Update(context.Background(), accountID, func(current svcaccount.Account, found bool) (svcaccount.Account, bool, error) {
		current.Banned = true
		return current, found, nil
	}); err != nil {
		w.t.Fatal(err)
	}
}

// 整条链路，只经 HTTP：登录只回账号票据 -> 清单里两个服都没有角色、推荐最新开的服 -> 进服拿到握手票据。
// 票据交给登录模块的认证器：account 建出账号与玩家号的映射，握手成功。再拿一次清单：那个服上有角色了，推荐的是它。
// 入口自己从头到尾没有建角、没有选角。
func TestPortalWalksFromAChannelIdentityToAnAuthenticatedHandshake(t *testing.T) {
	w := newPortalWorld(t)
	reply := w.post("/portal/login", map[string]any{"channel": "dev", "open_id": "alice", "credential": portalDevToken})
	if reply.status != http.StatusOK || len(reply.body) != 3 || reply.body["ok"] != true {
		t.Fatalf("login answered %s; want exactly ok, account_ticket and account_ticket_expires_at", reply.raw)
	}
	ticket := reply.text("account_ticket")
	if !strings.HasPrefix(ticket, "at1.1800000600.") || reply.number("account_ticket_expires_at") != 1_800_000_600 {
		t.Fatalf("account ticket = %q expiring at %d, want one of account's tickets living 10 minutes", ticket, reply.number("account_ticket_expires_at"))
	}

	servers, recommended := w.servers(ticket)
	if len(servers) != 2 {
		t.Fatalf("the list has %d servers, want the two account knows", len(servers))
	}
	for sid, want := range map[int]string{1000: "s1000", 1001: "s1001"} {
		entry := servers[sid]
		if entry["name"] != want || entry["status"] != "open" || entry["role"] != nil || entry["addr"] != "" || entry["addr_source"] != "none" || entry["load"] != float64(0) {
			t.Fatalf("server %d = %v, want open, without a role and (zero config) without an address", sid, entry)
		}
		for _, field := range []string{"role", "addr"} {
			if _, present := entry[field]; !present {
				t.Fatalf("server %d omits %q; an absent role is null and an unknown address is empty: %v", sid, field, entry)
			}
		}
	}
	// 新号：推荐状态是 open 的服里服号最大的。
	if recommended != 1001 {
		t.Fatalf("a new account is recommended server %d, want 1001 (the newest open one)", recommended)
	}

	entered := w.enter(ticket, 1000)
	if entered.number("server_id") != 1000 || entered.number("serving_server_id") != 1000 || entered.number("expires_at") != 1_800_001_800 ||
		entered.text("addr") != "" || entered.text("addr_source") != "none" {
		t.Fatalf("enter answered %s; want a ticket for 1000 living 30 minutes, without an address", entered.raw)
	}
	if _, err := w.service.RoleOnServer(context.Background(), "dev:alice", 1000); svcaccount.Code(err) != svcaccount.CodeRoleMissing {
		t.Fatalf("/portal/enter created the mapping; that is the handshake's job: %v", err)
	}
	// 握手：登录模块的认证器向同一个 account 出示这张票据。
	playerID, isNew := w.handshake(entered.text("ticket"))
	if playerID != 100_001 || !isNew {
		t.Fatalf("the handshake gave player %d (new %v), want the new player 100001", playerID, isNew)
	}

	// 再拿一次清单（同一张账号票据还在有效期内）：1000 上有角色了，推荐回自己的服。
	w.advance(3 * time.Minute)
	servers, recommended = w.servers(ticket)
	role, _ := servers[1000]["role"].(map[string]any)
	if role == nil || role["player_id"] != float64(100_001) || role["serving_server_id"] != float64(1000) ||
		role["created_at"] != float64(1_800_000_000) || role["last_login_at"] != float64(1_800_000_000) {
		t.Fatalf("server 1000's role = %v, want player 100001 created and last seen at the handshake", role)
	}
	if _, named := role["name"]; named {
		t.Fatalf("the role view carries a name; names belong to the game server: %v", role)
	}
	if servers[1001]["role"] != nil || recommended != 1000 {
		t.Fatalf("recommended %d with server 1001 = %v; want 1000, the server the account has a role on", recommended, servers[1001])
	}
	// 再进一次（换设备、重连）：同一名玩家，不再是新建。
	if again, stillNew := w.handshake(w.enter(ticket, 1000).text("ticket")); again != 100_001 || stillNew {
		t.Fatalf("entering again gave player %d (new %v)", again, stillNew)
	}
	// 另一个账号看不到它。
	if others, _ := w.servers(w.login("bob")); others[1000]["role"] != nil {
		t.Fatalf("another account sees a role on server 1000: %v", others[1000])
	}
	if got := w.accounts.roleWrites(); got != 0 {
		t.Fatalf("the portal called CreateRole / SelectRole / EnterServer %d times; it never creates or selects a role", got)
	}
}

// 账号只取自 account 校验过的账号票据。坏票据——空的、伪造的、被改过的、过期的、进服票据、角色会话令牌——
// 在两个端点上都是 400 与 account 的同一个码，响应一模一样，校验之后的任何调用都没有发生。
// 请求里夹带 account_id（或任何别的写法）不起作用。登录请求里的 open_id 也只是提示。
func TestPortalTakesTheAccountOnlyFromTheAccountTicket(t *testing.T) {
	w := newPortalWorld(t)
	alice, bob := w.login("alice"), w.login("bob")
	bobPlayer, _ := w.handshake(w.enter(bob, 1000).text("ticket"))
	enterTicket := strings.TrimPrefix(w.enter(alice, 1001).text("ticket"), "enter:")
	session, err := w.service.SelectRole(context.Background(), "dev:bob", bobPlayer)
	if err != nil {
		t.Fatal(err)
	}
	before, validations := w.accounts.afterTicket(), w.accounts.count("ValidateAccountTicket")
	flipped := alice[:len(alice)-1] + "A"
	if strings.HasSuffix(alice, "A") {
		flipped = alice[:len(alice)-1] + "B"
	}
	parts := strings.Split(alice, ".")
	bobParts := strings.Split(bob, ".")
	bad := map[string]string{
		"garbage":                       "not-a-ticket",
		"a changed signature":           flipped,
		"bob's account, alice's mac":    strings.Join([]string{parts[0], parts[1], bobParts[2], parts[3]}, "."),
		"a later expiry, the same mac":  strings.Join([]string{parts[0], "1900000000", parts[2], parts[3]}, "."),
		"an enter ticket":               enterTicket,
		"a handshake ticket":            "enter:" + enterTicket,
		"a role session token":          session.Token,
		"a ticket of the first version": "pt1." + strings.Join(parts[1:], "."),
	}
	var common string
	check := func(label string, reply portalReply) {
		t.Helper()
		if reply.status != http.StatusBadRequest || reply.code() != 560111 || reply.body["ok"] != false {
			t.Fatalf("%s: %d %s; want 400 with account's session-invalid code 560111", label, reply.status, reply.raw)
		}
		if common == "" {
			common = reply.raw
		}
		if reply.raw != common {
			t.Fatalf("%s: the refusal %s differs from %s; every bad ticket must get the same answer", label, reply.raw, common)
		}
	}
	for label, value := range bad {
		check(label+" on servers", w.post("/portal/servers", map[string]any{"account_ticket": value}))
		check(label+" on enter", w.post("/portal/enter", map[string]any{"account_ticket": value, "server_id": 1000}))
	}
	if got := w.accounts.count("ValidateAccountTicket") - validations; got != 2*len(bad) {
		t.Fatalf("account validated %d tickets, want every one of the %d (the portal does not judge tickets itself)", got, 2*len(bad))
	}
	// 空的、没带的、超长的票据连 account 都不问，回答与上面相同。
	validations = w.accounts.count("ValidateAccountTicket")
	check("an empty ticket on servers", w.post("/portal/servers", map[string]any{"account_ticket": ""}))
	check("no ticket field on enter", w.post("/portal/enter", map[string]any{"server_id": 1000}))
	check("an oversized ticket on servers", w.post("/portal/servers", map[string]any{"account_ticket": alice + strings.Repeat("A", 1025)}))
	if got := w.accounts.count("ValidateAccountTicket") - validations; got != 0 {
		t.Fatalf("empty or oversized tickets reached account %d times", got)
	}
	// 过期：10 分钟整。差一秒还能用，到点之后两个端点都拒绝。
	w.advance(10*time.Minute - time.Second)
	if reply := w.post("/portal/servers", map[string]any{"account_ticket": alice}); reply.status != http.StatusOK {
		t.Fatalf("one second before the ticket expires: %d %s", reply.status, reply.raw)
	}
	before += w.accounts.afterTicket() - before
	w.advance(time.Second)
	check("an expired ticket on servers", w.post("/portal/servers", map[string]any{"account_ticket": alice}))
	check("an expired ticket on enter", w.post("/portal/enter", map[string]any{"account_ticket": alice, "server_id": 1000}))
	if got := w.accounts.afterTicket(); got != before {
		t.Fatalf("refused tickets were followed by %d account calls", got-before)
	}

	// 夹带账号：到达 account 的始终是票据里的那个账号。
	fresh := w.login("alice")
	w.accounts.mu.Lock()
	w.accounts.asAccount = nil
	w.accounts.mu.Unlock()
	smuggled := map[string]any{"account_ticket": fresh, "account_id": "dev:bob", "accountID": "dev:bob", "AccountID": "dev:bob", "account": "dev:bob", "open_id": "bob", "player_id": bobPlayer}
	listed := w.post("/portal/servers", smuggled)
	if listed.status != http.StatusOK || strings.Contains(listed.raw, strconv.FormatInt(bobPlayer, 10)) {
		t.Fatalf("a list asked with account_id=dev:bob shows bob's role: %d %s", listed.status, listed.raw)
	}
	smuggled["server_id"] = 1000
	entered := w.post("/portal/enter", smuggled)
	if entered.status != http.StatusOK {
		t.Fatalf("enter with a smuggled account_id: %d %s", entered.status, entered.raw)
	}
	if playerID, isNew := w.handshake(entered.text("ticket")); playerID == bobPlayer || !isNew {
		t.Fatalf("alice's ticket with account_id=dev:bob entered as player %d (new %v); want a new player of alice's own", playerID, isNew)
	}
	if seen := w.accounts.seen(); seen != "dev:alice" {
		t.Fatalf("account was asked as %q; want dev:alice only", seen)
	}

	// 登录请求里的 open_id 只是提示：拿 carol 的凭据配上 dave 的 open_id，票据是 carol 的。凭据不回显。
	mixed := w.post("/portal/login", map[string]any{"channel": "store", "open_id": "dave", "credential": "receipt-of-carol"})
	if mixed.status != http.StatusOK || strings.Contains(mixed.raw, "receipt-of-carol") {
		t.Fatalf("store login: %d %s", mixed.status, mixed.raw)
	}
	if account, err := w.service.ValidateAccountTicket(context.Background(), mixed.text("account_ticket")); err != nil || account.ID != "store:carol" {
		t.Fatalf("the ticket issued for carol's receipt belongs to %q, %v", account.ID, err)
	}
	if _, found, _ := w.stores.accounts.Get(context.Background(), "store:dave"); found {
		t.Fatal("an account was created for the open id in the request")
	}
}

// 不成样子的请求——字段超长、必填没填、服号不是正数、请求体过大、不是 JSON、不是 POST——
// 一律不去问 account，响应里也不回显提交的内容。
func TestPortalRefusesOversizedAndMalformedRequestsWithoutAskingAccount(t *testing.T) {
	w := newPortalWorld(t)
	ticket := w.login("alice")
	total := func() int {
		w.accounts.mu.Lock()
		defer w.accounts.mu.Unlock()
		sum := 0
		for _, count := range w.accounts.calls {
			sum += count
		}
		return sum
	}
	before := total()
	long := func(n int) string { return strings.Repeat("x", n) }

	type attempt struct {
		label   string
		path    string
		payload map[string]any
	}
	attempts := []attempt{
		{label: "a 33-byte channel", path: "/portal/login", payload: map[string]any{"channel": long(33), "open_id": "alice", "credential": portalDevToken}},
		{label: "a 129-byte open id", path: "/portal/login", payload: map[string]any{"channel": "dev", "open_id": long(129), "credential": portalDevToken}},
		{label: "an 8193-byte credential", path: "/portal/login", payload: map[string]any{"channel": "dev", "open_id": "alice", "credential": long(8193)}},
		{label: "no channel", path: "/portal/login", payload: map[string]any{"open_id": "alice", "credential": portalDevToken}},
		{label: "a blank open id", path: "/portal/login", payload: map[string]any{"channel": "dev", "open_id": "   ", "credential": portalDevToken}},
		{label: "an empty login", path: "/portal/login", payload: map[string]any{}},
		{label: "server id zero", path: "/portal/enter", payload: map[string]any{"account_ticket": ticket, "server_id": 0}},
		{label: "a negative server id", path: "/portal/enter", payload: map[string]any{"account_ticket": ticket, "server_id": -1000}},
		{label: "no server id", path: "/portal/enter", payload: map[string]any{"account_ticket": ticket}},
	}
	for _, try := range attempts {
		reply := w.post(try.path, try.payload)
		if reply.status != http.StatusBadRequest || reply.code() != portalCodeRequestInvalid || reply.body["ok"] != false {
			t.Fatalf("%s: %d %s; want 400 with the portal_request_invalid code", try.label, reply.status, reply.raw)
		}
		if strings.Contains(reply.raw, "xxxxxxxx") || strings.Contains(reply.raw, portalDevToken) {
			t.Fatalf("%s: the refusal echoes the request: %s", try.label, reply.raw)
		}
	}
	// 类型不对、不是 JSON：解码这一层就拒绝了。
	for _, try := range []struct {
		label, path, body string
	}{
		{"not JSON (login)", "/portal/login", "channel=dev&open_id=alice"},
		{"not JSON (servers)", "/portal/servers", "account_ticket=" + ticket},
		{"not JSON (enter)", "/portal/enter", "account_ticket=" + ticket + "&server_id=1000"},
		{"a number for the channel", "/portal/login", `{"channel":7,"open_id":"alice","credential":"x"}`},
		{"a number for the ticket", "/portal/servers", `{"account_ticket":12345}`},
		{"a string for the server id", "/portal/enter", `{"account_ticket":"` + ticket + `","server_id":"1000"}`},
		{"a fraction for the server id", "/portal/enter", `{"account_ticket":"` + ticket + `","server_id":1000.5}`},
		{"two documents (login)", "/portal/login", `{"channel":"dev","open_id":"alice","credential":"` + portalDevToken + `"}{"channel":"dev"}`},
		{"two documents (servers)", "/portal/servers", `{"account_ticket":"` + ticket + `"}{"account_ticket":"x"}`},
	} {
		reply := portalSend(t, w.engine, http.MethodPost, try.path, []byte(try.body))
		if reply.status != http.StatusBadRequest || reply.body["ok"] != false {
			t.Fatalf("%s: %d %s; want 400", try.label, reply.status, reply.raw)
		}
	}
	// 请求体超过 16 KiB：413，不管里面写了什么。
	huge, _ := json.Marshal(map[string]any{"channel": "dev", "open_id": "alice", "credential": portalDevToken, "account_ticket": ticket, "server_id": 1000, "padding": long(17 << 10)})
	for _, path := range []string{"/portal/login", "/portal/servers", "/portal/enter"} {
		if reply := portalSend(t, w.engine, http.MethodPost, path, huge); reply.status != http.StatusRequestEntityTooLarge {
			t.Fatalf("a %d-byte body on %s: %d %s; want 413", len(huge), path, reply.status, reply.raw)
		}
		// 只有 POST。
		if reply := portalSend(t, w.engine, http.MethodGet, path, nil); reply.status != http.StatusMethodNotAllowed {
			t.Fatalf("GET %s: %d; want 405", path, reply.status)
		}
	}
	// 删掉的旧端点不存在。
	for _, path := range []string{"/portal/create-role", "/portal/select-role"} {
		if reply := portalSend(t, w.engine, http.MethodPost, path, []byte(`{}`)); reply.status != http.StatusNotFound {
			t.Fatalf("POST %s: %d; the portal no longer creates or selects roles", path, reply.status)
		}
	}
	if got := total(); got != before {
		t.Fatalf("malformed requests reached account %d times", got-before)
	}
	// 恰好在上限上的字段不被这一层拦：128 字节的 open id 能登录。
	if reply := w.post("/portal/login", map[string]any{"channel": "dev", "open_id": long(128), "credential": portalDevToken}); reply.status != http.StatusOK {
		t.Fatalf("a 128-byte open id: %d %s", reply.status, reply.raw)
	}
}

// account 的拒绝是 4xx 带它自己的码；account 或区服目录给不出结论（总线断了、超时、存储出错）是 500，
// 响应里没有内部的错误文本，也没有票据。两种不能混：把“问不到”答成 4xx，客户端会以为是自己的凭据坏了。
// 封号对已经发出去的账号票据立即生效。
func TestPortalSeparatesAccountRefusalsFromOutages(t *testing.T) {
	downDirectory := errors.New("directory: etcd 10.9.8.6:2379 unreachable")
	var directoryDown atomic.Bool
	w := newPortalWorld(t, func(options *Options) {
		options.Directory = DirectoryFunc(func(context.Context) ([]Entry, error) {
			if directoryDown.Load() {
				return nil, downDirectory
			}
			return []Entry{
				{ServerID: 1000, Addr: "203.0.113.7:7000"},
			}, nil
		})
	})
	ticket := w.login("alice")

	// 拒绝：凭据不对、渠道没接、服没登记、账号被封。都是 400，码是 account 的。
	loginPayload := map[string]any{"channel": "dev", "open_id": "alice", "credential": portalDevToken}
	for label, try := range map[string]struct {
		path    string
		payload map[string]any
		code    int
	}{
		"a wrong development credential": {"/portal/login", map[string]any{"channel": "dev", "open_id": "alice", "credential": "dev-wrong"}, 560102},
		"a channel nobody wired":         {"/portal/login", map[string]any{"channel": "appstore", "open_id": "alice", "credential": "receipt"}, 560102},
		"a server nobody registered":     {"/portal/enter", map[string]any{"account_ticket": ticket, "server_id": 4242}, 560104},
	} {
		reply := w.post(try.path, try.payload)
		if reply.status != http.StatusBadRequest || reply.code() != try.code || reply.body["ok"] != false {
			t.Fatalf("%s: %d %s; want 400 with account's code %d", label, reply.status, reply.raw, try.code)
		}
		if reply.text("account_ticket") != "" || reply.text("ticket") != "" {
			t.Fatalf("%s: a refusal handed out a ticket: %s", label, reply.raw)
		}
	}
	carol := w.login("carol")
	w.ban("dev:carol")
	for label, try := range map[string]struct {
		path    string
		payload map[string]any
	}{
		"a banned account asking for the list":  {"/portal/servers", map[string]any{"account_ticket": carol}},
		"a banned account asking to enter":      {"/portal/enter", map[string]any{"account_ticket": carol, "server_id": 1000}},
		"a banned account logging in once more": {"/portal/login", map[string]any{"channel": "dev", "open_id": "carol", "credential": portalDevToken}},
	} {
		if reply := w.post(try.path, try.payload); reply.status != http.StatusBadRequest || reply.code() != 560102 || reply.text("ticket") != "" || reply.text("account_ticket") != "" {
			t.Fatalf("%s: %d %s; want 400 with account's identity-denied code 560102", label, reply.status, reply.raw)
		}
	}

	// 问不到：每个用到的 account 接口各断一次，目录也断一次。
	outage := func(label string, reply portalReply) {
		t.Helper()
		if reply.status != http.StatusInternalServerError || reply.code() != 1 || reply.body["ok"] != false {
			t.Fatalf("%s: %d %s; want 500 with the internal code 1", label, reply.status, reply.raw)
		}
		for _, leak := range []string{"10.9.8.", "redis", "etcd", "no responders", "at1.", "et1.", "enter:", "dev:alice", "203.0.113"} {
			if strings.Contains(reply.raw, leak) {
				t.Fatalf("%s: the 500 response leaks %q: %s", label, leak, reply.raw)
			}
		}
	}
	serversPayload := map[string]any{"account_ticket": ticket}
	enterPayload := map[string]any{"account_ticket": ticket, "server_id": 1000}
	for _, step := range []struct {
		method, path string
		payload      map[string]any
	}{
		{"Login", "/portal/login", loginPayload},
		{"IssueAccountTicket", "/portal/login", loginPayload},
		{"ValidateAccountTicket", "/portal/servers", serversPayload},
		{"ListServers", "/portal/servers", serversPayload},
		{"RoleOnServer", "/portal/servers", serversPayload},
		{"ValidateAccountTicket", "/portal/enter", enterPayload},
		{"IssueEnterTicket", "/portal/enter", enterPayload},
	} {
		w.accounts.fail(step.method)
		outage(step.method+" is down on "+step.path, w.post(step.path, step.payload))
	}
	w.accounts.fail()
	directoryDown.Store(true)
	outage("the directory is down on servers", w.post("/portal/servers", serversPayload))
	outage("the directory is down on enter", w.post("/portal/enter", enterPayload))
	directoryDown.Store(false)
	// 都回来之后，同一张票据照常可用：断线期间没有东西被弄坏。
	if reply := w.enter(ticket, 1000); reply.text("addr") != "203.0.113.7:7000" || reply.text("addr_source") != "directory" {
		t.Fatalf("after the outage: %s", reply.raw)
	}
	if got := w.accounts.roleWrites(); got != 0 {
		t.Fatalf("the portal reached CreateRole / SelectRole / EnterServer %d times", got)
	}
}

// account 答了“成功”、内容却对不上问题时，入口不把它交给客户端：500，不带角色也不带票据。
// 正常情况下 account 不会这样答；这一层防的是总线另一头的版本不一致或存储被改坏——宁可失败也不把别人的角色
// 列给玩家、不交出一张握手必然失败的票据。
func TestPortalDoesNotPassOnAnAccountAnswerThatDoesNotMatchTheQuestion(t *testing.T) {
	w := newPortalWorld(t)
	ticket, bobTicket := w.login("alice"), w.login("bob")
	bobPlayer, _ := w.handshake(w.enter(bobTicket, 1000).text("ticket"))
	w.handshake(w.enter(ticket, 1000).text("ticket"))
	ctx := context.Background()
	loginPayload := map[string]any{"channel": "dev", "open_id": "alice", "credential": portalDevToken}
	serversPayload := map[string]any{"account_ticket": ticket}
	enterPayload := map[string]any{"account_ticket": ticket, "server_id": 1000}
	serverError := func(label string, reply portalReply) {
		t.Helper()
		if reply.status != http.StatusInternalServerError || reply.code() != 1 {
			t.Fatalf("%s: %d %s; want 500", label, reply.status, reply.raw)
		}
		for _, leak := range []string{"at1.", "et1.", "enter:", strconv.FormatInt(bobPlayer, 10), "dev:bob"} {
			if strings.Contains(reply.raw, leak) {
				t.Fatalf("%s: the 500 response carries %q: %s", label, leak, reply.raw)
			}
		}
	}
	reset := func() {
		w.accounts.login, w.accounts.issueAccount, w.accounts.validate = nil, nil, nil
		w.accounts.listServers, w.accounts.roleOnServer, w.accounts.issueEnter = nil, nil, nil
	}

	w.accounts.login = func() (svcaccount.Account, error) { return svcaccount.Account{}, nil }
	serverError("a login without an account id", w.post("/portal/login", loginPayload))
	reset()
	w.accounts.issueAccount = func() (svcaccount.AccountTicket, error) { return svcaccount.AccountTicket{ExpiresAtUnix: 1}, nil }
	serverError("an empty account ticket", w.post("/portal/login", loginPayload))
	reset()
	w.accounts.validate = func() (svcaccount.Account, error) { return svcaccount.Account{}, nil }
	serverError("a validated ticket without an account (servers)", w.post("/portal/servers", serversPayload))
	serverError("a validated ticket without an account (enter)", w.post("/portal/enter", enterPayload))
	reset()
	w.accounts.listServers = func() ([]svcaccount.GameServer, error) {
		return []svcaccount.GameServer{
			{ID: 0, Name: "nameless"},
		}, nil
	}
	serverError("a listed server without an id", w.post("/portal/servers", serversPayload))
	reset()
	real, err := w.service.RoleOnServer(ctx, "dev:alice", 1000)
	if err != nil {
		t.Fatal(err)
	}
	for label, twist := range map[string]func(*svcaccount.Role){
		"another account's role":         func(role *svcaccount.Role) { *role, _ = w.service.RoleOnServer(ctx, "dev:bob", 1000) },
		"a role without a player id":     func(role *svcaccount.Role) { role.PlayerID = 0 },
		"a role bound to another server": func(role *svcaccount.Role) { role.ServerID = 1001 },
	} {
		w.accounts.roleOnServer = func(_ string, serverID int32) (svcaccount.Role, error) {
			if serverID != 1000 {
				return svcaccount.Role{}, svcaccount.ErrRoleMissing
			}
			role := real
			twist(&role)
			return role, nil
		}
		serverError(label+" in the list", w.post("/portal/servers", serversPayload))
	}
	reset()
	issued, err := w.service.IssueEnterTicket(ctx, "dev:alice", 1000)
	if err != nil {
		t.Fatal(err)
	}
	for label, twist := range map[string]func(*svcaccount.EnterTicket){
		"an empty enter ticket":          func(ticket *svcaccount.EnterTicket) { ticket.Ticket = "" },
		"a ticket for another server":    func(ticket *svcaccount.EnterTicket) { ticket.ServerID = 1001 },
		"a ticket without a serving sid": func(ticket *svcaccount.EnterTicket) { ticket.ServingServerID = 0 },
	} {
		w.accounts.issueEnter = func(string, int32) (svcaccount.EnterTicket, error) {
			twisted := issued
			twist(&twisted)
			return twisted, nil
		}
		serverError(label, w.post("/portal/enter", enterPayload))
	}
	// 原样的回答照常通过：上面拒绝的确实是被改动的那一处。
	w.accounts.issueEnter = func(string, int32) (svcaccount.EnterTicket, error) { return issued, nil }
	if reply := w.post("/portal/enter", enterPayload); reply.status != http.StatusOK || reply.text("ticket") != "enter:"+issued.Ticket {
		t.Fatalf("an untouched enter ticket: %d %s", reply.status, reply.raw)
	}
	w.accounts.roleOnServer = func(string, int32) (svcaccount.Role, error) { return real, nil }
	w.accounts.listServers = func() ([]svcaccount.GameServer, error) {
		return []svcaccount.GameServer{
			{ID: 1000, Name: "s1000", Status: svcaccount.ServerOpen},
		}, nil
	}
	if reply := w.post("/portal/servers", serversPayload); reply.status != http.StatusOK {
		t.Fatalf("an untouched role: %d %s", reply.status, reply.raw)
	}
}

// 清单是三样东西按服号拼起来的：account 的区服记录（名字、状态、合服）、目录的地址与负载（给的是承载服的）、
// 本账号在各服的角色。目录里有而 account 没登记的服不列出；account 登记了而目录里没有的照常列出、没有地址。
// 动态注册表叠在静态配置上：登记的盖住配置的，过期之后回到配置。
func TestPortalListsWhatAccountAndTheDirectoryKnow(t *testing.T) {
	registryNow := time.Unix(1_800_000_000, 0)
	dynamic := NewRegistry(func() time.Time { return registryNow })
	w := newPortalWorld(t, func(options *Options) {
		options.Directory = Overlay(portalAddrs(t, map[int32]string{1000: "203.0.113.7:7000", 1001: "203.0.113.8:7001", 4242: "203.0.113.99:7000"}), dynamic)
	})
	ctx := context.Background()
	w.upsert(1002, svcaccount.ServerMaintenance)
	w.upsert(1003, svcaccount.ServerOpen)
	if err := dynamic.Announce(Entry{ServerID: 1001, Addr: "gate-b.example.test:7443", Load: 87, Tags: []string{"crowded"}}, 30*time.Second); err != nil {
		t.Fatal(err)
	}
	if err := dynamic.Announce(Entry{ServerID: 1003, Addr: "gate-c.example.test:7443", Load: 3, Tags: []string{"new", "recommended"}}, 30*time.Second); err != nil {
		t.Fatal(err)
	}
	ticket := w.login("alice")
	servers, recommended := w.servers(ticket)
	if len(servers) != 4 || servers[4242] != nil {
		t.Fatalf("the list has servers %v; want the four account registered and not 4242, which only the directory knows", portalKeys(servers))
	}
	for sid, want := range map[int]map[string]any{
		1000: {"name": "s1000", "status": "open", "addr": "203.0.113.7:7000", "addr_source": "directory", "load": float64(0)},
		1001: {"name": "s1001", "status": "open", "addr": "gate-b.example.test:7443", "addr_source": "directory", "load": float64(87)},
		1002: {"name": "s1002", "status": "maintenance", "addr": "", "addr_source": "none", "load": float64(0)},
		1003: {"name": "s1003", "status": "open", "addr": "gate-c.example.test:7443", "addr_source": "directory", "load": float64(3)},
	} {
		for key, value := range want {
			if servers[sid][key] != value {
				t.Fatalf("server %d: %s = %v, want %v (%v)", sid, key, servers[sid][key], value, servers[sid])
			}
		}
		if servers[sid]["role"] != nil {
			t.Fatalf("server %d lists a role before any handshake: %v", sid, servers[sid])
		}
		if _, merged := servers[sid]["merged_into"]; merged {
			t.Fatalf("server %d says merged_into without a merge: %v", sid, servers[sid])
		}
	}
	if tags, _ := servers[1003]["tags"].([]any); len(tags) != 2 || tags[0] != "new" || tags[1] != "recommended" {
		t.Fatalf("server 1003's tags = %v", servers[1003]["tags"])
	}
	if _, tagged := servers[1000]["tags"]; tagged {
		t.Fatalf("a server without tags carries the field: %v", servers[1000])
	}
	if recommended != 1003 {
		t.Fatalf("a new account is recommended %d, want 1003 (the newest open server with an address)", recommended)
	}

	// 登记过期：1001 回到配置的地址，1003 没有配置、地址没了。
	registryNow = registryNow.Add(30 * time.Second)
	servers, _ = w.servers(ticket)
	if servers[1001]["addr"] != "203.0.113.8:7001" || servers[1001]["load"] != float64(0) || servers[1003]["addr"] != "" || servers[1003]["addr_source"] != "none" {
		t.Fatalf("after the announcements expired: 1001 = %v, 1003 = %v", servers[1001], servers[1003])
	}

	// 角色：在 1000、1001 各进一次；1001 并入 1000；1000 上的角色开始换到 1003。
	onHome, _ := w.handshake(w.enter(ticket, 1000).text("ticket"))
	w.advance(time.Minute)
	onAway, _ := w.handshake(w.enter(ticket, 1001).text("ticket"))
	if _, err := w.service.MergeServer(ctx, svcaccount.MergeRequest{From: 1001, Into: 1000, Note: "portal scenario"}); err != nil {
		t.Fatal(err)
	}
	if _, err := w.service.BeginRoleTransfer(ctx, onHome, svcaccount.TransferRequest{ID: "move-1", FromSID: 1000, To: 1003}); err != nil {
		t.Fatal(err)
	}
	servers, recommended = w.servers(ticket)
	home, _ := servers[1000]["role"].(map[string]any)
	if home == nil || home["player_id"] != float64(onHome) || home["serving_server_id"] != float64(1000) || home["transferring_to"] != float64(1003) || home["last_login_at"] != float64(1_800_000_000) {
		t.Fatalf("server 1000's role = %v, want player %d moving to 1003", home, onHome)
	}
	away, _ := servers[1001]["role"].(map[string]any)
	if servers[1001]["merged_into"] != float64(1000) || servers[1001]["status"] != "closed" || servers[1001]["addr"] != "203.0.113.7:7000" ||
		away == nil || away["player_id"] != float64(onAway) || away["serving_server_id"] != float64(1000) || away["last_login_at"] != float64(1_800_000_060) {
		t.Fatalf("server 1001 = %v, want merged into 1000, reached at 1000's address, with player %d", servers[1001], onAway)
	}
	if _, moving := away["transferring_to"]; moving {
		t.Fatalf("a role that is not moving says transferring_to: %v", away)
	}
	// 换服的占位不是角色：目标服 1003 上仍然没有。老号推荐最近登录的那个角色所在的服。
	if servers[1003]["role"] != nil || recommended != 1001 {
		t.Fatalf("recommended %d, server 1003 = %v; want 1001 (the role logged in last) and no role on 1003", recommended, servers[1003])
	}
}

func portalKeys(servers map[int]map[string]any) []int {
	keys := make([]int, 0, len(servers))
	for sid := range servers {
		keys = append(keys, sid)
	}
	sort.Ints(keys)
	return keys
}

// 推荐规则（portal_rules.go 的 recommend）的每一支，以及入口怎样对待规则的回答。
func TestPortalRecommendsByRoleThenByTheNewestOpenServer(t *testing.T) {
	open := func(sid int32, addr string) ServerChoice {
		return ServerChoice{ServerID: sid, Status: "open", Addr: addr}
	}
	withRole := func(choice ServerChoice, lastLogin int64) ServerChoice {
		choice.HasRole, choice.RoleLastLoginAt = true, lastLogin
		return choice
	}
	for _, test := range []struct {
		label   string
		servers []ServerChoice
		want    int32
	}{
		{label: "no servers", servers: nil, want: 0},
		{label: "new account, newest open server", servers: []ServerChoice{open(1, "a:1"), open(2, "b:1"), open(3, "c:1")}, want: 3},
		{label: "new account, zero config (no addresses at all)", servers: []ServerChoice{open(1, ""), open(2, "")}, want: 2},
		{label: "new account, reachable servers come first", servers: []ServerChoice{open(1, "a:1"), open(2, ""), open(3, "")}, want: 1},
		{label: "new account, the newest reachable one", servers: []ServerChoice{open(1, "a:1"), open(2, "b:1"), open(3, "")}, want: 2},
		{
			label: "new account, servers that take no new roles are skipped",
			servers: []ServerChoice{
				open(1, "a:1"),
				{ServerID: 2, Status: "maintenance", Addr: "b:1"},
				{ServerID: 3, Status: "full", Addr: "c:1"},
				{ServerID: 4, Status: "closed", Addr: "d:1"},
				{ServerID: 5, Status: "open", MergedInto: 1, Addr: "a:1"},
			},
			want: 1,
		},
		{
			label: "new account, nothing is open",
			servers: []ServerChoice{
				{ServerID: 1, Status: "maintenance", Addr: "a:1"},
				{ServerID: 2, Status: "closed"},
			},
			want: 0,
		},
		{label: "one role wins over a newer open server", servers: []ServerChoice{withRole(open(1, "a:1"), 100), open(2, "b:1")}, want: 1},
		{label: "the role that logged in last", servers: []ServerChoice{withRole(open(1, "a:1"), 300), withRole(open(2, "b:1"), 200), withRole(open(3, "c:1"), 250)}, want: 1},
		{label: "equal login times, the larger server id", servers: []ServerChoice{withRole(open(1, "a:1"), 0), withRole(open(2, "b:1"), 0)}, want: 2},
		{
			label: "a role on a closed, unreachable server is still home",
			servers: []ServerChoice{
				withRole(ServerChoice{ServerID: 1, Status: "closed"}, 50),
				open(2, "b:1"),
			},
			want: 1,
		},
	} {
		if got := recommend(test.servers); got != test.want {
			t.Fatalf("%s: recommend = %d, want %d", test.label, got, test.want)
		}
	}

	// 入口把清单原样交给规则（每个服的状态、地址、负载、标签、有没有角色），规则挑的服进响应；
	// 规则挑了一个不在清单里的服、或者一个非正数，按没有推荐处理。
	var seen []ServerChoice
	pick := int32(1001)
	w := newPortalWorld(t, func(options *Options) {
		options.Directory = DirectoryFunc(func(context.Context) ([]Entry, error) {
			return []Entry{
				{ServerID: 1000, Addr: "203.0.113.7:7000", Load: 40, Tags: []string{"old"}},
			}, nil
		})
		options.Recommend = func(servers []ServerChoice) int32 {
			seen = servers
			return pick
		}
	})
	ticket := w.login("alice")
	w.handshake(w.enter(ticket, 1000).text("ticket"))
	if _, recommended := w.servers(ticket); recommended != 1001 {
		t.Fatalf("the rule picked 1001, the response says %d", recommended)
	}
	if len(seen) != 2 || seen[0].ServerID != 1000 || seen[0].Name != "s1000" || seen[0].Status != "open" || seen[0].Addr != "203.0.113.7:7000" || seen[0].Load != 40 ||
		len(seen[0].Tags) != 1 || !seen[0].HasRole || seen[0].RoleLastLoginAt != 1_800_000_000 || seen[1].ServerID != 1001 || seen[1].HasRole || seen[1].Addr != "" {
		t.Fatalf("the rule saw %+v", seen)
	}
	for _, unknown := range []int32{4242, 0, -1} {
		pick = unknown
		if _, recommended := w.servers(ticket); recommended != 0 {
			t.Fatalf("the rule picked %d, which is not in the list; the response recommends %d, want 0", unknown, recommended)
		}
	}
}

// 进服：只换一张进服票据与承载服的地址，不建角、不选角。选中的服并入了别的服时地址是那个服的；
// 维护中的服照样给票据（老号能进，新号在握手时被 account 拒绝）；同一张账号票据反复进同一个服不会多出玩家。
func TestPortalEnterHandsOutATicketAndTheServingAddress(t *testing.T) {
	w := newPortalWorld(t, func(options *Options) {
		options.Directory = portalAddrs(t, map[int32]string{1000: "203.0.113.7:7000", 1001: "203.0.113.8:7001"})
	})
	ctx := context.Background()
	ticket := w.login("alice")
	first := w.enter(ticket, 1001)
	if first.number("server_id") != 1001 || first.number("serving_server_id") != 1001 || first.text("addr") != "203.0.113.8:7001" || first.text("addr_source") != "directory" {
		t.Fatalf("enter 1001 answered %s", first.raw)
	}
	playerID, isNew := w.handshake(first.text("ticket"))
	if !isNew {
		t.Fatal("the first handshake did not create the mapping")
	}
	// 反复进：票据可以是新的，玩家只有一个。
	for range 3 {
		w.advance(time.Second)
		if again, created := w.handshake(w.enter(ticket, 1001).text("ticket")); again != playerID || created {
			t.Fatalf("entering again gave player %d (new %v), want %d", again, created, playerID)
		}
	}
	if w.nextID.Load() != 1 {
		t.Fatalf("%d player ids were allocated for one account on one server", w.nextID.Load())
	}
	// 1001 并入 1000：凭 1001 的票据进，连的是 1000。
	if _, err := w.service.MergeServer(ctx, svcaccount.MergeRequest{From: 1001, Into: 1000, Note: "portal scenario"}); err != nil {
		t.Fatal(err)
	}
	merged := w.enter(ticket, 1001)
	if merged.number("server_id") != 1001 || merged.number("serving_server_id") != 1000 || merged.text("addr") != "203.0.113.7:7000" {
		t.Fatalf("enter the merged server answered %s; want serving 1000 at 203.0.113.7:7000", merged.raw)
	}
	principal, err := gamelogin.Authenticator{Accounts: w.service}.Authenticate(ctx, merged.text("ticket"))
	if err != nil || principal.PlayerID != playerID || principal.ServerID != 1000 || principal.Claims["origin_server_id"] != "1001" {
		t.Fatalf("the merged role's handshake: %+v, %v; want player %d served by 1000, origin 1001", principal, err, playerID)
	}
	// 维护中的服：票据照发、地址为空（目录里没有它）；新号握手被 account 拒绝，什么也没建。
	w.upsert(1002, svcaccount.ServerMaintenance)
	maintenance := w.enter(ticket, 1002)
	if maintenance.text("addr") != "" || maintenance.text("addr_source") != "none" {
		t.Fatalf("enter a server the directory does not know answered %s", maintenance.raw)
	}
	if _, err := (gamelogin.Authenticator{Accounts: w.service}).Authenticate(ctx, maintenance.text("ticket")); err == nil {
		t.Fatal("a new account's handshake on a server in maintenance was accepted")
	}
	if _, err := w.service.RoleOnServer(ctx, "dev:alice", 1002); svcaccount.Code(err) != svcaccount.CodeRoleMissing {
		t.Fatalf("a mapping exists on the server in maintenance: %v", err)
	}
	if got := w.accounts.roleWrites(); got != 0 {
		t.Fatalf("the portal itself reached CreateRole / SelectRole / EnterServer %d times", got)
	}
}

// 动态注册表：登记的条目在期限内给出、到期那一刻起不给；同一个服再登记是覆盖并重新计时；撤销立刻生效；
// 不成样子的登记被拒且什么都不改；条目数有上限，过期的不占名额；并发登记与读取是安全的。
func TestPortalRegistryExpiresCapsAndIsSafeForConcurrentUse(t *testing.T) {
	now := time.Unix(1_800_000_000, 0)
	registry := NewRegistry(func() time.Time { return now })
	ctx := context.Background()
	list := func() string {
		entries, err := registry.Entries(ctx)
		if err != nil {
			t.Fatal(err)
		}
		parts := make([]string, 0, len(entries))
		for _, entry := range entries {
			parts = append(parts, fmt.Sprintf("%d=%s/%d/%s", entry.ServerID, entry.Addr, entry.Load, strings.Join(entry.Tags, "+")))
		}
		return strings.Join(parts, " ")
	}
	if list() != "" || registry.Len() != 0 {
		t.Fatalf("a new registry lists %q", list())
	}
	must := func(entry Entry, ttl time.Duration) {
		t.Helper()
		if err := registry.Announce(entry, ttl); err != nil {
			t.Fatal(err)
		}
	}
	must(Entry{ServerID: 1001, Addr: "gate-b:7000", Load: 5}, 30*time.Second)
	must(Entry{ServerID: 1000, Addr: " gate-a:7000 ", Tags: []string{"new"}}, 10*time.Second)
	if got := list(); got != "1000=gate-a:7000/0/new 1001=gate-b:7000/5/" {
		t.Fatalf("entries = %q, want both in ascending order with the address trimmed", got)
	}
	// 给出去的是副本。
	entries, _ := registry.Entries(ctx)
	entries[0].Addr, entries[0].Tags[0] = "tampered:1", "tampered"
	if got := list(); !strings.HasPrefix(got, "1000=gate-a:7000/0/new") {
		t.Fatalf("a caller's edit leaked into the registry: %q", got)
	}
	// 差一秒到期还在，到期那一刻起不在。
	now = now.Add(9 * time.Second)
	if registry.Len() != 2 {
		t.Fatalf("one second before server 1000's announcement expires: %q", list())
	}
	now = now.Add(time.Second)
	if got := list(); got != "1001=gate-b:7000/5/" {
		t.Fatalf("at the expiry instant: %q", got)
	}
	// 续期：覆盖并重新计时。
	must(Entry{ServerID: 1001, Addr: "gate-b2:7000", Load: 9}, 30*time.Second)
	now = now.Add(25 * time.Second) // 第一次登记本该在 5 秒前到期
	if got := list(); got != "1001=gate-b2:7000/9/" {
		t.Fatalf("after renewing: %q", got)
	}
	registry.Withdraw(1001)
	registry.Withdraw(4242)
	if list() != "" {
		t.Fatalf("after withdrawing: %q", list())
	}

	// 不成样子的登记。
	must(Entry{ServerID: 7, Addr: "gate:7000"}, time.Minute)
	for label, bad := range map[string]struct {
		entry Entry
		ttl   time.Duration
	}{
		"server id zero":       {Entry{ServerID: 0, Addr: "gate:7000"}, time.Minute},
		"a negative server id": {Entry{ServerID: -7, Addr: "gate:7000"}, time.Minute},
		"no host":              {Entry{ServerID: 7, Addr: ":7000"}, time.Minute},
		"no port":              {Entry{ServerID: 7, Addr: "gate"}, time.Minute},
		"port zero":            {Entry{ServerID: 7, Addr: "gate:0"}, time.Minute},
		"an oversized address": {Entry{ServerID: 7, Addr: strings.Repeat("g", 252) + ":7000"}, time.Minute},
		"a negative load":      {Entry{ServerID: 7, Addr: "gate:7000", Load: -1}, time.Minute},
		"nine tags":            {Entry{ServerID: 7, Addr: "gate:7000", Tags: strings.Split("a,b,c,d,e,f,g,h,i", ",")}, time.Minute},
		"an empty tag":         {Entry{ServerID: 7, Addr: "gate:7000", Tags: []string{""}}, time.Minute},
		"a 33-byte tag":        {Entry{ServerID: 7, Addr: "gate:7000", Tags: []string{strings.Repeat("t", 33)}}, time.Minute},
		"a zero ttl":           {Entry{ServerID: 7, Addr: "other:7000"}, 0},
		"a negative ttl":       {Entry{ServerID: 7, Addr: "other:7000"}, -time.Second},
		"a ttl over 10m":       {Entry{ServerID: 7, Addr: "other:7000"}, 10*time.Minute + time.Second},
	} {
		if err := registry.Announce(bad.entry, bad.ttl); err == nil {
			t.Fatalf("%s: the announcement was accepted", label)
		}
	}
	if got := list(); got != "7=gate:7000/0/" {
		t.Fatalf("refused announcements changed the registry: %q", got)
	}
	must(Entry{ServerID: 7, Addr: "gate:7000"}, 10*time.Minute) // 恰好 10 分钟可以

	// 上限 256：满了之后新的服号被拒，已登记的照常续期；过期的让出名额。
	for sid := int32(1000); registry.Len() < 256; sid++ {
		must(Entry{ServerID: sid, Addr: "gate:7000"}, time.Minute)
	}
	if err := registry.Announce(Entry{ServerID: 9000, Addr: "gate:7000"}, time.Minute); !errors.Is(err, ErrRegistryFull) {
		t.Fatalf("the 257th server: %v, want ErrRegistryFull", err)
	}
	must(Entry{ServerID: 1000, Addr: "renewed:7000"}, time.Minute)
	if registry.Len() != 256 {
		t.Fatalf("the registry holds %d servers", registry.Len())
	}
	now = now.Add(time.Minute) // 一分钟的那 255 条到期，只剩 10 分钟的 7
	must(Entry{ServerID: 9000, Addr: "gate:7000"}, time.Minute)
	if got := list(); got != "7=gate:7000/0/ 9000=gate:7000/0/" {
		t.Fatalf("after the short announcements expired: %q", got)
	}

	// 并发：登记、撤销与读取同时进行（配合 -race）。
	shared := NewRegistry(nil)
	var wg sync.WaitGroup
	for worker := range 8 {
		wg.Add(1)
		go func() {
			defer wg.Done()
			for round := range 200 {
				sid := int32(1 + (worker*200+round)%64)
				_ = shared.Announce(Entry{ServerID: sid, Addr: "gate:7000", Load: round}, time.Minute)
				if round%7 == 0 {
					shared.Withdraw(sid)
				}
				if entries, err := shared.Entries(ctx); err != nil || len(entries) > 64 {
					t.Errorf("concurrent read: %d entries, %v", len(entries), err)
					return
				}
			}
		}()
	}
	wg.Wait()
	if shared.Len() > 64 {
		t.Fatalf("the shared registry holds %d servers after the concurrent run", shared.Len())
	}
}

// 目录返回坏数据时：不成样子的条目与重复的服号（留第一个）被丢掉，那个服在清单里就是没有地址，
// 好的条目不受影响，请求照常成功；坏数据不会被带给客户端。静态目录写错了在构造时就报。Overlay 的叠法。
func TestPortalDropsBadDirectoryEntries(t *testing.T) {
	bad := []Entry{
		{ServerID: 1000, Addr: "203.0.113.7:7000", Load: 12},
		{ServerID: 1000, Addr: "duplicate.example.test:7000"},
		{ServerID: 1001, Addr: ":7000"},
		{ServerID: 0, Addr: "203.0.113.9:7000"},
		{ServerID: -5, Addr: "203.0.113.9:7000"},
		{ServerID: 1002, Addr: "no-port.example.test"},
		{ServerID: 1003, Addr: "203.0.113.10:7000", Load: -1},
		{ServerID: 1004, Addr: "203.0.113.11:7000", Tags: []string{""}},
	}
	w := newPortalWorld(t, func(options *Options) {
		options.Directory = DirectoryFunc(func(context.Context) ([]Entry, error) { return bad, nil })
	})
	for _, sid := range []int32{1002, 1003, 1004} {
		w.upsert(sid, svcaccount.ServerOpen)
	}
	ticket := w.login("alice")
	reply := w.post("/portal/servers", map[string]any{"account_ticket": ticket})
	servers, _ := w.servers(ticket)
	if servers[1000]["addr"] != "203.0.113.7:7000" || servers[1000]["load"] != float64(12) {
		t.Fatalf("the good entry (the first one for 1000) = %v", servers[1000])
	}
	for _, sid := range []int{1001, 1002, 1003, 1004} {
		if servers[sid]["addr"] != "" || servers[sid]["addr_source"] != "none" || servers[sid]["load"] != float64(0) {
			t.Fatalf("server %d, whose directory entry is malformed, = %v; want no address", sid, servers[sid])
		}
	}
	for _, leak := range []string{"duplicate.example.test", "no-port.example.test", "203.0.113.9", "203.0.113.10", "203.0.113.11", ":7000\",\"addr_source\":\"none"} {
		if strings.Contains(reply.raw, leak) {
			t.Fatalf("the response carries a dropped entry (%q): %s", leak, reply.raw)
		}
	}
	if entered := w.enter(ticket, 1001); entered.text("addr") != "" || entered.text("addr_source") != "none" {
		t.Fatalf("enter a server whose entry is malformed: %s", entered.raw)
	}
	// 条目太多：只认前 256 个成样子的。
	many := make([]Entry, 0, 300)
	for sid := int32(1); sid <= 300; sid++ {
		many = append(many, Entry{ServerID: sid, Addr: "203.0.113.7:7000"})
	}
	if usable, dropped := usableEntries(many); len(usable) != 256 || dropped != 44 || usable[256].Addr == "" || usable[257].Addr != "" {
		t.Fatalf("300 entries: %d kept, %d dropped", len(usable), dropped)
	}

	// 静态目录：写错了在构造时报，不等到请求。
	for label, addrs := range map[string]map[int32]string{
		"no host":     {1000: ":7000"},
		"no port":     {1000: "203.0.113.7"},
		"server zero": {0: "203.0.113.7:7000"},
	} {
		if static, err := NewStaticDirectory(addrs); err == nil || static != nil {
			t.Fatalf("%s: NewStaticDirectory accepted it", label)
		}
	}
	tooMany := map[int32]string{}
	for sid := int32(1); sid <= 257; sid++ {
		tooMany[sid] = "203.0.113.7:7000"
	}
	if _, err := NewStaticDirectory(tooMany); err == nil {
		t.Fatal("NewStaticDirectory accepted 257 servers")
	}
	// Overlay：后面的盖住前面的，nil 的层跳过，任何一层出错整体出错。
	base := portalAddrs(t, map[int32]string{1: "base-1:7000", 2: "base-2:7000"})
	top := DirectoryFunc(func(context.Context) ([]Entry, error) {
		return []Entry{
			{ServerID: 2, Addr: "top-2:7000", Load: 9},
			{ServerID: 3, Addr: "top-3:7000"},
			{ServerID: 3, Addr: "top-3-again:7000"},
		}, nil
	})
	merged, err := Overlay(base, nil, top).Entries(context.Background())
	if err != nil || len(merged) != 3 || merged[0].Addr != "base-1:7000" || merged[1].Addr != "top-2:7000" || merged[1].Load != 9 || merged[2].Addr != "top-3:7000" {
		t.Fatalf("Overlay = %+v, %v", merged, err)
	}
	broken := DirectoryFunc(func(context.Context) ([]Entry, error) { return nil, errors.New("down") })
	if entries, err := Overlay(base, broken).Entries(context.Background()); err == nil || entries != nil {
		t.Fatalf("Overlay over a failing layer = %+v, %v", entries, err)
	}
	if entries, err := Overlay().Entries(context.Background()); err != nil || len(entries) != 0 {
		t.Fatalf("an empty Overlay = %+v, %v", entries, err)
	}
}

// portalProcess 是托管 account 服务的进程里入口看得到的东西：配置、本进程的 account 服务、web Mod 的路由登记器。
// 返回 Start 的结果与装着路由的引擎（Start 失败时引擎上没有路由）。
func portalProcess(t *testing.T, accounts svcaccount.Accounts, settings map[string]any) (http.Handler, error) {
	t.Helper()
	cfg := viper.New()
	for key, value := range settings {
		cfg.Set(key, value)
	}
	registry := app.NewRegistry(cfg)
	if accounts != nil {
		if err := registry.Register(svcaccount.CapabilityName, accounts); err != nil {
			t.Fatal(err)
		}
	}
	engine := httpserver.NewEngine()
	if err := registry.Register(mods.ModWeb, webroute.Registerer(webroute.NewRegistrar(engine))); err != nil {
		t.Fatal(err)
	}
	stop, err := Start(registry)
	if stop != nil {
		t.Fatal("Start returned a stop function; the default directory holds nothing to stop")
	}
	return engine, err
}

// 在 account 的进程里启动：零配置就能用——不需要 sid、不需要玩家 TCP 的配置、不需要任何密钥；
// 清单是 account 登记过的服，没有地址。写了 portal.servers（YAML 里服号写成字符串或数字都行）就有地址。
// 生产配置也不需要入口自己的密钥（票据的密钥是 account 的）。缺了 account 服务或 web Mod 时进程不启动，
// 错误说出缺什么；配置写错的条目在启动时点名，一条路由都不登记。
func TestPortalStartsInTheAccountProcessWithZeroConfig(t *testing.T) {
	w := newPortalWorld(t)
	engine, err := portalProcess(t, w.accounts, nil)
	if err != nil {
		t.Fatalf("Start with no configuration at all: %v", err)
	}
	loginPayload := map[string]any{"channel": "dev", "open_id": "alice", "credential": portalDevToken}
	login := portalPost(t, engine, "/portal/login", loginPayload)
	if login.status != http.StatusOK {
		t.Fatalf("zero-config login: %d %s", login.status, login.raw)
	}
	ticket := login.text("account_ticket")
	listed := portalPost(t, engine, "/portal/servers", map[string]any{"account_ticket": ticket})
	if list, _ := listed.body["servers"].([]any); listed.status != http.StatusOK || len(list) != 2 || listed.number("recommended_server_id") != 1001 {
		t.Fatalf("zero-config list: %d %s; want the two servers account knows", listed.status, listed.raw)
	}
	entered := portalPost(t, engine, "/portal/enter", map[string]any{"account_ticket": ticket, "server_id": 1001})
	if entered.status != http.StatusOK || entered.text("addr") != "" || entered.text("addr_source") != "none" {
		t.Fatalf("zero-config enter: %d %s; want a ticket without an address", entered.status, entered.raw)
	}
	if playerID, isNew := w.handshake(entered.text("ticket")); playerID != 100_001 || !isNew {
		t.Fatalf("zero-config handshake: player %d (new %v)", playerID, isNew)
	}
	// 另一个副本（同一个 account，没有共享任何入口自己的密钥）认同一张账号票据：票据是 account 的。
	replica, err := portalProcess(t, w.accounts, map[string]any{"env": "prod"})
	if err != nil {
		t.Fatalf("a production config with no portal.* keys: %v", err)
	}
	if reply := portalPost(t, replica, "/portal/servers", map[string]any{"account_ticket": ticket}); reply.status != http.StatusOK {
		t.Fatalf("another replica refused a ticket account issued: %d %s", reply.status, reply.raw)
	}

	// portal.servers 从配置文件来。
	cfg := viper.New()
	cfg.SetConfigType("yaml")
	if err := cfg.ReadConfig(strings.NewReader(`
portal:
  servers:
    "1001": gate2.example.test:7001
    1000: 203.0.113.7:7000
    4242: 203.0.113.99:7000
`)); err != nil {
		t.Fatal(err)
	}
	settings := map[string]any{}
	for _, key := range cfg.AllKeys() {
		settings[key] = cfg.Get(key)
	}
	configured, err := portalProcess(t, w.accounts, settings)
	if err != nil {
		t.Fatalf("Start with a YAML config: %v", err)
	}
	if reply := portalPost(t, configured, "/portal/enter", map[string]any{"account_ticket": ticket, "server_id": 1001}); reply.text("addr") != "gate2.example.test:7001" || reply.text("addr_source") != "directory" {
		t.Fatalf("enter with portal.servers: %d %s", reply.status, reply.raw)
	}

	// 缺了入口离不开的东西。
	if _, err := portalProcess(t, nil, nil); err == nil || !strings.Contains(err.Error(), "service.account") {
		t.Fatalf("Start without the account service: %v", err)
	}
	noWeb := app.NewRegistry(viper.New())
	if err := noWeb.Register(svcaccount.CapabilityName, svcaccount.Accounts(w.accounts)); err != nil {
		t.Fatal(err)
	}
	if _, err := Start(noWeb); err == nil || !strings.Contains(err.Error(), "roost add mod web") {
		t.Fatalf("Start without the web mod: %v", err)
	}
	if _, err := Start(nil); err == nil {
		t.Fatal("Start without a registry succeeded")
	}
	tooMany := map[string]any{}
	for sid := 1; sid <= 257; sid++ {
		tooMany[strconv.Itoa(sid)] = "203.0.113.7:7000"
	}
	for label, test := range map[string]struct {
		servers map[string]any
		want    string
	}{
		"a key that is not a number": {map[string]any{"main": "203.0.113.7:7000"}, `"main"`},
		"server id zero":             {map[string]any{"0": "203.0.113.7:7000"}, `"0"`},
		"a leading zero":             {map[string]any{"01000": "203.0.113.7:7000"}, `"01000"`},
		"an address without a host":  {map[string]any{"1000": ":7000"}, "portal.servers.1000"},
		"an address without a port":  {map[string]any{"1000": "203.0.113.7"}, "portal.servers.1000"},
		"port zero":                  {map[string]any{"1000": "203.0.113.7:0"}, "portal.servers.1000"},
		"257 servers":                {tooMany, "portal.servers lists 257 servers; at most 256"},
	} {
		refused, err := portalProcess(t, w.accounts, map[string]any{"portal.servers": test.servers})
		if err == nil || !strings.Contains(err.Error(), test.want) {
			t.Fatalf("%s: err = %v, want it to name %s", label, err, test.want)
		}
		if reply := portalPost(t, refused, "/portal/login", loginPayload); reply.status != http.StatusNotFound {
			t.Fatalf("%s: a refused start registered routes (%d)", label, reply.status)
		}
	}
}

// New 不接受没有 account 的入口；没有目录就是“一个地址都没有”。同一条路由登记两次在登记时就报错。
func TestPortalNewRefusesIncompleteOptions(t *testing.T) {
	w := newPortalWorld(t)
	if portal, err := New(Options{}); err == nil || portal != nil {
		t.Fatal("New accepted options without the account service")
	}
	bare, err := New(Options{Accounts: w.accounts})
	if err != nil {
		t.Fatal(err)
	}
	if entries, err := bare.directory.Entries(context.Background()); err != nil || len(entries) != 0 {
		t.Fatalf("the default directory = %+v, %v; want no entries", entries, err)
	}
	registrar := webroute.NewRegistrar(httpserver.NewEngine())
	if err := w.portal.RegisterRoutes(registrar); err != nil {
		t.Fatal(err)
	}
	if err := w.portal.RegisterRoutes(registrar); err == nil || !strings.Contains(err.Error(), "/portal/login") {
		t.Fatalf("registering the routes twice: %v", err)
	}
	if err := w.portal.RegisterRoutes(nil); err == nil {
		t.Fatal("RegisterRoutes accepted a nil registerer")
	}
}
