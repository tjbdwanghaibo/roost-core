// 登录入口的场景。account 是真实的 svcaccount.Service（内存存储）：票据由它签、由它验，区服清单、角色映射、
// 封号都是它自己的行为；身份校验是登录模块写进工程的那一个（开发登录：渠道 dev、凭据是 login.dev_token），
// 握手校验是登录模块的认证器。入口夹在中间，场景证明的是“客户端只经 HTTP 就能从渠道身份走到一条认证过的连接”，
// 以及入口守住了“账号只取自票据”。请求经真实的路由引擎（httpserver.Engine + webroute.Registrar）进处理器，不开端口。
// 只有“account 给不出结论”“account 答非所问”用替身。场景名以 TestPortal 开头；需求里的数在这里写死，不引用被测常量。

// 入口自己的业务码。码值是安装时分配的（不是需求里的数），所以取自定义；account 的码是框架固定的，
// 场景里直接写数字。
var portalCodeRequestInvalid = int(apperrors.ErrPortalRequestInvalid.Code())

const (
	portalDevToken   = "dev-portal-scenarios"
	portalSessionKey = "portal-scenario-session-secret"
)

// portalWorld 是一套内存里的 account 加一个入口。时钟从 2027-01-15 08:00:00 UTC（Unix 1800000000）起，
// account 的两个时钟共用它，由用例拨。玩家号从 100001 起。
type portalWorld struct {
	t        *testing.T
	now      atomic.Int64 // Unix 毫秒
	nextID   atomic.Int64
	stores   portalStores
	service  *svcaccount.Service
	accounts *portalRecordingAccounts
	portal   *Portal
	engine   http.Handler
}

type portalStores struct {
	accounts versionstore.Store[string, svcaccount.Account]
	roles    versionstore.Store[int64, svcaccount.Role]
	slots    versionstore.Store[string, svcaccount.Slot]
}

func (w *portalWorld) clock() time.Time { return time.UnixMilli(w.now.Load()) }

func (w *portalWorld) advance(d time.Duration) { w.now.Add(d.Milliseconds()) }

func (w *portalWorld) Allocate(context.Context, int32) (int64, error) {
	return 100_000 + w.nextID.Add(1), nil
}

// portalRecordingAccounts 包着真实的 account：数每个接口被调了几次、记下带账号的接口收到的 accountID，
// 能让指定的接口答“问不到”（没有码的错误——总线断了、超时就是这个样子），也能把某个接口的回答换掉
// （造一个“答非所问”的 account）。
type portalRecordingAccounts struct {
	svcaccount.Accounts
	mu    sync.Mutex
	calls map[string]int
	// asAccount 是 RoleOnServer / IssueEnterTicket / IssueAccountTicket 收到的 accountID，去重后按出现顺序。
	asAccount []string
	// down 里的接口名一律答 errPortalBusDown。
	down map[string]bool
	// 非 nil 时取代真实的回答。
	login        func() (svcaccount.Account, error)
	issueAccount func() (svcaccount.AccountTicket, error)
	validate     func() (svcaccount.Account, error)
	listServers  func() ([]svcaccount.GameServer, error)
	roleOnServer func(accountID string, serverID int32) (svcaccount.Role, error)
	issueEnter   func(accountID string, serverID int32) (svcaccount.EnterTicket, error)
}

var errPortalBusDown = errors.New("bus: no responders for account (redis 10.9.8.7:6379 unreachable)")

func (accounts *portalRecordingAccounts) enter(method, accountID string) error {
	accounts.mu.Lock()
	defer accounts.mu.Unlock()
	accounts.calls[method]++
	if accountID != "" && (len(accounts.asAccount) == 0 || accounts.asAccount[len(accounts.asAccount)-1] != accountID) {
		accounts.asAccount = append(accounts.asAccount, accountID)
	}
	if accounts.down[method] {
		return errPortalBusDown
	}
	return nil
}

func (accounts *portalRecordingAccounts) count(method string) int {
	accounts.mu.Lock()
	defer accounts.mu.Unlock()
	return accounts.calls[method]
}

// afterTicket 是账号票据校验之后才该发生的调用次数：清单、角色查询、签进服票据。
func (accounts *portalRecordingAccounts) afterTicket() int {
	return accounts.count("ListServers") + accounts.count("RoleOnServer") + accounts.count("IssueEnterTicket")
}

// roleWrites 是入口绝不该碰的接口被调的次数：建角、选角、凭票进服都是握手那一侧的事。
func (accounts *portalRecordingAccounts) roleWrites() int {
	return accounts.count("CreateRole") + accounts.count("SelectRole") + accounts.count("EnterServer")
}

func (accounts *portalRecordingAccounts) seen() string {
	accounts.mu.Lock()
	defer accounts.mu.Unlock()
	return strings.Join(accounts.asAccount, ",")
}

func (accounts *portalRecordingAccounts) fail(methods ...string) {
	accounts.mu.Lock()
	defer accounts.mu.Unlock()
	accounts.down = map[string]bool{}
	for _, method := range methods {
		accounts.down[method] = true
	}
}

func (accounts *portalRecordingAccounts) Login(ctx context.Context, identity svcaccount.Identity) (svcaccount.Account, error) {
	if err := accounts.enter("Login", ""); err != nil {
		return svcaccount.Account{}, err
	}
	if accounts.login != nil {
		return accounts.login()
	}
	return accounts.Accounts.Login(ctx, identity)
}

func (accounts *portalRecordingAccounts) IssueAccountTicket(ctx context.Context, accountID string) (svcaccount.AccountTicket, error) {
	if err := accounts.enter("IssueAccountTicket", accountID); err != nil {
		return svcaccount.AccountTicket{}, err
	}
	if accounts.issueAccount != nil {
		return accounts.issueAccount()
	}
	return accounts.Accounts.IssueAccountTicket(ctx, accountID)
}

func (accounts *portalRecordingAccounts) ValidateAccountTicket(ctx context.Context, ticket string) (svcaccount.Account, error) {
	if err := accounts.enter("ValidateAccountTicket", ""); err != nil {
		return svcaccount.Account{}, err
	}
	if accounts.validate != nil {
		return accounts.validate()
	}
	return accounts.Accounts.ValidateAccountTicket(ctx, ticket)
}

func (accounts *portalRecordingAccounts) ListServers(ctx context.Context) ([]svcaccount.GameServer, error) {
	if err := accounts.enter("ListServers", ""); err != nil {
		return nil, err
	}
	if accounts.listServers != nil {
		return accounts.listServers()
	}
	return accounts.Accounts.ListServers(ctx)
}

func (accounts *portalRecordingAccounts) RoleOnServer(ctx context.Context, accountID string, serverID int32) (svcaccount.Role, error) {
	if err := accounts.enter("RoleOnServer", accountID); err != nil {
		return svcaccount.Role{}, err
