// Package portal 是客户端够得着的登录入口：三个 HTTP 端点，代客户端去问只在内部总线上的 account 服务。
// 它就是常说的 manifest（清单）那一层，缺省与 account 跑在同一个进程里。
//
//	POST /portal/login    渠道身份 -> 账号票据
//	POST /portal/servers  账号票据 -> 区服清单（每个服的地址、负载、本账号有没有角色）与推荐的服
//	POST /portal/enter    账号票据 + 服号 -> 进服票据 + 该连的地址
//
// 客户端走完这三步，拿进服票据去连那个地址（Gate，或直连的 game），握手时出示它；握手的认证器再去问
// account 这个账号在这个服上是哪一名玩家（登录模块 login）。入口不建角、不选角，也不知道玩家号。
//
// 入口是无状态的一层薄壳：HTTP 入参检查、调 account、区服目录（Directory）与推荐规则。它不认证任何人
// （身份由 account 向渠道确认），不持有任何密钥（票据由 account 签发与校验），也不存任何东西。
// 它只守一件事：**账号只取自 account 校验过的账号票据**，绝不取自请求。
//
// 路由在进程启动时登记到本进程的 web Mod（Start），监听地址、超时、请求体上限都是 web.* 的配置。web Mod
// 不做鉴权也不做限流；生产环境它缺省只绑回环地址，对外要放在终止 TLS 的反向代理后面（凭据与票据都在请求体里明文传）。
package portal

import (
	"context"
	"errors"
	"fmt"
	"log/slog"
	"net/http"
	"strings"

	gamelogin "{{MODULE}}/game/login"
	apperrors "{{MODULE}}/internal/errors"

	"github.com/tjbdwanghaibo/roost-core/framework/app"
	"github.com/tjbdwanghaibo/roost-core/infra/base/errcode"
	"github.com/tjbdwanghaibo/roost-core/infra/network/webroute"
	svcaccount "github.com/tjbdwanghaibo/roost-core/service/account"
	"github.com/tjbdwanghaibo/roost-core/wiring/mods"
)

// 三个端点的路径。
const (
	PathLogin   = "/portal/login"
	PathServers = "/portal/servers"
	PathEnter   = "/portal/enter"
)

// 请求的上限。请求体整段读进内存再解码，所以先按 MaxRequestBytes 截断，再逐个字段检查；
// 超过字段上限的请求不去问 account。
const (
	// MaxRequestBytes 是一个请求体的上限（字节），比 web.max_body_bytes 的缺省值小得多：三个端点的请求都很短。
	MaxRequestBytes = 16 << 10
	// MaxChannelBytes / MaxOpenIDBytes / MaxCredentialBytes 是登录请求三个字段的上限。
	// 凭据留得宽：平台的 token、收据可以有几 KB。
	MaxChannelBytes    = 32
	MaxOpenIDBytes     = 128
	MaxCredentialBytes = 8 << 10
	// MaxTicketBytes 是请求里账号票据的上限，与 account 的票据上限一致；更长的不去问 account。
	MaxTicketBytes = 1024
)

// 清单与进服结果里 addr_source 的取值：地址是怎么来的。
const (
	// AddrFromDirectory：区服目录给了这个服的地址。
	AddrFromDirectory = "directory"
	// AddrNone：目录里没有这个服的地址（没有配置、没有登记、登记过期了，或者那一条不成样子）。addr 为空。
	AddrNone = "none"
)

// Portal 是三个端点的处理器。用 New 构造；构造之后只读，请求可以并发。
type Portal struct {
	accounts  svcaccount.Accounts
	directory Directory
	recommend func([]ServerChoice) int32
}

// Options 是 New 的参数。Start 按进程配置填它；测试直接填。
type Options struct {
	// Accounts 是 account 服务（入口与 account 同进程时就是本进程的服务；拆成独立服务时是它的总线客户端）。必填。
	Accounts svcaccount.Accounts
	// Directory 是区服目录；nil 表示一个地址都没有（每个服都照常列出，只是没有地址）。
	Directory Directory
	// Recommend 是推荐规则；nil 取 portal_rules.go 的 recommend。只有测试需要换它。
	Recommend func([]ServerChoice) int32
}

// New 检查参数并返回处理器。
func New(options Options) (*Portal, error) {
	if options.Accounts == nil {
		return nil, errors.New("portal: the account service is required")
	}
	directory := options.Directory
	if directory == nil {
		directory = staticDirectory{}
	}
	rule := options.Recommend
	if rule == nil {
		rule = recommend
	}
	return &Portal{accounts: options.Accounts, directory: directory, recommend: rule}, nil
}

// Start 是模块的服务级启动入口（清单的 runtime）：在托管 account 服务的进程里，全部 Mod 启动之后、
// 路由表冻结之前执行一次，把三个端点登记到本进程的 web Mod。它读配置、取本进程的 account 服务、
// 让 portal_rules.go 选区服目录，任何一样不对都返回错误、进程不启动。返回的停止函数是 newDirectory 给的
// （没有要停的东西时是 nil）。
func Start(registry *app.Registry) (func(context.Context) error, error) {
	if registry == nil {
		return nil, errors.New("portal: the app registry is required")
	}
	var settings config
	if err := app.LoadConfig(registry.Config(), &settings); err != nil {
		return nil, fmt.Errorf("portal: %w", err)
	}
	addrs, err := parseServers(settings.Portal.Servers)
	if err != nil {
		return nil, fmt.Errorf("portal: %w", err)
	}
	configured, err := NewStaticDirectory(addrs)
	if err != nil {
		return nil, err
	}
	accounts, ok := app.Lookup[svcaccount.Accounts](registry, svcaccount.CapabilityName)
	if !ok || accounts == nil {
		return nil, fmt.Errorf("portal: capability %q not found; the login entry runs in the process that hosts the account service (or, split out, in a service that lists account under uses)", svcaccount.CapabilityName)
	}
	routes, ok := app.Lookup[webroute.Registerer](registry, mods.ModWeb)
	if !ok || routes == nil {
		return nil, fmt.Errorf("portal: capability %q not found; add the web mod to the service that hosts account (roost add mod web -service <that service>)", mods.ModWeb)
	}
	directory, stop, err := newDirectory(registry, configured)
	if err != nil {
		return stop, fmt.Errorf("portal: choose the server directory: %w", err)
	}
	if directory == nil {
		return stop, errors.New("portal: newDirectory returned no directory")
	}
	portal, err := New(Options{Accounts: accounts, Directory: directory})
	if err != nil {
		return stop, err
	}
	if err := portal.RegisterRoutes(routes); err != nil {
		return stop, fmt.Errorf("portal: %w", err)
	}
	slog.Info("portal: login entry registered on the web mod", "login", PathLogin, "servers", PathServers, "enter", PathEnter, "configured_addresses", len(addrs))
	return stop, nil
}

// RegisterRoutes 把三个端点登记到 reg（web Mod，或测试里的替身）。实现 webroute.Module。
// 路由只能在服务启动之前登记；同一条路由登记两次（工程自己也占了 /portal/...）会在这里报错。
func (portal *Portal) RegisterRoutes(reg webroute.Registerer) error {
	if reg == nil {
		return errors.New("portal: route registerer is required")
	}
	for _, route := range []struct {
		path    string
		handler http.HandlerFunc
	}{
		{PathLogin, portal.handleLogin},
		{PathServers, portal.handleServers},
		{PathEnter, portal.handleEnter},
	} {
		if err := reg.Register(http.MethodPost, route.path, route.handler); err != nil {
			return err
		}
	}
	return nil
}

var _ webroute.Module = (*Portal)(nil)

// ---- 登录 ----

// loginRequest 是 POST /portal/login 的请求体。
type loginRequest struct {
	// Channel 是登录渠道：开发登录是 "dev"，其余是工程在 internal/service/account/login_channels.go 接的渠道。
	Channel string `json:"channel"`
	// OpenID 是渠道里的用户标识。它只是提示：账号以渠道确认的身份为准（account 的 Login）。
	OpenID string `json:"open_id"`
	// Credential 是交给渠道校验的凭据（开发登录是 login.dev_token 的值）。入口不解释它、不记日志、不回显。
	Credential string `json:"credential"`
}

// loginResponse 是登录成功的响应：只有账号票据。区服清单是下一步（/portal/servers）。
type loginResponse struct {
	OK bool `json:"ok"`
	// AccountTicket 是 account 签发的账号票据：拿清单、要进服票据时原样带上。不要长期保存——
	// 它只有 account.ticket_ttl 那么久（缺省 10 分钟），过期了重新登录。
	AccountTicket string `json:"account_ticket"`
	// AccountTicketExpiresAt 是票据的过期时刻（Unix 秒，服务器的系统时间）。
	AccountTicketExpiresAt int64 `json:"account_ticket_expires_at"`
}

func (portal *Portal) handleLogin(w http.ResponseWriter, r *http.Request) {
	var request loginRequest
	if !decode(w, r, &request) {
		return
	}
	response, err := portal.login(r.Context(), request)
	webroute.WriteResult(w, http.StatusOK, response, err)
}

// login 向 account 确认身份，再向它要一张账号票据。
//
// 票据绑定的是 account 返回的账号（渠道确认过的身份），不是请求里的 open_id：拿自己的凭据配上别人的
// open_id，得到的仍是自己的账号。account 拒绝登录（凭据不对、账号被封、渠道没接）时原样带着它的码答回去。
func (portal *Portal) login(ctx context.Context, request loginRequest) (loginResponse, error) {
	channel, openID := strings.TrimSpace(request.Channel), strings.TrimSpace(request.OpenID)
	if channel == "" || len(channel) > MaxChannelBytes || openID == "" || len(openID) > MaxOpenIDBytes || len(request.Credential) > MaxCredentialBytes {
		return loginResponse{}, invalidRequest()
	}
	account, err := portal.accounts.Login(ctx, svcaccount.Identity{Channel: svcaccount.Channel(channel), OpenID: openID, Credential: request.Credential})
	if err != nil {
		return loginResponse{}, err
	}
	if account.ID == "" {
		return loginResponse{}, errors.New("portal: account answered a login without an account id")
	}
	ticket, err := portal.accounts.IssueAccountTicket(ctx, account.ID)
	if err != nil {
		return loginResponse{}, err
	}
	if ticket.Ticket == "" {
		return loginResponse{}, errors.New("portal: account answered without an account ticket")
	}
	return loginResponse{OK: true, AccountTicket: ticket.Ticket, AccountTicketExpiresAt: ticket.ExpiresAtUnix}, nil
}

// ---- 清单与推荐 ----

// serversRequest 是 POST /portal/servers 的请求体。
type serversRequest struct {
	AccountTicket string `json:"account_ticket"`
}

// serversResponse 是清单。
type serversResponse struct {
	OK bool `json:"ok"`
	// RecommendedServerID 是推荐规则（portal_rules.go 的 recommend）挑的服；0 表示没有推荐。
	RecommendedServerID int32 `json:"recommended_server_id"`
	// Servers 是 account 登记过的全部区服，按服号升序。
	Servers []serverView `json:"servers"`
}

// serverView 是清单里的一个服。
type serverView struct {
	ServerID int32  `json:"server_id"`
	Name     string `json:"name"`
	// Status 是 account 里这个服的状态：open、maintenance、full、closed。新号只能进 open 的服；
	// 已经有角色的在任何状态下都能拿到进服票据。
	Status string `json:"status"`
	// MergedInto 非 0 表示这个服已经并入那个服：这里的老角色照常进（由那个服承载），新号进不了。
	MergedInto int32 `json:"merged_into,omitempty"`
	// Addr 是进这个服该连的地址（它的承载服在目录里的地址）；目录里没有时是空串。
	Addr string `json:"addr"`
	// AddrSource 说明 Addr 是怎么来的：directory、none。
	AddrSource string `json:"addr_source"`
	// Load 与 Tags 是目录给的负载与标签，入口不解释；目录里没有这个服时是 0 与空。
	Load int      `json:"load"`
	Tags []string `json:"tags,omitempty"`
	// Role 是本账号在这个服上的角色；没有是 null——这就是“新号还是旧号”。
	Role *roleView `json:"role"`
}

// roleView 是清单里本账号在一个服上的角色。角色名不在这里：名字是游戏服的数据。
type roleView struct {
	PlayerID int64 `json:"player_id"`
	// ServingServerID 是现在承载它的服；没有合服时就是这个服自己。
	ServingServerID int32 `json:"serving_server_id"`
	CreatedAt       int64 `json:"created_at"`
	// LastLoginAt 是最近一次进服的时间（Unix 秒）；还没进过是 0。
	LastLoginAt int64 `json:"last_login_at"`
	// TransferringTo 非 0 表示这个角色正在换到那个服（还没换完，仍由 ServingServerID 承载）。
	TransferringTo int32 `json:"transferring_to,omitempty"`
}

func (portal *Portal) handleServers(w http.ResponseWriter, r *http.Request) {
	var request serversRequest
	if !decode(w, r, &request) {
		return
	}
	response, err := portal.servers(r.Context(), request)
	webroute.WriteResult(w, http.StatusOK, response, err)
}

// servers 给出清单与推荐。三样东西按服号拼起来：
//
//   - 有哪些服、名字、状态、并没并：account 的 ListServers；
//   - 每个服连哪里、多忙：区服目录（Directory）。地址给的是**承载服**的——并入别的服的服，连的是那个服；
//   - 本账号在每个服有没有角色：account 的 RoleOnServer。“没有角色”是清单的内容，不是错误。
//
// 任何一样问不到（account 出错、目录出错、角色记录对不上）整个请求失败：宁可让客户端重试，
// 也不给一份缺了角色或缺了地址的清单，让玩家以为号没了、或者被推荐去一个其实有号的服的隔壁。
// 开销是 1 次清单 + 每个服 1 次角色查询，顺序执行；区服很多、请求很密的部署见 README 的“边界”。
func (portal *Portal) servers(ctx context.Context, request serversRequest) (serversResponse, error) {
	account, err := portal.account(ctx, request.AccountTicket)
	if err != nil {
		return serversResponse{}, err
	}
	listed, err := portal.accounts.ListServers(ctx)
	if err != nil {
		return serversResponse{}, err
	}
	entries, err := portal.entries(ctx)
	if err != nil {
		return serversResponse{}, err
	}
	views := make([]serverView, 0, len(listed))
	choices := make([]ServerChoice, 0, len(listed))
	for _, server := range listed {
		if server.ID <= 0 {
			return serversResponse{}, errors.New("portal: account listed a server without an id")
		}
		view := serverView{ServerID: server.ID, Name: server.Name, Status: string(server.Status), MergedInto: server.MergedInto}
		serving := server.ID
		if server.MergedInto > 0 {
			serving = server.MergedInto
		}
		view.Addr, view.AddrSource, view.Load, view.Tags = addressOf(entries, serving)
		role, err := portal.accounts.RoleOnServer(ctx, account.ID, server.ID)
		switch {
		case err == nil:
			if role.PlayerID <= 0 || role.AccountID != account.ID || role.ServerID != server.ID {
				return serversResponse{}, fmt.Errorf("portal: account answered the role on server %d with a role that is not this account's role there", server.ID)
			}
			view.Role = &roleView{PlayerID: role.PlayerID, ServingServerID: role.ServingServerID, CreatedAt: role.CreatedAtUnix, LastLoginAt: role.LastLoginAtUnix}
			if role.Transfer != nil {
				view.Role.TransferringTo = role.Transfer.To
			}
		case svcaccount.Code(err) == svcaccount.CodeRoleMissing:
		default:
			return serversResponse{}, err
		}
		views = append(views, view)
		choice := ServerChoice{
			ServerID: view.ServerID, Name: view.Name, Status: view.Status, MergedInto: view.MergedInto,
			Addr: view.Addr, Load: view.Load, Tags: append([]string(nil), view.Tags...),
		}
		if view.Role != nil {
			choice.HasRole, choice.RoleLastLoginAt = true, view.Role.LastLoginAt
		}
		choices = append(choices, choice)
	}
	response := serversResponse{OK: true, Servers: views}
	// 推荐规则是工程的代码：它返回一个不在清单里的服号时按没有推荐处理，不把一个客户端进不了的服推出去。
	if recommended := portal.recommend(choices); recommended > 0 {
		for _, view := range views {
			if view.ServerID == recommended {
				response.RecommendedServerID = recommended
				break
			}
		}
	}
	return response, nil
}

// ---- 进服 ----

// enterRequest 是 POST /portal/enter 的请求体。
type enterRequest struct {
	AccountTicket string `json:"account_ticket"`
	ServerID      int32  `json:"server_id"`
}

// enterResponse 是进服的响应。
type enterResponse struct {
	OK bool `json:"ok"`
	// Ticket 是握手帧里出示的票据（enter:<进服票据>），原样使用。
	Ticket string `json:"ticket"`
	// ServerID 是选中的服，ServingServerID 是承载它的服（选中的服并入了别的服时两者不同）：客户端连的是承载服。
	ServerID        int32 `json:"server_id"`
	ServingServerID int32 `json:"serving_server_id"`
	// ExpiresAt 是进服票据的过期时刻（Unix 秒）：过期之前可以反复握手（断线重连），过期之后重新要一张。
	ExpiresAt int64 `json:"expires_at"`
	// Addr 是承载服的地址（host:port，目录给的）；目录里没有时是空串——票据照发，AddrSource 是 none。
	Addr       string `json:"addr"`
	AddrSource string `json:"addr_source"`
}

func (portal *Portal) handleEnter(w http.ResponseWriter, r *http.Request) {
	var request enterRequest
	if !decode(w, r, &request) {
		return
	}
	response, err := portal.enter(r.Context(), request)
	webroute.WriteResult(w, http.StatusOK, response, err)
}

// enter 替票据里的账号向 account 要一张进 server_id 的进服票据，连同承载服的地址回给客户端。
// 它**不建角、不选角**：这个账号在那个服上是哪一名玩家、要不要新建映射，是握手时认证器问 account 的事。
//
// 账号只取自账号票据。服号必须是 account 登记过的服，否则带着 account 的码拒绝；被封的账号拿不到票据。
// 区服的状态这里不拦（维护中的服，老号照常能进），新号能不能进由握手时的 account 按建角的规则回答。
// 目录里没有承载服的地址时照样成功、地址留空：票据是好的，只是入口不知道该连哪里。
func (portal *Portal) enter(ctx context.Context, request enterRequest) (enterResponse, error) {
	if request.ServerID <= 0 {
		return enterResponse{}, invalidRequest()
	}
	account, err := portal.account(ctx, request.AccountTicket)
	if err != nil {
		return enterResponse{}, err
	}
	ticket, err := portal.accounts.IssueEnterTicket(ctx, account.ID, request.ServerID)
	if err != nil {
		return enterResponse{}, err
	}
	if ticket.Ticket == "" || ticket.ServerID != request.ServerID || ticket.ServingServerID <= 0 {
		// account 答了“成功”，但票据不是问的那个服的、或者没有承载服：不把一张握手必然失败的票据交出去。
		return enterResponse{}, fmt.Errorf("portal: account answered an enter ticket for server %d with one that does not match", request.ServerID)
	}
	entries, err := portal.entries(ctx)
	if err != nil {
		return enterResponse{}, err
	}
	response := enterResponse{
		OK: true, Ticket: gamelogin.EnterTicket(ticket.Ticket),
		ServerID: ticket.ServerID, ServingServerID: ticket.ServingServerID, ExpiresAt: ticket.ExpiresAtUnix,
	}
	response.Addr, response.AddrSource, _, _ = addressOf(entries, ticket.ServingServerID)
	return response, nil
}

// ---- 公共 ----

// account 把请求里的账号票据交给 account 校验，返回它绑定的账号。这是入口里账号的唯一来源。
// 票据为空或超长的不去问 account，直接按 account 对无效票据的同一个回答（它的码）拒绝。
func (portal *Portal) account(ctx context.Context, ticket string) (svcaccount.Account, error) {
	if ticket == "" || len(ticket) > MaxTicketBytes {
		return svcaccount.Account{}, fmt.Errorf("%w: the ticket is not valid", svcaccount.ErrSessionInvalid)
	}
	account, err := portal.accounts.ValidateAccountTicket(ctx, ticket)
	if err != nil {
		return svcaccount.Account{}, err
	}
	if account.ID == "" {
		return svcaccount.Account{}, errors.New("portal: account validated a ticket without an account id")
	}
	return account, nil
}

// entries 问一次区服目录，整理成 服号 -> 条目（丢掉不成样子的与重复的，见 Directory 的约定）。
func (portal *Portal) entries(ctx context.Context) (map[int32]Entry, error) {
	raw, err := portal.directory.Entries(ctx)
	if err != nil {
		return nil, fmt.Errorf("portal: the server directory gave no answer: %w", err)
	}
	usable, dropped := usableEntries(raw)
	if dropped > 0 {
		slog.Warn("portal: the server directory returned entries that were dropped (bad server id, address, load or tags, a duplicate, or over the limit)", "dropped", dropped, "kept", len(usable))
	}
	return usable, nil
}

// addressOf 取 sid 这个服在目录里的地址、负载与标签。
func addressOf(entries map[int32]Entry, sid int32) (addr, source string, load int, tags []string) {
	entry, ok := entries[sid]
	if !ok {
		return "", AddrNone, 0, nil
	}
	return entry.Addr, AddrFromDirectory, entry.Load, entry.Tags
}

// decode 读一个 JSON 请求体。超过 MaxRequestBytes 答 413，不是 JSON 答 400（两者都由 webroute 写好了响应，
// 返回 false 时调用方直接返回）。不认识的字段被忽略——请求里夹带 account_id 不起任何作用，
// 因为请求结构体里根本没有这个字段。
func decode[T any](w http.ResponseWriter, r *http.Request, target *T) bool {
	r.Body = http.MaxBytesReader(w, r.Body, MaxRequestBytes)
	return webroute.DecodeJSON(w, r, target)
}

func invalidRequest() error { return errcode.Wrap(apperrors.ErrPortalRequestInvalid, nil) }
