// Package portal 是客户端够得着的登录入口：三个 HTTP 端点，代客户端去问只在内部总线上的 account 服务。
//
//	POST /portal/login        渠道身份 -> 账号票据 + 区服清单（每个服上本账号的角色）
//	POST /portal/create-role  账号票据 + 服号 + 名字 -> 角色
//	POST /portal/select-role  账号票据 + 玩家号 -> 握手票据（session:<player_id>:<token>）+ 该连的 TCP 地址
//
// 客户端走完这三步，拿握手票据去连玩家 TCP（登录模块 login 的认证器校验它），再发进入游戏的请求。
//
// 入口自己不存任何东西，也不认证任何人：身份由 account 向渠道确认（Login），角色归谁由 account 判断
// （SelectRole 的归属检查）。入口只守一件事——account 的 CreateRole / SelectRole 信任调用方给的 accountID，
// 所以这个 accountID 只能来自入口自己签发的账号票据（portal_ticket.go），绝不来自请求。
//
// 路由在服务启动时登记到 web Mod（Start），监听地址、超时、请求体上限都是 web.* 的配置。web Mod 不做鉴权也
// 不做限流；生产环境它缺省只绑回环地址，对外要放在终止 TLS 的反向代理后面（凭据与票据都在请求体里明文传）。
package portal

import (
	"context"
	"crypto/rand"
	"errors"
	"fmt"
	"log/slog"
	"net/http"
	"strings"
	"time"

	gamelogin "{{MODULE}}/game/login"
	apperrors "{{MODULE}}/internal/errors"

	"github.com/tjbdwanghaibo/roost-core/framework/app"
	"github.com/tjbdwanghaibo/roost-core/infra/base/errcode"
	"github.com/tjbdwanghaibo/roost-core/infra/network/webroute"
	svcaccount "github.com/tjbdwanghaibo/roost-core/service/account"
	"github.com/tjbdwanghaibo/roost-core/wiring/mods"
)

// 三个端点的路径。
const (
	PathLogin      = "/portal/login"
	PathCreateRole = "/portal/create-role"
	PathSelectRole = "/portal/select-role"
)

// 请求的上限。请求体整段读进内存再解码，所以先按 MaxRequestBytes 截断，再逐个字段检查；
// 超过字段上限的请求不去问 account。
const (
	// MaxRequestBytes 是一个请求体的上限（字节），比 web.max_body_bytes 的缺省值小得多：三个端点的请求都很短。
	MaxRequestBytes = 16 << 10
	// MaxChannelBytes / MaxOpenIDBytes / MaxCredentialBytes 是登录请求三个字段的上限。
	// 凭据留得宽：平台的 token、收据可以有几 KB。
	MaxChannelBytes    = 32
	MaxOpenIDBytes     = 128
	MaxCredentialBytes = 8 << 10
	// MaxNameBytes 是建角请求里名字的上限。它只是“不把明显过长的东西送去 account”的闸，
	// 名字真正的规则是 account 的 NameRules（internal/service/account/collaborators.go）。
	MaxNameBytes = 128
)

// Portal 是三个端点的处理器。用 New 构造；构造之后只读，请求可以并发。
type Portal struct {
	accounts svcaccount.Accounts
	tickets  *ticketKeeper
	servers  serverBook
}

// Options 是 New 的参数。Start 按进程配置填它；测试直接填。
type Options struct {
	// Accounts 是 account 服务的客户端（game 进程里由 account 的 ClientMod 发布）。必填。
	Accounts svcaccount.Accounts
	// TicketSecret 是账号票据的签名密钥，至少 MinSecretBytes 字节。必填——“没配置就随机生成”是 Start 的事。
	TicketSecret []byte
	// TicketTTL 是账号票据的有效期；零取 10 分钟。
	TicketTTL time.Duration
	// SelfServerID 是本进程的 sid。必填。
	SelfServerID int32
	// Servers 是 portal.servers（服号 -> 客户端连得到的 TCP 地址）；空表示清单只有本服。
	Servers map[int32]string
	// PlayerTCPEnabled / PlayerTCPListen 是本进程玩家 TCP 的开关与监听地址，没有配置 Servers 时用来回答本服的地址。
	PlayerTCPEnabled bool
	PlayerTCPListen  string
	// Now 是系统时钟（账号票据的过期按它算）；nil 取 time.Now。
	Now func() time.Time
}

// New 检查参数并返回处理器。
func New(options Options) (*Portal, error) {
	if options.Accounts == nil {
		return nil, errors.New("portal: the account client is required")
	}
	if len(options.TicketSecret) < MinSecretBytes {
		return nil, fmt.Errorf("portal: the ticket secret is %d bytes; it must be at least %d", len(options.TicketSecret), MinSecretBytes)
	}
	if options.SelfServerID <= 0 {
		return nil, errors.New("portal: this process has no positive sid")
	}
	if len(options.Servers) > MaxServers {
		return nil, fmt.Errorf("portal: %d servers listed; at most %d", len(options.Servers), MaxServers)
	}
	if options.TicketTTL <= 0 {
		options.TicketTTL = 10 * time.Minute
	}
	configured := make(map[int32]string, len(options.Servers))
	for sid, addr := range options.Servers {
		configured[sid] = addr
	}
	return &Portal{
		accounts: options.Accounts,
		tickets:  newTicketKeeper(options.TicketSecret, options.TicketTTL, options.Now),
		servers: serverBook{
			self: options.SelfServerID, configured: configured,
			tcpEnabled: options.PlayerTCPEnabled, tcpListen: options.PlayerTCPListen,
		},
	}, nil
}

// Start 是模块的服务级启动入口（清单的 runtime）：全部 Mod 启动之后、业务 Service.Init 之前执行一次，
// 把三个端点登记到本进程的 web Mod。它读配置、取 account 的客户端，任何一样不对都返回错误、进程不启动——
// 一个签不了票据、问不到 account 的登录入口不该开门。没有需要停止的东西，所以不返回停止函数。
func Start(registry *app.Registry) (func(context.Context) error, error) {
	if registry == nil {
		return nil, errors.New("portal: the app registry is required")
	}
	var settings config
	if err := app.LoadConfig(registry.Config(), &settings); err != nil {
		return nil, fmt.Errorf("portal: %w", err)
	}
	servers, err := parseServers(settings.Portal.Servers)
	if err != nil {
		return nil, fmt.Errorf("portal: %w", err)
	}
	var identity app.ServiceIdentity
	if err := app.LoadConfig(registry.Config(), &identity); err != nil {
		return nil, fmt.Errorf("portal: read this process's sid: %w", err)
	}
	var tcp playerTCPConfig
	if err := app.LoadConfig(registry.Config(), &tcp); err != nil {
		return nil, fmt.Errorf("portal: read the player tcp listener: %w", err)
	}
	accounts, ok := app.Lookup[svcaccount.Accounts](registry, svcaccount.CapabilityName)
	if !ok || accounts == nil {
		return nil, fmt.Errorf("portal: capability %q not found; the service that runs the login entry must list account under services.<service>.uses in roost.yaml", svcaccount.CapabilityName)
	}
	routes, ok := app.Lookup[webroute.Registerer](registry, mods.ModWeb)
	if !ok || routes == nil {
		return nil, fmt.Errorf("portal: capability %q not found; add the web mod to this service (roost add mod web -service <service>)", mods.ModWeb)
	}
	secret := []byte(settings.Portal.TicketSecret)
	if len(secret) == 0 {
		// 只会在非生产配置下走到这里：生产配置里密钥为空，上面读配置时已经拒绝了。
		secret = make([]byte, MinSecretBytes)
		if _, err := rand.Read(secret); err != nil {
			return nil, fmt.Errorf("portal: generate a ticket secret: %w", err)
		}
		slog.Info("portal: portal.ticket_secret is not set; signing account tickets with a random secret generated for this process. " +
			"Tickets die when the process restarts and no other process accepts them; set portal.ticket_secret to share or keep them")
	}
	portal, err := New(Options{
		Accounts: accounts, TicketSecret: secret, TicketTTL: settings.Portal.TicketTTL,
		SelfServerID: identity.Sid, Servers: servers,
		PlayerTCPEnabled: tcp.Enabled, PlayerTCPListen: tcp.Addr,
	})
	if err != nil {
		return nil, err
	}
	if err := portal.RegisterRoutes(routes); err != nil {
		return nil, fmt.Errorf("portal: %w", err)
	}
	slog.Info("portal: login entry registered on the web mod", "login", PathLogin, "create_role", PathCreateRole, "select_role", PathSelectRole,
		"sid", identity.Sid, "listed_servers", len(portal.servers.list()), "servers_configured", len(servers) > 0, "ticket_ttl", settings.Portal.TicketTTL.String())
	return nil, nil
}

// RegisterRoutes 把三个端点登记到 reg（web Mod，或测试里的替身）。实现 webroute.Module。
// 路由只能在服务启动之前登记；同一条路由登记两次（工程自己也占了 /portal/...）会在这里报错。
func (portal *Portal) RegisterRoutes(reg webroute.Registerer) error {
	if reg == nil {
		return errors.New("portal: route registerer is required")
	}
	for _, route := range []struct {
		path    string
		handler http.HandlerFunc
	}{
		{PathLogin, portal.handleLogin},
		{PathCreateRole, portal.handleCreateRole},
		{PathSelectRole, portal.handleSelectRole},
	} {
		if err := reg.Register(http.MethodPost, route.path, route.handler); err != nil {
			return err
		}
	}
	return nil
}

var _ webroute.Module = (*Portal)(nil)

// ---- 登录 ----

// loginRequest 是 POST /portal/login 的请求体。
type loginRequest struct {
	// Channel 是登录渠道：开发登录是 "dev"，其余是工程在 internal/service/account/login_channels.go 接的渠道。
	Channel string `json:"channel"`
	// OpenID 是渠道里的用户标识。它只是提示：账号以渠道确认的身份为准（account 的 Login）。
	OpenID string `json:"open_id"`
	// Credential 是交给渠道校验的凭据（开发登录是 login.dev_token 的值）。入口不解释它、不记日志、不回显。
	Credential string `json:"credential"`
}

// loginResponse 是登录成功的响应。
type loginResponse struct {
	OK bool `json:"ok"`
	// AccountTicket 是账号票据：建角、选角时原样带上。不要长期保存——它只有 portal.ticket_ttl 那么久。
	AccountTicket string `json:"account_ticket"`
	// AccountTicketExpiresAt 是票据的过期时刻（Unix 秒，服务器的系统时间）。
	AccountTicketExpiresAt int64 `json:"account_ticket_expires_at"`
	// Servers 是区服清单，按服号升序。
	Servers []serverView `json:"servers"`
}

// serverView 是清单里的一个服，连同本账号在这个服上的角色。
type serverView struct {
	ServerID int32 `json:"server_id"`
	// Registered 为 false 表示 account 里没有登记这个服（清单里有、但没有人跑过 accountctl upsert-server）：
	// 这样的服建不了角，Name 与 Status 为空。
	Registered bool   `json:"registered"`
	Name       string `json:"name"`
	// Status 是 account 里这个服的状态：open、maintenance、full、closed。只有 open 的服能建角；
	// 已有角色在任何状态下都能选。
	Status string `json:"status"`
	// MergedInto 非 0 表示这个服已经并入那个服：这里的角色照常选，由那个服承载；不能在这里建新角色。
	MergedInto int32 `json:"merged_into,omitempty"`
	// Role 是本账号在这个服上的角色；没有时是 null，客户端该引导建角。
	Role *roleView `json:"role"`
}

// roleView 是回给客户端的角色。
type roleView struct {
	PlayerID int64  `json:"player_id"`
	Name     string `json:"name"`
	// ServerID 是角色绑定的服（原服），ServingServerID 是现在承载它的服；没有合服时两者相同。
	ServerID        int32 `json:"server_id"`
	ServingServerID int32 `json:"serving_server_id"`
	CreatedAt       int64 `json:"created_at"`
	// TransferringTo 非 0 表示这个角色正在换到那个服（还没换完，仍由 ServingServerID 承载）。
	TransferringTo int32 `json:"transferring_to,omitempty"`
}

func roleViewOf(role svcaccount.Role) *roleView {
	view := &roleView{
		PlayerID: role.PlayerID, Name: role.Name, ServerID: role.ServerID,
		ServingServerID: role.ServingServerID, CreatedAt: role.CreatedAtUnix,
	}
	if role.Transfer != nil {
		view.TransferringTo = role.Transfer.To
	}
	return view
}

func (portal *Portal) handleLogin(w http.ResponseWriter, r *http.Request) {
	var request loginRequest
	if !decode(w, r, &request) {
		return
	}
	response, err := portal.login(r.Context(), request)
	webroute.WriteResult(w, http.StatusOK, response, err)
}

// login 向 account 确认身份，签发账号票据，再列出区服清单。
//
// 票据里的 accountID 取自 account 返回的账号（渠道确认过的身份），不是请求里的 open_id：
// 拿自己的凭据配上别人的 open_id，得到的仍是自己的账号。account 拒绝登录（凭据不对、账号被封、
// 渠道没接）时原样带着它的码答回去，不签票据。
//
// 清单里每个服问 account 两次：区服记录（GetServer）与本账号在那个服的角色（RoleOnServer）。
// “没有登记这个服”“这个服上没有角色”是清单的内容，不是错误；其余的失败（account 不可达、存储出错、
// 记录对不上）让整个登录失败——宁可让客户端重试，也不给一份缺了角色的清单，让玩家以为号没了。
func (portal *Portal) login(ctx context.Context, request loginRequest) (loginResponse, error) {
	channel, openID := strings.TrimSpace(request.Channel), strings.TrimSpace(request.OpenID)
	if channel == "" || len(channel) > MaxChannelBytes || openID == "" || len(openID) > MaxOpenIDBytes || len(request.Credential) > MaxCredentialBytes {
		return loginResponse{}, invalidRequest()
	}
	account, err := portal.accounts.Login(ctx, svcaccount.Identity{Channel: svcaccount.Channel(channel), OpenID: openID, Credential: request.Credential})
	if err != nil {
		return loginResponse{}, err
	}
	if account.ID == "" {
		return loginResponse{}, errors.New("portal: account answered a login without an account id")
	}
	servers := make([]serverView, 0, len(portal.servers.list()))
	for _, sid := range portal.servers.list() {
		view, err := portal.serverView(ctx, account.ID, sid)
		if err != nil {
			return loginResponse{}, err
		}
		servers = append(servers, view)
	}
	// 清单都拿到了才签票据：失败的登录不留下一张可用的票据。
	ticket, expiresAt := portal.tickets.issue(account.ID)
	return loginResponse{OK: true, AccountTicket: ticket, AccountTicketExpiresAt: expiresAt, Servers: servers}, nil
}

func (portal *Portal) serverView(ctx context.Context, accountID string, sid int32) (serverView, error) {
	view := serverView{ServerID: sid}
	server, err := portal.accounts.GetServer(ctx, sid)
	switch {
	case err == nil:
		view.Registered, view.Name, view.Status, view.MergedInto = true, server.Name, string(server.Status), server.MergedInto
	case svcaccount.Code(err) == svcaccount.CodeServerInvalid:
		// 清单里有、account 里没登记：照实列出来，运维一眼看得出少了哪一步。
	default:
		return serverView{}, err
	}
	role, err := portal.accounts.RoleOnServer(ctx, accountID, sid)
	switch {
	case err == nil:
		if role.PlayerID <= 0 || role.AccountID != accountID {
			return serverView{}, fmt.Errorf("portal: account answered the role on server %d with a role that is not this account's", sid)
		}
		view.Role = roleViewOf(role)
	case svcaccount.Code(err) == svcaccount.CodeRoleMissing:
	default:
		return serverView{}, err
	}
	return view, nil
}

// ---- 建角 ----

// createRoleRequest 是 POST /portal/create-role 的请求体。
type createRoleRequest struct {
	AccountTicket string `json:"account_ticket"`
	ServerID      int32  `json:"server_id"`
	Name          string `json:"name"`
}

// createRoleResponse 是建角成功的响应。
type createRoleResponse struct {
	OK   bool      `json:"ok"`
	Role *roleView `json:"role"`
}

func (portal *Portal) handleCreateRole(w http.ResponseWriter, r *http.Request) {
	var request createRoleRequest
	if !decode(w, r, &request) {
		return
	}
	response, err := portal.createRole(r.Context(), request)
	webroute.WriteResult(w, http.StatusOK, response, err)
}

// createRole 给票据里的账号在 server_id 上建角。名字的规则、服开没开、名额、重名都由 account 判断，
// 它的拒绝原样带码答回去。同一个名字重试是安全的：account 把它接到同一个建角计划上，回同一个角色
// （回复丢了的那一次也算）；换一个名字不会多得一个角色。
//
// 不限制 server_id 必须在清单里：能不能在那个服建角是 account 的区服记录说了算，入口不再加一层口径。
func (portal *Portal) createRole(ctx context.Context, request createRoleRequest) (createRoleResponse, error) {
	if request.ServerID <= 0 || request.Name == "" || len(request.Name) > MaxNameBytes {
		return createRoleResponse{}, invalidRequest()
	}
	accountID, err := portal.tickets.verify(request.AccountTicket)
	if err != nil {
		return createRoleResponse{}, err
	}
	role, err := portal.accounts.CreateRole(ctx, accountID, request.ServerID, request.Name)
	if err != nil {
		return createRoleResponse{}, err
	}
	return createRoleResponse{OK: true, Role: roleViewOf(role)}, nil
}

// ---- 选角 ----

// selectRoleRequest 是 POST /portal/select-role 的请求体。
type selectRoleRequest struct {
	AccountTicket string `json:"account_ticket"`
	PlayerID      int64  `json:"player_id"`
}

// selectRoleResponse 是选角成功的响应。
type selectRoleResponse struct {
	OK bool `json:"ok"`
	// Ticket 是玩家 TCP 握手帧里出示的票据（session:<player_id>:<token>），原样使用。
	Ticket   string `json:"ticket"`
	PlayerID int64  `json:"player_id"`
	// ServerID 是角色绑定的服（原服），ServingServerID 是承载它的服：客户端要连的是承载服。
	ServerID        int32 `json:"server_id"`
	ServingServerID int32 `json:"serving_server_id"`
	// ExpiresAt 是握手票据的过期时刻（Unix 秒）：过期之前可以反复握手（断线重连），过期之后重新选角。
	ExpiresAt int64 `json:"expires_at"`
	// TCPAddr 是承载服的玩家 TCP 地址（host:port）。可能为空——TCPAddrSource 说明原因。
	TCPAddr string `json:"tcp_addr"`
	// TCPAddrSource 说明地址是怎么来的（config、listen、request_host），地址为空时说明为什么没有
	// （unlisted_server、tcp_disabled、unknown）。取值与含义见 portal_servers.go。
	TCPAddrSource string `json:"tcp_addr_source"`
	// TransferringTo 非 0 表示这个角色正在换到那个服。票据照发，进入游戏时由换服模块决定放不放行。
	TransferringTo int32 `json:"transferring_to,omitempty"`
}

func (portal *Portal) handleSelectRole(w http.ResponseWriter, r *http.Request) {
	var request selectRoleRequest
	if !decode(w, r, &request) {
		return
	}
	response, err := portal.selectRole(r.Context(), request, r.Host)
	webroute.WriteResult(w, http.StatusOK, response, err)
}

// selectRole 给票据里的账号选 player_id 这个角色，拿到 account 签发的会话令牌，拼成握手票据。
// 角色是不是这个账号的由 account 判断（存储里角色的归属对票据里的账号）：拿自己的票据选别人的角色，
// account 答“不是你的角色”，入口原样带码拒绝，不签发任何东西。
//
// 承载服不在清单里（或者本服的监听没开）时照样成功、地址留空：票据是好的，只是入口不知道那个服的地址。
func (portal *Portal) selectRole(ctx context.Context, request selectRoleRequest, requestHost string) (selectRoleResponse, error) {
	if request.PlayerID <= 0 {
		return selectRoleResponse{}, invalidRequest()
	}
	accountID, err := portal.tickets.verify(request.AccountTicket)
	if err != nil {
		return selectRoleResponse{}, err
	}
	session, err := portal.accounts.SelectRole(ctx, accountID, request.PlayerID)
	if err != nil {
		return selectRoleResponse{}, err
	}
	if session.PlayerID != request.PlayerID || session.Token == "" || session.ServingServerID <= 0 {
		// account 答了“成功”，但会话不是问的那个角色、没有令牌或没有承载服：不拼一张握手必然失败的票据。
		return selectRoleResponse{}, fmt.Errorf("portal: account answered select-role for player %d with an unusable session", request.PlayerID)
	}
	response := selectRoleResponse{
		OK: true, Ticket: gamelogin.Ticket(session.PlayerID, session.Token), PlayerID: session.PlayerID,
		ServerID: session.ServerID, ServingServerID: session.ServingServerID, ExpiresAt: session.ExpiresAtUnix,
	}
	response.TCPAddr, response.TCPAddrSource = portal.servers.tcpAddr(session.ServingServerID, requestHost)
	if session.Transfer != nil {
		response.TransferringTo = session.Transfer.To
	}
	return response, nil
}

// ---- 公共 ----

// decode 读一个 JSON 请求体。超过 MaxRequestBytes 答 413，不是 JSON 答 400（两者都由 webroute 写好了响应，
// 返回 false 时调用方直接返回）。不认识的字段被忽略——请求里夹带 account_id 不起任何作用，
// 因为请求结构体里根本没有这个字段。
func decode[T any](w http.ResponseWriter, r *http.Request, target *T) bool {
	r.Body = http.MaxBytesReader(w, r.Body, MaxRequestBytes)
	return webroute.DecodeJSON(w, r, target)
}

func invalidRequest() error { return errcode.Wrap(apperrors.ErrPortalRequestInvalid, nil) }
