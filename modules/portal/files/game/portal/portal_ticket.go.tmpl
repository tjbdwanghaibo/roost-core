package portal

import (
	"crypto/hmac"
	"crypto/sha256"
	"encoding/base64"
	"strconv"
	"strings"
	"time"

	apperrors "{{MODULE}}/internal/errors"

	"github.com/tjbdwanghaibo/roost-core/infra/base/errcode"
)

// 账号票据：登录成功之后入口签发给客户端、建角与选角时出示的短期凭证。它是整个入口的安全核心——
// account 的 CreateRole / SelectRole 把 accountID 当作“可信调用方已经认证过的身份”，入口就是那个调用方，
// 所以入口绝不从请求里读 accountID，只认自己签过的票据里的那一个。
//
// 格式（四段，点号分隔，全部是 URL 安全的字符）：
//
//	pt1.<过期时刻 Unix 秒>.<base64url(accountID)>.<base64url(HMAC-SHA256(密钥, 前三段连同两个点号))>
//
// 第一段是版本：格式或算法要变时换成 pt2，旧票据自然失效。签名覆盖版本、过期时刻与账号，改任何一段都验不过。
// 票据不落库、不能单张吊销：有效期（portal.ticket_ttl，缺省 10 分钟）就是它的全部寿命；
// 要让在外的票据立刻全部作废，换 portal.ticket_secret。
const ticketVersion = "pt1"

// MaxTicketBytes 是票据的长度上限。账号 ID 至多一百多字节，正常的票据在 400 字节以内；超过上限的直接拒绝，
// 不做任何计算。
const MaxTicketBytes = 1024

// MinSecretBytes 是配置的票据密钥的最短长度（字节）。
const MinSecretBytes = 32

// ticketKeeper 签发与校验账号票据。零值不可用，用 newTicketKeeper 构造；构造之后只读，可以并发使用。
type ticketKeeper struct {
	secret []byte
	ttl    time.Duration
	// now 是系统时钟：票据的寿命是真实时间里的安全界限，不跟业务时间的偏移走（与 account 的会话令牌相同）。
	now func() time.Time
}

func newTicketKeeper(secret []byte, ttl time.Duration, now func() time.Time) *ticketKeeper {
	if now == nil {
		now = time.Now
	}
	return &ticketKeeper{secret: append([]byte(nil), secret...), ttl: ttl, now: now}
}

// issue 给 accountID 签一张票据，返回票据与它的过期时刻（Unix 秒）。accountID 必须来自 account 的 Login
// 返回的账号——调用方保证，这里不判断。
func (keeper *ticketKeeper) issue(accountID string) (ticket string, expiresAtUnix int64) {
	expiresAtUnix = keeper.now().Add(keeper.ttl).Unix()
	signed := ticketVersion + "." + strconv.FormatInt(expiresAtUnix, 10) + "." + base64.RawURLEncoding.EncodeToString([]byte(accountID))
	return signed + "." + base64.RawURLEncoding.EncodeToString(keeper.mac(signed)), expiresAtUnix
}

// verify 校验一张票据，返回它绑定的 accountID。任何一种不通过——超长、段数不对、版本不认识、签名不对
// （被改过、别的密钥签的）、已过期、账号段解不出来——都返回同一个 ErrPortalTicketInvalid，
// 错误里不带票据也不带原因：对方不该知道差在哪里。
//
// 顺序是先验签名、再看内容：没验过签名的过期时刻与账号是对方随手写的，不值得解析。签名用定长时间比较
// （hmac.Equal），比较所花的时间不随“前几个字节对了”而变。
func (keeper *ticketKeeper) verify(ticket string) (accountID string, err error) {
	if len(ticket) == 0 || len(ticket) > MaxTicketBytes {
		return "", invalidTicket()
	}
	parts := strings.Split(ticket, ".")
	if len(parts) != 4 || parts[0] != ticketVersion {
		return "", invalidTicket()
	}
	presented, decodeErr := base64.RawURLEncoding.DecodeString(parts[3])
	if decodeErr != nil {
		return "", invalidTicket()
	}
	signed := ticket[:len(ticket)-len(parts[3])-1]
	if !hmac.Equal(presented, keeper.mac(signed)) {
		return "", invalidTicket()
	}
	expiresAtUnix, parseErr := strconv.ParseInt(parts[1], 10, 64)
	if parseErr != nil || keeper.now().Unix() >= expiresAtUnix {
		return "", invalidTicket()
	}
	account, decodeErr := base64.RawURLEncoding.DecodeString(parts[2])
	if decodeErr != nil || len(account) == 0 {
		return "", invalidTicket()
	}
	return string(account), nil
}

func (keeper *ticketKeeper) mac(signed string) []byte {
	mac := hmac.New(sha256.New, keeper.secret)
	mac.Write([]byte(signed))
	return mac.Sum(nil)
}

func invalidTicket() error { return errcode.Wrap(apperrors.ErrPortalTicketInvalid, nil) }
