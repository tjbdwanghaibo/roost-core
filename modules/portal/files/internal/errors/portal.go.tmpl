package errors

import "github.com/tjbdwanghaibo/roost-core/infra/base/errcode"

// 登录入口（portal）自己的业务码；码值在安装时从 roost.yaml 的 ids.errcode 分配，发布后不要改。
// 票据不对、凭据不对、账号被封、区服没登记……都不在这里：那些是 account 的判断，入口原样带着 account 的码答回去。
var (
	// ErrPortalRequestInvalid：请求本身不成样子——必填字段没填、字段超过长度上限、服号不是正数。
	// 这样的请求不去问 account。重试同一个请求没有用。
	ErrPortalRequestInvalid = errcode.Define({{ID:errcode:portal_request_invalid}}, "portal_request_invalid", "the request is missing a field or a field is out of bounds")
)
