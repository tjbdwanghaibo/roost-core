package portal

import (
	"errors"
	"fmt"
	"sort"
	"strconv"
)

// config 是入口在托管 account 服务的进程配置（configs/service/config.<account 服务>.yaml）里读的键，可以不写：
//
//	portal:
//	  servers:                   # 静态的区服目录：服号 -> 客户端连得到的地址（host:port，通常是 Gate）
//	    "1000": 203.0.113.7:7000
//	    "1001": 203.0.113.8:7000
//
// 入口没有自己的密钥，也没有票据的有效期：票据由 account 签发与校验（account.session_secret、
// account.ticket_ttl、account.session_ttl）。
//
// 这个键由入口在启动时自己读（Start），不在 App 的配置声明里：`--print-config` 不会打印这一段，
// `--check-config` 也不检查它，写错了要等进程启动到入口这一步才报错并退出。
type config struct {
	Portal struct {
		Servers map[string]string `config:"servers" help:"静态的区服目录：服号 -> 客户端连得到的地址（host:port，通常是 Gate）。有哪些服由 account 说了算，这里只给地址；没写地址的服照常列出、没有地址"`
	} `config:"portal"`
}

// ValidateConfig 在读配置时执行（进程启动时，任何请求之前），不通过进程不启动：
// servers 的键不是正的服号、值不是带主机的 host:port、条数超过 MaxEntries——拒绝，点名是哪一条。
func (c *config) ValidateConfig(bool) error {
	var problems []error
	if len(c.Portal.Servers) > MaxEntries {
		problems = append(problems, fmt.Errorf("config: portal.servers lists %d servers; at most %d", len(c.Portal.Servers), MaxEntries))
	}
	if _, err := parseServers(c.Portal.Servers); err != nil {
		problems = append(problems, err)
	}
	return errors.Join(problems...)
}

// parseServers 把 portal.servers 变成 服号 -> 地址。键必须是正的服号的规范十进制写法（"+7"、"007" 不算），
// 值必须是带主机的 host:port——只写端口（":7000"）的地址客户端连不了。
func parseServers(raw map[string]string) (map[int32]string, error) {
	servers := make(map[int32]string, len(raw))
	keys := make([]string, 0, len(raw))
	for key := range raw {
		keys = append(keys, key)
	}
	sort.Strings(keys)
	for _, key := range keys {
		sid, err := strconv.ParseInt(key, 10, 32)
		if err != nil || sid <= 0 || strconv.FormatInt(sid, 10) != key {
			return nil, fmt.Errorf("config: portal.servers key %q is not a server id (a positive number, the game process's sid)", key)
		}
		addr, err := checkAddr(raw[key])
		if err != nil {
			return nil, fmt.Errorf("config: portal.servers.%s: %w", key, err)
		}
		servers[int32(sid)] = addr
	}
	return servers, nil
}
