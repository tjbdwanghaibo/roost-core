package teamroster

import (
	"fmt"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"

	"{{MODULE}}/game/view"
	"math"
	"slices"

	apperrors "{{MODULE}}/internal/errors"
)

// 队伍规则归工程所有；邀请不占座位，接受时再核对容量。
const MaxMembers = 8
const MaxInvites = 64
const InviteMillis int64 = 60000

// Owner 是 TeamRoster 组件的宿主：view 的 TeamEntity（Team 的接线见 game/entities/team/roster_component.go）。
// 只在 Team 被 Nest 锁住期间使用。
type Owner = view.TeamEntity

// Component 是 Team 的权威成员表规则：建队、邀请、入队、离队、解散与匹配冻结。
// 它不存状态，全部事实在 TeamDao 里；玩家一侧的组队引用在 Player 的 team 组件（game/components/team）。
type Component struct {
	entity.ComponentBase
	owner Owner
}

// NewComponent 是组件工厂；Team 在 game/entities/team/roster_component.go 登记它。
func NewComponent(value any, _ *entity.EntityCreateParam) (entity.ComponentInterfaceBase, error) {
	owner, ok := value.(Owner)
	if !ok {
		return nil, fmt.Errorf("team roster component: owner %T does not implement teamroster.Owner", value)
	}
	return &Component{owner: owner}, nil
}

func (c *Component) Name() string { return "team_roster" }

// Snapshot 是 view.TeamSnapshot（结构体定义在 game/view，这里留同名别名，组件与 handler 的写法不变）。
type Snapshot = view.TeamSnapshot

// Invitation 是 view.TeamInvitation（结构体定义在 game/view，这里留同名别名，组件与 handler 的写法不变）。
type Invitation = view.TeamInvitation

// InviteExpiry 是给这名玩家的邀请的过期时刻；没有邀请时为 0。只可在持有 Team 锁时调用。
func (c *Component) InviteExpiry(invitee int64) int64 {
	expiry, _ := c.owner.Dao().GetInvites(invitee)
	return expiry
}

// PendingInvitation 在 Team 权威锁内核对当前可接受的邀请。收件记录只是发现入口，不能代替这里的判断。
// 查询不预留席位；应答之后发生满员、解散或匹配冻结，Accept 仍会再次核对。
func (c *Component) PendingInvitation(invitee, now int64) Invitation {
	d := c.owner.Dao()
	expiry := c.InviteExpiry(invitee)
	if d.GetLeader() == 0 || d.GetMatchKey() != "" || d.MembersLen() >= MaxMembers || c.IsMember(invitee) || now >= expiry || d.GetRevision() == math.MaxInt64 {
		return Invitation{}
	}
	return Invitation{TeamSnapshot: c.Info(), Invitee: invitee, ExpireAt: expiry}
}

// Info 只可在持有 Team 锁时调用；不把 DAO 的集合交给锁外调用方。
func (c *Component) Info() Snapshot {
	d := c.owner.Dao()
	out := Snapshot{TeamID: c.owner.ID(), Leader: d.GetLeader(), Revision: d.GetRevision(), SIDs: map[int64]int32{}}
	d.RangeMembers(func(id int64, sid int32) bool { out.Members = append(out.Members, id); out.SIDs[id] = sid; return true })
	slices.Sort(out.Members)
	return out
}
func (c *Component) IsMember(id int64) bool { _, ok := c.owner.Dao().GetMembers(id); return ok }

func (c *Component) Found(id int64, sid int32) error {
	if id <= 0 || sid <= 0 {
		return apperrors.ErrTeamInvalid
	}
	d := c.owner.Dao()
	if d.GetRevision() != 0 {
		return apperrors.ErrTeamExists
	}
	d.SetLeader(id)
	d.SetMembers(id, sid)
	d.SetRevision(1)
	return nil
}
func (c *Component) Invite(leader, invitee, now int64) error {
	if c.owner.Dao().GetMatchKey() != "" {
		return apperrors.ErrTeamBlocked
	}
	d := c.owner.Dao()
	if d.GetLeader() == 0 {
		return apperrors.ErrTeamMissing
	}
	if d.GetLeader() != leader {
		return apperrors.ErrTeamNotLeader
	}
	if invitee <= 0 || invitee == leader || now < 0 || now > math.MaxInt64-InviteMillis {
		return apperrors.ErrTeamInvalid
	}
	if c.IsMember(invitee) {
		return nil
	}
	if d.MembersLen() >= MaxMembers {
		return apperrors.ErrTeamFull
	}
	c.pruneInvites(now)
	if _, exists := d.GetInvites(invitee); !exists && d.InvitesLen() >= MaxInvites {
		return apperrors.ErrTeamInvitesFull
	}
	d.SetInvites(invitee, now+InviteMillis)
	return nil
}
func (c *Component) Accept(id int64, sid int32, now int64) error {
	if c.owner.Dao().GetMatchKey() != "" {
		return apperrors.ErrTeamBlocked
	}
	d := c.owner.Dao()
	if id <= 0 || sid <= 0 || now < 0 {
		return apperrors.ErrTeamInvalid
	}
	if d.GetLeader() == 0 {
		return apperrors.ErrTeamMissing
	}
	if c.IsMember(id) {
		return nil
	}
	expiry, invited := d.GetInvites(id)
	if !invited || now >= expiry {
		return apperrors.ErrTeamNotInvited
	}
	if d.MembersLen() >= MaxMembers {
		return apperrors.ErrTeamFull
	}
	if d.GetRevision() == math.MaxInt64 {
		return apperrors.ErrTeamBlocked
	}
	d.DelInvites(id)
	d.SetMembers(id, sid)
	d.SetRevision(d.GetRevision() + 1)
	return nil
}
func (c *Component) Leave(id int64) error {
	if c.owner.Dao().GetMatchKey() != "" {
		return apperrors.ErrTeamBlocked
	}
	d := c.owner.Dao()
	if !c.IsMember(id) {
		return apperrors.ErrTeamMissing
	}
	if d.GetRevision() == math.MaxInt64 {
		return apperrors.ErrTeamBlocked
	}
	d.DelMembers(id)
	if d.GetLeader() == id {
		next := int64(0)
		d.RangeMembers(func(member int64, _ int32) bool {
			if next == 0 || member < next {
				next = member
			}
			return true
		})
		d.SetLeader(next)
		if next == 0 {
			c.clearInvites()
		}
	}
	d.SetRevision(d.GetRevision() + 1)
	return nil
}
func (c *Component) Disband(leader int64) error {
	if c.owner.Dao().GetMatchKey() != "" {
		return apperrors.ErrTeamBlocked
	}
	d := c.owner.Dao()
	if d.GetLeader() == 0 {
		return apperrors.ErrTeamMissing
	}
	if d.GetLeader() != leader {
		return apperrors.ErrTeamNotLeader
	}
	if d.GetRevision() == math.MaxInt64 {
		return apperrors.ErrTeamBlocked
	}
	for _, id := range c.Info().Members {
		d.DelMembers(id)
	}
	c.clearInvites()
	d.SetLeader(0)
	d.SetRevision(d.GetRevision() + 1)
	return nil
}
func (c *Component) pruneInvites(now int64) {
	d := c.owner.Dao()
	d.RangeInvites(func(id, expiry int64) bool {
		if now >= expiry {
			d.DelInvites(id)
		}
		return true
	})
}
func (c *Component) clearInvites() {
	d := c.owner.Dao()
	d.RangeInvites(func(id, _ int64) bool { d.DelInvites(id); return true })
}

// HoldMatch 冻结匹配使用的权威名单。调用方须在同一事务里写所有 Player 的排队意图。
func (c *Component) HoldMatch(key string) error {
	if key == "" {
		return apperrors.ErrTeamInvalid
	}
	current := c.owner.Dao().GetMatchKey()
	if current != "" && current != key {
		return apperrors.ErrTeamBlocked
	}
	c.owner.Dao().SetMatchKey(key)
	return nil
}

// ReleaseMatch 只解除对应意图，迟到的收尾不能解开下一轮的名单。
func (c *Component) ReleaseMatch(key string) error {
	current := c.owner.Dao().GetMatchKey()
	if current == "" {
		return nil
	}
	if current != key {
		return apperrors.ErrTeamBlocked
	}
	c.owner.Dao().SetMatchKey("")
	return nil
}
