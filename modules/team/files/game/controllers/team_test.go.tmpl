// 启动只发布 entity.runtime，不发布名为 lifecycle.Team 的能力。
// 不放入 Remote，检查 team 的启动检查已经越过正式 lifecycle 装配而到达下一项依赖，并让进程起不来。
func TestTeamControllerUsesEntityRuntimeLifecycle(t *testing.T) {
	registry := app.NewRegistry(viper.New())
	engine := nest.NewEngine()
	if err := registry.Register(mods.ModNest, engine); err != nil {
		t.Fatal(err)
	}
	if err := registry.Register(mods.ModEntityRuntime, entity.NewManagerAccess(entity.NewEntityManager())); err != nil {
		t.Fatal(err)
	}
	controller, err := FromRegistry(registry)
	if err != nil {
		t.Fatal(err)
	}
	// 只跑 team 自己登记的那一条：工程里别的模块的检查在这个夹具上本来就会失败。
	check := startChecks["team"]
	if check == nil {
		t.Fatal("team registered no start check: a process without its dependencies would start and fail on the first request")
	}
	if err := check(controller); err == nil || err.Error() != "team: remote runtime unavailable" {
		t.Fatalf("controller did not construct lifecycle from entity.runtime: %v", err)
	}
	if controller.CheckAtStart() == nil {
		t.Fatal("start checks passed without the Remote runtime: the process would start")
	}
}

// Team 是共享 kind（实体标记 ownership=shared，生成的登记调 entity.DeclareRemoteSharedKind）：建队认领的那一条插入就是
// 共享的所有权记录，不经过“先独占认领、再切共享”的中间态，建队也不再调切共享。替身按框架的认领规则作答：kind 在本进程
// 声明了共享，认领答出共享记录；没声明，答出建队进程独占的记录（别的 game 写它会被 fence）。认领答出独占记录时建队报错，
// 不把一支别的 game 写不了的队伍建出来，也不去切共享。
func TestTeamCreateClaimsSharedInOneStep(t *testing.T) {
	teamentity.RegisterEntity()
	id, _ := entity.BuildEntityID(91001, teamentity.EntityKindTeam)
	remote := &teamClaimRecorder{}
	err := teamClaim(context.Background(), remote, id)
	declared := entity.RemoteKindShared(teamentity.EntityKindTeam)
	if !declared || err != nil || remote.claims != 1 || remote.enters != 0 {
		t.Fatalf("team creation went through an exclusive claim: kind declared shared=%v claims=%d enter-shared calls=%d err=%v", declared, remote.claims, remote.enters, err)
	}
	exclusive := &teamClaimRecorder{exclusive: true}
	if err := teamClaim(context.Background(), exclusive, id); err == nil || exclusive.enters != 0 {
		t.Fatalf("an exclusive claim was accepted for a team: enter-shared calls=%d err=%v", exclusive.enters, err)
	}
}

// teamClaimRecorder 替代 Remote 运行时，记下建队认领与切共享的调用；exclusive 时认领总答独占记录（kind 没声明共享的进程）。
type teamClaimRecorder struct {
	entity.IRemoteEntityManager
	exclusive      bool
	claims, enters int
}

func (r *teamClaimRecorder) ClaimRemoteOwnership(context.Context, int64) (entity.RemoteEntityMarkerLease, error) {
	r.claims++
	shared := entity.RemoteKindShared(teamentity.EntityKindTeam) && !r.exclusive
	return entity.RemoteEntityMarkerLease{OwnerSid: 1000, MarkerEpoch: 1, RouteEpoch: 1, Shared: shared}, nil
}
func (r *teamClaimRecorder) EnterRemoteSharedMode(context.Context, int64) (entity.RemoteEntityMarkerLease, error) {
	r.enters++
	return entity.RemoteEntityMarkerLease{OwnerSid: 1000, MarkerEpoch: 2, RouteEpoch: 1, Shared: true}, nil
}

// 这里替代 Nest 只验证端点的编排和失败答法；权威邀请、事务回滚另由 handler 场景走正式 Nest 验证。
type teamEndpointClient struct {
	nest.Client
	request func(nest.HandlerName, int64, nest.Params) (any, error)
}

func (c teamEndpointClient) Request(_ context.Context, name nest.HandlerName, id int64, args nest.Params, _ ...nest.SendOpt) (any, error) {
	return c.request(name, id, args)
}

type teamPushRecorder struct {
	calls  int
	fail   bool
	online bool
	push   *pb.TeamInvitedPush
}

func (p *teamPushRecorder) ActiveSessions(int64) int {
	if p.online {
		return 1
	}
	return 0
}
func (p *teamPushRecorder) PushPlayer(_ context.Context, id int64, message uint32, value any) error {
	if id != 102 || message != msgid.MsgTeamInvited {
		return errors.New("unexpected recipient or protocol")
	}
	p.calls++
	p.push = value.(*pb.TeamInvitedPush)
	if p.fail {
		return errors.New("injected delivery failure")
	}
	return nil
}

func TestTeamEndpointInvitationQueryChecksAuthority(t *testing.T) {
	player.RegisterEntity()
	teamentity.RegisterEntity()
	facebookentity.RegisterEntity()
	first, _ := entity.BuildEntityID(91001, teamentity.EntityKindTeam)
	second, _ := entity.BuildEntityID(91002, teamentity.EntityKindTeam)
	foreign, _ := entity.BuildEntityID(91003, player.EntityKindPlayer) // 别的功能投进收件箱的邀请，不归队伍查
	inbox, _ := entity.BuildEntityID(102, facebookentity.EntityKindFacebook)
	checked := 0
	registry := app.NewRegistry(viper.New())
	if err := registry.Register(mods.ModRemoteEntity, entity.IRemoteEntityManager(teamOpenedInboxes{})); err != nil {
		t.Fatal(err)
	}
	c := &Controller{registry: registry, nestClient: teamEndpointClient{request: func(name nest.HandlerName, id int64, _ nest.Params) (any, error) {
		switch name.String() {
		case "handlerFacebookInvites":
			if id != inbox {
				t.Fatalf("wrong inbox: %d", id)
			}
			return []view.FacebookInvite{{Source: first, From: 101, ExpireAt: 60000}, {Source: second, From: 103, ExpireAt: 60000}, {Source: foreign, From: 105, ExpireAt: 60000}}, nil
		case "handlerTeamInvitation":
			checked++
			if id == first {
				return view.TeamInvitation{}, nil
			} // 队伍已解散，收件记录仍在。
			if id != second {
				t.Fatalf("looked up a non-team source %d", id)
			}
			return view.TeamInvitation{TeamSnapshot: view.TeamSnapshot{TeamID: second, Leader: 104}, Invitee: 102, ExpireAt: 70000}, nil
		default:
			t.Fatalf("unexpected request %s", name.String())
			return nil, nil
		}
	}}}
	out, err := c.HandleTeamInvites(&playeraccess.Context{PlayerID: 102}, &pb.TeamInvitesRequest{})
	if err != nil || out.Code != 0 || checked != 2 || len(out.Invites) != 1 || out.Invites[0].TeamID != second || out.Invites[0].Inviter != 103 || out.Invites[0].ExpireAtUnixMilli != 70000 {
		t.Fatalf("stale inbox exposed: response=%+v checked=%d err=%v", out, checked, err)
	}
}

// teamOpenedInboxes 替代 Remote 运行时，只答“收件人的 Facebook 已经打开（共享模式）”，让查询经 Nest 读它。
type teamOpenedInboxes struct{ entity.IRemoteEntityManager }

func (teamOpenedInboxes) GetRemoteOwnership(context.Context, int64) (entity.RemoteEntityMarkerLease, bool, error) {
	return entity.RemoteEntityMarkerLease{OwnerSid: 1000, MarkerEpoch: 1, RouteEpoch: 1, Shared: true}, true, nil
}

// 投递只是告知，不是邀请的一部分：收件箱记不上（这里没有 Remote 运行时，确保 Facebook 就失败）时，连在本进程的被邀请人
// 照样收到 TeamInvited；推送失败不影响什么；不在本进程的不推、也不冷加载。别的 game 广播来的告知走同一个处理。
func TestTeamEndpointInvitationNoticeFailureDoesNotUndoAuthority(t *testing.T) {
	player.RegisterEntity()
	teamentity.RegisterEntity()
	facebookentity.RegisterEntity()
	id, _ := entity.BuildEntityID(91001, teamentity.EntityKindTeam)
	c := &Controller{registry: app.NewRegistry(nil), nestClient: teamEndpointClient{request: func(name nest.HandlerName, target int64, _ nest.Params) (any, error) {
		t.Fatalf("unexpected request %s/%d: the facebook could not be ensured", name.String(), target)
		return nil, nil
	}}}
	push := &teamPushRecorder{online: true, fail: true}
	if err := c.registry.Register(PlayerTCPCapability, push); err != nil {
		t.Fatal(err)
	}
	expireAt := clock.UnixMilli() + 60000
	invitation := view.TeamInvitation{TeamSnapshot: view.TeamSnapshot{TeamID: id, Leader: 101}, Invitee: 102, ExpireAt: expireAt}
	c.teamAnnounceInvite(context.Background(), invitation)
	if push.calls != 1 || push.push.TeamID != id || push.push.Inviter != 101 || push.push.ExpireAtUnixMilli != expireAt {
		t.Fatalf("online invitee not told: %+v", push)
	}
	push.online = false
	c.teamAnnounceInvite(context.Background(), invitation)
	teamNotifyInvite(context.Background(), c.registry, facebook.Invite{To: 102, Source: id, From: 101, ExpireAt: expireAt})
	if push.calls != 1 {
		t.Fatal("offline player was pushed")
	}
	push.online = true
	teamNotifyInvite(context.Background(), c.registry, facebook.Invite{To: 102, Source: id, From: 101, ExpireAt: expireAt})
	if push.calls != 2 {
		t.Fatalf("a notice broadcast from another game did not reach the online invitee: %+v", push)
	}
}
