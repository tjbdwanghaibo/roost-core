func TestTeamEndpointRequiresAuthenticatedPlayer(t *testing.T) {
	player.RegisterEntity()
	c := &Controller{}
	if _, err := c.HandleTeamInfo(nil, &pb.TeamInfoRequest{}); err == nil {
		t.Fatal("anonymous team read accepted")
	}
	if _, err := c.HandleTeamCreate(&playeraccess.Context{}, &pb.TeamCreateRequest{}); err == nil {
		t.Fatal("zero player created team")
	}
}
func TestTeamEndpointRejectsMissingRequest(t *testing.T) {
	player.RegisterEntity()
	c := &Controller{}
	ctx := &playeraccess.Context{PlayerID: 101}
	if _, err := c.HandleTeamCreate(ctx, nil); err == nil {
		t.Fatal("nil request accepted")
	}
	if _, err := c.HandleTeamInvite(ctx, nil); err == nil {
		t.Fatal("nil invite accepted")
	}
	if _, err := c.HandleTeamAccept(ctx, nil); err == nil {
		t.Fatal("nil accept accepted")
	}
	if _, err := c.HandleTeamLeave(ctx, nil); err == nil {
		t.Fatal("nil leave accepted")
	}
	if _, err := c.HandleTeamDisband(ctx, nil); err == nil {
		t.Fatal("nil disband accepted")
	}
	if _, err := c.HandleTeamInfo(ctx, nil); err == nil {
		t.Fatal("nil info accepted")
	}
}
func TestTeamEndpointRejectsWrongKindBeforeDispatch(t *testing.T) {
	player.RegisterEntity()
	c := &Controller{}
	response, err := c.HandleTeamAccept(&playeraccess.Context{PlayerID: 101}, &pb.TeamAcceptRequest{TeamID: 123})
	if err != nil || response.Code != int32(errcode.CodeOf(apperrors.ErrTeamInvalid)) {
		t.Fatalf("wrong kind: %+v %v", response, err)
	}
}
func TestTeamEndpointRejectsInvalidInviteeBeforeDispatch(t *testing.T) {
	player.RegisterEntity()
	c := &Controller{}
	response, err := c.HandleTeamInvite(&playeraccess.Context{PlayerID: 101}, &pb.TeamInviteRequest{Invitee: -1})
	if err != nil || response.Code != int32(errcode.CodeOf(apperrors.ErrTeamInvalid)) {
		t.Fatalf("invalid invitee: %+v %v", response, err)
	}
}

// 启动只发布 entity.runtime，不发布名为 lifecycle.Team 的能力。
// 不放入 Remote，检查构造器已经越过正式 lifecycle 装配而到达下一项依赖。
func TestTeamControllerUsesEntityRuntimeLifecycle(t *testing.T) {
	registry := app.NewRegistry(viper.New())
	engine := nest.NewEngine()
	if err := registry.Register(mods.ModNest, engine); err != nil {
		t.Fatal(err)
	}
	if err := registry.Register(mods.ModEntityRuntime, entity.NewManagerAccess(entity.NewEntityManager())); err != nil {
		t.Fatal(err)
	}
	_, err := teamDepsFromRegistry(registry)
	if err == nil || err.Error() != "team: remote runtime unavailable" {
		t.Fatalf("controller did not construct lifecycle from entity.runtime: %v", err)
	}
}

// 这里替代 Nest 只验证端点的编排和失败答法；权威邀请、事务回滚另由 handler 场景走正式 Nest 验证。
type teamEndpointClient struct {
	nest.Client
	request func(nest.HandlerName, int64, nest.Params) (any, error)
}

func (c teamEndpointClient) Request(_ context.Context, name nest.HandlerName, id int64, args nest.Params, _ ...nest.SendOpt) (any, error) {
	return c.request(name, id, args)
}

type teamPushRecorder struct {
	calls  int
	fail   bool
	online bool
	push   *pb.TeamInvitedPush
}

func (p *teamPushRecorder) ActiveSessions(int64) int {
	if p.online {
		return 1
	}
	return 0
}
func (p *teamPushRecorder) PushPlayer(_ context.Context, id int64, message uint32, value any) error {
	if id != 102 || message != msgid.MsgTeamInvited {
		return errors.New("unexpected recipient or protocol")
	}
	p.calls++
	p.push = value.(*pb.TeamInvitedPush)
	if p.fail {
		return errors.New("injected delivery failure")
	}
	return nil
}

func TestTeamEndpointInvitationQueryChecksAuthority(t *testing.T) {
	player.RegisterEntity()
	teamentity.RegisterEntity()
	first, _ := entity.BuildEntityID(91001, teamentity.EntityKindTeam)
	second, _ := entity.BuildEntityID(91002, teamentity.EntityKindTeam)
	self, _ := entity.BuildEntityID(102, player.EntityKindPlayer)
	checked := 0
	c := &Controller{nestClient: teamEndpointClient{request: func(name nest.HandlerName, id int64, _ nest.Params) (any, error) {
		switch name.String() {
		case "handlerTeamInvites":
			if id != self {
				t.Fatalf("wrong observer: %d", id)
			}
			return []view.TeamInvite{{TeamID: first, Inviter: 101, ExpireAt: 60000}, {TeamID: second, Inviter: 103, ExpireAt: 60000}}, nil
		case "handlerTeamInvitation":
			checked++
			if id == first {
				return view.TeamInvitation{}, nil
			} // 队伍已解散，收件记录仍在。
			return view.TeamInvitation{TeamSnapshot: view.TeamSnapshot{TeamID: second, Leader: 104}, Invitee: 102, ExpireAt: 70000}, nil
		default:
			t.Fatalf("unexpected request %s", name.String())
			return nil, nil
		}
	}}}
	out, err := c.HandleTeamInvites(&playeraccess.Context{PlayerID: 102}, &pb.TeamInvitesRequest{})
	if err != nil || out.Code != 0 || checked != 2 || len(out.Invites) != 1 || out.Invites[0].TeamID != second || out.Invites[0].ExpireAtUnixMilli != 70000 {
		t.Fatalf("stale inbox exposed: response=%+v checked=%d err=%v", out, checked, err)
	}
}

func TestTeamEndpointInvitationNoticeFailureDoesNotUndoAuthority(t *testing.T) {
	player.RegisterEntity()
	teamentity.RegisterEntity()
	id, _ := entity.BuildEntityID(91001, teamentity.EntityKindTeam)
	self, _ := entity.BuildEntityID(102, player.EntityKindPlayer)
	noted := 0
	c := &Controller{registry: app.NewRegistry(nil), nestClient: teamEndpointClient{request: func(name nest.HandlerName, target int64, _ nest.Params) (any, error) {
		if name.String() != "handlerTeamInviteNote" || target != self {
			t.Fatalf("unexpected request %s/%d", name.String(), target)
		}
		noted++
		return true, nil
	}}}
	push := &teamPushRecorder{online: true, fail: true}
	if err := c.registry.Register(PlayerTCPCapability, push); err != nil {
		t.Fatal(err)
	}
	invitation := view.TeamInvitation{TeamSnapshot: view.TeamSnapshot{TeamID: id, Leader: 101}, Invitee: 102, ExpireAt: 60000}
	c.teamAnnounceInvite(context.Background(), invitation)
	if noted != 1 || push.calls != 1 || push.push.TeamID != id || push.push.ExpireAtUnixMilli != 60000 {
		t.Fatalf("note=%d push=%+v", noted, push)
	}
	push.online = false
	c.teamAnnounceInvite(context.Background(), invitation)
	if noted != 1 || push.calls != 1 {
		t.Fatal("offline player was cold loaded or pushed")
	}
}
