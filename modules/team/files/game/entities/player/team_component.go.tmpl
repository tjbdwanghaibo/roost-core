package player

import (
	"{{MODULE}}/game/components/team"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:Team}}
const CompTypeTeam entity.ComponentType = {{ID:component:Team}}

// TeamComponent 是 game/components/team 的组件在 Player 上的名字（生成接线与 handler 用它）；业务在那个包里。
type TeamComponent = team.Component

type ITeamEntity interface {
	entity.IThreadSafeEntity
	TeamComp() *TeamComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeTeam, team.NewComponent)
}
