package handler

import (
	"{{MODULE}}/game/view"
	player "{{MODULE}}/game/entities/player"
	team "{{MODULE}}/game/entities/team"
)

// handlerTeamCreate 的 Team 权限由准备阶段取得，业务阶段统一锁住 Team 与 Player。
//
//roost:nest rollback=undo durability=strict
func handlerTeamCreate(target team.ITeamEntity, member player.ITeamEntity, sid int32) (view.TeamSnapshot, error) {
	return member.TeamComp().Create(target.TeamEntity(), sid)
}
