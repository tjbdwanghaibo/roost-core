package handler

import (
	player "{{MODULE}}/game/entities/player"
	team "{{MODULE}}/game/entities/team"
)

// handlerTeamLeave 的 Team 权限由准备阶段取得，业务阶段统一锁住 Team 与 Player。
//
//roost:nest rollback=undo durability=strict
func handlerTeamLeave(target team.ITeamEntity, member player.ITeamEntity, disband bool) error {
	return member.TeamComp().Leave(target.TeamEntity(), disband)
}
