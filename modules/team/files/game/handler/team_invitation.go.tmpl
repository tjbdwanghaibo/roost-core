package handler

import "{{MODULE}}/game/view"

// handlerTeamInvitation 只读共享 Team 当前权威；Remote 准备在 I/O 池，实体读取在 Nest 锁内。
//
//roost:nest durability=memory
func handlerTeamInvitation(target view.TeamEntity, invitee int64, nowUnixMilli int64) view.TeamInvitation {
	return target.TeamRoster().PendingInvitation(invitee, nowUnixMilli)
}
