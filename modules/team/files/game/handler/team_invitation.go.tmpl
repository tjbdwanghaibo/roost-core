package handler

import team "{{MODULE}}/game/entities/team"

// handlerTeamInvitation 只读共享 Team 当前权威；Remote 准备在 I/O 池，实体读取在 Nest 锁内。
//
//roost:nest durability=memory
func handlerTeamInvitation(target team.ITeamEntity, invitee int64, nowUnixMilli int64) team.Invitation {
	return target.TeamEntity().PendingInvitation(invitee, nowUnixMilli)
}
