	_, err = sender.NewTeamInviteSender(f.engine).MultiSync_TeamInvite(context.Background(), f.teamID, f.playerID(102), 103)
	if !errors.Is(err, apperrors.ErrTeamMissing) {
		t.Fatalf("outsider invited: %v", err)
	}
	f.unchanged(t, before)
}

var teamHookOnce sync.Once
var teamHookReject atomic.Bool

func TestTeamProjectionHookFailureRollsBackBothEntities(t *testing.T) {
	teamHookOnce.Do(func() {
		player.OnTeamChanged("test-rejection", func(_ *player.Player, _ player.TeamChange) error {
			if teamHookReject.Load() {
				return errors.New("projection hook rejected")
			}
			return nil
		})
	})
	f := newTeamFixture(t)
	f.create(t, 101)
	f.invite(t, 101, 102)
	before := f.facts(t)
	teamHookReject.Store(true)
	t.Cleanup(func() { teamHookReject.Store(false) })
	_, err := sender.NewTeamAcceptSender(f.engine).MultiSync_TeamAccept(context.Background(), f.teamID, f.playerID(102), 1)
	teamHookReject.Store(false)
	if err == nil {
		t.Fatal("projection hook failure ignored")
	}
	f.unchanged(t, before)
}

// NewEngine 会复制包级注册；其他模块场景可能已经登记同一个正式 handler。
// 未登记时装到当前实例，不清全局表，也不吞掉重复登记以外的错误。
func registerTeamTestHandler(engine *nest.NestMgr, name nest.HandlerName, invoke nest.BaseHandler, meta nest.HandlerMeta) {
	if nest.GetHandler(name) == nil {
		engine.MustRegisterHandlerWithMeta(name, invoke, meta)
	}
}
