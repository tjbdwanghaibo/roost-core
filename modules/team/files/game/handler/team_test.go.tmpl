func TestTeamCommitContainsRemoteAndPlayerChanges(t *testing.T) {
	f := newTeamFixture(t)
	f.create(t, 101)
	f.invite(t, 101, 102)
	f.accept(t, 102)
	f.commit.lastMu.Lock()
	record := dataengine.CloneCommitRecord(f.commit.last)
	f.commit.lastMu.Unlock()
	var remote, local bool
	for _, mutation := range record.Mutations {
		if mutation.Remote != nil {
			remote = true
		} else if mutation.Key.ID == f.playerID(102) {
			local = true
		}
	}
	if !remote || !local {
		t.Fatalf("join record misses remote/player: %+v", record)
	}
}
