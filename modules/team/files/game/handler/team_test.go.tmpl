type teamGetter map[int64]entity.IThreadSafeEntity

func (g teamGetter) Get(_ context.Context, id int64, _ entity.EntityCategory) (entity.IThreadSafeEntity, error) {
	if v := g[id]; v != nil {
		return v, nil
	}
	return nil, fmt.Errorf("team fixture: missing %d", id)
}
func (g teamGetter) GetMany(ctx context.Context, ids []int64, cats []entity.EntityCategory) ([]entity.IThreadSafeEntity, error) {
	out := make([]entity.IThreadSafeEntity, len(ids))
	for i, id := range ids {
		v, err := g.Get(ctx, id, cats[i])
		if err != nil {
			return nil, err
		}
		out[i] = v
	}
	return out, nil
}

// 提交替身只验证正式 Nest 的事务与回滚，不宣称 Redis 权威或 Mongo 投影已经通过。
type teamCommitter struct {
	reject atomic.Bool
	calls  atomic.Int32
	lastMu sync.Mutex
	last   dataengine.CommitRecord
}

func (c *teamCommitter) Commit(_ context.Context, record dataengine.CommitRecord) error {
	c.calls.Add(1)
	c.lastMu.Lock()
	c.last = dataengine.CloneCommitRecord(record)
	c.lastMu.Unlock()
	if c.reject.Load() {
		return errors.New("team commit rejected")
	}
	return nil
}

type teamFixture struct {
	engine *nest.NestMgr
	values teamGetter
	teamID int64
	commit *teamCommitter
	now    atomic.Int64
}

func newTeamFixture(t *testing.T, registrations ...func(*nest.NestMgr)) *teamFixture {
	t.Helper()
	player.RegisterEntity()
	team.RegisterEntity()
	f := &teamFixture{values: teamGetter{}, commit: &teamCommitter{}}
	for _, spec := range []struct {
		unique int64
		kind   entity.EntityKind
	}{{91001, team.EntityKindTeam}, {91002, team.EntityKindTeam}, {101, player.EntityKindPlayer}, {102, player.EntityKindPlayer}, {103, player.EntityKindPlayer}, {104, player.EntityKindPlayer}, {105, player.EntityKindPlayer}, {106, player.EntityKindPlayer}, {107, player.EntityKindPlayer}, {108, player.EntityKindPlayer}, {109, player.EntityKindPlayer}} {
		id, err := entity.BuildEntityID(spec.unique, spec.kind)
		if err != nil {
			t.Fatal(err)
		}
		built, err := entity.BuildEntity(&entity.EntityCreateParam{IsCreate: true, Id: id, Kind: spec.kind})
		if err != nil {
			t.Fatal(err)
		}
		f.values[id] = built
		if spec.unique == 91001 {
			f.teamID = id
		}
	}
	f.now.Store(1000000)
	clock.SetSource(func() time.Time { return time.UnixMilli(f.now.Load()) })
	t.Cleanup(func() { clock.SetSource(nil) })
	remote := teamRemote{values: f.values, locks: map[int64]*sync.Mutex{}, versions: map[int64]*uint64{}}
	for id := range f.values {
		if entity.MatchEntityID(id, team.EntityKindTeam) {
			remote.locks[id] = &sync.Mutex{}
			remote.versions[id] = new(uint64)
		}
	}
	f.engine = nest.NewEngine(nest.NestOptionWithRemoteEntityManager(remote), nest.NestOptionWithGetter(f.values), nest.NestOptionWithTransactionCommitter(f.commit), nest.NestOptionWithWorkerPools(nest.WorkerPoolConfig{Workers: 2, QueueCap: 64}, nest.WorkerPoolConfig{}, nest.WorkerPoolConfig{}))
	for _, register := range []func(*nest.NestMgr) error{RegisterTeamCreateNestHandlersOn, RegisterTeamAcceptNestHandlersOn, RegisterTeamInviteNestHandlersOn, RegisterTeamLeaveNestHandlersOn, RegisterTeamInfoNestHandlersOn} {
		if err := register(f.engine); err != nil {
			t.Fatal(err)
		}
	}
	registerTeamTestHandler(f.engine, handlerNamePlayerTeam, invokePlayerTeam, nest.HandlerMeta{Rollback: nest.RollbackState, Durability: nest.DurabilityAsync})
	for _, register := range registrations {
		register(f.engine)
	}
	if err := f.engine.Start(); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := f.engine.Shutdown(context.Background()); err != nil {
			t.Error(err)
		}
	})
	return f
}
