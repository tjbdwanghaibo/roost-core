func TestTeamConcurrentAcceptsSerializePlayerMembership(t *testing.T) {
	f := newTeamFixture(t)
	f.create(t, 101)
	f.invite(t, 101, 102)
	other, _ := entity.BuildEntityID(91002, team.EntityKindTeam)
	if _, err := sender.NewTeamCreateSender(f.engine).MultiSync_TeamCreate(context.Background(), other, f.playerID(103), 1); err != nil {
		t.Fatal(err)
	}
	if _, err := sender.NewTeamInviteSender(f.engine).MultiSync_TeamInvite(context.Background(), other, f.playerID(103), 102); err != nil {
		t.Fatal(err)
	}
	start := make(chan struct{})
	done := make(chan error, 2)
	for _, id := range []int64{f.teamID, other} {
		go func() {
			<-start
			_, err := sender.NewTeamAcceptSender(f.engine).MultiSync_TeamAccept(context.Background(), id, f.playerID(102), 1)
			done <- err
		}()
	}
	close(start)
	a, b := <-done, <-done
	if !(a == nil && errors.Is(b, apperrors.ErrTeamExists) || b == nil && errors.Is(a, apperrors.ErrTeamExists)) {
		t.Fatalf("concurrent memberships: %v / %v", a, b)
	}
	current, err := sender.NewPlayerTeamSender(f.engine).Sync_PlayerTeam(context.Background(), f.playerID(102))
	if err != nil {
		t.Fatal(err)
	}
	first := f.info(t, 101)
	second, err := sender.NewTeamInfoSender(f.engine).MultiSync_TeamInfo(context.Background(), other, f.playerID(103))
	if err != nil {
		t.Fatal(err)
	}
	if len(first.Members)+len(second.Members) != 3 || !(current == f.teamID && len(first.Members) == 2 || current == other && len(second.Members) == 2) {
		t.Fatalf("conflicting authority: %d %+v %+v", current, first, second)
	}
}
