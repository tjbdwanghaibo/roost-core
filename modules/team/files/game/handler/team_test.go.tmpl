func TestTeamCreateAndJoinShareOneTransaction(t *testing.T) {
	f := newTeamFixture(t)
	first := f.create(t, 101)
	f.invite(t, 101, 102)
	before := f.commit.calls.Load()
	joined := f.accept(t, 102)
	current, err := sender.NewPlayerTeamSender(f.engine).Sync_PlayerTeam(context.Background(), f.playerID(102))
	if err != nil || first.Leader != 101 || len(joined.Members) != 2 || joined.Members[1] != 102 || current != f.teamID || f.commit.calls.Load() != before+1 {
		t.Fatalf("joined=%+v current=%d commits=%d err=%v", joined, current, f.commit.calls.Load()-before, err)
	}
}

// teamRemote 在离线场景里替代外部锁与权威存储，仍用生成的 BuildRemoteCommitLocked
// 冻结事务内的 Team 变化。测试断言它和 Player 变化出现在同一份正式提交记录中。
// 它不验证跨进程租约、Redis 原子提交、Mongo 投影或进程崩溃恢复。
type teamRemote struct {
	entity.IRemoteEntityManager
	values   teamGetter
	locks    map[int64]*sync.Mutex
	versions map[int64]*uint64
}

func (m teamRemote) PrepareRemoteWriteBatch(_ context.Context, ids []int64) (entity.RemoteWriteBatch, error) {
	ordered := slices.Clone(ids)
	slices.Sort(ordered)
	for _, id := range ordered {
		m.locks[id].Lock()
	}
	return &teamBatch{manager: m, ids: ordered}, nil
}

type teamBatch struct {
	manager teamRemote
	ids     []int64
	commits []entity.RemoteCommit
}

func (b *teamBatch) EntityIDs() []int64 { return b.ids }
func (b *teamBatch) FinalizeLocked(outcome entity.RemoteTransactionOutcome) error {
	for _, id := range b.ids {
		participant := b.manager.values[id].(entity.IRemoteCommitParticipant)
		if !participant.HasRemoteCommitLocked(outcome) {
			continue
		}
		lease := entity.RemoteWriteLease{EntityID: id, OwnerSID: 1, Mode: entity.RemoteWriteSharedLock, State: entity.RemoteOwnershipShared, BaseVersion: *b.manager.versions[id], MarkerEpoch: 1, LockFence: 1, RouteEpoch: 1}
		commit, err := participant.BuildRemoteCommitLocked(lease, outcome)
		if err != nil {
			return err
		}
		for i := range commit.Snapshots {
			snapshot := &commit.Snapshots[i]
			snapshot.BaseVersion = commit.BaseVersion
			snapshot.StateVersion = commit.NextVersion
			snapshot.MarkerEpoch = commit.MarkerEpoch
			snapshot.RouteEpoch = commit.RouteEpoch
		}
		b.commits = append(b.commits, commit)
	}
	return nil
}
func (b *teamBatch) Commits() []entity.RemoteCommit { return b.commits }
func (b *teamBatch) Commit(context.Context) ([]entity.RemoteCommitReceipt, error) {
	for _, commit := range b.commits {
		if err := b.manager.values[commit.EntityID].(entity.IRemoteCommitParticipant).AcknowledgeRemoteCommit(commit); err != nil {
			return nil, err
		}
		*b.manager.versions[commit.EntityID] = commit.NextVersion
	}
	return nil, nil
}
func (b *teamBatch) Abort(context.Context, error) error { return nil }
func (b *teamBatch) Indeterminate(context.Context, error) error {
	return fmt.Errorf("unexpected indeterminate team fixture commit")
}
func (b *teamBatch) Close(context.Context) error {
	for i := len(b.ids) - 1; i >= 0; i-- {
		b.manager.locks[b.ids[i]].Unlock()
	}
	return nil
}

func (f *teamFixture) facts(t *testing.T) map[int64]bson.M {
	t.Helper()
	out := map[int64]bson.M{}
	var decodeErr error
	err := f.engine.RunLocal(context.Background(), func() {
		for id, value := range f.values {
			value.GetMutex().Lock()
			var raw []byte
			if v, ok := value.(*team.Team); ok {
				raw = v.Dao().Marshal()
			} else {
				raw = value.(*player.Player).Dao().Marshal()
			}
			value.GetMutex().Unlock()
			var doc bson.M
			decoder := bson.NewDecoder(bson.NewDocumentReader(bytes.NewReader(raw)))
			decoder.DefaultDocumentM()
			if err := decoder.Decode(&doc); err != nil {
				decodeErr = err
				return
			}
			out[id] = doc
		}
	})
	if err != nil {
		t.Fatal(err)
	}
	if decodeErr != nil {
		t.Fatal(decodeErr)
	}
	return out
}
func (f *teamFixture) unchanged(t *testing.T, before map[int64]bson.M) {
	t.Helper()
	if after := f.facts(t); !reflect.DeepEqual(before, after) {
		t.Fatalf("team/player changed after rejection: before=%v after=%v", before, after)
	}
}
