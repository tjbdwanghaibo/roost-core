// accountctl 的场景。account 是内存存储上的正式服务：子命令只经 serverRecords 用它，与连着 Redis 的那一个
// 是同一份实现。没有连真实的 Redis——openService 那一段（地址、前缀）这里验不到。

// loginCtlAccount 给出一个空的 account：一个区服都没登记。
func loginCtlAccount(t *testing.T) *svcaccount.Service {
	t.Helper()
	names, err := directory.New(versionstore.NewMemoryStore[string, directory.Entry](), directory.Config{Normalize: directory.NormalizeLower, DefaultTTL: time.Minute})
	if err != nil {
		t.Fatal(err)
	}
	service, err := svcaccount.New(svcaccount.Config{
		Accounts: versionstore.NewMemoryStore[string, svcaccount.Account](),
		Roles:    versionstore.NewMemoryStore[int64, svcaccount.Role](),
		Servers:  versionstore.NewMemoryStore[int32, svcaccount.GameServer](),
		Slots:    versionstore.NewMemoryStore[string, svcaccount.Slot](),
		Names:    names,
		Verifier: svcaccount.VerifierFunc(func(_ context.Context, identity svcaccount.Identity) (svcaccount.Verified, error) {
			return svcaccount.Verified{Channel: identity.Channel, OpenID: identity.OpenID}, nil
		}),
		Allocator:     svcaccount.AllocatorFunc(func(context.Context, int32) (int64, error) { return 100_001, nil }),
		NameRules:     svcaccount.NameValidatorFunc(func(string) error { return nil }),
		SessionSecret: "accountctl-test",
	})
	if err != nil {
		t.Fatal(err)
	}
	return service
}

// loginCtlRun 执行一个子命令，返回它打印的记录（没有打印时是零值）与错误。
func loginCtlRun(t *testing.T, service *svcaccount.Service, args ...string) (svcaccount.GameServer, string, error) {
	t.Helper()
	var out bytes.Buffer
	err := run(context.Background(), service, args, &out)
	var server svcaccount.GameServer
	if out.Len() > 0 {
		if decodeErr := json.Unmarshal(out.Bytes(), &server); decodeErr != nil {
			t.Fatalf("accountctl %s printed something that is not a server record: %q", strings.Join(args, " "), out.String())
		}
	}
	return server, out.String(), err
}

// 登记区服之前建不了角；upsert-server 之后建得了。show-server 打印同一条记录；
// 把状态改成 maintenance 之后新账号建不了角，已有的角色照常选。
func TestLoginAccountctlRegistersAServerSoRolesCanBeCreated(t *testing.T) {
	service := loginCtlAccount(t)
	ctx := context.Background()
	alice, err := service.Login(ctx, svcaccount.Identity{Channel: "dev", OpenID: "alice"})
	if err != nil {
		t.Fatal(err)
	}
	if _, err := service.CreateRole(ctx, alice.ID, 1000, "Alice"); !errors.Is(err, svcaccount.ErrServerInvalid) {
		t.Fatalf("create role before the server is registered: %v, want ErrServerInvalid", err)
	}
	if _, _, err := loginCtlRun(t, service, "show-server", "-sid", "1000"); !errors.Is(err, svcaccount.ErrServerInvalid) {
		t.Fatalf("show-server of an unregistered server: %v, want ErrServerInvalid", err)
	}

	server, printed, err := loginCtlRun(t, service, "upsert-server", "-sid", "1000")
	if err != nil {
		t.Fatalf("upsert-server: %v", err)
	}
	if server.ID != 1000 || server.Name != "{{GAME_SERVICE}}-1000" || server.Status != svcaccount.ServerOpen || server.UpdatedAtUnix == 0 {
		t.Fatalf("upsert-server -sid 1000 wrote %+v, want an open server named {{GAME_SERVICE}}-1000", server)
	}
	if !strings.Contains(printed, `"status": "open"`) {
		t.Fatalf("upsert-server printed %q, want the record as indented JSON", printed)
	}
	role, err := service.CreateRole(ctx, alice.ID, 1000, "Alice")
	if err != nil {
		t.Fatalf("create role after upsert-server: %v", err)
	}
	shown, _, err := loginCtlRun(t, service, "show-server", "-sid", "1000")
	if err != nil || shown.ID != 1000 || shown.Name != server.Name || shown.Status != svcaccount.ServerOpen {
		t.Fatalf("show-server = %+v, %v; want the record upsert-server wrote", shown, err)
	}

	// 改名字、区域与状态：整条覆盖。
	renamed, _, err := loginCtlRun(t, service, "upsert-server", "-sid", "1000", "-name", "一服", "-region", "cn", "-status", "maintenance")
	if err != nil || renamed.Name != "一服" || renamed.Region != "cn" || renamed.Status != svcaccount.ServerMaintenance {
		t.Fatalf("upsert-server with a name, region and status = %+v, %v", renamed, err)
	}
	bob, err := service.Login(ctx, svcaccount.Identity{Channel: "dev", OpenID: "bob"})
	if err != nil {
		t.Fatal(err)
	}
	if _, err := service.CreateRole(ctx, bob.ID, 1000, "Bob"); !errors.Is(err, svcaccount.ErrServerClosed) {
		t.Fatalf("create role on a server in maintenance: %v, want ErrServerClosed", err)
	}
	if _, err := service.SelectRole(ctx, alice.ID, role.PlayerID); err != nil {
		t.Fatalf("an existing role on a server in maintenance cannot be selected: %v", err)
	}
	// 第二个服各记各的。
	if second, _, err := loginCtlRun(t, service, "upsert-server", "-sid", "1001", "-status", "full"); err != nil || second.ID != 1001 || second.Status != svcaccount.ServerFull {
		t.Fatalf("upsert-server -sid 1001 -status full = %+v, %v", second, err)
	}
	if again, _, _ := loginCtlRun(t, service, "show-server", "-sid", "1000"); again.Name != "一服" || again.Status != svcaccount.ServerMaintenance {
		t.Fatalf("registering 1001 changed 1000: %+v", again)
	}
}

// 参数不对的命令返回错误、什么也不写、什么也不打印：没有 -sid、服号不是正数、状态不认识、命令不认识。
func TestLoginAccountctlRefusesBadArgumentsWithoutWriting(t *testing.T) {
	service := loginCtlAccount(t)
	for label, test := range map[string]struct {
		args []string
		// want 是错误里必须出现的话：拒绝要出自这个命令自己的检查，说得出哪里不对。
		want string
	}{
		"no command":              {nil, "usage: accountctl"},
		"an unknown command":      {[]string{"merge-server", "-from", "1001", "-into", "1000"}, `unknown command "merge-server"`},
		"upsert without -sid":     {[]string{"upsert-server", "-name", "nameless"}, "-sid is required"},
		"upsert with sid zero":    {[]string{"upsert-server", "-sid", "0"}, "-sid is required"},
		"upsert with a bad sid":   {[]string{"upsert-server", "-sid", "-1000"}, "-sid is required"},
		"upsert with a bad state": {[]string{"upsert-server", "-sid", "1000", "-status", "opened"}, `invalid -status "opened"`},
		"upsert with a bad flag":  {[]string{"upsert-server", "-sid", "1000", "-open"}, "upsert-server: flag provided but not defined"},
		"show without -sid":       {[]string{"show-server"}, "-sid is required"},
		"list with an argument":   {[]string{"list-servers", "-sid", "1000"}, "list-servers: takes no arguments"},
		"show with a bad flag":    {[]string{"show-server", "-id", "1000"}, "show-server: flag provided but not defined"},
	} {
		_, printed, err := loginCtlRun(t, service, test.args...)
		if err == nil || !strings.Contains(err.Error(), test.want) {
			t.Fatalf("%s: accountctl %s: err = %v, want it to say %q", label, strings.Join(test.args, " "), err, test.want)
		}
		if printed != "" {
			t.Fatalf("%s: a refused command printed %q", label, printed)
		}
	}
	for _, sid := range []int32{1000, 1001} {
		if _, err := service.GetServer(context.Background(), sid); !errors.Is(err, svcaccount.ErrServerInvalid) {
			t.Fatalf("a refused command registered server %d: %v", sid, err)
		}
	}
}

// list-servers 打印登记过的全部区服，按服号升序，是一个 JSON 数组；一个都没有时是空数组而不是 null。
// 登记、改状态之后清单跟着变。
func TestLoginAccountctlListsTheRegisteredServers(t *testing.T) {
	service := loginCtlAccount(t)
	list := func() []svcaccount.GameServer {
		t.Helper()
		var out bytes.Buffer
		if err := run(context.Background(), service, []string{"list-servers"}, &out); err != nil {
			t.Fatalf("list-servers: %v", err)
		}
		if strings.TrimSpace(out.String()) == "null" {
			t.Fatal("list-servers printed null; an empty list must be []")
		}
		var servers []svcaccount.GameServer
		if err := json.Unmarshal(out.Bytes(), &servers); err != nil || servers == nil {
			t.Fatalf("list-servers printed %q, which is not a JSON array: %v", out.String(), err)
		}
		return servers
	}
	if servers := list(); len(servers) != 0 {
		t.Fatalf("a fresh account lists %+v", servers)
	}
	for _, args := range [][]string{
		{"upsert-server", "-sid", "1001", "-name", "二服"},
		{"upsert-server", "-sid", "1000"},
		{"upsert-server", "-sid", "7", "-status", "closed"},
	} {
		if _, _, err := loginCtlRun(t, service, args...); err != nil {
			t.Fatal(err)
		}
	}
	servers := list()
	if len(servers) != 3 || servers[0].ID != 7 || servers[0].Status != svcaccount.ServerClosed ||
		servers[1].ID != 1000 || servers[1].Name != "{{GAME_SERVICE}}-1000" || servers[2].ID != 1001 || servers[2].Name != "二服" {
		t.Fatalf("list-servers = %+v, want 7 (closed), 1000, 1001 in that order", servers)
	}
	if _, _, err := loginCtlRun(t, service, "upsert-server", "-sid", "1000", "-status", "maintenance"); err != nil {
		t.Fatal(err)
	}
	if servers := list(); len(servers) != 3 || servers[1].Status != svcaccount.ServerMaintenance {
		t.Fatalf("after changing server 1000's status: %+v", servers)
	}
	// account 给的是 nil 的清单：照样打印 []，脚本按数组读；account 出错：命令失败，什么都不打印。
	var out bytes.Buffer
	if err := run(context.Background(), loginCtlListing{}, []string{"list-servers"}, &out); err != nil || strings.TrimSpace(out.String()) != "[]" {
		t.Fatalf("a nil list printed %q, %v; want []", out.String(), err)
	}
	out.Reset()
	away := errors.New("redis: connection refused")
	if err := run(context.Background(), loginCtlListing{err: away}, []string{"list-servers"}, &out); !errors.Is(err, away) || out.Len() != 0 {
		t.Fatalf("a failed list: err %v, printed %q; want the error and no output", err, out.String())
	}
}

// loginCtlListing 是只答 ListServers 的 account 替身：清单是 nil，或者出错。
type loginCtlListing struct {
	serverRecords
	err error
}

func (listing loginCtlListing) ListServers(context.Context) ([]svcaccount.GameServer, error) {
	return nil, listing.err
}

// 连接旗标是与 deploy/dev/run.sh 的约定：脚本在全部服务起来之后按 config.account.yaml 里的 Redis 与键前缀
// 调 accountctl 登记本机的服。这里用脚本实际传的两种写法（单机、Cluster）来读，名字改了这一条就红。
// 什么都不带时的缺省值就是生成的开发配置里的值。
func TestLoginAccountctlReadsTheConnectionFlagsTheDevScriptPasses(t *testing.T) {
	single, command, err := parseConnection([]string{
		"-redis", "10.0.0.5:6380", "-redis-password", "s3cret", "-redis-db", "3", "-prefix", "roost:mygame:account",
		"upsert-server", "-sid", "1000",
	})
	if err != nil {
		t.Fatalf("the single-node form the dev script passes: %v", err)
	}
	if single.redis.Addr != "10.0.0.5:6380" || single.redis.Password != "s3cret" || single.redis.DB != 3 || len(single.redis.ClusterAddrs) != 0 || single.prefix != "roost:mygame:account" {
		t.Fatalf("connection = %+v with prefix %q", single.redis, single.prefix)
	}
	if strings.Join(command, " ") != "upsert-server -sid 1000" {
		t.Fatalf("the command after the connection flags = %q, want it left untouched for the sub-command", command)
	}
	cluster, command, err := parseConnection([]string{
		"-redis-cluster", "10.0.0.1:7000, 10.0.0.2:7000,", "-redis-password", "", "-prefix", "roost:{mygame}:account",
		"upsert-server", "-sid", "1001",
	})
	if err != nil {
		t.Fatalf("the cluster form the dev script passes: %v", err)
	}
	if strings.Join(cluster.redis.ClusterAddrs, "|") != "10.0.0.1:7000|10.0.0.2:7000" || cluster.redis.Password != "" || cluster.prefix != "roost:{mygame}:account" {
		t.Fatalf("cluster connection = %+v with prefix %q", cluster.redis, cluster.prefix)
	}
	if strings.Join(command, " ") != "upsert-server -sid 1001" {
		t.Fatalf("the command after the cluster flags = %q", command)
	}
	// 不带任何旗标：生成的开发配置里的值。
	defaults, command, err := parseConnection([]string{"show-server", "-sid", "1000"})
	if err != nil || defaults.redis.Addr != "127.0.0.1:6379" || defaults.redis.DB != 0 || defaults.redis.Password != "" ||
		len(defaults.redis.ClusterAddrs) != 0 || defaults.prefix != "roost:{{PROJECT}}:account" || len(command) != 3 {
		t.Fatalf("defaults = %+v, prefix %q, command %q, err %v", defaults.redis, defaults.prefix, command, err)
	}
	if _, command, err := parseConnection(nil); err != nil || len(command) != 0 {
		t.Fatalf("no arguments: command %q, err %v; main reports the usage", command, err)
	}
	// 不认识的连接旗标、写错类型的库号是错误，并带着用法。
	for _, args := range [][]string{
		{"-redis-addr", "10.0.0.5:6379", "upsert-server", "-sid", "1000"},
		{"-redis-db", "three", "upsert-server", "-sid", "1000"},
	} {
		if _, _, err := parseConnection(args); err == nil || !strings.Contains(err.Error(), "usage: accountctl") {
			t.Fatalf("accountctl %s: err = %v, want a flag error with the usage", strings.Join(args, " "), err)
		}
	}
}
