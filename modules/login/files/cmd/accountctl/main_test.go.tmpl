// accountctl 的场景。account 是内存存储上的正式服务：子命令只经 accountRecords 用它，与连着 Redis 的那一个
// 是同一份实现。没有连真实的 Redis——openService 那一段（地址、前缀）这里验不到。

// loginCtlAccount 给出一个空的 account：一个区服都没登记。
func loginCtlAccount(t *testing.T) *svcaccount.Service {
	t.Helper()
	return loginCtlAccountOn(t, versionstore.NewMemoryStore[int32, svcaccount.GameServer](), nil)
}

// loginCtlAccountOn 是在给定的区服存储上、按 account.services（services，可以为空）配置的 account；
// mutate 再改其余配置（例如 account.games）。
func loginCtlAccountOn(t *testing.T, servers versionstore.Store[int32, svcaccount.GameServer], services []svcaccount.ServiceSpec, mutate ...func(*svcaccount.Config)) *svcaccount.Service {
	t.Helper()
	names, err := directory.New(versionstore.NewMemoryStore[string, directory.Entry](), directory.Config{Normalize: directory.NormalizeLower, DefaultTTL: time.Minute})
	if err != nil {
		t.Fatal(err)
	}
	cfg := svcaccount.Config{
		Accounts:   versionstore.NewMemoryStore[string, svcaccount.Account](),
		Identities: versionstore.NewMemoryStore[string, svcaccount.IdentityRecord](),
		AccountIDs: svcaccount.NewMemoryAccountIDs(),
		Roles:      versionstore.NewMemoryStore[int64, svcaccount.Role](),
		Servers:    servers,
		Slots:      versionstore.NewMemoryStore[string, svcaccount.Slot](),
		Names:      names,
		Games:      []svcaccount.GameSpec{{Name: "main"}},
		Verifier: svcaccount.VerifierFunc(func(_ context.Context, identity svcaccount.Identity) (svcaccount.Verified, error) {
			return svcaccount.Verified{Channel: identity.Channel, OpenID: identity.OpenID}, nil
		}),
		Allocator:     svcaccount.AllocatorFunc(func(context.Context, int32) (int64, error) { return 100_001, nil }),
		NameRules:     svcaccount.NameValidatorFunc(func(string) error { return nil }),
		SessionSecret: "accountctl-test",
		Services:      services,
	}
	for _, change := range mutate {
		change(&cfg)
	}
	service, err := svcaccount.New(cfg)
	if err != nil {
		t.Fatal(err)
	}
	return service
}

// loginCtlRun 执行一个子命令，返回它打印的记录（没有打印时是零值）与错误。
func loginCtlRun(t *testing.T, service *svcaccount.Service, args ...string) (svcaccount.GameServer, string, error) {
	t.Helper()
	var out bytes.Buffer
	err := run(context.Background(), service, args, &out)
	var server svcaccount.GameServer
	if out.Len() > 0 {
		if decodeErr := json.Unmarshal(out.Bytes(), &server); decodeErr != nil {
			t.Fatalf("accountctl %s printed something that is not a server record: %q", strings.Join(args, " "), out.String())
		}
	}
	return server, out.String(), err
}

// 登记区服之前建不了角；upsert-server 之后建得了。show-server 打印同一条记录；
// 把状态改成 maintenance 之后新账号建不了角，已有的角色照常选。
func TestLoginAccountctlRegistersAServerSoRolesCanBeCreated(t *testing.T) {
	service := loginCtlAccount(t)
	ctx := context.Background()
	alice, err := service.Login(ctx, svcaccount.Identity{Channel: "dev", OpenID: "alice"})
	if err != nil {
		t.Fatal(err)
	}
	if _, err := service.CreateRole(ctx, alice.ID, 1000, "Alice"); !errors.Is(err, svcaccount.ErrServerInvalid) {
		t.Fatalf("create role before the server is registered: %v, want ErrServerInvalid", err)
	}
	if _, _, err := loginCtlRun(t, service, "show-server", "-sid", "1000"); !errors.Is(err, svcaccount.ErrServerInvalid) {
		t.Fatalf("show-server of an unregistered server: %v, want ErrServerInvalid", err)
	}

	server, printed, err := loginCtlRun(t, service, "upsert-server", "-sid", "1000")
	if err != nil {
		t.Fatalf("upsert-server: %v", err)
	}
	if server.ID != 1000 || server.Name != "{{GAME_SERVICE}}-1000" || server.Status != svcaccount.ServerOpen || server.UpdatedAtUnix == 0 {
		t.Fatalf("upsert-server -sid 1000 wrote %+v, want an open server named {{GAME_SERVICE}}-1000", server)
	}
	if !strings.Contains(printed, `"status": "open"`) {
		t.Fatalf("upsert-server printed %q, want the record as indented JSON", printed)
	}
	role, err := service.CreateRole(ctx, alice.ID, 1000, "Alice")
	if err != nil {
		t.Fatalf("create role after upsert-server: %v", err)
	}
	shown, _, err := loginCtlRun(t, service, "show-server", "-sid", "1000")
	if err != nil || shown.ID != 1000 || shown.Name != server.Name || shown.Status != svcaccount.ServerOpen {
		t.Fatalf("show-server = %+v, %v; want the record upsert-server wrote", shown, err)
	}

	// 改名字、区域与状态：整条覆盖。
	renamed, _, err := loginCtlRun(t, service, "upsert-server", "-sid", "1000", "-name", "一服", "-region", "cn", "-status", "maintenance")
	if err != nil || renamed.Name != "一服" || renamed.Region != "cn" || renamed.Status != svcaccount.ServerMaintenance {
		t.Fatalf("upsert-server with a name, region and status = %+v, %v", renamed, err)
	}
	bob, err := service.Login(ctx, svcaccount.Identity{Channel: "dev", OpenID: "bob"})
	if err != nil {
		t.Fatal(err)
	}
	if _, err := service.CreateRole(ctx, bob.ID, 1000, "Bob"); !errors.Is(err, svcaccount.ErrServerClosed) {
		t.Fatalf("create role on a server in maintenance: %v, want ErrServerClosed", err)
	}
	if _, err := service.SelectRole(ctx, alice.ID, role.PlayerID); err != nil {
		t.Fatalf("an existing role on a server in maintenance cannot be selected: %v", err)
	}
	// 第二个服各记各的。
	if second, _, err := loginCtlRun(t, service, "upsert-server", "-sid", "1001", "-status", "full"); err != nil || second.ID != 1001 || second.Status != svcaccount.ServerFull {
		t.Fatalf("upsert-server -sid 1001 -status full = %+v, %v", second, err)
	}
	if again, _, _ := loginCtlRun(t, service, "show-server", "-sid", "1000"); again.Name != "一服" || again.Status != svcaccount.ServerMaintenance {
		t.Fatalf("registering 1001 changed 1000: %+v", again)
	}
}

// 参数不对的命令返回错误、什么也不写、什么也不打印：没有 -sid、服号不是正数、状态不认识、命令不认识。
func TestLoginAccountctlRefusesBadArgumentsWithoutWriting(t *testing.T) {
	service := loginCtlAccount(t)
	for label, test := range map[string]struct {
		args []string
		// want 是错误里必须出现的话：拒绝要出自这个命令自己的检查，说得出哪里不对。
		want string
	}{
		"no command":              {nil, "usage: accountctl"},
		"an unknown command":      {[]string{"drop-server", "-sid", "1000"}, `unknown command "drop-server"`},
		"upsert without -sid":     {[]string{"upsert-server", "-name", "nameless"}, "-sid is required"},
		"upsert with sid zero":    {[]string{"upsert-server", "-sid", "0"}, "-sid is required"},
		"upsert with a bad sid":   {[]string{"upsert-server", "-sid", "-1000"}, "-sid is required"},
		"upsert with a bad state": {[]string{"upsert-server", "-sid", "1000", "-status", "opened"}, `invalid -status "opened"`},
		"upsert with a bad flag":  {[]string{"upsert-server", "-sid", "1000", "-open"}, "upsert-server: flag provided but not defined"},
		"show without -sid":       {[]string{"show-server"}, "-sid is required"},
		"list with an argument":   {[]string{"list-servers", "-sid", "1000"}, "list-servers: takes no arguments"},
		"show with a bad flag":    {[]string{"show-server", "-id", "1000"}, "show-server: flag provided but not defined"},
		"revoke without -account": {[]string{"revoke-game-tokens"}, "-account is required"},
		"revoke with a blank one": {[]string{"revoke-game-tokens", "-account", "  "}, "-account is required"},
		"revoke with an argument": {[]string{"revoke-game-tokens", "-account", "17", "now"}, "unexpected arguments"},
		"revoke with a bad flag":  {[]string{"revoke-game-tokens", "-player", "100001"}, "revoke-game-tokens: flag provided but not defined"},
		"revoke a missing one":    {[]string{"revoke-game-tokens", "-account", "999999"}, "account not found"},
		"ban without -account":    {[]string{"ban", "-note", "cheating"}, "ban: -account is required"},
		"ban without a note":      {[]string{"ban", "-account", "999999"}, "note"},
		"unban a missing one":     {[]string{"unban", "-account", "999999", "-note", "appeal"}, "account not found"},
		"ban with an argument":    {[]string{"ban", "-account", "17", "-note", "x", "now"}, "unexpected arguments"},
	} {
		_, printed, err := loginCtlRun(t, service, test.args...)
		if err == nil || !strings.Contains(err.Error(), test.want) {
			t.Fatalf("%s: accountctl %s: err = %v, want it to say %q", label, strings.Join(test.args, " "), err, test.want)
		}
		if printed != "" {
			t.Fatalf("%s: a refused command printed %q", label, printed)
		}
	}
	for _, sid := range []int32{1000, 1001} {
		if _, err := service.GetServer(context.Background(), sid); !errors.Is(err, svcaccount.ErrServerInvalid) {
			t.Fatalf("a refused command registered server %d: %v", sid, err)
		}
	}

	// 工程自己登记的子命令（registerCommand）：dispatch 先认它，交给它的是 account 服务本身与子命令名之后的参数；
	// 用法与“不认识的命令”里都列着它。没登记的名字仍然落到自带的命令上。与自带的命令重名、重复登记是写错了。
	var got []string
	registerCommand("login-test-echo", "login-test-echo WORD", func(_ context.Context, given *svcaccount.Service, args []string, out io.Writer) error {
		if given != service {
			t.Errorf("a registered command was handed %p, want the account service %p", given, service)
		}
		got = args
		_, err := io.WriteString(out, "echoed\n")
		return err
	})
	defer delete(operatorCommands, "login-test-echo")
	var out bytes.Buffer
	if err := dispatch(context.Background(), service, []string{"login-test-echo", "-sid", "7"}, &out); err != nil || strings.Join(got, " ") != "-sid 7" || out.String() != "echoed\n" {
		t.Fatalf("dispatch of a registered command: err %v, args %q, printed %q", err, got, out.String())
	}
	if err := dispatch(context.Background(), service, []string{"drop-server"}, &out); err == nil || !strings.Contains(err.Error(), `unknown command "drop-server"`) || !strings.Contains(err.Error(), "login-test-echo") {
		t.Fatalf("dispatch of an unknown command: %v, want the refusal to list the registered command too", err)
	}
	if err := dispatch(context.Background(), service, nil, &out); err == nil || !strings.Contains(err.Error(), "| login-test-echo WORD") {
		t.Fatalf("the usage does not list the registered command: %v", err)
	}
	for label, register := range map[string]func(){
		"a built-in name":  func() { registerCommand("show-server", "", func(context.Context, *svcaccount.Service, []string, io.Writer) error { return nil }) },
		"a name twice":     func() { registerCommand("login-test-echo", "", func(context.Context, *svcaccount.Service, []string, io.Writer) error { return nil }) },
		"no run function": func() { registerCommand("login-test-nil", "", nil) },
	} {
		func() {
			defer func() {
				if recover() == nil {
					t.Fatalf("registering %s did not panic", label)
				}
			}()
			register()
		}()
	}
}

// list-servers 打印登记过的全部区服，按服号升序，是一个 JSON 数组；一个都没有时是空数组而不是 null。
// 登记、改状态之后清单跟着变。
func TestLoginAccountctlListsTheRegisteredServers(t *testing.T) {
	service := loginCtlAccount(t)
	list := func() []svcaccount.GameServer {
		t.Helper()
		var out bytes.Buffer
		if err := run(context.Background(), service, []string{"list-servers"}, &out); err != nil {
			t.Fatalf("list-servers: %v", err)
		}
		if strings.TrimSpace(out.String()) == "null" {
			t.Fatal("list-servers printed null; an empty list must be []")
		}
		var servers []svcaccount.GameServer
		if err := json.Unmarshal(out.Bytes(), &servers); err != nil || servers == nil {
			t.Fatalf("list-servers printed %q, which is not a JSON array: %v", out.String(), err)
		}
		return servers
	}
	if servers := list(); len(servers) != 0 {
		t.Fatalf("a fresh account lists %+v", servers)
	}
	for _, args := range [][]string{
		{"upsert-server", "-sid", "1001", "-name", "二服"},
		{"upsert-server", "-sid", "1000"},
		{"upsert-server", "-sid", "7", "-status", "closed"},
	} {
		if _, _, err := loginCtlRun(t, service, args...); err != nil {
			t.Fatal(err)
		}
	}
	servers := list()
	if len(servers) != 3 || servers[0].ID != 7 || servers[0].Status != svcaccount.ServerClosed ||
		servers[1].ID != 1000 || servers[1].Name != "{{GAME_SERVICE}}-1000" || servers[2].ID != 1001 || servers[2].Name != "二服" {
		t.Fatalf("list-servers = %+v, want 7 (closed), 1000, 1001 in that order", servers)
	}
	if _, _, err := loginCtlRun(t, service, "upsert-server", "-sid", "1000", "-status", "maintenance"); err != nil {
		t.Fatal(err)
	}
	if servers := list(); len(servers) != 3 || servers[1].Status != svcaccount.ServerMaintenance {
		t.Fatalf("after changing server 1000's status: %+v", servers)
	}
	// account 给的是 nil 的清单：照样打印 []，脚本按数组读；account 出错：命令失败，什么都不打印。
	var out bytes.Buffer
	if err := run(context.Background(), loginCtlListing{}, []string{"list-servers"}, &out); err != nil || strings.TrimSpace(out.String()) != "[]" {
		t.Fatalf("a nil list printed %q, %v; want []", out.String(), err)
	}
	out.Reset()
	away := errors.New("redis: connection refused")
	if err := run(context.Background(), loginCtlListing{err: away}, []string{"list-servers"}, &out); !errors.Is(err, away) || out.Len() != 0 {
		t.Fatalf("a failed list: err %v, printed %q; want the error and no output", err, out.String())
	}
}

// loginCtlListing 是只答 ListServers 的 account 替身：清单是 nil，或者出错。
type loginCtlListing struct {
	accountRecords
	err error
}

func (listing loginCtlListing) ListServers(context.Context) ([]svcaccount.GameServer, error) {
	return nil, listing.err
}

// 连接旗标是与 deploy/dev/run.sh 的约定：脚本在全部服务起来之后按 config.account.yaml 里的 Redis 与键前缀
// 调 accountctl 登记本机的服。这里用脚本实际传的两种写法（单机、Cluster）来读，名字改了这一条就红。
// 什么都不带时的缺省值就是生成的开发配置里的值。
func TestLoginAccountctlReadsTheConnectionFlagsTheDevScriptPasses(t *testing.T) {
	single, command, err := parseConnection([]string{
		"-redis", "10.0.0.5:6380", "-redis-password", "s3cret", "-redis-db", "3", "-prefix", "roost:mygame:account",
		"upsert-server", "-sid", "1000",
	})
	if err != nil {
		t.Fatalf("the single-node form the dev script passes: %v", err)
	}
	if single.redis.Addr != "10.0.0.5:6380" || single.redis.Password != "s3cret" || single.redis.DB != 3 || len(single.redis.ClusterAddrs) != 0 || single.prefix != "roost:mygame:account" {
		t.Fatalf("connection = %+v with prefix %q", single.redis, single.prefix)
	}
	if strings.Join(command, " ") != "upsert-server -sid 1000" {
		t.Fatalf("the command after the connection flags = %q, want it left untouched for the sub-command", command)
	}
	cluster, command, err := parseConnection([]string{
		"-redis-cluster", "10.0.0.1:7000, 10.0.0.2:7000,", "-redis-password", "", "-prefix", "roost:{mygame}:account",
		"upsert-server", "-sid", "1001",
	})
	if err != nil {
		t.Fatalf("the cluster form the dev script passes: %v", err)
	}
	if strings.Join(cluster.redis.ClusterAddrs, "|") != "10.0.0.1:7000|10.0.0.2:7000" || cluster.redis.Password != "" || cluster.prefix != "roost:{mygame}:account" {
		t.Fatalf("cluster connection = %+v with prefix %q", cluster.redis, cluster.prefix)
	}
	if strings.Join(command, " ") != "upsert-server -sid 1001" {
		t.Fatalf("the command after the cluster flags = %q", command)
	}
	// 不带任何旗标：生成的开发配置里的值。
	defaults, command, err := parseConnection([]string{"show-server", "-sid", "1000"})
	if err != nil || defaults.redis.Addr != "127.0.0.1:6379" || defaults.redis.DB != 0 || defaults.redis.Password != "" ||
		len(defaults.redis.ClusterAddrs) != 0 || defaults.prefix != "roost:{{PROJECT}}:account" || len(command) != 3 {
		t.Fatalf("defaults = %+v, prefix %q, command %q, err %v", defaults.redis, defaults.prefix, command, err)
	}
	if _, command, err := parseConnection(nil); err != nil || len(command) != 0 {
		t.Fatalf("no arguments: command %q, err %v; main reports the usage", command, err)
	}
	// 不认识的连接旗标、写错类型的库号是错误，并带着用法。
	for _, args := range [][]string{
		{"-redis-addr", "10.0.0.5:6379", "upsert-server", "-sid", "1000"},
		{"-redis-db", "three", "upsert-server", "-sid", "1000"},
	} {
		if _, _, err := parseConnection(args); err == nil || !strings.Contains(err.Error(), "usage: accountctl") {
			t.Fatalf("accountctl %s: err = %v, want a flag error with the usage", strings.Join(args, " "), err)
		}
	}
}

// upsert-server -service 写区服归属的 game 服务（account.services 有几个 game 服务时必须写）：写进记录、show-server 看得到；
// 不是 game 服务的名字被 account 拒绝。accountctl 不读 account.services，-service 经 recordService 交给 openService。
// 记录写了服务名之后不带 -service 再改它，accountctl（没有配置 account.services 的那一个）点名该带的 -service。
func TestLoginAccountctlWritesTheServerService(t *testing.T) {
	servers := versionstore.NewMemoryStore[int32, svcaccount.GameServer]()
	service := loginCtlAccountOn(t, servers, []svcaccount.ServiceSpec{
		{Name: "brawl", Kind: svcaccount.ServiceKindGame}, {Name: "party", Kind: svcaccount.ServiceKindGame}, {Name: "lobby", Kind: svcaccount.ServiceKindLobby},
	})
	if _, _, err := loginCtlRun(t, service, "upsert-server", "-sid", "2000"); err == nil || !strings.Contains(err.Error(), "name the server's service") {
		t.Fatalf("upsert-server without -service among two game services: %v, want account's refusal", err)
	}
	written, _, err := loginCtlRun(t, service, "upsert-server", "-sid", "2000", "-service", "party")
	if err != nil || written.Service != "party" {
		t.Fatalf("upsert-server -service party = %+v, %v; want the record to belong to party", written, err)
	}
	if shown, _, err := loginCtlRun(t, service, "show-server", "-sid", "2000"); err != nil || shown.Service != "party" {
		t.Fatalf("show-server = %+v, %v; want service party", shown, err)
	}
	if _, _, err := loginCtlRun(t, service, "upsert-server", "-sid", "2001", "-service", "lobby"); err == nil || !strings.Contains(err.Error(), "is not a game service") {
		t.Fatalf("upsert-server -service lobby: %v, want a refusal (the lobby has no servers)", err)
	}

	if got := recordService([]string{"upsert-server", "-sid", "2000", "-service", "party"}); got != "party" {
		t.Fatalf("recordService of upsert-server -service party = %q", got)
	}
	for _, command := range [][]string{{"show-server", "-sid", "2000"}, {"upsert-server", "-sid", "2000"}, {"upsert-server", "-bad"}, nil} {
		if got := recordService(command); got != "" {
			t.Fatalf("recordService(%q) = %q, want none", command, got)
		}
	}

	// accountctl 不读 account.services：没带 -service 时它的 account 没有配置服务，改一个已写了服务名的记录被拒，错误点名 -service。
	unconfigured := loginCtlAccountOn(t, servers, nil)
	if _, printed, err := loginCtlRun(t, unconfigured, "upsert-server", "-sid", "2000", "-status", "maintenance"); err == nil || !strings.Contains(err.Error(), `belongs to service "party"; pass -service party`) || printed != "" {
		t.Fatalf("upsert-server of a party server without -service: %v (printed %q), want the refusal to name -service party", err, printed)
	}
	// 带上 -service（openService 把它当作唯一的 game 服务交给 account）就改得了，服务名保持。
	withService := loginCtlAccountOn(t, servers, []svcaccount.ServiceSpec{{Name: "party", Kind: svcaccount.ServiceKindGame}})
	if again, _, err := loginCtlRun(t, withService, "upsert-server", "-sid", "2000", "-status", "maintenance", "-service", "party"); err != nil || again.Service != "party" || again.Status != svcaccount.ServerMaintenance {
		t.Fatalf("upsert-server -service party -status maintenance = %+v, %v", again, err)
	}
}

// revoke-game-tokens（交接 C6）：经 account 的 RevokeGameTokens 把账号上的 token 代数加一，打印账号与新代数。
// 之前签发的游戏账号 token 校验被拒，之后签发的照常可用，别的账号不受影响；再执行一次再加一。
func TestLoginAccountctlRevokesAnAccountsGameTokens(t *testing.T) {
	service := loginCtlAccountOn(t, versionstore.NewMemoryStore[int32, svcaccount.GameServer](), nil, func(c *svcaccount.Config) {
		c.Games = []svcaccount.GameSpec{{Name: "party"}}
	})
	ctx := context.Background()
	gameToken := func(accountID string) string {
		t.Helper()
		ticket, err := service.IssueAccountTicket(ctx, accountID)
		if err != nil {
			t.Fatal(err)
		}
		token, err := service.IssueGameToken(ctx, ticket.Ticket, "party")
		if err != nil {
			t.Fatal(err)
		}
		return token.Token
	}
	alice, err := service.Login(ctx, svcaccount.Identity{Channel: "dev", OpenID: "alice"})
	if err != nil {
		t.Fatal(err)
	}
	bob, err := service.Login(ctx, svcaccount.Identity{Channel: "dev", OpenID: "bob"})
	if err != nil {
		t.Fatal(err)
	}
	before, bobs := gameToken(alice.ID), gameToken(bob.ID)
	revoke := func() uint64 {
		t.Helper()
		var out bytes.Buffer
		if err := dispatch(ctx, service, []string{"revoke-game-tokens", "-account", alice.ID}, &out); err != nil {
			t.Fatalf("accountctl revoke-game-tokens -account %s: %v", alice.ID, err)
		}
		var printed struct {
			AccountID  string  `json:"account_id"`
			Generation *uint64 `json:"game_token_generation"`
		}
		if err := json.Unmarshal(out.Bytes(), &printed); err != nil || printed.AccountID != alice.ID || printed.Generation == nil {
			t.Fatalf("revoke-game-tokens printed %q (%v)", out.String(), err)
		}
		return *printed.Generation
	}
	if generation := revoke(); generation != 1 {
		t.Fatalf("the first revocation printed generation %d, want 1", generation)
	}
	if _, err := service.ValidateGameToken(ctx, before); !errors.Is(err, svcaccount.ErrSessionInvalid) {
		t.Fatalf("alice's token from before the revocation: %v, want ErrSessionInvalid", err)
	}
	after := gameToken(alice.ID)
	if got, err := service.ValidateGameToken(ctx, after); err != nil || got.AccountID != alice.ID {
		t.Fatalf("alice's token from after the revocation: %+v, %v", got, err)
	}
	if got, err := service.ValidateGameToken(ctx, bobs); err != nil || got.AccountID != bob.ID {
		t.Fatalf("bob's token after alice's revocation: %+v, %v", got, err)
	}
	if generation := revoke(); generation != 2 {
		t.Fatalf("the second revocation printed generation %d, want 2", generation)
	}
	if _, err := service.ValidateGameToken(ctx, after); !errors.Is(err, svcaccount.ErrSessionInvalid) {
		t.Fatalf("the generation-1 token after the second revocation: %v", err)
	}
}

// ban / unban（维护者 2026-11-18）：封号在身份级。用这个人在 party 的账号号封，他在 brawl 的账号也登录不了；打印的身份
// 记录列出他在两个游戏的账号号（运维面）。解封之后两个游戏都能登录。
func TestLoginAccountctlBansThePersonInEveryGame(t *testing.T) {
	service := loginCtlAccountOn(t, versionstore.NewMemoryStore[int32, svcaccount.GameServer](), nil, func(c *svcaccount.Config) {
		c.Games, c.DefaultGame = []svcaccount.GameSpec{{Name: "party"}, {Name: "brawl"}}, "party"
	})
	ctx := context.Background()
	login := func(game string) (svcaccount.Account, error) {
		return service.Login(ctx, svcaccount.Identity{Channel: "dev", OpenID: "alice", Game: game})
	}
	party, err := login("party")
	if err != nil {
		t.Fatal(err)
	}
	brawl, err := login("brawl")
	if err != nil || brawl.ID == party.ID {
		t.Fatalf("alice in brawl = %+v, %v; want an account other than party's %s", brawl, err, party.ID)
	}
	command := func(args ...string) svcaccount.IdentityRecord {
		t.Helper()
		var out bytes.Buffer
		if err := dispatch(ctx, service, args, &out); err != nil {
			t.Fatalf("accountctl %s: %v", strings.Join(args, " "), err)
		}
		var printed svcaccount.IdentityRecord
		if err := json.Unmarshal(out.Bytes(), &printed); err != nil {
			t.Fatalf("accountctl %s printed %q: %v", strings.Join(args, " "), out.String(), err)
		}
		return printed
	}
	banned := command("ban", "-account", party.ID, "-note", "cheating, ticket 123")
	if !banned.Banned || banned.Accounts["party"] != party.ID || banned.Accounts["brawl"] != brawl.ID || banned.AdminNote != "cheating, ticket 123" {
		t.Fatalf("ban printed %+v", banned)
	}
	for _, game := range []string{"party", "brawl"} {
		if _, err := login(game); !errors.Is(err, svcaccount.ErrIdentityDenied) {
			t.Fatalf("a banned person logged into %s: %v", game, err)
		}
	}
	if unbanned := command("unban", "-account", brawl.ID, "-note", "appeal accepted"); unbanned.Banned {
		t.Fatalf("unban printed %+v", unbanned)
	}
	for _, game := range []string{"party", "brawl"} {
		if _, err := login(game); err != nil {
			t.Fatalf("logging into %s after the unban: %v", game, err)
		}
	}
}
