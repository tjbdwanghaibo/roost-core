// Command accountctl 是 account 服务故意不放上总线的那部分运维操作里，登录要用到的最小一块：
// 登记一个区服、改它的状态、看它的记录；另带按账号号吊销游戏账号 token、封号与解封三个命令。
//
//	go run ./cmd/accountctl upsert-server -sid 1000                       # 登记并开放 1000 服（名字缺省 {{GAME_SERVICE}}-1000）
//	go run ./cmd/accountctl upsert-server -sid 1000 -status maintenance   # 停止在这个服建角（已有角色照常登录）
//	go run ./cmd/accountctl show-server -sid 1000
//	go run ./cmd/accountctl list-servers                                  # 登记过的全部区服，按服号升序
//	go run ./cmd/accountctl -redis 10.0.0.5:6379 -redis-password ... -prefix roost:{{PROJECT}}:account upsert-server -sid 1001 -name 二服
//	go run ./cmd/accountctl upsert-server -sid 2000 -service brawl         # 区服归属的 game 服务（account.services 有几个 game 时）
//	go run ./cmd/accountctl revoke-game-tokens -account 17                 # 让账号号 17 所属的人此前签发的游戏账号 token（gt2）全部失效（所有游戏）
//	go run ./cmd/accountctl ban -account 17 -note "外挂，工单 123"           # 封这个人：他在所有游戏的账号都登录不了
//	go run ./cmd/accountctl unban -account 17 -note "申诉通过"
//
// 为什么要有它：account 里没有状态是 open 的服，新号进不了任何服（握手时建不出账号与玩家号的映射，
// CreateRole 也一律拒绝），登录入口的区服清单也是空的；而登记区服（UpsertServer）改的是
// “所有玩家能登录到哪里”，account 不让任何一个连得上总线的进程做这件事（roost-core 的
// service/account/account_rpc.go）。所以这个工具做运维会做的事：用 account 自己的 Redis 配置直接打开它的
// 存储，把区服记录写进去。服号就是 game 进程的 sid（configs/service/config.{{GAME_SERVICE}}.yaml 的 sid，
// 或启动时的 --sid）。
//
// 连接参数取自 account 进程的配置（configs/service/config.account.yaml）：-redis / -redis-password /
// -redis-db / -redis-cluster 对应 redis.*，-prefix 对应 account.key_prefix。缺省值就是生成的开发配置里的值，
// 所以本机开发不用带任何参数；别的环境照那个环境的配置填。前缀填错不会报错——只是写进了另一套部署
// （或谁也不读）的键里，登记之后用 show-server 与一次真实的建角确认。
//
// 区服归属的服务（-service）：account.services 列了几个 kind 为 game 的服务时，区服记录要写明归属哪一个
// （roost-core 的 service/account/services.go）；只有一个 game 服务、或没有配置 account.services 时不用写，account 自己归位。
// accountctl 不读 account.services：-service 的名字原样交给 account 写进记录，要与 account 配置里 kind: game 的服务名一致
// （写错了，那个服务的区服清单里就没有它，用 show-server 核对）。记录写了服务名之后，再改这个服也要带同一个 -service。
//
// 旗标的名字与 roost-core demo 的同名命令相同：生成的 deploy/dev/run.sh 发现工程里有 cmd/accountctl 时，
// 在全部服务起来之后用它们登记本机的服（upsert-server -sid $SID）。改旗标名字会让那一步失败。
//
// revoke-game-tokens（交接 C6，维护者 2026-11-17）：调 account 的 RevokeGameTokens（总线接口上的同一个方法，这里在
// 同一份存储上直接调），由账号号找到这个人的身份，把身份上的 token 代数加一：他在所有游戏里此前签发的游戏账号 token
// 全部失效，之后签发的照常可用；封号、账号票据、进服票据不受影响，已经连上 relay 的房间也不断开（只拦以后的大厅调用）。
// -account 是 account 的账号号（account 发的十进制数，一个游戏一个；维护者 2026-11-18），不是玩家号。
//
// ban / unban（维护者 2026-11-18）：调 account 的 Admin.SetIdentityBanned（不在总线上）。封号在身份级：由账号号找到这个人，
// 他在所有游戏的账号一起封或解封；按游戏封号以后再加。-note 必填，记在身份记录上。打印身份记录（渠道、open id、
// 各游戏的账号号）——这是运维面，别处拿不到。
//
// 合服、单个角色换服的人工兜底不在这里。工程要加自己的子命令时不用改这个文件：在这个包里另写一个文件，
// 用 init 调 registerCommand 登记（见它的注释）。roost-core 的 game-demo 就是这样加的
// merge-server / unmerge-server / show-role / transfer-role（它的 cmd/accountctl/operator.go）。
package main

import (
	"context"
	"encoding/json"
	"errors"
	"flag"
	"fmt"
	"io"
	"os"
	"sort"
	"strings"
	"time"

	accountcollaborators "{{MODULE}}/services/account"

	fredis "github.com/tjbdwanghaibo/roost-core/infra/storage/redis"
	redisdriver "github.com/tjbdwanghaibo/roost-core/infra/storage/redis/driver"
	svcaccount "github.com/tjbdwanghaibo/roost-core/service/account"
)

const usage = "usage: accountctl [-redis addr | -redis-cluster addr,addr,...] [-redis-password P] [-redis-db N] [-prefix key_prefix] " +
	"upsert-server -sid N [-name NAME] [-status open|maintenance|full|closed] [-region R] [-service GAME_SERVICE] | show-server -sid N | list-servers | " +
	"revoke-game-tokens -account ACCOUNT_ID | ban -account ACCOUNT_ID -note TEXT | unban -account ACCOUNT_ID -note TEXT"

func main() {
	target, command, err := parseConnection(os.Args[1:])
	if err != nil {
		fail(err)
	}
	if len(command) == 0 {
		fail(errors.New(usageText()))
	}
	service, closeStore, err := openService(target.redis, target.prefix, recordService(command))
	if err != nil {
		fail(err)
	}
	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	err = dispatch(ctx, service, command, os.Stdout)
	cancel()
	closeStore()
	if err != nil {
		fail(err)
	}
}

// connection 是命令行开头那几个旗标说的事：account 的 Redis 在哪里、它的键前缀是什么。
type connection struct {
	redis  *fredis.Config
	prefix string
}

// parseConnection 读子命令之前的连接旗标，返回连接参数与剩下的参数（子命令和它自己的旗标）。
// 旗标的名字是与 deploy/dev/run.sh 的约定（见文件头），不认识的旗标是错误。
func parseConnection(args []string) (connection, []string, error) {
	flags := flag.NewFlagSet("accountctl", flag.ContinueOnError)
	flags.SetOutput(io.Discard)
	redisAddr := flags.String("redis", "127.0.0.1:6379", "account 服务的 Redis（config.account.yaml 的 redis.addr）")
	redisPassword := flags.String("redis-password", "", "Redis 口令（redis.password）")
	redisDB := flags.Int("redis-db", 0, "Redis 库号（redis.db）")
	// 单机客户端连 Cluster 只够得着那个节点负责的槽，别的键会得到 MOVED。
	redisCluster := flags.String("redis-cluster", "", "Redis Cluster 种子地址，逗号分隔（redis.cluster_addrs）；写了就不用 -redis 与 -redis-db")
	prefix := flags.String("prefix", "roost:{{PROJECT}}:account", "config.account.yaml 的 account.key_prefix：与运行中的 account 服务靠它共用同一份存储")
	if err := flags.Parse(args); err != nil {
		return connection{}, nil, fmt.Errorf("%w\n%s", err, usageText())
	}
	cfg := fredis.DefaultConfig(*redisAddr)
	cfg.Password = *redisPassword
	cfg.DB = *redisDB
	for _, addr := range strings.Split(*redisCluster, ",") {
		if addr = strings.TrimSpace(addr); addr != "" {
			cfg.ClusterAddrs = append(cfg.ClusterAddrs, addr)
		}
	}
	return connection{redis: cfg, prefix: *prefix}, flags.Args(), nil
}

// accountRecords 是自带子命令用到的 account 接口；*svcaccount.Service 满足它。UpsertServer 不在总线接口
// （svcaccount.Accounts）上，所以这里要的是服务本身，不是它的客户端。RevokeGameTokens 在总线接口上，这里与它
// 一样在同一份存储上直接调。
type accountRecords interface {
	UpsertServer(ctx context.Context, server svcaccount.GameServer) (svcaccount.GameServer, error)
	GetServer(ctx context.Context, serverID int32) (svcaccount.GameServer, error)
	ListServers(ctx context.Context) ([]svcaccount.GameServer, error)
	RevokeGameTokens(ctx context.Context, accountID string) (uint64, error)
	SetIdentityBanned(ctx context.Context, accountID string, banned bool, note string) (svcaccount.IdentityRecord, error)
}

// builtinCommands 是这个文件自带的子命令的名字，按用法里的顺序。
var builtinCommands = []string{"upsert-server", "show-server", "list-servers", "revoke-game-tokens", "ban", "unban"}

// operatorCommand 是工程自己登记的一个子命令。
type operatorCommand struct {
	// usage 是它在用法里的那一段，例如 "merge-server -from A -into B -note TEXT"。
	usage string
	run   func(ctx context.Context, service *svcaccount.Service, args []string, out io.Writer) error
}

// operatorCommands 是工程登记的子命令，按名字查。只在 init 里写，之后只读。
var operatorCommands = map[string]operatorCommand{}

// registerCommand 登记一个工程自己的子命令。在这个包的另一个文件里用 init 调它，这个文件不用改：
//
//	func init() {
//		registerCommand("merge-server", "merge-server -from A -into B -note TEXT", mergeServer)
//	}
//
// run 拿到的是 account 服务本身（与运行中的 account 进程共用同一份存储），args 是子命令名之后的参数，
// 结果写到 out；返回错误时命令以非零状态退出。空名、nil、与自带的命令重名、重复登记都是写错了，直接 panic。
func registerCommand(name, usage string, run func(ctx context.Context, service *svcaccount.Service, args []string, out io.Writer) error) {
	if name == "" || run == nil {
		panic("accountctl: registerCommand needs a name and a run function")
	}
	for _, builtin := range builtinCommands {
		if name == builtin {
			panic(fmt.Sprintf("accountctl: command %q is built in and cannot be registered again", name))
		}
	}
	if _, taken := operatorCommands[name]; taken {
		panic(fmt.Sprintf("accountctl: command %q is registered twice", name))
	}
	operatorCommands[name] = operatorCommand{usage: usage, run: run}
}

// commandNames 是全部子命令的名字：自带的，然后是工程登记的（按名字排序）。
func commandNames() []string {
	names := make([]string, 0, len(operatorCommands))
	for name := range operatorCommands {
		names = append(names, name)
	}
	sort.Strings(names)
	return append(append([]string{}, builtinCommands...), names...)
}

// usageText 是完整的用法：自带的那一行，后面接工程登记的子命令各自的用法。
func usageText() string {
	text := usage
	for _, name := range commandNames()[len(builtinCommands):] {
		text += " | " + operatorCommands[name].usage
	}
	return text
}

// dispatch 是 main 调的入口：工程登记的子命令交给它自己，其余交给 run。
func dispatch(ctx context.Context, service *svcaccount.Service, args []string, out io.Writer) error {
	if len(args) > 0 {
		if command, ok := operatorCommands[args[0]]; ok {
			return command.run(ctx, service, args[1:], out)
		}
	}
	return run(ctx, service, args, out)
}

// run 执行一个自带的子命令，把结果记录以 JSON 写到 out。参数不对、account 拒绝都返回错误，什么也不写。
// 工程登记的子命令不经过这里（dispatch 先认它们）。
func run(ctx context.Context, records accountRecords, args []string, out io.Writer) error {
	if len(args) == 0 {
		return errors.New(usageText())
	}
	switch args[0] {
	case "upsert-server":
		return upsertServer(ctx, records, args[1:], out)
	case "show-server":
		return showServer(ctx, records, args[1:], out)
	case "list-servers":
		return listServers(ctx, records, args[1:], out)
	case "revoke-game-tokens":
		return revokeGameTokens(ctx, records, args[1:], out)
	case "ban", "unban":
		return setBanned(ctx, records, args[0], args[1:], out)
	default:
		return fmt.Errorf("unknown command %q (commands: %s)", args[0], strings.Join(commandNames(), ", "))
	}
}

// parseUpsertServer 读 upsert-server 的旗标，得到要写的记录（Service 为空表示不指定归属的服务）。
func parseUpsertServer(args []string) (svcaccount.GameServer, error) {
	flags := flag.NewFlagSet("upsert-server", flag.ContinueOnError)
	flags.SetOutput(io.Discard)
	sid := flags.Int("sid", 0, "区服号：game 进程的 sid")
	name := flags.String("name", "", "显示名（缺省 {{GAME_SERVICE}}-<sid>）")
	status := flags.String("status", string(svcaccount.ServerOpen), "open | maintenance | full | closed；只有 open 的服能建角")
	region := flags.String("region", "", "区域标签，account 不解释它")
	service := flags.String("service", "", "区服归属的 game 服务（account.services 里 kind: game 的服务名）；只有一个 game 服务时不用写")
	if err := flags.Parse(args); err != nil {
		return svcaccount.GameServer{}, fmt.Errorf("upsert-server: %w", err)
	}
	if *sid <= 0 {
		return svcaccount.GameServer{}, errors.New("upsert-server: -sid is required (the game process's sid, a positive number)")
	}
	if *name == "" {
		*name = fmt.Sprintf("{{GAME_SERVICE}}-%d", *sid)
	}
	serverStatus := svcaccount.ServerStatus(*status)
	switch serverStatus {
	case svcaccount.ServerOpen, svcaccount.ServerMaintenance, svcaccount.ServerFull, svcaccount.ServerClosed:
	default:
		return svcaccount.GameServer{}, fmt.Errorf("upsert-server: invalid -status %q (open, maintenance, full or closed)", *status)
	}
	return svcaccount.GameServer{ID: int32(*sid), Name: *name, Status: serverStatus, Region: *region, Service: strings.TrimSpace(*service)}, nil
}

// recordService 是命令要写进区服记录的服务名（upsert-server -service），其余命令与旗标写错时为空。openService 据它把这个
// 服务当作 account.services 里的 game 服务交给 account（accountctl 不读 account 的配置，见文件头）。
func recordService(command []string) string {
	if len(command) == 0 || command[0] != "upsert-server" {
		return ""
	}
	server, err := parseUpsertServer(command[1:])
	if err != nil {
		return ""
	}
	return server.Service
}

// upsertServer 登记或更新一个区服。它整条覆盖名字、状态与区域（合服字段由 account 原样保留）：
// 只想改状态时也要把名字带上，不带就回到缺省名。-sid 必填、没有缺省：写错服号是登记了一个没有进程的服。
// -service 写区服归属的 game 服务；不写时沿用记录里已有的（account 的规则）。
func upsertServer(ctx context.Context, records accountRecords, args []string, out io.Writer) error {
	request, err := parseUpsertServer(args)
	if err != nil {
		return err
	}
	server, err := records.UpsertServer(ctx, request)
	if err != nil {
		// 记录已经写了服务名、这次没带 -service：account 沿用记录里的服务名，而 accountctl 没有把它交给 account
		// （不读 account.services），于是被拒。点名该带的 -service，而不是只转述 account 的拒绝。
		if request.Service == "" {
			if current, getErr := records.GetServer(ctx, request.ID); getErr == nil && current.Service != "" {
				return fmt.Errorf("upsert-server: server %d belongs to service %q; pass -service %s: %w", request.ID, current.Service, current.Service, err)
			}
		}
		return fmt.Errorf("upsert-server: %w", err)
	}
	return printJSON(out, server)
}

// showServer 打印一个区服的记录（含合服字段）；没登记过的服是错误。
func showServer(ctx context.Context, records accountRecords, args []string, out io.Writer) error {
	flags := flag.NewFlagSet("show-server", flag.ContinueOnError)
	flags.SetOutput(io.Discard)
	sid := flags.Int("sid", 0, "区服号")
	if err := flags.Parse(args); err != nil {
		return fmt.Errorf("show-server: %w", err)
	}
	if *sid <= 0 {
		return errors.New("show-server: -sid is required")
	}
	server, err := records.GetServer(ctx, int32(*sid))
	if err != nil {
		return fmt.Errorf("show-server: %w", err)
	}
	return printJSON(out, server)
}

// listServers 打印登记过的全部区服（account 的 ListServers：登录入口给客户端的清单就是从它来的），
// 一个 JSON 数组，按服号升序；一个都没有时是 []。区服索引是随 upsert-server 维护的：
// 这个命令之前登记的服不在清单里，对它再执行一次 upsert-server 即补上。
func listServers(ctx context.Context, records accountRecords, args []string, out io.Writer) error {
	if len(args) != 0 {
		return fmt.Errorf("list-servers: takes no arguments, got %q", strings.Join(args, " "))
	}
	servers, err := records.ListServers(ctx)
	if err != nil {
		return fmt.Errorf("list-servers: %w", err)
	}
	if servers == nil {
		servers = []svcaccount.GameServer{}
	}
	return printJSON(out, servers)
}

// gameTokenRevocation 是 revoke-game-tokens 打印的结果。
type gameTokenRevocation struct {
	AccountID string `json:"account_id"`
	// GameTokenGeneration 是吊销之后账号上的代数：之后签发的 token 带它，之前的全部失效。
	GameTokenGeneration uint64 `json:"game_token_generation"`
}

// revokeGameTokens 吊销一个账号此前签发的全部游戏账号 token（account 的 RevokeGameTokens），打印账号与新的代数。
// -account 必填；账号不存在时 account 拒绝（ErrAccountMissing），什么都不写。再执行一次会再加一：每次都是
// “让到此刻为止签发的全部失效”。
func revokeGameTokens(ctx context.Context, records accountRecords, args []string, out io.Writer) error {
	flags := flag.NewFlagSet("revoke-game-tokens", flag.ContinueOnError)
	flags.SetOutput(io.Discard)
	account := flags.String("account", "", "account 的账号号（account 发的十进制数，任何一个游戏的都行），不是玩家号")
	if err := flags.Parse(args); err != nil {
		return fmt.Errorf("revoke-game-tokens: %w", err)
	}
	if flags.NArg() != 0 {
		return fmt.Errorf("revoke-game-tokens: unexpected arguments %q", strings.Join(flags.Args(), " "))
	}
	accountID := strings.TrimSpace(*account)
	if accountID == "" {
		return errors.New("revoke-game-tokens: -account is required (the account id account handed out at login)")
	}
	generation, err := records.RevokeGameTokens(ctx, accountID)
	if err != nil {
		return fmt.Errorf("revoke-game-tokens: %w", err)
	}
	return printJSON(out, gameTokenRevocation{AccountID: accountID, GameTokenGeneration: generation})
}

// setBanned 是 ban / unban：由账号号找到这个人的身份，封号或解封（account 的 Admin.SetIdentityBanned），打印身份记录。
// -account 与 -note 必填；账号不存在、备注为空或超长时 account 拒绝，什么都不写。
func setBanned(ctx context.Context, records accountRecords, command string, args []string, out io.Writer) error {
	flags := flag.NewFlagSet(command, flag.ContinueOnError)
	flags.SetOutput(io.Discard)
	account := flags.String("account", "", "account 的账号号（任何一个游戏的都行），不是玩家号")
	note := flags.String("note", "", "为什么封 / 解封（必填，记在身份记录上）")
	if err := flags.Parse(args); err != nil {
		return fmt.Errorf("%s: %w", command, err)
	}
	if flags.NArg() != 0 {
		return fmt.Errorf("%s: unexpected arguments %q", command, strings.Join(flags.Args(), " "))
	}
	accountID := strings.TrimSpace(*account)
	if accountID == "" {
		return fmt.Errorf("%s: -account is required (the account id account handed out at login)", command)
	}
	record, err := records.SetIdentityBanned(ctx, accountID, command == "ban", *note)
	if err != nil {
		return fmt.Errorf("%s: %w", command, err)
	}
	return printJSON(out, record)
}

func printJSON(out io.Writer, value any) error {
	encoded, err := json.MarshalIndent(value, "", "  ")
	if err != nil {
		return err
	}
	_, err = fmt.Fprintln(out, string(encoded))
	return err
}

// openService 在运行中的 account 进程用的同一份 Redis 存储上建一个 account 服务。协作者用工程自己的那一套
// （bootstrap 交给 account Mod 的同一份），名字规则因此一致；子命令不登录也不建角，所以身份校验与
// 玩家号分配器不会被调用，它们要的 Registry 绑定这里不需要。
//
// gameService 非空时（upsert-server -service），它作为 account.services 里唯一的 game 服务交给 account：account 据此检查名字的
// 写法并把它写进区服记录。accountctl 不读 account 的配置，名字要与 account.services 一致由运维保证（文件头）。
func openService(cfg *fredis.Config, prefix, gameService string) (*svcaccount.Service, func(), error) {
	assembly, err := redisdriver.Assemble(cfg)
	if err != nil {
		return nil, nil, fmt.Errorf("redis: %w", err)
	}
	closeStore := func() { _ = assembly.Close() }
	var services []svcaccount.ServiceSpec
	if gameService != "" {
		services = []svcaccount.ServiceSpec{{Name: gameService, Kind: svcaccount.ServiceKindGame}}
	}
	stores, err := svcaccount.NewRedisStores(assembly.Client, prefix, svcaccount.DefaultClaimTTL)
	if err != nil {
		closeStore()
		return nil, nil, fmt.Errorf("account stores: %w", err)
	}
	service, err := svcaccount.New(svcaccount.Config{
		Accounts: stores.Accounts, Identities: stores.Identities, AccountIDs: stores.AccountIDs,
		Roles: stores.Roles, Servers: stores.Servers, Slots: stores.Slots, Names: stores.Names,
		Verifier: accountcollaborators.Verifier(), Allocator: accountcollaborators.Allocator(), NameRules: accountcollaborators.NameRules(),
		// 构造服务必须给一把会话密钥；这个工具从不签发也不校验会话与票据（吊销与封号只改身份记录），值无所谓，
		// 而且不能是真的那一把。不给 account.games：这个工具不登录。
		SessionSecret: "accountctl-does-not-mint-sessions",
		Services:      services,
	})
	if err != nil {
		closeStore()
		return nil, nil, fmt.Errorf("account service: %w", err)
	}
	return service, closeStore, nil
}

func fail(err error) {
	fmt.Fprintf(os.Stderr, "accountctl: %v\n", err)
	os.Exit(1)
}
