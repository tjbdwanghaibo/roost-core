// 会话激活后的告知的场景。登记表是进程级的：每条用例换成自己的，结束时换回去。

func withNotices(t *testing.T) {
	t.Helper()
	noticesMu.Lock()
	saved := notices
	notices = map[string]Notice{}
	noticesMu.Unlock()
	t.Cleanup(func() {
		noticesMu.Lock()
		notices = saved
		noticesMu.Unlock()
	})
}

// noticeLog 记下告知看到的会话，按发生顺序。
type noticeLog struct {
	mu   sync.Mutex
	seen []string
	last Active
}

func (log *noticeLog) record(name string, session Active) {
	log.mu.Lock()
	defer log.mu.Unlock()
	log.seen = append(log.seen, name+":"+session.SessionID)
	log.last = session
}

func (log *noticeLog) events() []string {
	log.mu.Lock()
	defer log.mu.Unlock()
	return append([]string(nil), log.seen...)
}

// 嵌入 TCP：激活通知带着握手的 claims。通知立即返回——告知在后台执行，按名字顺序，拿到同一条会话与
// 传输 Mod 给的 registry；一条告知 panic 不带倒后面的。
func TestLoginSessionActiveRunsTheNoticesInTheBackground(t *testing.T) {
	withNotices(t)
	log := &noticeLog{}
	registry := app.NewRegistry(viper.New())
	release := make(chan struct{})
	var deadline time.Duration
	OnSessionActive("enter", func(ctx context.Context, got *app.Registry, session Active) {
		<-release
		if got != registry {
			t.Error("the notice got another registry")
		}
		if at, ok := ctx.Deadline(); ok {
			deadline = time.Until(at)
		}
		log.record("enter", session)
	})
	OnSessionActive("faulty", func(context.Context, *app.Registry, Active) { panic("notice blew up") })
	OnSessionActive("zeta", func(_ context.Context, _ *app.Registry, session Active) { log.record("zeta", session) })

	notifier := NewNotifier()
	claims := map[string]string{"server_id": "1000", "enter_ticket": "1"}
	returned := make(chan struct{})
	go func() {
		notifier.SessionActive(registry, gateway.Principal{PlayerID: 100_001, SessionID: "s-1", Claims: claims}, true)
		close(returned)
	}()
	select {
	case <-returned:
	case <-time.After(2 * time.Second):
		t.Fatal("SessionActive waited for a notice; it runs in the handshake goroutine and must return at once")
	}
	if got := log.events(); len(got) != 0 {
		t.Fatalf("notices ran before being released: %v", got)
	}
	close(release)
	notifier.Wait()
	if want := []string{"enter:s-1", "zeta:s-1"}; !reflect.DeepEqual(log.events(), want) {
		t.Fatalf("notices saw %v, want %v", log.events(), want)
	}
	if log.last.PlayerID != 100_001 || !reflect.DeepEqual(log.last.Claims, claims) {
		t.Fatalf("the notice saw %+v, want the handshake's player and claims", log.last)
	}
	if deadline <= 0 || deadline > 5*time.Second {
		t.Fatalf("the notice's context ends in %v, want a deadline of at most 5s", deadline)
	}
	// 没有登记任何告知的工程：什么都不做，也不记 claims。
	withNotices(t)
	idle := NewNotifier()
	idle.Remember(gateway.Principal{PlayerID: 100_001, Claims: claims})
	idle.SessionActive(registry, gateway.Principal{PlayerID: 100_001, SessionID: "s-2"}, false)
	idle.Wait()
	if len(idle.remembered) != 0 {
		t.Fatalf("%d players remembered with no notice registered", len(idle.remembered))
	}
}

// 独立 Gate：激活通知只有玩家号与会话号，claims 取认证器最近一次认证这名玩家时记下的。
// 记录 30 秒过期；没有记录（不是这个认证器认证的）就不告知，不拿空的 claims 去告知。
func TestLoginSessionActiveUnderAnIndependentGateRecallsTheClaims(t *testing.T) {
	withNotices(t)
	log := &noticeLog{}
	OnSessionActive("enter", func(_ context.Context, _ *app.Registry, session Active) { log.record("enter", session) })
	notifier := NewNotifier()
	now := time.Unix(1_800_000_000, 0)
	notifier.now = func() time.Time { return now }
	claims := map[string]string{"server_id": "1000", "enter_ticket": "1"}

	// Game Ingress 在 Bind 时认证（认证器给的会话号被换成 Gate 的），随后激活。
	notifier.Remember(gateway.Principal{PlayerID: 100_001, SessionID: "candidate", Claims: claims})
	notifier.SessionActive(nil, gateway.Principal{PlayerID: 100_001, SessionID: "gate-1"}, false)
	notifier.Wait()
	if want := []string{"enter:gate-1"}; !reflect.DeepEqual(log.events(), want) || !reflect.DeepEqual(log.last.Claims, claims) {
		t.Fatalf("notices saw %v with %+v, want the gate's session with the remembered claims", log.events(), log.last)
	}
	// 没认证过的玩家、过期的记录：不告知。
	notifier.SessionActive(nil, gateway.Principal{PlayerID: 100_002, SessionID: "gate-2"}, false)
	now = now.Add(30 * time.Second)
	notifier.SessionActive(nil, gateway.Principal{PlayerID: 100_001, SessionID: "gate-3"}, false)
	notifier.Wait()
	if want := []string{"enter:gate-1", "enter:gate-3"}; !reflect.DeepEqual(log.events(), want) {
		t.Fatalf("at exactly 30s: notices saw %v, want %v", log.events(), want)
	}
	now = now.Add(time.Second)
	notifier.SessionActive(nil, gateway.Principal{PlayerID: 100_001, SessionID: "gate-4"}, false)
	notifier.Wait()
	if got := log.events(); len(got) != 2 {
		t.Fatalf("a record older than 30s was used: %v", got)
	}
	// 嵌入 TCP 的激活通知自己带着 claims：用它的，并丢掉记录。
	notifier.Remember(gateway.Principal{PlayerID: 100_003, Claims: map[string]string{"server_id": "stale"}})
	notifier.SessionActive(nil, gateway.Principal{PlayerID: 100_003, SessionID: "tcp-1", Claims: claims}, true)
	notifier.Wait()
	if !reflect.DeepEqual(log.last.Claims, claims) || len(notifier.remembered) != 0 {
		t.Fatalf("an embedded activation saw %+v and left %d records; want its own claims and none", log.last, len(notifier.remembered))
	}
}

// 有界：同时在后台执行的告知至多 256 条会话，超过的丢弃而不是排队；记 claims 的表至多 4096 名玩家，
// 满了先清过期的，还满就不记。
func TestLoginSessionActiveIsBounded(t *testing.T) {
	withNotices(t)
	log := &noticeLog{}
	release := make(chan struct{})
	OnSessionActive("enter", func(_ context.Context, _ *app.Registry, session Active) {
		<-release
		log.record("enter", session)
	})
	notifier := NewNotifier()
	if cap(notifier.slots) != 256 {
		t.Fatalf("%d notices may be pending, want 256", cap(notifier.slots))
	}
	for i := 0; i < 256; i++ {
		notifier.SessionActive(nil, gateway.Principal{PlayerID: int64(i + 1), SessionID: "held"}, true)
	}
	over := make(chan struct{})
	go func() {
		notifier.SessionActive(nil, gateway.Principal{PlayerID: 999, SessionID: "over"}, true)
		close(over)
	}()
	select {
	case <-over:
	case <-time.After(2 * time.Second):
		t.Fatal("SessionActive waited for a free slot; over the bound it must drop the notice and return")
	}
	close(release)
	notifier.Wait()
	events := log.events()
	if len(events) != 256 {
		t.Fatalf("%d notices ran, want the 256 that fit", len(events))
	}
	for _, event := range events {
		if event == "enter:over" {
			t.Fatal("the notice over the bound ran")
		}
	}
	// 腾出来之后照常告知。
	notifier.SessionActive(nil, gateway.Principal{PlayerID: 999, SessionID: "later"}, true)
	notifier.Wait()
	if got := log.events(); got[len(got)-1] != "enter:later" {
		t.Fatalf("a notice after the burst did not run: last = %s", got[len(got)-1])
	}

	now := time.Unix(1_800_000_000, 0)
	notifier.now = func() time.Time { return now }
	for i := 0; i < 4096; i++ {
		notifier.Remember(gateway.Principal{PlayerID: int64(i + 1), Claims: map[string]string{}})
	}
	notifier.Remember(gateway.Principal{PlayerID: 5000})
	if _, known := notifier.recall(5000); known || len(notifier.remembered) != 4096 {
		t.Fatalf("the table holds %d players and the 4097th is known=%v; want 4096 and not remembered", len(notifier.remembered), known)
	}
	// 已经在表里的玩家照常更新。
	notifier.Remember(gateway.Principal{PlayerID: 1, Claims: map[string]string{"server_id": "1001"}})
	if claims, known := notifier.recall(1); !known || claims["server_id"] != "1001" {
		t.Fatalf("a remembered player was not refreshed: %v, %v", claims, known)
	}
	now = now.Add(31 * time.Second)
	notifier.Remember(gateway.Principal{PlayerID: 5000})
	if _, known := notifier.recall(5000); !known || len(notifier.remembered) != 1 {
		t.Fatalf("after the old records lapsed: known=%v with %d records; want the new one alone", known, len(notifier.remembered))
	}
	notifier.Remember(gateway.Principal{})
	if len(notifier.remembered) != 1 {
		t.Fatal("a principal without a player was remembered")
	}
}

// 登记写错了当场 panic，不留到运行时。
func TestLoginSessionActiveRegistrationMistakesPanic(t *testing.T) {
	withNotices(t)
	mustPanic := func(what string, register func()) {
		t.Helper()
		defer func() {
			if recover() == nil {
				t.Fatalf("%s did not panic", what)
			}
		}()
		register()
	}
	mustPanic("an empty name", func() { OnSessionActive("", func(context.Context, *app.Registry, Active) {}) })
	mustPanic("a nil notice", func() { OnSessionActive("enter", nil) })
	OnSessionActive("enter", func(context.Context, *app.Registry, Active) {})
	mustPanic("a duplicate name", func() { OnSessionActive("enter", func(context.Context, *app.Registry, Active) {}) })
	// nil 的 Notifier（认证器没建它）不 panic。
	var none *Notifier
	none.Remember(gateway.Principal{PlayerID: 1})
	none.SessionActive(nil, gateway.Principal{PlayerID: 1}, true)
}
