package login

import (
	"context"
	"reflect"
	"sync"
	"testing"
	"time"

	"github.com/spf13/viper"
	"github.com/tjbdwanghaibo/roost-core/framework/app"
	"github.com/tjbdwanghaibo/roost-core/infra/network/gateway"
)

// 会话激活后的告知的场景。登记表是进程级的：每条用例换成自己的，结束时换回去。

func withNotices(t *testing.T) {
	t.Helper()
	noticesMu.Lock()
	saved := notices
	notices = map[string]Notice{}
	noticesMu.Unlock()
	t.Cleanup(func() {
		noticesMu.Lock()
		notices = saved
		noticesMu.Unlock()
	})
}

// noticeLog 记下告知看到的会话，按发生顺序。
type noticeLog struct {
	mu   sync.Mutex
	seen []string
	last Active
}

func (log *noticeLog) record(name string, session Active) {
	log.mu.Lock()
	defer log.mu.Unlock()
	log.seen = append(log.seen, name+":"+session.SessionID)
	log.last = session
}

func (log *noticeLog) events() []string {
	log.mu.Lock()
	defer log.mu.Unlock()
	return append([]string(nil), log.seen...)
}

// 嵌入 TCP：激活通知带着握手的 claims。通知立即返回——告知在后台执行，按名字顺序，拿到同一条会话与
// 传输 Mod 给的 registry；一条告知 panic 不带倒后面的。
func TestLoginSessionActiveRunsTheNoticesInTheBackground(t *testing.T) {
	withNotices(t)
	log := &noticeLog{}
	registry := app.NewRegistry(viper.New())
	release := make(chan struct{})
	var deadline time.Duration
	OnSessionActive("enter", func(ctx context.Context, got *app.Registry, session Active) {
		<-release
		if got != registry {
			t.Error("the notice got another registry")
		}
		if at, ok := ctx.Deadline(); ok {
			deadline = time.Until(at)
		}
		log.record("enter", session)
	})
	OnSessionActive("faulty", func(context.Context, *app.Registry, Active) { panic("notice blew up") })
	OnSessionActive("zeta", func(_ context.Context, _ *app.Registry, session Active) { log.record("zeta", session) })

	notifier := NewNotifier()
	claims := map[string]string{"server_id": "1000", "enter_ticket": "1"}
	returned := make(chan struct{})
	go func() {
		notifier.SessionActive(registry, gateway.Principal{PlayerID: 100_001, SessionID: "s-1", Claims: claims})
		close(returned)
	}()
	select {
	case <-returned:
	case <-time.After(2 * time.Second):
		t.Fatal("SessionActive waited for a notice; it runs in the handshake goroutine and must return at once")
	}
	if got := log.events(); len(got) != 0 {
		t.Fatalf("notices ran before being released: %v", got)
	}
	close(release)
	notifier.Wait()
	if want := []string{"enter:s-1", "zeta:s-1"}; !reflect.DeepEqual(log.events(), want) {
		t.Fatalf("notices saw %v, want %v", log.events(), want)
	}
	if log.last.PlayerID != 100_001 || !reflect.DeepEqual(log.last.Claims, claims) {
		t.Fatalf("the notice saw %+v, want the handshake's player and claims", log.last)
	}
	if deadline <= 0 || deadline > 5*time.Second {
		t.Fatalf("the notice's context ends in %v, want a deadline of at most 5s", deadline)
	}
	// 没有登记任何告知的工程：什么都不做，连后台的名额都不占。
	withNotices(t)
	idle := NewNotifier()
	idle.SessionActive(registry, gateway.Principal{PlayerID: 100_001, SessionID: "s-2", Claims: claims})
	idle.Wait()
	if len(idle.slots) != 0 {
		t.Fatalf("%d notice slots taken with no notice registered", len(idle.slots))
	}
}

// 独立 Gate：激活通知带的是 Game Ingress 绑定这条会话时认证出来的 Principal（会话号是 Gate 的），告知看到的
// 就是它的 claims。Notifier 不记任何会话的状态：同一名玩家的下一条会话只看到自己那一次的 claims，
// 不带 claims 的会话看到的是空的，不会捡到上一条会话的。
func TestLoginSessionActiveUnderAnIndependentGateUsesTheBoundPrincipal(t *testing.T) {
	withNotices(t)
	log := &noticeLog{}
	OnSessionActive("enter", func(_ context.Context, _ *app.Registry, session Active) { log.record("enter", session) })
	notifier := NewNotifier()
	claims := map[string]string{"server_id": "1000", "enter_ticket": "1"}

	notifier.SessionActive(nil, gateway.Principal{PlayerID: 100_001, SessionID: "gate-1", Claims: claims})
	notifier.Wait()
	if want := []string{"enter:gate-1"}; !reflect.DeepEqual(log.events(), want) || !reflect.DeepEqual(log.last.Claims, claims) {
		t.Fatalf("notices saw %v with %+v, want the gate's session with the bound principal's claims", log.events(), log.last)
	}
	later := map[string]string{"server_id": "1001"}
	notifier.SessionActive(nil, gateway.Principal{PlayerID: 100_001, SessionID: "gate-2", Claims: later})
	notifier.Wait()
	if want := []string{"enter:gate-1", "enter:gate-2"}; !reflect.DeepEqual(log.events(), want) || !reflect.DeepEqual(log.last.Claims, later) {
		t.Fatalf("the second session saw %v with %+v, want its own claims", log.events(), log.last)
	}
	notifier.SessionActive(nil, gateway.Principal{PlayerID: 100_001, SessionID: "gate-3"})
	notifier.Wait()
	if got := log.events(); len(got) != 3 || got[2] != "enter:gate-3" || len(log.last.Claims) != 0 {
		t.Fatalf("a session without claims saw %v with %+v, want the notice with no claims", got, log.last)
	}
}

// 有界：同时在后台执行的告知至多 256 条会话，超过的丢弃而不是排队。
func TestLoginSessionActiveIsBounded(t *testing.T) {
	withNotices(t)
	log := &noticeLog{}
	release := make(chan struct{})
	OnSessionActive("enter", func(_ context.Context, _ *app.Registry, session Active) {
		<-release
		log.record("enter", session)
	})
	notifier := NewNotifier()
	if cap(notifier.slots) != 256 {
		t.Fatalf("%d notices may be pending, want 256", cap(notifier.slots))
	}
	for i := 0; i < 256; i++ {
		notifier.SessionActive(nil, gateway.Principal{PlayerID: int64(i + 1), SessionID: "held"})
	}
	over := make(chan struct{})
	go func() {
		notifier.SessionActive(nil, gateway.Principal{PlayerID: 999, SessionID: "over"})
		close(over)
	}()
	select {
	case <-over:
	case <-time.After(2 * time.Second):
		t.Fatal("SessionActive waited for a free slot; over the bound it must drop the notice and return")
	}
	close(release)
	notifier.Wait()
	events := log.events()
	if len(events) != 256 {
		t.Fatalf("%d notices ran, want the 256 that fit", len(events))
	}
	for _, event := range events {
		if event == "enter:over" {
			t.Fatal("the notice over the bound ran")
		}
	}
	// 腾出来之后照常告知。
	notifier.SessionActive(nil, gateway.Principal{PlayerID: 999, SessionID: "later"})
	notifier.Wait()
	if got := log.events(); got[len(got)-1] != "enter:later" {
		t.Fatalf("a notice after the burst did not run: last = %s", got[len(got)-1])
	}
}

// 登记写错了当场 panic，不留到运行时。
func TestLoginSessionActiveRegistrationMistakesPanic(t *testing.T) {
	withNotices(t)
	mustPanic := func(what string, register func()) {
		t.Helper()
		defer func() {
			if recover() == nil {
				t.Fatalf("%s did not panic", what)
			}
		}()
		register()
	}
	mustPanic("an empty name", func() { OnSessionActive("", func(context.Context, *app.Registry, Active) {}) })
	mustPanic("a nil notice", func() { OnSessionActive("enter", nil) })
	OnSessionActive("enter", func(context.Context, *app.Registry, Active) {})
	mustPanic("a duplicate name", func() { OnSessionActive("enter", func(context.Context, *app.Registry, Active) {}) })
	// nil 的 Notifier（认证器没建它）不 panic。
	var none *Notifier
	none.SessionActive(nil, gateway.Principal{PlayerID: 1})
}
