// 联动的场景经 game/enter 的登记表执行（Enter），所以证明的是“接上了”：
// 认证器写的 claims 原样交给进入流程，被拒绝的进入没有加载任何东西。

// withLoginRegistry 是一个 game 进程的 Registry：只有配置里的 sid（0 表示不写）。
func withLoginRegistry(sid int) *app.Registry {
	cfg := viper.New()
	if sid != 0 {
		cfg.Set("sid", sid)
	}
	return app.NewRegistry(cfg)
}

// withLoginEnter 照进入端点那样走一遍 Enter，load 只计数。
func withLoginEnter(registry *app.Registry, claims map[string]string, loads *int) (Entered, error) {
	return Enter(context.Background(), registry, Entering{PlayerID: 100_001, Claims: claims},
		func(context.Context) (InitResult, error) {
			*loads++
			return InitResult{First: true}, nil
		})
}

// 认证器给本服的角色写的 claims 放行，进入钩子拿到同一份；别的服的角色、没有 claims 的会话在加载之前被拒，
// 客户端拿到 login_elsewhere。
func TestWithLoginEnterRefusesARoleOfAnotherServerBeforeLoading(t *testing.T) {
	registry := withLoginRegistry(1000)
	loads := 0
	here := Claims(svcaccount.Role{PlayerID: 100_001, ServerID: 1000, ServingServerID: 1000, CreatedAtUnix: 1_800_000_000})
	entered, err := withLoginEnter(registry, here, &loads)
	if err != nil || loads != 1 {
		t.Fatalf("a role this server serves: err %v, %d loads; want admitted and loaded once", err, loads)
	}
	if !entered.First || entered.Claims["server_id"] != "1000" || entered.Claims["role_created_at"] != "1800000000" {
		t.Fatalf("the enter hooks would see %+v, want the authenticator's claims", entered)
	}
	// 合服之后原服是 1001、承载服是本服的角色照样放行：比较的是承载服。
	merged := Claims(svcaccount.Role{PlayerID: 100_001, ServerID: 1001, ServingServerID: 1000})
	if _, err := withLoginEnter(registry, merged, &loads); err != nil || loads != 2 {
		t.Fatalf("a merged role served here: err %v, %d loads", err, loads)
	}

	elsewhere := Claims(svcaccount.Role{PlayerID: 100_001, ServerID: 1001, ServingServerID: 1001})
	for _, claims := range []map[string]string{elsewhere, {}, nil} {
		_, err := withLoginEnter(registry, claims, &loads)
		if !errors.Is(err, apperrors.ErrLoginElsewhere) {
			t.Fatalf("claims %v: err = %v, want login_elsewhere", claims, err)
		}
	}
	if loads != 2 {
		t.Fatalf("a refused enter loaded the player: %d loads, want 2", loads)
	}
}

// 比较用的是本进程配置里的 sid：换一个进程（sid 1001）问，同一份 claims 的答案相反；
// 读不出 sid 的进程一个都不放。
func TestWithLoginEnterComparesWithThisProcessSid(t *testing.T) {
	loads := 0
	onOtherServer := Claims(svcaccount.Role{PlayerID: 100_001, ServerID: 1001, ServingServerID: 1001})
	if _, err := withLoginEnter(withLoginRegistry(1001), onOtherServer, &loads); err != nil || loads != 1 {
		t.Fatalf("server 1001 and its own role: err %v, %d loads", err, loads)
	}
	if _, err := withLoginEnter(withLoginRegistry(1000), onOtherServer, &loads); !errors.Is(err, apperrors.ErrLoginElsewhere) {
		t.Fatalf("server 1000 and a role of 1001: err = %v, want login_elsewhere", err)
	}
	for _, registry := range []*app.Registry{withLoginRegistry(0), withLoginRegistry(-7), nil} {
		// 用本来会放行的 claims 问：读不出 sid 时既不能放行，也不能答 login_elsewhere——
		// 那是在告诉客户端“去别的服”，而问题出在本进程的配置上。
		_, err := withLoginEnter(registry, Claims(svcaccount.Role{PlayerID: 100_001, ServerID: 1000, ServingServerID: 1000}), &loads)
		if err == nil {
			t.Fatal("a process that cannot read its sid admitted a player")
		}
		if errors.Is(err, apperrors.ErrLoginElsewhere) {
			t.Fatalf("a process that cannot read its sid answered login_elsewhere: %v", err)
		}
		if _, err := withLoginEnter(registry, onOtherServer, &loads); err == nil || errors.Is(err, apperrors.ErrLoginElsewhere) {
			t.Fatalf("a process that cannot read its sid judged a role of server 1001: %v", err)
		}
	}
	if loads != 1 {
		t.Fatalf("%d loads, want 1", loads)
	}
}

// 下面是握手方式与进入游戏两条路的场景。account 是真实的（newLoginWorld），握手经真实的认证器；
// 游戏服的档用内存替身（withLoginRecords），它照 enter 模块的事务规则回答：建成了没有只看首次初始化的标记。

type withLoginRecord struct {
	built  bool
	fresh  bool
	name   string
	grants int
}

type withLoginRecords struct{ players map[int64]*withLoginRecord }

func (records *withLoginRecords) loads(playerID int64) Loads {
	return Loads{
		LoadOrCreate: func(context.Context) (InitResult, error) {
			record := records.players[playerID]
			if record == nil {
				record = &withLoginRecord{}
				records.players[playerID] = record
			}
			if !record.built {
				record.built, record.grants = true, record.grants+1
				return InitResult{First: true}, nil
			}
			first := record.fresh
			record.fresh = false
			return InitResult{First: first}, nil
		},
		Existing: func(context.Context) (InitResult, error) {
			record := records.players[playerID]
			if record == nil || !record.built {
				return InitResult{}, ErrNeedCreate
			}
			first := record.fresh
			record.fresh = false
			return InitResult{First: first}, nil
		},
	}
}

func (records *withLoginRecords) steps(playerID int64) CreateSteps {
	return CreateSteps{
		Ensure: func(context.Context) error {
			if records.players[playerID] == nil {
				records.players[playerID] = &withLoginRecord{}
			}
			return nil
		},
		Commit: func(_ context.Context, name string) error {
			record := records.players[playerID]
			if record.built {
				return apperrors.ErrEnterCreated
			}
			record.built, record.fresh, record.name, record.grants = true, true, name, record.grants+1
			return nil
		},
	}
}

func (records *withLoginRecords) built(playerID int64) func(context.Context) (bool, error) {
	return func(context.Context) (bool, error) {
		record := records.players[playerID]
		return record != nil && record.built, nil
	}
}

// withLoginAnnounced 换掉推 EnterStatus 的入口，记下告知被叫到时拿的会话；结束时换回去。
type withLoginAnnounced struct {
	entering  Entering
	sessionID string
	calls     int
}

func withLoginAnnounce(t *testing.T) *withLoginAnnounced {
	t.Helper()
	seen := &withLoginAnnounced{}
	saved := enterAnnounce
	enterAnnounce = func(_ context.Context, _ *app.Registry, entering Entering, sessionID string) {
		seen.entering, seen.sessionID = entering, sessionID
		seen.calls++
	}
	t.Cleanup(func() { enterAnnounce = saved })
	return seen
}

// 新号的整条路：进服票据握手 → 会话激活后的告知拿到这条会话 → 告知的结论是“要先新建”→ 没新建就进入被拒、
// 什么都没建 → 新建（带名字）→ 进入是首次 → 再握手（重连）告知“直接进入”。
func TestWithLoginEnterANewAccountIsToldToCreateThenCreatesAndEnters(t *testing.T) {
	w := newLoginWorld(t)
	registry := withLoginRegistry(1000)
	records := &withLoginRecords{players: map[int64]*withLoginRecord{}}
	announced := withLoginAnnounce(t)
	authenticator := Authenticator{Accounts: w.service}
	notifier := NewNotifier()
	handshake := w.enterHandshake("alice", 1000)

	principal, err := authenticator.Authenticate(context.Background(), handshake)
	if err != nil || principal.Claims[svcaccount.NewRoleClaim] != "1" {
		t.Fatalf("a new account's handshake: %+v, %v", principal, err)
	}
	notifier.SessionActive(registry, principal)
	notifier.Wait()
	if announced.calls != 1 || announced.sessionID != principal.SessionID || announced.entering.PlayerID != 100_001 || announced.entering.Claims[EnterTicketClaim] != "1" {
		t.Fatalf("the status notice got %+v for session %q (%d calls), want this session and its claims once", announced.entering, announced.sessionID, announced.calls)
	}
	entering := announced.entering
	status, refused, err := Assess(context.Background(), registry, entering, records.built(100_001))
	if err != nil || refused || status != (Status{NeedCreate: true}) {
		t.Fatalf("status for a new account = %+v refused=%v err=%v, want need_create", status, refused, err)
	}
	// 推送丢了也一样：直接进入得到 enter_need_create，游戏服什么都没建。
	if _, err := EnterSession(context.Background(), registry, entering, records.loads(100_001)); !errors.Is(err, apperrors.ErrEnterNeedCreate) {
		t.Fatalf("entering before creating: err = %v, want enter_need_create", err)
	}
	if len(records.players) != 0 {
		t.Fatalf("a refused enter created a record: %v", records.players)
	}
	creating := Creating{PlayerID: entering.PlayerID, Name: "Alice", Claims: entering.Claims}
	if err := Create(context.Background(), registry, creating, records.steps(100_001)); err != nil {
		t.Fatal(err)
	}
	if record := records.players[100_001]; record == nil || !record.built || record.name != "Alice" || record.grants != 1 {
		t.Fatalf("after create: %+v, want built, named by the game server, one grant", record)
	}
	// account 那一侧只有映射，没有名字。
	if role, err := w.service.RoleOnServer(context.Background(), "store:alice", 1000); err != nil || role.PlayerID != 100_001 || role.Name != "" {
		t.Fatalf("account holds %+v, %v; want the mapping without a name", role, err)
	}
	entered, err := EnterSession(context.Background(), registry, entering, records.loads(100_001))
	if err != nil || !entered.First || entered.PlayerID != 100_001 {
		t.Fatalf("the first enter after create: %+v, %v; want first", entered, err)
	}
	if err := Create(context.Background(), registry, creating, records.steps(100_001)); !errors.Is(err, apperrors.ErrEnterCreated) {
		t.Fatalf("creating again: err = %v, want enter_created", err)
	}
	// 重连：同一张票据，不再是新映射；告知的结论是直接进入，进入不再是首次。
	again, err := authenticator.Authenticate(context.Background(), handshake)
	if err != nil || again.PlayerID != 100_001 {
		t.Fatal(err)
	}
	if _, isNew := again.Claims[svcaccount.NewRoleClaim]; isNew {
		t.Fatal("the reconnect is marked as a new mapping")
	}
	status, refused, err = Assess(context.Background(), registry, Entering{PlayerID: again.PlayerID, Claims: again.Claims}, records.built(100_001))
	if err != nil || refused || status != (Status{}) {
		t.Fatalf("status on reconnect = %+v refused=%v err=%v, want enter directly", status, refused, err)
	}
	if entered, err = EnterSession(context.Background(), registry, Entering{PlayerID: again.PlayerID, Claims: again.Claims}, records.loads(100_001)); err != nil || entered.First {
		t.Fatalf("enter on reconnect: %+v, %v; want not first", entered, err)
	}
	if records.players[100_001].grants != 1 {
		t.Fatalf("%d grants, want 1", records.players[100_001].grants)
	}
}

// 要不要新建由游戏服的档说了算，不看 account 的“映射是不是这次新建的”：映射早就有、玩家数据没建成
// （上次握手之后没有新建，或者建到一半）的账号再来，照样被告知要新建、进入照样被拒。
func TestWithLoginEnterAMappedAccountWithoutPlayerDataStillCreates(t *testing.T) {
	w := newLoginWorld(t)
	registry := withLoginRegistry(1000)
	records := &withLoginRecords{players: map[int64]*withLoginRecord{}}
	authenticator := Authenticator{Accounts: w.service}
	handshake := w.enterHandshake("alice", 1000)
	if _, err := authenticator.Authenticate(context.Background(), handshake); err != nil {
		t.Fatal(err)
	}
	// 有档而没建成：上次新建到一半。
	records.players[100_001] = &withLoginRecord{}
	principal, err := authenticator.Authenticate(context.Background(), handshake)
	if err != nil {
		t.Fatal(err)
	}
	if _, isNew := principal.Claims[svcaccount.NewRoleClaim]; isNew {
		t.Fatal("the second handshake is marked as a new mapping; the scenario needs an old one")
	}
	entering := Entering{PlayerID: principal.PlayerID, Claims: principal.Claims}
	status, refused, err := Assess(context.Background(), registry, entering, records.built(100_001))
	if err != nil || refused || !status.NeedCreate {
		t.Fatalf("status = %+v refused=%v err=%v, want need_create although the mapping is old", status, refused, err)
	}
	if _, err := EnterSession(context.Background(), registry, entering, records.loads(100_001)); !errors.Is(err, apperrors.ErrEnterNeedCreate) {
		t.Fatalf("entering: err = %v, want enter_need_create", err)
	}
	if record := records.players[100_001]; record.built || record.grants != 0 {
		t.Fatalf("a refused enter changed the record: %+v", record)
	}
	if err := Create(context.Background(), registry, Creating{PlayerID: 100_001, Name: "Alice", Claims: principal.Claims}, records.steps(100_001)); err != nil {
		t.Fatal(err)
	}
	if entered, err := EnterSession(context.Background(), registry, entering, records.loads(100_001)); err != nil || !entered.First {
		t.Fatalf("enter after create: %+v, %v", entered, err)
	}
}

// 用角色会话令牌握手的会话（名字在 account 的 CreateRole 里起过）不是“先新建”的会话：告知里没有 need_create
// （也不去读档），EnterGame 照旧加载或创建。
func TestWithLoginEnterSessionTokenSessionsKeepLoadOrCreate(t *testing.T) {
	w := newLoginWorld(t)
	registry := withLoginRegistry(1000)
	records := &withLoginRecords{players: map[int64]*withLoginRecord{}}
	session := w.role("alice", 1000)
	principal, err := Authenticator{Accounts: w.service}.Authenticate(context.Background(), Ticket(session.PlayerID, session.Token))
	if err != nil {
		t.Fatal(err)
	}
	if EnterTicketSession(principal.Claims) || CreateFirst(principal.Claims) {
		t.Fatalf("a session-token session is treated as create-first: %v", principal.Claims)
	}
	entering := Entering{PlayerID: principal.PlayerID, Claims: principal.Claims}
	asked := 0
	status, refused, err := Assess(context.Background(), registry, entering, func(context.Context) (bool, error) { asked++; return false, nil })
	if err != nil || refused || status != (Status{}) || asked != 0 {
		t.Fatalf("status = %+v refused=%v err=%v, record read %d times; want enter directly without reading the record", status, refused, err, asked)
	}
	entered, err := EnterSession(context.Background(), registry, entering, records.loads(principal.PlayerID))
	if err != nil || !entered.First || !records.players[principal.PlayerID].built {
		t.Fatalf("EnterGame of a new player on a session-token session: %+v, %v; want it built by the enter", entered, err)
	}
}

// 本服不该服务的角色（票据是给 1001 服的，连到了 1000 服）：握手照样成功，告知的结论是 login_elsewhere 并要断开；
// 他在本服进入、新建都被同一条检查拒绝，什么都没建。独立 Gate 下激活通知带的是 Game Ingress 绑定时认证出来的 Principal
// （会话号是 Gate 的），结论相同。
func TestWithLoginEnterARoleOfAnotherServerIsToldToLeave(t *testing.T) {
	w := newLoginWorld(t)
	registry := withLoginRegistry(1000)
	records := &withLoginRecords{players: map[int64]*withLoginRecord{}}
	announced := withLoginAnnounce(t)
	notifier := NewNotifier()
	principal, err := Authenticator{Accounts: w.service}.Authenticate(context.Background(), w.enterHandshake("alice", 1001))
	if err != nil || principal.ServerID != 1001 {
		t.Fatalf("handshake for server 1001: %+v, %v", principal, err)
	}
	// 独立 Gate：Game Ingress 认证之后把会话号换成 Gate 的，激活通知带着这个 Principal。
	bound := principal
	bound.SessionID = "gate-session"
	notifier.SessionActive(registry, bound)
	notifier.Wait()
	if announced.calls != 1 || announced.sessionID != "gate-session" || announced.entering.Claims[svcaccount.ServerIDClaim] != "1001" {
		t.Fatalf("under an independent Gate the notice got %+v for %q (%d calls)", announced.entering, announced.sessionID, announced.calls)
	}
	entering := announced.entering
	asked := 0
	status, refused, err := Assess(context.Background(), registry, entering, func(context.Context) (bool, error) { asked++; return false, nil })
	if err != nil || !refused || status.Code != apperrors.ErrLoginElsewhere.Code() || status.NeedCreate || asked != 0 {
		t.Fatalf("status = %+v refused=%v err=%v asked=%d; want login_elsewhere, refused, the record not read", status, refused, err, asked)
	}
	if _, err := EnterSession(context.Background(), registry, entering, records.loads(principal.PlayerID)); !errors.Is(err, apperrors.ErrLoginElsewhere) {
		t.Fatalf("entering: err = %v, want login_elsewhere", err)
	}
	creating := Creating{PlayerID: principal.PlayerID, Name: "Alice", Claims: entering.Claims}
	if err := Create(context.Background(), registry, creating, records.steps(principal.PlayerID)); !errors.Is(err, apperrors.ErrLoginElsewhere) {
		t.Fatalf("creating: err = %v, want login_elsewhere", err)
	}
	if len(records.players) != 0 {
		t.Fatalf("this server built a record for a role it does not serve: %v", records.players)
	}
}

// v1.47.0：登录对进入的检查不再随 game/login 的 init 打开（见 RegisterEnterChecks），本测试包照旧要它们。
func init() { RegisterEnterChecks() }
