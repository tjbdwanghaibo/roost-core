package dbdef

// SceneDao 从开图配置重建；成员与时间域均是进程内权威，不从数据库恢复在线状态。
//
//roost:dao nocoll
type SceneDao struct {
	Members        map[int64]bool `dao:"nopersist,map=fast" store:"1"`
	Closed         bool           `dao:"nopersist" store:"2"`
	AnchorBusiness int64          `dao:"nopersist,sync" store:"3"`
	AnchorDomain   int64          `dao:"nopersist,sync" store:"4"`
	Rate           float64        `dao:"nopersist,sync" store:"5"`
	Closing        bool           `dao:"nopersist" store:"6"`
}
