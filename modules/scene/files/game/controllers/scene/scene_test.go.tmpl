type sceneCommit struct{ reject atomic.Bool }

func (c *sceneCommit) Commit(context.Context, dataengine.CommitRecord) error {
	if c.reject.Load() {
		return errors.New("scene injected commit rejection")
	}
	return nil
}

type sceneFixture struct {
	t          *testing.T
	registry   *app.Registry
	access     *entity.ManagerAccess
	engine     *nest.NestMgr
	sync       *entitysync.Manager
	manager    *scenes.Manager
	controller *Controller
	commit     *sceneCommit
}

var sceneTestPlayer = nest.NewHandlerName("module_scene.player")
var sceneTestArea = nest.NewHandlerName("module_scene.area")

func newSceneFixture(t *testing.T) *sceneFixture {
	t.Helper()
	player.RegisterEntity()
	sceneentity.RegisterEntity()
	f := &sceneFixture{t: t, access: entity.NewManagerAccess(entity.NewEntityManager()), commit: &sceneCommit{}}
	var err error
	f.sync, err = entitysync.NewManager(entitysync.ManagerConfig{Transport: entitysync.TransportFunc(func(context.Context, entitysync.SessionID, []byte) error { return nil })})
	if err != nil {
		t.Fatal(err)
	}
	f.engine = nest.NewEngine(nest.NestOptionWithGetter(f.access), nest.NestOptionWithTransactionCommitter(f.commit), nest.NestOptionWithEntitySync(f.sync),
		nest.NestOptionWithWorkerPools(nest.WorkerPoolConfig{Workers: 2, QueueCap: 64}, nest.WorkerPoolConfig{}, nest.WorkerPoolConfig{}))
	for _, register := range []func(*nest.NestMgr) error{handler.RegisterSceneChangeNestHandlersOn, handler.RegisterSceneCloseNestHandlersOn, handler.RegisterSceneTimeNestHandlersOn, handler.RegisterSceneInteractNestHandlersOn, handler.RegisterSceneDrainNestHandlersOn} {
		if err := register(f.engine); err != nil {
			t.Fatal(err)
		}
	}
	f.engine.MustRegisterHandlerWithMeta(sceneTestPlayer, func(values []entity.IThreadSafeEntity, args []any, _ ...nest.HandlerOption) (any, error) {
		return nil, args[0].(func(*player.Player) error)(values[0].(*player.Player))
	}, nest.HandlerMeta{Rollback: nest.RollbackUndo, Durability: nest.DurabilityAsync})
	f.engine.MustRegisterHandlerWithMeta(sceneTestArea, func(values []entity.IThreadSafeEntity, args []any, _ ...nest.HandlerOption) (any, error) {
		return nil, args[0].(func(*sceneentity.Scene) error)(values[0].(*sceneentity.Scene))
	}, nest.HandlerMeta{Rollback: nest.RollbackUndo, Durability: nest.DurabilityAsync})
	if err := f.engine.Start(); err != nil {
		t.Fatal(err)
	}
	registry := app.NewRegistry(viper.New())
	f.registry = registry
	for key, value := range map[app.ModName]any{mods.ModNest: f.engine, mods.ModEntityRuntime: f.access, mods.ModEntitySync: f.sync} {
		if err := registry.Register(key, value); err != nil {
			t.Fatal(err)
		}
	}
	// 与正式 access.player 一致：先构造协议控制器，再启动模块 runtime。
	f.controller, err = FromRegistry(registry)
	if err != nil {
		t.Fatal(err)
	}
	if _, err := f.controller.HandleSceneChange(&playeraccess.Context{PlayerID: 1001}, &pb.SceneChangeRequest{ToID: 1}); err == nil {
		t.Fatal("scene change accepted before runtime started")
	}
	if _, err := f.controller.HandleSceneInteract(&playeraccess.Context{PlayerID: 1001}, &pb.SceneInteractRequest{SceneID: 1, Sequence: 1}); err == nil {
		t.Fatal("scene interaction accepted before runtime started")
	}
	_, err = scenes.Start(registry)
	if err != nil {
		t.Fatal(err)
	}
	f.manager, err = scenes.FromRegistry(registry)
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := f.engine.Shutdown(context.Background()); err != nil {
			t.Error(err)
		}
		if err := f.sync.Close(context.Background()); err != nil {
			t.Error(err)
		}
		f.access.Manager().Range(func(value entity.IThreadSafeEntity) bool {
			if p, ok := value.(*player.Player); ok {
				p.ActorComp().OnDestroy(entity.DestroyReasonCommon)
			}
			value.OnDestroy(entity.DestroyReasonCommon)
			return true
		})
	})
	return f
}
func (f *sceneFixture) player(raw int64) *player.Player {
	f.t.Helper()
	value, err := f.access.Create(&entity.EntityCreateParam{IsCreate: true, UniqueID: raw, Kind: player.EntityKindPlayer})
	if err != nil {
		f.t.Fatal(err)
	}
	if err := f.sync.OpenSession(entitysync.SessionID(raw)); err != nil {
		f.t.Fatal(err)
	}
	return value.(*player.Player)
}
func (f *sceneFixture) change(p *player.Player, from, to int64) (*pb.SceneChangeResponse, error) {
	return f.controller.HandleSceneChange(&playeraccess.Context{PlayerID: p.UniqueID()}, &pb.SceneChangeRequest{FromID: from, ToID: to})
}
func (f *sceneFixture) enter(p *player.Player, id int64) {
	f.t.Helper()
	if response, err := f.change(p, 0, id); err != nil || response.Code != 0 {
		f.t.Fatalf("enter %d: %+v %v", id, response, err)
	}
}

// refusedChange / refusedInteract 断言一次业务拒绝的形状：controller 不返回 error（否则接入层会断开这条连接），
// 应答带着指定的业务码与非空的原因，不带任何成功字段。
func (f *sceneFixture) refusedChange(name string, want *errcode.IntError, response *pb.SceneChangeResponse, err error) {
	f.t.Helper()
	if err != nil {
		f.t.Fatalf("%s: controller returned an error, the access layer would close the connection: %v", name, err)
	}
	if response == nil || response.Code != want.Code() || response.Reason == "" || response.SceneID != 0 {
		f.t.Fatalf("%s: response %+v, want code %d (%s)", name, response, want.Code(), want.Name())
	}
}
func (f *sceneFixture) refusedInteract(name string, want *errcode.IntError, response *pb.SceneInteractResponse, err error) {
	f.t.Helper()
	if err != nil {
		f.t.Fatalf("%s: controller returned an error, the access layer would close the connection: %v", name, err)
	}
	if response == nil || response.Code != want.Code() || response.Reason == "" || response.Text != "" || response.Sequence != 0 {
		f.t.Fatalf("%s: response %+v, want code %d (%s)", name, response, want.Code(), want.Name())
	}
}
func (f *sceneFixture) area(raw int64) *sceneentity.Scene {
	id, _ := entity.BuildEntityID(raw, sceneentity.EntityKindScene)
	return f.access.Manager().Get(id).(*sceneentity.Scene)
}
func (f *sceneFixture) run(p *player.Player, fn func(*player.Player) error) error {
	_, err := f.engine.Request(context.Background(), sceneTestPlayer, p.ID(), nest.NewParams(fn))
	return err
}
func (f *sceneFixture) must(p *player.Player, fn func(*player.Player) error) {
	f.t.Helper()
	if err := f.run(p, fn); err != nil {
		f.t.Fatal(err)
	}
}
func (f *sceneFixture) open(id int64, config gamescene.Config) *sceneentity.Scene {
	f.t.Helper()
	area, err := f.manager.Open(id, config)
	if err != nil {
		f.t.Fatal(err)
	}
	return area
}

func TestSceneDefaultRuntimeAndPBEntry(t *testing.T) {
	f := newSceneFixture(t)
	p := f.player(1001)
	raw, err := pb.MarshalSceneChangeRequest(&pb.SceneChangeRequest{ToID: 1})
	if err != nil {
		t.Fatal(err)
	}
	request, err := pb.UnmarshalSceneChangeRequest(raw)
	if err != nil {
		t.Fatal(err)
	}
	response, err := f.controller.HandleSceneChange(&playeraccess.Context{PlayerID: p.UniqueID()}, request)
	if err != nil || response.SceneID != 1 || response.X != 50 || response.Y != 50 {
		t.Fatalf("%+v %v", response, err)
	}
}
func TestSceneSwitchChangesBothMemberships(t *testing.T) {
	f := newSceneFixture(t)
	p := f.player(1001)
	f.enter(p, 1)
	target := f.open(2, gamescene.DefaultConfig())
	if response, err := f.change(p, 1, 2); err != nil || response.Code != 0 || response.SceneID != 2 {
		t.Fatalf("%+v %v", response, err)
	}
	f.must(p, func(p *player.Player) error {
		if p.ActorComp().Body().Map.SceneID() != target.ID() {
			t.Fatal("wrong map")
		}
		return nil
	})
	if err := f.manager.Close(context.Background(), 1); err != nil {
		t.Fatal("old membership retained", err)
	}
	if err := f.manager.Close(context.Background(), 2); err == nil {
		t.Fatal("occupied target closed")
	}
}
func TestSceneRefusesStaleFromWithoutChangingPosition(t *testing.T) {
	f := newSceneFixture(t)
	p := f.player(1001)
	f.enter(p, 1)
	f.open(2, gamescene.DefaultConfig())
	response, err := f.change(p, 0, 2)
	f.refusedChange("stale from", apperrors.ErrSceneStale, response, err)
	f.must(p, func(p *player.Player) error {
		if p.ActorComp().Body().Map.SceneID() != f.area(1).ID() {
			t.Fatal("moved")
		}
		return nil
	})
	// 来源已经不是开着的图，同样是“客户端记的位置过期了”，不是目标不可用。
	response, err = f.change(p, 987, 2)
	f.refusedChange("closed from", apperrors.ErrSceneStale, response, err)
	// 拒绝之后连接还在：带上正确的 FromID 重发就成功。
	if response, err = f.change(p, 1, 2); err != nil || response.Code != 0 || response.SceneID != 2 {
		t.Fatalf("retry with the right FromID: %+v %v", response, err)
	}
}
