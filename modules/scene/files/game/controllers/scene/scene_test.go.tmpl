func TestSceneRejectedSwitchRollsBackSavedPosition(t *testing.T) {
	f := newSceneFixture(t)
	p := f.player(1001)
	f.enter(p, 1)
	f.open(2, gamescene.DefaultConfig())
	f.commit.reject.Store(true)
	_, err := f.change(p, 1, 2)
	f.commit.reject.Store(false)
	if err == nil {
		t.Fatal("commit was not rejected")
	}
	f.must(p, func(p *player.Player) error {
		id, _, _ := p.ActorComp().SavedPosition()
		if id != 0 || p.ActorComp().Body().Map.SceneID() != f.area(1).ID() {
			t.Fatal("partial switch remained")
		}
		return nil
	})
	if err := f.manager.Close(context.Background(), 2); err != nil {
		t.Fatal("target member leaked", err)
	}
}
func TestSceneNearbySubjectsUseOneAOI(t *testing.T) {
	f := newSceneFixture(t)
	a, b := f.player(1001), f.player(1002)
	f.enter(a, 1)
	f.enter(b, 1)
	if err := f.sync.Flush(context.Background()); err != nil {
		t.Fatal(err)
	}
	seen := f.area(1).Space().Nearby(a.UniqueID())
	if !slices.Contains(seen, b.ID()) || slices.Contains(seen, a.ID()) || !slices.Contains(seen, f.area(1).ID()) {
		t.Fatalf("seen %v", seen)
	}
}
