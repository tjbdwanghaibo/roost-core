var sceneRegionReject atomic.Bool

// sceneRegionCoded 让区域回调返回一个带业务码的拒绝（借用模块自己的码，测试不另外申请号）。
var sceneRegionCoded atomic.Bool

func init() {
	scenecomp.OnRegion("scene_test", func(_ view.PlayerEntity, event gamescene.RegionEvent) error {
		if event.ID == 33 && sceneRegionCoded.Load() {
			return apperrors.ErrSceneObjectFar
		}
		if event.ID == 33 && sceneRegionReject.Load() {
			return errors.New("reject region")
		}
		return nil
	})
	scenecomp.OnSceneInteract("scene_test", func(p view.PlayerEntity, object gamescene.Object) error {
		if object.ID == 71 {
			s := p.Dao().GetActorSaved()
			s.SetFacing(s.GetFacing() + 1)
		}
		return nil
	})
}
func sceneObjects() gamescene.Config {
	c := gamescene.DefaultConfig()
	c.Regions = []gamescene.Region{{ID: 33, Bounds: spatial.Rect{Min: spatial.Point{X: 40, Y: 40}, Max: spatial.Point{X: 60, Y: 60}}}}
	c.Objects = []gamescene.Object{{ID: 71, Position: c.Spawn, Radius: 10, Text: "well"}}
	return c
}
func TestSceneRegionEntryAndExitAreDerivedFromPosition(t *testing.T) {
	f := newSceneFixture(t)
	p := f.player(1001)
	f.open(2, sceneObjects())
	f.enter(p, 2)
	f.must(p, func(p *player.Player) error {
		if p.Dao().GetSceneRuntime().RegionsLen() != 1 {
			t.Fatal("enter region missing")
		}
		if err := p.ActorComp().Body().Map.SetPos(spatial.Point{X: 100, Y: 100}); err != nil {
			return err
		}
		return p.ActorComp().Body().Tick(heartbeat.Beat{Now: time.Now(), Elapsed: time.Millisecond})
	})
	f.must(p, func(p *player.Player) error {
		if p.Dao().GetSceneRuntime().RegionsLen() != 0 {
			t.Fatal("leave region missing")
		}
		return nil
	})
}
func TestSceneRegionFailureRollsBackTheEntry(t *testing.T) {
	f := newSceneFixture(t)
	p := f.player(1001)
	f.open(2, sceneObjects())
	sceneRegionReject.Store(true)
	t.Cleanup(func() { sceneRegionReject.Store(false) })
	// 回调返回的是不带码的错误：按内部错误处理，controller 返回 error。
	if response, err := f.change(p, 0, 2); err == nil || response != nil {
		t.Fatalf("region rejection ignored: %+v %v", response, err)
	}
	f.must(p, func(p *player.Player) error {
		if p.ActorComp().Body().Map.InScene() || p.Dao().GetSceneRuntime().RegionsLen() != 0 {
			t.Fatal("partial entry")
		}
		return nil
	})
	if err := f.manager.Close(context.Background(), 2); err != nil {
		t.Fatal("failed entry occupied scene", err)
	}
}
func TestSceneCodedCallbackRefusalIsAnsweredAndRolledBack(t *testing.T) {
	f := newSceneFixture(t)
	p := f.player(1001)
	f.open(2, sceneObjects())
	sceneRegionCoded.Store(true)
	t.Cleanup(func() { sceneRegionCoded.Store(false) })
	// 登记的回调用带码的错误拒绝：与模块自己的拒绝一样答在应答里，这次进入整笔撤销。
	response, err := f.change(p, 0, 2)
	f.refusedChange("coded region refusal", apperrors.ErrSceneObjectFar, response, err)
	f.must(p, func(p *player.Player) error {
		if p.ActorComp().Body().Map.InScene() || p.Dao().GetSceneRuntime().RegionsLen() != 0 {
			t.Fatal("partial entry")
		}
		return nil
	})
	sceneRegionCoded.Store(false)
	if response, err = f.change(p, 0, 2); err != nil || response.Code != 0 || response.SceneID != 2 {
		t.Fatalf("entry after the refusal: %+v %v", response, err)
	}
}
func TestSceneRefusalCodesAreDistinctBusinessCodes(t *testing.T) {
	seen := map[int32]string{}
	for _, def := range []*errcode.IntError{apperrors.ErrSceneUnavailable, apperrors.ErrSceneFull, apperrors.ErrSceneStale, apperrors.ErrSceneNotHere, apperrors.ErrSceneObjectUnknown, apperrors.ErrSceneObjectFar, apperrors.ErrSceneSequence} {
		code, reason := errcode.ClientError(def)
		if code <= errcode.FrameworkCodeLast || reason == "" {
			t.Fatalf("%s: code %d reason %q is not a business refusal", def.Name(), code, reason)
		}
		if _, _, ok := refusal(def); !ok {
			t.Fatalf("%s would be returned as an error", def.Name())
		}
		if prior := seen[code]; prior != "" {
			t.Fatalf("%s and %s share code %d", def.Name(), prior, code)
		}
		seen[code] = def.Name()
	}
	// 框架码（没进入游戏、可重试……）同样答在应答里；只有不带码的才算内部错误。
	if _, _, ok := refusal(errcode.ErrEntityNotFound); !ok {
		t.Fatal("a framework-coded refusal would close the connection")
	}
	if code, _, ok := refusal(errors.New("anything without a code")); ok || code != errcode.CodeInternal {
		t.Fatal("an uncoded error was answered as a business refusal")
	}
}
func TestSceneInteractionIsOncePerContinuousSequence(t *testing.T) {
	f := newSceneFixture(t)
	p := f.player(1001)
	f.open(2, sceneObjects())
	f.enter(p, 2)
	request := &pb.SceneInteractRequest{SceneID: 2, ObjectID: 71, Sequence: 1}
	ctx := &playeraccess.Context{PlayerID: p.UniqueID()}
	a, err := f.controller.HandleSceneInteract(ctx, request)
	if err != nil || a == nil || a.Code != 0 || a.Text != "well" {
		t.Fatalf("%+v %v", a, err)
	}
	b, err := f.controller.HandleSceneInteract(ctx, request)
	if err != nil || b == nil || b.Code != 0 || b.Text != "well" {
		t.Fatalf("replayed interaction refused: response=%+v err=%v", b, err)
	}
	f.must(p, func(p *player.Player) error {
		if p.Dao().GetActorSaved().GetFacing() != 1 {
			t.Fatal("replayed interaction ran twice")
		}
		return nil
	})
	request.ObjectID = 72
	response, err := f.controller.HandleSceneInteract(ctx, request)
	f.refusedInteract("same sequence, other object", apperrors.ErrSceneSequence, response, err)
	request.ObjectID = 71
	request.Sequence = 3
	response, err = f.controller.HandleSceneInteract(ctx, request)
	f.refusedInteract("sequence gap", apperrors.ErrSceneSequence, response, err)
	request.Sequence = 0
	response, err = f.controller.HandleSceneInteract(ctx, request)
	f.refusedInteract("zero sequence", apperrors.ErrSceneSequence, response, err)
	// 被拒的序号没有被消耗：同一条连接上发正确的下一个序号成功，回调只多跑一次。
	request.Sequence = 2
	if response, err = f.controller.HandleSceneInteract(ctx, request); err != nil || response.Code != 0 || response.Sequence != 2 || response.Text != "well" {
		t.Fatalf("next sequence after refusals: %+v %v", response, err)
	}
	f.must(p, func(p *player.Player) error {
		if p.Dao().GetActorSaved().GetFacing() != 2 || p.Dao().GetSceneInteraction().GetSequence() != 2 {
			t.Fatal("refused interactions changed state")
		}
		return nil
	})
}
func TestSceneInteractionCannotReachAnotherSceneOrDistantObject(t *testing.T) {
	f := newSceneFixture(t)
	p := f.player(1001)
	f.open(2, sceneObjects())
	f.enter(p, 1)
	request := &pb.SceneInteractRequest{SceneID: 2, ObjectID: 71, Sequence: 1}
	ctx := &playeraccess.Context{PlayerID: p.UniqueID()}
	response, err := f.controller.HandleSceneInteract(ctx, request)
	f.refusedInteract("cross scene", apperrors.ErrSceneNotHere, response, err)
	response, err = f.controller.HandleSceneInteract(ctx, &pb.SceneInteractRequest{SceneID: 987, ObjectID: 71, Sequence: 1})
	f.refusedInteract("scene that is not open", apperrors.ErrSceneUnavailable, response, err)
	response, err = f.controller.HandleSceneInteract(ctx, &pb.SceneInteractRequest{ObjectID: 71, Sequence: 1})
	f.refusedInteract("zero scene id", apperrors.ErrSceneNotHere, response, err)
	if response, err := f.change(p, 1, 2); err != nil || response.Code != 0 {
		t.Fatalf("%+v %v", response, err)
	}
	response, err = f.controller.HandleSceneInteract(ctx, &pb.SceneInteractRequest{SceneID: 2, ObjectID: 72, Sequence: 1})
	f.refusedInteract("unknown object", apperrors.ErrSceneObjectUnknown, response, err)
	f.must(p, func(p *player.Player) error { return p.ActorComp().Body().Map.SetPos(spatial.Point{X: 500, Y: 500}) })
	response, err = f.controller.HandleSceneInteract(ctx, request)
	f.refusedInteract("out of range", apperrors.ErrSceneObjectFar, response, err)
	// 走回对象旁边，同一个序号、同一条连接上重试成功；之前的拒绝都没有记账。
	f.must(p, func(p *player.Player) error { return p.ActorComp().Body().Map.SetPos(spatial.Point{X: 50, Y: 50}) })
	if response, err = f.controller.HandleSceneInteract(ctx, request); err != nil || response.Code != 0 || response.Sequence != 1 || response.Text != "well" {
		t.Fatalf("retry in range: %+v %v", response, err)
	}
}
func TestSceneSensingOnlySeesCommittedPositions(t *testing.T) {
	f := newSceneFixture(t)
	p := f.player(1001)
	f.enter(p, 1)
	space := f.area(1).Space()
	if found := space.Sense(spatial.Point{X: 50, Y: 50}, 20); len(found) != 1 || found[0].ID != p.ID() {
		t.Fatal(found)
	}
	failure := errors.New("abort")
	if err := f.run(p, func(p *player.Player) error {
		if err := p.ActorComp().Body().Map.SetPos(spatial.Point{X: 500, Y: 500}); err != nil {
			return err
		}
		return failure
	}); !errors.Is(err, failure) {
		t.Fatal(err)
	}
	if found := space.Sense(spatial.Point{X: 50, Y: 50}, 20); len(found) != 1 {
		t.Fatal("rollback changed sensing", found)
	}
	f.must(p, func(p *player.Player) error { return p.ActorComp().Body().Map.SetPos(spatial.Point{X: 500, Y: 500}) })
	if found := space.Sense(spatial.Point{X: 50, Y: 50}, 20); len(found) != 0 {
		t.Fatal("old position retained", found)
	}
}

var sceneStopReject atomic.Bool

func init() {
	gameactor.OnActor("scene.stop_test", func(view.PlayerEntity) actor.Hooks {
		return actor.Hooks{Leave: func(*actor.Body) error {
			if sceneStopReject.Load() {
				return errors.New("reject evacuation")
			}
			return nil
		}}
	})
}
func TestSceneStopEvacuatesAndClosesAdmission(t *testing.T) {
	f := newSceneFixture(t)
	p := f.player(1001)
	f.enter(p, 1)
	if err := f.manager.Stop(context.Background()); err != nil {
		t.Fatal(err)
	}
	f.must(p, func(p *player.Player) error {
		if p.ActorComp().Body().Map.InScene() {
			t.Fatal("player not evacuated")
		}
		return nil
	})
	if _, _, err := f.manager.IDs(0, 1); err == nil {
		t.Fatal("closed map remained")
	}
	if _, err := f.manager.Open(2, gamescene.DefaultConfig()); err == nil {
		t.Fatal("stop reopened admission")
	}
	if err := f.manager.Stop(context.Background()); err != nil {
		t.Fatal(err)
	}
}
func TestSceneStopRetriesRejectedEvacuation(t *testing.T) {
	f := newSceneFixture(t)
	p := f.player(1001)
	f.enter(p, 1)
	sceneStopReject.Store(true)
	t.Cleanup(func() { sceneStopReject.Store(false) })
	if err := f.manager.Stop(context.Background()); err == nil {
		t.Fatal("evacuation rejection ignored")
	}
	sceneStopReject.Store(false)
	f.must(p, func(p *player.Player) error {
		if !p.ActorComp().Body().Map.InScene() {
			t.Fatal("failed evacuation changed player")
		}
		return nil
	})
	fresh := f.player(1002)
	if _, err := sender.NewSceneChangeSender(f.engine).MultiGroupSync_SceneChange(context.Background(), fresh.ID(), []int64{f.area(1).ID()}, f.area(1).ID()); !errors.Is(err, apperrors.ErrSceneUnavailable) {
		t.Fatal("closing map admitted player", err)
	}
	// 客户端入口在停机期间同样是带码拒绝，不是断开。
	response, err := f.change(fresh, 0, 1)
	f.refusedChange("closing map", apperrors.ErrSceneUnavailable, response, err)
	if err := f.manager.Stop(context.Background()); err != nil {
		t.Fatal("retry failed", err)
	}
}
func TestScenePrunesUnloadedMembersAndTheirVisibility(t *testing.T) {
	f := newSceneFixture(t)
	c := gamescene.DefaultConfig()
	c.Capacity = 1
	area := f.open(2, c)
	old := f.player(1001)
	f.enter(old, 2)
	if err := f.access.Destroy(context.Background(), old, entity.DestroyReasonCommon, false); err != nil {
		t.Fatal(err)
	}
	fresh := f.player(1002)
	f.enter(fresh, 2)
	found := area.Space().Sense(c.Spawn, c.Sight)
	if len(found) != 1 || found[0].ID != fresh.ID() {
		t.Fatalf("unloaded actor retained: %+v", found)
	}
	if err := f.manager.Stop(context.Background()); err != nil {
		t.Fatal("stale member prevented stop", err)
	}
}
func TestSceneStopPreservesDependentMembersForRetry(t *testing.T) {
	f := newSceneFixture(t)
	area := f.area(1)
	other := f.open(2, gamescene.DefaultConfig())
	_, err := f.engine.Request(context.Background(), sceneTestArea, area.ID(), nest.NewParams(func(s *sceneentity.Scene) error { return s.Admit(other.ID()) }))
	if err != nil {
		t.Fatal(err)
	}
	_, err = f.engine.Request(context.Background(), sceneTestArea, other.ID(), nest.NewParams(func(s *sceneentity.Scene) error { return s.Admit(other.ID()) }))
	if err != nil {
		t.Fatal(err)
	}
	// 用独立 Scene 实体模拟还未停止的依赖模块；它必须留下而不能被当成 Player 强制驱逐。
	if err := f.manager.Stop(context.Background()); err == nil {
		t.Fatal("dependent member silently discarded")
	}
	if f.access.Manager().Get(area.ID()) == nil {
		t.Fatal("occupied scene destroyed")
	}
	for _, s := range []*sceneentity.Scene{area, other} {
		_, err = f.engine.Request(context.Background(), sceneTestArea, s.ID(), nest.NewParams(func(s *sceneentity.Scene) error { s.Depart(other.ID()); return nil }))
		if err != nil {
			t.Fatal(err)
		}
	}
	if err := f.manager.Stop(context.Background()); err != nil {
		t.Fatal("dependent cleanup retry failed", err)
	}
}

func TestSceneDrainOnlyClosesTheRequestedMap(t *testing.T) {
	f := newSceneFixture(t)
	a, b := f.player(1001), f.player(1002)
	f.open(2, gamescene.DefaultConfig())
	f.enter(a, 1)
	f.enter(b, 2)
	if err := f.manager.Drain(context.Background(), 2); err != nil {
		t.Fatal(err)
	}
	f.must(b, func(p *player.Player) error {
		if p.ActorComp().Body().Map.InScene() {
			return errors.New("drained player stayed")
		}
		return nil
	})
	f.must(a, func(p *player.Player) error {
		if !p.ActorComp().Body().Map.InScene() {
			return errors.New("unrelated player evacuated")
		}
		return nil
	})
	if response, err := f.change(f.player(1003), 0, 1); err != nil || response.Code != 0 {
		t.Fatal("unrelated map closed", response, err)
	}
	f.open(3, gamescene.DefaultConfig())
	if err := f.manager.Drain(context.Background(), 2); err != nil {
		t.Fatal("repeat drain", err)
	}
}
