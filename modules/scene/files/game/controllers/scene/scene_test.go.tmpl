func TestSceneCapacityRejectsWithoutEvictingSource(t *testing.T) {
	f := newSceneFixture(t)
	a, b := f.player(1001), f.player(1002)
	c := gamescene.DefaultConfig()
	c.Capacity = 1
	f.open(2, c)
	f.enter(a, 1)
	f.enter(b, 2)
	response, err := f.change(a, 1, 2)
	f.refusedChange("full target", apperrors.ErrSceneFull, response, err)
	f.must(a, func(p *player.Player) error {
		if p.ActorComp().Body().Map.SceneID() != f.area(1).ID() {
			t.Fatal("lost original scene")
		}
		return nil
	})
	// 满员的那张图空出来之后，同一条连接上的重试成功。
	if response, err = f.change(b, 2, 0); err != nil || response.Code != 0 {
		t.Fatalf("%+v %v", response, err)
	}
	if response, err = f.change(a, 1, 2); err != nil || response.Code != 0 || response.SceneID != 2 {
		t.Fatalf("retry after a slot opened: %+v %v", response, err)
	}
}
func TestSceneRejectedSwitchRollsBackSavedPosition(t *testing.T) {
	f := newSceneFixture(t)
	p := f.player(1001)
	f.enter(p, 1)
	f.open(2, gamescene.DefaultConfig())
	f.commit.reject.Store(true)
	response, err := f.change(p, 1, 2)
	f.commit.reject.Store(false)
	// 提交被拒不是业务拒绝：不带码，controller 仍把它作为 error 返回。
	if err == nil || response != nil {
		t.Fatalf("commit was not rejected: %+v %v", response, err)
	}
	f.must(p, func(p *player.Player) error {
		id, _, _ := p.ActorComp().SavedPosition()
		if id != 0 || p.ActorComp().Body().Map.SceneID() != f.area(1).ID() {
			t.Fatal("partial switch remained")
		}
		return nil
	})
	if err := f.manager.Close(context.Background(), 2); err != nil {
		t.Fatal("target member leaked", err)
	}
}
func TestSceneNearbySubjectsUseOneAOI(t *testing.T) {
	f := newSceneFixture(t)
	a, b := f.player(1001), f.player(1002)
	f.enter(a, 1)
	f.enter(b, 1)
	if err := f.sync.Flush(context.Background()); err != nil {
		t.Fatal(err)
	}
	seen := f.area(1).Space().Nearby(a.UniqueID())
