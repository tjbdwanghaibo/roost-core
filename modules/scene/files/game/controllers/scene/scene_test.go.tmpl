func TestSceneMovementChangesInterestAfterCommit(t *testing.T) {
	f := newSceneFixture(t)
	a, b := f.player(1001), f.player(1002)
	f.enter(a, 1)
	f.enter(b, 1)
	f.must(b, func(p *player.Player) error {
		body := p.ActorComp().Body()
		if err := body.Walk([]spatial.Point{{X: 500, Y: 50}}, 1000); err != nil {
			return err
		}
		return body.Tick(heartbeat.Beat{Now: time.Now().Add(time.Second), Elapsed: time.Second})
	})
	// 域时间读取冻结业务时间；直接改位置也走同一个 commit-gated QueueMove。
	f.must(b, func(p *player.Player) error { return p.ActorComp().Body().Map.SetPos(spatial.Point{X: 500, Y: 50}) })
	if err := f.sync.Flush(context.Background()); err != nil {
		t.Fatal(err)
	}
	if slices.Contains(f.area(1).Space().Nearby(a.UniqueID()), b.ID()) {
		t.Fatal("distant actor still visible")
	}
}
func TestSceneRollbackDoesNotMoveAOI(t *testing.T) {
	f := newSceneFixture(t)
	a, b := f.player(1001), f.player(1002)
	f.enter(a, 1)
	f.enter(b, 1)
	failure := errors.New("abort move")
	if err := f.run(b, func(p *player.Player) error {
		if err := p.ActorComp().Body().Map.SetPos(spatial.Point{X: 500, Y: 50}); err != nil {
			return err
		}
		return failure
	}); !errors.Is(err, failure) {
		t.Fatal(err)
	}
	if err := f.sync.Flush(context.Background()); err != nil {
		t.Fatal(err)
	}
	if !slices.Contains(f.area(1).Space().Nearby(a.UniqueID()), b.ID()) {
		t.Fatal("uncommitted movement leaked")
	}
}
