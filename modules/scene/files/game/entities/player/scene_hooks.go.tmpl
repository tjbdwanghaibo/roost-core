package player

import (
	"fmt"
	"github.com/tjbdwanghaibo/roost-core/gameplay/heartbeat"
	"slices"
	"{{MODULE}}/game/actor"
	gamescene "{{MODULE}}/game/scene"
)

// OnRegion 只在 init 登记。回调在玩家同一 Nest 事务内，适合向 task 上报可信的进入/离开事件。
// 返回错误会撤销这一拍位置、区域列表和奖励；不能发 RPC 或取得其他实体锁。
var regionHandlers = map[string]func(*Player, gamescene.RegionEvent) error{}

func OnRegion(name string, handler func(*Player, gamescene.RegionEvent) error) {
	if name == "" || handler == nil || regionHandlers[name] != nil {
		panic("scene: duplicate/empty region handler")
	}
	regionHandlers[name] = handler
}

// OnSceneInteract 同样只在 init 登记；仅在位置、场景与请求序号都通过后触发一次。
var interactionHandlers = map[string]func(*Player, gamescene.Object) error{}

func OnSceneInteract(name string, handler func(*Player, gamescene.Object) error) {
	if name == "" || handler == nil || interactionHandlers[name] != nil {
		panic("scene: duplicate/empty interaction handler")
	}
	interactionHandlers[name] = handler
}

func init() {
	OnActor("scene.regions", func(owner *Player) actor.Hooks {
		return actor.Hooks{
			Enter:     func(body *actor.Body) error { return owner.updateRegions(body, false) },
			Leave:     func(body *actor.Body) error { return owner.updateRegions(body, true) },
			AfterTick: func(body *actor.Body, _ heartbeat.Beat) error { return owner.updateRegions(body, false) },
		}
	})
}
func (p *Player) updateRegions(body *actor.Body, leaving bool) error {
	space, ok := body.Environment().Space.(*gamescene.Space)
	if !ok {
		return nil
	}
	var next []int64
	if !leaving {
		next = space.RegionsAt(body.Position())
	}
	slices.Sort(next)
	state := p.Dao().GetSceneRuntime()
	var old []int64
	state.RangeRegions(func(_ int, id int64) bool { old = append(old, id); return true })
	if slices.Equal(old, next) {
		return nil
	}
	state.SetRegions(next)
	names := make([]string, 0, len(regionHandlers))
	for name := range regionHandlers {
		names = append(names, name)
	}
	slices.Sort(names)
	var events []gamescene.RegionEvent
	for _, id := range old {
		if !slices.Contains(next, id) {
			events = append(events, gamescene.RegionEvent{ID: id})
		}
	}
	for _, id := range next {
		if !slices.Contains(old, id) {
			events = append(events, gamescene.RegionEvent{ID: id, Entered: true})
		}
	}
	for _, event := range events {
		for _, name := range names {
			if err := regionHandlers[name](p, event); err != nil {
				return fmt.Errorf("scene region %d: %w", event.ID, err)
			}
		}
	}
	return nil
}

func (p *Player) InteractObject(object gamescene.Object) error {
	names := make([]string, 0, len(interactionHandlers))
	for name := range interactionHandlers {
		names = append(names, name)
	}
	slices.Sort(names)
	for _, name := range names {
		if err := interactionHandlers[name](p, object); err != nil {
			return err
		}
	}
	return nil
}
