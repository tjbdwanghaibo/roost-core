package handler

import "{{MODULE}}/game/view"

//roost:nest rollback=undo durability=async
func handlerSceneBeginClosing(target view.ISceneMembersEntity) []int64 {
	return target.SceneMembers().BeginClosing()
}

// handlerSceneEvacuate 仅供停机入口。若角色已卸载重建且不再此图，仍能清掉旧进场账本。
//
//roost:nest rollback=undo durability=async
func handlerSceneEvacuate(target view.IActorEntity, area view.ISceneMembersEntity) error {
	body := target.Actor().Body()
	if body.Map.SceneID() == area.ID() {
		if err := body.Leave(); err != nil {
			return err
		}
	}
	area.SceneMembers().Depart(target.ID())
	return nil
}
