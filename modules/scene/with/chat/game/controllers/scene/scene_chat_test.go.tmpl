type sceneChatTransport struct {
	online map[int64]bool
	got    map[int64][]pb.ChatMessagePush
}

func (s *sceneChatTransport) ActiveSessions(id int64) int {
	if s.online[id] {
		return 1
	}
	return 0
}
func (s *sceneChatTransport) PushPlayer(_ context.Context, id int64, _ uint32, value any) error {
	s.got[id] = append(s.got[id], *value.(*pb.ChatMessagePush))
	return nil
}

type sceneChatRemote struct {
	svcchat.Messaging
	calls int
}

func (s *sceneChatRemote) Publish(context.Context, svcchat.Sender, svcchat.PublishRequest) (svcchat.Message, error) {
	s.calls++
	return svcchat.Message{}, fmt.Errorf("nearby must not persist")
}
func newSceneChat(t *testing.T) (*sceneFixture, *chatcontroller.Controller, *sceneChatTransport, *sceneChatRemote) {
	handler.RegisterSceneChatNestHandlers()
	f := newSceneFixture(t)
	transport := &sceneChatTransport{online: map[int64]bool{}, got: map[int64][]pb.ChatMessagePush{}}
	remote := &sceneChatRemote{}
	if err := f.registry.Register(svcchat.CapabilityName, svcchat.Messaging(remote)); err != nil {
		t.Fatal(err)
	}
	if err := f.registry.Register(app.ModName("access.player.tcp"), transport); err != nil {
		t.Fatal(err)
	}
	c, err := chatcontroller.FromRegistry(f.registry)
	if err != nil {
		t.Fatal(err)
	}
	return f, c, transport, remote
}
func sendNearby(t *testing.T, c *chatcontroller.Controller, p *player.Player) *pb.ChatSendResponse {
	t.Helper()
	response, err := c.HandleChatSend(&playeraccess.Context{PlayerID: p.UniqueID()}, &pb.ChatSendRequest{Kind: "nearby", Text: "hello"})
	if err != nil {
		t.Fatal(err)
	}
	return response
}
func TestWithSceneChatPushesOnlyNearbyPlayers(t *testing.T) {
	f, c, transport, remote := newSceneChat(t)
	a, b, d := f.player(1001), f.player(1002), f.player(1003)
	for _, p := range []*player.Player{a, b, d} {
		f.enter(p, 1)
		transport.online[p.UniqueID()] = true
	}
	f.must(d, func(p *player.Player) error { return p.ActorComp().Body().Map.SetPos(spatial.Point{X: 500, Y: 500}) })
	response := sendNearby(t, c, a)
	if response.Code != 0 || response.Seq != 0 || len(transport.got[a.UniqueID()]) != 1 || len(transport.got[b.UniqueID()]) != 1 || len(transport.got[d.UniqueID()]) != 0 || remote.calls != 0 {
		t.Fatal("nearby recipients or durability wrong", response, transport.got, remote.calls)
	}
	push := transport.got[b.UniqueID()][0]
	if push.FromID != a.UniqueID() || push.Kind != "nearby" || push.Target != 1 || push.Seq != 0 {
		t.Fatal(push)
	}
}
func TestWithSceneChatDoesNotCrossLines(t *testing.T) {
	f, c, transport, _ := newSceneChat(t)
	a, b := f.player(1001), f.player(1002)
	config := gamescene.DefaultConfig()
	config.Line = 2
	f.open(2, config)
	f.enter(a, 1)
	f.enter(b, 2)
	transport.online[a.UniqueID()] = true
	transport.online[b.UniqueID()] = true
	if response := sendNearby(t, c, a); response.Code != 0 {
		t.Fatal(response)
	}
	if len(transport.got[b.UniqueID()]) != 0 {
		t.Fatal("nearby crossed scene")
	}
}
func TestWithSceneChatRequiresSceneAndLocalConnection(t *testing.T) {
	f, c, transport, _ := newSceneChat(t)
	a := f.player(1001)
	transport.online[a.UniqueID()] = true
	// 不在任何场景里是正常拒绝：答 scene 的业务码，不是内部错误。
	if response := sendNearby(t, c, a); response.Code != apperrors.ErrSceneNotHere.Code() || response.Reason == "" {
		t.Fatal("outside scene accepted or answered without the scene code", response)
	}
	f.enter(a, 1)
	delete(transport.online, a.UniqueID())
	if response := sendNearby(t, c, a); response.Code == 0 {
		t.Fatal("offline sender accepted")
	}
	if len(transport.got) != 0 {
		t.Fatal("rejected message delivered")
	}
}
func TestWithSceneChatRejectsChosenTargetsAndHistory(t *testing.T) {
	f, c, transport, remote := newSceneChat(t)
	a := f.player(1001)
	f.enter(a, 1)
	transport.online[a.UniqueID()] = true
	ctx := &playeraccess.Context{PlayerID: a.UniqueID()}
	response, err := c.HandleChatSend(ctx, &pb.ChatSendRequest{Kind: "nearby", Target: 99, Text: "hello"})
	if err != nil || response.Code == 0 {
		t.Fatal("chosen target accepted", response, err)
	}
	history, err := c.HandleChatHistory(ctx, &pb.ChatHistoryRequest{Kind: "nearby"})
	if err != nil || history.Code == 0 || remote.calls != 0 || len(transport.got) != 0 {
		t.Fatal("nearby retained history", history, err)
	}
}
func TestWithSceneChatSkipsDisconnectedRecipients(t *testing.T) {
	f, c, transport, _ := newSceneChat(t)
	a, b := f.player(1001), f.player(1002)
	f.enter(a, 1)
	f.enter(b, 1)
	transport.online[a.UniqueID()] = true
	if response := sendNearby(t, c, a); response.Code != 0 {
		t.Fatal(response)
	}
	if len(transport.got[a.UniqueID()]) != 1 || len(transport.got[b.UniqueID()]) != 0 {
		t.Fatal("offline recipient pushed", transport.got)
	}
}
