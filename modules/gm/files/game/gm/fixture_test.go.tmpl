// 离线替身只替换目标仓库与提交器；命令、生成 Sender、实体锁和回滚使用真实 Nest。
type gmGetter map[int64]entity.IThreadSafeEntity

func (g gmGetter) Get(_ context.Context, id int64, _ entity.EntityCategory) (entity.IThreadSafeEntity, error) {
	if value := g[id]; value != nil {
		return value, nil
	}
	return nil, fmt.Errorf("missing entity %d", id)
}
func (g gmGetter) GetMany(ctx context.Context, ids []int64, categories []entity.EntityCategory) ([]entity.IThreadSafeEntity, error) {
	values := make([]entity.IThreadSafeEntity, len(ids))
	for i, id := range ids {
		value, err := g.Get(ctx, id, categories[i])
		if err != nil {
			return nil, err
		}
		values[i] = value
	}
	return values, nil
}

type gmCommitter struct {
	reject  atomic.Bool
	commits atomic.Int64
}

func (c *gmCommitter) Commit(context.Context, dataengine.CommitRecord) error {
	if c.reject.Load() {
		return fmt.Errorf("injected commit rejection")
	}
	c.commits.Add(1)
	return nil
}

type gmFixture struct {
	engine    *nest.NestMgr
	registry  *app.Registry
	commands  *admin.Registry
	committer *gmCommitter
}

func newGMFixture(t *testing.T, target entity.IThreadSafeEntity) *gmFixture {
	t.Helper()
	f := &gmFixture{committer: &gmCommitter{}}
	f.engine = nest.NewEngine(nest.NestOptionWithGetter(gmGetter{target.ID(): target}), nest.NestOptionWithTransactionCommitter(f.committer), nest.NestOptionWithWorkerPools(nest.WorkerPoolConfig{Workers: 2, QueueCap: 64}, nest.WorkerPoolConfig{}, nest.WorkerPoolConfig{}))
	if err := f.engine.Start(); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := f.engine.Shutdown(context.Background()); err != nil {
			t.Error(err)
		}
	})
	f.registry = app.NewRegistry(viper.New())
	if err := f.registry.Register(app.ModName("nest"), nest.Client(f.engine)); err != nil {
		t.Fatal(err)
	}
	stop, err := Start(f.registry)
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := stop(context.Background()); err != nil {
			t.Error(err)
		}
	})
	f.commands, _ = app.Lookup[*admin.Registry](f.registry, app.ModAdmin)
	return f
}
func (f *gmFixture) execute(name, payload string) (admin.Result, error) {
	return f.commands.Execute(context.Background(), admin.Command{Name: name, Operator: "tester", Payload: []byte(payload)})
}
func (f *gmFixture) read(t *testing.T, target entity.IThreadSafeEntity, read func()) {
	t.Helper()
	if err := f.engine.RunLocal(context.Background(), func() { target.GetMutex().Lock(); defer target.GetMutex().Unlock(); read() }); err != nil {
		t.Fatal(err)
	}
}

// gmAuditLog 把进程日志改写到内存里，供场景读 gm 这一层的审计记录（执行前 "gm: executing"、执行后 "gm: completed"）。
// 本包的场景不并行；结束时还原全局 logger。联动（with/gm）的场景也用它。
type gmAuditLog struct {
	mu     sync.Mutex
	buffer bytes.Buffer
}

func (l *gmAuditLog) Write(p []byte) (int, error) {
	l.mu.Lock()
	defer l.mu.Unlock()
	return l.buffer.Write(p)
}
func captureGMAudit(t *testing.T) *gmAuditLog {
	t.Helper()
	l := &gmAuditLog{}
	previous := slog.Default()
	slog.SetDefault(slog.New(slog.NewJSONHandler(l, &slog.HandlerOptions{Level: slog.LevelInfo})))
	t.Cleanup(func() { slog.SetDefault(previous) })
	return l
}

// records 取某个 trace_id 下指定 msg 的日志，按写入顺序。
func (l *gmAuditLog) records(t *testing.T, message, trace string) []map[string]any {
	t.Helper()
	l.mu.Lock()
	text := l.buffer.String()
	l.mu.Unlock()
	var matched []map[string]any
	for _, line := range strings.Split(strings.TrimSpace(text), "\n") {
		if line == "" {
			continue
		}
		record := map[string]any{}
		if err := json.Unmarshal([]byte(line), &record); err != nil {
			t.Fatalf("log line %q: %v", line, err)
		}
		if record["msg"] == message && record["trace_id"] == trace {
			matched = append(matched, record)
		}
	}
	return matched
}
