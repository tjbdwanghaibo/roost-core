func TestGMAuditedCommandExecutes(t *testing.T) {
	_, commands, calls := gmTestRuntime(t)
	result, err := commands.Execute(context.Background(), gmTestCommand(`{"note":"restore missing reward"}`))
	if err != nil || !result.OK || *calls != 1 || result.TraceID != "audit-1" {
		t.Fatalf("result=%+v err=%v calls=%d", result, err, *calls)
