func TestGMProductionRefusesDevToken(t *testing.T) {
	config := viper.New()
	config.Set("env", "production")
	config.Set("ops.enabled", true)
	config.Set("ops.admin_enabled", true)
	config.Set("ops.admin_token", "dev-gm-test")
	config.Set("ops.allow_dev_token", true)
	if err := ops.NewOpsMod().Init(config); err == nil {
		t.Fatal("production accepted dev token")
	}
}

func TestGMReplacePreservesAudit(t *testing.T) {
	saved := definitions
	definitions = map[string]Definition{}
	defer func() { definitions = saved }()
	calls := 0
	def := Definition{Name: "gm.replace", Handler: func(context.Context, *app.Registry, admin.Command) (admin.Result, error) {
		calls++
		return admin.Result{}, nil
	}}
	Register(def)
	registry := app.NewRegistry(viper.New())
	stop, err := Start(registry)
	if err != nil {
		t.Fatal(err)
	}
	defer stop(context.Background())
	def.Handler = func(context.Context, *app.Registry, admin.Command) (admin.Result, error) {
		calls += 10
		return admin.Result{}, nil
	}
	if err := Replace(registry, def); err != nil {
		t.Fatal(err)
	}
	commands, _ := app.Lookup[*admin.Registry](registry, app.ModAdmin)
	cmd := gmTestCommand(`{"note":"override"}`)
	cmd.Name = "gm.replace"
	cmd.Operator = ""
	if _, err := commands.Execute(context.Background(), cmd); err == nil || calls != 0 {
		t.Fatalf("audit bypass: %v %d", err, calls)
	}
	cmd.Operator = "tester"
	if _, err := commands.Execute(context.Background(), cmd); err != nil || calls != 10 {
		t.Fatalf("override: %v %d", err, calls)
	}
}
