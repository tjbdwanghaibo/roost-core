func gmTestCommand(payload string) admin.Command {
	return admin.Command{Name: "gm.test", Operator: "operator", TraceID: "audit-1", Payload: []byte(payload)}
}
func gmTestRuntime(t *testing.T) (*runtime, *admin.Registry, *int) {
	t.Helper()
	registry := app.NewRegistry(viper.New())
	commands, _ := app.Lookup[*admin.Registry](registry, app.ModAdmin)
	r := &runtime{registry: registry, commands: commands}
	calls := new(int)
	if err := r.install(Definition{Name: "gm.test", Handler: func(context.Context, *app.Registry, admin.Command) (admin.Result, error) {
		*calls++
		return admin.Result{}, nil
	}}); err != nil {
		t.Fatal(err)
	}
	return r, commands, calls
}
func TestGMStartsWithoutFeatureCommands(t *testing.T) {
	saved := definitions
	definitions = map[string]Definition{}
	defer func() { definitions = saved }()
	registry := app.NewRegistry(viper.New())
	stop, err := Start(registry)
	if err != nil {
		t.Fatal(err)
	}
	commands, _ := app.Lookup[*admin.Registry](registry, app.ModAdmin)
	if _, err = commands.Execute(context.Background(), gmTestCommand(`{"note":"test"}`)); !errors.Is(err, admin.ErrCommandNotFound) {
		t.Fatalf("unexpected command: %v", err)
	}
	if err = stop(context.Background()); err != nil {
		t.Fatal(err)
	}
}
func TestGMRequiresOperator(t *testing.T) {
	_, commands, calls := gmTestRuntime(t)
	cmd := gmTestCommand(`{"note":"compensate"}`)
	cmd.Operator = " "
	result, err := commands.Execute(context.Background(), cmd)
	if !errors.Is(err, apperrors.ErrGMInvalid) || result.OK || *calls != 0 || result.Data["code"] != errcode.CodeOf(apperrors.ErrGMInvalid) {
		t.Fatalf("result=%+v err=%v calls=%d", result, err, *calls)
	}
}
