func TestGMKeepsCodedCause(t *testing.T) {
	r, commands, _ := gmTestRuntime(t)
	if err := r.install(Definition{Name: "gm.test", Handler: func(context.Context, *app.Registry, admin.Command) (admin.Result, error) {
		return admin.Result{}, apperrors.ErrGMUnavailable
	}}); err != nil {
		t.Fatal(err)
	}
	result, err := commands.Execute(context.Background(), gmTestCommand(`{"note":"test"}`))
	if !errors.Is(err, apperrors.ErrGMUnavailable) || result.Data["code"] != errcode.CodeOf(apperrors.ErrGMUnavailable) {
