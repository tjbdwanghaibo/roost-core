// Nest、生成 DAO/组件、handler 和 Remote 准入是真实接口；Remote 授权及提交是内存替身。
// 不把这里的通过当成 Mongo、WAL、迁移进程或 NATS 已验收。
type scopeRemote struct {
	entity.IRemoteEntityManager
	owner atomic.Int32
}

func (r *scopeRemote) GetRemoteOwnership(context.Context, int64) (entity.RemoteEntityMarkerLease, bool, error) {
	return entity.RemoteEntityMarkerLease{OwnerSid: r.owner.Load(), MarkerEpoch: 1, RouteEpoch: 1}, true, nil
}

func (r *scopeRemote) PrepareRemoteWriteBatch(_ context.Context, ids []int64) (entity.RemoteWriteBatch, error) {
	if r.owner.Load() != 1000 {
		return nil, entity.ErrRemoteFenced
	}
	return &scopeBatch{ids: ids}, nil
}

type scopeBatch struct{ ids []int64 }

func (b *scopeBatch) EntityIDs() []int64 { return b.ids }

func (*scopeBatch) FinalizeLocked(entity.RemoteTransactionOutcome) error { return nil }

func (*scopeBatch) Commits() []entity.RemoteCommit { return nil }

func (*scopeBatch) Commit(context.Context) ([]entity.RemoteCommitReceipt, error) { return nil, nil }

func (*scopeBatch) Abort(context.Context, error) error { return nil }

func (*scopeBatch) Indeterminate(context.Context, error) error { return nil }

func (*scopeBatch) Close(context.Context) error { return nil }

type scopeGetter struct{ value *host.Alliance }

func (g scopeGetter) Get(context.Context, int64, entity.EntityCategory) (entity.IThreadSafeEntity, error) {
	return g.value, nil
}

func (g scopeGetter) GetMany(_ context.Context, ids []int64, _ []entity.EntityCategory) ([]entity.IThreadSafeEntity, error) {
	out := make([]entity.IThreadSafeEntity, len(ids))
	for i := range ids {
		out[i] = g.value
	}
	return out, nil
}

type scopeCommitter struct{ reject atomic.Bool }

func (c *scopeCommitter) Commit(context.Context, dataengine.CommitRecord) error {
	if c.reject.Load() {
		return errors.New("scope commit rejected")
	}
	return nil
}

type scopeFixture struct {
	owner   *host.Alliance
	remote  *scopeRemote
	client  *nest.NestMgr
	service *Service
	commit  *scopeCommitter
	now     atomic.Int64
}

var scopeAction = nest.NewHandlerName("test_alliance_activity_scope")

func newScopeFixture(t *testing.T) *scopeFixture {
	t.Helper()
	host.RegisterEntity()
	config := configdata.NewRegistry()
	if err := generated.RegisterGeneratedConfigData(config); err != nil {
		t.Fatal(err)
	}
	if _, err := configdata.NewStore(config, "../../../configs/data").Load(context.Background()); err != nil {
		t.Fatal(err)
	}
	id, err := entity.BuildEntityID(98101, host.EntityKindAlliance)
	if err != nil {
		t.Fatal(err)
	}
	value, err := entity.BuildEntity(&entity.EntityCreateParam{IsCreate: true, Id: id, Kind: host.EntityKindAlliance})
	if err != nil {
		t.Fatal(err)
	}
	f := &scopeFixture{owner: value.(*host.Alliance), remote: &scopeRemote{}, commit: &scopeCommitter{}}
	f.remote.owner.Store(1000)
	f.now.Store(clock.ProcessCalendar().DayStart(time.UnixMilli(1900000000000)).UnixMilli())
	clock.SetSource(func() time.Time { return time.UnixMilli(f.now.Load()) })
	t.Cleanup(func() { clock.SetSource(nil) })
	f.client = nest.NewEngine(nest.NestOptionWithGetter(scopeGetter{f.owner}), nest.NestOptionWithRemoteEntityManager(f.remote), nest.NestOptionWithTransactionCommitter(f.commit))
	if err = f.client.RegisterHandlerWithMeta(scopeAction, func(es []entity.IThreadSafeEntity, params []any, _ ...nest.HandlerOption) (any, error) {
		c := es[0].(*host.Alliance).AllianceActivityComp()
		if err := params[0].(func(activity.Host) error)(c.Host()); err != nil {
			return nil, err
		}
		return nil, c.Rearm()
	}, nest.HandlerMeta{Rollback: nest.RollbackUndo, Durability: nest.DurabilityStrict}); err != nil {
		t.Fatal(err)
	}
	for _, register := range []func(*nest.NestMgr) error{handler.RegisterAllianceActivityPulseNestHandlersOn, handler.RegisterAllianceActivityCompleteNestHandlersOn} {
		if err = register(f.client); err != nil {
			t.Fatal(err)
		}
	}
	if err = f.client.Start(); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := f.client.Shutdown(context.Background()); err != nil {
			t.Error(err)
		}
	})
	f.service = &Service{client: f.client, owners: f.remote, sid: 1000}
	return f
}

func (f *scopeFixture) call(fn func(activity.Host) error) error {
	_, err := f.client.Request(context.Background(), scopeAction, f.owner.ID(), nest.NewParams(fn))
	return err
}

func (f *scopeFixture) rule() activity.Definition {
	return activity.Definition{ID: 1, Version: 1, Scope: "alliance", Trigger: "fixed", StartMilli: f.now.Load(), WarmupMillis: 1000, OpenMillis: 1000, Repeat: "weekly", Period: 1, MaxCycles: 3, Catchup: "queue"}
}

func TestAllianceActivityCycleUsesAuthorityAndStableScope(t *testing.T) {
	f := newScopeFixture(t)
	d := f.rule()
	if err := f.call(func(h activity.Host) error {
		_, err := h.Activate(d, "", 0, f.now.Load())
		if err != nil {
			return err
		}
		return h.Advance(f.now.Load())
	}); err != nil {
		t.Fatal(err)
	}
	first, err := f.service.Pulse(context.Background(), f.owner.ID(), "", 0)
	if err != nil || len(first) != 1 {
		t.Fatalf("first=%+v err=%v", first, err)
	}
	if first[0].Token.Scope != "alliance" || first[0].Token.Owner != f.owner.ID() || first[0].Token.Phase != activity.Warmup {
		t.Fatal(first)
	}
	f.now.Add(2000)
	if _, err = f.service.Pulse(context.Background(), f.owner.ID(), "", 0); err != nil {
		t.Fatal(err)
	}
	f.now.Store(time.UnixMilli(d.StartMilli).AddDate(0, 0, 7).UnixMilli())
	second, err := f.service.Pulse(context.Background(), f.owner.ID(), "", 0)
	if err != nil || len(second) != 1 {
		t.Fatal(second, err)
	}
	if second[0].Token.Cycle != 2 || second[0].Token.Generation != 1 || second[0].Start != f.now.Load() {
		t.Fatalf("drifting scope=%+v", second)
	}
}

func TestAllianceActivityChangedOwnerRejectsOldDriver(t *testing.T) {
	f := newScopeFixture(t)
	f.remote.owner.Store(1001)
	if err := f.service.CheckRoute(context.Background(), f.owner.ID()); err == nil {
		t.Fatal("route accepted foreign owner")
	}
	if _, err := f.service.Pulse(context.Background(), f.owner.ID(), "", 0); err == nil {
		t.Fatal("stale driver wrote foreign owner")
	}
	if err := f.call(func(h activity.Host) error { _, e := h.Activate(f.rule(), "", 0, f.now.Load()); return e }); !errors.Is(err, entity.ErrRemoteFenced) {
		t.Fatal(err)
	}
}

func TestAllianceActivityFailureLeavesNoActivation(t *testing.T) {
	f := newScopeFixture(t)
	if err := f.call(func(h activity.Host) error {
		if _, err := h.Activate(f.rule(), "", 0, f.now.Load()); err != nil {
			return err
		}
		return fmt.Errorf("business rejected")
	}); err == nil {
		t.Fatal("missing rejection")
	}
	values, err := f.service.Pulse(context.Background(), f.owner.ID(), "", 0)
	if err != nil || len(values) != 0 {
		t.Fatalf("rollback=%+v %v", values, err)
	}
}

// scopeRows 只换 activity 这张表（其余表原样带上），用例结束时把缺省 Store 与运行期配置换回。
func scopeRows(t *testing.T, rows ...activity.Definition) {
	t.Helper()
	previous, config := configdata.DefaultStore(), fctx.RuntimeConfig()
	t.Cleanup(func() { configdata.SetDefaultStore(previous); fctx.SetRuntimeConfig(config) })
	dir := t.TempDir()
	entries, err := os.ReadDir("../../../configs/data")
	if err != nil {
		t.Fatal(err)
	}
	for _, e := range entries {
		if e.IsDir() || filepath.Ext(e.Name()) != ".json" || e.Name() == "_manifest.json" {
			continue
		}
		raw, err := os.ReadFile(filepath.Join("../../../configs/data", e.Name()))
		if err != nil {
			t.Fatal(err)
		}
		if err = os.WriteFile(filepath.Join(dir, e.Name()), raw, 0600); err != nil {
			t.Fatal(err)
		}
	}
	raw, err := json.Marshal(rows)
	if err != nil {
		t.Fatal(err)
	}
	if err = os.WriteFile(filepath.Join(dir, "activity.json"), raw, 0600); err != nil {
		t.Fatal(err)
	}
	registry := configdata.NewRegistry()
	if err = generated.RegisterGeneratedConfigData(registry); err != nil {
		t.Fatal(err)
	}
	if _, err = configdata.NewStore(registry, dir).Load(context.Background()); err != nil {
		t.Fatal(err)
	}
}

// Trigger=created 的联盟活动在建盟之后由恢复扫描自动激活：扫描的调用形态是 Pulse(target, "", 0)，
// 不带创建时间，创建事实取自联盟自己的持久建盟时间。建盟时间以秒落库（AllianceDao.CreatedAtUnix），
// 活动引擎用毫秒，时间线必须锚在“建盟时刻 + DelayMillis”上。没建成的联盟没有创建事实，不激活。
func TestAllianceActivityCreatedTriggerStartsFromTheFoundingTime(t *testing.T) {
	f := newScopeFixture(t)
	scopeRows(t, activity.Definition{ID: 2, Version: 1, Scope: "alliance", Trigger: "created", DelayMillis: 60000, WarmupMillis: 1000, OpenMillis: 5000, Repeat: "none", Catchup: "queue"})
	scan := func() []activity.Snapshot {
		t.Helper()
		views, err := f.service.Pulse(context.Background(), f.owner.ID(), "", 0)
		if err != nil {
			t.Fatal(err)
		}
		return views
	}
	if views := scan(); len(views) != 0 {
		t.Fatalf("an alliance nobody founded activated %+v", views)
	}
	// 建盟走联盟自己的规则入口，写下的是秒。
	foundedUnix := f.now.Load() / 1000
	if err := f.call(func(h activity.Host) error {
		return h.Owner.(*host.Alliance).AllianceRosterComp().Found("seven", 100, 1000, true, "found-seven", foundedUnix)
	}); err != nil {
		t.Fatal(err)
	}
	f.now.Add(30500) // 扫描在建盟 30.5 秒之后才轮到这个联盟
	views := scan()
	if len(views) != 1 {
		t.Fatalf("after the founding the scan sees %+v, want the created-trigger activity", views)
	}
	start := foundedUnix*1000 + 60000
	if got := views[0]; got.Token.Definition != 2 || got.Token.Scope != "alliance" || got.Token.Owner != f.owner.ID() || got.Start != start || got.OpenAt != start+1000 || got.CloseAt != start+6000 {
		t.Fatalf("activity = %+v, want it anchored at the founding time in milliseconds (start %d)", got, start)
	}
	if views[0].Token.Phase == activity.Open || views[0].Token.Phase == activity.Settling || views[0].Token.Phase == activity.Ended {
		t.Fatalf("phase %v before the start time: the timeline is not anchored on the founding", views[0].Token.Phase)
	}
	// 再扫不重置锚点；到开启时间后进入 Open。
	f.now.Store(start + 1000)
	views = scan()
	if len(views) != 1 || views[0].Start != start || views[0].Token.Generation != 1 || views[0].Token.Phase != activity.Open {
		t.Fatalf("at the open time: %+v", views)
	}
	// 最后一名成员（盟主）退出后联盟解散：之后才配置的 created 定义不在它身上新激活，已激活的时间线照常保留。
	if err := f.call(func(h activity.Host) error {
		roster := h.Owner.(*host.Alliance).AllianceRosterComp()
		if err := roster.CheckRemoval(100, 100); err != nil {
			return err
		}
		roster.Remove(100)
		return nil
	}); err != nil {
		t.Fatal(err)
	}
	scopeRows(t,
		activity.Definition{ID: 2, Version: 1, Scope: "alliance", Trigger: "created", DelayMillis: 60000, WarmupMillis: 1000, OpenMillis: 5000, Repeat: "none", Catchup: "queue"},
		activity.Definition{ID: 3, Version: 1, Scope: "alliance", Trigger: "created", WarmupMillis: 1000, OpenMillis: 5000, Repeat: "none", Catchup: "queue"})
	if views = scan(); len(views) != 1 || views[0].Token.Definition != 2 || views[0].Start != start {
		t.Fatalf("a disbanded alliance: %+v, want only the activity that was already running", views)
	}
}

func TestAllianceActivityEmptyConfigurationDoesNothing(t *testing.T) {
	f := newScopeFixture(t)
	values, err := f.service.Pulse(context.Background(), f.owner.ID(), "", 0)
	if err != nil || len(values) != 0 {
