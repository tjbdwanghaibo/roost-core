package activity_alliance

import (
	"context"
	"log/slog"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/framework/nest"
	"github.com/tjbdwanghaibo/roost-core/wiring/remoteentity"

	"{{MODULE}}/game/activity"
	host "{{MODULE}}/game/entities/alliance"
	syncsender "{{MODULE}}/game/handler/syncsender"
)

type Service struct {
	client nest.Client
	owners entity.RemoteOwnershipManager
	sid    int32
}

func New() *Service { return &Service{} }

func (s *Service) CheckRoute(ctx context.Context, target int64) error {
	if entity.GetEntityKindFromID(target) != host.EntityKindAlliance {
		return activity.ErrRule
	}
	return remoteentity.RPCRouteCheck(ctx, s.owners, s.sid, target)
}

func (s *Service) Pulse(ctx context.Context, target int64, event string, createdAt int64) ([]activity.Snapshot, error) {
	// 直接调用与总线调用同样检查路由，防止恢复扫描拿到的旧属主快照越权。
	if err := s.CheckRoute(ctx, target); err != nil {
		return nil, err
	}
	views, err := syncsender.NewAllianceActivityPulseSender(s.client).Sync_AllianceActivityPulse(ctx, target, event, createdAt)
	// 空事件是周期扫描，不为每拍打印日志；明确触发只记录请求已确认。
	if err == nil && event != "" {
		slog.DebugContext(ctx, "activity: trigger confirmed", "owner_entity_id", target, "scope", "alliance", "event", event, "activities", len(views))
	}
	return views, err
}

func (s *Service) Complete(ctx context.Context, target int64, token activity.Token) error {
	if err := s.CheckRoute(ctx, target); err != nil {
		return err
	}
	err := syncsender.NewAllianceActivityCompleteSender(s.client).Sync_AllianceActivityComplete(ctx, target, token)
	if err == nil {
		slog.DebugContext(ctx, "activity: completion confirmed", "owner_entity_id", target, "scope", token.Scope, "definition", token.Definition, "generation", token.Generation, "cycle", token.Cycle, "phase", token.Phase, "flow_version", token.FlowVersion)
	}
	return err
}
