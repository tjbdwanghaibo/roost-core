package controllers

import (
	"errors"
	"log/slog"

	"github.com/tjbdwanghaibo/roost-core/infra/base/errcode"
	"github.com/tjbdwanghaibo/roost-core/infra/network/playeraccess"

	"{{MODULE}}/game/modules/cellspace"
	"{{MODULE}}/protocol/pb"
)

func (c *Controller) HandleCellMove(ctx *playeraccess.Context, req *pb.CellMoveRequest) (*pb.CellMoveResponse, error) {
	if ctx == nil || req == nil {
		return nil, errors.New("cellspace: missing request")
	}
	err := cellspace.Move(ctx.Context(), ctx.PlayerID, ctx.Session, req.VX, req.VY)
	code, reason := errcode.ClientError(err)
	if code == errcode.CodeInternal {
		slog.ErrorContext(ctx.Context(), "cellspace: move failed", "player", ctx.PlayerID, "err", err)
	}
	return &pb.CellMoveResponse{Code: code, Reason: reason}, nil
}
