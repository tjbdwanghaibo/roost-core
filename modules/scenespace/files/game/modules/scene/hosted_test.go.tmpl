func hostedFixture(t *testing.T) (*Space, *entitysync.Manager) {
	t.Helper()
	m, err := entitysync.NewManager(entitysync.ManagerConfig{Transport: entitysync.TransportFunc(func(context.Context, entitysync.SessionID, []byte) error { return nil })})
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { _ = m.Close(context.Background()) })
	s, err := NewHostedSpace(policy.InterestConfig{Manager: m, AOI: policy.AOIConfig{Bounds: spatial.Rect{Max: spatial.Point{X: 1000, Y: 1000}}, BlockSize: 50, EnterRadius: 90, LeaveRadius: 120}}, 1, 42, entity.SyncProfile{})
	if err != nil {
		t.Fatal(err)
	}
	return s, m
}

func TestSceneSpaceBorrowsTheHostManager(t *testing.T) {
	s, m := hostedFixture(t)
	if s.manager != m {
		t.Fatal("hosted space replaced its manager")
	}
	s.Close()
	// Three maps can coexist on one manager without changing each other's broad phase.
	var maps []*Space
	defer func() { for _, space := range maps { space.Close() } }()
	for _, mode := range []policy.AOIIndexMode{"", policy.IndexCrossList, policy.IndexKDTree} {
		cfg := DefaultConfig(); cfg.AOIIndex = mode
		space, err := NewSpace(m, cfg, 1)
		if err != nil { t.Fatalf("open %q: %v", mode, err) }
		maps = append(maps, space)
	}
	for i, mode := range []policy.AOIIndexMode{policy.IndexBlock, policy.IndexCrossList, policy.IndexKDTree} {
		if got := maps[i].Interest.IndexMode(); got != mode { t.Fatalf("map %d uses %q, want %q", i, got, mode) }
	}
	bad := DefaultConfig(); bad.AOIIndex = "typo"
	if got, err := NewSpace(m, bad, 1); err == nil || got != nil { t.Fatal("invalid AOI index accepted") }
	if err := m.OpenHeldSession(19); err != nil {
		t.Fatalf("closing the space closed the host manager: %v", err)
	}
	m.CloseSession(19)
}

func TestSceneSpaceRejoinAndForgetUseTheSameMainView(t *testing.T) {
	s, _ := hostedFixture(t)
	defer s.Close()
	const observer int64 = 19
	id := observer<<entity.UniqueIDShift | 1<<entity.EntityKindShift | 1
	for _, at := range []spatial.Point{{X: 20, Y: 20}, {X: 80, Y: 20}} {
		if err := s.EnterRegistered(id, at, policy.ObserverView{}); err != nil {
			t.Fatal(err)
		}
		if _, ok := s.Interest.ObserverView(observer); !ok {
			t.Fatal("no observer in the owned interest")
		}
		if err := s.AttachMetadata(observer); err != nil {
			t.Fatal(err)
		}
	}
	if err := s.Forget(id); err != nil {
		t.Fatal(err)
	}
	if _, ok := s.Interest.ObserverView(observer); ok {
		t.Fatal("observer still registered after leave")
	}
	if err := s.SetRegionMode(observer, regionsummary.Count); err == nil { t.Fatal("unconfigured map granted counts") }
	verifyRegionLayer(t)
}

type regionTestObject struct{ *entity.EntityBase }
func (o *regionTestObject) Base() *entity.EntityBase { return o.EntityBase }

// Exercise the installed map's actual Enter, QueueMove, Forget, configuration and public API.
func verifyRegionLayer(t *testing.T) {
	t.Helper()
	decoder := entitysync.NewDecoder(frame.DefaultLimits())
	held := map[int64]bool{}; counts := map[int64]uint64{}
	push := func(_ context.Context, _ entitysync.SessionID, data []byte) error {
		f, err := decoder.Decode(data); if err != nil { return err }
		if f.Kind == frame.Full { clear(held); clear(counts) }
		for _, obj := range f.Objects {
			if obj.Operation == frame.ObjectRemove { delete(held,obj.SubjectID); delete(counts,obj.SubjectID); continue }
			for _, comp := range obj.Components { u := comp.Update; held[u.SubjectID] = true
				if u.Namespace == regionsummary.Namespace { var v wrapperspb.UInt64Value; if err:=proto.Unmarshal(u.Payload.BytesCopy(),&v); err!=nil{return err}; counts[u.SubjectID]=v.Value }
			}
		}
		return nil
	}
	m, err := entitysync.NewManager(entitysync.ManagerConfig{Transport: entitysync.TransportFunc(push)})
	check := func(err error) { t.Helper(); if err!=nil { t.Fatal(err) } }; check(err); defer m.Close(context.Background())
	const observer = 19
	const playerID = observer<<entity.UniqueIDShift | 1<<entity.EntityKindShift | 1
	const unitID = 25<<entity.UniqueIDShift | 2<<entity.EntityKindShift | 1
	const west, east = 8001,8002
	cfg:=DefaultConfig(); cfg.RegionSummary=&regionsummary.Config{View:20, DetailView:21, DetailProfile:Public, Public:func(id int64)bool{return id==unitID}, Areas:[]regionsummary.Area{
		{SubjectID:west, Bounds:spatial.Rect{Max:spatial.Point{X:500,Y:1000}}},
		{SubjectID:east, Bounds:spatial.Rect{Min:spatial.Point{X:500},Max:spatial.Point{X:1000,Y:1000}}},
	}}
	space,err:=NewSpace(m,cfg,1); check(err); defer space.Close(); check(m.OpenSession(observer))
	check(space.EnterRegistered(playerID,spatial.Point{X:50,Y:50},policy.ObserverView{}))
	unit:=&regionTestObject{entity.NewEntityBase(unitID,entity.EntityCategory(1),true,2)}
	unit.SetSyncState(entity.NewSubjectSyncState(entity.SubjectSyncCreateParam{Enabled:true, SubjectID:unitID, Namespace:"landmark", Packer:entity.SubjectSyncPackFunc{Snapshot:func(p entity.SyncProfile)(entity.FrozenSyncPayload,error){return entity.TakeFrozenSyncPayload(1,[]byte{1}),nil}}}))
	check(space.Enter(unit,spatial.Point{X:400,Y:400}))
	flush:=func(){t.Helper(); for range 3 { check(m.Flush(context.Background())) }}
	check(space.SetRegionMode(observer,regionsummary.Detail)); flush()
	if !held[unitID] || len(held)!=1 || len(space.Nearby(observer))!=0 {t.Fatalf("detail: held=%v nearby=%v",held,space.Nearby(observer))}
	check(space.SetRegionMode(observer,regionsummary.Count)); flush(); if len(held)!=1 || counts[west]!=1 {t.Fatalf("count: %v %v",held,counts)}
	check(space.QueueMove(unit,spatial.Point{X:500,Y:400})); flush(); if len(held)!=1 || counts[east]!=1 {t.Fatalf("cross: %v %v",held,counts)}
	check(space.QueueMove(unit,spatial.Point{X:60,Y:50})); flush(); if !held[unitID] || counts[west]!=1 || len(held)!=2 || !slices.Equal(space.Nearby(observer),[]int64{unitID}) {t.Fatalf("real near source: %v %v",held,counts)}
	check(space.SetRegionMode(observer,regionsummary.Detail)); flush(); if len(held)!=1 || !held[unitID] {t.Fatalf("back to detail: %v",held)}
	check(space.Forget(unitID)); flush(); if len(held)!=0 || m.AuditStats().Subscriptions!=0 {t.Fatalf("forget: %v",held)}
}

// 移动的提交后发布（actor 的 AfterCommit）与 Scene 侧 Forget（Scene 的 AfterCommit）分属两个实体，互不保序：
// 发布已从 positions 读到条目、尚未拿到位置锁时，Forget 删掉条目并撤出区域层；随后的发布不能把已离开的
// 对象重新计进区域数、加回详情视图（之后的 Hide/Leave 不再清它，计数会永久多 1）。
func TestSceneSpaceMoveAfterForgetDoesNotRecount(t *testing.T) {
	m, err := entitysync.NewManager(entitysync.ManagerConfig{Transport: entitysync.TransportFunc(func(context.Context, entitysync.SessionID, []byte) error { return nil })})
	if err != nil { t.Fatal(err) }
	defer m.Close(context.Background())
	const unitID int64 = 25<<entity.UniqueIDShift | 2<<entity.EntityKindShift | 1
	cfg := DefaultConfig(); cfg.RegionSummary = &regionsummary.Config{View: 20, DetailView: 21, DetailProfile: Public, Public: func(id int64) bool { return id == unitID }, Areas: []regionsummary.Area{
		{SubjectID: 8001, Bounds: spatial.Rect{Max: spatial.Point{X: 1000, Y: 1000}}},
	}}
	space, err := NewSpace(m, cfg, 1)
	if err != nil { t.Fatal(err) }
	defer space.Close()
	unit := &regionTestObject{entity.NewEntityBase(unitID, entity.EntityCategory(1), true, 2)}
	unit.SetSyncState(entity.NewSubjectSyncState(entity.SubjectSyncCreateParam{Enabled: true, SubjectID: unitID, Namespace: "landmark", Packer: entity.SubjectSyncPackFunc{Snapshot: func(entity.SyncProfile) (entity.FrozenSyncPayload, error) { return entity.TakeFrozenSyncPayload(1, []byte{1}), nil }}}))
	if err := space.Enter(unit, spatial.Point{X: 400, Y: 400}); err != nil { t.Fatal(err) }
	entry, ok := space.positions.Load(unitID) // 发布已读到条目
	if !ok { t.Fatal("entered unit has no committed position") }
	if err := space.Forget(unitID); err != nil { t.Fatal(err) } // Scene 侧先完成离开
	space.publishMove(unitID, entry.(*committedPosition), spatial.Point{X: 450, Y: 400}) // 发布这才拿到位置锁
	if members, _ := space.Interest.ViewMembers(21); len(members) != 0 { t.Fatalf("departed unit put back into the detail view: %v", members) }
	if markers, _ := space.Interest.ViewMembers(20); len(markers) != 0 { t.Fatalf("departed unit recounted: %v", markers) }
}

func TestSceneSpaceNoNewManagerOrDefaultMapOnInvalidHost(t *testing.T) {
	s, err := NewHostedSpace(policy.InterestConfig{}, 1, 42, entity.SyncProfile{})
	if err == nil || s != nil {
		t.Fatal("hosted space supplied its own manager")
	}
