func groupForTest(draws int64, replacement bool) schema.RewardGroup {
	return schema.RewardGroup{ID: 1, Draws: draws, Replacement: replacement}
}

func fixedRow(id, item, count int64) schema.RewardEntry {
	return schema.RewardEntry{ID: id, GroupID: 1, ItemID: item, Count: count, Kind: "fixed"}
}

func chanceRow(id, item, count, bp int64) schema.RewardEntry {
	r := fixedRow(id, item, count)
	r.Kind, r.ChanceBP = "chance", bp
	return r
}

func weightedRow(id, item, count, weight int64) schema.RewardEntry {
	r := fixedRow(id, item, count)
	r.Kind, r.Weight = "weighted", weight
	return r
}

// 脚本同时断言取样的次数、先后与半开区间，不靠固定 seed 或统计容差。
func scriptedSamples(t *testing.T, steps ...[2]int64) func(int64) (int64, error) {
	t.Helper()
	i := 0
	t.Cleanup(func() {
		if i != len(steps) {
			t.Errorf("consumed %d of %d samples", i, len(steps))
		}
	})
	return func(bound int64) (int64, error) {
		t.Helper()
		if i >= len(steps) {
			t.Fatalf("unexpected sample with bound %d", bound)
		}
		step := steps[i]
		i++
		if bound != step[0] {
			t.Fatalf("sample %d: bound %d, want %d", i, bound, step[0])
		}
		return step[1], nil
	}
}

func wantResolution(t *testing.T, g schema.RewardGroup, rows []schema.RewardEntry, rng func(int64) (int64, error), want ...Item) {
	t.Helper()
	got, err := resolve(g, rows, rng)
	if err != nil || !slices.Equal(got, want) {
		t.Fatalf("resolve = %+v, %v; want %+v and no error", got, err, want)
	}
}

func wantRefusal(t *testing.T, g schema.RewardGroup, rows []schema.RewardEntry, rng func(int64) (int64, error)) {
	t.Helper()
	if got, err := resolve(g, rows, rng); err == nil || got != nil {
		t.Fatalf("resolve = %+v, %v; want nil and an error", got, err)
	}
}

func TestRewardIndependentChanceBoundaries(t *testing.T) {
	g := groupForTest(0, false)
	// CSV 顺序与行号相反：第一个样本总是给 #10。四种联合结果都能出现。
	rows := []schema.RewardEntry{chanceRow(40, 9, 99, 0), chanceRow(20, 3, 4, 9999), chanceRow(10, 8, 2, 1), chanceRow(30, 7, 1, 10000)}
	for _, tc := range []struct {
		name string
		a, b int64
		want []Item
	}{
		{"both hit", 0, 9998, []Item{{3, 4}, {7, 1}, {8, 2}}},
		{"first only", 0, 9999, []Item{{7, 1}, {8, 2}}},
		{"second only", 1, 9998, []Item{{3, 4}, {7, 1}}},
		{"both miss", 1, 9999, []Item{{7, 1}}},
	} {
		t.Run(tc.name, func(t *testing.T) {
			wantResolution(t, g, rows, scriptedSamples(t, [2]int64{10000, tc.a}, [2]int64{10000, tc.b}), tc.want...)
		})
	}
	// 无确定项与加权项，概率未命中：这是合法空结果，不是非法空组。
	wantResolution(t, g, []schema.RewardEntry{chanceRow(1, 9, 8, 2500)}, scriptedSamples(t, [2]int64{10000, 2500}))
}

func TestRewardWeightedIntervalsWithReplacement(t *testing.T) {
	g := groupForTest(2, true)
	rows := []schema.RewardEntry{
		weightedRow(70, 5, 3, 3), chanceRow(90, 5, 1, 8700), weightedRow(20, 8, 6, 2),
		fixedRow(60, 8, 1), weightedRow(40, 9, 4, 1),
	}
	// 行号顺序映射为 [0,2)、[2,3)、[3,6)。每格连中两次：行须保留，fixed/chance 只入账一次。
	for ticket, want := range [][]Item{
		{{5, 1}, {8, 13}}, {{5, 1}, {8, 13}}, {{5, 1}, {8, 1}, {9, 8}},
		{{5, 7}, {8, 1}}, {{5, 7}, {8, 1}}, {{5, 7}, {8, 1}},
	} {
		rng := scriptedSamples(t, [2]int64{10000, 8699}, [2]int64{6, int64(ticket)}, [2]int64{6, int64(ticket)})
		wantResolution(t, g, rows, rng, want...)
	}
}

func TestRewardWithoutReplacementRemovesOneEntry(t *testing.T) {
	g := groupForTest(2, false)
	rows := []schema.RewardEntry{weightedRow(30, 3, 7, 1), weightedRow(20, 8, 4, 3), weightedRow(10, 8, 1, 2)}
	ab, ac, bc := []Item{{8, 5}}, []Item{{3, 7}, {8, 1}}, []Item{{3, 7}, {8, 4}}
	// 同物品的 A、B 两行可以一起中。枚举第二抽的每一格、数结果频次：证明剩余权重，不限定删行后的排列。
	for _, tc := range []struct {
		name                string
		first               int64
		left, right         []Item
		leftHits, rightHits int64
	}{
		{"A first", 0, ab, ac, 3, 1},
		{"B first", 2, ab, bc, 2, 1},
		{"C first", 5, ac, bc, 2, 3},
	} {
		t.Run(tc.name, func(t *testing.T) {
			var left, right int64
			remaining := tc.leftHits + tc.rightHits
			for ticket := int64(0); ticket < remaining; ticket++ {
				rng := scriptedSamples(t, [2]int64{6, tc.first}, [2]int64{remaining, ticket})
				got, err := resolve(g, rows, rng)
				switch {
				case err != nil:
					t.Fatal(err)
				case slices.Equal(got, tc.left):
					left++
				case slices.Equal(got, tc.right):
					right++
				default:
					t.Fatalf("second ticket %d: impossible pair %+v", ticket, got)
				}
			}
			if left != tc.leftHits || right != tc.rightHits {
				t.Fatalf("remaining intervals have lengths %d,%d; want %d,%d", left, right, tc.leftHits, tc.rightHits)
			}
		})
	}
}

// 逐组验收工程当前发布的全量配置；不假设样例 ID、抽中结果或组数。
// resolve 在取样前检查所有可达分支，故固定合法取样值即可验出潜在产量溢出。
func checkProjectRewardCatalog(t *testing.T) {
	t.Helper()
	previousStore, previousConfig := configdata.DefaultStore(), fctx.RuntimeConfig()
	t.Cleanup(func() { configdata.SetDefaultStore(previousStore); fctx.SetRuntimeConfig(previousConfig) })
	registry := configdata.NewRegistry()
	if err := generated.RegisterGeneratedConfigData(registry); err != nil {
		t.Fatal(err)
	}
	snap, err := configdata.NewStore(registry, "../../../configs/data").Load(context.Background())
	if err != nil {
		t.Fatal(err)
	}
	groups, groupsOK := generated.RewardGroupTableFrom(snap)
	entries, entriesOK := generated.RewardEntryTableFrom(snap)
	if !groupsOK || !entriesOK {
		t.Fatal("project configs/data did not load both reward tables")
	}
	byGroup := make(map[int64][]schema.RewardEntry)
	for _, row := range entries.Rows() {
		byGroup[row.GroupID] = append(byGroup[row.GroupID], row)
	}
	for _, group := range groups.Rows() {
		if _, err := resolve(group, byGroup[group.ID], func(int64) (int64, error) { return 0, nil }); err != nil {
			t.Errorf("configs/data reward group %d: %v", group.ID, err)
		}
	}
}

func TestRewardInvalidDefinitionsAndLimits(t *testing.T) {
	t.Run("project_catalog", checkProjectRewardCatalog)
	f, w := fixedRow(1, 5, 2), weightedRow(2, 6, 1, 1)
	badKind, wrongGroup, fixedChance, fixedWeight, chanceWeight, weightedChance := f, f, f, f, chanceRow(9, 1, 1, 50), w
	badKind.Kind, wrongGroup.GroupID, fixedChance.ChanceBP, fixedWeight.Weight = "other", 2, 1, 1
	chanceWeight.Weight, weightedChance.ChanceBP = 1, 1
	rows := make([]schema.RewardEntry, 257)
	for i := range rows {
		rows[i] = fixedRow(int64(i+1), 4, 1)
	}
	noPool, pool := groupForTest(0, false), groupForTest(1, false)
	zero := func(int64) (int64, error) { return 0, nil }
	wantResolution(t, noPool, rows[:256], zero, Item{4, 256})
	wantResolution(t, groupForTest(64, true), []schema.RewardEntry{w}, zero, Item{6, 64})
	for _, tc := range []struct {
		name string
		g    schema.RewardGroup
		rows []schema.RewardEntry
	}{
		{"empty group", noPool, nil}, {"257 rows", noPool, rows},
		{"zero group id", schema.RewardGroup{}, []schema.RewardEntry{f}},
		{"zero entry id", noPool, []schema.RewardEntry{fixedRow(0, 1, 2)}},
		{"duplicate entry id", noPool, []schema.RewardEntry{f, f}},
		{"wrong group", noPool, []schema.RewardEntry{wrongGroup}},
		{"unknown kind", noPool, []schema.RewardEntry{badKind}},
		{"zero item", noPool, []schema.RewardEntry{fixedRow(1, 0, 1)}},
		{"zero count", noPool, []schema.RewardEntry{fixedRow(1, 1, 0)}},
		{"negative count", noPool, []schema.RewardEntry{fixedRow(1, 1, -2)}},
		{"fixed with chance", noPool, []schema.RewardEntry{fixedChance}},
		{"fixed with weight", noPool, []schema.RewardEntry{fixedWeight}},
		{"chance with weight", noPool, []schema.RewardEntry{chanceWeight}},
		{"weighted with chance", pool, []schema.RewardEntry{weightedChance}},
		{"negative BP", noPool, []schema.RewardEntry{chanceRow(1, 1, 1, -1)}},
		{"over 10000 BP", noPool, []schema.RewardEntry{chanceRow(1, 1, 1, 10001)}},
		{"zero weight", pool, []schema.RewardEntry{weightedRow(1, 1, 1, 0)}},
		{"negative weight", pool, []schema.RewardEntry{weightedRow(1, 1, 1, -1)}},
		{"draws without pool", pool, []schema.RewardEntry{f}},
		{"pool without draws", noPool, []schema.RewardEntry{w}},
		{"negative draws", groupForTest(-1, true), []schema.RewardEntry{w}},
		{"65 draws", groupForTest(65, true), []schema.RewardEntry{w}},
		{"too few distinct rows", groupForTest(2, false), []schema.RewardEntry{w}},
	} {
		t.Run(tc.name, func(t *testing.T) { wantRefusal(t, tc.g, tc.rows, zero) })
	}
}

func TestRewardReachableInt64Bounds(t *testing.T) {
	const m = math.MaxInt64
	zero := func(int64) (int64, error) { return 0, nil }
	// 整数精度：MaxInt64 的最后一个权重格仍能命中仅重 1 的行。
	wantResolution(t, groupForTest(1, true), []schema.RewardEntry{weightedRow(1, 3, 1, m-1), weightedRow(2, 5, 1, 1)}, scriptedSamples(t, [2]int64{m, m - 1}), Item{5, 1})
	// 上界是逐物品、逐可达结果计算的；0% 和别种物品不挤占同一计数器。
	wantResolution(t, groupForTest(0, false), []schema.RewardEntry{fixedRow(1, 7, m), chanceRow(2, 7, m, 0), fixedRow(3, 6, m)}, zero, Item{6, m}, Item{7, m})
	// 两抽最多中两行，三行总和虽已超界，并不代表任何一份清单会溢出。
	// 只检查解析后的合法集合，不假定删行后的第二个区间是哪一行。
	got, err := resolve(groupForTest(2, false), []schema.RewardEntry{weightedRow(1, 7, m-2, 1), weightedRow(2, 7, 2, 1), weightedRow(3, 7, 1, 1)}, zero)
	if err != nil || len(got) != 1 || got[0].ItemID != 7 || (got[0].Count != m && got[0].Count != m-1) {
		t.Fatalf("legal no-replacement sum rejected or wrong: %+v, %v", got, err)
	}
	wantResolution(t, groupForTest(2, true), []schema.RewardEntry{fixedRow(1, 7, 1), weightedRow(2, 7, m/2, 1)}, zero, Item{7, m})
	for _, tc := range []struct {
		name string
		g    schema.RewardGroup
		rows []schema.RewardEntry
	}{
		{"weight sum", groupForTest(1, true), []schema.RewardEntry{weightedRow(1, 1, 1, m), weightedRow(2, 1, 1, 1)}},
		{"fixed sum", groupForTest(0, false), []schema.RewardEntry{fixedRow(1, 1, m), fixedRow(2, 1, 1)}},
		{"chance might hit", groupForTest(0, false), []schema.RewardEntry{fixedRow(1, 1, m), chanceRow(2, 1, 1, 1)}},
		{"repeat multiplication", groupForTest(2, true), []schema.RewardEntry{weightedRow(1, 1, m/2+1, 1)}},
		{"fixed plus top two", groupForTest(2, false), []schema.RewardEntry{fixedRow(1, 1, 1), weightedRow(2, 1, 1, 1), weightedRow(3, 1, 2, 1), weightedRow(4, 1, m-2, 1)}},
	} {
		t.Run(tc.name, func(t *testing.T) {
			// 这份配置本身不可用；不能靠这次刚好避开坏分支而成功。
			wantRefusal(t, tc.g, tc.rows, func(bound int64) (int64, error) { return bound - 1, nil })
		})
	}
}

func TestRewardRandomFailureReturnsNoPartialManifest(t *testing.T) {
	rows := []schema.RewardEntry{fixedRow(1, 5, 2), chanceRow(2, 6, 3, 50), weightedRow(3, 7, 4, 3), weightedRow(4, 8, 5, 1)}
	g := groupForTest(2, true)
	wantRefusal(t, g, rows, nil)
	for _, phase := range []struct {
		name string
		call int
	}{{"at chance", 1}, {"after first weighted hit", 3}} {
		for _, fault := range []struct {
			name string
			rng  func(int64) (int64, error)
		}{
			{"source error", func(int64) (int64, error) { return 0, errors.New("entropy unavailable") }},
			{"negative sample", func(int64) (int64, error) { return -1, nil }},
			{"exclusive upper bound", func(n int64) (int64, error) { return n, nil }},
		} {
			t.Run(phase.name+"/"+fault.name, func(t *testing.T) {
				calls := 0
				wantRefusal(t, g, rows, func(n int64) (int64, error) {
					calls++
					if calls == phase.call {
						return fault.rng(n)
					}
					return 0, nil
				})
				if calls != phase.call {
					t.Fatalf("failure at call %d, source called %d times", phase.call, calls)
				}
			})
		}
	}
}
