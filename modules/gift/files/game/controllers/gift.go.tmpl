// giftStatusUnknown is the status for a saga the coordinator has not
// recorded yet, or one that is not the asking player's. The two are
// deliberately indistinguishable to the client.
const giftStatusUnknown = "unknown"

// HandleGiftStatus reads the saga record from the coordinator (the saga Mod
// publishes its Engine under mods.ModSaga; the partition owner answers from
// memory). request.SagaID is the business key SendGift handed back; the saga's
// own id is derived from it. Only the sender may look: the state names the
// sender, and anything else reads as unknown. A record that is not there is not
// an error — the start intent travels through the outbox and the start relay,
// so the first poll after SendGift usually finds nothing, and a gift that ended
// longer ago than saga.terminal_retention (1h by default) is gone from memory.
func (controller *Controller) HandleGiftStatus(context *playeraccess.Context, request *pb.GiftStatusRequest) (*pb.GiftStatusResponse, error) {
	if context == nil || request == nil {
		return nil, fmt.Errorf("gift_status endpoint: context and request are required")
	}
	engine, ok := app.Lookup[*saga.Engine](controller.registry, mods.ModSaga)
	if !ok || engine == nil {
		return nil, fmt.Errorf("gift_status endpoint: capability %q not found; the saga mod is not assembled", mods.ModSaga)
	}
	if request.SagaID == "" {
		return &pb.GiftStatusResponse{Status: giftStatusUnknown}, nil
	}
	record, err := engine.GetByBusinessKey(context.Context(), giftitem.Type, request.SagaID)
	if err != nil {
		if errors.Is(err, saga.ErrNotFound) {
			return &pb.GiftStatusResponse{Status: giftStatusUnknown}, nil
		}
		code, reason := errcode.ClientError(err)
		slog.Error("gift_status: saga read failed", "player_id", context.PlayerID, "saga_id", request.SagaID, "err", err)
		return &pb.GiftStatusResponse{Code: code, Reason: reason}, nil
	}
	state, err := gift.Decode(record.Data)
	if err != nil || state.From != context.PlayerID {
		return &pb.GiftStatusResponse{Status: giftStatusUnknown}, nil
	}
	return &pb.GiftStatusResponse{Status: record.Status.String(), Step: int32(record.Step), LastError: record.LastError}, nil
}

// HandleSendGift starts the gift saga through the StartGift transaction on
// the sender's Player: the item check happens under the Player's lock and
// the saga start intent is committed in the same WAL record, so a gift is
// either started durably or refused — never started for items the player
// did not have. The saga id is the sender, session and frame sequence, so a
// client retrying the frame does not start a second saga, and the gift
// carries this process's sid as the sender's bound sid. What happens next is
// asynchronous; the client polls GiftStatus.
func (controller *Controller) HandleSendGift(context *playeraccess.Context, request *pb.SendGiftRequest) (*pb.SendGiftResponse, error) {
	if context == nil || context.Session == nil || request == nil {
		return nil, fmt.Errorf("send_gift endpoint: context and request are required")
	}
	entityID, err := entity.BuildEntityID(context.PlayerID, player.EntityKindPlayer)
	if err != nil {
		return nil, fmt.Errorf("send_gift endpoint: %w", err)
	}
	sagaID := gift.SagaID(context.PlayerID, context.Session.Principal().SessionID, context.Seq)
	// 先核对会话与当前归属，再让 Nest 装载发送方，不能取客户端提供的路由。
	sessionSID, parseErr := strconv.ParseInt(context.Session.Principal().Claims[svcaccount.ServerIDClaim], 10, 32)
	if parseErr != nil {
		sessionSID = 0 // 缺失、非法或溢出的绑定必须被拒，不能使用 ParseInt 的饱和值。
	}
	sid, err := gift.SenderSID(context.Context(), controller.Registry(), context.PlayerID, int32(sessionSID))
	if err != nil {
		code, reason := errcode.ClientError(err)
		if code == errcode.CodeInternal {
			slog.Error("send_gift: ownership unavailable", "player_id", context.PlayerID, "err", err)
		}
		return &pb.SendGiftResponse{Code: code, Reason: reason}, nil
	}
	started, err := syncsender.NewStartGiftSender(controller.NestClient()).Sync_StartGift(context.Context(), entityID, context.PlayerID, sid, request.ToPlayerID, request.ItemID, request.Count, sagaID)
	if err != nil {
		code, reason := errcode.ClientError(err)
		if code == errcode.CodeInternal {
			slog.Error("send_gift failed", "player_id", context.PlayerID, "to", request.ToPlayerID, "item_id", request.ItemID, "err", err)
		}
		return &pb.SendGiftResponse{Code: code, Reason: reason}, nil
	}
	return &pb.SendGiftResponse{SagaID: started}, nil
}
