func TestRecipeTCPCreatePersistsProfileName(t *testing.T) {
	handler.RegisterProfileCardNestHandlers()
	f := newRecipeNetwork(t)
	conn, status := f.handshake(t, f.enterTicket(t, "named-player", 1000))
	if status.Code != 0 || !status.NeedCreate {
		t.Fatalf("new player status: %+v", status)
	}
	if refused := recipeCreate(t, conn, ""); refused.Code != apperrors.ErrProfileNameEmpty.Code() {
		t.Fatalf("empty create name: %+v", refused)
	}
	if f.committed() != 0 {
		t.Fatalf("empty name committed %d transactions", f.committed())
	}
	if created := recipeCreate(t, conn, "First"); created.Code != 0 {
		t.Fatalf("valid create name: %+v", created)
	}
	recipeEnter(t, conn)
	client, ok := app.Lookup[nest.Client](f.registry, mods.ModNest)
	if !ok {
		t.Fatal("Nest missing")
	}
	id, err := entity.BuildEntityID(42, playerentity.EntityKindPlayer)
	if err != nil {
		t.Fatal(err)
	}
	card, err := syncsender.NewProfileCardSender(client).Sync_ProfileCard(f.ctx, id)
	if err != nil || card.Name != "First" {
		t.Fatalf("created profile name: %+v %v", card, err)
	}
	if repeated := recipeCreate(t, conn, "Changed"); repeated.Code != apperrors.ErrEnterCreated.Code() {
		t.Fatalf("repeated create: %+v", repeated)
	}
	card, err = syncsender.NewProfileCardSender(client).Sync_ProfileCard(f.ctx, id)
	if err != nil || card.Name != "First" {
		t.Fatalf("repeated create changed profile name: %+v %v", card, err)
	}
}

// 单排路径不获取 Remote Team；该能力只用于构造 Team Controller，不把它当作 Remote 验收。
type recipeRemote struct{ entity.IRemoteEntityManager }

func init() {
	recipeExtraRegistry = func(registry *app.Registry) error {
		databases, err := kitdataengine.LoadDatabaseMap(registry.Config(), nil)
		if err != nil {
			return err
		}
		for name, value := range map[app.ModName]any{mods.ModMongo: mongotest.NewClient(), mods.ModRemoteEntity: recipeRemote{}, mods.ModDataEngineDatabases: databases} {
			if err := registry.Register(name, value); err != nil {
				return err
			}
		}
		return nil
	}
}
func TestRecipeTCPTwoPlayersFinishATurn(t *testing.T) {
	roomentity.RegisterEntity()
	handler.RegisterMatchBeginNestHandlers()
	handler.RegisterMatchStateNestHandlers()
	handler.RegisterMatchUpdateNestHandlers()
	f := newRecipeNetwork(t, handler.RegisterMatchroomOpenNestHandlersOn, handler.RegisterRoomOpenNestHandlersOn, handler.RegisterRoomJoinNestHandlersOn, handler.RegisterTurnStartNestHandlersOn, handler.RegisterTurnEndNestHandlersOn, handler.RegisterTurnViewNestHandlersOn)
	// 两名新号经登录入口进来（进服票据握手 → 新建，名字进档案 → 进入）；玩家号按握手先后是 42、43。
	a, b := f.login(t, "first", "First"), f.login(t, "second", "Second")

	// 两个客户端真实发 MatchEnqueue，match 使用正式内存 Store；房号使用 mongotest 跑正式计数器/映射代码。
	match, err := svcmatch.NewMemoryStore(svcmatch.Config{})
	if err != nil {
		t.Fatal(err)
	}
	rooms, err := matchroom.FromRegistry(f.registry)
	if err != nil {
		t.Fatal(err)
	}
	client, _ := app.Lookup[nest.Client](f.registry, mods.ModNest)
	access, _ := app.Lookup[*entity.ManagerAccess](f.registry, mods.ModEntityRuntime)
	runtime, err := matchmaking.NewRuntime(client, match, rooms, 1000, func(id int64) bool {
		full, _ := entity.BuildEntityID(id, playerentity.EntityKindPlayer)
		return access.Manager().Get(full) != nil
	})
	if err != nil {
		t.Fatal(err)
	}
	if err := f.registry.Register(matchmaking.Capability, runtime); err != nil {
		t.Fatal(err)
	}
	for _, conn := range []transport.Conn{a, b} {
		enqueued := recipeRPC(t, conn, {{ID:protocol:MatchEnqueue}}, &pb.MatchEnqueueRequest{Sequence: 1}, pb.MarshalMatchEnqueueRequest, pb.UnmarshalMatchmakingResponse)
		if enqueued.Code != 0 || enqueued.Phase != "queued" {
			t.Fatalf("enqueue: %+v", enqueued)
		}
	}
	if err := runtime.Step(context.Background()); err != nil {
		t.Fatal(err)
	}
	matched := recipeRPC(t, a, {{ID:protocol:MatchStatus}}, &pb.MatchStatusRequest{}, pb.MarshalMatchStatusRequest, pb.UnmarshalMatchmakingResponse)
	other := recipeRPC(t, b, {{ID:protocol:MatchStatus}}, &pb.MatchStatusRequest{}, pb.MarshalMatchStatusRequest, pb.UnmarshalMatchmakingResponse)
	if matched.Code != 0 || matched.Phase != "matched" || matched.RoomID <= 0 || matched.RoomID != other.RoomID {
		t.Fatalf("matching: %+v %+v", matched, other)
	}
	roomID := matched.RoomID
	first := recipeRPC(t, a, {{ID:protocol:RoomJoin}}, &pb.RoomJoinRequest{RoomID: roomID}, pb.MarshalRoomJoinRequest, pb.UnmarshalRoomJoinResponse)
	second := recipeRPC(t, b, {{ID:protocol:RoomJoin}}, &pb.RoomJoinRequest{RoomID: roomID}, pb.MarshalRoomJoinRequest, pb.UnmarshalRoomJoinResponse)
	if first.Code != 0 || second.Code != 0 || first.Info.HostID != 42 || len(second.Info.Seats) != 2 {
		t.Fatalf("join: %+v %+v", first, second)
	}
	start := recipeRPC(t, a, {{ID:protocol:TurnStart}}, &pb.TurnStartRequest{RoomID: roomID, Epoch: first.Info.Epoch, TurnMillis: 30000, MaxTurns: 2}, pb.MarshalTurnStartRequest, pb.UnmarshalTurnStartResponse)
	if start.Code != 0 || start.Info.ActorID != 42 || start.Info.Round != 1 {
		t.Fatalf("start: %+v", start)
	}
	end := recipeRPC(t, a, {{ID:protocol:TurnEnd}}, &pb.TurnEndRequest{RoomID: roomID, Epoch: first.Info.Epoch, Round: 1, Sequence: 1}, pb.MarshalTurnEndRequest, pb.UnmarshalTurnEndResponse)
	if end.Code != 0 || end.Info.ActorID != 43 || end.Info.Round != 2 {
		t.Fatalf("advance: %+v", end)
	}
	repeated := recipeRPC(t, a, {{ID:protocol:TurnEnd}}, &pb.TurnEndRequest{RoomID: roomID, Epoch: first.Info.Epoch, Round: 1, Sequence: 1}, pb.MarshalTurnEndRequest, pb.UnmarshalTurnEndResponse)
	if repeated.Code != 0 || repeated.Info.Round != 2 {
		t.Fatalf("replay consumed next turn: %+v", repeated)
	}
	finished := recipeRPC(t, b, {{ID:protocol:TurnEnd}}, &pb.TurnEndRequest{RoomID: roomID, Epoch: second.Info.Epoch, Round: 2, Sequence: 1}, pb.MarshalTurnEndRequest, pb.UnmarshalTurnEndResponse)
	if finished.Code != 0 || finished.Info.Status != 2 {
		t.Fatalf("finish: %+v", finished)
	}
}
