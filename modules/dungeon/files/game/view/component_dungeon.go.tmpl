package view

// Dungeon 是 Dungeon 组件对 game/ 下其它包公开的方法（实现在 game/components/dungeon，语义见那里）；只在宿主被 Nest 锁住期间调用。
type Dungeon interface {
	PlayerID() int64
	Counts(season int64) DungeonClaimResult
	Claim(runID, season, amount, resolvedAt, now int64) (DungeonClaimResult, error)
}

// DungeonHolder 是“带有 Dungeon 组件”的小接口：只要这个组件的组件包、钩子与联动收它；实体接口（entity_<实体>.go，生成）嵌入它。
type DungeonHolder interface{ Dungeon() Dungeon }

type DungeonClaimResult struct {
	Claimed      bool
	ExpGranted   int64
	LevelsGained int32
	Season       int64
	Clears       int64
	TotalClears  int64
	BoardPending bool
}
