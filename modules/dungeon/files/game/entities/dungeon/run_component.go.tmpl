package dungeon

import (
	"{{MODULE}}/game/components/dungeonrun"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:DungeonRun}}
const CompTypeDungeonRun entity.ComponentType = {{ID:component:DungeonRun}}

// DungeonRunComponent 是 game/components/dungeonrun 的组件在 Dungeon 上的名字（生成接线与 handler 用它）；业务在那个包里。
type DungeonRunComponent = dungeonrun.Component

// IDungeonRunEntity is the narrow lock-safe view for Nest handlers using this
// component. The generated Entity wire implements the getter.
type IDungeonRunEntity interface {
	entity.IThreadSafeEntity
	DungeonRunComp() *DungeonRunComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeDungeonRun, dungeonrun.NewComponent)
}
