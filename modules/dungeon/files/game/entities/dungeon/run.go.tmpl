package dungeon

import (
	"fmt"
	"strconv"
	"sync"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/gameplay/level"

	apperrors "{{MODULE}}/internal/errors"
	logic "{{MODULE}}/game/dungeon"
)

var program = sync.OnceValues(logic.Program)

func (run *Dungeon) machine() (*level.LevelComponent, error) {
	p, err := program()
	if err != nil {
		return nil, err
	}
	return level.NewLevelComponent(run.level, p)
}

// OnInitFinish 在新建和冷加载后验证两份DAO身份与定义，缺失一半存档不能当成新关卡继续运行。
func (run *Dungeon) OnInitFinish(*entity.EntityCreateParam) error {
	if run.dao.Id() != run.ID() || run.level.Id() != run.ID() {
		return fmt.Errorf("dungeon: aggregate identity mismatch")
	}
	machine, err := run.machine()
	if err != nil {
		return err
	}
	s := machine.Snapshot()
	if run.dao.GetOwnerID() == 0 {
		if s.Instance != "" || run.dao.GetSeason() != 0 || run.dao.GetExpReward() != 0 || run.dao.GetResolvedAtUnix() != 0 {
			return fmt.Errorf("dungeon: incomplete unopened aggregate")
		}
		return nil
	}
	if s.Instance != run.instance() || s.Epoch != 1 || run.dao.GetOwnerID() <= 0 || run.dao.GetSeason() <= 0 || run.dao.GetExpReward() <= 0 {
		return fmt.Errorf("dungeon: aggregate state mismatch")
	}
	if (s.Phase == level.Finishing) != (run.dao.GetResolvedAtUnix() > 0) {
		return fmt.Errorf("dungeon: terminal timestamp mismatch")
	}
	return nil
}
func (run *Dungeon) instance() string { return "dungeon-" + strconv.FormatInt(run.ID(), 10) }

// Open 同ID重试只读；owner/season不同是冲突，ID不可重用于第二局。
func (run *Dungeon) Open(playerID, season, now int64) (logic.Snapshot, error) {
	if playerID <= 0 || season <= 0 || now <= 0 {
		return logic.Snapshot{}, apperrors.ErrDungeonInvalid
	}
	if run.dao.GetOwnerID() != 0 {
		if run.dao.GetOwnerID() != playerID || run.dao.GetSeason() != season {
			return logic.Snapshot{}, apperrors.ErrDungeonInvalid
		}
		return run.snapshot()
	}
	machine, err := run.machine()
	if err != nil {
		return logic.Snapshot{}, err
	}
	if err := machine.Initialize(run.instance(), 1, now); err != nil {
		return logic.Snapshot{}, err
	}
	if err := machine.Start(now); err != nil {
		return logic.Snapshot{}, err
	}
	run.dao.SetOwnerID(playerID)
	run.dao.SetSeason(season)
	run.dao.SetExpReward(logic.ClearExp)
	return run.snapshot()
}

func (run *Dungeon) snapshot() (logic.Snapshot, error) {
	machine, err := run.machine()
	if err != nil {
		return logic.Snapshot{}, err
	}
	view := machine.Project()
	result := logic.Snapshot{Instance: view.Instance, Epoch: view.Epoch, Revision: view.Revision, Phase: string(view.Phase), Result: view.Result, ResolvedAtUnix: run.dao.GetResolvedAtUnix(), Kills: view.Variables["global/kills"].Int}
	for _, stage := range view.Stages {
		if stage.ID != "deadline" {
			result.Stage = stage.ID
		}
	}
	return result, nil
}
func (run *Dungeon) resolve(machine *level.LevelComponent, now int64) {
	if machine.Snapshot().Phase == level.Finishing && run.dao.GetResolvedAtUnix() == 0 {
		run.dao.SetResolvedAtUnix(now / 1000)
	}
}

// Defeated 只接受可信战斗来源，源序号与内容摘要由level校验；错误必须交回Nest撤回整笔推进。
func (run *Dungeon) Defeated(instance string, epoch uint64, source string, sequence uint64, enemy string, now int64) (logic.Snapshot, error) {
	machine, err := run.machine()
	if err != nil {
		return logic.Snapshot{}, err
	}
	if instance != run.instance() || epoch != 1 {
		return logic.Snapshot{}, level.ErrStale
	}
	// 认识哪些敌人只由规则文件决定（logic.KnownEnemy 读关卡定义），这里不另写一份名单。
	if !logic.KnownEnemy(enemy) {
		return logic.Snapshot{}, apperrors.ErrDungeonInvalid
	}
	before := machine.Snapshot().Phase
	if err := machine.Advance(now); err != nil {
		return logic.Snapshot{}, err
	}
	// 超时这笔要提交失败终局，不让随后不再可接收的事件错误把超时撤回。
	if before == level.Running && machine.Snapshot().Phase == level.Finishing {
		run.resolve(machine, now)
		return run.snapshot()
	}
	if err := machine.Handle(level.Event{Instance: instance, Epoch: epoch, Source: source, Sequence: sequence, Kind: logic.EventEnemyDefeated, Fields: map[string]level.Value{logic.FieldEnemy: level.String(enemy)}}, now); err != nil {
		return logic.Snapshot{}, err
	}
	run.resolve(machine, now)
	return run.snapshot()
}

func (run *Dungeon) View(playerID, now int64) (logic.Snapshot, error) {
	if playerID <= 0 || run.dao.GetOwnerID() != playerID {
		return logic.Snapshot{}, apperrors.ErrDungeonOwner
	}
	machine, err := run.machine()
	if err != nil {
		return logic.Snapshot{}, err
	}
	if err := machine.Advance(now); err != nil {
		return logic.Snapshot{}, err
	}
	run.resolve(machine, now)
	return run.snapshot()
}

// Reward 只在同时锁住Dungeon和Player的领奖事务里调用，奖励依据持久关卡结果而不是请求中的success。
func (run *Dungeon) Reward(playerID int64) (season, amount, resolvedAt int64, err error) {
	if run.dao.GetOwnerID() != playerID {
		return 0, 0, 0, apperrors.ErrDungeonOwner
	}
	machine, err := run.machine()
	if err != nil {
		return 0, 0, 0, err
	}
	s := machine.Snapshot()
	if s.Phase != level.Finishing || s.Result != "success" {
		return 0, 0, 0, apperrors.ErrDungeonUnfinished
	}
	return run.dao.GetSeason(), run.dao.GetExpReward(), run.dao.GetResolvedAtUnix(), nil
}
