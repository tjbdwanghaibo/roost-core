package player

import (
	"{{MODULE}}/game/components/dungeon"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:Dungeon}}
const CompTypeDungeon entity.ComponentType = {{ID:component:Dungeon}}

// DungeonComponent 是 game/components/dungeon 的组件在 Player 上的名字（生成接线与 handler 用它）；业务在那个包里。
type DungeonComponent = dungeon.Component

type IDungeonRewardEntity interface {
	entity.IThreadSafeEntity
	DungeonComp() *DungeonComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeDungeon, dungeon.NewComponent)
}
