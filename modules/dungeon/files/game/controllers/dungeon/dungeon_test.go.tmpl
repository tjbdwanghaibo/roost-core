func TestDungeonClaimWindowUsesFrozenAuthorityAndInclusiveBoundary(t *testing.T) {
	f := newDungeonFixture(t)
	a := f.clear(t, 1001, 1)
	f.clear(t, 1002, 1)
	f.now.Add(logic.ClaimWindowSeconds * 1000)
	if a2 := f.event(t, 1001, a, 3, "boss"); a2.ResolvedAtUnix != a.ResolvedAtUnix {
		t.Fatal("replay renewed resolution time")
	}
	if result, err := f.claim(1001); err != nil || !result.Claimed {
		t.Fatalf("exact boundary=%+v %v", result, err)
	}
	f.now.Add(1000)
	if _, err := f.claim(1002); !errors.Is(err, apperrors.ErrDungeonWindow) {
		t.Fatalf("expired claim accepted: %v", err)
	}
	f.assertPlayer(t, 1, 1)
}
func TestDungeonLedgerPruneWaitsForGrace(t *testing.T) {
	f := newDungeonFixture(t)
	f.clear(t, 1001, 1)
	if _, err := f.claim(1001); err != nil {
		t.Fatal(err)
	}
	f.now.Add((logic.ClaimWindowSeconds + logic.LedgerPruneGraceSeconds) * 1000)
	f.clear(t, 1002, 1)
	if _, err := f.claim(1002); err != nil {
		t.Fatal(err)
	}
	f.assertPlayer(t, 2, 2)
	f.now.Add(1000)
	f.clear(t, 1003, 1)
	if _, err := f.claim(1003); err != nil {
		t.Fatal(err)
	}
	f.assertPlayer(t, 3, 2)
	if _, err := f.claim(1001); !errors.Is(err, apperrors.ErrDungeonWindow) {
		t.Fatalf("pruned run could reclaim=%v", err)
	}
}
