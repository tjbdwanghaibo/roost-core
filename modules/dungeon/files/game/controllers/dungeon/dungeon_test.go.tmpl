	t.Helper()
	id, err := entity.BuildEntityID(dungeonPlayer, player.EntityKindPlayer)
	if err != nil {
		t.Fatal(err)
	}
	if err := f.engine.RunLocal(context.Background(), func() {
		p := f.manager.Get(id).(*player.Player)
		p.GetMutex().Lock()
		defer p.GetMutex().Unlock()
		fn(p)
	}); err != nil {
