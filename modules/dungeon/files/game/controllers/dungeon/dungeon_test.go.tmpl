const dungeonNow int64 = 1900000000
const dungeonPlayer int64 = 96101

type dungeonCommitter struct {
	writes atomic.Int64
	reject atomic.Bool
	mu     sync.Mutex
	last   dataengine.CommitRecord
}

func (c *dungeonCommitter) Commit(_ context.Context, record dataengine.CommitRecord) error {
	if c.reject.Load() {
		return errors.New("injected dungeon commit rejection")
	}
	c.mu.Lock()
	c.last = record
	c.mu.Unlock()
	c.writes.Add(1)
	return nil
}
func (c *dungeonCommitter) record() dataengine.CommitRecord {
	c.mu.Lock()
	defer c.mu.Unlock()
	return c.last
}

type dungeonFixture struct {
	controller *Controller
	manager    *entity.EntityManager
	engine     *nest.NestMgr
	commit     *dungeonCommitter
	now        atomic.Int64
}

// 正式EntityManager、生命周期、生成Sender、Nest与DAO链路；提交器只验收离线事务，不冒充Mongo/WAL部署验收。
func newDungeonFixture(t *testing.T) *dungeonFixture {
	t.Helper()
	player.RegisterEntity()
	runentity.RegisterEntity()
	handler.RegisterDungeonCountsNestHandlers()
	f := &dungeonFixture{manager: entity.NewEntityManager(), commit: &dungeonCommitter{}}
	f.now.Store(dungeonNow * 1000)
	clock.SetSource(func() time.Time { return time.UnixMilli(f.now.Load()) })
	t.Cleanup(func() { clock.SetSource(nil) })
	for _, id := range []int64{dungeonPlayer, dungeonPlayer + 1} {
		value, err := entity.BuildEntity(&entity.EntityCreateParam{IsCreate: true, UniqueID: id, Kind: player.EntityKindPlayer})
		if err != nil {
			t.Fatal(err)
		}
		f.manager.Add(value)
	}
	f.start(t)
	t.Cleanup(func() {
		if err := f.engine.Shutdown(context.Background()); err != nil {
			t.Error(err)
		}
	})
	return f
}
func (f *dungeonFixture) start(t *testing.T) {
	t.Helper()
	access := entity.NewManagerAccess(f.manager)
	f.engine = nest.NewEngine(nest.NestOptionWithGetter(access), nest.NestOptionWithTransactionCommitter(f.commit), nest.NestOptionWithWorkerPools(nest.WorkerPoolConfig{Workers: 2, QueueCap: 64}, nest.WorkerPoolConfig{}, nest.WorkerPoolConfig{}))
	if err := handler.RegisterDungeonNestHandlersOn(f.engine); err != nil {
		t.Fatal(err)
	}
	if err := f.engine.Start(); err != nil {
		t.Fatal(err)
	}
	registry := app.NewRegistry(viper.New())
	for name, value := range map[app.ModName]any{app.ModName("nest"): nest.Client(f.engine), mods.ModEntityRuntime: access} {
		if err := registry.Register(name, value); err != nil {
			t.Fatal(err)
		}
	}
	var err error
	f.controller, err = FromRegistry(registry)
	if err != nil {
		t.Fatal(err)
	}
}
