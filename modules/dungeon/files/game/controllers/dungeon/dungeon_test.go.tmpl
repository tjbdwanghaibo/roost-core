func TestDungeonConcurrentClaimGrantsOnce(t *testing.T) {
	f := newDungeonFixture(t)
	f.clear(t, 1001, 1)
	var wg sync.WaitGroup
	results := make(chan logic.ClaimResult, 8)
	failures := make(chan error, 8)
	for i := 0; i < 8; i++ {
		wg.Add(1)
		go func() { defer wg.Done(); result, err := f.claim(1001); results <- result; failures <- err }()
	}
	wg.Wait()
	close(results)
	close(failures)
	for err := range failures {
		if err != nil {
			t.Fatal(err)
		}
	}
	count := 0
	for result := range results {
		if result.Claimed {
			count++
		}
	}
	if count != 1 {
		t.Fatalf("claim winners=%d", count)
	}
	f.assertPlayer(t, 1, 1)
}
func TestDungeonColdRestorePreservesProgressAndMultiEntityClaim(t *testing.T) {
	f := newDungeonFixture(t)
	s := f.open(t, 1001, 1)
	s = f.event(t, 1001, s, 1, "minion")
	f.restart(t)
	if got := f.view(t, 1001); got != s {
		t.Fatalf("progress not restored=%+v", got)
	}
	s = f.event(t, 1001, s, 2, "minion")
	s = f.event(t, 1001, s, 3, "boss")
	f.restart(t)
	if got := f.view(t, 1001); got != s {
		t.Fatal("terminal not restored")
	}
	if a, err := f.claim(1001); err != nil || !a.Claimed {
		t.Fatalf("cold claim=%+v %v", a, err)
	}
	f.restart(t)
	writes := f.commit.writes.Load()
	if a, err := f.claim(1001); err != nil || a.Claimed || f.commit.writes.Load() != writes {
		t.Fatalf("cold duplicate=%+v %v", a, err)
	}
	f.assertPlayer(t, 1, 1)
}
func TestDungeonColdRestoreRejectsHalfAggregateAndIdentityMismatch(t *testing.T) {
	f := newDungeonFixture(t)
	f.clear(t, 1001, 1)
	for _, a := range f.documents(t) {
		if a.kind != runentity.EntityKindDungeon {
			continue
		}
		original := a.documents[level.CollectionName]
		delete(a.documents, level.CollectionName)
		if _, err := restoreDungeonAggregate(a); err == nil {
			t.Fatal("missing official LevelDAO accepted")
		}
		a.documents[level.CollectionName] = original
		a.id++
		if _, err := restoreDungeonAggregate(a); err == nil {
			t.Fatal("cross-run DAO identity accepted")
		}
	}
}
func TestDungeonPBEndpointsAndDeadlineCannotSupplySuccess(t *testing.T) {
	f := newDungeonFixture(t)
	f.open(t, 1001, 1)
	raw, err := pb.MarshalDungeonClaimRequest(&pb.DungeonClaimRequest{RunID: 1001})
	if err != nil {
		t.Fatal(err)
	}
	request, err := pb.UnmarshalDungeonClaimRequest(raw)
	if err != nil {
		t.Fatal(err)
	}
	response, err := f.controller.HandleDungeonClaim(&playeraccess.Context{PlayerID: dungeonPlayer}, request)
	if err != nil || response.Code == 0 || response.Claimed {
		t.Fatalf("unfinished PB claim=%+v %v", response, err)
	}
	f.now.Add(30 * 60 * 1000)
	view, err := f.controller.HandleDungeonView(&playeraccess.Context{PlayerID: dungeonPlayer}, &pb.DungeonViewRequest{RunID: 1001})
	if err != nil || view.Code != 0 || view.Info.Result != "failed" {
		t.Fatalf("deadline=%+v %v", view, err)
	}
	if _, err := f.controller.HandleDungeonClaim(nil, request); err == nil {
		t.Fatal("unauthenticated request accepted")
	}
	f.assertPlayer(t, 0, 0)
	f.clear(t, 1002, 1)
	response, err = f.controller.HandleDungeonClaim(&playeraccess.Context{PlayerID: dungeonPlayer}, &pb.DungeonClaimRequest{RunID: 1002})
	if err != nil || response.Code != 0 || !response.Claimed || response.ExpGranted != 100 {
		t.Fatalf("successful PB claim=%+v %v", response, err)
	}
	f.assertPlayer(t, 1, 1)
}

// dungeonScenarioEnemy 是“这份规则认识的一种敌人”：缺省取缺省规则里的 minion；
// TestDungeonNewEnemyOnlyNeedsTheRulesFile 换一份规则文件重跑时用环境变量指到新加的敌人上。
func dungeonScenarioEnemy() string {
	if enemy := os.Getenv("DUNGEON_SCENARIO_ENEMY"); enemy != "" {
		return enemy
	}
	return "minion"
}

// 敌人种类只有规则文件一个来源：规则里出现的被接受，规则里没有的答 dungeon_invalid、不写、不占事件序号。
func TestDungeonEnemyAdmissionFollowsRules(t *testing.T) {
	f := newDungeonFixture(t)
	s := f.open(t, 1001, 1)
	writes := f.commit.writes.Load()
	if _, err := f.controller.Defeated(context.Background(), 1001, s.Instance, s.Epoch, "battle", 1, "not-in-the-rules"); !errors.Is(err, apperrors.ErrDungeonInvalid) {
		t.Fatalf("enemy outside the rules: %v", err)
	}
	if f.commit.writes.Load() != writes {
		t.Fatal("refused enemy wrote")
	}
	enemy := dungeonScenarioEnemy()
	if _, err := f.controller.Defeated(context.Background(), 1001, s.Instance, s.Epoch, "battle", 1, enemy); err != nil {
		t.Fatalf("enemy %q named by the rules refused: %v", enemy, err)
	}
	if f.commit.writes.Load() != writes+1 {
		t.Fatalf("enemy %q named by the rules did not advance the level", enemy)
	}
}

// 加一种敌人只改规则文件：用 overlay 换一份多了 elite 触发器的 rules.go（别的文件一个字不动），
// 可信战斗事实里的 elite 就被接受。
func TestDungeonNewEnemyOnlyNeedsTheRulesFile(t *testing.T) {
	dir, err := os.Getwd()
	if err != nil {
		t.Fatal(err)
	}
	path, err := filepath.Abs(filepath.Join(dir, "../..", "dungeon/rules.go"))
	if err != nil {
		t.Fatal(err)
	}
	source, err := os.ReadFile(path)
	if err != nil {
		t.Fatal(err)
	}
	const anchor = `{ID: "next", Event: EventEnemyDefeated`
	const elite = `{ID: "elite", Event: EventEnemyDefeated, Conditions: []level.Condition{enemyIs("elite")}, Actions: []level.Action{{Kind: "add", Scope: level.Global, Name: "kills", Value: level.Literal(level.Int(2))}}},
				`
	if strings.Count(string(source), anchor) != 1 {
		t.Fatal("rules anchor changed: dungeon/rules.go")
	}
	scratch := t.TempDir()
	replacement := filepath.Join(scratch, "rules.go")
	if err := os.WriteFile(replacement, []byte(strings.Replace(string(source), anchor, elite+anchor, 1)), 0644); err != nil {
		t.Fatal(err)
	}
	data, _ := json.Marshal(map[string]map[string]string{"Replace": {path: replacement}})
	overlay := filepath.Join(scratch, "overlay.json")
	if err := os.WriteFile(overlay, data, 0644); err != nil {
		t.Fatal(err)
	}
	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
	defer cancel()
	check := exec.CommandContext(ctx, "go", "test", "-mod=mod", "-count=1", "-overlay", overlay, "-run", "^TestDungeonEnemyAdmissionFollowsRules$", ".")
	check.Env = append(os.Environ(), "GOWORK=off", "DUNGEON_SCENARIO_ENEMY=elite")
	if out, err := check.CombinedOutput(); err != nil {
		t.Fatalf("an enemy added only in the rules file was not accepted: %v\n%s", err, out)
	}
}
func TestDungeonMutationsDetectDuplicateAndWindowRegression(t *testing.T) {
	dir, err := os.Getwd()
	if err != nil {
		t.Fatal(err)
	}
	cases := []struct{ path, before, after, test, marker string }{
		{"components/dungeon/dungeon.go", "if _, ok := state.GetClaims(runID); ok {", "if _, ok := state.GetClaims(runID); ok && false {", "TestDungeonClaimDuplicateGrantsExactlyOnce", "duplicate reward escaped"},
		{"dungeon/rules.go", "return now-resolvedAt > ClaimWindowSeconds", "return now-resolvedAt > ClaimWindowSeconds+1", "TestDungeonClaimWindowUsesFrozenAuthorityAndInclusiveBoundary", "expired claim accepted"},
	}
	for _, c := range cases {
		path, err := filepath.Abs(filepath.Join(dir, "../..", c.path))
		if err != nil {
			t.Fatal(err)
		}
		source, err := os.ReadFile(path)
		if err != nil {
			t.Fatal(err)
		}
		if strings.Count(string(source), c.before) != 1 {
			t.Fatalf("mutation anchor changed: %s", c.path)
		}
		scratch := t.TempDir()
		replacement := filepath.Join(scratch, "mutant.go")
		if err := os.WriteFile(replacement, []byte(strings.Replace(string(source), c.before, c.after, 1)), 0644); err != nil {
			t.Fatal(err)
		}
		data, _ := json.Marshal(map[string]map[string]string{"Replace": {path: replacement}})
		overlay := filepath.Join(scratch, "overlay.json")
		if err := os.WriteFile(overlay, data, 0644); err != nil {
			t.Fatal(err)
		}
		ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
		compile := exec.CommandContext(ctx, "go", "test", "-mod=mod", "-overlay", overlay, "-run", "^$", ".")
		compile.Env = append(os.Environ(), "GOWORK=off")
		if out, err := compile.CombinedOutput(); err != nil {
			cancel()
			t.Fatalf("mutant did not compile %s: %v\n%s", c.path, err, out)
		}
		check := exec.CommandContext(ctx, "go", "test", "-mod=mod", "-count=1", "-overlay", overlay, "-run", "^"+c.test+"$", ".")
		check.Env = append(os.Environ(), "GOWORK=off")
		out, err := check.CombinedOutput()
		cancel()
		if err == nil || !strings.Contains(string(out), c.marker) {
			t.Fatalf("mutant survived %s: %v\n%s", c.path, err, out)
		}
	}
}
