func (f *dungeonFixture) assertPlayer(t *testing.T, clears int64, claims int) {
	t.Helper()
	f.player(t, func(p *player.Player) {
		if p.ProfileComp().Level() != int32(clears) || p.ProfileComp().Exp() != 0 || p.Dao().GetDungeon().GetTotalClears() != clears || p.Dao().GetDungeon().ClaimsLen() != claims {
			t.Errorf("reward/ledger drift: level=%d clears=%d claims=%d", p.ProfileComp().Level(), p.Dao().GetDungeon().GetTotalClears(), p.Dao().GetDungeon().ClaimsLen())
		}
	})
}

type dungeonDocument struct {
	raw     []byte
	schema  uint32
	version uint64
}
type dungeonAggregate struct {
	id        int64
	kind      entity.EntityKind
	documents map[string]dungeonDocument
}

func (f *dungeonFixture) documents(t *testing.T) []dungeonAggregate {
	t.Helper()
	out := []dungeonAggregate{}
	if err := f.engine.RunLocal(context.Background(), func() {
		f.manager.Range(func(value entity.IThreadSafeEntity) bool {
			value.GetMutex().Lock()
			defer value.GetMutex().Unlock()
			a := dungeonAggregate{id: value.ID(), kind: entity.ResolveEntityID(value.ID()).Kind, documents: map[string]dungeonDocument{}}
			value.(entity.Guardable).RangeDao(func(dao entity.DaoInterface) {
				// 所有生成/手写DAO共用正式MutationParticipant快照，不按具体类型分支或遗漏附加DAO。
				participant, ok := dao.(nest.MutationParticipant)
				if !ok {
					t.Errorf("DAO %T has no persistence participant", dao)
					return
				}
				mutation, err := participant.PrepareMutation(nest.PersistChange{Mask: dataengine.AllFields})
				if err != nil {
					t.Error(err)
					return
				}
				version := dao.(interface{ DirtyTracker() *dataengine.Tracker }).DirtyTracker().Version()
				if mutation.Kind != dataengine.MutationPut || mutation.Key.ID != a.id || mutation.Key.ID != dao.Id() || mutation.Key.Database != dao.DbName() || mutation.Key.Resource != dao.CollName() || mutation.Schema != dao.(dataengine.Descriptor).SchemaVersion() || mutation.ExpectedVersion != version || mutation.NextVersion != version+1 || len(mutation.Data) == 0 {
					t.Errorf("invalid full persistence snapshot for %T: key=%+v schema=%d version=%d/%d", dao, mutation.Key, mutation.Schema, mutation.ExpectedVersion, mutation.NextVersion)
					return
				}
				// 这里只冻结当前版本，不AcceptMutation，也不把伪造的下一版本当成已提交事实。
				a.documents[dao.CollName()] = dungeonDocument{raw: mutation.Data, schema: mutation.Schema, version: mutation.ExpectedVersion}
			})
			out = append(out, a)
			return true
		})
	}); err != nil {
		t.Fatal(err)
	}
	return out
}

// 与仓库相同顺序：每份DAO先SetId与RestorePersisted，再BuildEntity绑定aggregate及执行OnInitFinish。
func restoreDungeonAggregate(a dungeonAggregate) (entity.IThreadSafeEntity, error) {
	daos := map[string]entity.DaoInterface{}
	for _, build := range entity.GetEntityBuilderParam(a.kind).DaoBuilders {
		dao := build()
		dao.SetId(a.id)
		if d, ok := a.documents[dao.CollName()]; ok {
			if err := dao.(entity.PersistedDaoLoader).RestorePersisted(d.raw, d.schema, d.version); err != nil {
				return nil, err
			}
		}
		daos[dao.CollName()] = dao
	}
	return entity.BuildEntity(&entity.EntityCreateParam{IsCreate: false, Id: a.id, Kind: a.kind, Dao: daos})
}
func (f *dungeonFixture) restart(t *testing.T) {
	t.Helper()
	saved := f.documents(t)
	if err := f.engine.Shutdown(context.Background()); err != nil {
		t.Fatal(err)
	}
	f.manager = entity.NewEntityManager()
	for _, a := range saved {
		value, err := restoreDungeonAggregate(a)
		if err != nil {
			t.Fatal(err)
		}
		f.manager.Add(value)
	}
	f.start(t)
}

func TestDungeonOpenPersistsBothOfficialDAOs(t *testing.T) {
	f := newDungeonFixture(t)
	s := f.open(t, 1001, 1)
	record := f.commit.record()
	if s.Instance == "" || s.Epoch != 1 || s.Stage != "waves" || s.Phase != string(level.Running) {
		t.Fatalf("open=%+v", s)
	}
	if len(record.Mutations) != 2 || record.Durability != dataengine.DurabilityStrict {
		t.Fatalf("aggregate commit=%+v", record)
	}
	collections := map[string]bool{}
	for _, m := range record.Mutations {
		collections[m.Key.Resource] = true
	}
	if !collections["dungeon"] || !collections[level.CollectionName] {
		t.Fatalf("missing official DAO=%v", collections)
	}
}
func TestDungeonOpenIsIdempotentAndIDCannotChangeOwner(t *testing.T) {
	f := newDungeonFixture(t)
	first := f.open(t, 1001, 1)
	writes := f.commit.writes.Load()
	second := f.open(t, 1001, 1)
	if first != second || f.commit.writes.Load() != writes {
		t.Fatal("open replay wrote state")
	}
	if _, err := f.controller.Open(context.Background(), 1001, dungeonPlayer+1, 1); err == nil {
		t.Fatal("owner conflict accepted")
	}
	if _, err := f.controller.Open(context.Background(), 1001, dungeonPlayer, 2); err == nil {
		t.Fatal("season conflict accepted")
	}
	f.clear(t, 1002, 1)
	terminal := f.view(t, 1002)
	if s := f.open(t, 1002, 1); s != terminal {
		t.Fatal("finished ID reused")
	}
}
func TestDungeonLevelConditionsRequireWavesBeforeBoss(t *testing.T) {
	f := newDungeonFixture(t)
	s := f.open(t, 1001, 1)
	s = f.event(t, 1001, s, 1, "boss")
	if s.Result != "" || s.Kills != 0 {
		t.Fatal("early boss settled")
	}
	s = f.event(t, 1001, s, 2, "minion")
	if s.Kills != 1 || s.Stage != "waves" {
		t.Fatalf("first=%+v", s)
	}
	s = f.event(t, 1001, s, 3, "minion")
	if s.Kills != 2 || s.Stage != "boss" {
		t.Fatalf("conditions/actions=%+v", s)
	}
	s = f.event(t, 1001, s, 4, "boss")
	if s.Result != "success" || s.ResolvedAtUnix != dungeonNow {
		t.Fatalf("terminal=%+v", s)
	}
}
