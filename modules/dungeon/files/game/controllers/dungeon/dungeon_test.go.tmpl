	s = f.event(t, 1001, s, 2, "minion")
	if _, err := f.controller.Defeated(context.Background(), 1001, s.Instance, s.Epoch, "battle", 1, "minion"); err == nil {
		t.Fatal("stale sequence accepted")
	}
}
