package dbdef

// DungeonDao 是一次不复用ID的单人副本。规则版本由独立LevelDAO保存的DefinitionHash绑定。
//
//roost:dao coll=dungeon db=main
type DungeonDao struct {
	OwnerID   int64 `dao:"nosync" store:"1"`
	Season    int64 `dao:"nosync" store:"2"`
	ExpReward int64 `dao:"nosync" store:"3"`
	// ResolvedAtUnix 只在Level首次进入终局时记录；不接受客户端时间，不被重放改写。
	ResolvedAtUnix int64 `dao:"nosync" store:"4"`
}

// PlayerDungeonState 的Claims最多128条，Clears最多8季；不按数量淘汰仍能领奖的事实。
type PlayerDungeonState struct {
	Claims      map[int64]int64 `store:"1"`
	Clears      map[int64]int64 `store:"2"`
	TotalClears int64           `store:"3"`
}
