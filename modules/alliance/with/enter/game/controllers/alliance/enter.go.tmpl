package alliance

import (
	"context"

	gamelogin "{{MODULE}}/game/login"
	"github.com/tjbdwanghaibo/roost-core/framework/app"
)

func init() { gamelogin.OnEntered("alliance", refreshOnEnter) }
func refreshOnEnter(ctx context.Context, registry *app.Registry, entered gamelogin.Entered) error {
	controller, err := FromRegistry(registry)
	if err != nil {
		return err
	}
	return controller.RefreshMembership(ctx, entered.PlayerID)
}
