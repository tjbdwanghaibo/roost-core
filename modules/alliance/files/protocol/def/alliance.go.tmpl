//go:build protocoldef

package protocoldef

// The alliance endpoints. A alliance lives in the alliance service, not in this
// process: joining and leaving are one alliance RPC each, answered with the
// alliance's new state; founding, donating and claiming the alliance reward also
// change the player's Bag, so they start a saga and answer "accepted" with the
// saga's key (AllianceOpStatus reports how it went); reading a alliance reads its
// Remote mirror. See game/alliance for the rules and the codes.

// FoundAllianceRequest founds a alliance led by this player. The fee (Controller.foundCost
// gold coins, item 9001) is taken by the saga and refunded if the alliance
// service refuses (an invalid name, the player is already in a alliance).
type FoundAllianceRequest struct {
	Name     string `pb:"1"`
	OpenJoin bool   `pb:"2"`
}

// JoinAllianceRequest joins an open alliance by id. The id comes from somewhere
// outside this demo — a list endpoint, a friend, a recruitment board — which
// is deliberately not modelled: the point here is the cross-process join, not
// alliance discovery.
type JoinAllianceRequest struct {
	AllianceID int64 `pb:"1"`
}

// LeaveAllianceRequest leaves the alliance the player is in. A leader transfers the
// leadership first (alliance_leader).
type LeaveAllianceRequest struct{}

// AllianceInfoRequest reads a alliance from its mirror. AllianceID 0 means "the one I
// am in". MinVersion is the Version a write answered with: the read is then
// Monotonic — never older than that write — instead of Cached.
type AllianceInfoRequest struct {
	AllianceID int64 `pb:"1"`
	MinVersion int64 `pb:"2"`
}

// DonateAllianceRequest donates gold coins to the alliance the player is in.
type DonateAllianceRequest struct {
	Amount int32 `pb:"1"`
}

// ClaimAllianceRewardRequest claims this period's alliance reward.
type ClaimAllianceRewardRequest struct{}

// AllianceOpStatusRequest asks how a alliance saga went: Op is found / donate /
// reward, SagaKey the key its start answered with.
type AllianceOpStatusRequest struct {
	Op      string `pb:"1"`
	SagaKey string `pb:"2"`
}

// AllianceResponse is what join, leave and info answer with, and what found,
// donate and claim answer when they are accepted (SagaKey set, nothing else
// yet).
type AllianceResponse struct {
	Code       int32  `pb:"1"`
	Reason     string `pb:"2"`
	AllianceID int64  `pb:"3"`
	Name       string `pb:"4"`
	Members    int32  `pb:"5"`
	// ServedBySID is the alliance service instance that answered a join or
	// leave (each alliance is owned by one instance, found through its route);
	// 0 for a mirror read, which no instance answered.
	ServedBySID int32 `pb:"6"`
	LeaderID    int64 `pb:"7"`
	Funds       int64 `pb:"8"`
	// Version is the alliance's state version: a write's answer carries the
	// version it produced; send it back as AllianceInfoRequest.MinVersion.
	Version int64 `pb:"9"`
	// SagaKey is set when a saga was started (found, donate, claim reward).
	SagaKey string `pb:"10"`
}

// AllianceOpStatusResponse is a alliance saga's state: unknown until the start has
// been consumed, then the coordinator's status (completed, compensated,
// failed, ...), its current step and last error, and the alliance the saga
// founded / donated to / claimed in once known.
type AllianceOpStatusResponse struct {
	Code       int32  `pb:"1"`
	Reason     string `pb:"2"`
	Status     string `pb:"3"`
	Step       int32  `pb:"4"`
	LastError  string `pb:"5"`
	AllianceID int64  `pb:"6"`
}

//roost:protocol group=game handler=alliance
type AllianceProtocol interface {
	//roost:msg id={{ID:protocol:FoundAlliance}}
	FoundAlliance(FoundAllianceRequest) AllianceResponse
	//roost:msg id={{ID:protocol:JoinAlliance}}
	JoinAlliance(JoinAllianceRequest) AllianceResponse
	//roost:msg id={{ID:protocol:AllianceInfo}}
	AllianceInfo(AllianceInfoRequest) AllianceResponse
	//roost:msg id={{ID:protocol:LeaveAlliance}}
	LeaveAlliance(LeaveAllianceRequest) AllianceResponse
	//roost:msg id={{ID:protocol:DonateAlliance}}
	DonateAlliance(DonateAllianceRequest) AllianceResponse
	//roost:msg id={{ID:protocol:ClaimAllianceReward}}
	ClaimAllianceReward(ClaimAllianceRewardRequest) AllianceResponse
	//roost:msg id={{ID:protocol:AllianceOpStatus}}
	AllianceOpStatus(AllianceOpStatusRequest) AllianceOpStatusResponse
}
