func endpointRegistry(t *testing.T) *app.Registry {
	t.Helper()
	cfg := viper.New()
	cfg.Set("sid", 1300)
	r := app.NewRegistry(cfg)
	if err := r.Register(svcaccount.CapabilityName, endpointAccount{}); err != nil {
		t.Fatal(err)
	}
	return r
}
