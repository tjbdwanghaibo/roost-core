// Package alliancerule holds the alliance service's rules that do not belong
// to one entity: what a request receipt is and how a write consults it, which
// errors are business rejections, and the shapes a write answers with.
//
// Ids: an alliance id is a number the service mints from one Mongo counter
// (internal/rpc/alliance wiring.go); it says nothing about which instance
// holds the alliance. A player's AllianceMember has the player's id. Which
// instance owns an entity is only the Remote ownership record, found through
// the route registration (plan §2.7).
//
// The service owns two remote-managed kinds (game/entities/alliance,
// game/entities/alliance_member); its RPC is internal/rpc/alliance. No
// alliance write records an effect: whatever follows a write (the member's
// notice, finishing a guard on another instance, the enemy's side of a war)
// is the service layer's, after the write answered. The design is
// docs/maintenance/FEATURE-2026-11-04-alliance-service.md in roost-core
// (§2.2 entities, §2.3 the four answers, §2.5 one player one alliance, §2.5B
// no effects).
package alliancerule

import (
	"errors"
	"strings"
	"time"
	"unicode"
	"unicode/utf8"

	apperrors "{{MODULE}}/internal/errors"

	"github.com/tjbdwanghaibo/roost-core/infra/base/errcode"
)

// Roles in an alliance. The leader approves, rejects and kicks; every member
// may leave and donate.
const (
	RoleMember int32 = 1
	RoleLeader int32 = 2
)

// Membership changes, as a write reports them (MemberChange) and the member's
// game server is told (the service's MemberNotice).
const (
	MemberJoined = "joined"
	MemberLeft   = "left"
	MemberKicked = "kicked"
)

// MaxWars bounds how many alliances one alliance is at war with.
const MaxWars = 8

// MaxNameBytes bounds an alliance name.
const MaxNameBytes = 48

// ValidateName refuses a name that is empty, too long or carries control or
// invalid bytes. It decides on the bytes alone, so the endpoint can refuse
// before calling the service and the service refuses the same names again.
func ValidateName(name string) error {
	if strings.TrimSpace(name) == "" || len(name) > MaxNameBytes || !utf8.ValidString(name) {
		return errcode.Wrap(apperrors.ErrAllianceName, nil, "name", name)
	}
	for _, r := range name {
		if unicode.IsControl(r) {
			return errcode.Wrap(apperrors.ErrAllianceName, nil, "name", name)
		}
	}
	return nil
}

// rejections is every business rejection the alliance writes record. An error
// that is not one of these (a framework error, a broken invariant) aborts
// the transaction instead and leaves no receipt.
var rejections = []*errcode.IntError{
	apperrors.ErrAllianceName, apperrors.ErrAllianceMissing, apperrors.ErrAllianceFull,
	apperrors.ErrAllianceDenied, apperrors.ErrAllianceMembership, apperrors.ErrAllianceApplication,
	apperrors.ErrAllianceLeader, apperrors.ErrAllianceAmount, apperrors.ErrAllianceCooldown,
	apperrors.ErrAllianceExpired, apperrors.ErrAllianceWar, apperrors.ErrAllianceReward,
}

// IsRejection reports whether err is an alliance business rejection.
func IsRejection(err error) bool {
	for _, rejection := range rejections {
		if errors.Is(err, rejection) {
			return true
		}
	}
	return false
}

// Rejection rebuilds the rejection a receipt recorded, so a request fails
// with the same error (errors.Is holds) whether it was decided now or replayed.
func Rejection(code int32) error {
	for _, rejection := range rejections {
		if rejection.Code() == code {
			return rejection
		}
	}
	return errcode.Remote(code, "", "alliance: recorded rejection")
}

// Receipt is what one request did. Code 0 is success, otherwise the business
// rejection's code. Version is the entity state version the write produced
// (the version the Remote commit assigns: admission base + 1); show the
// write's result from it and read mirrors no older than it. Subject is the
// request's result id: the alliance founded, the player admitted, the new
// leader.
type Receipt struct {
	Code    int32
	Version int64
	Subject int64
	AtUnix  int64
}

// Outcome is a write's answer: its receipt, and whether it was replayed from
// an earlier delivery of the same request id rather than executed now.
type Outcome struct {
	Receipt
	Replayed bool
}

// Err is the outcome as an error: nil for success, the recorded rejection
// otherwise.
func (o Outcome) Err() error {
	if o.Code == 0 {
		return nil
	}
	return Rejection(o.Code)
}

// ReceiptStore is where an entity keeps its receipts: its DAO's Requests map,
// adapted by the entity's component.
type ReceiptStore interface {
	Receipt(requestID string) (Receipt, bool)
	PutReceipt(requestID string, receipt Receipt)
	DeleteReceipt(requestID string)
	RangeReceipts(func(requestID string, receipt Receipt) bool)
}

// DefaultReceiptRetention is how long a receipt is kept (alliance.receipt_retention),
// the same default as the saga step receipts: longer than any caller keeps
// retrying one request.
const DefaultReceiptRetention = 168 * time.Hour

// maxPrunePerCommit bounds how many expired receipts one write removes, so
// pruning never makes a write's WAL record large.
const maxPrunePerCommit = 16

// Execute runs one write under the entity's Nest lock, with its receipt:
//
//  1. a receipt for requestID already exists: replay it, run nothing;
//  2. run apply. It must check everything before it changes anything (a
//     rejection has to leave no partial change, because the transaction
//     commits to keep the receipt), and record effects last;
//  3. success or a business rejection: write the receipt (and prune a few
//     expired ones) in the same transaction, and return the outcome with a
//     nil error so the transaction commits;
//  4. any other error: return it, so the transaction rolls back and no
//     receipt is written — the request was not decided.
//
// baseVersion is the entity's state version at admission; the commit
// produces baseVersion + 1.
func Execute(store ReceiptStore, requestID string, baseVersion, nowUnix int64, retention time.Duration, apply func() (int64, error)) (Outcome, error) {
	if requestID == "" {
		return Outcome{}, errors.New("alliancerule: request id is required")
	}
	if receipt, ok := store.Receipt(requestID); ok {
		return Outcome{Receipt: receipt, Replayed: true}, nil
	}
	subject, err := apply()
	var code int32
	if err != nil {
		if !IsRejection(err) {
			return Outcome{}, err
		}
		code = errcode.CodeOf(err)
	}
	receipt := Receipt{Code: code, Version: baseVersion + 1, Subject: subject, AtUnix: nowUnix}
	store.PutReceipt(requestID, receipt)
	prune(store, requestID, nowUnix-int64(retention/time.Second))
	return Outcome{Receipt: receipt}, nil
}

// prune removes at most maxPrunePerCommit receipts older than cutoff, never
// the one just written.
func prune(store ReceiptStore, keep string, cutoff int64) {
	var expired []string
	store.RangeReceipts(func(requestID string, receipt Receipt) bool {
		if requestID != keep && receipt.AtUnix < cutoff {
			expired = append(expired, requestID)
		}
		return len(expired) < maxPrunePerCommit
	})
	for _, requestID := range expired {
		store.DeleteReceipt(requestID)
	}
}

// MemberView is one member as a write answers it.
type MemberView struct {
	PlayerID     int64
	Role         int32
	Contribution int64
}

// View is the alliance as a write or Info answers it — and as the game
// builds it from the alliance mirror (AllianceMirror.View), so the game shows
// a write's result from the reply and reads the mirror afterwards with
// Monotonic(after = Version).
type View struct {
	AllianceID int64
	Name       string
	LeaderID   int64
	OpenJoin   bool
	Funds      int64
	Members    []MemberView
	Applicants []int64
	Wars       []int64
	Version    int64
}

// MemberState is a player's guard as the service answers it.
type MemberState struct {
	PlayerID            int64
	AllianceID          int64
	JoinRequestID       string
	PendingAllianceID   int64
	PendingRequestID    string
	PendingDeadlineUnix int64
	LeftAtUnix          int64
	// RewardPeriod is the last reward period the player claimed (0: none).
	RewardPeriod int64
	Version      int64
}

// Holder is what holds the guard, if anything: the pending reservation
// (pending=true: alliance PendingAllianceID, request PendingRequestID) or the
// membership (alliance AllianceID, request JoinRequestID). A pending
// reservation is reported first: it is the newer of the two.
func (state MemberState) Holder() (allianceID int64, requestID string, pending, held bool) {
	switch {
	case state.PendingRequestID != "":
		return state.PendingAllianceID, state.PendingRequestID, true, true
	case state.AllianceID != 0:
		return state.AllianceID, state.JoinRequestID, false, true
	default:
		return 0, "", false, false
	}
}

// Answer is an alliance write's answer: the outcome and the alliance after it.
//
// GuardHeld: the write was not decided and nothing was recorded, because the
// player's guard is held by another alliance or request (Guard) and the
// caller asked to be told first (deferHeld): the guard may be stale — a
// finishing call that was lost — and the service heals it from the alliance
// that holds it before deciding (rpc/alliance guard.go, healGuard).
//
// Ended is the join request id of the membership a removal of a player whose
// guard is on another instance ended (the service's ClearGuard names it).
//
// Member is the membership this write changed — set only when the write ran
// now and succeeded, never on a replay: the service sends the member's game
// server a best-effort notice of it once the write answered.
//
// WarPending: the alliance holds a cross-instance war declared under this
// request whose enemy has not acknowledged it yet (AllianceDao.WarAcks), so
// the service asks the enemy now (fresh or replayed).
type Answer struct {
	Outcome
	View       View
	GuardHeld  bool
	Guard      MemberState
	Ended      string
	Member     MemberChange
	WarPending bool
}

// MemberChange is one membership change: the player, the game server they
// belong to (where the notice goes) and how it changed (MemberJoined, ...).
// The zero value is no change.
type MemberChange struct {
	PlayerID int64
	HomeSID  int32
	Change   string
}

// WarAck is a cross-instance war declared under RequestID that EnemyID has
// not acknowledged yet (AllianceDao.WarAcks).
type WarAck struct {
	RequestID string
	EnemyID   int64
}

// GuardAnswer is a guard write's answer: the outcome (for writes with a
// receipt) and the guard after it. Held is GuardHeld for a reservation.
type GuardAnswer struct {
	Outcome
	Changed bool
	Held    bool
	State   MemberState
}

// ReceiptAnswer is a receipt lookup: Found=false means the request was never
// decided on that entity. Seated (Settle only) reports whether the player is
// in the alliance's roster under that request id now.
type ReceiptAnswer struct {
	Found   bool
	Receipt Receipt
	Seated  bool
}

// HomeUpdate 是联盟通知地址的条件更新结果。
type HomeUpdate struct {
	Changed bool
	HomeSID int32
}
