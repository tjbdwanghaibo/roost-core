package alliance_member

import (
	"{{MODULE}}/game/components/allianceguard"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:AllianceGuard}}
const CompTypeAllianceGuard entity.ComponentType = {{ID:component:AllianceGuard}}

// AllianceGuardComponent 是 game/components/allianceguard 的组件在 AllianceMember 上的名字（生成接线与 handler 用它）；业务在那个包里。
type AllianceGuardComponent = allianceguard.Component

// IAllianceGuardEntity is the narrow lock-safe view for Nest handlers using this
// component. The generated Entity wire implements the getter.
type IAllianceGuardEntity interface {
	entity.IThreadSafeEntity
	AllianceGuardComp() *AllianceGuardComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeAllianceGuard, allianceguard.NewComponent)
}
