package alliance

import (
	"{{MODULE}}/game/components/allianceroster"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:AllianceRoster}}
const CompTypeAllianceRoster entity.ComponentType = {{ID:component:AllianceRoster}}

// AllianceRosterComponent 是 game/components/allianceroster 的组件在 Alliance 上的名字（生成接线与 handler 用它）；业务在那个包里。
type AllianceRosterComponent = allianceroster.Component

// IAllianceRosterEntity is the narrow lock-safe view for Nest handlers using this
// component. The generated Entity wire implements the getter.
type IAllianceRosterEntity interface {
	entity.IThreadSafeEntity
	AllianceRosterComp() *AllianceRosterComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeAllianceRoster, allianceroster.NewComponent)
}
