package player

import (
	"{{MODULE}}/game/components/alliance"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:Alliance}}
const CompTypeAlliance entity.ComponentType = {{ID:component:Alliance}}

// AllianceComponent 是 game/components/alliance 的组件在 Player 上的名字（生成接线与 handler 用它）；业务在那个包里。
type AllianceComponent = alliance.Component

type IAllianceEntity interface {
	entity.IThreadSafeEntity
	AllianceComp() *AllianceComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeAlliance, alliance.NewComponent)
}
