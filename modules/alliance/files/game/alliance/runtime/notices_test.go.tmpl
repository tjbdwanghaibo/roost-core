// noticePush is the player connection as the notices see it: who is online,
// and what was pushed to whom.
type noticePush struct {
	online map[int64]bool
	pushed []pb.AllianceNoticePush
	to     []int64
}

func (p *noticePush) ActiveSessions(playerID int64) int {
	if p.online[playerID] {
		return 1
	}
	return 0
}

func (p *noticePush) PushPlayer(_ context.Context, playerID int64, messageID uint32, value any) error {
	if messageID != msgid.MsgAllianceNotice {
		return nil
	}
	p.to = append(p.to, playerID)
	p.pushed = append(p.pushed, *value.(*pb.AllianceNoticePush))
	return nil
}

// A membership notice reaches an ONLINE member: the alliance they are shown in
// changes (the display field, through the real ShowAlliance transaction) and the
// client gets AllianceNotice. An offline member is neither loaded nor pushed —
// the next login reads the mirror. A "left alliance 7" that arrives after the
// player already shows alliance 9 does not blank alliance 9.
func TestAllianceMemberNoticeReachesAnOnlineMember(t *testing.T) {
	online := noticePlayer(t, 501)
	offline := noticePlayer(t, 502)
	handler.RegisterShowAllianceNestHandlers()
	engine := nest.NewEngine(
		nest.NestOptionWithGetter(noticeGetter{online.ID(): online}),
		nest.NestOptionWithTransactionCommitter(noticeCommitter{}),
		nest.NestOptionWithWorkerPools(nest.WorkerPoolConfig{Workers: 1, QueueCap: 16}, nest.WorkerPoolConfig{}, nest.WorkerPoolConfig{}),
	)
	if err := engine.Start(); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { _ = engine.Shutdown(context.Background()) })
	push := &noticePush{online: map[int64]bool{501: true}}
	notices := allianceNotices{nest: engine, push: push}
	ctx := context.Background()

	if err := notices.apply(ctx, &rpcalliance.MemberNotice{AllianceID: 7, PlayerID: 501, Change: alliancerule.MemberJoined, Version: 4}); err != nil {
		t.Fatal(err)
	}
	if got := online.AllianceComp().AllianceID(); got != 7 {
		t.Fatalf("online member shows alliance %d after a join notice, want 7", got)
	}
	if len(push.pushed) != 1 || push.to[0] != 501 || push.pushed[0].AllianceID != 7 || push.pushed[0].Change != alliancerule.MemberJoined || push.pushed[0].Version != 4 {
		t.Fatalf("pushed %v to %v, want one AllianceNotice(7, joined, 4) to 501", push.pushed, push.to)
	}

	// Offline: the harness holds no entity 502, so loading it would fail the
	// test through the getter; the notice must not try.
	if err := notices.apply(ctx, &rpcalliance.MemberNotice{AllianceID: 7, PlayerID: 502, Change: alliancerule.MemberJoined, Version: 5}); err != nil {
		t.Fatal(err)
	}
	if offline.AllianceComp().AllianceID() != 0 || len(push.pushed) != 1 {
		t.Fatalf("an offline member was touched: shows %d, pushes %d", offline.AllianceComp().AllianceID(), len(push.pushed))
	}

	// The player moved to alliance 9; a late "left 7" must not hide alliance 9, and
	// "left 9" does.
	if err := notices.apply(ctx, &rpcalliance.MemberNotice{AllianceID: 9, PlayerID: 501, Change: alliancerule.MemberJoined, Version: 1}); err != nil {
		t.Fatal(err)
	}
	if err := notices.apply(ctx, &rpcalliance.MemberNotice{AllianceID: 7, PlayerID: 501, Change: alliancerule.MemberLeft, Version: 6}); err != nil {
		t.Fatal(err)
	}
	if got := online.AllianceComp().AllianceID(); got != 9 {
		t.Fatalf("a late leave of alliance 7 changed the display to %d, want 9", got)
	}
	if err := notices.apply(ctx, &rpcalliance.MemberNotice{AllianceID: 9, PlayerID: 501, Change: alliancerule.MemberKicked, Version: 2}); err != nil {
		t.Fatal(err)
	}
	if got := online.AllianceComp().AllianceID(); got != 0 {
		t.Fatalf("kicked from alliance 9, still shows %d", got)
	}
}

func noticePlayer(t *testing.T, uniqueID int64) *player.Player {
	t.Helper()
	player.RegisterEntity()
	id, err := entity.BuildEntityID(uniqueID, player.EntityKindPlayer)
	if err != nil {
		t.Fatal(err)
	}
	value, err := entity.BuildEntity(&entity.EntityCreateParam{IsCreate: true, Kind: player.EntityKindPlayer, Id: id})
	if err != nil {
		t.Fatal(err)
	}
	return value.(*player.Player)
}

type noticeCommitter struct{}

func (noticeCommitter) Commit(context.Context, dataengine.CommitRecord) error { return nil }

type noticeGetter map[int64]entity.IThreadSafeEntity

func (g noticeGetter) Get(_ context.Context, id int64, _ entity.EntityCategory) (entity.IThreadSafeEntity, error) {
	if e := g[id]; e != nil {
		return e, nil
	}
	return nil, fmt.Errorf("offline entity %d was loaded", id)
}
func (g noticeGetter) GetMany(ctx context.Context, ids []int64, categories []entity.EntityCategory) ([]entity.IThreadSafeEntity, error) {
	out := make([]entity.IThreadSafeEntity, len(ids))
	for i, id := range ids {
		e, err := g.Get(ctx, id, categories[i])
		if err != nil {
			return nil, err
		}
		out[i] = e
	}
	return out, nil
}
