package handler

import (
	"time"

	"{{MODULE}}/game/alliancerule"
	alliance "{{MODULE}}/game/entities/alliance"
)

// handlerAllianceApply records a player's application to join.
//
//roost:nest rollback=undo durability=strict
func handlerAllianceApply(target alliance.IAllianceRosterEntity, requestID string, playerID int64, homeSID int32, retentionSeconds int64, nowUnix int64) (alliancerule.Answer, error) {
	roster := target.AllianceRosterComp()
	outcome, err := roster.Execute(requestID, nowUnix, time.Duration(retentionSeconds)*time.Second, func() (int64, error) {
		return playerID, roster.Apply(playerID, homeSID, nowUnix)
	})
	return answer(roster, outcome, err)
}

// answer is a write's reply: the outcome and the alliance as it stands after
// the write (at the version the write produced; a replay reports the
// version its receipt recorded).
func answer(roster *alliance.AllianceRosterComponent, outcome alliancerule.Outcome, err error) (alliancerule.Answer, error) {
	if err != nil {
		return alliancerule.Answer{}, err
	}
	version := outcome.Version
	if outcome.Replayed {
		version = roster.CurrentVersion()
	}
	return alliancerule.Answer{Outcome: outcome, View: roster.View(version)}, nil
}
