package handler

import (
	"{{MODULE}}/game/view"
	"time"

	"{{MODULE}}/game/modules/alliancerule"
)

// handlerAllianceReject drops an application; leader only.
//
//roost:nest rollback=undo
func handlerAllianceReject(target view.IAllianceRosterEntity, requestID string, actorID int64, applicantID int64, retentionSeconds int64, nowUnix int64) (alliancerule.Answer, error) {
	roster := target.AllianceRoster()
	outcome, err := roster.Execute(requestID, nowUnix, time.Duration(retentionSeconds)*time.Second, func() (int64, error) {
		return applicantID, roster.Reject(actorID, applicantID)
	})
	return answer(roster, outcome, err)
}
