package handler

import (
	player "{{MODULE}}/game/entities/player"

	"github.com/tjbdwanghaibo/roost-core/framework/saga"
	"github.com/tjbdwanghaibo/roost-core/infra/base/errcode"
)

// handlerAllianceDebit is a alliance saga's native step that takes count of itemID
// out of the player's Bag: the founding fee and the donation (forward), and
// the reward grant's compensation (taking back a reward granted after the
// saga had given up on it). The Bag change and the step's receipt
// (PlayerDao.SagaReceipts) are one WAL record, so a redelivered or retried
// attempt of the same operation replays the receipt instead of taking twice.
//
// A business refusal (not enough coins) commits its receipt and answers the
// coordinator Success=false; an infrastructure error rolls back and leaves the
// outcome unknown, so the command is redelivered.
//
//roost:nest rollback=undo durability=pipelined
func handlerAllianceDebit(target player.IBagEntity, itemID int64, count int32, step saga.NativeStep) (int32, error) {
	left, err := target.BagComp().Remove(itemID, int64(count))
	if err != nil {
		code, reason := errcode.ClientError(err)
		if code == errcode.CodeInternal {
			return 0, err
		}
		return 0, step.Complete(false, reason)
	}
	return int32(left), step.Complete(true, "")
}
