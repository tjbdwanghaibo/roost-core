const homeSID int32 = 1000

var ctx = context.Background()

// found founds an alliance through the generated client, the queue group
// handing it to instance sid, and returns its id.
func found(t *testing.T, c *cluster, sid int32, requestID string, founder int64, openJoin bool) int64 {
	t.Helper()
	reply, err := c.via(sid).Found(ctx, requestID, founder, homeSID, "alliance-"+requestID, openJoin)
	if err != nil {
		t.Fatalf("found %s on %d: %v", requestID, sid, err)
	}
	if reply.Alliance.AllianceID == 0 || reply.Alliance.LeaderID != founder || reply.ServedBySID != sid {
		t.Fatalf("found %s on %d: reply %+v", requestID, sid, reply)
	}
	return reply.Alliance.AllianceID
}

func members(view alliancerule.View) []int64 {
	var ids []int64
	for _, member := range view.Members {
		ids = append(ids, member.PlayerID)
	}
	return ids
}

func has(ids []int64, id int64) bool {
	for _, candidate := range ids {
		if candidate == id {
			return true
		}
	}
	return false
}

// info is the authoritative read through the route RPC.
func info(t *testing.T, c *cluster, allianceID int64) alliancerule.View {
	t.Helper()
	reply, err := c.client().Info(ctx, mustAllianceTarget(t, allianceID))
	if err != nil {
		t.Fatalf("info %d: %v", allianceID, err)
	}
	return reply.Alliance
}

func guardState(t *testing.T, c *cluster, playerID int64) alliancerule.MemberState {
	t.Helper()
	reply, err := c.client().Guard(ctx, mustGuardTarget(t, playerID))
	if err != nil {
		t.Fatalf("guard %d: %v", playerID, err)
	}
	return reply.State
}

func requireRejected(t *testing.T, what string, err error, want *errcode.IntError) {
	t.Helper()
	if !errors.Is(err, want) || servicerpc.Classify(err) != servicerpc.OutcomeRejected {
		t.Fatalf("%s: err = %v (outcome %s), want the business rejection %s", what, err, servicerpc.Classify(err), want.Name())
	}
}

// A request id is executed once: the same id again replays the recorded
// result — success or rejection — and runs nothing, even when running it again
// would now give a different answer.
func TestAllianceWriteReplaysItsReceipt(t *testing.T) {
	c := newCluster(t, defaultRules(), 3000)
	client := c.client()
	allianceID := found(t, c, 3000, "found", 100, false)
	target := mustAllianceTarget(t, allianceID)

	first, err := client.Apply(ctx, "apply-103", 103, homeSID, target)
	if err != nil || first.Replayed || !has(first.Alliance.Applicants, 103) {
		t.Fatalf("apply: reply %+v err %v", first, err)
	}
	if _, err := client.Reject(ctx, "reject-103", 100, homeSID, target, 103); err != nil {
		t.Fatal(err)
	}
	replay, err := client.Apply(ctx, "apply-103", 103, homeSID, target)
	if err != nil || !replay.Replayed {
		t.Fatalf("replayed apply: reply %+v err %v, want the recorded success replayed", replay, err)
	}
	if has(info(t, c, allianceID).Applicants, 103) {
		t.Fatal("the replayed apply ran again: 103's application is back after the leader rejected it")
	}

	// A rejection is recorded and replayed the same way.
	if _, err := client.Apply(ctx, "apply-101", 101, homeSID, target); err != nil {
		t.Fatal(err)
	}
	_, err = client.Apply(ctx, "apply-101-again", 101, homeSID, target)
	requireRejected(t, "second application", err, apperrors.ErrAllianceApplication)
	if _, err := client.Reject(ctx, "reject-101", 100, homeSID, target, 101); err != nil {
		t.Fatal(err)
	}
	replayed, err := client.Apply(ctx, "apply-101-again", 101, homeSID, target)
	requireRejected(t, "replayed rejection", err, apperrors.ErrAllianceApplication)
	if !replayed.Replayed || has(info(t, c, allianceID).Applicants, 101) {
		t.Fatalf("the rejected request ran again once it could succeed: reply %+v applicants %v", replayed, info(t, c, allianceID).Applicants)
	}

	// Found's receipt is on the founder's guard: a retried Found returns the
	// alliance it founded and founds no second one.
	again, err := c.via(3000).Found(ctx, "found", 100, homeSID, "alliance-found", false)
	if err != nil || !again.Replayed || again.Alliance.AllianceID != allianceID {
		t.Fatalf("retried found: reply %+v err %v, want alliance %d replayed", again, err, allianceID)
	}
	if guard := guardState(t, c, 100); guard.AllianceID != allianceID {
		t.Fatalf("founder's guard = %+v", guard)
	}
	if leaders := c.instances[3000].store.founded(t); len(leaders) != 1 {
		t.Fatalf("founded alliances %v, want one", leaders)
	}
	result, err := client.Result(ctx, mustGuardTarget(t, 100), "found")
	if err != nil || !result.Found || result.Outcome != 0 || result.Subject != allianceID {
		t.Fatalf("Result(guard, found) = %+v err %v", result, err)
	}
	result, err = client.Result(ctx, target, "never-sent")
	if err != nil || result.Found {
		t.Fatalf("Result(never-sent) = %+v err %v, want not found", result, err)
	}
}

// Only the leader approves, rejects, kicks, transfers and declares war; the
// leader cannot leave or be kicked. A refusal changes nothing.
func TestAlliancePermissions(t *testing.T) {
	c := newCluster(t, defaultRules(), 3000)
	client := c.client()
	allianceID := found(t, c, 3000, "found", 100, true)
	target := mustAllianceTarget(t, allianceID)
	enemyID := found(t, c, 3000, "found-enemy", 104, true)
	for _, player := range []int64{101, 102} {
		if _, err := client.Join(ctx, fmt.Sprintf("join-%d", player), player, homeSID, target); err != nil {
			t.Fatalf("join %d: %v", player, err)
		}
	}
	if _, err := client.Apply(ctx, "apply-103", 103, homeSID, target); err != nil {
		t.Fatal(err)
	}
	before := info(t, c, allianceID)

	_, err := client.Approve(ctx, "member-approves", 101, homeSID, target, 103)
	requireRejected(t, "a member approves", err, apperrors.ErrAllianceDenied)
	_, err = client.Reject(ctx, "member-rejects", 101, homeSID, target, 103)
	requireRejected(t, "a member rejects", err, apperrors.ErrAllianceDenied)
	_, err = client.Kick(ctx, "member-kicks", 101, homeSID, target, 102)
	requireRejected(t, "a member kicks", err, apperrors.ErrAllianceDenied)
	_, err = client.Transfer(ctx, "member-transfers", 101, homeSID, target, 102)
	requireRejected(t, "a member transfers", err, apperrors.ErrAllianceDenied)
	_, err = client.DeclareWar(ctx, "member-declares", 101, homeSID, target, enemyID)
	requireRejected(t, "a member declares war", err, apperrors.ErrAllianceDenied)
	_, err = client.Kick(ctx, "outsider-kicks", 999, homeSID, target, 101)
	requireRejected(t, "an outsider kicks", err, apperrors.ErrAllianceDenied)
	_, err = client.Leave(ctx, "leader-leaves", 100, homeSID, target)
	requireRejected(t, "the leader leaves", err, apperrors.ErrAllianceLeader)
	if after := info(t, c, allianceID); !sameRoster(before, after) {
		t.Fatalf("refused writes changed the alliance:\nbefore %+v\nafter  %+v", before, after)
	}

	if _, err := client.Kick(ctx, "leader-kicks", 100, homeSID, target, 101); err != nil {
		t.Fatalf("the leader kicks: %v", err)
	}
	if has(members(info(t, c, allianceID)), 101) || guardState(t, c, 101).AllianceID != 0 {
		t.Fatal("kicked member is still in the roster or the guard")
	}
	if _, err := client.Transfer(ctx, "leader-transfers", 100, homeSID, target, 102); err != nil {
		t.Fatal(err)
	}
	if _, err := client.Leave(ctx, "former-leader-leaves", 100, homeSID, target); err != nil {
		t.Fatalf("the former leader leaves after the transfer: %v", err)
	}
	if view := info(t, c, allianceID); view.LeaderID != 102 || has(members(view), 100) {
		t.Fatalf("after transfer and leave: %+v", view)
	}
}

func sameRoster(a, b alliancerule.View) bool {
	return a.LeaderID == b.LeaderID && len(a.Members) == len(b.Members) && len(a.Applicants) == len(b.Applicants) && len(a.Wars) == len(b.Wars) &&
		has(members(a), 101) == has(members(b), 101) && has(members(a), 102) == has(members(b), 102) &&
		has(a.Applicants, 103) == has(b.Applicants, 103)
}

// A write to an alliance nobody founded is the caller's mistake: answered
// "entity not found" (a rejection) — by the route lookup without sending,
// and by the route check of an instance a stale hint sent it to — never an
// internal error, and never by claiming the id.
func TestAllianceWriteToAMissingAllianceIsRejected(t *testing.T) {
	c := newCluster(t, defaultRules(), 3000)
	nowhere := mustAllianceTarget(t, 404)
	_, err := c.client().Join(ctx, "join-nowhere", 101, homeSID, nowhere)
	requireRejected(t, "join an alliance nobody founded", err, errcode.ErrEntityNotFound)

	c.hint(nowhere, 3000) // an old registration still names 3000
	_, err = c.client().Join(ctx, "join-nowhere-hinted", 101, homeSID, nowhere)
	requireRejected(t, "join an alliance nobody founded, sent to 3000", err, errcode.ErrEntityNotFound)
	if owner, claimed := c.owner(nowhere); claimed || c.instances[3000].store.has(nowhere) {
		t.Fatalf("the refused join claimed alliance 404 for %d or loaded it", owner)
	}
}

// The roster limit comes from alliance.max_members; a full alliance refuses
// and leaves the player's guard free.
func TestAllianceRosterLimit(t *testing.T) {
	rules := defaultRules()
	rules.MaxMembers = 2
	c := newCluster(t, rules, 3000)
	client := c.client()
	allianceID := found(t, c, 3000, "found", 100, true)
	target := mustAllianceTarget(t, allianceID)
	if _, err := client.Join(ctx, "join-101", 101, homeSID, target); err != nil {
		t.Fatal(err)
	}
	_, err := client.Join(ctx, "join-102", 102, homeSID, target)
	requireRejected(t, "join a full alliance", err, apperrors.ErrAllianceFull)
	if guard := guardState(t, c, 102); guard.AllianceID != 0 || guard.PendingRequestID != "" {
		t.Fatalf("refused player's guard = %+v, want free", guard)
	}
	if got := len(info(t, c, allianceID).Members); got != 2 {
		t.Fatalf("members = %d, want 2", got)
	}
}

// alliance.max_members defaults to 100 and is refused above the hard limit 500
// when the config loads. There are no routing keys.
func TestAllianceSettingsEnforceTheHardMemberLimit(t *testing.T) {
	load := func(maxMembers any) (Settings, error) {
		v := viper.New()
		v.Set("sid", 3000)
		if maxMembers != nil {
			v.Set("alliance.max_members", maxMembers)
		}
		var loaded config
		err := app.LoadConfig(v, &loaded)
		return loaded.Alliance, err
	}
	settings, err := load(nil)
	if err != nil || settings.MaxMembers != 100 {
		t.Fatalf("default: max_members=%d err=%v, want 100", settings.MaxMembers, err)
	}
	if settings, err := load(500); err != nil || settings.MaxMembers != 500 {
		t.Fatalf("500: max_members=%d err=%v", settings.MaxMembers, err)
	}
	if _, err := load(501); err == nil || !strings.Contains(err.Error(), "max_members") {
		t.Fatalf("501 loaded: err=%v, want max_members refused", err)
	}
}

// The alliance reward (the game's reward saga, plan §2.6): a member claims
// once per period, a non-member is refused, the claim answers the reward from
// alliance.reward_*, a redelivered claim replays its receipt, and the
// compensation releases exactly that claim — after which the member may claim
// again. Releasing anything else changes nothing.
func TestAllianceRewardIsClaimedOncePerPeriodAndReleasedByItsClaim(t *testing.T) {
	c := newCluster(t, defaultRules(), 3000)
	client := c.client()
	allianceID := found(t, c, 3000, "found", 100, true)
	guard := mustGuardTarget(t, 100)

	reply, err := client.ClaimReward(ctx, "claim-1", 100, homeSID, guard)
	if err != nil || reply.AllianceID != allianceID || reply.ItemID != 1002 || reply.Count != 5 || reply.State.RewardPeriod == 0 {
		t.Fatalf("first claim = %+v, %v; want the reward of alliance %d", reply, err, allianceID)
	}
	if again, err := client.ClaimReward(ctx, "claim-1", 100, homeSID, guard); err != nil || !again.Replayed {
		t.Fatalf("redelivered claim = %+v, %v; want its receipt replayed", again, err)
	}
	_, err = client.ClaimReward(ctx, "claim-2", 100, homeSID, guard)
	requireRejected(t, "a second claim in the same period", err, apperrors.ErrAllianceReward)

	if released, err := client.ReleaseReward(ctx, guard, "claim-2"); err != nil || released.Changed {
		t.Fatalf("release of a claim that was refused = %+v, %v; want nothing released", released, err)
	}
	if released, err := client.ReleaseReward(ctx, guard, "claim-1"); err != nil || !released.Changed || released.State.RewardPeriod != 0 {
		t.Fatalf("release of claim-1 = %+v, %v; want it released", released, err)
	}
	if released, err := client.ReleaseReward(ctx, guard, "claim-1"); err != nil || released.Changed {
		t.Fatalf("release of claim-1 again = %+v, %v; want nothing (idempotent)", released, err)
	}
	if reply, err := client.ClaimReward(ctx, "claim-3", 100, homeSID, guard); err != nil || reply.Replayed {
		t.Fatalf("claim after the release = %+v, %v; want a fresh claim", reply, err)
	}

	// A player in no alliance: their guard does not exist (entity not found);
	// one who left: refused as not a member.
	_, err = client.ClaimReward(ctx, "claim-4", 101, homeSID, mustGuardTarget(t, 101))
	if servicerpc.Classify(err) != servicerpc.OutcomeRejected {
		t.Fatalf("claim by a player with no guard: err = %v, want a rejection", err)
	}
	target := mustAllianceTarget(t, allianceID)
	if _, err := client.Join(ctx, "join-102", 102, homeSID, target); err != nil {
		t.Fatal(err)
	}
	if _, err := client.Leave(ctx, "leave-102", 102, homeSID, target); err != nil {
		t.Fatal(err)
	}
	_, err = client.ClaimReward(ctx, "claim-5", 102, homeSID, mustGuardTarget(t, 102))
	requireRejected(t, "a claim by a former member", err, apperrors.ErrAllianceMissing)
	// Only the player's own guard: a claim on someone else's is invalid.
	if _, err := client.ClaimReward(ctx, "claim-6", 101, homeSID, guard); err == nil {
		t.Fatal("player 101 claimed on player 100's guard")
	}
}
