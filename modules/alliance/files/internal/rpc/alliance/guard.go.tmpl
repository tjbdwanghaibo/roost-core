// Guard implements Alliance: the guard as it is, not healed (Membership
// heals it first).
func (s *Service) Guard(ctx context.Context, target int64) (GuardReply, error) {
	state, err := s.guardState(ctx, target)
	return s.guardReply(alliancerule.GuardAnswer{State: state}, err)
}

// ReserveGuard implements Alliance (step 1 of a two-step join or founding).
// A guard held by another alliance or request is healed from its holder
// first (healGuard), then asked again; a holder that cannot be reached
// answers "not executed". A reservation that holds once it answered —
// made now, or replayed and still open — has its deadline armed in this
// process (armReservation).
func (s *Service) ReserveGuard(ctx context.Context, requestID string, target int64, allianceID int64, deadlineUnix int64) (GuardReply, error) {
	err := requireRequest(requestID, allianceID, deadlineUnix)
	if err != nil {
		return s.guardReply(alliancerule.GuardAnswer{}, err)
	}
	answer, err := s.reserveGuard(ctx, requestID, target, allianceID, deadlineUnix, true)
	if err == nil && answer.Held {
		if err = s.healGuard(ctx, answer.State); err == nil {
			answer, err = s.reserveGuard(ctx, requestID, target, allianceID, deadlineUnix, false)
		}
	}
	if err == nil && answer.State.PendingRequestID == requestID {
		s.armReservation(answer.State)
	}
	return s.guardReply(answer, err)
}

// reserveGuard is one reservation transaction: the guard alone (its own
// lock — two players' reservations never wait on each other).
func (s *Service) reserveGuard(ctx context.Context, requestID string, target int64, allianceID int64, deadlineUnix int64, deferHeld bool) (alliancerule.GuardAnswer, error) {
	var answer alliancerule.GuardAnswer
	err := s.call(ctx, target, alliance_member.EntityKindAllianceMember, func(ctx context.Context) error {
		if err := s.deps.Entities.EnsureGuard(ctx, entity.GetUniqueIDFromEntityID(target)); err != nil {
			return err
		}
		var err error
		answer, err = syncsender.NewAllianceGuardSender(s.deps.Nest).Sync_GuardReserve(ctx, target, requestID, allianceID, deadlineUnix, deferHeld, s.cooldown(), s.retention())
		return err
	})
	return answer, err
}

// ResolveGuard implements Alliance. A guard that no longer holds the
// reservation afterwards has its deadline disarmed here (it was armed by the
// ReserveGuard that made it, on the guard's owner).
func (s *Service) ResolveGuard(ctx context.Context, requestID string, target int64, allianceID int64, joined bool) (GuardReply, error) {
	var answer alliancerule.GuardAnswer
	err := requireRequest(requestID, allianceID)
	if err == nil {
		err = s.call(ctx, target, alliance_member.EntityKindAllianceMember, func(ctx context.Context) error {
			if err := s.deps.Entities.EnsureGuard(ctx, entity.GetUniqueIDFromEntityID(target)); err != nil {
				return err
			}
			var err error
			answer, err = syncsender.NewAllianceGuardSender(s.deps.Nest).Sync_GuardResolve(ctx, target, requestID, allianceID, joined)
			return err
		})
	}
	if err == nil && answer.State.PendingRequestID != requestID {
		s.follow.disarm(reservationKey(entity.GetUniqueIDFromEntityID(target), requestID))
	}
	return s.guardReply(answer, err)
}

// ClearGuard implements Alliance.
func (s *Service) ClearGuard(ctx context.Context, target int64, allianceID int64, joinRequestID string) (GuardReply, error) {
	var answer alliancerule.GuardAnswer
	err := requireRequest(joinRequestID, allianceID)
	if err == nil {
		err = s.call(ctx, target, alliance_member.EntityKindAllianceMember, func(ctx context.Context) error {
			if err := s.deps.Entities.EnsureGuard(ctx, entity.GetUniqueIDFromEntityID(target)); err != nil {
				return err
			}
			var err error
			answer, err = syncsender.NewAllianceGuardSender(s.deps.Nest).Sync_GuardClear(ctx, target, allianceID, joinRequestID)
			return err
		})
	}
	return s.guardReply(answer, err)
}

// ClaimReward implements Alliance. A player claims only for themself: target
// must be the caller's own guard.
func (s *Service) ClaimReward(ctx context.Context, requestID string, callerID int64, _ int32, target int64) (RewardReply, error) {
	var answer alliancerule.GuardAnswer
	err := requireRequest(requestID, callerID)
	if err == nil {
		if own, guardErr := GuardTarget(callerID); guardErr != nil || own != target {
			err = fmt.Errorf("%w: target %d is not the guard of player %d", ErrRequestInvalid, target, callerID)
		}
	}
	if err == nil {
		// Only a member claims, and a stale-occupied guard must not let a
		// player who left claim: the guard is checked against its alliance
		// first (healGuard; a real member is left as it is).
		err = s.verifyGuard(ctx, target, requestID)
	}
	if err == nil {
		err = s.call(ctx, target, alliance_member.EntityKindAllianceMember, func(ctx context.Context) error {
			if err := s.deps.Entities.EnsureGuard(ctx, callerID); err != nil {
				return err
			}
			var err error
			answer, err = syncsender.NewAllianceGuardSender(s.deps.Nest).Sync_GuardClaimReward(ctx, target, requestID,
				int64(s.deps.Rules.RewardPeriod/time.Second), s.retention())
			return err
		})
	}
	if err == nil {
		err = answer.Err()
	}
	return RewardReply{
		State: answer.State, AllianceID: answer.Subject, ItemID: s.deps.Rules.RewardItemID, Count: s.deps.Rules.RewardCount,
		Replayed: answer.Replayed, ServedBySID: s.deps.LocalSID,
	}, err
}

// ReleaseReward implements Alliance.
func (s *Service) ReleaseReward(ctx context.Context, target int64, claimRequestID string) (GuardReply, error) {
	var answer alliancerule.GuardAnswer
	err := requireRequest(claimRequestID)
	if err == nil {
		err = s.call(ctx, target, alliance_member.EntityKindAllianceMember, func(ctx context.Context) error {
			if err := s.deps.Entities.EnsureGuard(ctx, entity.GetUniqueIDFromEntityID(target)); err != nil {
				return err
			}
			var err error
			answer, err = syncsender.NewAllianceGuardSender(s.deps.Nest).Sync_GuardReleaseReward(ctx, target, claimRequestID)
			return err
		})
	}
	return s.guardReply(answer, err)
}

// --- the guard as a cache of the rosters ---

// healGuard brings a held guard in line with the roster that holds it. The
// guard is a cache of the rosters: it may be stale-occupied (a ResolveGuard or
// ClearGuard that should have finished it was lost), never stale-empty.
// observed is the guard as a request (or a reservation's deadline, or the
// game's login lookup) found it; its holder (alliance X, request R — pending
// or joined) is asked for the authoritative answer:
//
//   - Settle(X, R, player, decide) on X, in one transaction: reports whether
//     the player holds a seat under R now (Seated) and whether R has an
//     answer. decide — a membership, or a reservation past its deadline —
//     also records R's answer if X never decided it (alliance_expired, or
//     success when the player holds a seat under R whose receipt was
//     pruned), so no admission under R can change the answer afterwards.
//     A reservation before its deadline is not decided: its join may still
//     be on the way to X, and cutting it short would turn a race between two
//     approvals into an expiry; it is healed only when X already answered.
//   - pending (X, R): ResolveGuard(R, joined=Seated) — confirmed if seated,
//     released otherwise — once R is answered; before that nothing.
//   - joined (X, R) and not seated: ClearGuard(X, R). Seated: nothing, the
//     guard was right.
//
// ResolveGuard and ClearGuard change the guard only while it still holds
// exactly (X, R) — the observed state — so a heal racing another heal or a
// direct finish changes nothing twice. Why emptying it is safe: once R has
// an answer on X (a deciding Settle recorded it, or X had decided R before —
// the non-deciding case releases only then), the player cannot get a seat in
// X under R any more (an admission under R replays R's recorded answer), and a seat in X under any other
// request needs the guard free (same-instance join: checked in the same
// transaction) or reserved for that request (cross-instance join): neither
// is possible while the guard holds (X, R). So "not seated under R" read in
// Settle's transaction stays true until the conditional write. The one
// assumption, as before healing: a request id is not retried after its
// receipts were pruned (alliance.receipt_retention).
//
// It runs in the service layer (the RPC handler's I/O segment), never inside
// a guard handler: the questions are RPCs, and a Nest handler on the fast
// pool must not wait. An error is "not executed" for the request that found
// the guard held: nothing of it was decided.
func (s *Service) healGuard(ctx context.Context, observed alliancerule.MemberState) error {
	allianceID, requestID, pending, held := observed.Holder()
	if !held {
		return nil
	}
	guard, err := GuardTarget(observed.PlayerID)
	if err != nil {
		return fmt.Errorf("%w: player %d: %v", ErrRequestInvalid, observed.PlayerID, err)
	}
	decide := !pending || s.deps.Now().Unix() >= observed.PendingDeadlineUnix
	settled, err := s.settle(ctx, allianceID, requestID, observed.PlayerID, decide)
	if err != nil {
		return servicerpc.Retryable(fmt.Errorf("alliance: ask alliance %d about request %s of player %d: %w", allianceID, requestID, observed.PlayerID, err))
	}
	switch {
	case pending && !settled.Found && !settled.Seated:
		return nil // still on the way to X: the reservation holds until X answers or its deadline passes
	case pending:
		err = s.onGuard(ctx, guard, func(peer Alliance) error {
			_, err := peer.ResolveGuard(ctx, requestID, guard, allianceID, settled.Seated)
			return err
		})
	case !settled.Seated:
		err = s.onGuard(ctx, guard, func(peer Alliance) error {
			_, err := peer.ClearGuard(ctx, guard, allianceID, requestID)
			return err
		})
	default:
		return nil
	}
	if err != nil && !final(err) {
		return servicerpc.Retryable(fmt.Errorf("alliance: heal the guard of player %d: %w", observed.PlayerID, err))
	}
	metrics.IncCounter("alliance.guard_healed_total", metrics.Labels{"pending": fmt.Sprint(pending)}, 1)
	return nil
}

// onGuard runs a guard call on the guard's owner: this service when it is
// this instance's (no bus round trip back to itself), the route RPC
// otherwise (a reservation's deadline runs on the instance that made the
// reservation, which may have given the guard away since).
func (s *Service) onGuard(ctx context.Context, guard int64, run func(peer Alliance) error) error {
	_, here, err := s.owned(ctx, guard)
	if err != nil {
		return err
	}
	if here {
		return run(s)
	}
	return run(s.deps.Peers)
}

// verifyGuard heals the guard target from its holder whatever it holds (the
// reward claim: a member is checked against the roster every time).
func (s *Service) verifyGuard(ctx context.Context, target int64, requestID string) error {
	var state alliancerule.MemberState
	err := s.call(ctx, target, alliance_member.EntityKindAllianceMember, func(ctx context.Context) error {
		if err := s.deps.Entities.EnsureGuard(ctx, entity.GetUniqueIDFromEntityID(target)); err != nil {
			return err
		}
		var receipt alliancerule.ReceiptAnswer
		var err error
		if receipt, err = syncsender.NewAllianceGuardSender(s.deps.Nest).Sync_GuardReceipt(ctx, target, requestID); err != nil || receipt.Found {
			return err // a replay is answered from its receipt
		}
		state, err = syncsender.NewAllianceGuardSender(s.deps.Nest).Sync_GuardInfo(ctx, target)
		return err
	})
	if err != nil {
		return err
	}
	return s.healGuard(ctx, state)
}

// finishGuard is the direct finishing call after a cross-instance write
// (confirm a reservation, or clear an ended membership). Best effort: a lost
// one leaves the guard stale-occupied, which healGuard corrects for the next
// request that finds it held.
func (s *Service) finishGuard(ctx context.Context, playerID, allianceID int64, requestID string, change string) {
	guard, err := GuardTarget(playerID)
	if err == nil {
		switch change {
		case alliancerule.MemberJoined:
			_, err = s.deps.Peers.ResolveGuard(ctx, requestID, guard, allianceID, true)
		default:
			_, err = s.deps.Peers.ClearGuard(ctx, guard, allianceID, requestID)
		}
	}
	if err != nil {
		metrics.IncCounter("alliance.guard_finish_lost_total", metrics.Labels{"change": change}, 1)
		slog.Warn("alliance: guard not finished; the next request that finds it held heals it",
			"player_id", playerID, "alliance_id", allianceID, "request_id", requestID, "change", change, "err", err)
	}
}

// --- after a write: the member's notice, the reservation's deadline, the login's lookup ---

// MemberNotice is the best-effort notice a player's game server gets when
// their membership changes; the game updates what an online player is shown
// and pushes AllianceNotice to the client (game/alliance/runtime/notices.go).
// A notice that is lost is made up for at the next login: the game checks the
// alliance the player is shown in against the alliance's mirror, and asks
// Membership when it shows none.
type MemberNotice struct {
	AllianceID int64  `json:"alliance_id"`
	PlayerID   int64  `json:"player_id"`
	Change     string `json:"change"`
	Version    int64  `json:"version"`
}

// MsgName is the bus message name (module NoticeModule on the game server).
func (MemberNotice) MsgName() string { return "alliance.member_notice" }

// NoticeModule is the bus module the game server handles MemberNotice on.
const NoticeModule = "alliance"

// notify sends the member's game server the notice of the membership a write
// changed (answer.Member, set only by a write that ran now and succeeded —
// a replay sends nothing), straight from the service once the write answered:
// a bus publish, so it does not wait for the game, and it runs in the RPC
// handler's I/O segment, never in a Nest handler. Best effort: a notice that
// cannot be sent is logged and not retried; it finishes nothing (the guard is
// the writes' and healGuard's), so losing it only delays what the player is
// shown until the next notice or login.
func (s *Service) notify(ctx context.Context, answer alliancerule.Answer) {
	change := answer.Member
	if s.deps.Notify == nil || change.PlayerID <= 0 || change.HomeSID <= 0 {
		return
	}
	notice := MemberNotice{AllianceID: answer.View.AllianceID, PlayerID: change.PlayerID, Change: change.Change, Version: answer.View.Version}
	if err := s.deps.Notify(ctx, change.HomeSID, notice); err != nil {
		metrics.IncCounter("alliance.member_notice_lost_total", metrics.Labels{"change": change.Change}, 1)
		slog.Warn("alliance: member notice not sent; the player sees the change at the next notice or login",
			"player_id", change.PlayerID, "alliance_id", notice.AllianceID, "home_sid", change.HomeSID, "err", err)
	}
}

// reservationKey names a reservation's deadline among the follow-ups.
func reservationKey(playerID int64, requestID string) string {
	return fmt.Sprintf("reservation:%d:%s", playerID, requestID)
}

// armReservation arms, in this process, the deadline of the reservation the
// guard state holds (the instance that made it — the guard's owner). At the
// deadline the guard is healed the way a request that found it held would
// heal it (reservationDue). The deadline is not persisted: it is only what
// finishes an abandoned reservation without waiting for the next request
// (correctness is the healing's). Lost with this process, or never armed
// because the reservation answered nothing here, it is made up by the next
// request that finds the guard held (Join, Found, ReserveGuard, ClaimReward,
// the game's Membership lookup at login, a transfer).
func (s *Service) armReservation(state alliancerule.MemberState) {
	s.armReservationAttempt(state.PlayerID, state.PendingAllianceID, state.PendingRequestID, state.PendingDeadlineUnix, 0)
}

func (s *Service) armReservationAttempt(playerID, allianceID int64, requestID string, deadlineUnix int64, attempt int) {
	delay := time.Unix(deadlineUnix, 0).Sub(s.deps.Now())
	if attempt > 0 {
		delay = attemptDelay(attempt)
	}
	s.follow.arm(reservationKey(playerID, requestID), delay, func(ctx context.Context) {
		s.reservationDue(ctx, playerID, allianceID, requestID, deadlineUnix, attempt)
	})
}

// reservationDue runs when the deadline of (playerID, allianceID, requestID)
// has passed: if the guard still holds that reservation it is healed —
// its alliance settles the request (which also makes the answer final) and
// the guard is confirmed or released by the answer, never on the clock alone.
// An alliance that cannot be reached leaves the reservation pending and the
// heal is tried again later (retryDelay), as long as this process runs.
func (s *Service) reservationDue(ctx context.Context, playerID, allianceID int64, requestID string, deadlineUnix int64, attempt int) {
	if now := s.deps.Now().Unix(); now < deadlineUnix {
		// The business clock was moved back after the deadline was armed.
		s.armReservationAttempt(playerID, allianceID, requestID, deadlineUnix, 0)
		return
	}
	guard, err := GuardTarget(playerID)
	if err != nil {
		return
	}
	var state GuardReply
	err = s.onGuard(ctx, guard, func(peer Alliance) (err error) {
		state, err = peer.Guard(ctx, guard)
		return err
	})
	if err == nil && (state.State.PendingRequestID != requestID || state.State.PendingAllianceID != allianceID) {
		return // settled meanwhile
	}
	if err == nil {
		err = s.healGuard(ctx, state.State)
	}
	if err != nil && ctx.Err() == nil {
		slog.Warn("alliance: reservation deadline not settled; trying again",
			"player_id", playerID, "alliance_id", allianceID, "request_id", requestID, "attempt", attempt, "err", err)
		s.armReservationAttempt(playerID, allianceID, requestID, deadlineUnix, attempt+1)
	}
}

// Membership implements Alliance: which alliance the player of the guard
// target is in, as the roster has it. The game asks at login when the
// player's own copy shows no alliance — a membership made while they were
// offline, whose notice found nobody online. A held guard is healed from its
// holder first (healGuard): a membership the roster no longer has is
// cleared, a reservation the roster seated is confirmed, one past its
// deadline is settled; a reservation still on its way answers no alliance
// yet. The guard is a cache that may be stale-occupied but never
// stale-empty, so a guard that holds nothing is the answer as it is.
func (s *Service) Membership(ctx context.Context, target int64) (GuardReply, error) {
	state, err := s.guardState(ctx, target)
	if err == nil {
		if _, _, _, held := state.Holder(); held {
			if err = s.healGuard(ctx, state); err == nil {
				state, err = s.guardState(ctx, target)
			}
		}
	}
	return s.guardReply(alliancerule.GuardAnswer{State: state}, err)
}

// guardState reads the guard target, which this instance owns.
func (s *Service) guardState(ctx context.Context, target int64) (alliancerule.MemberState, error) {
	var state alliancerule.MemberState
	err := s.call(ctx, target, alliance_member.EntityKindAllianceMember, func(ctx context.Context) error {
		if err := s.deps.Entities.EnsureGuard(ctx, entity.GetUniqueIDFromEntityID(target)); err != nil {
			return err
		}
		var err error
		state, err = syncsender.NewAllianceGuardSender(s.deps.Nest).Sync_GuardInfo(ctx, target)
		return err
	})
	return state, err
}

// settle asks the alliance what became of requestID for playerID (Settle)
// wherever it is (onAlliance). An alliance id that has no owner yet is a
// founding whose instance reserved the guard and has not created the
// alliance: deciding, it is created here, empty, so the request's
// alliance_expired can be recorded on it and a late Establish of that request
// is refused; not deciding, the founding may still be on its way and nothing
// is answered.
func (s *Service) settle(ctx context.Context, allianceID int64, requestID string, playerID int64, decide bool) (ResultReply, error) {
	var settled ResultReply
	if !decide {
		target, err := AllianceTarget(allianceID)
		if err != nil {
			return settled, fmt.Errorf("%w: alliance %d: %v", ErrRequestInvalid, allianceID, err)
		}
		if exists, _, err := s.owned(ctx, target); err != nil || !exists {
			return settled, err
		}
	}
	err := s.onAlliance(ctx, allianceID,
		func(ctx context.Context, target int64) (err error) {
			settled, err = s.Settle(ctx, target, requestID, playerID, decide)
			return err
		},
		func(ctx context.Context, target int64) (err error) {
			settled, err = s.deps.Peers.Settle(ctx, target, requestID, playerID, decide)
			return err
		})
	return settled, err
}
