// Found implements Alliance (plan §2.3, "create on random routing"). Any
// instance may take it — the request carries no route — so the request id
// cannot be anchored on the new alliance: a retry of the same request id may
// reach another instance before or after the first delivery created
// anything. It is anchored on the founder's AllianceMember instead, which is
// routed by a stable id (the player's): the guard records "request id →
// alliance id" before the alliance exists, and every delivery founds the
// alliance the guard names.
//
//   - Guard owned here, or not created yet (a player's first alliance): one
//     transaction over a freshly minted alliance and the guard
//     (handlerAllianceFound); its admission claims both for this instance.
//   - Guard owned by another instance — or claimed by one while this
//     delivery was trying: two steps. ReserveGuard there binds the request
//     id to an alliance id (this delivery's, or the one an earlier delivery
//     bound — its receipt replays), then Establish founds that alliance:
//     here when nobody owns it yet, through the route RPC when another
//     instance does (an earlier delivery created it, or won the claim).
//
// So a retry never founds a second alliance. A delivery that minted an id it
// did not use leaves that number unused (like a failed mint).
func (s *Service) Found(ctx context.Context, requestID string, callerID int64, callerSID int32, name string, openJoin bool) (Reply, error) {
	if err := requireRequest(requestID, callerID); err != nil {
		return s.reply(alliancerule.Answer{}, err)
	}
	if err := alliancerule.ValidateName(name); err != nil {
		return s.reply(alliancerule.Answer{}, err)
	}
	guard, err := GuardTarget(callerID)
	if err != nil {
		return s.reply(alliancerule.Answer{}, fmt.Errorf("%w: caller %d: %v", ErrRequestInvalid, callerID, err))
	}
	here, err := s.claimable(ctx, guard)
	if err != nil {
		return s.reply(alliancerule.Answer{}, err)
	}
	var minted int64
	if here {
		reply, done, id, err := s.foundHere(ctx, requestID, callerID, callerSID, guard, name, openJoin)
		if done {
			if err == nil {
				slog.InfoContext(ctx, "alliance: founding confirmed", "player_id", callerID, "request_key", requestID, "alliance_id", reply.Alliance.AllianceID, "name", name, "replayed", reply.Replayed)
			}
			return reply, err
		}
		minted = id // the guard moved: go on in two steps, with the id already minted
	}
	reply, err := s.foundInTwoSteps(ctx, requestID, callerID, callerSID, guard, name, openJoin, minted)
	if err == nil {
		slog.InfoContext(ctx, "alliance: founding confirmed", "player_id", callerID, "request_key", requestID, "alliance_id", reply.Alliance.AllianceID, "name", name, "replayed", reply.Replayed)
	}
	return reply, err
}

// foundHere is Found when the founder's guard is (or becomes) this
// instance's. done=false means the guard was claimed by another instance
// meanwhile; minted is the alliance id this delivery minted, if any.
func (s *Service) foundHere(ctx context.Context, requestID string, callerID int64, callerSID int32, guard int64, name string, openJoin bool) (reply Reply, done bool, minted int64, err error) {
	if err := s.deps.Entities.EnsureGuard(ctx, callerID); err != nil {
		return Reply{}, true, 0, err
	}
	// A replay first: it costs one read and keeps a retry from minting.
	var receipt alliancerule.ReceiptAnswer
	err = s.call(ctx, guard, alliance_member.EntityKindAllianceMember, func(ctx context.Context) (err error) {
		receipt, err = syncsender.NewAllianceGuardSender(s.deps.Nest).Sync_GuardReceipt(ctx, guard, requestID)
		return err
	})
	if s.moved(ctx, guard, err) {
		return Reply{}, false, 0, nil
	}
	if err != nil {
		return Reply{}, true, 0, err
	}
	if receipt.Found {
		reply, err := s.foundReplay(ctx, requestID, callerID, callerSID, receipt.Receipt, name, openJoin)
		return reply, true, 0, err
	}
	minted, err = s.deps.Sequence.Next(ctx)
	if err != nil {
		return Reply{}, true, 0, err
	}
	if err := s.deps.Entities.EnsureAlliance(ctx, minted); err != nil {
		return Reply{}, true, minted, err
	}
	target, err := AllianceTarget(minted)
	if err != nil {
		return Reply{}, true, minted, err
	}
	var answer alliancerule.Answer
	foundOnce := func(deferHeld bool) error {
		return s.call(ctx, target, alliance.EntityKindAlliance, func(ctx context.Context) (err error) {
			answer, err = syncsender.NewAllianceFoundSender(s.deps.Nest).MultiSync_AllianceFound(ctx, target, guard, requestID, name, callerSID, openJoin, deferHeld, s.cooldown(), s.retention())
			return err
		})
	}
	err = foundOnce(true)
	if err == nil && answer.GuardHeld {
		// The founder's guard holds another alliance or request: heal it from
		// its holder (it may be stale), then decide.
		if err = s.healGuard(ctx, answer.Guard); err == nil {
			err = foundOnce(false)
		}
	}
	if s.moved(ctx, guard, err) {
		return Reply{}, false, minted, nil
	}
	if err == nil && answer.Replayed {
		// Another delivery of the request decided it between the read above
		// and this transaction.
		reply, err := s.foundReplay(ctx, requestID, callerID, callerSID, answer.Receipt, name, openJoin)
		return reply, true, minted, err
	}
	if err == nil {
		s.notify(ctx, answer)
	}
	reply, err = s.reply(answer, err)
	return reply, true, minted, err
}

// foundInTwoSteps is Found when the founder's guard is another instance's.
func (s *Service) foundInTwoSteps(ctx context.Context, requestID string, callerID int64, callerSID int32, guard int64, name string, openJoin bool, minted int64) (Reply, error) {
	if minted == 0 {
		var err error
		if minted, err = s.deps.Sequence.Next(ctx); err != nil {
			return s.reply(alliancerule.Answer{}, err)
		}
	}
	deadline := s.deps.Now().Add(s.deps.Rules.ReservationTTL).Unix()
	reserved, err := s.deps.Peers.ReserveGuard(ctx, requestID, guard, minted, deadline)
	if err != nil {
		// A rejection (already in an alliance, the request refused before) is
		// the answer; anything else is not final, and a reservation that did
		// happen is settled at its deadline.
		return s.reply(alliancerule.Answer{}, passOn(err))
	}
	bound := reserved.AllianceID
	if bound <= 0 {
		return s.reply(alliancerule.Answer{}, fmt.Errorf("alliance: guard of %d answered no alliance for request %s", callerID, requestID))
	}
	reply, err := s.establish(ctx, requestID, callerID, callerSID, bound, name, openJoin)
	if alliancerule.IsRejection(err) {
		// Refused (an alliance the deadline already settled answers
		// alliance_expired): release the reservation now rather than at its
		// deadline. Best effort; the deadline settles it otherwise.
		if _, releaseErr := s.deps.Peers.ResolveGuard(ctx, requestID, guard, bound, false); releaseErr != nil {
			slog.Warn("alliance: reservation not released after a refused founding; its deadline will settle it",
				"request_id", requestID, "player_id", callerID, "alliance_id", bound, "err", releaseErr)
		}
	}
	return reply, err
}

// foundReplay answers a Found whose receipt is on the guard: the rejection
// it recorded, or the alliance it is bound to (the receipt's Subject) —
// founded already (Establish replays it), or only reserved by a delivery
// that stopped before creating it (Establish founds it now).
func (s *Service) foundReplay(ctx context.Context, requestID string, callerID int64, callerSID int32, receipt alliancerule.Receipt, name string, openJoin bool) (Reply, error) {
	if receipt.Code != 0 {
		return s.reply(alliancerule.Answer{Outcome: alliancerule.Outcome{Receipt: receipt, Replayed: true}}, nil)
	}
	return s.establish(ctx, requestID, callerID, callerSID, receipt.Subject, name, openJoin)
}

// establish founds allianceID for requestID wherever it belongs (onAlliance;
// the instance that founds it sends the founder's notice), then confirms the
// founder's reservation directly (finishGuard; a founding whose guard is on
// this instance was confirmed in its own transaction and the call changes
// nothing).
func (s *Service) establish(ctx context.Context, requestID string, founderID int64, homeSID int32, allianceID int64, name string, openJoin bool) (Reply, error) {
	var reply Reply
	err := s.onAlliance(ctx, allianceID,
		func(ctx context.Context, target int64) (err error) {
			reply, err = s.Establish(ctx, requestID, founderID, homeSID, target, name, openJoin)
			return err
		},
		func(ctx context.Context, target int64) (err error) {
			reply, err = s.deps.Peers.Establish(ctx, requestID, founderID, homeSID, target, name, openJoin)
			return err
		})
	if err == nil {
		s.finishGuard(ctx, founderID, allianceID, requestID, alliancerule.MemberJoined)
	}
	return reply, err
}

// Establish implements Alliance (step 2 of a two-step founding).
func (s *Service) Establish(ctx context.Context, requestID string, callerID int64, callerSID int32, target int64, name string, openJoin bool) (Reply, error) {
	if err := requireRequest(requestID, callerID); err != nil {
		return s.reply(alliancerule.Answer{}, err)
	}
	if err := alliancerule.ValidateName(name); err != nil {
		return s.reply(alliancerule.Answer{}, err)
	}
	var answer alliancerule.Answer
	err := s.call(ctx, target, alliance.EntityKindAlliance, func(ctx context.Context) (err error) {
		answer, err = syncsender.NewAllianceFoundSender(s.deps.Nest).Sync_AllianceEstablish(ctx, target, requestID, callerID, name, callerSID, openJoin, s.retention())
		return err
	})
	if err == nil {
		s.notify(ctx, answer)
	}
	return s.reply(answer, err)
}

// Approve implements Alliance.
func (s *Service) Approve(ctx context.Context, requestID string, callerID int64, callerSID int32, target int64, applicantID int64) (Reply, error) {
	if err := requireRequest(requestID, callerID, applicantID); err != nil {
		return s.reply(alliancerule.Answer{}, err)
	}
	reply, err := s.admit(ctx, requestID, callerID, callerSID, target, applicantID, true)
	if err == nil {
		slog.InfoContext(ctx, "alliance: approve confirmed", "player_id", callerID, "member_id", applicantID, "alliance_id", reply.Alliance.AllianceID, "request_key", requestID, "replayed", reply.Replayed)
	}
	return reply, err
}

// Join implements Alliance.
func (s *Service) Join(ctx context.Context, requestID string, callerID int64, callerSID int32, target int64) (Reply, error) {
	if err := requireRequest(requestID, callerID); err != nil {
		return s.reply(alliancerule.Answer{}, err)
	}
	reply, err := s.admit(ctx, requestID, callerID, callerSID, target, callerID, false)
	if err == nil {
		slog.InfoContext(ctx, "alliance: join confirmed", "player_id", callerID, "member_id", callerID, "alliance_id", reply.Alliance.AllianceID, "request_key", requestID, "replayed", reply.Replayed)
	}
	return reply, err
}

// admit seats playerID in the alliance target under requestID (plan §2.5).
//
// Guard owned here, or not created yet (then this instance creates it and
// the transaction's admission claims it): one transaction over the alliance
// and the guard (handlerAllianceAdmit). Guard owned elsewhere — or claimed by
// another instance while this one was trying (its claim won; this
// transaction was fenced and committed nothing) — two steps, the guard's
// instance first, both through the route RPC:
//
//  1. ReserveGuard there (refused if the player is in or joining another
//     alliance; the deadline is armed with the reservation);
//  2. admit here under the same request id (handlerAllianceAdmitReserved),
//     recording the receipt either way, then confirm the guard with a direct
//     ResolveGuard (finishGuard).
//
// A rejection in step 2 releases the reservation at once (best effort); a
// lost confirmation or release, or an answer that is not final in either
// step, leaves the reservation pending: its deadline (armed in the guard
// instance's process by ReserveGuard), or the next request that finds the
// guard held, settles it with this alliance and heals the guard (healGuard)
// — never on the clock alone. No effect finishes anything; the member's
// notice is sent after the admission answered (notify, best effort).
//
// A guard held by another alliance or request is healed from its holder
// before the admission is decided: here (deferHeld, then healGuard), or by
// the guard's instance inside ReserveGuard.
func (s *Service) admit(ctx context.Context, requestID string, actorID int64, callerSID int32, target, playerID int64, viaApplication bool) (Reply, error) {
	guard, err := GuardTarget(playerID)
	if err != nil {
		return s.reply(alliancerule.Answer{}, fmt.Errorf("%w: player %d: %v", ErrRequestInvalid, playerID, err))
	}
	allianceID := entity.GetUniqueIDFromEntityID(target)
	var answer alliancerule.Answer
	var peerErr error // the guard instance's own answer to ReserveGuard, passed on as it is
	maxMembers := int32(s.deps.Rules.MaxMembers)
	err = s.call(ctx, target, alliance.EntityKindAlliance, func(ctx context.Context) error {
		here, err := s.claimable(ctx, guard)
		if err != nil {
			return err
		}
		if here {
			if err := s.deps.Entities.EnsureGuard(ctx, playerID); err != nil {
				return err
			}
			admitOnce := func(deferHeld bool) (err error) {
				answer, err = syncsender.NewAllianceAdmitSender(s.deps.Nest).MultiSync_AllianceAdmit(ctx, target, guard, requestID, actorID, callerSID, viaApplication, deferHeld, maxMembers, s.cooldown(), s.retention())
				return err
			}
			err = admitOnce(true)
			if err == nil && answer.GuardHeld {
				if err = s.healGuard(ctx, answer.Guard); err != nil {
					peerErr = err
					return nil
				}
				err = admitOnce(false)
			}
			if !s.moved(ctx, guard, err) {
				if err == nil {
					s.notify(ctx, answer)
				}
				return err
			}
		}
		deadline := s.deps.Now().Add(s.deps.Rules.ReservationTTL).Unix()
		if _, err := s.deps.Peers.ReserveGuard(ctx, requestID, guard, allianceID, deadline); err != nil {
			// A rejection (already in an alliance) is the answer; anything else
			// is not final, and a reservation that did happen is settled at its
			// deadline. Either way this alliance has decided nothing.
			if alliancerule.IsRejection(err) {
				answer = alliancerule.Answer{Outcome: alliancerule.Outcome{Receipt: alliancerule.Receipt{Code: errcode.CodeOf(err)}}}
			} else {
				peerErr = err
			}
			return nil
		}
		answer, err = syncsender.NewAllianceAdmitReservedSender(s.deps.Nest).Sync_AllianceAdmitReserved(ctx, target, requestID, actorID, playerID, callerSID, viaApplication, maxMembers, s.retention())
		switch {
		case err != nil:
		case answer.Code == 0:
			s.notify(ctx, answer)
			s.finishGuard(ctx, playerID, allianceID, requestID, alliancerule.MemberJoined)
		default:
			if _, releaseErr := s.deps.Peers.ResolveGuard(ctx, requestID, guard, allianceID, false); releaseErr != nil {
				slog.Warn("alliance: reservation not released after a refused admission; its deadline or the next request heals it",
					"request_id", requestID, "player_id", playerID, "alliance_id", allianceID, "err", releaseErr)
			}
		}
		return err
	})
	if err == nil && peerErr != nil {
		// Not this alliance's answer: the guard instance's (not executed,
		// redirect, unknown). A redirect it names is the guard's owner, not
		// this alliance's, so it is passed on as "not executed".
		err = passOn(peerErr)
	}
	return s.reply(answer, err)
}

// Leave implements Alliance.
func (s *Service) Leave(ctx context.Context, requestID string, callerID int64, _ int32, target int64) (Reply, error) {
	if err := requireRequest(requestID, callerID); err != nil {
		return s.reply(alliancerule.Answer{}, err)
	}
	reply, err := s.remove(ctx, requestID, callerID, target, callerID)
	if err == nil {
		slog.InfoContext(ctx, "alliance: leave confirmed", "player_id", callerID, "member_id", callerID, "alliance_id", reply.Alliance.AllianceID, "request_key", requestID, "replayed", reply.Replayed)
	}
	return reply, err
}

// Kick implements Alliance.
func (s *Service) Kick(ctx context.Context, requestID string, callerID int64, _ int32, target int64, memberID int64) (Reply, error) {
	if err := requireRequest(requestID, callerID, memberID); err != nil {
		return s.reply(alliancerule.Answer{}, err)
	}
	reply, err := s.remove(ctx, requestID, callerID, target, memberID)
	if err == nil {
		slog.InfoContext(ctx, "alliance: kick confirmed", "player_id", callerID, "member_id", memberID, "alliance_id", reply.Alliance.AllianceID, "request_key", requestID, "replayed", reply.Replayed)
	}
	return reply, err
}

// remove unseats memberID: the roster first, then the guard — in the same
// transaction when the guard is this instance's, otherwise by a direct
// ClearGuard on the guard's owner (finishGuard: best effort; a lost one
// leaves the guard stale-occupied until the next request that finds it held
// heals it from this roster). The member's notice follows the write
// (notify).
func (s *Service) remove(ctx context.Context, requestID string, actorID, target, memberID int64) (Reply, error) {
	guard, err := GuardTarget(memberID)
	if err != nil {
		return s.reply(alliancerule.Answer{}, fmt.Errorf("%w: player %d: %v", ErrRequestInvalid, memberID, err))
	}
	var answer alliancerule.Answer
	err = s.call(ctx, target, alliance.EntityKindAlliance, func(ctx context.Context) error {
		exists, here, err := s.owned(ctx, guard)
		if err != nil {
			return err
		}
		if exists && here {
			if err := s.deps.Entities.EnsureGuard(ctx, memberID); err != nil {
				return err
			}
			answer, err = syncsender.NewAllianceRemoveSender(s.deps.Nest).MultiSync_AllianceRemove(ctx, target, guard, requestID, actorID, s.retention())
			if !s.moved(ctx, guard, err) {
				if err == nil {
					s.notify(ctx, answer)
				}
				return err
			}
		}
		answer, err = syncsender.NewAllianceRemoveSender(s.deps.Nest).Sync_AllianceRemoveDetached(ctx, target, requestID, actorID, memberID, s.retention())
		if err == nil {
			s.notify(ctx, answer)
		}
		if err == nil && answer.Ended != "" {
			s.finishGuard(ctx, memberID, entity.GetUniqueIDFromEntityID(target), answer.Ended, alliancerule.MemberLeft)
		}
		return err
	})
	return s.reply(answer, err)
}
