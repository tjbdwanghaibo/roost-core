package alliance

import (
	"context"
	"fmt"

	rpcalliance "{{MODULE}}/internal/rpc/alliance"

	"github.com/tjbdwanghaibo/roost-core/framework/app"
	"github.com/tjbdwanghaibo/roost-core/infra/network/bus"
	"github.com/tjbdwanghaibo/roost-core/infra/observe/admin"
	"github.com/tjbdwanghaibo/roost-core/wiring/mods"
)

const (
	adminTransfer = "alliance.transfer"
	adminInfo     = "alliance.info"
	adminGuard    = "alliance.guard"
	// adminStopFounding is the first step of scaling an instance in (plan
	// §2.7 缩容): it stops taking new alliances, then alliance.transfer moves
	// what it owns, then it is stopped.
	adminStopFounding = "alliance.stop_founding"
)

type transferPayload struct {
	// IDs are full entity ids (alliances or guards); Count, when IDs is
	// empty, moves that many of the entities this instance owns.
	IDs   []int64 `json:"ids"`
	Count int     `json:"count"`
	ToSID int32   `json:"to_sid"`
}

type allianceInfoPayload struct {
	AllianceID int64 `json:"alliance_id"`
}

type guardPayload struct {
	PlayerID int64 `json:"player_id"`
}

// registerAdminCommands adds the alliance operator commands to the ops admin
// endpoint (POST /admin/execute) of this process. A process without the admin
// registry (admin off) skips them.
func registerAdminCommands(registry *app.Registry, service *rpcalliance.Service) error {
	commands, ok := app.Lookup[*admin.Registry](registry, mods.ModAdmin)
	if !ok || commands == nil {
		return nil
	}
	definitions := []admin.CommandDef{
		{
			Name: adminTransfer,
			Description: "move alliances and guards THIS instance owns to to_sid: {ids: [full entity ids], to_sid} or {count, to_sid} " +
				"(the first count it owns, alliances first, listed by owner). Run on the instance giving them away; guards with an open reservation are " +
				"reported as pending, run again once they settle; more=true means the command stopped before its deadline (ops.admin_timeout), run it again. " +
				"Callers follow the new owner by redirect and the route registration",
			Handler: func(ctx context.Context, cmd admin.Command) (admin.Result, error) {
				payload, err := admin.DecodePayload[transferPayload](cmd)
				if err != nil {
					return admin.Result{}, err
				}
				report, err := service.TransferOwnership(ctx, payload.IDs, payload.Count, payload.ToSID)
				if err != nil {
					return admin.Result{}, fmt.Errorf("%w: %v", admin.ErrCommandInvalid, err)
				}
				return admin.Result{Data: map[string]any{"moved": report.Moved, "pending": report.Pending, "failed": report.Failed, "more": report.More}}, nil
			},
		},
		{
			Name:        adminInfo,
			Description: "the authoritative alliance: {alliance_id}",
			Handler: func(ctx context.Context, cmd admin.Command) (admin.Result, error) {
				payload, err := admin.DecodePayload[allianceInfoPayload](cmd)
				if err != nil {
					return admin.Result{}, err
				}
				reply, err := service.AllianceInfo(ctx, payload.AllianceID)
				if err != nil {
					return admin.Result{}, err
				}
				return admin.Result{Data: map[string]any{"alliance": reply.Alliance, "served_by_sid": reply.ServedBySID}}, nil
			},
		},
		{
			Name:        adminGuard,
			Description: "a player's alliance guard: {player_id}",
			Handler: func(ctx context.Context, cmd admin.Command) (admin.Result, error) {
				payload, err := admin.DecodePayload[guardPayload](cmd)
				if err != nil {
					return admin.Result{}, err
				}
				reply, err := service.GuardInfo(ctx, payload.PlayerID)
				if err != nil {
					return admin.Result{}, err
				}
				return admin.Result{Data: map[string]any{"guard": reply.State, "served_by_sid": reply.ServedBySID}}, nil
			},
		},
	}
	if busClient, ok := app.Lookup[bus.IBus](registry, mods.ModBus); ok && busClient != nil {
		definitions = append(definitions, admin.CommandDef{
			Name: adminStopFounding,
			Description: "stop taking new alliances on THIS instance (scale-in, step 1): leave Found's bus queue group, so founding " +
				"requests go to the other instances; route RPCs on what it owns keep arriving on its own subject. Not undone until the " +
				"process restarts. Then alliance.transfer {count, to_sid} until it owns nothing, then stop it",
			Handler: func(context.Context, admin.Command) (admin.Result, error) {
				if err := stopFounding(busClient); err != nil {
					return admin.Result{}, err
				}
				return admin.Result{Data: map[string]any{"left": rpcalliance.MethodFound}}, nil
			},
		})
	}
	for _, definition := range definitions {
		if err := commands.Register(definition); err != nil {
			return fmt.Errorf("alliance: admin command %s: %w", definition.Name, err)
		}
	}
	return nil
}

// stopFounding takes this instance out of the queue group Found is delivered
// through (bus.RPCQueueLeaver): a founding request goes to one instance of
// the group, so after this it lands on the others. Route RPCs are sent to an
// owner's own subject and are not affected; an instance keeps serving what it
// owns until alliance.transfer has moved it away. Idempotent.
func stopFounding(busClient bus.IBus) error {
	leaver, ok := busClient.(bus.RPCQueueLeaver)
	if !ok {
		return fmt.Errorf("alliance: this bus (%T) cannot leave an rpc queue group", busClient)
	}
	if err := leaver.LeaveRPCQueue(rpcalliance.MethodFound); err != nil {
		return fmt.Errorf("alliance: leave the %s queue group: %w", rpcalliance.MethodFound, err)
	}
	return nil
}
