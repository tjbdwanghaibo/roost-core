package db

import (
	"testing"

	"github.com/tjbdwanghaibo/roost-core/framework/dataengine"
	"go.mongodb.org/mongo-driver/v2/bson"
)

// PlayerDao.Alliance.ID is the player's own copy of their membership: persisted
// and synced. The alliance service's roster is the only authority on
// membership (decision 1 of the alliance plan), but the membership guards are
// not mirrored to game servers (AllianceMember declares snapshots=none), so
// the copy on the Player document is what the game knows across logins. Both
// directions: a stored document's alliance_id is loaded, and the document the
// DAO writes carries it. Nearby players see the alliance (the "near" sync view).
func TestAllianceDisplayIsPersistedAsThePlayersCopy(t *testing.T) {
	stored, err := bson.Marshal(bson.M{"_id": int64(42), "alliance": bson.M{"1": int64(7)}})
	if err != nil {
		t.Fatal(err)
	}
	dao := NewPlayerDao()
	dao.SetId(42)
	if err := dao.RestorePersisted(stored, PlayerDaoSchemaVersion, 1); err != nil {
		t.Fatalf("restore: %v", err)
	}
	if got := dao.GetAlliance().GetID(); got != 7 {
		t.Fatalf("Alliance.ID restored from the Player document = %d, want 7", got)
	}
	var written struct {
		Alliance struct {
			ID int64 `bson:"1"`
		} `bson:"alliance"`
	}
	if err := bson.Unmarshal(dao.MarshalPersist(dataengine.AllFields), &written); err != nil {
		t.Fatal(err)
	}
	if value := written.Alliance.ID; value != int64(7) {
		t.Fatalf("the Player document the DAO writes carries alliance_id = %v, want 7", value)
	}
}
