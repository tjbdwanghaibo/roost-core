// Package notice 是可信服务端公告入口。没有玩家协议；周期播放应由项目调度器用每次播放的稳定事件键调用。
package notice

import (
	"context"
	"errors"
	"fmt"
	"log/slog"
	"strings"
	"sync/atomic"

	gamechat "{{MODULE}}/game/chat"
	chatcontroller "{{MODULE}}/game/controllers/chat"

	"github.com/tjbdwanghaibo/roost-core/framework/app"
)

const Capability app.ModName = "notice.publisher"

var (
	// ErrInvalid：类别、正文或稳定键不合法，没有调用 chat。调用方（例如 with/gm 的运维命令）据此换成自己的拒绝码。
	ErrInvalid = errors.New("notice: invalid notice")
	// ErrStopped：模块已停止或没有启动。
	ErrStopped = errors.New("notice: publisher is stopped")
)

type announcer interface {
	AnnounceWorld(context.Context, string, string) error
}
type Publisher struct {
	chat    announcer
	stopped atomic.Bool
}

// Publish 经 chat 的正式系统发布入口持久化并向本进程在线玩家推送；漏掉的推送由 ChatHistory 补读。
// kind 是 announce 或 marquee，通过中文前缀表达展示意图；客户端可以按前缀选择表现。不是另一条旁路广播。
// key 必须稳定、同键内容不可变。chat 保留期内重复不新增历史，但在线推送可能重复，客户端按 Seq 去重。
// 调用在 Nest 外执行；没有定时器、goroutine 或自建在线名单。
func (publisher *Publisher) Publish(ctx context.Context, kind, text, key string) error {
	if publisher == nil || publisher.chat == nil || publisher.stopped.Load() {
		return ErrStopped
	}
	prefix := ""
	switch kind {
	case "announce":
		prefix = "公告："
	case "marquee":
		prefix = "跑马灯："
	default:
		return fmt.Errorf("%w: unknown kind %q", ErrInvalid, kind)
	}
	if strings.TrimSpace(text) == "" || strings.TrimSpace(key) == "" || len(key) > 64 {
		return fmt.Errorf("%w: text and stable key are required (key <= 64 bytes)", ErrInvalid)
	}
	if err := gamechat.ValidateText([]byte(prefix + text)); err != nil {
		return fmt.Errorf("%w: %v", ErrInvalid, err)
	}
	err := publisher.chat.AnnounceWorld(ctx, prefix+text, "notice:"+kind+":"+key)
	if err == nil {
		slog.DebugContext(ctx, "notice: publish completed", "kind", kind, "key", key)
	}
	return err
}

// FromRegistry 供可信业务代码取启动时发布的入口，不经玩家网络端点。
func FromRegistry(registry *app.Registry) (*Publisher, error) {
	if registry == nil {
		return nil, fmt.Errorf("notice: registry is required")
	}
	publisher, ok := app.Lookup[*Publisher](registry, Capability)
	if !ok || publisher == nil {
		return nil, fmt.Errorf("notice: publisher is unavailable")
	}
	return publisher, nil
}

// Start 由模块服务适配器调用。本模块只发布可信的服务端入口，不登记运维命令，也不要求进程里有运维入口；
// 运维命令在装了 gm 模块时由联动文件 game/gm/notice.go 经 gm 的登记点提供（操作者与备注必填、带审计）。
func Start(registry *app.Registry) (func(context.Context) error, error) {
	if registry == nil {
		return nil, fmt.Errorf("notice: registry is required")
	}
	chat, err := chatcontroller.FromRegistry(registry)
	if err != nil {
		return nil, err
	}
	return start(registry, chat)
}

func start(registry *app.Registry, chat announcer) (func(context.Context) error, error) {
	publisher := &Publisher{chat: chat}
	if err := registry.Register(Capability, publisher); err != nil {
		return nil, err
	}
	// 本模块不持后台任务或依赖的释放责任；依赖排空由 App 的 chat 生命周期负责。
	return func(context.Context) error { publisher.stopped.Store(true); return nil }, nil
}
