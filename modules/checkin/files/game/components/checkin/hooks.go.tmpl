package checkin

import (
	"{{MODULE}}/game/view"
	"fmt"
	"sort"
	"sync"
)

// 签到成功的登记点：别的功能在“今天签到成功”时顺带做一件事（每日任务推进一次、活动计数……）。
//
// 钩子在 Claim 的同一笔事务里、Player 的实体锁内执行，拿到的是这名 Player 自己：
//
//   - 只改这名 Player 的状态（经同一个实体上别的组件），不做事务之外的事（发消息、调别的服务）；
//   - 返回错误会让这一次签到整笔回滚（奖励、进度、钩子之前写的都撤销），玩家收到这个错误、之后可以再签。
//     不想让签到因为自己失败的功能，就在钩子里把错误吞掉；
//   - 一个业务日只会随成功的签到执行一次；被拒绝的签到（今天签过了）不执行。
//
// 登记只在 init 里做（装了对应模块时由它的联动文件登记），之后只读；重名、空名、nil 是写错了，直接 panic。
type CheckinClaimedHook func(owner view.PlayerEntity, result CheckinResult, nowUnixMilli int64) error

var (
	checkinClaimedMu    sync.RWMutex
	checkinClaimedHooks = map[string]CheckinClaimedHook{}
)

// OnCheckinClaimed 登记一个签到成功的钩子，name 用功能自己的名字（模块名）。
func OnCheckinClaimed(name string, hook CheckinClaimedHook) {
	if name == "" || hook == nil {
		panic("checkin: OnCheckinClaimed needs a name and a hook")
	}
	checkinClaimedMu.Lock()
	defer checkinClaimedMu.Unlock()
	if _, taken := checkinClaimedHooks[name]; taken {
		panic(fmt.Sprintf("checkin: hook %q is registered twice", name))
	}
	checkinClaimedHooks[name] = hook
}

// runCheckinClaimed 按名字顺序执行钩子；第一个错误原样返回，交给事务回滚。
func runCheckinClaimed(owner view.PlayerEntity, result CheckinResult, nowUnixMilli int64) error {
	checkinClaimedMu.RLock()
	names := make([]string, 0, len(checkinClaimedHooks))
	for name := range checkinClaimedHooks {
		names = append(names, name)
	}
	sort.Strings(names)
	hooks := make([]CheckinClaimedHook, len(names))
	for i, name := range names {
		hooks[i] = checkinClaimedHooks[name]
	}
	checkinClaimedMu.RUnlock()
	for i, hook := range hooks {
		if err := hook(owner, result, nowUnixMilli); err != nil {
			return fmt.Errorf("checkin: hook %s: %w", names[i], err)
		}
	}
	return nil
}
