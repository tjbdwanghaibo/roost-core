package player

import (
	"{{MODULE}}/game/components/checkin"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type={{ID:component:Checkin}}
const CompTypeCheckin entity.ComponentType = {{ID:component:Checkin}}

// CheckinComponent 是 game/components/checkin 的组件在 Player 上的名字（生成接线与 handler 用它）；业务在那个包里。
type CheckinComponent = checkin.Component

// ICheckinEntity 是 Nest handler 用这个组件时的窄实体接口；getter 由生成的 Entity 接线实现。
type ICheckinEntity interface {
	entity.IThreadSafeEntity
	CheckinComp() *CheckinComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeCheckin, checkin.NewComponent)
}
