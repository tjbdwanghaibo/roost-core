package checkin

import (
	"log/slog"

	"{{MODULE}}/game/playeraccess"
	"{{MODULE}}/protocol/pb"
)

// HandleCheckinClaim 是签到协议的入口；目标取认证会话的玩家，是否已签在 Nest handler 的锁内判断。
//
//roost:endpoint nest=CheckinClaim
func (controller *Controller) HandleCheckinClaim(ctx *playeraccess.Context, req *pb.CheckinClaimRequest) (*pb.CheckinClaimResponse, error) {
	response, err := controller.dispatchCheckinClaim(ctx, req)
	// 只记录已确认的请求结果；带业务键的重放也会返回成功，不把日志当作资产流水。
	if err == nil && response != nil && response.Code == 0 && ctx != nil && req != nil {
		slog.InfoContext(ctx.Context(), "checkin: claim completed", "player_id", ctx.PlayerID, "streak", response.Streak, "reward", response.Reward, "balance", response.Balance)
	}
	return response, err
}
