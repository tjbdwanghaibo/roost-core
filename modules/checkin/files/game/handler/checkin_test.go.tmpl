const checkinDay = 24 * time.Hour

// 奖励规则的数字只写死在两条用例里（样例规则：连续第 n 天发 10 × min(n, 7) 金币）：
// TestCheckinFirstClaimPaysTheBaseReward 与 TestCheckinConsecutiveDaysGrowTheStreakAndReward。
// 工程改了 checkin_component.go 的奖励规则，就按自己的规则改这两条；其余用例只断言签到自己的事实
// （同日拒绝零写入、断签从第 1 天算、回滚、钩子），拿应答里的 Reward / Balance 比对，不随奖励数额变。
// 不引用 checkin_component.go 的常量：常量改错了，引用它的断言照样通过。

// 测试替身自己带一份，不借用别的模块的测试文件：那些文件归工程所有，可能被改。
type checkinGetter map[int64]entity.IThreadSafeEntity

func (g checkinGetter) Get(_ context.Context, id int64, _ entity.EntityCategory) (entity.IThreadSafeEntity, error) {
	if e := g[id]; e != nil {
		return e, nil
	}
	return nil, fmt.Errorf("missing %d", id)
}

func (g checkinGetter) GetMany(ctx context.Context, ids []int64, cats []entity.EntityCategory) ([]entity.IThreadSafeEntity, error) {
	out := make([]entity.IThreadSafeEntity, len(ids))
	for i, id := range ids {
		e, err := g.Get(ctx, id, cats[i])
		if err != nil {
			return nil, err
		}
		out[i] = e
	}
	return out, nil
}

// checkinCommitter 是替身提交器：不落盘，reject 打开时拒绝提交，用来验证回滚。
type checkinCommitter struct{ reject atomic.Bool }

func (c *checkinCommitter) Commit(context.Context, dataengine.CommitRecord) error {
	if c.reject.Load() {
		return errors.New("injected rejection")
	}
	return nil
}

type checkinFixture struct {
	engine    *nest.NestMgr
	player    *playerentity.Player
	claims    *sender.CheckinClaimSender
	committer *checkinCommitter
	now       atomic.Int64
}

// newCheckinFixture 用替身提交器起一个 Nest，业务时钟由用例拨：签到按业务日切分（测试里是缺省的 UTC 零点）。
// clock.SetSource 是进程级的：一个用例里只建一个 fixture，后建的会顶掉前一个的时钟。
func newCheckinFixture(t *testing.T) *checkinFixture {
	t.Helper()
	playerentity.RegisterEntity()
	RegisterCheckinClaimNestHandlers()
	f := &checkinFixture{committer: &checkinCommitter{}}
	f.now.Store(time.Date(2026, 11, 10, 9, 0, 0, 0, time.UTC).UnixMilli())
	clock.SetSource(func() time.Time { return time.UnixMilli(f.now.Load()) })
	t.Cleanup(func() { clock.SetSource(nil) })
	id, err := entity.BuildEntityID(92001, playerentity.EntityKindPlayer)
	if err != nil {
		t.Fatal(err)
	}
	built, err := entity.BuildEntity(&entity.EntityCreateParam{IsCreate: true, Id: id, Kind: playerentity.EntityKindPlayer})
	if err != nil {
		t.Fatal(err)
	}
	f.player = built.(*playerentity.Player)
	f.engine = nest.NewEngine(nest.NestOptionWithGetter(checkinGetter{id: built}), nest.NestOptionWithTransactionCommitter(f.committer),
		nest.NestOptionWithWorkerPools(nest.WorkerPoolConfig{Workers: 2, QueueCap: 64}, nest.WorkerPoolConfig{}, nest.WorkerPoolConfig{}))
	if err := f.engine.Start(); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := f.engine.Shutdown(context.Background()); err != nil {
			t.Error(err)
		}
	})
	f.claims = sender.NewCheckinClaimSender(f.engine)
	return f
}

func (f *checkinFixture) claim() (*pb.CheckinClaimResponse, error) {
	return f.claims.Sync_CheckinClaim(context.Background(), f.player.ID(), &pb.CheckinClaimRequest{})
}

func (f *checkinFixture) mustClaim(t *testing.T) *pb.CheckinClaimResponse {
	t.Helper()
	response, err := f.claim()
	if err != nil {
		t.Fatal(err)
	}
	return response
}

// snapshot 在业务 worker 上持实体锁读签到进度与余额。
func (f *checkinFixture) snapshot(t *testing.T) (streak, total int32, coins int64) {
	t.Helper()
	if err := f.engine.RunLocal(context.Background(), func() {
		f.player.GetMutex().Lock()
		defer f.player.GetMutex().Unlock()
		state := f.player.Dao().GetCheckin()
		streak, total = state.GetStreak(), state.GetTotal()
		coins = f.player.Dao().GetWallet().GetCoins()
	}); err != nil {
		t.Fatal(err)
	}
	return streak, total, coins
}

func TestCheckinFirstClaimPaysTheBaseReward(t *testing.T) {
	f := newCheckinFixture(t)
	response := f.mustClaim(t)
	if response.Streak != 1 || response.Reward != 10 || response.Balance != 10 {
		t.Fatalf("response = %+v, want streak 1, reward 10, balance 10", response)
	}
}

func TestCheckinSecondClaimOnTheSameDayWritesNothing(t *testing.T) {
	f := newCheckinFixture(t)
	first := f.mustClaim(t)
	f.now.Add(int64(3 * time.Hour / time.Millisecond)) // 同一个 UTC 日
	if _, err := f.claim(); !errors.Is(err, apperrors.ErrCheckinDone) {
		t.Fatalf("err = %v, want checkin_done", err)
	}
	if streak, total, coins := f.snapshot(t); streak != 1 || total != 1 || coins != first.Balance {
		t.Fatalf("refusal wrote: streak=%d total=%d coins=%d (balance after the first claim %d)", streak, total, coins, first.Balance)
	}
}

func TestCheckinConsecutiveDaysGrowTheStreakAndReward(t *testing.T) {
	f := newCheckinFixture(t)
	// 样例规则逐天写死：第 1～7 天 10、20……70，第 8 天起封顶 70。
	balance := int64(0)
	for day, want := range []int64{10, 20, 30, 40, 50, 60, 70, 70, 70} {
		if day > 0 {
			f.now.Add(int64(checkinDay / time.Millisecond))
		}
		balance += want
		response := f.mustClaim(t)
		if response.Streak != int32(day+1) || response.Reward != want || response.Balance != balance {
			t.Fatalf("day %d = %+v, want streak %d, reward %d, balance %d", day+1, response, day+1, want, balance)
		}
	}
}

func TestCheckinMissedDayResetsTheStreak(t *testing.T) {
	f := newCheckinFixture(t)
	first := f.mustClaim(t)
	f.now.Add(int64(checkinDay / time.Millisecond))
	f.mustClaim(t)
	f.now.Add(int64(2 * checkinDay / time.Millisecond)) // 断签一天
	// 断签之后从第 1 天算：连续天数回到 1，奖励与第一次签到相同。
	response := f.mustClaim(t)
	if response.Streak != 1 || response.Reward != first.Reward {
		t.Fatalf("after a missed day = %+v, want streak 1 and the first-day reward %d", response, first.Reward)
	}
	if _, total, _ := f.snapshot(t); total != 3 {
		t.Fatalf("total = %d, want 3", total)
	}
}

// 签到进度与货币在同一笔事务里：提交被拒绝时两者一起回滚，之后同一天还能再领。
func TestCheckinRejectedCommitRollsBackProgressAndCoins(t *testing.T) {
	f := newCheckinFixture(t)
	f.committer.reject.Store(true)
	if _, err := f.claim(); err == nil {
		t.Fatal("a rejected commit reported success")
	}
	f.committer.reject.Store(false)
	if streak, total, coins := f.snapshot(t); streak != 0 || total != 0 || coins != 0 {
		t.Fatalf("rollback left streak=%d total=%d coins=%d", streak, total, coins)
	}
	if response := f.mustClaim(t); response.Streak != 1 || response.Balance != response.Reward {
		t.Fatalf("claim after rollback = %+v, want streak 1 and the reward as the whole balance", response)
	}
}

// 连续签到多久都能领：“今天领过没有”记在签到自己的进度里，发奖不占货币的去重窗口。
// 修前：每次签到占一条货币回执，回执满了不淘汰，第 129 天起签到与消费全部被拒（wallet_ledger_full）。
func TestCheckinKeepsPayingPastTheWalletReceiptWindow(t *testing.T) {
	f := newCheckinFixture(t)
	const days = playerentity.WalletReceiptWindow + 72
	for day := 1; day <= days; day++ {
		if _, err := f.claim(); err != nil {
			t.Fatalf("day %d: %v", day, err)
		}
		f.now.Add(int64(checkinDay / time.Millisecond))
	}
	var receipts int
	if err := f.engine.RunLocal(context.Background(), func() {
		f.player.GetMutex().Lock()
		defer f.player.GetMutex().Unlock()
		receipts = f.player.Dao().GetWalletLedger().ReceiptsLen()
	}); err != nil {
		t.Fatal(err)
	}
	if _, total, _ := f.snapshot(t); total != days || receipts != 0 {
		t.Fatalf("total = %d (want %d), wallet receipts = %d (want 0: check-in keeps its own fact)", total, days, receipts)
	}
}

// checkinProbe 是测试登记的签到钩子。登记表是进程级的、只能登记一次，所以用开关控制它在哪条用例里生效。
var checkinProbe struct {
	once    sync.Once
	enabled atomic.Bool
	fail    atomic.Bool
	calls   atomic.Int64
	streak  atomic.Int32
	reward  atomic.Int64
	at      atomic.Int64
}

func useCheckinProbe(t *testing.T) {
	t.Helper()
	checkinProbe.once.Do(func() {
		gamecheckin.OnCheckinClaimed("zz-checkin-test-probe", func(owner *playerentity.Player, result gamecheckin.CheckinResult, nowUnixMilli int64) error {
			if !checkinProbe.enabled.Load() {
				return nil
			}
			checkinProbe.calls.Add(1)
			checkinProbe.streak.Store(result.Streak)
			checkinProbe.reward.Store(result.Reward)
			checkinProbe.at.Store(nowUnixMilli)
			if owner == nil || owner.Dao().GetCheckin().GetStreak() != result.Streak {
				return errors.New("the hook ran before the check-in was recorded")
			}
			if checkinProbe.fail.Load() {
				return errors.New("injected hook failure")
			}
			return nil
		})
	})
	checkinProbe.calls.Store(0)
	checkinProbe.fail.Store(false)
	checkinProbe.enabled.Store(true)
	t.Cleanup(func() { checkinProbe.enabled.Store(false) })
}

// 签到成功执行一次登记的钩子，带着这一次的结果与业务时间；被拒绝的签到不执行。
func TestCheckinClaimedHookRunsOncePerSuccessfulClaim(t *testing.T) {
	f := newCheckinFixture(t)
	useCheckinProbe(t)
	first := f.mustClaim(t)
	if calls := checkinProbe.calls.Load(); calls != 1 {
		t.Fatalf("the hook ran %d times for one claim", calls)
	}
	if checkinProbe.streak.Load() != 1 || checkinProbe.reward.Load() != first.Reward || checkinProbe.at.Load() != f.now.Load() {
		t.Fatalf("the hook saw streak=%d reward=%d at=%d", checkinProbe.streak.Load(), checkinProbe.reward.Load(), checkinProbe.at.Load())
	}
	if _, err := f.claim(); !errors.Is(err, apperrors.ErrCheckinDone) {
		t.Fatalf("err = %v, want checkin_done", err)
	}
	if calls := checkinProbe.calls.Load(); calls != 1 {
		t.Fatalf("a refused claim ran the hook: %d calls", calls)
	}
	f.now.Add(int64(checkinDay / time.Millisecond))
	second := f.mustClaim(t)
	if checkinProbe.calls.Load() != 2 || checkinProbe.streak.Load() != 2 || checkinProbe.reward.Load() != second.Reward {
		t.Fatalf("day 2: calls=%d streak=%d reward=%d", checkinProbe.calls.Load(), checkinProbe.streak.Load(), checkinProbe.reward.Load())
	}
}

// 钩子返回错误：这一次签到整笔回滚（奖励与进度都没有），之后钩子好了还能签。
func TestCheckinClaimedHookFailureRollsBackTheClaim(t *testing.T) {
	f := newCheckinFixture(t)
	useCheckinProbe(t)
	checkinProbe.fail.Store(true)
	if _, err := f.claim(); err == nil {
		t.Fatal("a failing hook let the claim succeed")
	}
	if streak, total, coins := f.snapshot(t); streak != 0 || total != 0 || coins != 0 {
		t.Fatalf("the failed claim left streak=%d total=%d coins=%d", streak, total, coins)
	}
	checkinProbe.fail.Store(false)
	response := f.mustClaim(t)
	if response.Streak != 1 || response.Balance != response.Reward {
		t.Fatalf("claim after the hook recovered = %+v, want streak 1 and the reward as the whole balance", response)
	}
}
