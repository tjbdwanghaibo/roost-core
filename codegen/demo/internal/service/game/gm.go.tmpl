package {{GAME_SERVICE_PKG}}

import (
	"context"
	"fmt"
	"log/slog"
	"time"

	gameactivity "{{MODULE}}/game/activity"
	guild "{{MODULE}}/game/entities/guild"
	player "{{MODULE}}/game/entities/player"
	syncsender "{{MODULE}}/game/handler/syncsender"
	lifecycle "{{MODULE}}/game/lifecycle"
	"{{MODULE}}/game/rewards"
	"github.com/tjbdwanghaibo/roost-core/admin"
	"github.com/tjbdwanghaibo/roost-core/app"
	"github.com/tjbdwanghaibo/roost-core/configdata"
	"github.com/tjbdwanghaibo/roost-core/entity"
	"github.com/tjbdwanghaibo/roost-core/featureflag"
	"github.com/tjbdwanghaibo/roost-core/hotcode"
	corenest "github.com/tjbdwanghaibo/roost-core/nest"
	"github.com/tjbdwanghaibo/roost-core/saga"
	"github.com/tjbdwanghaibo/roost-kit/mods"
	svcmail "github.com/tjbdwanghaibo/roost-kit/service/mail"
