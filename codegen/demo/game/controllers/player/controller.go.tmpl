// Controller hosts the player protocol endpoints. It holds what an endpoint
// may reach for: the Nest client, for everything that touches a locked
// Entity; the Player lifecycle, for the one operation that happens before
// there is an Entity to lock; the match and chat service clients, typed
// servicerpc interfaces to other processes; the set of players online in this
// process, for chat fan-out; and this process's World id.
type Controller struct {
	registry   *app.Registry
	nestClient corenest.Client
	players    *lifecycle.PlayerLifecycle
	guilds     *lifecycle.GuildLifecycle
	matcher    svcmatch.Matchmaker
	messaging  svcchat.Messaging
	mailer     svcmail.Mail
	sessions   svcsession.Session
	ranking    svcrank.Rank
	payments   svcplatform.Platform
	purchases  atomic.Pointer[purchaseDrainer]
	activities atomic.Pointer[activityRunner]
	owners     atomic.Pointer[playerOwners]
	presence   *chatroom.Presence
	transport  atomic.Pointer[pushTransport]
	battles    atomic.Pointer[battleRouter]
	scene      atomic.Pointer[sceneJoiner]
	worldID    int64
	sceneID    int64
	// paymentSecret is the demo's stand-in for a payment provider's signing
	// key. A real game process does not hold one (see the purchase endpoint).
	paymentSecret string
	// serverSID and ids are what this process needs to mint ids for things it
	// creates: a guild, like a monster, gets an id with this process's sid in
	// it, so two processes founding at the same moment cannot collide.
	serverSID int32
	ids       *runtimeid.Allocator

	// The skill catalog, compiled from game/skills/*.json on first use.
	skillsOnce   sync.Once
	skillCatalog *skills.Catalog
	skillErr     error
}

// battleRouter is the slice of the game service's battle manager the
// endpoints use: one call, plain parameters. It is an interface here, and
// looked up by capability name, for the same reason pushTransport is — the
// service package imports the controller, not the other way round.
type battleRouter interface {
	SubmitBattleInput(ctx context.Context, battleID string, playerID int64, frame uint32, payload []byte, hashFrame uint32, hash uint64, catchupFrom uint32) error
}

// sceneJoiner is the slice of the scene an endpoint needs: put this player's
// Entity into the replicated world. Looked up by capability name for the same
// reason as the battle manager — the service package imports this one.
type sceneJoiner interface {
	Join(ctx context.Context, subject *player.Player, at spatial.Point) error
	Moved(ctx context.Context, subjectID int64, to spatial.Point)
	Leave(ctx context.Context, subjectID int64)
}

// playerOwners is the slice of the game service's ownership table an endpoint
// uses: claim this player for this process at login. Looked up by capability
// name for the same reason the scene is.
type playerOwners interface {
	Claim(ctx context.Context, playerID int64) (bool, error)
	OwnerSID(ctx context.Context, playerID int64) (int32, error)
}

// activityRunner is the slice of the game service's activity runner the
// endpoints use: where a player stands, and one contribution. Looked up by
// capability name for the same reason the scene is.
type activityRunner interface {
	Standing(ctx context.Context, playerID int64) (string, svcactivity.Activity, svcactivity.Participant, error)
	Contribute(ctx context.Context, playerID int64, runID string) (svcactivity.Participant, error)
	Settled(ctx context.Context, activityID string) (bool, error)
}

// purchaseDrainer is the slice of the game service's paid-order drain an
// endpoint uses: settle whatever the platform service has recorded for this
// player. Looked up by capability name for the same reason the scene is.
type purchaseDrainer interface {
	DrainPlayer(ctx context.Context, playerID int64) ([]purchase.Settlement, error)
}

// pushTransport is the slice of the player TCP Runtime the endpoints use.
// It is an interface here, and the capability is looked up by name, because
// the transport package imports the protocol binding that constructs this
// controller — importing it back would be an import cycle.
type pushTransport interface {
	PushPlayer(ctx context.Context, playerID int64, messageID uint32, value any) error
	ActiveSessions(playerID int64) int
}

// playerTCPCapability is internal/access/player/tcp's Name: the capability
// the transport Mod publishes its Runtime under.
const playerTCPCapability app.ModName = "access.player.tcp"

// battleCapability is what internal/service/<game> publishes its battle
// manager under (BattleCapability there). It is registered in the service's
// Init, which runs after this controller is constructed, so the lookup is
// lazy like the transport's.
const battleCapability app.ModName = "{{GAME_SERVICE}}.battle"

// sceneCapability is what internal/service/<game> publishes its scene under
// (SceneCapability there).
const sceneCapability app.ModName = "{{GAME_SERVICE}}.scene"

// purchaseCapability is what internal/service/<game> publishes its paid-order
// drain under (PurchaseCapability there).
const purchaseCapability app.ModName = "{{GAME_SERVICE}}.purchases"

// activityCapability is what internal/service/<game> publishes its activity
// runner under (ActivityCapability there).
const activityCapability app.ModName = "{{GAME_SERVICE}}.activity"

// playerOwnerCapability is what internal/service/<game> publishes its player
// ownership table under (PlayerOwnerCapability there).
const playerOwnerCapability app.ModName = "{{GAME_SERVICE}}.playerowner"

// FromRegistry is what the generated protocol binding calls once per
// process; keep its signature.
func FromRegistry(registry *app.Registry) (*Controller, error) {
	if registry == nil {
		return nil, fmt.Errorf("player controller: app registry is required")
	}
	client, ok := app.Lookup[corenest.Client](registry, app.ModName("nest"))
	if !ok || client == nil {
		return nil, fmt.Errorf("player controller: nest client is unavailable")
	}
	players, err := lifecycle.PlayerFromRegistry(registry)
	if err != nil {
		return nil, fmt.Errorf("player controller: %w", err)
	}
	guilds, err := lifecycle.GuildFromRegistry(registry)
	if err != nil {
		return nil, fmt.Errorf("player controller: %w", err)
	}
	// The same capabilities internal/service/<game>'s generated Match() and
	// Chat() accessors return; looked up here directly so this package does
	// not import the service package.
	matcher, ok := app.Lookup[svcmatch.Matchmaker](registry, svcmatch.CapabilityName)
	if !ok || matcher == nil {
		return nil, fmt.Errorf("player controller: capability %q not found; list match under services.<game>.uses", svcmatch.CapabilityName)
	}
	messaging, ok := app.Lookup[svcchat.Messaging](registry, svcchat.CapabilityName)
	if !ok || messaging == nil {
		return nil, fmt.Errorf("player controller: capability %q not found; list chat under services.<game>.uses", svcchat.CapabilityName)
	}
	mailer, ok := app.Lookup[svcmail.Mail](registry, svcmail.CapabilityName)
	if !ok || mailer == nil {
		return nil, fmt.Errorf("player controller: capability %q not found; list mail under services.<game>.uses", svcmail.CapabilityName)
	}
	sessions, ok := app.Lookup[svcsession.Session](registry, svcsession.CapabilityName)
	if !ok || sessions == nil {
		return nil, fmt.Errorf("player controller: capability %q not found; list session under services.<game>.uses", svcsession.CapabilityName)
	}
	ranking, ok := app.Lookup[svcrank.Rank](registry, svcrank.CapabilityName)
	if !ok || ranking == nil {
		return nil, fmt.Errorf("player controller: capability %q not found; list rank under services.<game>.uses", svcrank.CapabilityName)
	}
	// The demo plays the payment provider, so this process needs the secret
	// the platform service checks callbacks with. Refused here rather than at
	// the first purchase: an empty secret turns every callback into an
	// invalid-signature refusal, which reads as an attack rather than as a
	// missing configuration key.
	paymentSecret := registry.Config().GetString("platform.payment_secret")
	if paymentSecret == "" {
		return nil, fmt.Errorf("player controller: platform.payment_secret is empty; the demo signs its own payment callbacks with it")
	}
	payments, ok := app.Lookup[svcplatform.Platform](registry, svcplatform.CapabilityName)
	if !ok || payments == nil {
		return nil, fmt.Errorf("player controller: capability %q not found; list platform under services.<game>.uses", svcplatform.CapabilityName)
	}
	// The sid comes from the registry's config, not from the runtime-config
	// slot: that slot holds whatever wrote to it last, and the config-data Mod
	// overwrites it with its snapshot (U-0244).
	serverSID := int32(registry.Config().GetInt("sid"))
	ids, err := runtimeid.New(serverSID)
	if err != nil {
		return nil, fmt.Errorf("player controller: %w", err)
	}
	worldID, err := lifecycle.WorldID(registry)
	if err != nil {
		return nil, fmt.Errorf("player controller: %w", err)
	}
	sceneID, err := entity.BuildEntityID(lifecycle.WorldSceneUniqueID, sceneentity.EntityKindScene)
	if err != nil {
		return nil, fmt.Errorf("player controller: %w", err)
	}
	return &Controller{
		registry: registry, nestClient: client, players: players, guilds: guilds,
		matcher: matcher, messaging: messaging, mailer: mailer, sessions: sessions, ranking: ranking,
		payments: payments, paymentSecret: paymentSecret,
		serverSID: serverSID, ids: ids,
		presence: chatroom.DefaultPresence(), worldID: worldID, sceneID: sceneID,
	}, nil
}

