// battleSink is the LockstepBot's outbound half: one BattleInput request
// carries an input, a keyframe hash report or a catch-up request, so all
// three of the sink's methods are the same call with different fields set.
// The bot calls them from whatever goroutine is applying frames; the robot
// session is safe for concurrent calls.
type battleSink struct {
	ctx      context.Context
	session  *session.Session
	battleID string
	// state is this client's simulation. The bot applies frames into it and
	// samples its hash at keyframes; the server never sends state, which is
	// the whole point of lockstep.
	state *battle.State
	seats []lockstep.PlayerID
}

func (sink *battleSink) send(request *pb.BattleInputRequest) error {
	message, err := sink.session.Call(sink.ctx, msgid.MsgBattleInput, msgid.MsgBattleInput, request)
	if err != nil {
		return err
	}
	response, ok := message.Value.(*pb.BattleInputResponse)
	if !ok {
		return fmt.Errorf("battle: unexpected response %T", message.Value)
	}
	return coded(response.Code, response.Reason)
}

func (sink *battleSink) SubmitInput(frame lockstep.FrameID, payload []byte) error {
	// The battle's length is part of the contract both sides read, so the
	// client stops at the last frame rather than being refused for a room
	// that has just closed.
	if battle.Over(frame) {
		return nil
	}
	return sink.send(&pb.BattleInputRequest{BattleID: sink.battleID, Frame: uint32(frame), Payload: payload})
}

func (sink *battleSink) ReportHash(frame lockstep.FrameID, hash uint64) error {
	if battle.Over(frame) {
		return nil
	}
	return sink.send(&pb.BattleInputRequest{BattleID: sink.battleID, HashFrame: uint32(frame), Hash: hash})
}

func (sink *battleSink) RequestCatchup(from lockstep.FrameID) error {
	// Frames ride on the player's TCP connection here, so a gap means the
	// server dropped one, not the network. Ask for history anyway: the room
	// pages it over the same lane, and a demo that hid this would hide the
	// one thing catch-up exists for.
	return sink.send(&pb.BattleInputRequest{BattleID: sink.battleID, CatchupFrom: uint32(from)})
}

// runBattle plays one lockstep battle to its frame budget.
//
// Params: "frames" (how many applied frames to wait for, default the
// contract's budget), "timeout" (default 15s). The battle id is the match id
// join_queue/poll_match left on the blackboard.
func runBattle(ctx context.Context, rb *robot.Context, param any) error {
	params := action.ParamsOf(rb, param)
	want := lockstep.FrameID(params.Int64("frames", int64(battle.Frames)))
	timeout := params.Duration("timeout", 15*time.Second)
	raw, ok := rb.Blackboard.Get("match_id")
	battleID, _ := raw.(string)
	if !ok || battleID == "" {
		return errors.New("battle: no match_id on the blackboard; join_queue must run first")
	}
	rawMembers, _ := rb.Blackboard.Get("match_members")
	members, _ := rawMembers.([]int64)
	rawPlayer, _ := rb.Blackboard.Get("player_id")
	playerID, _ := rawPlayer.(int64)
	// The seat is this robot's index among the members, the same mapping the
	// game service made when it opened the room. A robot that cannot find
	// itself in the match has no business submitting inputs.
	seat := lockstep.PlayerID(0)
	for index, member := range members {
		if member == playerID {
			seat = battle.Seat(index)
			break
		}
	}
	if seat == 0 {
		return fmt.Errorf("battle: player %d is not among the %d members of match %s", playerID, len(members), battleID)
	}
	robotSession := rb.Session()
	if robotSession == nil {
		return session.ErrClosed
	}
	battleCtx, cancel := context.WithTimeout(ctx, timeout)
	defer cancel()

	sink := &battleSink{ctx: battleCtx, session: robotSession, battleID: battleID, state: battle.NewState(), seats: battle.Seats(len(members))}
	// A tiny deterministic input: everyone walks right one unit per frame.
	// Deterministic on purpose — two clients that apply the same frames must
	// reach the same state, and the keyframe hashes prove they did.
	bot, err := robot.NewLockstepBot(robot.LockstepBotConfig{
		Player:           seat,
		Sink:             sink,
		Simulate:         func(frame lockstep.Frame) error { return sink.state.Apply(frame) },
		Input:            func(lockstep.FrameID) []byte { return battle.Encode(battle.Input{DX: 1}) },
		Hash:             func(lockstep.FrameID) uint64 { return sink.state.Hash(sink.seats) },
		KeyframeInterval: battle.KeyframeInterval,
	})
	if err != nil {
		return fmt.Errorf("battle: %w", err)
	}
	// The push handler only hands the packet over: it runs on the session's
	// read loop, and applying a frame sends this seat's next input on the
	// same session — doing that here would block the reader against its own
	// response. The loop below owns the bot. A full queue drops the packet,
	// which is exactly what a lossy lane does: the next packet carries the
	// frame again (redundancy), and a gap too wide for that asks the room
	// for history.
	packets := make(chan []byte, 256)
	if err := rb.EnsurePushCapture("battle:"+battleID, msgid.MsgBattleFrame, func(message *session.Message) {
		push, ok := message.Value.(*pb.BattleFramePush)
		if !ok || push.BattleID != battleID {
			return
		}
		select {
		case packets <- push.Packet:
		default:
		}
	}); err != nil {
		return fmt.Errorf("battle: capture frames: %w", err)
	}
	// The first input opens the room: it starts cutting frames once a seat
	// has spoken, so nobody waits on an opponent who never connected.
	if err := sink.SubmitInput(bot.Next(), battle.Encode(battle.Input{DX: 1})); err != nil {
		return fmt.Errorf("battle: first input: %w", err)
	}
	for {
		select {
		case packet := <-packets:
			// Applying a frame runs the simulation, sends this seat's input
			// for the next one and, at a keyframe, its state hash.
			if err := bot.HandleBroadcast(packet); err != nil {
				return fmt.Errorf("battle: apply frame: %w", err)
			}
			if terminal := bot.Terminal(); terminal != nil {
				return fmt.Errorf("battle: bot is terminal: %w", terminal)
			}
			// Next is the frame the bot is waiting for, so it has applied
			// everything below it.
			if bot.Next() > want {
				stats := bot.Stats()
				rb.Blackboard.Set("battle_frames", int64(bot.Next()-1))
				rb.Blackboard.Set("battle_catchups", int64(stats.CatchupsRequested))
				return nil
			}
		case <-battleCtx.Done():
			return fmt.Errorf("battle: applied %d of %d frames before the deadline", bot.Next()-1, want)
		}
	}
}

// sceneWatcher is a client-side view of the replicated world: subject id →
// the fields this client has been told about. It is what a real client would
// feed into its rendering state.
type sceneWatcher struct {
	mu          sync.Mutex
	reassembler *corestate.Reassembler
	session     corestate.SessionID
	subjects    map[int64]bson.M
	frames      int
	deltas      int
	failure     error
}

func (watcher *sceneWatcher) consume(push *pb.EntitySyncPush) {
	watcher.mu.Lock()
	defer watcher.mu.Unlock()
	raw := push.Payload
	if push.Datagram {
		complete, done, _, err := watcher.reassembler.PushFor(watcher.session, push.Payload, time.Now())
		if err != nil {
			watcher.failure = fmt.Errorf("reassemble state frame: %w", err)
			return
		}
		if !done {
			return
		}
		raw = complete
		watcher.deltas++
	}
	_, _, frame, err := room.DecodeRoomWireFrame(raw, corestate.DefaultLimits())
	if err != nil {
		watcher.failure = fmt.Errorf("decode state frame: %w", err)
		return
	}
	watcher.frames++
	for _, object := range frame.Objects {
		for _, component := range object.Components {
			update, err := room.DecodeRoomSubjectUpdate(component.Data, 0)
			if err != nil {
				watcher.failure = fmt.Errorf("decode subject update: %w", err)
				return
			}
			payload := update.Payload.BytesCopy()
			if len(payload) == 0 {
				continue
			}
			var document bson.M
			if err := bson.Unmarshal(payload, &document); err != nil {
				watcher.failure = fmt.Errorf("decode player state: %w", err)
				return
			}
			// A delta carries only what changed, so the client MERGES it into
			// what it already knows. Replacing would make every delta look
			// like a state with three fields missing.
			known := watcher.subjects[update.SubjectID]
			if known == nil {
				known = bson.M{}
				watcher.subjects[update.SubjectID] = known
			}
			for key, value := range document {
				known[key] = value
			}
		}
	}
}

// watchScene installs the capture. Params: none.
func watchScene(_ context.Context, rb *robot.Context, _ any) error {
	rawPlayer, _ := rb.Blackboard.Get("player_id")
	playerID, _ := rawPlayer.(int64)
	watcher := &sceneWatcher{
		reassembler: corestate.NewReassembler(corestate.DefaultLimits(), 5*time.Second),
		session:     corestate.SessionID(playerID),
		subjects:    make(map[int64]bson.M),
	}
	rb.Blackboard.Set("scene_watcher", watcher)
	if err := rb.EnsurePushCapture("scene", msgid.MsgEntitySync, func(message *session.Message) {
		push, ok := message.Value.(*pb.EntitySyncPush)
		if !ok {
			return
		}
		watcher.consume(push)
	}); err != nil {
		return fmt.Errorf("scene_watch: capture state frames: %w", err)
	}
	return nil
}

// expectScene judges what arrived. Params: "fields" (comma separated, each
// must have been replicated for this client's own subject), "timeout".
func expectScene(ctx context.Context, rb *robot.Context, param any) error {
	params := action.ParamsOf(rb, param)
	timeout := params.Duration("timeout", 10*time.Second)
	wanted := strings.Split(params.String("fields", "level"), ",")
	wantSubjects := int(params.Int64("subjects", 1))
	raw, _ := rb.Blackboard.Get("scene_watcher")
	watcher, ok := raw.(*sceneWatcher)
	if !ok || watcher == nil {
		return errors.New("scene_expect: no watcher on the blackboard; scene_watch must run first")
	}
	rawPlayer, _ := rb.Blackboard.Get("player_id")
	playerID, _ := rawPlayer.(int64)
	deadline := time.After(timeout)
	for {
		watcher.mu.Lock()
		failure, subjects := watcher.failure, len(watcher.subjects)
		missing := ""
		if failure == nil && subjects > 0 {
			// The fields are about THIS client, so they have to arrive on
			// this client's own subject. Accepting them from any subject
			// made the check pass on a peer's data — with several robots
			// running, somebody else's equipment satisfied a client that
			// had not equipped anything yet, and the scenario went green
			// while the thing it tests had not happened.
			own := bson.M(nil)
			for subjectID, document := range watcher.subjects {
				if entity.GetUniqueIDFromEntityID(subjectID) == playerID {
					own = document
					break
				}
			}
			if own == nil {
				missing = "this client's own subject"
			} else {
				for _, field := range wanted {
					field = strings.TrimSpace(field)
					if field == "" {
						continue
					}
					if _, ok := own[field]; !ok {
						missing = field
						break
					}
				}
			}
		}
		watcher.mu.Unlock()
		if failure != nil {
			return failure
		}
		if subjects >= wantSubjects && missing == "" {
			return nil
		}
		select {
		case <-ctx.Done():
			return ctx.Err()
		case <-deadline:
			watcher.mu.Lock()
			defer watcher.mu.Unlock()
			return fmt.Errorf("scene_expect: after %s the client knows %d subjects (want %d) and %d frames; %q never arrived", timeout, len(watcher.subjects), wantSubjects, watcher.frames, missing)
		case <-time.After(100 * time.Millisecond):
		}
	}
}
