package errors

import "github.com/tjbdwanghaibo/roost-core/infra/base/errcode"

// ErrScenePartitioned answers a request the partitioned scene does not take
// (scene.partition; maintainer decisions D5 / D6 = A): Move and MoveTarget —
// a player of a partitioned scene sends a move intent instead (MoveIntent),
// because the authority over its position is the Cell process of the cell it
// stands in, and the Base cannot answer "where you landed" without waiting on
// another process — and GM commands that need a monster's AI, walk or buffs,
// which a partitioned scene's monster does not run.
var ErrScenePartitioned = errcode.Define(100043, "scene_partitioned", "not supported in a partitioned scene")

// ErrSceneNotPartitioned answers MoveIntent / AttackTarget on a process whose
// scene is an ordinary one: there, Move and MoveTarget are the movement.
var ErrSceneNotPartitioned = errcode.Define(100044, "scene_not_partitioned", "this scene is not partitioned")

// ErrPartitionNotEntered answers MoveIntent / AttackTarget from a player that
// has not entered the partitioned scene (yet), or whose cell is not known yet.
var ErrPartitionNotEntered = errcode.Define(100045, "partition_not_entered", "not in the partitioned scene")

// Superseded connections may not move the player, attack, or release the replacement's first frame.
var ErrPartitionStaleSession = errcode.Define(100905, "partition_stale_session", "this connection is not the current partition session")

// Client-operation numbers are independent of TCP sequence numbers and Cell hit IDs.
var ErrAttackRequestInvalid = errcode.Define(100902, "attack_request_invalid", "attack request number must not be negative")
var ErrAttackRequestExpired = errcode.Define(100903, "attack_request_expired", "attack request expired; original outcome is unknown")
var ErrAttackRequestConflict = errcode.Define(100904, "attack_request_conflict", "attack request already used with different parameters")
