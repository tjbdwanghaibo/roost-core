package errors

import "github.com/tjbdwanghaibo/roost-core/infra/base/errcode"

// ErrGuildBusy: the alliance service did not execute the request — no
// instance was ready for it (starting, recovering, preloading: no responders),
// or its guild was being moved. Nothing happened; send the same request again.
//
// It is a RETRYABLE refusal, and telling it apart from a real failure matters:
// the commonest cause is an alliance instance that is restarting, which clears
// itself in seconds. Reporting that as an internal error tells the client
// "something is broken".
var ErrGuildBusy = errcode.Define(100020, "guild_busy", "guild service is busy, try again")
