package tcp

import (
	"context"
	"errors"
	"testing"

	controllerplayer "{{MODULE}}/game/controllers/player"
	"github.com/tjbdwanghaibo/roost-core/infra/network/gateway"
	svcaccount "github.com/tjbdwanghaibo/roost-core/service/account"
	svcmail "github.com/tjbdwanghaibo/roost-core/service/mail"
)

// sessionAccounts 是只认一张会话票据的 account 客户端：票据对得上就返回原服 originID、由 serverID 承载的
// 角色（originID 为 0 表示没有合服，原服就是 serverID）；bindEpoch 与 transfer 是角色的绑定代数与在途的
// 换服。其余方法不会被认证器调用，留给嵌入的 nil 接口。
type sessionAccounts struct {
	svcaccount.Accounts
	playerID  int64
	token     string
	serverID  int32
	originID  int32
	bindEpoch uint64
	transfer  *svcaccount.RoleTransfer
}

func (accounts sessionAccounts) ValidateSession(_ context.Context, playerID int64, token string) (svcaccount.Role, error) {
	if playerID != accounts.playerID || token != accounts.token {
		return svcaccount.Role{}, errors.New("unknown session")
	}
	origin := accounts.originID
	if origin == 0 {
		origin = accounts.serverID
	}
	return svcaccount.Role{
		PlayerID: playerID, ServerID: origin, ServingServerID: accounts.serverID, CreatedAtUnix: 1_700_000_000,
		BindEpoch: accounts.bindEpoch, Transfer: accounts.transfer,
	}, nil
}

// principalSession 把认证器产出的 Principal 装成登录端点拿到的会话。
type principalSession struct{ principal gateway.Principal }

func (session principalSession) Principal() gateway.Principal { return session.principal }
func (principalSession) Reply(context.Context, any) error     { return nil }
func (principalSession) Close(error) error                    { return nil }

// 认证器写、登录端点读：角色绑定的 sid 在两边用的键和格式必须一致，否则每一次登录都按“没有记下
// 绑定”fail-closed（player_elsewhere，owner_sid=0），而两边各自的测试都还是绿的。这里用真实的认证器
// （只把 account 客户端换成替身）产出 Principal，交给登录端点真正使用的 BoundServerID 去读。
func TestTheAuthenticatorsPrincipalCarriesTheSidTheLoginReads(t *testing.T) {
	authenticator := &applicationAuthenticator{}
	authenticator.accounts.Store(&accountsHandle{accounts: sessionAccounts{playerID: 42, token: "ticket", serverID: 1300}})
	principal, err := authenticator.Authenticate(context.Background(), sessionTokenPrefix+"42:ticket", nil)
	if err != nil {
		t.Fatalf("a valid session ticket was refused: %v", err)
	}
	if principal.PlayerID != 42 {
		t.Fatalf("principal names player %d, want 42", principal.PlayerID)
	}
	sid, bound := controllerplayer.BoundServerID(principalSession{principal: principal})
	if !bound || sid != 1300 {
		t.Fatalf("the login endpoint read (%d, %v) from the authenticator's claims %v, want the role's server 1300", sid, bound, principal.Claims)
	}
	// 全服邮件拉取的画像：本服范围 + 角色建立时间，都从认证器写的 claims 读。
	profile, ok := controllerplayer.BroadcastProfile(principalSession{principal: principal}, sid)
	if !ok || profile.RegisteredAtUnix != 1_700_000_000 || len(profile.Scopes) != 1 || profile.Scopes[0] != svcmail.ServerScope(1300) {
		t.Fatalf("the login endpoint built the broadcast profile %+v (%v) from %v, want server 1300 registered at 1700000000", profile, ok, principal.Claims)
	}
}

// 合服之后（原服 1301 并入 1300）：登录端点读到的是承载服 1300，原服记在 OriginServerIDClaim。
func TestAMergedRolesPrincipalCarriesTheServingServer(t *testing.T) {
	authenticator := &applicationAuthenticator{}
	authenticator.accounts.Store(&accountsHandle{accounts: sessionAccounts{playerID: 42, token: "ticket", serverID: 1300, originID: 1301}})
	principal, err := authenticator.Authenticate(context.Background(), sessionTokenPrefix+"42:ticket", nil)
	if err != nil {
		t.Fatalf("a valid session ticket was refused: %v", err)
	}
	sid, bound := controllerplayer.BoundServerID(principalSession{principal: principal})
	if !bound || sid != 1300 {
		t.Fatalf("the login endpoint read (%d, %v), want the serving server 1300", sid, bound)
	}
	if origin := principal.Claims[svcaccount.OriginServerIDClaim]; origin != "1301" {
		t.Fatalf("OriginServerIDClaim = %q, want the origin 1301", origin)
	}
	// 全服邮件：承载服的范围之外，合服前发给原服的也属于这个角色。
	profile, ok := controllerplayer.BroadcastProfile(principalSession{principal: principal}, sid)
	if !ok || len(profile.Scopes) != 2 || profile.Scopes[0] != svcmail.ServerScope(1300) || profile.Scopes[1] != svcmail.ServerScope(1301) {
		t.Fatalf("broadcast profile of a merged role = %+v (%v), want the scopes of 1300 and 1301", profile, ok)
	}
}

// 单个角色换服（account 的 RoleBinding / BeginRoleTransfer）：认证器把绑定代数记在 BindEpochClaim（没换过服是
// "0"），换服在途时把目标 sid 与换服 ID 记在 TransferClaim；原有的三项不变，在途的角色仍按源服承载。认证器
// 只记不拒：握手失败客户端拿不到原因，放不放行由登录端点决定。
func TestTheAuthenticatorsPrincipalCarriesTheBindEpochAndATransferInFlight(t *testing.T) {
	authenticate := func(accounts sessionAccounts) gateway.Principal {
		t.Helper()
		authenticator := &applicationAuthenticator{}
		authenticator.accounts.Store(&accountsHandle{accounts: accounts})
		principal, err := authenticator.Authenticate(context.Background(), sessionTokenPrefix+"42:ticket", nil)
		if err != nil {
			t.Fatalf("a valid session ticket was refused: %v", err)
		}
		return principal
	}

	settled := authenticate(sessionAccounts{playerID: 42, token: "ticket", serverID: 1300})
	if got := settled.Claims[svcaccount.BindEpochClaim]; got != "0" {
		t.Fatalf("BindEpochClaim of a role that never moved = %q, want 0 (claims %v)", got, settled.Claims)
	}
	if value, moving := settled.Claims[svcaccount.TransferClaim]; moving {
		t.Fatalf("a role that is not moving carries TransferClaim %q", value)
	}

	moving := authenticate(sessionAccounts{
		playerID: 42, token: "ticket", serverID: 1300, bindEpoch: 3,
		transfer: &svcaccount.RoleTransfer{ID: "rehome:42:7", From: 1300, To: 1301, Epoch: 3},
	})
	if got := moving.Claims[svcaccount.BindEpochClaim]; got != "3" {
		t.Fatalf("BindEpochClaim = %q, want 3 (claims %v)", got, moving.Claims)
	}
	to, id, ok := svcaccount.ParseTransferClaim(moving.Claims[svcaccount.TransferClaim])
	if !ok || to != 1301 || id != "rehome:42:7" {
		t.Fatalf("TransferClaim %q parses to (%d, %q, %v), want (1301, rehome:42:7, true)", moving.Claims[svcaccount.TransferClaim], to, id, ok)
	}
	// 在途时角色仍由源服承载：登录端点读到的还是 1300，建角时间也还在。
	if sid, bound := controllerplayer.BoundServerID(principalSession{principal: moving}); !bound || sid != 1300 {
		t.Fatalf("the login endpoint read (%d, %v) for a role in transfer, want the source server 1300", sid, bound)
	}
	if moving.Claims[svcaccount.OriginServerIDClaim] != "1300" || moving.Claims[svcaccount.RoleCreatedAtClaim] != "1700000000" {
		t.Fatalf("the existing claims changed: %v", moving.Claims)
	}
}
