// Settle implements Alliance. The recorded answer — success, or the
// rejection the request got (alliance_expired when a deciding Settle decided
// it) — is the reply's Outcome, not this call's error; Seated is the roster
// now.
func (s *Service) Settle(ctx context.Context, target int64, requestID string, playerID int64, decide bool) (ResultReply, error) {
	var answer alliancerule.ReceiptAnswer
	err := requireRequest(requestID, playerID)
	if err == nil {
		err = s.call(ctx, target, alliance.EntityKindAlliance, func(ctx context.Context) (err error) {
			answer, err = syncsender.NewAllianceSettleSender(s.deps.Nest).Sync_AllianceSettle(ctx, target, requestID, playerID, decide, s.retention())
			return err
		})
	}
	return s.resultReply(answer, err)
}

// Result implements Alliance: the receipt on the alliance, or on the
// player's guard (Found, ReserveGuard), by target's kind.
func (s *Service) Result(ctx context.Context, target int64, requestID string) (ResultReply, error) {
	var answer alliancerule.ReceiptAnswer
	err := requireRequest(requestID)
	if err == nil && entity.MatchEntityID(target, alliance_member.EntityKindAllianceMember) {
		err = s.call(ctx, target, alliance_member.EntityKindAllianceMember, func(ctx context.Context) (err error) {
			answer, err = syncsender.NewAllianceGuardSender(s.deps.Nest).Sync_GuardReceipt(ctx, target, requestID)
			return err
		})
	} else if err == nil {
		err = s.call(ctx, target, alliance.EntityKindAlliance, func(ctx context.Context) (err error) {
			answer, err = syncsender.NewAllianceInfoSender(s.deps.Nest).Sync_AllianceReceipt(ctx, target, requestID)
			return err
		})
	}
	return s.resultReply(answer, err)
}

// onAlliance runs a write on allianceID, an alliance that may not exist yet:
// here when this instance owns it or nobody does (then it is created here
// and the write's admission claims it), through the route RPC (remote) when
// another instance owns it — or when another instance claimed it while this
// one was trying. It is how a founding (Establish) and a deadline's Settle
// reach an alliance id that was minted but perhaps never written.
func (s *Service) onAlliance(ctx context.Context, allianceID int64, local func(ctx context.Context, target int64) error, remote func(ctx context.Context, target int64) error) error {
	target, err := AllianceTarget(allianceID)
	if err != nil {
		return fmt.Errorf("%w: alliance %d: %v", ErrRequestInvalid, allianceID, err)
	}
	here, err := s.claimable(ctx, target)
	if err != nil {
		return err
	}
	if here {
		if err := s.deps.Entities.EnsureAlliance(ctx, allianceID); err != nil {
			return err
		}
		err = local(ctx, target)
		if !s.moved(ctx, target, err) {
			return err
		}
	}
	return remote(ctx, target)
}

// errAllianceMissing answers a request naming an alliance id that has no
// ownership record: nobody founded it.
func errAllianceMissing(allianceID int64) error {
	return errcode.Wrap(apperrors.ErrAllianceMissing, nil, "alliance_id", allianceID)
}

// AllianceInfo is Info for an operator command: the alliance by its id,
// through the route RPC, so whichever instance runs the command reaches the
// owner.
func (s *Service) AllianceInfo(ctx context.Context, allianceID int64) (Reply, error) {
	target, err := AllianceTarget(allianceID)
	if err != nil {
		return Reply{}, fmt.Errorf("%w: alliance %d: %v", ErrRequestInvalid, allianceID, err)
	}
	return s.deps.Peers.Info(ctx, target)
}

// GuardInfo is Guard for an operator command, the same way.
func (s *Service) GuardInfo(ctx context.Context, playerID int64) (GuardReply, error) {
	target, err := GuardTarget(playerID)
	if err != nil {
		return GuardReply{}, fmt.Errorf("%w: player %d: %v", ErrRequestInvalid, playerID, err)
	}
	return s.deps.Peers.Guard(ctx, target)
}
