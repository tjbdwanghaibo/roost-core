// Package alliance is the alliance service's RPC: the only way to change an
// alliance or a player's alliance guard. The service owns the Alliance and
// AllianceMember entities (remote=managed, service=alliance, one writer
// each); game processes call it (uses_rpcs: [alliance]), and read alliances
// through Remote mirrors (game/entities/alliance AllianceMirror; the alliance
// plan, docs/maintenance/FEATURE-2026-11-04-alliance-service.md in
// roost-core).
//
// roost add rpc -entity-service scaffolded it; roost servicerpc generates the
// transport (alliance_rpc_gen.go: the routed BusClient, the handlers that run
// the route check first and write the redirect target) and the assembly
// (alliance_rpc_assembly_gen.go) from the interface below. service.go and
// the files beside it are the implementation.
package alliance

import (
	"context"

	"{{MODULE}}/game/alliancerule"
	"github.com/tjbdwanghaibo/roost-core/infra/base/errcode"
)

//go:generate go run github.com/tjbdwanghaibo/roost-core/codegen/cmd/servicerpc -dir .

// ErrRequestInvalid answers a request the handlers cannot decode, or that
// lacks a request id, or whose target is not an entity of the kind the method
// acts on.
var ErrRequestInvalid = errcode.Define(100040, "alliance_request_invalid", "alliance: request is invalid")

// Error maps an error to the code and reason a caller sees.
func Error(err error) (int32, string) { return errcode.ClientError(err) }

// Alliance is what other processes may ask of the alliance service.
//
// Every write takes requestID first: the caller makes one per user action and
// keeps it across retries, and the service answers the same request id with
// the same result, rejections included (the receipt is committed with the
// change). callerID / callerSID come from the caller's authenticated session,
// never from client fields.
//
// Ids: target is a full entity id (AllianceTarget, GuardTarget) — the route
// key; every other id is a unique id: a player id, or an alliance id as View
// answers it (the number the service minted).
//
// Routing (plan §2.3, §2.7): a method marked //roost:rpc route acts on an
// existing entity and goes to the instance that owns target — the generated
// client finds it through the route registration (Redis) or the Remote
// ownership record, and follows one redirect; the generated handler runs the
// route check (CheckRoute) before the method, so an entity nobody created is
// answered "not found" (servicerpc.EntityNotFound, a rejection) and is never
// claimed by a non-create request. Found carries no route: it creates, so any
// instance takes it (the bus queue group), and its request id is anchored on
// the founder's AllianceMember, which is routed by a stable id.
//
// A call answers one of four ways (servicerpc.Classify): success with the
// alliance's new state and version; a business rejection (internal/errors
// alliance_*, or entity not found), final for that request id; not executed
// (no responders, servicerpc.CodeRetryable, or CodeRedirect when even the
// redirect did not reach the owner) — send it again with the same request
// id; or unknown (timeout, internal error) — ask Result, or send it again
// with the same request id, until success or a rejection comes back.
//
//roost:rpc service_type=alliance capability=rpc.alliance
type Alliance interface {
	// Found creates an alliance led by the caller. Any instance may take it;
	// the alliance is created on that instance.
	Found(ctx context.Context, requestID string, callerID int64, callerSID int32, name string, openJoin bool) (reply Reply, err error)
	// Apply asks to join the alliance target; the leader approves or rejects.
	//roost:rpc route
	Apply(ctx context.Context, requestID string, callerID int64, callerSID int32, target int64) (reply Reply, err error)
	// Approve seats an applicant; leader only.
	//roost:rpc route
	Approve(ctx context.Context, requestID string, callerID int64, callerSID int32, target int64, applicantID int64) (reply Reply, err error)
	// Reject drops an application; leader only.
	//roost:rpc route
	Reject(ctx context.Context, requestID string, callerID int64, callerSID int32, target int64, applicantID int64) (reply Reply, err error)
	// Join seats the caller in an open alliance, without approval.
	//roost:rpc route
	Join(ctx context.Context, requestID string, callerID int64, callerSID int32, target int64) (reply Reply, err error)
	// Leave takes the caller out; the leader transfers first.
	//roost:rpc route
	Leave(ctx context.Context, requestID string, callerID int64, callerSID int32, target int64) (reply Reply, err error)
	// Kick removes a member; leader only.
	//roost:rpc route
	Kick(ctx context.Context, requestID string, callerID int64, callerSID int32, target int64, memberID int64) (reply Reply, err error)
	// Transfer hands leadership to another member; leader only.
	//roost:rpc route
	Transfer(ctx context.Context, requestID string, callerID int64, callerSID int32, target int64, newLeaderID int64) (reply Reply, err error)
	// Donate adds to the alliance's funds (the donate saga's step after the
	// game debited the player's coins).
	//roost:rpc route
	Donate(ctx context.Context, requestID string, callerID int64, callerSID int32, target int64, amount int64) (reply Reply, err error)
	// DeclareWar declares war on the alliance enemyID; leader only. Both
	// alliances on one instance: one transaction. Otherwise this side now,
	// with a durable wait for the enemy, and the enemy's side eventually: the
	// service asks the enemy (AcknowledgeWar) until it answers — no effect.
	//roost:rpc route
	DeclareWar(ctx context.Context, requestID string, callerID int64, callerSID int32, target int64, enemyID int64) (reply Reply, err error)
	// Info is the authoritative read of an alliance (GM, checking after a
	// write); players read the mirror.
	//roost:rpc route
	Info(ctx context.Context, target int64) (reply Reply, err error)
	// Guard is the authoritative read of a player's guard (target is the
	// guard: GuardTarget), as it is — a stale-occupied guard is not healed.
	//roost:rpc route
	Guard(ctx context.Context, target int64) (reply GuardReply, err error)
	// Membership answers which alliance the player of the guard target is
	// in, as the roster has it: a held guard is healed from its holder first
	// (a membership the roster no longer has is cleared, a reservation the
	// roster seated is confirmed); the reply's State.AllianceID is the
	// alliance, 0 for none (a reservation still on its way is none yet). The
	// game asks it at login when the player's own copy shows no guild — a
	// membership made while they were offline. A player who never had a guard
	// is answered "entity not found" (servicerpc.EntityNotFound): no alliance.
	//roost:rpc route
	Membership(ctx context.Context, target int64) (reply GuardReply, err error)
	// Result answers what request requestID did on target: an alliance for
	// the writes on it, or the founder's guard (GuardTarget) for Found and
	// ReserveGuard, whose receipts are there. Found=false means it was never
	// decided there and sending it again is safe.
	//roost:rpc route
	Result(ctx context.Context, target int64, requestID string) (reply ResultReply, err error)
	// ClaimReward takes this period's alliance reward for the caller — the
	// first step of the game's reward saga (plan §2.6). target is the
	// caller's guard (GuardTarget(callerID)): only a member claims, once per
	// alliance.reward_period. The reply names the reward the game hands over
	// in the saga's next step.
	//roost:rpc route
	ClaimReward(ctx context.Context, requestID string, callerID int64, callerSID int32, target int64) (reply RewardReply, err error)
	// ReleaseReward undoes the claim claimRequestID made on the guard target:
	// the reward saga's compensation when the game could not hand the reward
	// over (the bag was full). Idempotent: only that claim is released.
	//roost:rpc route
	ReleaseReward(ctx context.Context, target int64, claimRequestID string) (reply GuardReply, err error)

	// The calls below are between alliance service instances (the two-step
	// join and founding of plan §2.3 / §2.5, cross-instance wars of §2.9); a
	// game process has no reason to make them.

	// Establish founds the alliance target under requestID, after the
	// founder's guard was reserved for it (step 2 of a founding whose guard
	// is on another instance). The instance that minted the id creates and
	// claims the alliance itself; Establish is how another instance, retrying
	// the same request, reaches the alliance once it has an owner.
	//roost:rpc route
	Establish(ctx context.Context, requestID string, callerID int64, callerSID int32, target int64, name string, openJoin bool) (reply Reply, err error)
	// ReserveGuard reserves the guard target for allianceID under requestID
	// until deadlineUnix. A request id already decided there replays: the
	// reply's AllianceID is the alliance the request was bound to first.
	//roost:rpc route
	ReserveGuard(ctx context.Context, requestID string, target int64, allianceID int64, deadlineUnix int64) (reply GuardReply, err error)
	// ResolveGuard confirms (joined) or releases the reservation of requestID.
	//roost:rpc route
	ResolveGuard(ctx context.Context, requestID string, target int64, allianceID int64, joined bool) (reply GuardReply, err error)
	// ClearGuard ends the membership that joinRequestID made in allianceID.
	//roost:rpc route
	ClearGuard(ctx context.Context, target int64, allianceID int64, joinRequestID string) (reply GuardReply, err error)
	// AcknowledgeWar records the enemy side of a cross-instance declaration
	// on the alliance target. Idempotent by request id (its receipt): the
	// declaring instance asks again after a lost answer or a restart.
	//roost:rpc route
	AcknowledgeWar(ctx context.Context, requestID string, target int64, declarerID int64) (reply Reply, err error)
	// Settle answers what requestID did on the alliance target for playerID;
	// Seated reports whether the player holds a seat under requestID now,
	// Found whether the request has an answer. decide makes the answer final
	// (a request never decided is recorded as alliance_expired, unless the
	// player holds a seat under it); without it nothing is written. A guard
	// held for (target, requestID) is confirmed, released or cleared by it
	// (healGuard).
	//roost:rpc route
	Settle(ctx context.Context, target int64, requestID string, playerID int64, decide bool) (reply ResultReply, err error)
}

// Reply is an alliance call's answer. A redirect's target travels in the
// generated response envelope (RedirectSid), not here.
type Reply struct {
	// Alliance is the alliance after the write; show the result from it, and
	// read the mirror afterwards with Monotonic(after = Alliance.Version).
	Alliance alliancerule.View `json:"alliance"`
	// Replayed: the request id had been decided before; this is its receipt.
	Replayed bool `json:"replayed,omitempty"`
	// ServedBySID is the alliance service instance that answered.
	ServedBySID int32 `json:"served_by_sid"`
}

// GuardReply is a guard call's answer.
type GuardReply struct {
	State    alliancerule.MemberState `json:"state"`
	Changed  bool                     `json:"changed,omitempty"`
	Replayed bool                     `json:"replayed,omitempty"`
	// AllianceID is the alliance a ReserveGuard request is bound to: the one
	// this call reserved for, or — replayed — the one the first delivery of
	// the request id reserved for (or founded, for Found).
	AllianceID  int64 `json:"alliance_id,omitempty"`
	ServedBySID int32 `json:"served_by_sid"`
}

// RewardReply is ClaimReward's answer: the guard after the claim, the
// alliance it was claimed in and the reward the game hands over (the alliance
// service's alliance.reward_* settings).
type RewardReply struct {
	State      alliancerule.MemberState `json:"state"`
	AllianceID int64                    `json:"alliance_id"`
	ItemID     int64                    `json:"item_id"`
	Count      int32                    `json:"count"`
	Replayed   bool                     `json:"replayed,omitempty"`
	ServedBySID int32                   `json:"served_by_sid"`
}

// ResultReply is a receipt lookup's answer. Seated: Settle only.
type ResultReply struct {
	Found       bool  `json:"found"`
	Outcome     int32 `json:"outcome"`
	Version     int64 `json:"version"`
	Subject     int64 `json:"subject"`
	Seated      bool  `json:"seated,omitempty"`
	ServedBySID int32 `json:"served_by_sid"`
}
