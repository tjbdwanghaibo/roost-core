// Guard implements Alliance.
func (s *Service) Guard(ctx context.Context, target int64) (GuardReply, error) {
	var answer alliancerule.GuardAnswer
	err := s.call(ctx, target, alliance_member.EntityKindAllianceMember, func(ctx context.Context) error {
		if err := s.deps.Entities.EnsureGuard(ctx, entity.GetUniqueIDFromEntityID(target)); err != nil {
			return err
		}
		var err error
		answer.State, err = syncsender.NewAllianceGuardSender(s.deps.Nest).Sync_GuardInfo(ctx, target)
		return err
	})
	return s.guardReply(answer, err)
}

// ReserveGuard implements Alliance (step 1 of a two-step join or founding).
func (s *Service) ReserveGuard(ctx context.Context, requestID string, target int64, allianceID int64, deadlineUnix int64) (GuardReply, error) {
	var answer alliancerule.GuardAnswer
	err := requireRequest(requestID, allianceID, deadlineUnix)
	if err == nil {
		err = s.call(ctx, target, alliance_member.EntityKindAllianceMember, func(ctx context.Context) error {
			shard, err := s.shard(ctx)
			if err != nil {
				return err
			}
			if err := s.deps.Entities.EnsureGuard(ctx, entity.GetUniqueIDFromEntityID(target)); err != nil {
				return err
			}
			answer, err = syncsender.NewAllianceGuardSender(s.deps.Nest).MultiSync_GuardReserve(ctx, target, shard, requestID, allianceID, deadlineUnix, s.cooldown(), s.retention())
			return err
		})
	}
	return s.guardReply(answer, err)
}

// ResolveGuard implements Alliance.
func (s *Service) ResolveGuard(ctx context.Context, requestID string, target int64, allianceID int64, joined bool) (GuardReply, error) {
	var answer alliancerule.GuardAnswer
	err := requireRequest(requestID, allianceID)
	if err == nil {
		err = s.call(ctx, target, alliance_member.EntityKindAllianceMember, func(ctx context.Context) error {
			shard, err := s.shard(ctx)
			if err != nil {
				return err
			}
			if err := s.deps.Entities.EnsureGuard(ctx, entity.GetUniqueIDFromEntityID(target)); err != nil {
				return err
			}
			answer, err = syncsender.NewAllianceGuardSender(s.deps.Nest).MultiSync_GuardResolve(ctx, target, shard, requestID, allianceID, joined)
			return err
		})
	}
	return s.guardReply(answer, err)
}

