package {{GAME_SERVICE_PKG}}

import (
	"context"
	"errors"
	"fmt"
	"log/slog"

	world "{{MODULE}}/game/entities/world"
	lifecycle "{{MODULE}}/game/lifecycle"
	gamerehome "{{MODULE}}/game/rehome"
	"{{MODULE}}/game/settings"
	"{{MODULE}}/game/terrainmap"
	accessplayer "{{MODULE}}/internal/access/player"
	accessplayertcp "{{MODULE}}/internal/access/player/tcp"
	"github.com/tjbdwanghaibo/roost-core/framework/app"
 "github.com/tjbdwanghaibo/roost-core/infra/observe/health"
	coreentity "github.com/tjbdwanghaibo/roost-core/framework/entity"
	fnats "github.com/tjbdwanghaibo/roost-core/infra/network/nats"
	"github.com/tjbdwanghaibo/roost-core/gameplay/cellworld"
	kitdataengine "github.com/tjbdwanghaibo/roost-core/wiring/dataengine"
	"github.com/tjbdwanghaibo/roost-core/wiring/mods"
	kitsaga "github.com/tjbdwanghaibo/roost-core/wiring/saga"
)

// Service is the game server. It owns this process's World, the consumers
// that turn committed effects into work (level-ups into reward mail), the
// matchmaker that turns waiting tickets into matches, the gift saga's step
// consumers, and the lockstep rooms those matches play in.
type Service struct {
 // sceneSync 先由 Nest 绑定，Init 建好 Scene 后再接上目标 Manager。
 sceneSync sceneSyncObserver
	world          *world.World
	levelUpMail    fnats.IJetStreamSubscription
	stopMatchmaker func()
	giftSteps      *kitsaga.Steps
	guildSteps     *kitsaga.Steps
	battles        *battleManager
	scene          *Scene
	stopSpawner    func()
	spawner        *spawner
	partition      *partitionRuntime
	// terrain 是可编辑地形（terrain.go）；没配 scene.terrain.pack 时为 nil。
	terrain        *terrainmap.Map
	// cellHandlers 是分区场景 cellworld.Node 的 handler 名单：引擎启动前由 InstallNestHandlers 注册（partition.go），
	// Init 里建 Node 时接上。不分区的进程也注册，只是永远不会被投递。
	cellHandlers   *cellworld.Handlers
	owners         *PlayerOwners
	stopFlags      func()
	// stopBuildingConfig 撤销建筑配置的热更新检查（building_config.go）。
	stopBuildingConfig func()
	activity       *ActivityRunner
	stopActivity   func()
	stopTimers     func(context.Context) error
	stopHeartbeat  func(context.Context) error
	activityPhase  fnats.IJetStreamSubscription
}

func New() *Service                    { return &Service{cellHandlers: cellworld.NewHandlers()} }
func (*Service) Name() app.ServiceName { return app.ServiceName("{{GAME_SERVICE}}") }

// ConfigSchema declares the keys this service's own code reads (game/settings):
// the App checks them before any Mod starts, together with every Mod's, and
// `--print-config` / `roost project doctor` know about them. Without it the
// activity.* and platform.* sections in this service's config are keys no
// declaration owns (maintainer decision).
func (*Service) ConfigSchema() app.ConfigSchema { return settings.Schema() }

// Init runs after every Mod has started, so the Entity runtime, JetStream,
// Mongo and the mail client are all up. The World — this process's one
// singleton Entity — is created or loaded here, before any request is
// served; then the effect consumer subscribes, so a level-up committed while
// this process was down is delivered as soon as it is back.
func (s *Service) Init(registry *app.Registry) error {
	// The World's timer driver before the World: the driver dates the load
	// and every deadline by the business clock, so it is bound and started
	// before the first load (activity.go, startWorldTimers). It is the
	// framework's driver wired by hand — the demo does not use roost add
	// timer.
	stopTimers, err := startWorldTimers(registry)
	if err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: %w", err)
	}
	s.stopTimers = stopTimers
	// The heartbeat driver before the scene and before any player or monster
	// exists: their components take a host from it as they initialize
	// (heartbeat.go). Movement, the monsters' AI and the scene's population
	// all run on it.
	stopHeartbeat, err := startHeartbeat(registry)
	if err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: %w", err)
	}
	s.stopHeartbeat = stopHeartbeat
	value, err := lifecycle.EnsureWorld(context.Background(), registry)
	if err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: %w", err)
	}
	s.world = value
	// The editable terrain (terrain.go), before anything that could stand on
	// it — and before the map, which is the terrain's on an ordinary scene:
	// the chunks of this process's cell are loaded — edited ones from their
	// records, the rest from the base pack — and published. Without
	// scene.terrain.pack there is none and nothing else changes.
	// The building configs (building_config.go) before the terrain: the
	// terrain's startup reconciliation reads them, and a config table that
	// breaks a cross-row rule must stop the process here.
	stopBuildingConfig, err := installBuildingConfig(registry)
	if err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: %w", err)
	}
	s.stopBuildingConfig = stopBuildingConfig
	terrainMap, err := startTerrain(registry)
	if err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: %w", err)
	}
	s.terrain = terrainMap
	partitioned, err := settings.LoadPartition(registry)
	if err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: %w", err)
	}
	// The map, before anything can put a player on it. A scene is built from
	// configuration on every start (noPersist), so this is a build, not a
	// load.
	world, err := sceneWorld(partitioned, terrainMap)
	if err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: %w", err)
	}
	area, err := lifecycle.EnsureWorldScene(context.Background(), registry, world)
	if err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: %w", err)
	}
	subscription, err := startLevelUpMailer(context.Background(), registry)
	if err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: %w", err)
	}
	s.levelUpMail = subscription
	// The battle manager before the matchmaker: a match that forms opens a
	// lockstep room through it, so it must be published and reachable first.
	battles, err := newBattleManager(registry)
	if err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: %w", err)
	}
	if err := registry.Register(BattleCapability, battles); err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: publish battle manager: %w", err)
	}
	s.battles = battles
	// The scene before anything that can make a player visible: EnterGame
	// joins it, and a join before Start would have no room to join.
	scene, err := s.newScene(registry)
	if err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: %w", err)
	}
	if err := scene.Start(context.Background()); err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: %w", err)
	}
	if err := registry.Register(SceneCapability, scene); err != nil {
		_ = scene.Close(context.Background())
		return fmt.Errorf("{{GAME_SERVICE}}: publish scene: %w", err)
	}
	s.scene = scene
	// Members are entered with the bridge's Space (their steps reach the AOI
	// commit-gated), and the scene's own subject — its time domain — is
	// replicated to every member through the scene view.
	area.SetSpace(scene.MoveSpace())
	if err := scene.ShowScene(area); err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: %w", err)
	}
	// The edited terrain chunks this process writes become replication
	// subjects (terrain_sync.go): the load read their records into the
	// view only, the subjects need the entities. Before any player can join.
	if scene.terrain != nil {
		if err := startTerrainSync(registry, scene, s.terrain); err != nil {
			return fmt.Errorf("{{GAME_SERVICE}}: %w", err)
		}
		// Walks, routes and placements on this map follow the height field
		// (slopes, steps, drops, swimming; P3) — on the ordinary scene here;
		// a partitioned scene's positions are integrated by the cells
		// (gameplay/cellworld), whose ground hook startPartition installs
		// (partitionSurface). Before any player can join, so no walk starts flat.
		installSurface(area.Terrain(), s.terrain)
	}
 // Scene 自己拥有 Manager；Nest Mod 没有这个句柄，健康检查由此登记。
 if checks,ok:=app.Lookup[*health.Registry](registry,mods.ModHealth);ok && checks!=nil {checks.Register("entitysync.scene",scene)}
	// A partitioned scene (scene.partition, partition.go) instead of the
	// spawner: this process is a Cell (its sid owns a cell: it hosts the
	// cell's region and spawns the cell's monsters) and the Base of its own
	// players. Before the player owners are published, so no login can join
	// before it is in place. Without scene.partition.enabled nothing of it
	// exists and the scene is the ordinary one.
	if partitioned.Enabled {
		runtime, err := startPartition(registry, partitioned, area, scene, s.cellHandlers)
		if err != nil {
			return fmt.Errorf("{{GAME_SERVICE}}: %w", err)
		}
		scene.partition.Store(runtime)
		s.partition = runtime
		if err := registry.Register(PartitionCapability, runtime); err != nil {
			return fmt.Errorf("{{GAME_SERVICE}}: publish partitioned scene: %w", err)
		}
	} else {
		// The spawner last among the scene's users: it needs both the entity and
		// the bridge, and it starts producing subjects immediately.
		stopSpawner, spawn, err := startSpawner(context.Background(), registry, area, scene)
		if err != nil {
			return fmt.Errorf("{{GAME_SERVICE}}: %w", err)
		}
		s.stopSpawner, s.spawner = stopSpawner, spawn
	}
	// 本进程为哪些玩家服务（playerowner.go），在问它的消费者之前发布：matchmaker 和赠礼步骤在启动时
	// 各查一次这个能力，查不到就拒绝启动。玩家绑定在哪个 sid 是 account 写进角色的静态事实，同一 sid
	// 只有一个进程由 App 单实例锁保证，所以这里只是一张本地驻留表，不碰 Redis。下面装好卸载与连接之后
	// 才 Start。
	owners, err := NewPlayerOwners(registry)
	if err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: %w", err)
	}
	// 闲置卸载丢副本用的东西，在发布之前装上：丢一个玩家就是先让他离开场景、再移出实体管理器，所以
	// 场景在上面先建好。卸载只是本地内存管理，不交出任何东西；之后在本进程重新装载时，DataEngine 的
	// 冷加载会先等这个实体在途的投影。
	players, err := lifecycle.PlayerFromRegistry(registry)
	if err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: player lifecycle for eviction: %w", err)
	}
	access, ok := app.Lookup[*coreentity.ManagerAccess](registry, mods.ModEntityRuntime)
	if !ok || access == nil || access.Manager() == nil {
		return fmt.Errorf("{{GAME_SERVICE}}: entity runtime is unavailable, so an idle player could never be unloaded")
	}
	// 换服（rehome 模块）用的是同一个东西的另一面：不是丢副本，而是把实体的写权交出去——离开场景、DataEngine
	// 交出实体并保持屏障。DataEngine 不在（不该发生：Nest 的提交器就是它）时不装，换服在“离开”这一步被中止。
	evictor := playerEvictor{scene: scene, players: players, manager: access.Manager()}
	if dataEngine, ok := app.Lookup[*kitdataengine.Mod](registry, mods.ModDataEngine); ok && dataEngine != nil {
		evictor.handOff = dataEngine
	}
	owners.Evict(evictor)
	owners.HandOff(evictor)
	if err := registry.Register(PlayerOwnerCapability, owners); err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: publish player owners: %w", err)
	}
	// 同一张表，以 rehome 模块的 Residency 的名义再发布一次：模块的驱动器、进入前检查与 Binding 看到的迁出表
	// 就是驻留表里的那一张，不会一边说“在本服”一边说“已迁走”。
	if err := registry.Register(gamerehome.ResidencyCapability, gamerehome.Residency(owners)); err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: publish player owners as the rehome residency: %w", err)
	}
	// 同一张表，再以接入边界的可选闸门名发布：从这里起每个玩家请求在到达 handler 之前都先检查，没有
	// 在本进程接入服务（登录时校验 server_id）的玩家，所有端点一起拒绝。
	if err := registry.Register(accessplayer.WriteGateCapability, accessplayer.WriteGate(owners)); err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: publish player write gate: %w", err)
	}
	s.owners = owners
	stop, err := startMatchmaker(context.Background(), registry, battles, scene)
	if err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: %w", err)
	}
	s.stopMatchmaker = stop
	// The gift saga's step consumers (gift_saga.go): the saga Mod has
	// started, so the stream exists and the coordinator is running.
	giftSteps, err := startGiftSaga(context.Background(), registry)
	if err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: %w", err)
	}
	s.giftSteps = giftSteps
	// The guild sagas' step consumers (alliance_saga.go: found, donate, claim
	// reward — the Player steps here, the guild steps through the alliance
	// RPC), and the alliance service's membership notices (alliance_notice.go).
	guildSteps, err := startGuildSagas(context.Background(), registry)
	if err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: %w", err)
	}
	s.guildSteps = guildSteps
	if err := installGuildNotices(registry); err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: %w", err)
	}
	// The kill switches, before anything they gate: a process that comes up
	// during an incident must come up with the store closed if that is how
	// the operator left it (flags.go).
	stopFlags, err := installFeatureFlags(registry)
	if err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: %w", err)
	}
	s.stopFlags = stopFlags
	// What may be hot-patched, registered before anything can be patched.
	if err := installPatchPoints(); err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: %w", err)
	}
	// Chat presence (who gets world-channel pushes) is the chat module's: its
	// controller subscribes to session closes the first time it pushes
	// (game/controllers/chat/chat_push.go), so nothing is wired here.
	// 传输层此时已经起来：卸载要用它判断玩家还有没有连接，停机要用它断开服务中的玩家。没有它就不卸载。
	if runtime, ok := app.Lookup[*accessplayertcp.Runtime](registry, accessplayertcp.Name); ok && runtime != nil {
		owners.Fence(runtime)
	}
	owners.Start(context.Background())
	// The timed server-wide event: the coordinator loop (activity.go); the
	// World's timers are already running (startWorldTimers above). After the
	// scene, because the settlement mails players who are already in the
	// world, and before the GM commands, which can close a window by hand.
	runner, stopActivity, err := startActivity(context.Background(), registry)
	if err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: %w", err)
	}
	s.activity, s.stopActivity = runner, stopActivity
	if err := registry.Register(ActivityCapability, runner); err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: publish activity runner: %w", err)
	}
	phase, err := startActivityPhaseConsumer(context.Background(), registry, runner)
	if err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: %w", err)
	}
	s.activityPhase = phase
	// The operator surface: GM commands on the admin registry the ops Mod
	// serves (gm.go). Registered last, when everything they call is up.
	if err := registerGMCommands(registry, s.spawner, s.activity, s.partition); err != nil {
		return fmt.Errorf("{{GAME_SERVICE}}: %w", err)
	}
	return nil
}

// World is this process's World. It is set in Init and never nil afterwards.
func (s *Service) World() *world.World { return s.world }

func (*Service) Serve(ctx context.Context) error { <-ctx.Done(); return nil }

// Shutdown drains the consumer: in-flight effects finish or are redelivered
// to the next process holding the durable; nothing is lost either way.
//
// ctx is the App's stop context, bounded by shutdown.total_timeout; the scene
// closes under it, so stopping the reload of unloaded
// players and closing the replication manager cannot outlive the deployment's
// grace period. It used to close under context.Background().
//
// 第一件事是断开本进程服务中的全部玩家连接：停机可能
// 是 fail-stop（失锁、DataEngine / Remote fatal，此时 Nest 已被围栏），进程不再处理请求，连接不能
// 留在这里，客户端重连到接替的进程。会话关闭事件照常走到场景、在线状态，此时它们都还开着。
func (s *Service) Shutdown(ctx context.Context) error {
	if s.owners != nil {
		if closed := s.owners.CloseServedSessions(errServiceStopping); closed > 0 {
			slog.Info("{{GAME_SERVICE}}: disconnected the players this process served", "sessions_closed", closed)
		}
	}
	if s.stopMatchmaker != nil {
		s.stopMatchmaker()
		s.stopMatchmaker = nil
	}
	// The heartbeat driver early: no walk advances, no monster decides and
	// the scene asks for no new population while the rest closes. Nest is
	// still up for a beat already delivered.
	if s.stopHeartbeat != nil {
		if err := s.stopHeartbeat(ctx); err != nil {
			slog.Warn("heartbeat driver did not stop in time", "err", err)
		}
		s.stopHeartbeat = nil
	}
	// The gift steps finish what they are running within the stop budget;
	// past it they are stopped and JetStream redelivers what was not acked.
	if s.giftSteps != nil {
		if err := s.giftSteps.Drain(ctx); err != nil {
			slog.Warn("gift saga steps did not drain in time; stopping them", "err", err)
			s.giftSteps.Stop()
		}
		s.giftSteps = nil
	}
	if s.guildSteps != nil {
		if err := s.guildSteps.Drain(ctx); err != nil {
			slog.Warn("guild saga steps did not drain in time; stopping them", "err", err)
			s.guildSteps.Stop()
		}
		s.guildSteps = nil
	}
	// After the matchmaker, so no new battle is opened while rooms close.
	if s.battles != nil {
		s.battles.Close()
		s.battles = nil
	}
	if s.levelUpMail != nil {
		s.levelUpMail.Drain()
		s.levelUpMail = nil
	}
	if s.stopBuildingConfig != nil {
		s.stopBuildingConfig()
		s.stopBuildingConfig = nil
	}
	if s.stopFlags != nil {
		s.stopFlags()
		s.stopFlags = nil
	}
	if s.owners != nil {
		s.owners.Stop()
		s.owners = nil
	}
	// The activity loops before the consumer that feeds them, so nothing is
	// still opening a window while the phase subscription drains.
	if s.stopActivity != nil {
		s.stopActivity()
		s.stopActivity = nil
	}
	// The World's timer driver after the loops and before the consumer its
	// ticks feed: no new phase effect is committed while the subscription
	// drains. The deadlines stay in the World's DAO.
	if s.stopTimers != nil {
		if err := s.stopTimers(ctx); err != nil {
			slog.Warn("world timer driver did not stop in time", "err", err)
		}
		s.stopTimers = nil
	}
	if s.activityPhase != nil {
		s.activityPhase.Drain()
		s.activityPhase = nil
	}
	// The spawner before the scene: it takes its population down, and the
	// room has to still be there to hear about it.
	if s.stopSpawner != nil {
		s.stopSpawner()
		s.stopSpawner = nil
	}
	// The partitioned scene's node before the scene: it feeds the scene's
	// manager (the mirrors), and nothing is taken from or sent to the other
	// cells once it is down. The SceneActors and monsters it holds go with the
	// process: the Bases re-enter their players elsewhere or here again.
	if s.partition != nil {
		s.partition.stop()
		s.partition = nil
	}
	// The scene last among the fan-out paths: closing it stops the
	// replication loop and the transport sink, and anything still preparing
	// a frame finishes first.
	if s.scene != nil {
		if err := s.scene.Close(ctx); err != nil {
			slog.Warn("scene did not close cleanly", "err", err)
		}
		s.scene = nil
	}
	// The terrain last: it is unpublished (an edit transaction still in
	// Nest answers ErrDisabled) and its base pack closed. Nothing of it needs
	// draining: an edit is durable when its transaction commits.
	if s.terrain != nil {
		if err := s.terrain.Close(); err != nil {
			slog.Warn("terrain base pack did not close cleanly", "err", err)
		}
		s.terrain = nil
	}
	return nil
}

// errServiceStopping 是停机时断开玩家连接的原因。
var errServiceStopping = errors.New("{{GAME_SERVICE}}: this process is stopping; reconnect")

var _ app.Service = (*Service)(nil)
var _ app.ModConfigSchema = (*Service)(nil)
