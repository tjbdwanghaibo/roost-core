// 分区场景的转发编辑（terrain_relay.go 与 game/terrainmap/relay.go，可编辑地形 P5，方案 §30；跨格的编辑在转发之前拒绝，
// §30.10）：两个格进程（sid 101 写块
// x 0～3，sid 102 写块 x 4～7）与一个只做 Base 的进程（sid 103），各自有正式的 Map + Nest + 实体与 terrainRelay；进程之间
// 是一张进程内的网（代替 cellworld Node 的扩展消息，可以丢掉某一类消息、每条投两次、录下重放）。地图 8 × 2 块平地。
//
// terrainmap.Active 是进程级的：格执行一份请求时（relayExecMu 下）先装上本进程的 Map。

const relayPlayer = brushPlayer

// relayExecMu 让各进程的执行一次一个（每次先 Install 本进程的 Map：handler 经 terrainmap.Active 找 Map）。
var relayExecMu sync.Mutex

func lockedExec(m *terrainmap.Map) func(context.Context, terrainmap.PartRequest) terrainmap.PartAnswer {
	return func(ctx context.Context, req terrainmap.PartRequest) terrainmap.PartAnswer {
		relayExecMu.Lock()
		defer relayExecMu.Unlock()
		terrainmap.Install(m)
		return m.Exec(ctx, req)
	}
}

// writeRelayPack 是 8 × 2 块的平地（高度同建筑用例的平地，全局水位在地面以下），放得下建筑、改得动。
func writeRelayPack(t *testing.T, dir string) string {
	t.Helper()
	path := filepath.Join(dir, "relay.pack")
	meta := terrain.Meta{BaseRevision: 1, ChunksX: 8, ChunksY: 2, WaterLevel: 40000}
	err := terrain.WritePackFile(path, meta, func(terrain.ChunkKey) (terrain.Chunk, error) {
		c := terrain.NewChunk()
		for i := range c.Heights {
			c.Heights[i], c.Materials[i] = buildingFlat, 3
		}
		return c, nil
	})
	if err != nil {
		t.Fatal(err)
	}
	return path
}

// relayNet 是进程之间的网：投给对方 terrainRelay 的 deliver。drop 为真的消息丢掉（kind 是请求 / 答复）；dup 为真时每条
// 投两次；录下全部消息。
type relayNet struct {
	mu    sync.Mutex
	nodes map[int32]*terrainRelay
	drop  func(from, to int32, kind byte) bool
	dup   bool
	sent  []relayMessage
}

type relayMessage struct {
	from, to int32
	body     []byte
}

func newRelayNet() *relayNet { return &relayNet{nodes: map[int32]*terrainRelay{}} }

func (n *relayNet) sender(from int32) func(int32, []byte) bool {
	return func(to int32, body []byte) bool {
		n.mu.Lock()
		target, dup := n.nodes[to], n.dup
		drop := n.drop != nil && len(body) > 1 && n.drop(from, to, body[1])
		n.sent = append(n.sent, relayMessage{from: from, to: to, body: slices.Clone(body)})
		n.mu.Unlock()
		if target != nil && !drop {
			target.deliver(from, body)
			if dup {
				target.deliver(from, body)
			}
		}
		return true
	}
}

func (n *relayNet) attach(sid int32, r *terrainRelay) {
	n.mu.Lock()
	n.nodes[sid] = r
	n.mu.Unlock()
}

func (n *relayNet) setDrop(drop func(from, to int32, kind byte) bool) {
	n.mu.Lock()
	n.drop = drop
	n.mu.Unlock()
}

// replay 把录下的每条消息按原样再投一遍（迟到的重复）。
func (n *relayNet) replay() {
	n.mu.Lock()
	sent := slices.Clone(n.sent)
	nodes := n.nodes
	n.mu.Unlock()
	for _, msg := range sent {
		n.mu.Lock()
		target := nodes[msg.to]
		n.mu.Unlock()
		if target != nil {
			target.deliver(msg.from, msg.body)
		}
	}
}

// cellLedgers 是格账本（TerrainCellEditor，dbscope=sid）的“库”：每个 sid 一份，同一个玩家在各格的账本是不同库里的文档。
type cellLedgers struct {
	mu   sync.Mutex
	docs map[int32]map[int64]coredata.RawDocument
}

func (l *cellLedgers) persist(t *testing.T, sid int32, p *terrainProcess) {
	t.Helper()
	l.mu.Lock()
	defer l.mu.Unlock()
	if l.docs == nil {
		l.docs = map[int32]map[int64]coredata.RawDocument{}
	}
	docs := map[int64]coredata.RawDocument{}
	p.entities.Range(func(e entity.IThreadSafeEntity) bool {
		if c, ok := e.(*terrain_cell_editor.TerrainCellEditor); ok && c != nil {
			docs[c.ID()] = coredata.RawDocument{
				Key:  coredata.DocumentKey{Database: db.TerrainCellEditorDaoDBName, Resource: db.TerrainCellEditorDaoCollection, ID: c.ID()},
				Data: c.Dao().Marshal(), Schema: db.TerrainCellEditorDaoSchemaVersion, Version: 1,
			}
		}
		return true
	})
	l.docs[sid] = docs
}

func (l *cellLedgers) restore(t *testing.T, sid int32, p *terrainProcess) {
	t.Helper()
	l.mu.Lock()
	defer l.mu.Unlock()
	for id, doc := range l.docs[sid] {
		dao := db.NewTerrainCellEditorDao()
		dao.SetId(id)
		if err := dao.RestorePersisted(doc.Data, doc.Schema, doc.Version); err != nil {
			t.Fatalf("restore cell ledger %d: %v", id, err)
		}
		built, err := entity.BuildEntity(&entity.EntityCreateParam{Kind: terrain_cell_editor.EntityKindTerrainCellEditor, Id: id,
			Dao: map[string]entity.DaoInterface{db.TerrainCellEditorDaoCollection: dao}})
		if err != nil {
			t.Fatalf("rebuild cell ledger %d: %v", id, err)
		}
		p.entities.Add(built)
	}
}

// relayWorld 是一次用例的全部进程共用的东西：网格、包、块与建筑的“库”、格账本的“库”与网。
type relayWorld struct {
	grid    *cellworld.Grid
	pack    string
	store   *memoryChunkStore
	ledgers *cellLedgers
	net     *relayNet
}

func newRelayWorld(t *testing.T) *relayWorld {
	t.Helper()
	return &relayWorld{grid: partitionTerrainGrid(t), pack: writeRelayPack(t, t.TempDir()), store: &memoryChunkStore{}, ledgers: &cellLedgers{}, net: newRelayNet()}
}

// relayProc 是一个分区进程里与跨格编辑有关的部分。
type relayProc struct {
	sid     int32
	world   *relayWorld
	process *terrainProcess
	relay   *terrainRelay
	stopped bool
}

// relayOptions 调整一个进程：policy 改编辑上限（缺省不限频），setup 在 Load 之前（例如换时钟、装 Rules）。
type relayOptions struct {
	policy func(*terrainmap.Policy)
	setup  func(*terrainProcess)
}

// start 照 startTerrain + startPartition 的顺序起一个进程：接建筑、托管格的进程接格账本（EnableCell），Load 之后起
// terrainRelay 接到网上。
func (w *relayWorld) start(t *testing.T, sid int32, opts relayOptions) *relayProc {
	t.Helper()
	grid := w.grid
	region := func(meta terrain.Meta) (terrainmap.Region, error) {
		cell, ok := grid.CellOf(sid)
		if !ok {
			return terrainmap.Region{}, nil
		}
		own, band := grid.Rect(cell), grid.GhostBand()
		return terrainmap.Region{Own: own, Load: spatial.Rect{
			Min: spatial.Point{X: own.Min.X - band, Y: own.Min.Y - band}, Max: spatial.Point{X: own.Max.X + band, Y: own.Max.Y + band}}}, nil
	}
	terrain_cell_editor.RegisterEntity()
	process := startTerrainProcessWith(t, w.pack, region, w.store, func(p *terrainProcess) {
		policy := terrainmap.DefaultPolicy
		policy.EditPointsPerSecond = 0
		if opts.policy != nil {
			opts.policy(&policy)
		}
		p.m.SetPolicy(policy)
		w.ledgers.restore(t, sid, p)
		if _, hosts := grid.CellOf(sid); hosts {
			cells, err := terrain_cell_editor.NewLifecycle(entity.NewManagerAccess(p.entities))
			if err != nil {
				t.Fatal(err)
			}
			p.m.EnableCell(cells)
		}
		if opts.setup != nil {
			opts.setup(p)
		}
	})
	relay, err := newTerrainRelay(relayConfig{
		Self: sid, OwnerOf: partitionOwnerOf(grid, process.m.Meta()), Send: w.net.sender(sid), Exec: lockedExec(process.m),
		ResendEvery: 10 * time.Millisecond, Deadline: 300 * time.Millisecond,
	})
	if err != nil {
		t.Fatal(err)
	}
	w.net.attach(sid, relay)
	p := &relayProc{sid: sid, world: w, process: process, relay: relay}
	t.Cleanup(p.stop)
	return p
}

// stop 是进程停下（跨格编辑端点、Nest、Map），stopAndPersist 再把它的块、建筑、玩家账本与格账本写进“库”。
func (p *relayProc) stop() {
	if p.stopped {
		return
	}
	p.stopped = true
	p.world.net.attach(p.sid, nil)
	p.relay.stop()
	relayExecMu.Lock()
	p.process.stop()
	relayExecMu.Unlock()
}

func (p *relayProc) stopAndPersist(t *testing.T) {
	t.Helper()
	p.stop()
	p.process.persist(p.world.store)
	p.world.ledgers.persist(t, p.sid, p.process)
}

func (p *relayProc) brush(seq uint64, b terrain.Brush) (terrainmap.RelayResult, error) {
	return p.process.m.RelayBrush(context.Background(), relayPlayer, seq, b, p.relay)
}

// version 是本进程写的一块的 DAO 版本（没有实体时 0）。
func (p *relayProc) version(t *testing.T, key terrain.ChunkKey) int64 {
	t.Helper()
	relayExecMu.Lock()
	defer relayExecMu.Unlock()
	return stateOf(t, p.process, key).daoVersion
}

// cellLedger 是玩家在本格的账本（没有实体时零值）。
func (p *relayProc) cellLedger(t *testing.T) terrainledger.SeqWindow {
	t.Helper()
	id, err := terrain_cell_editor.EntityID(relayPlayer)
	if err != nil {
		t.Fatal(err)
	}
	if e, _ := p.process.entities.Get(id).(*terrain_cell_editor.TerrainCellEditor); e != nil {
		return e.LedgerComp().Window()
	}
	return terrainledger.SeqWindow{}
}

var (
	relayLeft  = terrain.ChunkKey{X: 3, Y: 0} // sid 101 写
	relayRight = terrain.ChunkKey{X: 4, Y: 0} // sid 102 写
)

// borderBrush 是跨格的笔刷：中心在块 (3,0) / (4,0) 的边界上，只覆盖这两块（各约半个 16m 的圆）。
func borderBrush(op terrain.BrushOp, material byte) terrain.Brush {
	return terrain.Brush{Op: op, X: 4 * terrain.ChunkSize, Y: terrain.ChunkSize / 2, Radius: 1600, Falloff: terrain.FalloffSmooth, Strength: 20, Material: material}
}

// cellBrush 是只覆盖块 key 的笔刷：中心在块中心，16m 的圆整个在这块里（块边长 64m）。
func cellBrush(key terrain.ChunkKey, op terrain.BrushOp, material byte) terrain.Brush {
	return terrain.Brush{Op: op, X: int64(key.X)*terrain.ChunkSize + terrain.ChunkSize/2, Y: int64(key.Y)*terrain.ChunkSize + terrain.ChunkSize/2,
		Radius: 1600, Falloff: terrain.FalloffSmooth, Strength: 20, Material: material}
}

// 转发（方案 §30）：只做 Base 的进程上的玩家一次笔刷，整个落在格 102 的块里：整份转发给 102、一笔事务；块的结果与“在
// 一张整图上应用一次”的纯计算逐点相同，版本 1，102 的账本记下这个序号、101 什么都没收到，Base 的账本发了这个号。玩家在
// 格进程上时：落在本格的笔刷直接执行、不经网络，落在邻格的整份经网络转发。
func TestTerrainRelayForwardsABrushToTheCellThatWritesIt(t *testing.T) {
	w := newRelayWorld(t)
	a := w.start(t, partitionSidA, relayOptions{})
	b := w.start(t, partitionSidB, relayOptions{})
	c := w.start(t, partitionSidC, relayOptions{})
	raise := cellBrush(relayRight, terrain.BrushRaise, 0)
	if keys := raise.Chunks(c.process.m.Meta()); len(keys) != 1 || keys[0] != relayRight {
		t.Fatalf("the brush covers %v, want only %v", keys, relayRight)
	}
	result, err := c.brush(1, raise)
	if err != nil || result.Err() != nil {
		t.Fatalf("forwarded brush: %+v %v %v", result, err, result.Err())
	}
	if result.Part.SID != partitionSidB || result.Part.Answer.Outcome != terrainmap.OutcomeApplied {
		t.Fatalf("forwarded brush went to %d with %v, want cell %d applied", result.Part.SID, result.Part.Answer.Outcome, partitionSidB)
	}
	if result.Again || result.LastSeq != 1 {
		t.Fatalf("base ledger: again %v last %d", result.Again, result.LastSeq)
	}
	if answer := result.Part.Answer; answer.Points <= 0 || len(answer.Chunks) != 1 || answer.Chunks[0].Version != 1 {
		t.Fatalf("the cell's answer: %+v", answer)
	}
	want := expectBrushes(t, b.process.m, w.pack, raise)
	viewMatches(t, b.process.m, map[terrain.ChunkKey]terrain.Chunk{relayRight: want[relayRight]})
	if b.version(t, relayRight) != 1 || b.cellLedger(t).Last != 1 {
		t.Fatalf("cell %d: version %d ledger %+v", b.sid, b.version(t, relayRight), b.cellLedger(t))
	}
	if a.relay.requestsIn.Load() != 0 || a.cellLedger(t).Last != 0 {
		t.Fatalf("the other cell took part: %d requests, ledger %+v", a.relay.requestsIn.Load(), a.cellLedger(t))
	}
	// 玩家在格 101 上：落在邻格的笔刷整份走网络。
	sentBefore := a.relay.requestsOut.Load()
	result, err = a.brush(2, cellBrush(relayRight, terrain.BrushLower, 0))
	if err != nil || result.Err() != nil || result.Part.SID != partitionSidB {
		t.Fatalf("from a cell into the neighbour: %+v %v %v", result, err, result.Err())
	}
	if sent := a.relay.requestsOut.Load() - sentBefore; sent != 1 {
		t.Fatalf("%d requests went over the net, want the one to the neighbour", sent)
	}
	// 落在本格的笔刷直接执行。
	sentBefore = a.relay.requestsOut.Load()
	result, err = a.brush(3, cellBrush(relayLeft, terrain.BrushRaise, 0))
	if err != nil || result.Err() != nil || result.Part.SID != partitionSidA {
		t.Fatalf("from a cell into itself: %+v %v %v", result, err, result.Err())
	}
	if sent := a.relay.requestsOut.Load() - sentBefore; sent != 0 {
		t.Fatalf("%d requests went over the net for the cell's own ground", sent)
	}
	if a.version(t, relayLeft) != 1 || b.version(t, relayRight) != 2 {
		t.Fatalf("versions %d %d", a.version(t, relayLeft), b.version(t, relayRight))
	}
}

// 跨格笔刷直接拒绝（维护者 2026-11-10：“跨格是指跨两个地图进程吗，如果是的话就直接拒绝”，与建筑占地同一规则）：覆盖的块
// 归两个格时，Base 在预扣配额与发号之前答 ErrBrushCrossCell——两个格都没写（块版本、格账本），配额不扣（时钟冻结：满桶时
// 一份大于每秒点数的笔刷能透支一次，扣过任何一点就过不去），序号不前进（同一个序号接着用在格内的笔刷上，Base 账本答新号
// 而不是 Again，之后 LastSeq 是 1）。玩家在格进程上时同样拒绝，本格那一部分也不执行、什么都不发。
func TestTerrainRelayRefusesABrushAcrossCells(t *testing.T) {
	w := newRelayWorld(t)
	now := time.Unix(1_800_000_000, 0)
	clock := func() time.Time { return now }
	a := w.start(t, partitionSidA, relayOptions{})
	b := w.start(t, partitionSidB, relayOptions{})
	c := w.start(t, partitionSidC, relayOptions{
		policy: func(p *terrainmap.Policy) { p.EditPointsPerSecond = 270 },
		setup:  func(p *terrainProcess) { p.m.SetClock(clock) },
	})
	meta, rate := c.process.m.Meta(), 270
	cross := borderBrush(terrain.BrushRaise, 0)
	if _, err := c.brush(1, cross); !errors.Is(err, terrainmap.ErrBrushCrossCell) {
		t.Fatalf("a brush across two cells: %v, want ErrBrushCrossCell before anything is charged or issued", err)
	}
	if a.version(t, relayLeft) != 0 || b.version(t, relayRight) != 0 || a.cellLedger(t).Last != 0 || b.cellLedger(t).Last != 0 {
		t.Fatalf("the refused brush wrote: versions %d %d, cell ledgers %+v %+v", a.version(t, relayLeft), b.version(t, relayRight), a.cellLedger(t), b.cellLedger(t))
	}
	if got := a.relay.requestsIn.Load() + b.relay.requestsIn.Load() + c.relay.requestsOut.Load(); got != 0 {
		t.Fatalf("the refused brush was forwarded: %d messages", got)
	}
	// 格 101 内部、什么都不改的大笔刷（材质与地面相同）：覆盖的点数超过每秒点数，只有满桶才过得去。
	inside := terrain.Brush{Op: terrain.BrushPaint, X: terrain.ChunkSize + terrain.ChunkSize/2, Y: terrain.ChunkSize / 2, Radius: 1600, Material: 3}
	if total, _ := footprintOf(inside, meta); total <= rate {
		t.Fatalf("the probe covers %d points; it must need a full bucket for the test to mean anything", total)
	}
	result, err := c.brush(1, inside)
	if err != nil || result.Err() != nil || result.Again {
		t.Fatalf("the same sequence on a brush inside one cell: %+v %v %v, want a fresh sequence on a full bucket", result, err, result.Err())
	}
	if last, err := c.process.m.LastSeq(context.Background(), relayPlayer); err != nil || last != 1 {
		t.Fatalf("last sequence %d %v, want 1", last, err)
	}
	// 玩家在格 101 上：同样拒绝，本格那一部分也不执行。
	if _, err := a.brush(1, cross); !errors.Is(err, terrainmap.ErrBrushCrossCell) {
		t.Fatalf("a brush across two cells from a cell: %v", err)
	}
	if a.version(t, relayLeft) != 0 || a.relay.requestsOut.Load() != 0 {
		t.Fatalf("the cell ran its part of a refused brush: version %d, %d requests out", a.version(t, relayLeft), a.relay.requestsOut.Load())
	}
	// 格一侧：转发来的笔刷覆盖了别的格的块（Base 与格对映射的看法不同，§30.8 ⑥）：答 ErrNotOwned，本格那一部分也不执行。
	answer := lockedExec(a.process.m)(context.Background(), terrainmap.PartRequest{Op: terrainmap.PartBrush, PlayerID: relayPlayer, Seq: 9, Brush: cross})
	if answer.Outcome != terrainmap.OutcomeRefused || !errors.Is(answer.Refusal, terrainmap.ErrNotOwned) {
		t.Fatalf("a cell given a brush that also covers its neighbour's ground: %+v, want refused as not owned", answer)
	}
	if a.version(t, relayLeft) != 0 || a.cellLedger(t).Last != 1 {
		t.Fatalf("the cell ran its part: version %d, ledger %+v", a.version(t, relayLeft), a.cellLedger(t))
	}
}

// occupiedRules 是业务另外的占位钩子：on 为真时整个本格都占着（让一个格拒绝它那一份）。
type occupiedRules struct{ on atomic.Bool }

func (r *occupiedRules) AllowEdit(context.Context, int64, terrain.Brush, []terrain.ChunkKey) error { return nil }
func (r *occupiedRules) Occupied(terrain.ChunkKey, int32) bool                                    { return r.on.Load() }

// 格拒绝（占位）：什么都没写（块、账本），Base 的结论是格的原因。用同一个序号重发：Base 的账本答 Again，格这次执行。
// （P5 原来的“跨格笔刷一个格拒绝、另一个格照常提交”的部分成功随跨格笔刷撤回，见 TestTerrainRelayRefusesABrushAcrossCells。）
func TestTerrainRelayRefusalWritesNothingAndRetries(t *testing.T) {
	w := newRelayWorld(t)
	rules := &occupiedRules{}
	rules.on.Store(true)
	w.start(t, partitionSidA, relayOptions{})
	b := w.start(t, partitionSidB, relayOptions{setup: func(p *terrainProcess) { p.m.SetRules(rules) }})
	c := w.start(t, partitionSidC, relayOptions{})
	raise := cellBrush(relayRight, terrain.BrushRaise, 0)
	result, err := c.brush(1, raise)
	if err != nil {
		t.Fatal(err)
	}
	if !errors.Is(result.Err(), terrainmap.ErrOccupied) || result.Part.Answer.Outcome != terrainmap.OutcomeRefused {
		t.Fatalf("the cell refuses: %+v %v, want the cell's reason", result.Part, result.Err())
	}
	if b.version(t, relayRight) != 0 || b.cellLedger(t).Last != 0 {
		t.Fatalf("after a refusal: version %d, ledger %+v", b.version(t, relayRight), b.cellLedger(t))
	}
	rules.on.Store(false)
	result, err = c.brush(1, raise)
	if err != nil || result.Err() != nil {
		t.Fatalf("the same sequence again: %+v %v %v", result, err, result.Err())
	}
	if !result.Again || result.Part.Answer.Outcome != terrainmap.OutcomeApplied {
		t.Fatalf("the same sequence again: again %v outcome %v, want a retry that runs", result.Again, result.Part.Answer.Outcome)
	}
	if b.version(t, relayRight) != 1 {
		t.Fatalf("after the retry: version %d", b.version(t, relayRight))
	}
	want := expectBrushes(t, b.process.m, w.pack, raise)
	viewMatches(t, b.process.m, map[terrain.ChunkKey]terrain.Chunk{relayRight: want[relayRight]})
}

// 结果未知：格的答复全丢时 Base 在期限内反复重发（格只执行一次：执行完的答复按身份缓存），期限到了结论是 Unknown、
// ErrPending——而格其实已经执行了。网好了之后客户端用同一个序号重发：格答 Duplicate，块只改过一次。请求全丢时格没有执行；
// 重发之后执行一次。
func TestTerrainRelayUnknownResultsAreRetriedOnce(t *testing.T) {
	w := newRelayWorld(t)
	w.start(t, partitionSidA, relayOptions{})
	b := w.start(t, partitionSidB, relayOptions{})
	c := w.start(t, partitionSidC, relayOptions{})
	w.net.setDrop(func(from, _ int32, kind byte) bool { return from == partitionSidB && kind == relayKindAnswer })
	result, err := c.brush(1, cellBrush(relayRight, terrain.BrushRaise, 0))
	if err != nil {
		t.Fatal(err)
	}
	if !errors.Is(result.Err(), terrainmap.ErrPending) || result.Part.Answer.Outcome != terrainmap.OutcomeUnknown {
		t.Fatalf("answers lost: %+v %v, want unknown / pending", result.Part, result.Err())
	}
	waitFor(t, "the cell whose answers were lost has executed the brush", func() bool { return b.relay.executed.Load() >= 1 })
	if b.version(t, relayRight) != 1 {
		t.Fatalf("the cell whose answers were lost: version %d, want it executed once", b.version(t, relayRight))
	}
	if c.relay.resends.Load() == 0 || b.relay.cachedReplies.Load()+b.relay.inFlightRepeats.Load() == 0 {
		t.Fatalf("no resend reached the cell: %v / %v", c.relay.stats(), b.relay.stats())
	}
	w.net.setDrop(nil)
	result, err = c.brush(1, cellBrush(relayRight, terrain.BrushRaise, 0))
	if err != nil || result.Err() != nil || !result.Again || !result.Duplicate() {
		t.Fatalf("the same sequence after the loss: %+v %v %v", result, err, result.Err())
	}
	if b.version(t, relayRight) != 1 {
		t.Fatalf("written twice: version %d", b.version(t, relayRight))
	}
	// 请求全丢：格没有执行，期限后 Unknown；重发之后执行一次。
	w.net.setDrop(func(_, to int32, kind byte) bool { return to == partitionSidB && kind == relayKindRequest })
	received := b.relay.requestsIn.Load()
	result, err = c.brush(2, cellBrush(relayRight, terrain.BrushLower, 0))
	if err != nil || !errors.Is(result.Err(), terrainmap.ErrPending) || b.relay.requestsIn.Load() != received || b.version(t, relayRight) != 1 {
		t.Fatalf("requests lost: %+v %v %v, cell version %d", result, err, result.Err(), b.version(t, relayRight))
	}
	w.net.setDrop(nil)
	result, err = c.brush(2, cellBrush(relayRight, terrain.BrushLower, 0))
	if err != nil || result.Err() != nil || result.Part.Answer.Outcome != terrainmap.OutcomeApplied {
		t.Fatalf("the same sequence after the requests were lost: %+v %v %v", result, err, result.Err())
	}
	if b.version(t, relayRight) != 2 {
		t.Fatalf("version %d", b.version(t, relayRight))
	}
}

// 重复与迟到：每条消息都投两次，事后把录下的全部消息再投一遍——格对同一身份至多执行一次（缓存答复或账本 Duplicate），
// 迟到的答复没有人在等、被忽略；块版本与账本都不变。两个格各收三笔。
func TestTerrainRelayDuplicatedAndLateMessagesWriteOnce(t *testing.T) {
	w := newRelayWorld(t)
	a := w.start(t, partitionSidA, relayOptions{})
	b := w.start(t, partitionSidB, relayOptions{})
	c := w.start(t, partitionSidC, relayOptions{})
	w.net.mu.Lock()
	w.net.dup = true
	w.net.mu.Unlock()
	for seq := uint64(1); seq <= 6; seq++ {
		key := relayRight
		if seq > 3 {
			key = relayLeft
		}
		result, err := c.brush(seq, cellBrush(key, terrain.BrushRaise, 0))
		if err != nil || result.Err() != nil {
			t.Fatalf("seq %d: %+v %v %v", seq, result, err, result.Err())
		}
	}
	before := []int64{a.version(t, relayLeft), b.version(t, relayRight)}
	ledgers := []terrainledger.SeqWindow{a.cellLedger(t), b.cellLedger(t)}
	if before[0] != 3 || before[1] != 3 {
		t.Fatalf("versions %v after three brushes on each cell", before)
	}
	w.net.replay()
	waitFor(t, "the replayed requests are answered", func() bool {
		return b.relay.executed.Load()+b.relay.cachedReplies.Load() >= 6 && a.relay.executed.Load()+a.relay.cachedReplies.Load() >= 6
	})
	if after := []int64{a.version(t, relayLeft), b.version(t, relayRight)}; !slices.Equal(after, before) {
		t.Fatalf("a replay wrote again: versions %v, before %v", after, before)
	}
	if got := []terrainledger.SeqWindow{a.cellLedger(t), b.cellLedger(t)}; !slices.Equal(got, ledgers) {
		t.Fatalf("a replay changed the cell ledgers: %v, before %v", got, ledgers)
	}
	waitFor(t, "late answers are ignored", func() bool { return c.relay.strayAnswers.Load() > 0 })
}

// 重启之后的对账：答复丢了的那一笔在格上已执行；格重启（块与格账本从“库”冷加载）后，同一个序号重发答 Duplicate、不写
// 第二次。Base 重启（玩家面向客户端的账本从“库”冷加载）后，同一个序号是 Again、格答 Duplicate，新序号照常执行。
func TestTerrainRelayReconcilesAfterRestarts(t *testing.T) {
	w := newRelayWorld(t)
	a := w.start(t, partitionSidA, relayOptions{})
	b := w.start(t, partitionSidB, relayOptions{})
	c := w.start(t, partitionSidC, relayOptions{})
	w.net.setDrop(func(from, _ int32, kind byte) bool { return from == partitionSidB && kind == relayKindAnswer })
	raise := cellBrush(relayRight, terrain.BrushRaise, 0)
	if result, err := c.brush(1, raise); err != nil || !errors.Is(result.Err(), terrainmap.ErrPending) {
		t.Fatalf("answers lost: %+v %v", result, err)
	}
	w.net.setDrop(nil)
	b.stopAndPersist(t)
	b = w.start(t, partitionSidB, relayOptions{})
	if b.version(t, relayRight) != 1 || b.cellLedger(t).Last != 1 {
		t.Fatalf("the restarted cell: version %d ledger %+v", b.version(t, relayRight), b.cellLedger(t))
	}
	result, err := c.brush(1, raise)
	if err != nil || result.Err() != nil || !result.Duplicate() {
		t.Fatalf("the same sequence after the cell restarted: %+v %v %v", result, err, result.Err())
	}
	if b.version(t, relayRight) != 1 {
		t.Fatalf("written twice across the cell's restart: version %d", b.version(t, relayRight))
	}
	c.stopAndPersist(t)
	c = w.start(t, partitionSidC, relayOptions{})
	result, err = c.brush(1, raise)
	if err != nil || result.Err() != nil || !result.Again || !result.Duplicate() {
		t.Fatalf("the same sequence after the base restarted: %+v %v %v", result, err, result.Err())
	}
	last, err := c.process.m.LastSeq(context.Background(), relayPlayer)
	if err != nil || last != 1 {
		t.Fatalf("last sequence after the base restarted: %d %v", last, err)
	}
	result, err = c.brush(2, cellBrush(relayRight, terrain.BrushLower, 0))
	if err != nil || result.Err() != nil || result.Again {
		t.Fatalf("a new sequence after the restarts: %+v %v %v", result, err, result.Err())
	}
	result, err = c.brush(3, cellBrush(relayLeft, terrain.BrushRaise, 0))
	if err != nil || result.Err() != nil {
		t.Fatalf("a new sequence on the other cell after the restarts: %+v %v %v", result, err, result.Err())
	}
	if a.version(t, relayLeft) != 1 || b.version(t, relayRight) != 2 {
		t.Fatalf("versions %d %d", a.version(t, relayLeft), b.version(t, relayRight))
	}
}

// probeBrush 是格 101 内部（块 (1,0)）一份改材质为 3（与地面相同：不改任何点）的笔刷，覆盖的采样点数落在 (lo, hi]。
func probeBrush(t *testing.T, meta terrain.Meta, lo, hi int) terrain.Brush {
	t.Helper()
	for radius := int64(100); radius <= 1600; radius += 10 {
		b := terrain.Brush{Op: terrain.BrushPaint, X: terrain.ChunkSize + terrain.ChunkSize/2, Y: terrain.ChunkSize / 2, Radius: radius, Material: 3}
		n := 0
		for _, c := range b.Footprint(meta) {
			n += c
		}
		if n > lo && n <= hi {
			return b
		}
	}
	t.Fatalf("no probe brush covers (%d, %d] points", lo, hi)
	return terrain.Brush{}
}

func footprintOf(b terrain.Brush, meta terrain.Meta) (total int, byKey map[terrain.ChunkKey]int) {
	byKey = b.Footprint(meta)
	for _, n := range byKey {
		total += n
	}
	return total, byKey
}

// 配额（D16，Base 扣）：Base 按 Footprint 预扣，按格的结论多退——Applied 计实际改动的点数，Unknown 计 Footprint（可能已
// 生效，不退），至少 MinEditPoints。时钟冻结，用“下一份笔刷能不能过”读余额。
func TestTerrainRelayChargesTheBaseByWhatWasApplied(t *testing.T) {
	w := newRelayWorld(t)
	now := time.Unix(1_800_000_000, 0)
	var clockMu sync.Mutex
	clock := func() time.Time { clockMu.Lock(); defer clockMu.Unlock(); return now }
	advance := func(d time.Duration) { clockMu.Lock(); now = now.Add(d); clockMu.Unlock() }
	w.start(t, partitionSidA, relayOptions{})
	w.start(t, partitionSidB, relayOptions{})
	c := w.start(t, partitionSidC, relayOptions{
		policy: func(p *terrainmap.Policy) { p.EditPointsPerSecond = 270 },
		setup:  func(p *terrainProcess) { p.m.SetClock(clock) },
	})
	meta, rate, minimum := c.process.m.Meta(), 270, terrainmap.DefaultPolicy.MinEditPoints
	// 1. 转发给格 102、什么都不改的笔刷（材质与地面相同）：预扣 Footprint（满桶透支），格答实际 0 点 → 只计 MinEditPoints。
	noop := cellBrush(relayRight, terrain.BrushPaint, 3)
	if total, _ := footprintOf(noop, meta); total <= rate {
		t.Fatalf("the no-op brush covers %d points; it must overdraw a full bucket for the test to mean anything", total)
	}
	if result, err := c.brush(1, noop); err != nil || result.Err() != nil {
		t.Fatalf("no-op brush: %+v %v", result, err)
	}
	left := rate - minimum
	if _, err := c.brush(2, probeBrush(t, meta, left-60, left)); err != nil {
		t.Fatalf("a brush within what should be left (%d points) after the refund: %v", left, err)
	}
	// 2. 真改材质的笔刷，格 102 的答复丢了：计 Footprint，余额 = rate − Footprint（为负）。
	advance(10 * time.Second)
	w.net.setDrop(func(from, _ int32, kind byte) bool { return from == partitionSidB && kind == relayKindAnswer })
	paint := cellBrush(relayRight, terrain.BrushPaint, 5)
	total, _ := footprintOf(paint, meta)
	result, err := c.brush(3, paint)
	if err != nil || !errors.Is(result.Err(), terrainmap.ErrPending) {
		t.Fatalf("paint with lost answers: %+v %v", result, err)
	}
	w.net.setDrop(nil)
	balance := float64(rate - total)
	// 补到余额刚好比 MinEditPoints 少一点：一份最小的笔刷还过不去；Unknown 若被退回，余额会多出它的 Footprint。
	wait := (float64(minimum) - 1 - balance) / float64(rate)
	advance(time.Duration(wait * float64(time.Second)))
	if _, err := c.brush(4, probeBrush(t, meta, 0, minimum)); !errors.Is(err, terrainmap.ErrRateLimited) {
		t.Fatalf("the unknown brush's points came back to the bucket: %v", err)
	}
	advance(time.Second / 10)
	if _, err := c.brush(4, probeBrush(t, meta, 0, minimum)); err != nil {
		t.Fatalf("after the bucket refilled: %v", err)
	}
}

// 分区场景的建筑（方案 §30）：只做 Base 的进程上的玩家把建筑放进一个格（转发给写占地的格，那个格一笔事务：块、建筑、
// 玩家在本格的账本），重发答 Duplicate；改参数、拆除同样转发。占地跨两个格的放置在转发之前拒绝（ErrBuildCrossCell），
// 什么都没写、没发号。笔刷改到格里建筑占着的点：那个格在自己的锁里查占位、拒绝。
func TestTerrainRelayBuildingsStayInOneCell(t *testing.T) {
	w := newRelayWorld(t)
	a := w.start(t, partitionSidA, relayOptions{})
	b := w.start(t, partitionSidB, relayOptions{})
	c := w.start(t, partitionSidC, relayOptions{})
	ctx := context.Background()
	place, err := c.process.m.RelayPlace(ctx, relayPlayer, 1, hut(240, 20), c.relay)
	if err != nil || place.Err() != nil {
		t.Fatalf("place: %+v %v %v", place, err, place.Err())
	}
	if place.Part.SID != partitionSidA || place.Part.Answer.Outcome != terrainmap.OutcomeApplied {
		t.Fatalf("place went to %d with %v, want cell %d applied", place.Part.SID, place.Part.Answer.Outcome, partitionSidA)
	}
	if state := place.Part.Answer.Building; !state.Standing || state.Owner != relayPlayer || state.ConfigID != 1 {
		t.Fatalf("placed building %+v", state)
	}
	if !buildingAt(t, a.process, 240, 20).Standing || buildingAt(t, c.process, 240, 20).ID != 0 {
		t.Fatal("the building is not on the cell that writes its lot, or it is on the base")
	}
	if !a.process.m.Occupied(relayLeft, (240-3*terrain.ChunkSamples)+21*terrain.ChunkSamples) {
		t.Fatal("the cell's walkers do not see the building")
	}
	again, err := c.process.m.RelayPlace(ctx, relayPlayer, 1, hut(240, 20), c.relay)
	if err != nil || again.Err() != nil || !again.Duplicate() || !again.Again {
		t.Fatalf("the same placement again: %+v %v %v", again, err, again.Err())
	}
	params, err := c.process.m.RelayParams(ctx, relayPlayer, 2, 240, 20, []int32{5}, c.relay)
	if err != nil || params.Err() != nil || !slices.Equal(params.Part.Answer.Building.Params, []int32{5}) {
		t.Fatalf("parameters: %+v %v %v", params, err, params.Err())
	}
	if !slices.Equal(buildingAt(t, a.process, 240, 20).Params, []int32{5}) {
		t.Fatalf("the cell's building has parameters %v", buildingAt(t, a.process, 240, 20).Params)
	}
	// 占地跨块 (3,0) / (4,0)，也就跨了两个格：拒绝，什么都没写，没发号。
	cross, err := c.process.m.RelayPlace(ctx, relayPlayer, 3, hut(254, 20), c.relay)
	if !errors.Is(err, terrainmap.ErrBuildCrossCell) || cross.Part.SID != 0 {
		t.Fatalf("a lot across two cells: %+v %v", cross, err)
	}
	if buildingAt(t, a.process, 254, 20).ID != 0 || buildingAt(t, b.process, 254, 20).ID != 0 {
		t.Fatal("the refused placement left a building entity")
	}
	if last, _ := c.process.m.LastSeq(ctx, relayPlayer); last != 2 {
		t.Fatalf("the refused placement issued a sequence: last %d", last)
	}
	removed, err := c.process.m.RelayRemove(ctx, relayPlayer, 3, 240, 20, c.relay)
	if err != nil || removed.Err() != nil || removed.Part.Answer.Building.Standing {
		t.Fatalf("remove: %+v %v %v", removed, err, removed.Err())
	}
	if buildingAt(t, a.process, 240, 20).Standing || a.process.m.Occupied(relayLeft, (240-3*terrain.ChunkSamples)+21*terrain.ChunkSamples) {
		t.Fatal("the building still stands on the cell")
	}
	// 转发的笔刷不能改到建筑占着的点：格在自己的锁里查自己的占位（笔刷整个在块 (3,0) 里，盖住锚点 (250, 30) 的 hut）。
	if _, err := c.process.m.RelayPlace(ctx, relayPlayer, 4, hut(250, 30), c.relay); err != nil {
		t.Fatal(err)
	}
	over := terrain.Brush{Op: terrain.BrushRaise, X: 25100, Y: 3100, Radius: 400, Falloff: terrain.FalloffConstant, Strength: 10}
	if keys := over.Chunks(c.process.m.Meta()); len(keys) != 1 || keys[0] != relayLeft {
		t.Fatalf("the brush over the building covers %v, want only %v", keys, relayLeft)
	}
	brushed, err := c.brush(5, over)
	if err != nil || !errors.Is(brushed.Err(), terrainmap.ErrOccupied) || brushed.Part.Answer.Outcome != terrainmap.OutcomeRefused {
		t.Fatalf("a brush over a building: %+v %v", brushed, err)
	}
}

// Ghost 带里邻格的建筑（方案 §30）：格 101 在它与 102 交界的块 (3,0) 上放了建筑，102 的 Ghost 带经地形副本收到这块的
// 占位，102 的行走判定（Walker）不能走进去；拆了之后又能走。102 重启后（启动时按库里的记录、之后按副本）同样看得见。
func TestTerrainPartitionGhostBandSeesNeighbourBuildings(t *testing.T) {
	pack := writeRelayPack(t, t.TempDir())
	grid := partitionTerrainGrid(t)
	store := &memoryChunkStore{}
	net := newPartitionNet()
	a := startPartitionProc(t, net, grid, partitionSidA, pack, store)
	b := startPartitionProc(t, net, grid, partitionSidB, pack, store)
	index := int32((250 - 3*terrain.ChunkSamples) + 21*terrain.ChunkSamples)
	from, into := spatial.Point{X: 249, Y: 21}, spatial.Point{X: 250, Y: 21}
	walkable := func(p *partitionProc) bool {
		w := p.process.m.Walker()
		_, ok := w.Step(from, into)
		return ok
	}
	if !walkable(b) {
		t.Fatal("before the building the neighbour's walkers cannot step there; the test would prove nothing")
	}
	terrainmap.Install(a.process.m)
	if _, err := a.process.m.Place(context.Background(), relayPlayer, 1, hut(250, 20)); err != nil {
		t.Fatal(err)
	}
	waitFor(t, "the neighbour's ghost band takes the building's lot", func() bool { return b.process.m.Occupied(relayLeft, index) })
	if walkable(b) || walkable(a) {
		t.Fatal("a walker steps into the building")
	}
	if lots := b.process.m.LotsAt(relayLeft); len(lots) != 1 || lots[0] != (terrainsurface.Lot{GX: 250, GY: 20, W: 4, H: 4}) {
		t.Fatalf("the neighbour's lots %v", lots)
	}
	if b.pt.rep.Stats().LotsApplied == 0 {
		t.Fatalf("no lots arrived by replica: %+v", b.pt.rep.Stats())
	}
	// 102 重启：启动时按库里的记录装入，之后由副本跟上拆除。
	a.process.persist(store)
	b.stop()
	b = startPartitionProc(t, net, grid, partitionSidB, pack, store)
	if !b.process.m.Occupied(relayLeft, index) {
		t.Fatal("the restarted neighbour does not see the building")
	}
	terrainmap.Install(a.process.m)
	if _, err := a.process.m.Remove(context.Background(), relayPlayer, 2, 250, 20); err != nil {
		t.Fatal(err)
	}
	waitFor(t, "the neighbour's ghost band takes the removal", func() bool { return !b.process.m.Occupied(relayLeft, index) })
	if !walkable(b) {
		t.Fatal("after the removal the neighbour's walkers still cannot step there")
	}
}

// 线上格式：请求、答复往返不变；版本、kind、截断、尾随字节、越界的值都拒绝。
func TestTerrainRelayWireFormat(t *testing.T) {
	requests := []terrainmap.PartRequest{
		{Op: terrainmap.PartBrush, PlayerID: 7, Seq: 1 << 40, Brush: terrain.Brush{Op: terrain.BrushFlatten, X: -5, Y: 123456789, Radius: 1600, Falloff: terrain.FalloffLinear, Strength: 50, Target: 16383, Material: 255}},
		{Op: terrainmap.PartPlace, PlayerID: 8, Seq: 2, Placement: buildingsite.Placement{ConfigID: 2, Params: []int32{3, -1}, GX: 70, GY: 80, Facing: 3, Level: true}},
		{Op: terrainmap.PartRemove, PlayerID: 9, Seq: 3, GX: 1, GY: 2},
		{Op: terrainmap.PartParams, PlayerID: 9, Seq: 4, GX: 1, GY: 2, Params: []int32{1, 2, 3}},
	}
	for _, req := range requests {
		body, err := encodeRelayRequest(42, 7, req)
		if err != nil {
			t.Fatal(err)
		}
		inc, id, got, err := decodeRelayRequest(body)
		if err != nil || inc != 42 || id != 7 || got.Op != req.Op || got.PlayerID != req.PlayerID || got.Seq != req.Seq || got.Brush != req.Brush ||
			got.GX != req.GX || got.GY != req.GY || !slices.Equal(got.Params, req.Params) ||
			got.Placement.ConfigID != req.Placement.ConfigID || !slices.Equal(got.Placement.Params, req.Placement.Params) ||
			got.Placement.GX != req.Placement.GX || got.Placement.GY != req.Placement.GY || got.Placement.Facing != req.Placement.Facing || got.Placement.Level != req.Placement.Level {
			t.Fatalf("request %+v came back as %+v (%v)", req, got, err)
		}
		if _, _, _, err := decodeRelayRequest(body[:len(body)-1]); err == nil {
			t.Fatalf("a truncated request decoded: %+v", req)
		}
		if _, _, _, err := decodeRelayRequest(append(slices.Clone(body), 0)); err == nil {
			t.Fatalf("a request with trailing bytes decoded: %+v", req)
		}
	}
	answers := []terrainmap.PartAnswer{
		{Outcome: terrainmap.OutcomeApplied, Points: 812, LastSeq: 9, Chunks: []terrainsurface.ChunkVersion{{Key: terrain.ChunkKey{X: 3, Y: 0}, Version: 4}}},
		{Outcome: terrainmap.OutcomeDuplicate, LastSeq: 9, Building: buildingsite.State{ID: 99, Standing: true, Owner: 7, ConfigID: 2, Params: []int32{1}, Facing: 1,
			Lot: terrainsurface.Lot{GX: 70, GY: 80, W: 6, H: 8}, Foundation: -300, Leveled: true, BaseRevision: 2}},
		{Outcome: terrainmap.OutcomeRefused, Refusal: terrainmap.ErrOccupied},
		{Outcome: terrainmap.OutcomeRefused, Refusal: errors.New("a disk on fire")},
		{Outcome: terrainmap.OutcomeUnknown, Refusal: errors.New("wal timeout")},
	}
	for _, answer := range answers {
		body := encodeRelayAnswer(42, 7, answer)
		inc, id, got, err := decodeRelayAnswer(body)
		if err != nil || inc != 42 || id != 7 || got.Outcome != answer.Outcome || got.Points != answer.Points || got.LastSeq != answer.LastSeq ||
			!slices.Equal(got.Chunks, answer.Chunks) || !got.Building.Equal(answer.Building) {
			t.Fatalf("answer %+v came back as %+v (%v)", answer, got, err)
		}
		if answer.Outcome == terrainmap.OutcomeRefused {
			if sentinel := terrainmap.RefusalCode(answer.Refusal); sentinel != 0 && !errors.Is(got.Refusal, terrainmap.ErrOccupied) {
				t.Fatalf("refusal %v came back as %v", answer.Refusal, got.Refusal)
			}
			if terrainmap.RefusalCode(answer.Refusal) == 0 && !errors.Is(got.Refusal, terrainmap.ErrCellFailed) {
				t.Fatalf("an unclassified refusal came back as %v", got.Refusal)
			}
		}
		if _, _, _, err := decodeRelayAnswer(body[:len(body)-1]); err == nil {
			t.Fatalf("a truncated answer decoded: %+v", answer)
		}
	}
	good, _ := encodeRelayRequest(1, 1, requests[2])
	for name, mutate := range map[string]func([]byte){
		"version": func(b []byte) { b[0] = terrainEditWire + 1 },
		"kind":    func(b []byte) { b[1] = 9 },
		"op":      func(b []byte) { b[2+8+1] = 9 },
	} {
		body := slices.Clone(good)
		mutate(body)
		r := &terrainRelay{}
		r.deliver(partitionSidA, body)
		if r.decodeErrors.Load() != 1 {
			t.Fatalf("%s: a bad message was not counted as a decode error", name)
		}
	}
}
