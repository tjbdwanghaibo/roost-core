// 地形同步（可编辑地形方案 §7，P2）：被改过的块（TerrainChunk 实体，sync=true）经场景的同一个 entitysync Manager
// 下发——同一条玩家连接、同一个推送编号、同一个 epoch，客户端按命名空间 "terrain" 分流。
//
// 订阅是地形自己的一个 policy.Interest（独立订阅来源，与场景的 Interest 互不干扰）：
//   - 观察者：每个进了场景的玩家（Join）以 Watch 登记一个主视野（只看不被看），视点跟着玩家的位置走（terrainMoves：
//     玩家移动提交之后 MoveView，移动不到 terrainViewStep 不报，省掉每一步的 AOI 重评）。
//   - subject：地图上每一块（方案 §31.9）。被改过的块（Version ≥ 1）是实体：启动时本进程写的改过的块装成实体登记
//     （loadEdited），之后第一次改的块在提交后登记（terrainmap.Map.SetCommitted）。从没改过的块不建实体，登记一个就绪
//     标记（terrain_chunk.Base：同一 ID / 命名空间 / 编码，全量只有 BaseRevision 与 Version 0；showBases），客户端收到
//     它就知道“这块没改过、用本地原始地形包”，可以确认（C# TerrainChunkSync → TerrainRebuildScheduler.Confirm）。块第一次
//     被改时标记关掉、同一 ID 重新绑定到实体（Manager 的 rebind：订阅不断、改发实体的全量），客户端看到同一个对象从
//     Version 0 跳到改过的版本，中间没有 remove。
//   - 视野 200m（terrainViewRadius）、MaxVisible 64；块的位置取块中心，所以视野圆里约 30 块（π·200² / 64²，离开半径
//     220m 时至多约 37 块），64 是拉远视野或人为放大半径时的上限。每一块都有 subject 之后，视野里的块数不再随改过的块
//     多少变化：进场时每会话约 30～37 个地形全量（标记每个约 20 字节），按快照预算每次 Flush 4 个、约 8～10 次 Flush。
//
// 容量与快照预算（方案 §7“对象上限”“基线限流”，决策 D15）：地形是 Manager 的一个单独计的命名空间
// （entitysync.ManagerConfig.Namespaces，terrainNamespaceLimits）——一个会话最多持有 64 块地形（terrainMaxVisible），
// 地形的全量每会话每次 Flush 至多 4 个（terrainSnapshotsPerFlush）。玩家 / 怪 / 场景 / 建筑不在其中，是场景按主视野
// 名额定的上限（sceneSessionObjects：名额 + 自身 / 场景 / 队友 3 + 留给关系视野的 33）、不限快照，交付与不开地形时逐字节
// 相同：开地形的普通场景是游戏尺度的 128 → 164（方案 §29），分区场景仍是 demo 原尺度的 64 → 100。会话的对象引用表合起来
// 可持有 164 + 64 = 228（普通场景）或 100 + 64 = 164（分区场景）个（sceneTerrainMaxObjects），每帧对象数按前一类的上限切。
// 可编辑地形里只有地形块是这样单独的一类、单独的订阅来源。地形块超过 64（视野上限配错）与玩家 / 怪超过会话上限一样不断开
// （超额降级，D17）：Manager 暂缓放不下的块并通知地形的 Interest，视野收紧到放得下、从最远的块开始退订，有空位时逐步放宽；
// 计 entitysync_over_limit_deferred_total{namespace="terrain"}。
//
// 分区场景（P3，terrain_partition.go）用同一套：玩家的视点不来自本进程的移动，而是格进程发来的 witness 里玩家自己的
// 位置（cellworld 的 Hooks.Witness → moved）；subject 除了本进程写的改过的块（实体），还有玩家附近别的格写的改过的块
// （terrain_chunk.Replica，拥有者推来的只读副本，showReplica / hideReplica）。follow 把视点的变化告诉分区一侧，
// 它据此决定要订阅哪些块的副本。
const (
	// terrainViewRadius 是地形视野的进入半径（世界单位，200m），离开半径多 terrainViewHysteresis（20m）。
	terrainViewRadius     = 20000
	terrainViewHysteresis = 2000
	// terrainMaxVisible 是一个玩家的地形视野最多同时持有的块数（方案 §8.1）。
	terrainMaxVisible = 64
	// terrainSnapshotsPerFlush 是每会话每次 Flush 至多发出的地形全量块数（方案 §8.1 初值 4；只计地形）。
	terrainSnapshotsPerFlush = 4
	// terrainViewStep 是玩家离上次报告的视点多远才移动地形视野（8m）：远小于离开滞回 20m，不会漏掉进出。
	terrainViewStep = 800
)


// sceneTerrainMaxObjects 是开了地形的场景里一个会话的对象引用表上限：场景的上限（玩家 / 怪 / 建筑 / 场景，一类，
// sceneSessionObjects）加地形的上限（单独计）。开地形的普通场景 164 + 64 = 228，分区场景 100 + 64 = 164。客户端若显式设
// 对象表容量（C# EntityViews 的 maxObjects），不得小于它。
func sceneTerrainMaxObjects(view gamescene.View) int {
	return sceneSessionObjects(view.MaxVisible) + terrainMaxVisible
}

// terrainSyncConfig 是地形同步的参数：地图范围（AOI 的边界）与视野。测试用更大的半径制造“视野里的改过的块超过
// MaxVisible”。
type terrainSyncConfig struct {
	bounds     spatial.Rect
	radius     int64
	maxVisible int
}

func defaultTerrainSync(bounds spatial.Rect) *terrainSyncConfig {
	return &terrainSyncConfig{bounds: bounds, radius: terrainViewRadius, maxVisible: terrainMaxVisible}
}

// terrainSync 是地形的订阅组织：一个 Interest（玩家是观察者、改过的块是 subject）加启动 / 提交后的登记。
//
// 锁：mu 保护 shown、bases 与 reported；Interest 与 Manager 的调用只取它们自己的短锁、不等待，可以在 Nest worker 与提交后
// 回调里调用。shown 只增不减：块实体常驻（World 档、不卸载），从没改过的块从不出现在这里。bases 里的标记与 shown 不相交：
// 标记的登记、撤下与转成实体 / 副本都持 mu 完成（Manager / Interest 的短锁在 mu 之内取，它们不回调本类型），所以“这一块
// 现在是标记还是实体”在 mu 下只有一个答案。
type terrainSync struct {
	manager  *entitysync.Manager
	interest *policy.Interest
	bounds   spatial.Rect

	mu       sync.Mutex
	shown    map[int64]struct{}              // 已登记、已放进 Interest 的块实体 ID
	bases    map[int64]*terrain_chunk.Base // 没改过的块的就绪标记（已登记、已放进 Interest）
	reported map[int64]spatial.Point         // 玩家 ID → 上次报告给 Interest 的视点
	closed   atomic.Bool
	// follow 是视点变化的通知（分区场景，terrain_partition.go）：watching 为假表示玩家不再看地形。在报告视点的同一
	// goroutine 上、放开 mu 之后调用，不得阻塞。nil 时不通知。
	follow atomic.Pointer[func(playerID int64, at spatial.Point, watching bool)]
}

// setFollow 登记视点变化的通知（见 follow）。玩家能进来之前调用。
func (s *terrainSync) setFollow(notify func(playerID int64, at spatial.Point, watching bool)) {
	if s != nil {
		s.follow.Store(&notify)
	}
}

func (s *terrainSync) notify(playerID int64, at spatial.Point, watching bool) {
	if notify := s.follow.Load(); notify != nil {
		(*notify)(playerID, at, watching)
	}
}

func newTerrainSync(manager *entitysync.Manager, config terrainSyncConfig) (*terrainSync, error) {
	interest, err := policy.NewInterest(policy.InterestConfig{
		Manager:   manager,
		ApplyMode: policy.ApplySync,
		OnRefusal: logRefusal,
		AOI: policy.AOIConfig{
			Bounds:      config.bounds,
			BlockSize:   terrain.ChunkSize,
			EnterRadius: config.radius,
			LeaveRadius: config.radius + terrainViewHysteresis,
			MaxVisible:  config.maxVisible,
		},
	})
	if err != nil {
		return nil, fmt.Errorf("terrain sync: interest policy: %w", err)
	}
	return &terrainSync{manager: manager, interest: interest, bounds: config.bounds, shown: map[int64]struct{}{}, bases: map[int64]*terrain_chunk.Base{}, reported: map[int64]spatial.Point{}}, nil
}

// clamp 把场景里的位置夹进地形图（场景比地形图大时，图外的玩家从最近的图边看）。
func (s *terrainSync) clamp(at spatial.Point) spatial.Point {
	return spatial.Point{X: min(max(at.X, s.bounds.Min.X), s.bounds.Max.X-1), Y: min(max(at.Y, s.bounds.Min.Y), s.bounds.Max.Y-1)}
}

// watch 让玩家的地形视野从 at 开始（Join：首次与重连都调用；重连按新位置重新登记）。
func (s *terrainSync) watch(playerID int64, at spatial.Point) {
	if s == nil || s.closed.Load() {
		return
	}
	at = s.clamp(at)
	s.mu.Lock()
	s.reported[playerID] = at
	s.mu.Unlock()
	if err := s.interest.Watch(playerID, at, policy.ObserverView{}); err != nil {
		slog.Warn("terrain sync: player not watching the terrain", "player_id", playerID, "err", err)
	}
	s.notify(playerID, at, true)
}

// moved 是玩家移动提交之后的视点更新：离上次报告不到 terrainViewStep 时不报。
func (s *terrainSync) moved(playerID int64, at spatial.Point) {
	if s == nil || s.closed.Load() {
		return
	}
	at = s.clamp(at)
	s.mu.Lock()
	last, watching := s.reported[playerID]
	if !watching || spatial.DistanceSquared(last, at) < terrainViewStep*terrainViewStep {
		s.mu.Unlock()
		return
	}
	s.reported[playerID] = at
	s.mu.Unlock()
	if err := s.interest.MoveView(playerID, at); err != nil && !errors.Is(err, policy.ErrInterestUnknown) {
		slog.Debug("terrain sync: view not moved", "player_id", playerID, "err", err)
	}
	s.notify(playerID, at, true)
}

// unwatch 撤掉玩家的地形视野（Leave）。会话随场景的 Leave 关闭，订阅一起删掉。
func (s *terrainSync) unwatch(playerID int64) {
	if s == nil {
		return
	}
	s.mu.Lock()
	delete(s.reported, playerID)
	s.mu.Unlock()
	if err := s.interest.Unwatch(playerID); err != nil && !errors.Is(err, policy.ErrInterestUnknown) {
		slog.Debug("terrain sync: player not released", "player_id", playerID, "err", err)
	}
	s.notify(playerID, spatial.Point{}, false)
}

// show 把一块改过的块登记为 subject、放在块中心（Map 的提交后通知与 loadEdited 调用）；已登记的什么都不做。
// 不阻塞：Manager.Register 与 Interest.Show 只取短锁。
func (s *terrainSync) show(chunk *terrain_chunk.TerrainChunk) {
	if s == nil || chunk == nil || s.closed.Load() {
		return
	}
	id := chunk.ID()
	s.mu.Lock()
	if _, done := s.shown[id]; done {
		s.mu.Unlock()
		return
	}
	s.shown[id] = struct{}{}
	if base := s.bases[id]; base != nil {
		// 第一次改：标记转成实体（持 mu，见类型说明）。Interest 里同一 ID 已在块中心，不再 Show。
		delete(s.bases, id)
		err := s.promoteLocked(base, chunk.Sync())
		s.mu.Unlock()
		if err != nil {
			s.forget(id)
			slog.Error("terrain sync: an edited chunk did not replace its base marker; players will not receive it until a restart", "chunk", chunk.Key().String(), "err", err)
		}
		return
	}
	s.mu.Unlock()
	if err := s.manager.Register(chunk.Sync()); err != nil && !errors.Is(err, entitysync.ErrSubjectRegistered) {
		s.forget(id)
		slog.Error("terrain sync: an edited chunk was not registered; players will not receive it until a restart", "chunk", chunk.Key().String(), "err", err)
		return
	}
	b := chunk.Key().Bounds()
	centre := spatial.Point{X: (b.Min.X + b.Max.X) / 2, Y: (b.Min.Y + b.Max.Y) / 2}
	if err := s.interest.Show(id, centre); err != nil {
		s.forget(id)
		slog.Error("terrain sync: an edited chunk was not shown; players will not receive it until a restart", "chunk", chunk.Key().String(), "err", err)
	}
}

// showReplica 把别的格写的一块的只读副本登记为 subject、放在块中心（分区场景，terrain_partition.go）。同一 ID 上一次
// hideReplica 的退役还没发完时排在它之后登记（remove 先于 create）；这期间 Interest 的订阅被拒、按它的重试表再说。
// 不阻塞：Manager 与 Interest 的调用只取短锁。
func (s *terrainSync) showReplica(r *terrain_chunk.Replica) error {
	if s.closed.Load() {
		return errors.New("terrain sync: closed")
	}
	s.mu.Lock()
	if base := s.bases[r.ID()]; base != nil {
		// 拥有者第一次说“改过了”：标记转成副本（持 mu，见类型说明），Interest 里同一 ID 已在块中心。
		delete(s.bases, r.ID())
		err := s.promoteLocked(base, r.Sync())
		s.mu.Unlock()
		if err != nil {
			return fmt.Errorf("terrain sync: replica %v replacing its base marker: %w", r.Key(), err)
		}
		return nil
	}
	s.mu.Unlock()
	if _, err := s.manager.RegisterAfterRetirement(r.Sync(), nil); err != nil {
		return fmt.Errorf("terrain sync: register replica %v: %w", r.Key(), err)
	}
	b := r.Key().Bounds()
	if err := s.interest.Show(r.ID(), spatial.Point{X: (b.Min.X + b.Max.X) / 2, Y: (b.Min.Y + b.Max.Y) / 2}); err != nil {
		_ = s.manager.Unregister(r.ID())
		return fmt.Errorf("terrain sync: show replica %v: %w", r.Key(), err)
	}
	return nil
}

// hideReplica 撤下一份副本：先从 AOI 撤（政策释放订阅），再退役 subject（订阅者下一帧收到 remove），最后关闭状态。
func (s *terrainSync) hideReplica(r *terrain_chunk.Replica) {
	_ = s.interest.Hide(r.ID())
	_ = s.manager.Unregister(r.ID())
	r.Close()
}

func (s *terrainSync) forget(id int64) {
	s.mu.Lock()
	delete(s.shown, id)
	s.mu.Unlock()
}

// ---- 没改过的块的就绪标记（方案 §31.9）----

// showBase 给一块没改过的块登记就绪标记（terrain_chunk.Base）并放在块中心。这一块已有实体或标记时什么都不做（答 nil）；
// 同一 ID 已有活着的副本登记时 Manager 拒绝（ErrSubjectRegistered，调用方只在没有副本时调用）。同一 ID 上一次撤下（hideBase / hideReplica）的退役还没发完时排在它之后登记（remove 先于 create）。
// 不阻塞：持 mu 调 Manager 与 Interest 的短锁。
func (s *terrainSync) showBase(key terrain.ChunkKey, baseRevision int64) error {
	if s == nil || s.closed.Load() {
		return nil
	}
	id, err := terrain_chunk.EntityID(key)
	if err != nil {
		return err
	}
	b := key.Bounds()
	centre := spatial.Point{X: (b.Min.X + b.Max.X) / 2, Y: (b.Min.Y + b.Max.Y) / 2}
	s.mu.Lock()
	defer s.mu.Unlock()
	if _, edited := s.shown[id]; edited || s.bases[id] != nil {
		return nil
	}
	base, err := terrain_chunk.NewBase(key, baseRevision)
	if err != nil {
		return err
	}
	if _, err := s.manager.RegisterAfterRetirement(base.Sync(), nil); err != nil {
		base.Close()
		return fmt.Errorf("terrain sync: register base marker %v: %w", key, err)
	}
	if err := s.interest.Show(id, centre); err != nil {
		_ = s.manager.Unregister(id)
		base.Close()
		return fmt.Errorf("terrain sync: show base marker %v: %w", key, err)
	}
	s.bases[id] = base
	return nil
}

// hideBase 撤下一块的就绪标记（分区场景：这块离开了本进程全部玩家的视点范围）：先从 AOI 撤，再退役（订阅者下一帧收到
// remove），最后关闭状态。没有标记时什么都不做。
func (s *terrainSync) hideBase(key terrain.ChunkKey) {
	if s == nil {
		return
	}
	id, err := terrain_chunk.EntityID(key)
	if err != nil {
		return
	}
	s.mu.Lock()
	defer s.mu.Unlock()
	base := s.bases[id]
	if base == nil {
		return
	}
	delete(s.bases, id)
	_ = s.interest.Hide(id)
	_ = s.manager.Unregister(id)
	base.Close()
}

// hasBase 报告这一块现在是不是就绪标记（分区场景的 Held：标记 = 持有原始块）。
func (s *terrainSync) hasBase(key terrain.ChunkKey) bool {
	id, err := terrain_chunk.EntityID(key)
	if err != nil {
		return false
	}
	s.mu.Lock()
	defer s.mu.Unlock()
	return s.bases[id] != nil
}

// promoteLocked 把一块的标记换成实体或副本的状态（持 mu）：先关掉标记，再以新状态 Register——Manager 看到同 ID 的旧状态
// 已关闭，把订阅接到新状态上并强制全量（rebind：旧状态关闭到重新绑定之间不捕获、不发送）。失败时退役这个 ID（订阅者
// 收到 remove、撤销确认），不留一个停在 Version 0 的标记让客户端把改过的块当成没改过。
func (s *terrainSync) promoteLocked(base *terrain_chunk.Base, state *coreentity.SubjectSyncState) error {
	base.Close()
	if err := s.manager.Register(state); err != nil && !errors.Is(err, entitysync.ErrSubjectRegistered) {
		_ = s.interest.Hide(base.ID())
		_ = s.manager.Unregister(base.ID())
		return err
	}
	return nil
}

// showBases 给本进程写的、视图里是原始块（Version 0）的块登记就绪标记（启动阶段，loadEdited 之后、玩家进来之前）。
// 装不进视图的块（原始地形包里这块坏了）不登记：服务端自己也查不了它，客户端不会被告知“没改过”。返回登记的个数。
func (s *terrainSync) showBases(m *terrainmap.Map) (int, error) {
	if s == nil || m == nil {
		return 0, nil
	}
	rev := m.Meta().BaseRevision
	shown := 0
	for _, key := range m.Keys() {
		if version, loaded := m.View().Version(key); !loaded || version != 0 || !m.Owns(key) {
			continue
		}
		if err := s.showBase(key, rev); err != nil {
			return shown, err
		}
		shown++
	}
	return shown, nil
}

// baseCount 是已登记的就绪标记数（测试与诊断）。
func (s *terrainSync) baseCount() int {
	s.mu.Lock()
	defer s.mu.Unlock()
	return len(s.bases)
}

// shownCount 是已登记的改过的块数（测试与诊断）。
func (s *terrainSync) shownCount() int {
	s.mu.Lock()
	defer s.mu.Unlock()
	return len(s.shown)
}

// attach 把地形同步接到 Map 上：之后提交的改块（第一次改的块）在提交后登记为 subject。建筑不经这里：它们是普通实体，
// 进场景主视野（Scene.attachBuildings，building_sync.go）。
func (s *terrainSync) attach(m *terrainmap.Map) {
	if s == nil || m == nil {
		return
	}
	m.SetCommitted(s.show)
}

// loadEdited 把本进程写的、改过的块装成实体并登记为 subject（启动阶段，Map.Load 之后、玩家进来之前）。Map.Load 只把
// 记录读进了视图，没有装成实体；同步要的是实体的 SubjectSyncState，所以这里经 lifecycle 的 GetOrCreate 冷加载
// （每块一次按 _id 的读，8 路并行）。代价按块数线性：内存每块约多一份 DAO（高度 8KB + 材质 4KB + 变化树，与视图里的
// 副本分开），启动多 N 次读；1w 地图一个格全改过（2304 块）约多 30MB、按实测的单块读耗时估几百毫秒（方案 P2 实施结果）。
// 邻格 Ghost 带里的块不装（不能在本进程持有别的格的可写实体，P3 推送）。
func (s *terrainSync) loadEdited(ctx context.Context, m *terrainmap.Map, chunks terrainmap.Chunks) (int, error) {
	if s == nil || m == nil {
		return 0, nil
	}
	keys := m.EditedOwned()
	var (
		next    atomic.Int64
		loaded  atomic.Int64
		errOnce sync.Once
		first   error
		workers sync.WaitGroup
	)
	for range min(8, len(keys)) {
		workers.Go(func() {
			for {
				i := int(next.Add(1) - 1)
				if i >= len(keys) {
					return
				}
				unique, err := terrain_chunk.UniqueID(keys[i])
				if err == nil {
					var chunk *terrain_chunk.TerrainChunk
					if chunk, _, err = chunks.GetOrCreate(ctx, unique); err == nil {
						s.show(chunk)
						loaded.Add(1)
						continue
					}
				}
				errOnce.Do(func() { first = fmt.Errorf("terrain sync: load edited chunk %v: %w", keys[i], err) })
				return
			}
		})
	}
	workers.Wait()
	return int(loaded.Load()), first
}

func (s *terrainSync) close() {
	if s == nil || !s.closed.CompareAndSwap(false, true) {
		return
	}
	s.interest.Close()
}

// terrainMoves 是开了地形同步的场景给玩家与怪的 movement.Space：在场景原来的 Space（actor.InterestMoves）之外，
// 玩家的移动在提交之后报给地形视野（回滚的一步不报）。怪不看地形，不报。
type terrainMoves struct {
	movement.Space
	terrain *terrainSync
}

func (moves terrainMoves) QueueMove(e coreentity.IThreadSafeEntity, at spatial.Point) error {
	if err := moves.Space.QueueMove(e, at); err != nil {
		return err
	}
	if e == nil || coreentity.GetEntityKindFromID(e.ID()) != player.EntityKindPlayer {
		return nil
	}
	playerID := playerOf(e.ID())
	follow := func() { moves.terrain.moved(playerID, at) }
	if !nest.AfterCommit(follow) {
		follow()
	}
	return nil
}

// terrainNamespaceLimits 是开了地形的场景 Manager 的按命名空间配置：只有 "terrain" 单独计上限与快照预算。玩家、怪、
// 场景、建筑都不在其中，同在 Limits.MaxObjects（sceneSessionObjects：普通场景 164、分区场景 100）那一类、不限快照
// （方案 D15、§27.10、§29）。
func terrainNamespaceLimits() map[string]entitysync.NamespaceLimits {
	return map[string]entitysync.NamespaceLimits{
		terrainNamespace: {MaxObjects: terrainMaxVisible, SnapshotBudget: entitysync.SnapshotBudget{PerSessionObjects: terrainSnapshotsPerFlush}},
	}
}

// terrainNamespace 是 TerrainChunk 实体（与别的格写的块的副本）的同步命名空间，客户端按它分流。
const terrainNamespace = terrain_chunk.SyncNamespaceTerrain
