package {{GAME_SERVICE_PKG}}

import (
	"context"
	"path/filepath"
	"testing"
	"time"

	generated "{{MODULE}}/configs/generated"
	db "{{MODULE}}/db"
	"{{MODULE}}/game/handler"
	syncsender "{{MODULE}}/game/handler/syncsender"
	gamescene "{{MODULE}}/game/scene"
	"{{MODULE}}/protocol/pb"
	"github.com/tjbdwanghaibo/roost-core/framework/configdata"
	"github.com/tjbdwanghaibo/roost-core/framework/nest"
	"github.com/tjbdwanghaibo/roost-core/infra/base/fctx"
	"github.com/tjbdwanghaibo/roost-core/infra/base/spatial"
)

// The Bag is the bag module's component, and unlike the demo's own components
// it never calls Player.PublishSyncDirty: a module knows nothing about the
// project's replication. Its changes still reach the client, because the
// game's Nest is built with the scene's commit observer
// (Service.NestSyncObserver): when a transaction is admitted, Nest collects
// the sync marks the generated setters left on every entity it locked
// (Player.TakeEntitySyncChanges) and marks the subject itself.
//
// So this test wires the Nest the way the service does — with the observer —
// and runs bag transactions through the real handlers. It asserts what the
// player and a bystander receive:
//
//   - the owner gets a delta carrying the bag after a grant, with the new count;
//   - taking the last one of an item removes its key from the owner's copy
//     (the module deletes the key at zero; no zero-count entry is left behind);
//   - a refused grant (rolled back) sends nothing;
//   - another player in view never receives the bag: it is in none of the
//     views others get (game/entities/player/sync_packer.go);
//   - a later change made by the demo's own code (experience, which calls
//     Player.PublishSyncDirty) does not send the unchanged bag again.
//
// The scene tests in scene_test.go build a bare Nest without the observer;
// there only an explicit PublishSyncDirty marks a subject, so they are not
// the place to assert this.
func TestBagChangesReplicateToTheOwnerThroughTheCommitObserver(t *testing.T) {
	// The Bag validates items against the item table.
	registry := configdata.NewRegistry()
	if err := generated.RegisterGeneratedConfigData(registry); err != nil {
		t.Fatal(err)
	}
	previousStore, previousConfig := configdata.DefaultStore(), fctx.RuntimeConfig()
	t.Cleanup(func() {
		configdata.SetDefaultStore(previousStore)
		fctx.SetRuntimeConfig(previousConfig)
	})
	if _, err := configdata.NewStore(registry, filepath.Join("..", "..", "..", "configs", "data")).Load(context.Background()); err != nil {
		t.Fatal(err)
	}

	const (
		ownerID  = int64(9501)
		nearbyID = int64(9502)
		potion   = int64(1001)
		sword    = int64(2001) // max_stack 1 in the demo's item table
	)
	owner := newScenePlayer(t, ownerID)
	nearby := newScenePlayer(t, nearbyID)
	counters := newSceneWorld(t)

	// The service's order: Nest binds the observer when it is built, the
	// scene attaches its manager to it afterwards.
	var observer sceneSyncObserver
	handler.RegisterAddItemNestHandlers()
	handler.RegisterBagDiscardNestHandlers()
	handler.RegisterAddExpNestHandlers()
	engine := nest.NewEngine(
		nest.NestOptionWithGetter(sceneGetter{owner.ID(): owner, nearby.ID(): nearby, counters.ID(): counters}),
		nest.NestOptionWithTransactionCommitter(sceneCommitter{}),
		nest.NestOptionWithWorkerPools(nest.WorkerPoolConfig{Workers: 1, QueueCap: 16}, nest.WorkerPoolConfig{}, nest.WorkerPoolConfig{}),
		nest.NestOptionWithEntitySync(&observer),
	)
	if err := engine.Start(); err != nil {
		t.Fatalf("start nest: %v", err)
	}
	t.Cleanup(func() { _ = engine.Shutdown(context.Background()) })

	recorder := newSceneRecorder()
	config := gamescene.DefaultConfig()
	scene, err := newSceneWithObserver(sceneLane{transport: recorder}, recorder, nil, config, config.Normalize().View.MaxVisible, nil, &observer)
	if err != nil {
		t.Fatalf("new scene: %v", err)
	}
	ctx := context.Background()
	if err := scene.Start(ctx); err != nil {
		t.Fatalf("start scene: %v", err)
	}
	t.Cleanup(func() {
		closeCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		_ = scene.Close(closeCtx)
	})
	joinReady(t, scene, ctx, owner, spatial.Point{X: 500, Y: 500})
	joinReady(t, scene, ctx, nearby, spatial.Point{X: 520, Y: 500})
	for range 2 {
		if err := scene.Flush(ctx); err != nil {
			t.Fatalf("flush after joins: %v", err)
		}
	}
	recorder.take(ownerID)
	recorder.take(nearbyID)

	// bagSeen flushes and returns the owner's bag as the owner's client now
	// has it (item id -> count), and whether any update of the owner carried
	// the bag to the owner / to the bystander.
	bagSeen := func() (items map[int64]int64, toOwner, toNearby bool) {
		t.Helper()
		if err := scene.Flush(ctx); err != nil {
			t.Fatalf("flush: %v", err)
		}
		if document, ok := decodeSceneFrames(t, ownerID, recorder.take(ownerID))[owner.ID()]; ok {
			if raw, carried := document["bag"]; carried {
				toOwner = true
				items = bagItemsOf(t, raw)
			}
		}
		if document, ok := decodeSceneFrames(t, nearbyID, recorder.take(nearbyID))[owner.ID()]; ok {
			_, toNearby = document["bag"]
		}
		return items, toOwner, toNearby
	}

	add := syncsender.NewAddItemSender(engine)
	if held, err := add.Sync_AddItem(ctx, owner.ID(), potion, 3); err != nil || held != 3 {
		t.Fatalf("add 3 potions: held=%d err=%v", held, err)
	}
	items, toOwner, toNearby := bagSeen()
	if !toOwner || items[potion] != 3 || len(items) != 1 {
		t.Fatalf("after a grant the owner received bag=%v (carried=%v), want {%d: 3}", items, toOwner, potion)
	}
	if toNearby {
		t.Fatal("a player nearby received the owner's bag")
	}

	// The demo's own writes mark the subject through Player.PublishSyncDirty (AddExp
	// calls it). It takes the same client mask the observer takes, so a bag the
	// observer already sent is not sent to the owner again with the next level-up
	// or step.
	if gained, err := syncsender.NewAddExpSender(engine).MultiSync_AddExp(ctx, owner.ID(), counters.ID(), 250); err != nil || gained == 0 {
		t.Fatalf("add exp: gained=%d err=%v", gained, err)
	}
	if items, toOwner, _ = bagSeen(); toOwner {
		t.Fatalf("gaining experience sent the unchanged bag to the owner again: bag=%v", items)
	}

	// A refused grant is rolled back and replicates nothing.
	if _, err := add.Sync_AddItem(ctx, owner.ID(), sword, 2); err == nil {
		t.Fatal("2 swords fit a stack capped at 1")
	}
	if items, toOwner, toNearby = bagSeen(); toOwner || toNearby {
		t.Fatalf("a refused grant was replicated: bag=%v", items)
	}

	// Discarding the last potions removes the key on the client as well.
	discard := syncsender.NewBagDiscardSender(engine)
	if response, err := discard.Sync_BagDiscard(ctx, owner.ID(), &pb.BagDiscardRequest{ItemID: potion, Count: 3}); err != nil || response.Left != 0 {
		t.Fatalf("discard 3 potions: response=%+v err=%v", response, err)
	}
	items, toOwner, toNearby = bagSeen()
	if !toOwner || len(items) != 0 {
		t.Fatalf("after discarding the last potions the owner received bag=%v (carried=%v), want an empty bag", items, toOwner)
	}
	if toNearby {
		t.Fatal("a player nearby received the owner's bag")
	}
}

// bagItemsOf reads the bag out of a decoded Player sync document: the field
// "bag" is the module's nested BagState as the generated sync patch decodes it.
func bagItemsOf(t *testing.T, raw any) map[int64]int64 {
	t.Helper()
	state, ok := raw.(db.SyncBagState)
	if !ok {
		t.Fatalf("the bag field decoded as %T, want db.SyncBagState", raw)
	}
	return state.Items
}
