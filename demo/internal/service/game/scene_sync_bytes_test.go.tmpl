package game

import (
	"fmt"
	"testing"
	"time"

	"{{MODULE}}/game/clientsync"
	player "{{MODULE}}/game/entities/player"
	syncsender "{{MODULE}}/game/handler/syncsender"
	"{{MODULE}}/protocol/pb"
	"github.com/tjbdwanghaibo/roost-core/framework/sync/frame"
