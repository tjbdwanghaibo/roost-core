package {{GAME_SERVICE_PKG}}

import (
	"context"
	"errors"
	"fmt"
	"testing"
	"time"

	"github.com/tjbdwanghaibo/roost-core/errcode"
	svcglobal "github.com/tjbdwanghaibo/roost-core/kit/service/global"
)

// RR-20260930-24：活动租约丢了要重取，不是每 5s 告警一次直到停机。
//
// 进程停顿（SIGSTOP、GC 长暂停、到 global 的分区）超过租约 TTL 后，
// RenewLease 回 `global: lease has expired`；旧 renewLease 只 Warn，没有
// 重新 AcquireLease 的路径，于是这台 game 永远不在协调器的 expected 集合里，
// 窗口不再等它、它的贡献也不再被结算。这些用例用一张可控时钟的租约表替代
// global 服务，把租约推过期、让别人持有、让续租瞬时失败，分别断言：过期后
// 重取并恢复 owner（LiveGames 又能看见它、新 incarnation 能续）；别人持有时
// 退到 standby 按周期重试，对方放手后拿回；瞬时错误不动租约、不去 acquire。
//
// 错误按 bus 送到的形状给（errcode.Remote 带 code 的错误，不是哨兵本身），
// 因为判别必须对着 code 成立：errcode.IntError.Is 比较的是 code。

// gameLeaseTable 是 global 服务的租约表，只有本测试要的那几行语义：
// 过期不可续、不持有不可续、活着的租约不可被别人 acquire。
type gameLeaseTable struct {
	svcglobal.Routing
	now      time.Time
	ttl      time.Duration
	holder   svcglobal.GameLease
	minted   int
	acquires int
	// renewErr 注入一次瞬时失败（bus 超时之类），与租约状态无关。
	renewErr error
}

func (s *gameLeaseTable) live() bool {
	return s.holder.Incarnation != "" && s.holder.ExpiresAtUnix > s.now.Unix()
}

func (s *gameLeaseTable) Bind(context.Context, int32, string, int32) (svcglobal.RouteBinding, error) {
	return svcglobal.RouteBinding{}, errcode.Remote(svcglobal.CodeConflict, "global: conflict: already bound", "")
}

func (s *gameLeaseTable) AcquireLease(_ context.Context, sid int32) (svcglobal.GameLease, error) {
	s.acquires++
	if s.live() {
		return svcglobal.GameLease{}, errcode.Remote(svcglobal.CodeConflict, fmt.Sprintf("global: conflict: game %d lease is held", sid), "")
	}
	s.minted++
	s.holder = svcglobal.GameLease{
		GameSID: sid, Incarnation: fmt.Sprintf("inc-%d", s.minted), State: svcglobal.LeaseActive,
		ExpiresAtUnix: s.now.Add(s.ttl).Unix(),
	}
	return s.holder, nil
}

func (s *gameLeaseTable) RenewLease(_ context.Context, sid int32, incarnation string, _ map[string]string) (svcglobal.GameLease, error) {
	if s.renewErr != nil {
		return svcglobal.GameLease{}, s.renewErr
	}
	if s.holder.Incarnation != incarnation {
		return svcglobal.GameLease{}, errcode.Remote(svcglobal.CodeLeaseNotHolder, "global: caller does not hold this lease", "")
	}
	if !s.live() {
		return svcglobal.GameLease{}, errcode.Remote(svcglobal.CodeLeaseExpired, fmt.Sprintf("global: lease has expired: game %d lapsed at %d", sid, s.holder.ExpiresAtUnix), "")
	}
	s.holder.ExpiresAtUnix = s.now.Add(s.ttl).Unix()
	return s.holder, nil
}

func (s *gameLeaseTable) LiveGames(context.Context, string, []int32, int) ([]svcglobal.GameLease, error) {
	if !s.live() {
		return nil, nil
	}
	return []svcglobal.GameLease{s.holder}, nil
}

// anotherProcessTakes 模拟另一进程拿到了这台 game 的租约。
func (s *gameLeaseTable) anotherProcessTakes() {
	s.minted++
	s.holder = svcglobal.GameLease{GameSID: 1300, Incarnation: fmt.Sprintf("other-%d", s.minted), State: svcglobal.LeaseActive, ExpiresAtUnix: s.now.Add(s.ttl).Unix()}
}

func leasedRunner(t *testing.T) (*ActivityRunner, *gameLeaseTable) {
	t.Helper()
	table := &gameLeaseTable{now: time.Unix(1_700_000_000, 0), ttl: 30 * time.Second}
	runner := &ActivityRunner{routing: table, gameSID: 1300, candidates: []int32{1300}}
	if err := runner.bindAndLease(context.Background()); err != nil {
		t.Fatal(err)
	}
	// 启动那次 acquire 不算：下面数的是心跳做了几次。
	table.acquires = 0
	return runner, table
}

// 过期后的下一次心跳重取租约：incarnation 换新、续租又能成功、LiveGames 又
// 能看见这台 game——也就是协调器开下一个窗口时会再等它。
func TestALapsedActivityLeaseIsRetakenOnTheNextHeartbeat(t *testing.T) {
	ctx := context.Background()
	runner, table := leasedRunner(t)
	first := runner.incarnation

	table.now = table.now.Add(10 * time.Second)
	runner.renewLease(ctx)
	if runner.incarnation != first || table.minted != 1 {
		t.Fatalf("a live lease was re-acquired: incarnation %q -> %q, minted %d", first, runner.incarnation, table.minted)
	}

	// 停顿超过 TTL：租约在表里过期了，谁都没持有。
	table.now = table.now.Add(table.ttl + time.Second)
	runner.renewLease(ctx)
	if runner.incarnation == first {
		t.Fatalf("the lease lapsed and was never retaken: incarnation still %q, acquires=%d", runner.incarnation, table.acquires)
	}
	if runner.incarnation != table.holder.Incarnation {
		t.Fatalf("runner holds %q but the table says %q", runner.incarnation, table.holder.Incarnation)
	}

	// 恢复 owner 之后 sweep 照常：心跳用新 incarnation 续得上，expected 集合里
	// 又有这台 game。
	table.now = table.now.Add(10 * time.Second)
	runner.renewLease(ctx)
	if want := table.now.Add(table.ttl).Unix(); table.holder.ExpiresAtUnix != want {
		t.Fatalf("the retaken lease was not renewed: expires at %d, want %d", table.holder.ExpiresAtUnix, want)
	}
	expected, err := runner.expectedGameSIDs(ctx)
	if err != nil || len(expected) != 1 || expected[0] != 1300 {
		t.Fatalf("after the retake the coordinator would expect %v (err %v), want [1300]", expected, err)
	}
	if table.acquires != 1 {
		t.Fatalf("acquire was called %d times, want exactly 1 (the retake)", table.acquires)
	}
}

// 别人持有时退到 standby：每个周期试一次 acquire，对方放手后拿回来。
func TestAnActivityLeaseHeldElsewhereIsRetriedUntilItIsFree(t *testing.T) {
	ctx := context.Background()
	runner, table := leasedRunner(t)
	first := runner.incarnation

	table.now = table.now.Add(table.ttl + time.Second)
	table.anotherProcessTakes()
	other := table.holder.Incarnation
	runner.renewLease(ctx)
	runner.renewLease(ctx)
	if table.holder.Incarnation != other {
		t.Fatalf("a live lease held by another process was displaced: %q", table.holder.Incarnation)
	}
	if table.acquires != 2 {
		t.Fatalf("standby tried to acquire %d times over two heartbeats, want 2", table.acquires)
	}

	table.now = table.now.Add(table.ttl + time.Second)
	runner.renewLease(ctx)
	if runner.incarnation == first || runner.incarnation == other || runner.incarnation != table.holder.Incarnation {
		t.Fatalf("the lease was not taken back once it was free: runner %q, table %q", runner.incarnation, table.holder.Incarnation)
	}
}

// 瞬时错误（bus 超时）不是"租约不是我的"：不 acquire、不换 incarnation，
// 下一个周期续租照旧。
func TestATransientRenewErrorDoesNotGiveUpTheActivityLease(t *testing.T) {
	ctx := context.Background()
	runner, table := leasedRunner(t)
	first := runner.incarnation

	table.now = table.now.Add(10 * time.Second)
	table.renewErr = errors.New("bus: request timed out")
	runner.renewLease(ctx)
	if runner.incarnation != first || table.acquires != 0 {
		t.Fatalf("a transient error was treated as a lost lease: incarnation %q -> %q, acquires=%d", first, runner.incarnation, table.acquires)
	}

	table.renewErr = nil
	table.now = table.now.Add(10 * time.Second)
	runner.renewLease(ctx)
	if want := table.now.Add(table.ttl).Unix(); table.holder.ExpiresAtUnix != want || runner.incarnation != first {
		t.Fatalf("the heartbeat after a transient error did not renew: expires at %d (want %d), incarnation %q", table.holder.ExpiresAtUnix, want, runner.incarnation)
	}
}
