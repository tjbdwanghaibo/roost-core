// spawner turns the scene's population decisions into Entities.
//
// The split is the same one the interest system uses: the Refresh system
// decides WHAT should exist (it reads the spawn table and counts what it has
// been told exists), and this file makes it exist — because building an
// Entity needs the lifecycle, the lifecycle needs the entity packages, and
// the entity packages hold the scene runtime. A system that created its own
// Entities would be an import cycle.
//
// WHEN it decides is the scene's own heartbeat (D20 P5): the Scene entity's
// "scene.spawn" beat, 1 Hz, in the scene's lock, asks Refresh what is due and
// hands the answer over after its transaction commits (Scene.SetSpawner →
// offer). There is no ticker here any more — the service goroutine that used
// to wake every second and ask is the pattern the heartbeat replaces.
//
// Building a monster is four steps, in this order, on this goroutine (never
// on the business worker that ran the beat):
//
//  1. mint the id and create the Entity (lifecycle.Create): its components
//     are built, its AI has no strategy yet, so nothing of it runs;
//  2. place its body (template, hp, position) — the one write before anybody
//     can see it, so a subject is never replicated at (0,0);
//  3. register it as a replicated subject and show it to the AOI at that
//     point (Scene.ShowSubject: Register before Show, or the policy would
//     subscribe watchers to a subject the manager does not hold);
//  4. enter it into the scene's movement and start its patrol, in a Nest
//     transaction on the monster and the scene (handlerSpawnMonster): its
//     heartbeats start when that commits, so its first step comes after it
//     is visible, and every step is queued for the AOI commit-gated.
//
// Only then does it count (Refresh.Spawned): the system counts what it has
// been told exists, so a failure at any step — undone in reverse (hide,
// destroy) — simply reappears in the next beat's Due.
//
// One batch at a time: offer drops a batch while the previous one is still
// being built (busy). Without that a beat that came while a batch was being
// built would hand over the same requests again — Refresh has not been told
// about them yet — and the group would be built twice.
//
// Monster ids come from game/runtimeid: the process's sid is encoded into the
// id, so two game processes cannot mint the same one. A local counter was the
// first version of this and it was wrong for exactly the deployment the rest
// of the demo is built for.
type spawner struct {
	area   *sceneentity.Scene
	bridge *Scene
	lives  *lifecycle.MonsterLifecycle
	ids    *runtimeid.Allocator
	nest   corenest.Client

	// business is the clock deaths are dated on (a respawn delay is business
	// time; the scene's beat decides on the same clock).
	business clock.Business

	work chan []gamescene.SpawnRequest
	busy atomic.Bool
	// offered counts the batches the scene handed over, dropped the ones
	// offered while one was being built (tests, diagnostics).
	offered atomic.Int64
	dropped atomic.Int64

	mu       sync.Mutex
	monsters map[int64]*monster.Monster
}

func startSpawner(ctx context.Context, registry *app.Registry, area *sceneentity.Scene, bridge *Scene) (func(), *spawner, error) {
	lives, err := lifecycle.MonsterFromRegistry(registry)
	if err != nil {
		return nil, nil, fmt.Errorf("spawner: %w", err)
	}
	ids, err := runtimeid.New(processSid(registry))
	if err != nil {
		return nil, nil, fmt.Errorf("spawner: %w", err)
	}
	client, ok := app.Lookup[corenest.Client](registry, mods.ModNest)
	if !ok || client == nil {
		return nil, nil, errors.New("spawner: nest client is unavailable")
	}
	instance := newSpawner(area, bridge, lives, ids, client, app.BusinessClock(registry))
	stop := instance.start(ctx)
	return stop, instance, nil
}

func newSpawner(area *sceneentity.Scene, bridge *Scene, lives *lifecycle.MonsterLifecycle, ids *runtimeid.Allocator, client corenest.Client, business clock.Business) *spawner {
	return &spawner{
		area: area, bridge: bridge, lives: lives, ids: ids, nest: client, business: business,
		work:     make(chan []gamescene.SpawnRequest, 1),
		monsters: make(map[int64]*monster.Monster),
	}
}

// start runs the building goroutine and installs offer on the scene. The
// returned stop takes offer down first (no new batch), waits for the batch in
// progress, and then takes the population down with the process: these
// Entities are ephemeral, and leaving them in the manager would leave
// subjects the room still holds.
func (s *spawner) start(ctx context.Context) func() {
	loopCtx, cancel := context.WithCancel(ctx)
	done := make(chan struct{})
	go func() {
		defer close(done)
		for {
			select {
			case <-loopCtx.Done():
				return
			case batch := <-s.work:
				s.build(loopCtx, batch)
				s.busy.Store(false)
			}
		}
	}()
	s.area.SetSpawner(s.offer)
	return func() {
		s.area.SetSpawner(nil)
		cancel()
		<-done
		drainCtx, drainCancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer drainCancel()
		s.drain(drainCtx)
	}
}

// offer is what the scene's population beat calls after its transaction
// commits, on the Nest worker that ran it: it only hands the batch over and
// never blocks. A batch offered while the previous one is still being built
// is dropped — the next beat asks again, and by then Refresh has been told
// what the previous batch built.
func (s *spawner) offer(batch []gamescene.SpawnRequest) {
	if len(batch) == 0 {
		return
	}
	s.offered.Add(1)
	if !s.busy.CompareAndSwap(false, true) {
		s.dropped.Add(1)
		return
	}
	select {
	case s.work <- batch:
	default:
		s.busy.Store(false)
		s.dropped.Add(1)
	}
}

// build creates what one beat decided, in the order the type comment gives.
func (s *spawner) build(ctx context.Context, batch []gamescene.SpawnRequest) {
	refresh := s.area.Refresh()
	if refresh == nil {
		return
	}
	for _, request := range batch {
		if ctx.Err() != nil {
			return
		}
		uniqueID, err := s.ids.Next()
		if err != nil {
			// The sequence is exhausted. Refusing is the point: wrapping
			// would re-mint ids that are still in use.
			slog.Error("spawner: out of runtime ids", "err", err)
			return
		}
		// 1. The Entity.
		value, err := s.lives.Create(ctx, uniqueID)
		if err != nil {
			slog.Warn("spawner: monster not created", "group", request.Group, "err", err)
			continue
		}
		// 2. Its body, before anybody can see it.
		value.BodyComp().Place(request.Template, request.HP, request.At)
		// 3. Replicated and shown at that point.
		if err := s.bridge.ShowSubject(ctx, value.Sync(), value.ID(), request.At); err != nil {
			slog.Warn("spawner: monster not replicated", "monster_id", value.ID(), "err", err)
			_ = s.lives.Destroy(ctx, value, coreentity.DestroyReasonCommon, false)
			continue
		}
		// 4. On the map, acting.
		if err := syncsender.NewSpawnMonsterSender(s.nest).MultiSync_SpawnMonster(ctx, value.ID(), s.area.ID(), request.At.X, request.At.Y); err != nil {
			slog.Warn("spawner: monster not put on the map", "monster_id", value.ID(), "err", err)
			s.bridge.HideSubject(ctx, value.ID())
			_ = s.lives.Destroy(ctx, value, coreentity.DestroyReasonCommon, false)
			continue
		}
		s.mu.Lock()
		s.monsters[value.ID()] = value
		s.mu.Unlock()
		// Only now does it count.
		refresh.Spawned(request.Group, value.ID())
	}
}

// Kill removes a monster and queues its slot. It is what the GM command calls;
// a real game calls it from combat.
func (s *spawner) Kill(ctx context.Context, monsterID int64) error {
	s.mu.Lock()
	value, known := s.monsters[monsterID]
	delete(s.monsters, monsterID)
	s.mu.Unlock()
	if !known {
		return fmt.Errorf("spawner: monster %d is not here", monsterID)
	}
	s.area.Refresh().Died(monsterID, s.business.Now())
	s.bridge.HideSubject(ctx, monsterID)
	return s.lives.Destroy(ctx, value, coreentity.DestroyReasonCommon, false)
}

func (s *spawner) drain(ctx context.Context) {
	s.mu.Lock()
	values := make([]*monster.Monster, 0, len(s.monsters))
	for _, value := range s.monsters {
		values = append(values, value)
	}
	s.monsters = make(map[int64]*monster.Monster)
	s.mu.Unlock()
	for _, value := range values {
		s.bridge.HideSubject(ctx, value.ID())
		if err := s.lives.Destroy(ctx, value, coreentity.DestroyReasonCommon, false); err != nil {
			slog.Debug("spawner: monster not destroyed", "monster_id", value.ID(), "err", err)
		}
	}
}

// processSid is this process's server id, the same number every other part of
// the deployment is keyed by. It is required: a process that does not know
// which server it is cannot mint ids that are unique across servers.
//
// It comes from the registry's own configuration, which is the process's
// config. `fctx.RuntimeConfig()` looks like the same thing and is not — that
// slot holds whatever was set last, and the config-data Mod puts its active
// snapshot there.
func processSid(registry *app.Registry) int32 {
	if registry == nil {
		return 0
	}
	identity, err := settings.Identity(registry)
	if err != nil {
		return 0
	}
	return identity.Sid
}

// Count and IDs are what the GM commands report.
func (s *spawner) Count() int {
	s.mu.Lock()
	defer s.mu.Unlock()
	return len(s.monsters)
}

func (s *spawner) IDs() []int64 {
	s.mu.Lock()
	defer s.mu.Unlock()
	ids := make([]int64, 0, len(s.monsters))
	for id := range s.monsters {
		ids = append(ids, id)
	}
	return ids
}
