// The gift saga's steps. The coordinator (the saga Mod; its partitions live
// on the JetStream saga streams) writes one command per step attempt into its
// partition log; the four consumers below each take one topic — debit, its
// compensation, deliver, its compensation — run the business, and publish the
// result straight back to the command's partition, acknowledging the command
// only after that publish. Debit and its compensation are delivered only to
// the sender's sid (routed steps, see register).
//
// What a step is allowed to be: idempotent per command. The framework offers
// two shapes and this saga uses both, because its steps are two kinds of work:
//
//   - **debit and its compensation are Nest transactions**, so they take the
//     native path: registered with `Steps.Native`, they pass the framework's
//     `saga.NativeStep` into their Nest handler, which calls `step.Complete`
//     INSIDE its transaction (game/handler/gift_debit.go). The Bag change and
//     the operation's receipt (kept in the sender's Player,
//     PlayerDao.SagaReceipts) are one WAL record: the generated dispatch calls
//     step.Begin before the handler, and a redelivery — or a later attempt of
//     the same step after the coordinator timed the first one out, e.g. across
//     a kill -9 and restart — finds the receipt and replays it instead of
//     debiting again; an attempt that finds no receipt after its deadline is
//     skipped. The framework lets at most one attempt of one operation take
//     effect (roost-core SAGA.md, 原生步骤执行契约), so the step needs no
//     idempotency of its own. The result is published once the transaction is
//     durable: the handlers are durability=pipelined, so the Player lock is
//     released before the WAL fsync and Nest's async completion waits for it
//     off the short pool (the framework allowlists them and turns that on).
//   - **deliver is a mail call**, not a Nest transaction, so there is nothing
//     to bind it to. It is registered with `Steps.Mongo`, whose inbox keeps one
//     receipt per operation in the saga database and writes it in the step's
//     Mongo transaction: an attempt that finds an earlier attempt's result
//     replays it, and two attempts running at once conflict on that receipt
//     so one of them rolls back (roost-core SAGA.md, 「Mongo 步骤」). That
//     contract covers what the handler writes through its Mongo transaction,
//     and the mail is not such a write: a rolled-back attempt may already have
//     sent it. So the mail service's own idempotency is still REQUIRED here,
//     not optional: Send deduplicates by RequestID and the RequestID is the
//     command's IdempotencyKey. A Mongo step whose business is a write through
//     the handler's transaction needs no idempotency of its own.
//
// That split is the rule, not a demo convenience: the native path is for a
// step whose business already commits through Nest. Using it for a step that
// calls another service would bind a receipt to a transaction that does not
// contain the side effect.
//
// How a step reports: a coded business refusal (the sender no longer has
// the items, the recipient's mailbox is full) is a completion with
// Success=false and Retryable=false — the coordinator then compensates the
// steps that completed. Anything else (Mongo, bus, Nest unavailable) is
// returned as an error. For the Mongo steps (deliver and its undo) that rolls
// the transaction back and the redelivery retries with backoff. For the native
// steps (debit and refund) the outcome is unknown — the Nest commit may have
// happened — so the command is redelivered and the generated dispatch replays
// the receipt if the commit did happen; the next attempt comes from the
// coordinator after the step timeout.
const (
	// giftSagaSteps names this service's gift step consumers: deliver's
	// durable is `<name>-deliver` (shared by all replicas of the service),
	// debit's and refund's are `<name>-<step>-<sid>` (routed: one per sid,
	// bound by that sid's process only), the Mongo step inbox is
	// `_<name>_step_inbox` in the saga database.
	giftSagaSteps = "{{GAME_SERVICE}}-gift"
	// giftRecipientNotFound is deliver's refusal for a recipient with no
	// Player document. The check reads the Player DAO's collection directly
	// rather than loading a foreign Player into this process; see deliver
	// for which database that is.
	giftRecipientNotFound = "recipient has never entered the game"
)

// startGiftSaga registers the four steps and starts their consumers. It runs
// in Init, after the saga Mod has started (the streams exist); the returned
// Steps is drained in Shutdown. Which streams, prefix and databases the
// consumers use, their inboxes, the admission signal and metrics are the
// framework's (roost-core wiring/saga Steps); what is left here is the business.
func startGiftSaga(ctx context.Context, registry *app.Registry) (*kitsaga.Steps, error) {
	nestClient, ok := app.Lookup[corenest.Client](registry, app.ModName("nest"))
	if !ok || nestClient == nil {
		return nil, fmt.Errorf("gift saga: nest client is unavailable")
	}
	mongoClient, ok := app.Lookup[fmongo.IMongo](registry, mods.ModMongo)
	if !ok || mongoClient == nil {
		return nil, fmt.Errorf("gift saga: capability %q not found", mods.ModMongo)
	}
	// The Player DAO's db= is a logical name; the Data Engine's frozen
	// mapping (dataengine.databases) says which Mongo database it lands in.
	databases, err := kitdataengine.Databases(registry)
	if err != nil {
		return nil, fmt.Errorf("gift saga: %w", err)
	}
	mailer, err := Mail(registry)
	if err != nil {
		return nil, fmt.Errorf("gift saga: %w", err)
	}
	// Not optional: a step that runs without the ownership table is a step
	// that will happily load another process's player, and nothing about the
	// resulting corruption points back here. Refuse to subscribe instead.
	owners, ok := app.Lookup[*PlayerOwners](registry, PlayerOwnerCapability)
	if !ok || owners == nil {
		return nil, fmt.Errorf("gift saga: player ownership (%s) is not published yet; it must be registered before the step consumers subscribe", PlayerOwnerCapability)
	}
	runtime, err := kitsaga.NewSteps(registry, giftSagaSteps)
	if err != nil {
		return nil, fmt.Errorf("gift saga: %w", err)
	}
	players := kitdataengine.DAOCollection(mongoClient, databases, db.NewPlayerDao(), 0)
	steps := giftSteps{nest: nestClient, mailer: mailer, players: players, owners: owners}
	steps.register(runtime)
	if err := runtime.Start(ctx); err != nil {
		return nil, fmt.Errorf("gift saga: %w", err)
	}
	return runtime, nil
}

// register names the four steps. The topic constants come from the generated
// definition, so a durable and its filter can never drift apart.
//
// Debit and its compensation write the sender's Player, which only the
// process of the sender's bound sid may load: they are routed steps
// (saga/gift_item/definition.go, Routed: true — roost add saga -routed debit),
// so the coordinator delivers each command straight to the durable of the sid
// StartGift named (saga.StartRequest.Route = saga.SidRoute(FromSID)) and no
// other process ever sees it (maintainer decision 2026-11-11, plan ③). The
// admission on them is the last guard against a second writer, not the
// router: see admitBound.
//
// Deliver is a mail call, which any process may make: it stays on the shared
// durable, and pinning it to the owner would only make it wait.
func (steps giftSteps) register(runtime *kitsaga.Steps) {
	runtime.Native("debit", giftitem.TopicDebit, steps.debit, kitsaga.WithSidRoute(), kitsaga.WithAdmit(steps.admitBound))
	runtime.Native("debit-undo", giftitem.TopicDebitCompensation, steps.refund, kitsaga.WithSidRoute(), kitsaga.WithAdmit(steps.admitBound))
	runtime.Mongo("deliver", giftitem.TopicDeliver, steps.deliver)
	runtime.Mongo("deliver-undo", giftitem.TopicDeliverCompensation, steps.nothingToUndo)
}

// playerOwnership is the part of PlayerOwners these steps ask about. Declared
// here rather than taking *PlayerOwners so a test could stand it in; the
// route tests (gift_route_test.go) use the real table.
//
// 静态绑定：步骤命令携带发送方绑定的 sid，准入只问“这个 sid 是不是本服”。是本服
// 就接入（建立或刷新驻留记录，算一次使用），发送方离线、没有副本也照常执行——Nest 在 io 池冷加载他，
// 驻留记录让闲置卸载之后收走这份副本；不是本服就不建记录，把步骤退回协调器、指明那个 sid。驻留记录因此
// 只会出现在玩家绑定的那个 sid 上，不会有两个写者。
type playerOwnership interface {
	// AdmitBound: local=false → the player is bound to another sid, nothing
	// was recorded here; local=true, err=nil → served here (counted as use);
	// local=true, err!=nil → bound here but the copy is being unloaded.
	AdmitBound(playerID int64, boundSID int32) (local bool, err error)
}

type giftSteps struct {
	nest   corenest.Client
	mailer svcmail.Mail
	// players is the Player DAO's physical collection (kitdataengine.DAOCollection),
	// where deliver looks the recipient up.
	players fmongo.ICollection
	// owners is who may touch which player. nil means a single-process
	// deployment, where every player is this process's.
	owners playerOwnership
	// moving is the "is this player moving between sids" hook; nil is
	// notMoving. See playerMoving.
	moving playerMoving
}

// playerMoving reports whether a player is moving between sids right now.
// A routed Player step that meets a moving player is bounced back to the
// coordinator (saga.BounceStep("", …)): it is not run here, nothing is
// written, and the coordinator dispatches it again after a backoff without
// spending an attempt, until the move completes and the old sid can name the
// new one, or the saga's deadline compensates it.
//
// TODO（维护者 2026-11-11）：玩家换服还没有对应的现有状态——demo 的玩家绑定是静态的（整服搬机器 sid 不变，
// 离线别名合服要求 saga 全部终态），所以缺省 notMoving 恒返回“不在换服中”。等单个玩家换服的功能存在，
// 把它的状态接到这里（giftSteps.moving / guildSteps.moving）；退回发送端的路径与用例（gift_route_test.go）已经就绪。
type playerMoving func(playerID int64) bool

// notMoving is the default playerMoving: no player is ever moving (TODO above).
func notMoving(int64) bool { return false }

// isMoving asks the hook, nil meaning notMoving.
func (moving playerMoving) isMoving(playerID int64) bool {
	if moving == nil {
		return notMoving(playerID)
	}
	return moving(playerID)
}

// admitBound is debit's and refund's admission: may THIS process run this
// command at all? It is the last guard against a second writer, not the
// router — the coordinator already delivered the command to this sid's
// durable because StartGift named the sender's sid as the saga's route.
//
// Why it still exists: loading a player bound to another sid here is the
// corruption (two entity runtimes, two version counters, one document, and the
// loser is a `fatal projection version conflict` that takes a process down —
// GAME_DEMO_TEMPLATE §9.11). It is wired as saga.StepConsumerConfig.Admit rather
// than as the first line of the handler because a handler-level refusal would
// already have loaded the sender's Player (Nest loads a declared cold target
// before the handler runs); ahead of the Nest call a refusal writes nothing.
//
// Its verdicts (roost-core SAGA.md, 按 sid 确切路由):
//
//   - the payload names no sender sid: saga.RejectStep, logged as an error.
//     Such a payload cannot be routed at all — StartGift refuses to start it
//     (gift.Encode) and the coordinator refuses a routed saga without a route
//     — so this only meets a payload from before from_sid existed, which is
//     not migrated (maintainer decisions 2026-10-05 / 2026-11-11). The
//     coordinator gets a non-retryable failure: a debit fails the gift, a
//     refund goes to manual_required.
//   - the sender is bound to another sid (the command reached a sid that is
//     not his): saga.BounceStep back to the coordinator with his binding as
//     the new route, so the next attempt goes there. With static binding the
//     binding is the payload's FromSID; the route and FromSID are written from
//     the same value at start, so this only happens if the two disagree.
//   - the sender is moving between sids (playerMoving; no such state yet,
//     TODO 维护者 2026-11-11): saga.BounceStep with no new route — back to the
//     coordinator, not run, nothing written, dispatched again at the same
//     route without spending an attempt. Never a nak, which on a routed
//     durable only comes back to this same process.
//   - the sender is bound here but his copy is being unloaded: a plain error,
//     so the delivery is redelivered to this sid's durable after a backoff and
//     finds the unload finished. There is no better process to give it to.
//
// Moving a whole sid to another machine keeps the route: the commands wait on
// that sid's durable for the new process, nothing to bounce.
func (steps giftSteps) admitBound(_ context.Context, command saga.Command) error {
	if steps.owners == nil {
		return nil
	}
	// Decode only. Admission needs the player id and nothing else: resolving
	// the entity id here would make "is the Player kind registered yet" part
	// of a question that is purely about ownership.
	state, err := gift.Decode(command.Payload)
	if err != nil {
		// Not a gift payload. Admit it and let the handler produce the real
		// refusal: admission answers "whose work is this", not "is it valid".
		slog.Warn("gift saga: admitting a step whose payload is not a gift", "command", command.ID, "err", err)
		return nil
	}
	if state.FromSID <= 0 {
		slog.Error("gift saga: rejecting a step whose payload names no sender sid", "player_id", state.From, "command", command.ID, "saga_id", command.SagaID)
		return saga.RejectStep(fmt.Sprintf("gift step %s for player %d names no sender sid; it cannot be routed", command.ID, state.From))
	}
	if steps.moving.isMoving(state.From) {
		return saga.BounceStep("", fmt.Sprintf("player %d is moving between sids", state.From))
	}
	local, err := steps.owners.AdmitBound(state.From, state.FromSID)
	if !local {
		return saga.BounceStep(saga.SidRoute(state.FromSID), fmt.Sprintf("player %d is bound to sid %d", state.From, state.FromSID))
	}
	if err != nil {
		return fmt.Errorf("gift saga: player %d: %w", state.From, err)
	}
	return nil
}

// debit takes the items out of the sender's Bag. The sender may have spent
// them since SendGift checked: that is the coded refusal bag_short, and a
// failed first step has nothing to compensate.
//
// A payload that is not a gift has no transaction to carry a refusal: the
// error makes this delivery fail and retry, and the saga's deadline is what
// ends it. A payload this broken is a bug, not a business outcome.
//
// The receipt is written inside the transaction (step.Complete), and the
// consumer publishes the result once the transaction is durable. The sender
// may be offline and cold
// (restart, idle hand-back): Nest sees the declared target is not loaded at
// admission and prepares it on the io pool before the handler runs, so no
// SendOptionIO is needed here.
func (steps giftSteps) debit(ctx context.Context, step saga.NativeStep) error {
	state, entityID, err := giftTarget(step.Command(), func(state gift.State) int64 { return state.From })
	if err != nil {
		return err
	}
	_, err = syncsender.NewGiftDebitSender(steps.nest).Sync_GiftDebit(ctx, entityID, state.ItemID, state.Count, step)
	return err
}

// refund is debit's compensation: the same AddItem transaction the endpoint
// runs. It can refuse too — the stack filled up meanwhile — and a refused
// compensation is what the coordinator marks manual_required for: an
// operator sees it in gm.saga.list and decides. A refund usually lands on an
// offline, cold sender; Nest loads declared cold targets on its io pool, so
// "offline" is not a reason for the compensation to fail.
//
// 重试预算：退款只投给发送方绑定的 sid（路由步骤，admitBound 核对），那个 sid 的进程崩溃重启期间，命令留在
// 它的 durable 上没有人取，每一次尝试都等到 Timeout；补偿的重试用尽就是 manual_required，要人工处理。一次
// 崩溃重启最长约为 singleton.startup_wait（30s，新进程等旧锁的上限）+ singleton.ttl（15s，旧进程最后
// 一次续期之后键还活着的时间）+ 被拉起与 Init 的余量（按 45s 留），合计 90s。所以 debit 这一步（它的
// 补偿就是退款）在 game 服务的配置里覆盖为 `saga.steps.gift_item.debit.max_attempts: 15`（Timeout 5s、
// 退避 100ms..5s 取 saga.step_defaults）：至少 15 × 5s + 23.15s（14 次退避各取抖动下界）≈ 98s，至多约
// 121s，在重启结束之后至少还有一次完整的尝试。步骤预算正反两个方向共用，所以 debit 的正向尝试也是 15 次
// ——同一次扣款最多生效一次（框架按操作实例去重，见 roost-core SAGA.md「原生步骤执行契约」），一直失败时
// 什么都没扣，只是更晚才判赠礼失败（仍受 gift.Deadline 约束）。gift_saga_budget_test.go 用 saga Mod 读
// 配置的同一个函数钉住这个关系；改 ttl / startup_wait 或步骤预算时一起改这里。
func (steps giftSteps) refund(ctx context.Context, step saga.NativeStep) error {
	state, entityID, err := giftTarget(step.Command(), func(state gift.State) int64 { return state.From })
	if err != nil {
		return err
	}
	_, err = syncsender.NewGiftRefundSender(steps.nest).Sync_GiftRefund(ctx, entityID, state.ItemID, state.Count, step)
	return err
}

// deliver mails the item to the recipient. A recipient who has never
// entered the game has no Player document and is refused — the case that
// makes the coordinator compensate the debit. The mail service's own coded
// refusals (mailbox full) do the same.
//
// Where the Player document is: the Player DAO's collection in the physical
// database its logical db= (`//roost:dao coll=player db=main` in
// db/def/player.go) maps to through dataengine.databases — resolved once in
// startGiftSaga with kitdataengine.DAOCollection. NOT `dataengine.database`
// (the Data Engine's own collections), and NOT db.PlayerDaoDBName used as a
// database name: that is the logical name, and a deployment that maps it
// elsewhere would make every gift compensate as "recipient has never entered
// the game".
func (steps giftSteps) deliver(ctx context.Context, command saga.Command) (saga.Completion, error) {
	state, entityID, err := giftTarget(command, func(state gift.State) int64 { return state.To })
	if err != nil {
		return refuse(err.Error()), nil
	}
	var recipient struct {
		ID int64 `bson:"_id"`
	}
	if err := steps.players.FindOne(ctx, bson.M{"_id": entityID}, &recipient); err != nil {
		if errors.Is(err, fmongo.ErrNotFound) {
			return refuse(giftRecipientNotFound), nil
		}
		return saga.Completion{}, err
	}
	// The mailbox module's sender. The gifted stack rides as an item
	// attachment (gamemailbox.Item, the kind the mailbox and bag modules
	// register together); the recipient claims it through MailboxClaim.
	_, err = gamemailbox.SendTo(ctx, steps.mailer, gamemailbox.Letter{
		To: state.To, Subject: gift.Subject(state), Body: gift.Body(state),
		Attachment:       gamemailbox.Item(state.ItemID, int64(state.Count)),
		ExpiresInSeconds: gift.MailExpiresIn,
		// One mail per step, however many times the command is delivered
		// and however many attempts the step takes. Required: the mail is
		// outside the inbox's transaction, so the framework's
		// one-attempt-per-operation contract does not cover it.
		RequestID: "gift:" + command.IdempotencyKey,
	})
	if err != nil {
		// A gift that is not an attachment the mailbox can grant will not
		// become one on a retry: a business refusal, so the saga compensates.
		if errors.Is(err, gamemailbox.ErrLetterInvalid) {
			return refuse(err.Error()), nil
		}
		if code, reason := errcode.ClientError(err); code != errcode.CodeInternal {
			return refuse(reason), nil
		}
		return saga.Completion{}, err
	}
	return saga.Completion{Success: true}, nil
}

// nothingToUndo is deliver's compensation. A sent mail is not recalled; the
// definition names a compensation topic for every step, so this one
// acknowledges and moves on. It only ever runs if a step after deliver is
// added and fails.
func (giftSteps) nothingToUndo(_ context.Context, command saga.Command) (saga.Completion, error) {
	slog.Warn("gift saga: deliver compensation requested; mail is not recalled", "saga_id", command.SagaID)
	return saga.Completion{Success: true}, nil
}

// giftTarget decodes the command's state and builds the entity id of the
// player the step acts on.
func giftTarget(command saga.Command, pick func(gift.State) int64) (gift.State, int64, error) {
	state, err := gift.Decode(command.Payload)
	if err != nil {
		return gift.State{}, 0, err
	}
	entityID, err := entity.BuildEntityID(pick(state), player.EntityKindPlayer)
	if err != nil {
		return gift.State{}, 0, err
	}
	return state, entityID, nil
}

// refuse is a non-retryable failure: the coordinator moves to compensation.
func refuse(reason string) saga.Completion {
	return saga.Completion{Success: false, Retryable: false, Error: reason}
}

