// 建筑同步（可编辑地形方案 §27）：建筑是普通的同步实体，走与 Player / Monster 相同的链路——实体 sync=true（命名空间
// "building"，生成的同步字段与 packer），登记为场景同一个 entitysync Manager 的 subject，按位置放进一个 policy.Interest，
// 由提交观察者按 on_change 发增量（场景的 TypeSchedules）；同一条玩家连接、同一个推送编号、同一个 epoch，客户端按命名空间
// 分流、用生成的 ApplySyncBuildingDao 应用。没有建筑专用的消息或通道，建筑也不挂在地形块的同步上（块上的 Lots 只是服务端
// 放置时的串行化索引，不下发）。
//
// 为什么是自己的 Interest（与地形块一样是一个独立订阅来源），而不是场景的主视野：主视野的 MaxVisible（64）是“离玩家最近的
// 64 个玩家 / 怪”，建筑放进去会按距离挤掉玩家；超额降级（D17）收紧的也是整个主视野。建筑自己的 Interest 有自己的视野半径
// （建筑是大而静止的东西，比人看得远）、自己的 MaxVisible，Manager 上是自己的命名空间与上限（D15 的 Namespaces），
// 超额只在建筑一类降级，玩家、怪、地形照常。
//
//   - 观察者：玩家的地形视点（terrainSync 的 watch / moved / unwatch，跟着玩家提交后的位置走，8m 才报一次）同时就是建筑视野
//     的视点——两个 Interest 用同一个视点、各自的半径与上限。
//   - subject：站着的建筑，位置是占地中心。放置提交之后登记并放进视野（terrainmap.Map.SetBuildingCommitted 的通知），
//     拆除提交之后撤出视野（Interest.Hide：看着它的客户端下一帧收到 remove），subject 留在 Manager 里——同一锚点再放时
//     是同一个实体，重新 Show 即可，不必等退役。改参数是普通的 DAO 写，subject 已登记，提交观察者按 on_change 发增量。
//   - 次序：放置 / 拆除的提交后回调可能乱序到达，通知带锚点所在块的 LotRevision（同一座建筑的每次放置 / 拆除都写这一块，
//     随提交次序严格递增），这里只认更大的修订号，所以“拆了又放”不会以“放了又拆”的次序落到视野上。
//   - 启动：地形服务的建筑对账核对通过的建筑（Map.ReconciledBuildings）在场景启动之后、玩家能进来之前登记（loadStanding）。
//
// 预算（每个观察者，方案 §27）：实测一座 hall 的全量是 132 字节的同步组件（subject 头约 79 字节 + DAO 同步载荷 53 字节），
// 改参数的增量 94 字节（载荷 15 字节）（building_sync_test.go 的 TCP 用例记录）。视野满 128 座约 17KB，一次进入视野发完；
// 按 10m/s 走过每 100m² 一座建筑的街区（200m 视野每秒新扫过约 4000m²），每秒约 40 座进入视野，约 5.3KB/s；改参数受编辑
// 配额限制。远低于每观察者 50KB/s 的下行预算，与地形的预算（D15）相加仍在其内，所以建筑命名空间不设快照预算。
const (
	// buildingNamespace 是 Building 实体的同步命名空间，客户端按它分流。
	buildingNamespace = building.SyncNamespaceBuilding
	// buildingViewRadius 是建筑视野的进入半径（世界单位，200m，与地形视野相同），离开半径多 buildingViewHysteresis（20m）。
	buildingViewRadius     = 20000
	buildingViewHysteresis = 2000
	// buildingMaxVisible 是一个玩家的建筑视野最多同时持有的建筑数，也是建筑命名空间的会话持有上限（D15）。
	buildingMaxVisible = 128
)

// buildingSync 是建筑的订阅组织：一个 Interest（玩家是观察者、站着的建筑是 subject）加提交后的登记 / 撤出。
//
// 锁：mu 保护 revisions；Interest 与 Manager 的调用只取它们自己的短锁、不等待，可以在提交后回调里调用。
type buildingSeen struct {
	revision int64
	standing bool
}

type buildingSync struct {
	manager  *entitysync.Manager
	interest *policy.Interest

	mu sync.Mutex
	// latest 是每座建筑最近一次处理的通知：修订号（锚点块的 LotRevision；更小或相等的通知是迟到的，丢掉）与是否站着。
	latest map[int64]buildingSeen
	closed atomic.Bool
}

func newBuildingSync(manager *entitysync.Manager, bounds spatial.Rect, maxVisible int) (*buildingSync, error) {
	interest, err := policy.NewInterest(policy.InterestConfig{
		Manager:   manager,
		ApplyMode: policy.ApplySync,
		OnRefusal: logRefusal,
		AOI: policy.AOIConfig{
			Bounds:      bounds,
			BlockSize:   terrain.ChunkSize,
			EnterRadius: buildingViewRadius,
			LeaveRadius: buildingViewRadius + buildingViewHysteresis,
			MaxVisible:  maxVisible,
		},
	})
	if err != nil {
		return nil, fmt.Errorf("building sync: interest policy: %w", err)
	}
	return &buildingSync{manager: manager, interest: interest, latest: map[int64]buildingSeen{}}, nil
}

// watch / move / unwatch 是玩家的建筑视点（terrainSync 在它自己的视点变化时调用，at 已夹进地图）。
func (s *buildingSync) watch(playerID int64, at spatial.Point) {
	if s == nil || s.closed.Load() {
		return
	}
	if err := s.interest.Watch(playerID, at, policy.ObserverView{}); err != nil {
		slog.Warn("building sync: player not watching the buildings", "player_id", playerID, "err", err)
	}
}

func (s *buildingSync) move(playerID int64, at spatial.Point) {
	if s == nil || s.closed.Load() {
		return
	}
	if err := s.interest.MoveView(playerID, at); err != nil && !errors.Is(err, policy.ErrInterestUnknown) {
		slog.Debug("building sync: view not moved", "player_id", playerID, "err", err)
	}
}

func (s *buildingSync) unwatch(playerID int64) {
	if s == nil {
		return
	}
	if err := s.interest.Unwatch(playerID); err != nil && !errors.Is(err, policy.ErrInterestUnknown) {
		slog.Debug("building sync: player not released", "player_id", playerID, "err", err)
	}
}

// committed 是放置 / 拆除提交之后的通知（terrainmap.Map.SetBuildingCommitted），也是启动时登记站着的建筑的入口。不阻塞。
func (s *buildingSync) committed(change terrainmap.BuildingCommit) {
	if s == nil || change.Building == nil || s.closed.Load() {
		return
	}
	id := change.Building.ID()
	s.mu.Lock()
	if last, seen := s.latest[id]; seen && last.revision >= change.Revision {
		s.mu.Unlock()
		return
	}
	s.latest[id] = buildingSeen{revision: change.Revision, standing: change.Standing}
	s.mu.Unlock()
	if !change.Standing {
		if err := s.interest.Hide(id); err != nil && !errors.Is(err, policy.ErrInterestUnknown) {
			slog.Warn("building sync: a removed building was not hidden", "building", id, "err", err)
		}
		return
	}
	if err := s.manager.Register(change.Building.Sync()); err != nil && !errors.Is(err, entitysync.ErrSubjectRegistered) {
		slog.Error("building sync: a building was not registered; players will not see it until a restart", "building", id, "lot", change.Lot.String(), "err", err)
		return
	}
	if err := s.interest.Show(id, lotCentre(change.Lot)); err != nil {
		slog.Error("building sync: a building was not shown; players will not see it until a restart", "building", id, "lot", change.Lot.String(), "err", err)
	}
}

// loadStanding 登记启动对账核对通过的站着的建筑（场景启动之后、玩家能进来之前）。返回登记了几座。
func (s *buildingSync) loadStanding(m *terrainmap.Map) int {
	if s == nil || m == nil {
		return 0
	}
	standing := m.ReconciledBuildings()
	for _, b := range standing {
		s.committed(b)
	}
	return len(standing)
}

// standingCount 是按最近的通知此刻站着（放在建筑视野里）的建筑数（测试与诊断）。
func (s *buildingSync) standingCount() int {
	if s == nil {
		return 0
	}
	s.mu.Lock()
	defer s.mu.Unlock()
	n := 0
	for _, seen := range s.latest {
		if seen.standing {
			n++
		}
	}
	return n
}

func (s *buildingSync) close() {
	if s == nil || !s.closed.CompareAndSwap(false, true) {
		return
	}
	s.interest.Close()
}

// lotCentre 是占地中心的世界坐标（厘米）：节点 n 在 n × SampleSpacing。
func lotCentre(lot terrain_chunk.Lot) spatial.Point {
	return spatial.Point{
		X: (lot.GX*2 + int64(lot.W) - 1) * terrain.SampleSpacing / 2,
		Y: (lot.GY*2 + int64(lot.H) - 1) * terrain.SampleSpacing / 2,
	}
}
