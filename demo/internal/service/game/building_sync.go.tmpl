// 建筑同步（可编辑地形方案 §27、§27.10）：建筑是普通的同步实体，订阅跟随玩家与怪——与 Monster 完全相同的接法：
// 场景的 ShowSubject（登记为场景 Manager 的 subject，再放进场景主视野那个 Interest）/ HideSubject（撤出主视野并退役
// subject），同一个 Manager、同一个主视野（同一套半径、MaxVisible 与超额降级）、同一条玩家连接与推送编号；Manager 的
// TypeSchedules 里没有建筑的条目，与玩家、怪一样按 Manager 的模式发（生产是 on_change）；Namespaces 里也没有建筑，
// 它与玩家、怪、场景同在缺省一类（Limits.MaxObjects 100）。实体的同步命名空间 "building" 只是客户端的分流键，
// 与 "monster" 相同。可编辑地形里只有 TerrainChunk 有自己的 Interest、周期调度与副本（terrain_sync.go）。
//
// 这里只剩建筑与怪不同的一点：什么时候 Show / Hide。怪由 spawner 在一个 goroutine 上建、上图、杀；建筑由放置 / 拆除的
// Nest 事务决定，提交之后（nest.AfterCommit，WAL 落盘之后）terrainmap.Map.SetBuildingCommitted 通知这里：
//   - 放置提交：ShowSubject，位置是占地中心（建筑不动，之后不再 Move）。
//   - 拆除提交：HideSubject（看着它的客户端下一帧收到 remove，subject 退役）。同一锚点再放时是同一个实体 ID，退役还没发完
//     就再放的，ShowSubject 把登记排在退役之后（Manager.RegisterAfterRetirement），先 remove 后 create。
//   - 改参数是普通的 DAO 写：subject 已登记，提交观察者按 on_change 发增量，不经这里。
//   - 次序：提交后回调可能乱序到达，通知带锚点所在块的 LotRevision（同一座建筑的每次放置 / 拆除都写这一块，随提交
//     次序严格递增），只认更大的修订号；判定与 Show / Hide 在同一把锁里做，判定通过的旧通知不会在更新的通知之后才生效。
//   - 启动：地形服务的建筑对账核对通过的建筑（Map.ReconciledBuildings）在场景启动之后、玩家能进来之前登记（loadStanding）。
//
// 主视野的半径与上限是场景的（scene.go：进入 1.2m、离开 1.5m，客户端最多要到进入 2.7m / 离开 3m；最近 64 个），对建筑也一样：建筑与玩家、
// 怪一起按占地中心的距离排“最近 64 个”，超额时一起降级（D17）。demo 尺度下的影响见方案 §27.10。
type buildingSync struct {
	// scene 是建筑进出场景的入口，就是怪用的那两个（ShowSubject / HideSubject）。
	scene *Scene

	mu sync.Mutex
	// latest 是每座建筑最近一次处理的通知：修订号（锚点块的 LotRevision；更小或相等的通知是迟到的，丢掉）与是否站着。
	latest map[int64]buildingSeen
}

type buildingSeen struct {
	revision int64
	standing bool
}

func newBuildingSync(scene *Scene) *buildingSync {
	return &buildingSync{scene: scene, latest: map[int64]buildingSeen{}}
}

// committed 是放置 / 拆除提交之后的通知（terrainmap.Map.SetBuildingCommitted），也是启动时登记站着的建筑的入口。
// 不阻塞：ShowSubject / HideSubject 只取 Manager 与 Interest 的短锁，所以可以持着 mu 调用，让修订号的判定与它的效果
// 一起按修订号的次序生效。
func (s *buildingSync) committed(change terrainmap.BuildingCommit) {
	if s == nil || change.Building == nil {
		return
	}
	id := change.Building.ID()
	s.mu.Lock()
	defer s.mu.Unlock()
	if last, seen := s.latest[id]; seen && last.revision >= change.Revision {
		return
	}
	s.latest[id] = buildingSeen{revision: change.Revision, standing: change.Standing}
	if !change.Standing {
		s.scene.HideSubject(context.Background(), id)
		return
	}
	// 场景已关闭（进程退出时迟到的提交后通知）不算丢失：重启时 loadStanding 按库里的建筑重新登记。
	if err := s.scene.ShowSubject(context.Background(), change.Building.Sync(), id, lotCentre(change.Lot)); err != nil && !errors.Is(err, entitysync.ErrManagerClosed) {
		slog.Error("building sync: a building was not shown; players will not see it until a restart", "building", id, "lot", change.Lot.String(), "err", err)
	}
}

// loadStanding 登记启动对账核对通过的站着的建筑（场景启动之后、玩家能进来之前）。返回登记了几座。
func (s *buildingSync) loadStanding(m *terrainmap.Map) int {
	if s == nil || m == nil {
		return 0
	}
	standing := m.ReconciledBuildings()
	for _, b := range standing {
		s.committed(b)
	}
	return len(standing)
}

// standingCount 是按最近的通知此刻站着（放在主视野里）的建筑数（测试与诊断）。
func (s *buildingSync) standingCount() int {
	if s == nil {
		return 0
	}
	s.mu.Lock()
	defer s.mu.Unlock()
	n := 0
	for _, seen := range s.latest {
		if seen.standing {
			n++
		}
	}
	return n
}

// attachBuildings 把建筑接到场景上：只在接建筑的普通场景（terrainmap.Map.BuildingsEnabled）。之后提交的放置 / 拆除
// 在提交后进出场景主视野；返回的 buildingSync 也是启动时登记站着的建筑的入口（startTerrainSync）。不接建筑时 nil。
// 玩家能进来之前调用。
func (bridge *Scene) attachBuildings(m *terrainmap.Map) *buildingSync {
	if bridge == nil || !m.BuildingsEnabled() {
		return nil
	}
	bridge.buildings = newBuildingSync(bridge)
	m.SetBuildingCommitted(bridge.buildings.committed)
	return bridge.buildings
}

// lotCentre 是占地中心的世界坐标（厘米）：节点 n 在 n × SampleSpacing。
func lotCentre(lot terrainsurface.Lot) spatial.Point {
	return spatial.Point{
		X: (lot.GX*2 + int64(lot.W) - 1) * terrain.SampleSpacing / 2,
		Y: (lot.GY*2 + int64(lot.H) - 1) * terrain.SampleSpacing / 2,
	}
}
