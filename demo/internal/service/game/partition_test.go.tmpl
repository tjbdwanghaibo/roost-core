// What a client sees of a partitioned scene are the Base's mirrors, packed with the Player's and the Monster's own
// sync encoding (maintainer decision D2 = A): the demo's decoder reads them unchanged, by namespace.
func TestPartitionMirrorsDecodeAsPlayersAndMonsters(t *testing.T) {
	rt := &partitionRuntime{config: settings.ScenePartition{MonsterTemplate: 9001}}
	for _, tc := range []struct {
		name  string
		state cellworld.EntityState
		want  map[string]int64
	}{
		{"player", cellworld.EntityState{ID: 1, Kind: cellworld.KindPlayer, X: 2990, Y: 1500, HP: 80, Panel: cellworld.Panel{MaxHP: 120, Attack: 14, Power: 40, Ver: 2}},
			map[string]int64{"pos_x": 2990, "pos_y": 1500, "cell_hp": 80, "cell_max_hp": 120, "cell_attack": 14, "cell_power": 40}},
		{"monster", cellworld.EntityState{ID: 2, Kind: cellworld.KindNPC, X: 3010, Y: 1500, HP: 70}, map[string]int64{"pos_x": 3010, "pos_y": 1500, "hp": 70, "template": 9001}},
	} {
		t.Run(tc.name, func(t *testing.T) {
			namespace, _ := partitionMirrorKind(tc.state)
			if namespace != tc.name {
				t.Fatalf("namespace %q, want %q", namespace, tc.name)
			}
			payload, err := rt.packMirror(tc.state, entity.SyncProfile{})
			if err != nil {
				t.Fatal(err)
			}
			fields, err := clientsync.DecodeFields(entity.SubjectSyncUpdate{SubjectID: tc.state.ID, Namespace: namespace, Payload: payload})
			if err != nil {
				t.Fatal(err)
			}
			for key, want := range tc.want {
				var got int64
				switch v := fields[key].(type) {
				case int64:
					got = v
				case int32:
					got = int64(v)
				}
				if got != want {
					t.Fatalf("%s = %v, want %d (fields %v)", key, fields[key], want, fields)
				}
			}
		})
	}
}

// Use the real world entity, not the two-process terrain fixture's walkScene stand-in.
func TestWorldSceneCellBeatAndTeardown(t *testing.T) {
	w := newMoveWorldMode(t, gamescene.DefaultConfig(), true)
	area := w.area
	if w.bridge.ordinary != nil || area.CellRegion() != nil {
		t.Fatal("partition started with an ordinary Space or a premature Region")
	}
	grid := partitionTerrainGrid(t)
	cell, ok := grid.CellOf(partitionSidA)
	if !ok {
		t.Fatal("no cell for test process")
	}
	owners, err := cellworld.NewOwnerRegistry(versionstore.NewMemoryStore[int64, cellworld.OwnerRecord](), func(context.Context, cellworld.OwnerProcess) (bool, error) { return true, nil }, versionstore.NewMemoryStore[uint32, cellworld.DeathBucket]())
	if err != nil {
		t.Fatal(err)
	}
	committed := make(chan cellworld.CellID, 1)
	node, err := cellworld.NewNode(cellworld.NodeConfig{
		World: "entity-life", SID: partitionSidA, Grid: grid, Cell: &cell, Scene: area.ID(), Nest: w.engine, Transport: &walkTransport{},
		Owners: owners, Incarnation: "local", CheckLease: func() error { return nil }, ViewRadius: 800,
		CreateActor: func(int64, cellworld.EntityKind) (cellworld.Actor, error) {
			return nil, errors.New("unexpected actor creation")
		},
		Destroy: func(context.Context, entity.IThreadSafeEntity) error {
			return errors.New("unexpected actor destruction")
		},
		Hooks: cellworld.Hooks{TickDone: func(c cellworld.CellID, _ time.Duration, _, _ int) {
			select {
			case committed <- c:
			default:
			}
		}},
	})
	if err != nil {
		t.Fatal(err)
	}
	cellworldhost.Install(node, area.ID(), actor.Heartbeat)
	defer cellworldhost.Uninstall(node)
	if err := locked(w, area.ID(), func() error { return area.HostCell(node.Config().Period) }); err != nil {
		t.Fatal(err)
	}
	w.clock.advance(time.Second)
	select {
	case got := <-committed:
		if got != cell || locked(w, area.ID(), area.CellRegion) == nil {
			t.Fatal("wrong cell or scene region")
		}
	case <-time.After(5 * time.Second):
		t.Fatal("the world entity did not commit a region beat")
	}
	// Stop dispatch (not registrations), then drain the entity's pending messages. A shared
	// driver can retain unrelated registrations from another fixture. No automatic stale-ID
	// sweep can now mask a missing host release; exactly spawn and cell must leave the ring.
	if err := actor.Heartbeat.Stop(w.ctx); err != nil {
		t.Fatal(err)
	}
	w.settle(area.ID())
	registered := actor.Heartbeat.Registered()
	if err := w.entities.Destroy(w.ctx, area, entity.DestroyReasonCommon, false); err != nil {
		t.Fatal(err)
	}
	area.OnDestroy(entity.DestroyReasonCommon) // a late destroy must not stop the bridge or release anything twice
	if after := actor.Heartbeat.Registered(); registered-after != 2 {
		t.Fatalf("destroying the Cell world must remove its two heartbeats: before %d, after %d", registered, after)
	}
	if area.Terrain() != nil || actor.WorldTime() != nil {
		t.Fatal("world retained its map or time domain publication")
	}
	if err := w.bridge.manager.OpenHeldSession(9761); err != nil {
		t.Fatalf("entity destruction closed the bridge manager: %v", err)
	}
	w.bridge.manager.CloseSession(9761)
}

// A process without scene.partition publishes no partitioned scene: the endpoints take that as "ordinary scene"
// (Move works, MoveIntent answers scene_not_partitioned), and the default config keeps it so.
func TestPartitionIsOffByDefault(t *testing.T) {
	var config settings.Config
	if config.Scene.Partition.Enabled {
		t.Fatal("the partitioned scene is on in a zero config")
	}
	if err := config.Scene.Partition.ValidateConfig(false); err != nil {
		t.Fatalf("a disabled partition is refused: %v", err)
	}
}

// The verdict the attacker's client gets (AttackResultPush, maintainer 2026-11-03 item 2): applied with the damage the
// target's cell actually dealt (the attacker's panel attack, item 3 = A) and the target's HP after it, a retry the target's cell had already applied as a duplicate (no damage this
// time), a refusal with its reason, and "unknown" — the target's cell did not answer, so no HP is claimed.
func TestAttackResultPushNamesTheVerdict(t *testing.T) {
	hit := cellworld.HitID{Attacker: 1, Seq: 9, ID: "attack-identity"}
	for _, tc := range []struct {
		in   cellworld.AttackResult
		want string
		dmg  int32
		hp   int32
		why  string
	}{
		{cellworld.AttackResult{Hit: hit, Target: 5, Outcome: cellworld.OutcomeApplied, HP: 60, Damage: 14}, "applied", 14, 60, ""},
		{cellworld.AttackResult{Hit: hit, Target: 5, Outcome: cellworld.OutcomeApplied, Duplicate: true, HP: 60}, "duplicate", 0, 60, ""},
		{cellworld.AttackResult{Hit: hit, Target: 5, Outcome: cellworld.OutcomeRejected, Reason: cellworld.ReasonOutOfRange, HP: 70}, "rejected", 0, 70, "out_of_range"},
		{cellworld.AttackResult{Hit: hit, Target: 5, Outcome: cellworld.OutcomeUnknown, HP: 70}, "unknown", 0, 0, ""},
	} {
		got := attackResultPush(tc.in)
		if got.Seq != 9 || got.AttackID != hit.ID || got.Target != 5 || got.Outcome != tc.want || got.Damage != tc.dmg || got.TargetHP != tc.hp || got.Reason != tc.why {
			t.Errorf("%+v → %+v, want outcome %s damage %d hp %d reason %q", tc.in, got, tc.want, tc.dmg, tc.hp, tc.why)
		}
	}
}
