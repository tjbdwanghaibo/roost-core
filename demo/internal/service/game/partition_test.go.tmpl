// What a client sees of a partitioned scene are the Base's mirrors, packed with the Player's and the Monster's own
// sync encoding (maintainer decision D2 = A): the demo's decoder reads them unchanged, by namespace.
func TestPartitionMirrorsDecodeAsPlayersAndMonsters(t *testing.T) {
	rt := &partitionRuntime{config: settings.ScenePartition{MonsterTemplate: 9001}}
	for _, tc := range []struct {
		name  string
		state cellworld.EntityState
		want  map[string]int64
	}{
		{"player", cellworld.EntityState{ID: 1, Kind: cellworld.KindPlayer, X: 2990, Y: 1500, HP: 80}, map[string]int64{"pos_x": 2990, "pos_y": 1500, "cell_hp": 80}},
		{"monster", cellworld.EntityState{ID: 2, Kind: cellworld.KindNPC, X: 3010, Y: 1500, HP: 70}, map[string]int64{"pos_x": 3010, "pos_y": 1500, "hp": 70, "template": 9001}},
	} {
		t.Run(tc.name, func(t *testing.T) {
			namespace, _ := partitionMirrorKind(tc.state)
			if namespace != tc.name {
				t.Fatalf("namespace %q, want %q", namespace, tc.name)
			}
			payload, err := rt.packMirror(tc.state, entity.SyncProfile{})
			if err != nil {
				t.Fatal(err)
			}
			fields, err := clientsync.DecodeFields(entity.SubjectSyncUpdate{SubjectID: tc.state.ID, Namespace: namespace, Payload: payload})
			if err != nil {
				t.Fatal(err)
			}
			for key, want := range tc.want {
				var got int64
				switch v := fields[key].(type) {
				case int64:
					got = v
				case int32:
					got = int64(v)
				}
				if got != want {
					t.Fatalf("%s = %v, want %d (fields %v)", key, fields[key], want, fields)
				}
			}
		})
	}
}

// A process without scene.partition publishes no partitioned scene: the endpoints take that as "ordinary scene"
// (Move works, MoveIntent answers scene_not_partitioned), and the default config keeps it so.
func TestPartitionIsOffByDefault(t *testing.T) {
	var config settings.Config
	if config.Scene.Partition.Enabled {
		t.Fatal("the partitioned scene is on in a zero config")
	}
	if err := config.Scene.Partition.ValidateConfig(false); err != nil {
		t.Fatalf("a disabled partition is refused: %v", err)
	}
}

// The verdict the attacker's client gets (AttackResultPush, maintainer 2026-11-03 item 2): applied with the damage
// and the target's HP after it, a retry the target's cell had already applied as a duplicate (no damage this
// time), a refusal with its reason, and "unknown" — the target's cell did not answer, so no HP is claimed.
func TestAttackResultPushNamesTheVerdict(t *testing.T) {
	hit := cellworld.HitID{Attacker: 1, Seq: 9}
	for _, tc := range []struct {
		in   cellworld.AttackResult
		want string
		dmg  int32
		hp   int32
		why  string
	}{
		{cellworld.AttackResult{Hit: hit, Target: 5, Outcome: cellworld.OutcomeApplied, HP: 60}, "applied", 10, 60, ""},
		{cellworld.AttackResult{Hit: hit, Target: 5, Outcome: cellworld.OutcomeApplied, Duplicate: true, HP: 60}, "duplicate", 0, 60, ""},
		{cellworld.AttackResult{Hit: hit, Target: 5, Outcome: cellworld.OutcomeRejected, Reason: cellworld.ReasonOutOfRange, HP: 70}, "rejected", 0, 70, "out_of_range"},
		{cellworld.AttackResult{Hit: hit, Target: 5, Outcome: cellworld.OutcomeUnknown, HP: 70}, "unknown", 0, 0, ""},
	} {
		got := attackResultPush(tc.in, 10)
		if got.Seq != 9 || got.Target != 5 || got.Outcome != tc.want || got.Damage != tc.dmg || got.TargetHP != tc.hp || got.Reason != tc.why {
			t.Errorf("%+v → %+v, want outcome %s damage %d hp %d reason %q", tc.in, got, tc.want, tc.dmg, tc.hp, tc.why)
		}
	}
}
