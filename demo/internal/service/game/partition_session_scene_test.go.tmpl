// A confirmed replacement login and a replacement Join are distinct lifecycle
// steps. Only the latter installs a new receiver; neither formally removes the Base.
func TestPartitionGateViewLifecycle(t *testing.T) {
	for _, step := range []string{"close", "reconcile", "close_after_rejoin"} {
		t.Run(step, func(t *testing.T) {
			ctx := context.Background()
			const id = 862
			f, peers, scene, p := partitionCommandFixture(t, id)
			owner, next := peers.socket(id, 1), peers.socket(id, 2)
			gate := partitionGateStub{}
			binding := gate.bind(owner, 1)
			f.rt.gateIngress = gate
			scene.watchSessions(peers)
			join := func(socket *partitionViewSocket) {
				t.Helper()
				if err := scene.JoinConnection(ctx, p, spatial.Point{}, socket); err != nil {
					t.Fatal(err)
				}
				if err := scene.ReadyConnection(id, socket); err != nil {
					t.Fatal(err)
				}
			}
			join(owner)
			before, err := f.rt.node.BaseStateOf(ctx, p.ID())
			if err != nil || !before.InWorld {
				t.Fatalf("joined Base: %+v, %v", before, err)
			}
			if step != "close_after_rejoin" {
				next.key.SessionID = "second-login" // independent login of the same player
			}
			nextBinding := gate.bind(next, 2)
			if step == "close_after_rejoin" {
				join(next) // same SID replaced, and the new connection has entered
			} else {
				if len(gate) != 2 || !gate.ConnectionActive(id, owner.ConnectionID()) || !gate.ConnectionActive(id, next.ConnectionID()) {
					t.Fatal("expected two independently live Gate bindings before owner close")
				}
				delete(gate, binding.SessionID) // retire only the owner before publishing its close
			}
			owner.closed.Store(true)
			closed := gateway.TCPSessionClosed{PlayerID: id, SessionID: binding.SessionID, ConnectionID: binding.ConnectionNonce, Binding: binding, ReceiverID: 1}
			if step == "reconcile" {
				// Exactly one periodic pass, without delivering the close or another Join.
				scene.reconcilePartitionViewsOnce()
			} else {
				for _, notify := range peers.closed {
					notify(closed)
				}
			}
			after, err := f.rt.node.BaseStateOf(ctx, p.ID())
			if err != nil || !after.InWorld || after.Actor != before.Actor || after.Entry != before.Entry {
				t.Fatalf("view cleanup changed the Base entry: %+v -> %+v, %v", before, after, err)
			}
			_, terrain := scene.terrain.interest.ObserverView(id)
			subs := scene.manager.Subscribers(p.ID())
			if binding, order, ok := gate.SessionAdmission(next.key.SessionID); !ok || binding != nextBinding || order != 2 || next.closed.Load() || peers.closuresOf(id) != 0 {
				t.Fatal("view cleanup disturbed the second login")
			}
			// The first Flush is after cleanup. A retired receiver cannot emit its
			// pending first snapshot even though player-keyed delivery is available.
			if err := scene.Flush(ctx); err != nil {
				t.Fatal(err)
			}
			frames := peers.take(id)
			if step == "close_after_rejoin" {
				if err := scene.ReadyConnection(id, next); err != nil || scene.Members() != 1 || !terrain || len(subs) != 1 || !heldSubjects(t, frames)[p.ID()] {
					t.Fatalf("replacement view: ready=%v members=%d terrain=%v self=%v frames=%d", err, scene.Members(), terrain, subs, len(frames))
				}
				return
			}
			if scene.Members() != 0 || terrain || len(subs) != 0 || len(frames) != 0 || !errors.Is(scene.manager.ReadySession(id), entitysync.ErrSessionUnknown) {
				t.Fatalf("departed view: members=%d terrain=%v self=%v frames=%d", scene.Members(), terrain, subs, len(frames))
			}
		})
	}
}

