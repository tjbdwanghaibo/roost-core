// RR-20260920-04：持有一把租约，和**知道自己还持有它**，是两件事。
//
// 续租失败之后这个进程什么都不知道，而 30 秒后另一个进程可以合法地接手同一个
// 玩家。所以"写到有人来拦"不成立——没有人会来拦。每条写入路径都问 Admit，它只
// 根据 Redis 最近一次**确认过**的续租回答，并且在确认的租约快到期时提前收口。

type fakeLeaseTable struct {
	sid      int32
	owner    map[int64]int32
	refresh  func(playerID int64) playerroute.RefreshResult
	released []int64
}

func newFakeLeaseTable(sid int32) *fakeLeaseTable {
	return &fakeLeaseTable{sid: sid, owner: map[int64]int32{}}
}

func (f *fakeLeaseTable) SID() int32 { return f.sid }

func (f *fakeLeaseTable) Claim(_ context.Context, playerID int64) (playerroute.Route, error) {
	if held, ok := f.owner[playerID]; ok {
		return playerroute.Route{SID: held, Token: "t"}, nil
	}
	f.owner[playerID] = f.sid
	return playerroute.Route{SID: f.sid, Token: "t"}, nil
}

func (f *fakeLeaseTable) Owner(_ context.Context, playerID int64) (playerroute.Route, error) {
	if held, ok := f.owner[playerID]; ok {
		return playerroute.Route{SID: held, Token: "t"}, nil
	}
	return playerroute.Route{}, nil
}

func (f *fakeLeaseTable) Owns(_ context.Context, playerID int64) (bool, error) {
	return f.owner[playerID] == f.sid, nil
}

func (f *fakeLeaseTable) GetRoute(_ context.Context, playerID int64) (playerroute.Route, bool, error) {
	held, ok := f.owner[playerID]
	if !ok {
		return playerroute.Route{}, false, nil
	}
	return playerroute.Route{SID: held, Token: "t"}, true, nil
}

func (f *fakeLeaseTable) Refresh(_ context.Context, playerIDs []int64) []playerroute.RefreshResult {
	out := make([]playerroute.RefreshResult, 0, len(playerIDs))
	for _, playerID := range playerIDs {
		if f.refresh != nil {
			out = append(out, f.refresh(playerID))
			continue
		}
		out = append(out, playerroute.RefreshResult{PlayerID: playerID, Held: f.owner[playerID] == f.sid})
	}
	return out
}

func (f *fakeLeaseTable) Release(_ context.Context, playerID int64) error {
	f.released = append(f.released, playerID)
	delete(f.owner, playerID)
	return nil
}

type fakeFencer struct {
	closed []int64
	// online is who this process still has a connection for. The zero value
	// is "nobody", which is what a background consumer's player looks like.
	online map[int64]int
}

func (f *fakeFencer) CloseSessions(playerID int64, _ error) int {
	f.closed = append(f.closed, playerID)
	closed := f.online[playerID]
	delete(f.online, playerID)
	return closed
}

func (f *fakeFencer) ActiveSessions(playerID int64) int { return f.online[playerID] }

func (f *fakeFencer) connect(playerID int64) {
	if f.online == nil {
		f.online = map[int64]int{}
	}
	f.online[playerID] = 1
}

func ownersUnderTest(t *testing.T) (*PlayerOwners, *fakeLeaseTable, *fakeFencer, *time.Time) {
	t.Helper()
	table := newFakeLeaseTable(1000)
	fencer := &fakeFencer{}
	clock := time.Unix(1_700_000_000, 0)
	owners := newPlayerOwners(table, fencer, func() time.Time { return clock })
	// Every assembled deployment has one (service.go installs it before the
	// table is published), and without one a claim across a gap is refused —
	// which is the point of RR-20260920-09, not the subject of most tests.
	owners.Evict(&evictorStub{})
	// Likewise every assembled deployment waits for the data engine before a
	// hand-back (RR-20260926-31); by default nothing is in flight.
	owners.Projections(newProjectionStub())
	return owners, table, fencer, &clock
}

// Redis 说这把租约已经是别人的：立刻停止服务这个玩家——拒绝新事务，并断开连接。
func TestALostLeaseFencesThePlayer(t *testing.T) {
	owners, table, fencer, _ := ownersUnderTest(t)
	ctx := context.Background()
	if mine, err := owners.Claim(ctx, 42); err != nil || !mine {
		t.Fatalf("claim = %v, %v", mine, err)
	}
	if err := owners.Admit(42); err != nil {
		t.Fatalf("a freshly confirmed lease was refused: %v", err)
	}

	// The next renewal says it is somebody else's. (Not merely gone: a lease
	// that has simply lapsed is retaken, which the test below covers.)
	table.owner[42] = 1001
	owners.renew(ctx)

	if err := owners.Admit(42); !errors.Is(err, ErrLeaseNotHeld) {
		t.Fatalf("a player whose lease moved is still admitted for writes: %v", err)
	}
	if len(fencer.closed) != 1 || fencer.closed[0] != 42 {
		t.Fatalf("the player was left connected to a process that may not serve them: closed=%v", fencer.closed)
	}
	// The lease belongs to somebody else now; deleting it would delete THEIR
	// lease, so nothing was released.
	if len(table.released) != 0 {
		t.Fatalf("a fenced lease was released, which deletes the new owner's: %v", table.released)
	}
}

// 续租读不出来（Redis 挂了）：不知道 ≠ 失去。租约不被放弃，但确认的期限不再延长，
// 于是准入自己走到头——这正是"停在越界之前"和"越界之后还在写"的区别。
func TestAnUnknownRenewalRunsAdmissionOutInsteadOfPretending(t *testing.T) {
	owners, table, fencer, clock := ownersUnderTest(t)
	ctx := context.Background()
	if _, err := owners.Claim(ctx, 42); err != nil {
		t.Fatal(err)
	}
	table.refresh = func(playerID int64) playerroute.RefreshResult {
		return playerroute.RefreshResult{PlayerID: playerID, Err: errors.New("redis down")}
	}

	// Renewals keep failing while the confirmed lease still has room.
	for i := 0; i < 2; i++ {
		*clock = clock.Add(playerroute.RefreshInterval)
		owners.renew(ctx)
		if err := owners.Admit(42); err != nil {
			t.Fatalf("admission stopped while the confirmed lease still had %s left: %v", playerroute.Lease-time.Duration(i+1)*playerroute.RefreshInterval, err)
		}
	}
	if len(fencer.closed) != 0 {
		t.Fatalf("an unknown renewal disconnected the player; unknown is not lost: %v", fencer.closed)
	}

	// Past the guard band, admission must stop on its own.
	*clock = clock.Add(playerroute.Lease - 2*playerroute.RefreshInterval - AdmissionGuard + time.Second)
	if err := owners.Admit(42); !errors.Is(err, ErrLeaseNotHeld) {
		t.Fatalf("a new transaction was admitted inside the guard band: %v", err)
	}
}

// 准入必须提前于到期收口，否则一个在最后一刻被放行的事务会跨过截止时刻。
func TestAdmissionStopsOneGuardBandBeforeTheDeadline(t *testing.T) {
	owners, _, _, clock := ownersUnderTest(t)
	ctx := context.Background()
	if _, err := owners.Claim(ctx, 42); err != nil {
		t.Fatal(err)
	}
	*clock = clock.Add(playerroute.Lease - AdmissionGuard - time.Second)
	if err := owners.Admit(42); err != nil {
		t.Fatalf("refused while more than the guard band remained: %v", err)
	}
	*clock = clock.Add(2 * time.Second)
	if err := owners.Admit(42); !errors.Is(err, ErrLeaseNotHeld) {
		t.Fatalf("admitted with less than the guard band left: %v", err)
	}
}

// 没有确认过的租约就不能写，哪怕 Redis 里这个 sid 确实是持有者——那可能是前一次
// 化身留下的。
func TestASidMatchWithoutAConfirmedLeaseIsNotOwnership(t *testing.T) {
	owners, table, _, _ := ownersUnderTest(t)
	ctx := context.Background()
	table.owner[42] = 1000 // same sid, but this process never claimed it

	if err := owners.Admit(42); !errors.Is(err, ErrLeaseNotHeld) {
		t.Fatalf("a lease this process never confirmed was admitted: %v", err)
	}
	owned, err := owners.OwnedHere(ctx, 42)
	if err != nil {
		t.Fatal(err)
	}
	if owned {
		t.Fatal("OwnedHere answered yes for a lease this process cannot prove it holds")
	}
}

// 边界上的闸门：登录必须放行（它就是取得所有权的那条消息），其余一律按 Admit 判。
func TestTheWriteGateExemptsLoginAndRefusesEverythingElse(t *testing.T) {
	owners, _, _, _ := ownersUnderTest(t)
	ctx := context.Background()

	// Nothing claimed yet: only the login may run.
	if err := owners.AdmitMessage(42, msgid.MsgEnterGame); err != nil {
		t.Fatalf("login was gated on already owning the player: %v", err)
	}
	if err := owners.AdmitMessage(42, msgid.MsgAddItem); !errors.Is(err, ErrLeaseNotHeld) {
		t.Fatalf("a write was admitted for a player this process does not own: %v", err)
	}

	// After the login's claim, ordinary messages run.
	if _, err := owners.Claim(ctx, 42); err != nil {
		t.Fatal(err)
	}
	if err := owners.AdmitMessage(42, msgid.MsgAddItem); err != nil {
		t.Fatalf("a write was refused while the lease is confirmed: %v", err)
	}
}

// 租约只是"没了"（我们的续租断过一段），而没有别人接手：重新取回来，不要把租约丢掉。
// SetNX 是原子的，所以"没人拿着"这个判断和取回是同一件事。
//
// 取回和围栏的区别在租约的归属，不在连接：取回之后租约仍是这个进程的，重连落回这里；
// 围栏之后租约是别人的、本地也不再持有。连接在两条路上都会关——跨过间断的副本已经
// 扔掉，连着的会话没有场景可待（RR-20260930-23，见下面的用例）。
func TestALapsedLeaseNobodyElseTookIsRetakenInsteadOfFenced(t *testing.T) {
	owners, table, _, _ := ownersUnderTest(t)
	// Retaking means dropping the copy from before the gap, so a table that
	// can retake is a table that can forget (RR-20260920-09). This used to
	// pass without an evictor, which was the defect: the retake was treated
	// as benign.
	owners.Evict(&evictorStub{})
	ctx := context.Background()
	if _, err := owners.Claim(ctx, 42); err != nil {
		t.Fatal(err)
	}
	// The key vanished — our renewals lapsed — but nobody took the player.
	delete(table.owner, 42)
	owners.renew(ctx)

	if err := owners.Admit(42); err != nil {
		t.Fatalf("a lease that merely lapsed was not retaken: %v", err)
	}
	if table.owner[42] != 1000 {
		t.Fatalf("the table does not show this process as the owner: %v", table.owner)
	}
	if len(table.released) != 0 {
		t.Fatalf("a lease nobody else had taken was given up instead of retaken: released=%v", table.released)
	}
}

// RR-20260930-23：续租中断、租约重新取回之后，还连着的玩家不能"连接活着却脱离场景"。
//
// Claim 跨过间断时把常驻副本整个扔掉（RR-20260920-09），玩家在场景里的成员身份跟着
// 副本一起没了——可他的连接还在：此后他收不到任何帧、别人也看不到他，直到他自己
// 重新登录（真实环境里 SIGSTOP 40s 之后仍连着的观察者就是这样）。重载钩子
// （RR-20260927-23 的 OnEntityLoaded → Rebind）救不了他：这里是 Destroy，不是重载。
// 所以取回租约之后要像围栏那样关掉这个玩家的连接，让客户端重连、走正常登录重新
// 加载并进场；租约仍是这个进程的，重连就落回这里。
func TestARetakenLeaseClosesTheSessionsThatLivedThroughTheGap(t *testing.T) {
	owners, table, fencer, _ := ownersUnderTest(t)
	evictor := &evictorStub{}
	owners.Evict(evictor)
	ctx := context.Background()
	if _, err := owners.Claim(ctx, 42); err != nil {
		t.Fatal(err)
	}
	// Logged in here, and still connected when the renewals lapse.
	fencer.connect(42)
	evictor.forget()

	// The key vanished — our renewals lapsed — and nobody took the player.
	delete(table.owner, 42)
	owners.renew(ctx)

	if dropped := evictor.taken(); len(dropped) != 1 || dropped[0] != 42 {
		t.Fatalf("the copy from before the gap was kept: dropped=%v", dropped)
	}
	if len(fencer.closed) != 1 || fencer.closed[0] != 42 {
		t.Fatalf("the player's connection outlived the copy it was bound to: the stale copy was dropped, but the session stayed open and detached from the scene; closed=%v", fencer.closed)
	}
	// And the lease is still ours: the reconnect lands back here and goes
	// through an ordinary login, not a fence.
	if err := owners.Admit(42); err != nil {
		t.Fatalf("the retaken lease is not in service: %v", err)
	}
	if table.owner[42] != 1000 {
		t.Fatalf("the table does not show this process as the owner: %v", table.owner)
	}
}

// 同一条路径的另一个结局：租约在 Redis 里取回来了，副本却没能在预算内扔掉。扔副本
// 的第一步就是离开场景，所以这个玩家的场景成员身份已经（或马上要）没了，而租约没有
// 确认、每条写都被拒——连接留着同样是"活着却脱离场景"。连接照样关掉；重连的登录
// 会等那次还在进行的清除，等不到就被拒绝，客户端得到明确的答复而不是沉默。
func TestARetakeWhoseCopyCannotBeDroppedStillClosesTheSessions(t *testing.T) {
	owners, table, fencer, _ := ownersUnderTest(t)
	owners.Evict(&evictorStub{})
	ctx := context.Background()
	if _, err := owners.Claim(ctx, 42); err != nil {
		t.Fatal(err)
	}
	fencer.connect(42)
	// From here on the entity is busy and the drop runs out of budget.
	owners.Evict(&evictorStub{fail: errors.New("the entity is busy")})

	delete(table.owner, 42)
	owners.renew(ctx)

	if len(fencer.closed) != 1 || fencer.closed[0] != 42 {
		t.Fatalf("the player stayed connected to a copy this process could neither drop nor serve: closed=%v", fencer.closed)
	}
	if err := owners.Admit(42); !errors.Is(err, ErrLeaseNotHeld) {
		t.Fatalf("writes are admitted for a player whose stale copy is still resident: %v", err)
	}
}

// 关连接只属于刷新循环里的取回。登录路径的 Claim 同样跨间断（这个进程之前没有他），
// 但正在登录的那条连接就是刚登记的会话——在那里关会把登录本身关掉。
func TestAClaimAtLoginDoesNotCloseTheConnectionThatIsLoggingIn(t *testing.T) {
	owners, _, fencer, _ := ownersUnderTest(t)
	owners.Evict(&evictorStub{})
	// The login's own connection is registered before enter_game runs.
	fencer.connect(42)
	if mine, err := owners.Claim(context.Background(), 42); err != nil || !mine {
		t.Fatalf("claim = %v, %v", mine, err)
	}
	if len(fencer.closed) != 0 {
		t.Fatalf("a login-time claim closed the connection that was logging in: %v", fencer.closed)
	}
}

// evictorStub records which players this process was told to forget, and can
// refuse one.
type evictorStub struct {
	mu      sync.Mutex
	dropped []int64
	fail    error
}

func (stub *evictorStub) EvictPlayer(_ context.Context, playerID int64) error {
	stub.mu.Lock()
	defer stub.mu.Unlock()
	if stub.fail != nil {
		return stub.fail
	}
	stub.dropped = append(stub.dropped, playerID)
	return nil
}

// forget is what a test calls between the claim it does not care about and
// the one it does.
func (stub *evictorStub) forget() {
	stub.mu.Lock()
	stub.dropped = nil
	stub.mu.Unlock()
}

func (stub *evictorStub) taken() []int64 {
	stub.mu.Lock()
	defer stub.mu.Unlock()
	return append([]int64(nil), stub.dropped...)
}

// U-0268 · C8 · RR-20260920-09：租约有过间断，内存里那份副本就不能再用。
//
// An absent key has two histories — nobody ever took the player, or somebody
// took them, wrote, and their lease expired too — and the table cannot tell
// them apart. So a claim across a gap must drop whatever this process still
// has: nothing reloads a resident entity, and the document may have moved on
// without it.
func TestALeaseThatWasInterruptedDropsTheResidentCopy(t *testing.T) {
	owners, table, _, _ := ownersUnderTest(t)
	evictor := &evictorStub{}
	owners.Evict(evictor)
	ctx := context.Background()
	if _, err := owners.Claim(ctx, 42); err != nil {
		t.Fatal(err)
	}
	// The first claim is itself a claim across a gap — this process had
	// nothing before it — so it asks for the copy to be dropped and finds
	// none. What matters is the SECOND one.
	evictor.forget()

	// The key vanished: our renewals lapsed. Whether anybody else held it in
	// the meantime is exactly what cannot be known.
	delete(table.owner, 42)
	owners.renew(ctx)

	if dropped := evictor.taken(); len(dropped) != 1 || dropped[0] != 42 {
		t.Fatalf("the copy from before the gap was kept: dropped=%v", dropped)
	}
	if err := owners.Admit(42); err != nil {
		t.Fatalf("the player is not served after a clean retake: %v", err)
	}
}

// A claim this process could not make safe is not taken into service: the
// lease is left to lapse rather than used on a copy that is still there.
func TestAClaimWhoseCopyCannotBeDroppedIsNotTakenIntoService(t *testing.T) {
	owners, table, _, _ := ownersUnderTest(t)
	owners.Evict(&evictorStub{fail: errors.New("the entity is busy")})
	ctx := context.Background()
	mine, err := owners.Claim(ctx, 42)
	if mine {
		t.Fatal("the player was taken into service although the stale copy is still resident")
	}
	if err == nil {
		t.Fatal("the caller was not told why")
	}
	if err := owners.Admit(42); err == nil {
		t.Fatal("writes are admitted for a player this process could not make safe")
	}
	// The lease IS ours in Redis — nothing refreshes it, so it lapses.
	if table.owner[42] != 1000 {
		t.Fatalf("the claim did not happen at all: %v", table.owner)
	}
}

// Holding the lease without interruption keeps the resident copy: the whole
// point is that an ordinary session costs nothing.
func TestAnUninterruptedLeaseKeepsItsPlayer(t *testing.T) {
	owners, _, fencer, clock := ownersUnderTest(t)
	evictor := &evictorStub{}
	owners.Evict(evictor)
	ctx := context.Background()
	if _, err := owners.Claim(ctx, 42); err != nil {
		t.Fatal(err)
	}
	// Logged in here, so the idle hand-back (U-0269) leaves them alone and
	// this test is about the interruption rule only.
	fencer.connect(42)
	evictor.forget()
	for range 5 {
		*clock = clock.Add(playerroute.RefreshInterval)
		owners.renew(ctx)
	}
	// And a re-login while the lease never lapsed is not a gap either.
	if _, err := owners.Claim(ctx, 42); err != nil {
		t.Fatal(err)
	}
	if dropped := evictor.taken(); len(dropped) != 0 {
		t.Fatalf("a player this process never stopped owning was dropped: %v", dropped)
	}
}

// Fencing takes the copy with the sessions. Disconnecting stops this process
// being asked to do anything; it does not make the resident entity match a
// document the new owner is writing.
func TestFencingAlsoDropsTheCopy(t *testing.T) {
	owners, table, fencer, _ := ownersUnderTest(t)
	evictor := &evictorStub{}
	owners.Evict(evictor)
	ctx := context.Background()
	if _, err := owners.Claim(ctx, 42); err != nil {
		t.Fatal(err)
	}
	evictor.forget()
	table.owner[42] = 2000 // another process owns them now
	owners.renew(ctx)

	if len(fencer.closed) != 1 {
		t.Fatalf("the player was not disconnected: %v", fencer.closed)
	}
	// The eviction is not waited on, so give it a moment to land.
	deadline := time.Now().Add(2 * time.Second)
	for time.Now().Before(deadline) {
		if len(evictor.taken()) > 0 {
			return
		}
		time.Sleep(5 * time.Millisecond)
	}
	t.Fatalf("a fenced player's copy was kept: dropped=%v", evictor.taken())
}

// U-0269 · C8 · RR-20260920-10：为后台工作取得的所有权必须还回去。
//
// Ownership has to be takeable for an offline player — their mail, their saga
// steps and their paid orders cannot wait for them to log in. What it must
// not be is permanent: nothing releases it, so the first background step to
// touch an offline player used to pin them to that process for as long as it
// lived, and a login anywhere else was refused by name, forever.
func TestABackgroundClaimIsHandedBackWhenNobodyIsPlaying(t *testing.T) {
	owners, table, _, clock := ownersUnderTest(t)
	evictor := &evictorStub{}
	owners.Evict(evictor)
	ctx := context.Background()

	// A gift step for a player who is not logged in anywhere.
	owned, err := owners.Owns(ctx, 77)
	if err != nil || !owned {
		t.Fatalf("a background consumer could not take an unowned player: owned=%v err=%v", owned, err)
	}
	if table.owner[77] != 1000 {
		t.Fatalf("the claim did not happen: %v", table.owner)
	}
	// Taking a player this process did not hold is itself a claim across a
	// gap, so it already asked for a copy that is not there (U-0268). What
	// this test is about is the drop that comes with the hand-back.
	evictor.forget()
	// The step finishes; nothing else asks about this player.
	*clock = clock.Add(HandBackIdle + time.Second)
	owners.renew(ctx)

	if len(evictor.taken()) != 1 {
		t.Fatalf("the player's copy was kept: %v", evictor.taken())
	}
	if _, held := table.owner[77]; held {
		t.Fatalf("the lease was not handed back: %v", table.owner)
	}
	if err := owners.Admit(77); err == nil {
		t.Fatal("this process still admits writes for a player it gave back")
	}
}

// A player who is actually playing here keeps their lease however quiet they
// are: an idle connection is still a connection.
func TestAPlayerWithASessionIsNeverHandedBack(t *testing.T) {
	owners, table, fencer, clock := ownersUnderTest(t)
	ctx := context.Background()
	if _, err := owners.Claim(ctx, 42); err != nil {
		t.Fatal(err)
	}
	fencer.connect(42)
	for range 5 {
		*clock = clock.Add(HandBackIdle)
		owners.renew(ctx)
	}
	if table.owner[42] != 1000 {
		t.Fatalf("a connected player's lease was given away: %v", table.owner)
	}
	if err := owners.Admit(42); err != nil {
		t.Fatalf("a connected player is no longer admitted: %v", err)
	}
}

// Work in progress holds the lease: every admission is a use, so a step that
// keeps being retried is never handed back underneath itself.
func TestWorkInProgressKeepsTheLease(t *testing.T) {
	owners, table, _, clock := ownersUnderTest(t)
	ctx := context.Background()
	if owned, err := owners.Owns(ctx, 77); err != nil || !owned {
		t.Fatalf("owns: %v %v", owned, err)
	}
	for range 5 {
		*clock = clock.Add(HandBackIdle - time.Second)
		if owned, err := owners.Owns(ctx, 77); err != nil || !owned {
			t.Fatalf("the background consumer lost the player mid-work: %v %v", owned, err)
		}
		owners.renew(ctx)
	}
	if table.owner[77] != 1000 {
		t.Fatalf("a lease doing work was handed back: %v", table.owner)
	}
}

// The copy goes first and the claim second, never the other way round:
// releasing while the entity is still resident is what invites a second copy
// of it in another process (U-0259).
func TestAHandBackThatCannotDropTheCopyKeepsTheLease(t *testing.T) {
	owners, table, _, clock := ownersUnderTest(t)
	ctx := context.Background()
	if owned, err := owners.Owns(ctx, 77); err != nil || !owned {
		t.Fatalf("owns: %v %v", owned, err)
	}
	// The entity becomes unavailable AFTER the claim: a transaction is on it
	// when the hand-back comes round.
	owners.Evict(&evictorStub{fail: errors.New("the entity is busy")})
	*clock = clock.Add(HandBackIdle + time.Second)
	owners.renew(ctx)

	if table.owner[77] != 1000 {
		t.Fatalf("the claim was given back although this process still holds the player: %v", table.owner)
	}
}

// U-0271 · C8 · RR-20260920-11：为新工作重新取得的租约不是空闲租约。
//
// `confirm` used to serve two different events through one `IsZero` guard: a
// renewal (which must NOT count as use, or no lease would ever look idle) and
// a fresh claim (which must, because work is about to start). A lease retaken
// after its window expired therefore kept the timestamp of the work before
// it, and the very next refresh pass handed it back — out from under the step
// it had just admitted.
func TestALeaseRetakenForNewWorkIsNotIdle(t *testing.T) {
	owners, table, _, clock := ownersUnderTest(t)
	ctx := context.Background()

	// T0: a background step claims an offline player.
	if owned, err := owners.Owns(ctx, 77); err != nil || !owned {
		t.Fatalf("owns: %v %v", owned, err)
	}
	// The confirmed window runs out and the key expires with it: from here
	// Admit refuses, so the next Owns has to go and retake the lease.
	*clock = clock.Add(playerroute.Lease + time.Second)
	delete(table.owner, 77)

	// T1: new work arrives and is admitted.
	if owned, err := owners.Owns(ctx, 77); err != nil || !owned {
		t.Fatalf("the new step was refused: %v %v", owned, err)
	}
	// The refresh pass that follows, with that step still running.
	owners.renew(ctx)

	if _, held := table.owner[77]; !held {
		t.Fatalf("the lease was handed back under the step it had just admitted: %v", table.owner)
	}
	if err := owners.Admit(77); err != nil {
		t.Fatalf("the step lost its admission mid-work: %v", err)
	}
}

// A renewal is not use: if it were, no lease would ever look idle and the
// hand-back would never happen at all.
func TestRenewalsDoNotCountAsUse(t *testing.T) {
	owners, table, _, clock := ownersUnderTest(t)
	ctx := context.Background()
	if owned, err := owners.Owns(ctx, 77); err != nil || !owned {
		t.Fatalf("owns: %v %v", owned, err)
	}
	// Refresh passes keep confirming the lease, but nobody asks for the
	// player. Each pass is well inside HandBackIdle, so only the accumulated
	// time can make it idle.
	for range 4 {
		*clock = clock.Add(playerroute.RefreshInterval)
		owners.renew(ctx)
	}
	if _, held := table.owner[77]; held {
		t.Fatalf("a lease nothing has used was renewed forever: %v", table.owner)
	}
}

// While a hand-back is in flight the lease admits nothing. Between dropping
// the copy and releasing the claim there is a window where the old code still
// said yes, and work admitted in it would load a fresh copy of a player this
// process is about to give away.
func TestAHandBackInFlightAdmitsNothing(t *testing.T) {
	owners, _, _, clock := ownersUnderTest(t)
	ctx := context.Background()
	// Armed only for the hand-back: a claim evicts too (RR-20260920-09), and
	// that one says no for a different reason — there is no lease yet.
	armed := false
	var duringHandBack []error
	owners.Evict(evictorFunc(func(_ context.Context, playerID int64) error {
		if armed {
			duringHandBack = append(duringHandBack, owners.Admit(playerID))
		}
		return nil
	}))
	if owned, err := owners.Owns(ctx, 77); err != nil || !owned {
		t.Fatalf("owns: %v %v", owned, err)
	}
	*clock = clock.Add(HandBackIdle + time.Second)
	armed = true
	owners.renew(ctx)
	armed = false

	if len(duringHandBack) != 1 {
		t.Fatalf("the hand-back did not evict exactly once: %v", duringHandBack)
	}
	if duringHandBack[0] == nil {
		t.Fatal("work was admitted while the player was being handed back")
	}
}

// A hand-back that could not complete leaves the lease in service rather than
// in a state that refuses everything.
func TestAFailedHandBackPutsTheLeaseBackInService(t *testing.T) {
	owners, table, _, clock := ownersUnderTest(t)
	ctx := context.Background()
	if owned, err := owners.Owns(ctx, 77); err != nil || !owned {
		t.Fatalf("owns: %v %v", owned, err)
	}
	owners.Evict(&evictorStub{fail: errors.New("the entity is busy")})
	*clock = clock.Add(HandBackIdle + time.Second)
	owners.renew(ctx)

	if table.owner[77] != 1000 {
		t.Fatalf("the claim was given back although the copy is still here: %v", table.owner)
	}
	if err := owners.Admit(77); err != nil {
		t.Fatalf("the lease stayed closed after a hand-back that did not happen: %v", err)
	}
}

// evictorFunc adapts a function to residentEvictor.
type evictorFunc func(context.Context, int64) error

func (fn evictorFunc) EvictPlayer(ctx context.Context, playerID int64) error {
	return fn(ctx, playerID)
}

// blockingEvictor holds the eviction until a test lets it go, the way a
// transaction on the entity holds EntityManager.Destroy — which waits for the
// entity's mutex and does not look at a context.
type blockingEvictor struct {
	release chan struct{}
	calls   chan int64
}

func newBlockingEvictor() *blockingEvictor {
	return &blockingEvictor{release: make(chan struct{}), calls: make(chan int64, 8)}
}

func (e *blockingEvictor) EvictPlayer(_ context.Context, playerID int64) error {
	e.calls <- playerID
	<-e.release
	return nil
}

// U-0272 · C8 · RR-20260920-12：撤离的预算只能限制"等多久"，那就让它限制等待。
//
// The wait used to be a ctx timeout around a call that ends in
// EntityManager.Destroy, which waits on the entity's mutex without reading
// ctx — so it bounded nothing, and a busy entity sat on the refresh loop with
// every other player's renewal behind it.
func TestAClaimWaitsAtMostTheBudgetForABusyEntity(t *testing.T) {
	owners, table, _, _ := ownersUnderTest(t)
	owners.evictWait = 50 * time.Millisecond
	evictor := newBlockingEvictor()
	owners.Evict(evictor)
	t.Cleanup(func() { close(evictor.release) })
	ctx := context.Background()

	start := time.Now()
	mine, err := owners.Claim(ctx, 42)
	elapsed := time.Since(start)

	if elapsed > time.Second {
		t.Fatalf("the claim waited %s for a budget of %s", elapsed, owners.evictWait)
	}
	if mine || err == nil {
		t.Fatalf("a player whose copy is still resident was taken into service: mine=%v err=%v", mine, err)
	}
	if err := owners.Admit(42); err == nil {
		t.Fatal("writes are admitted for a player this process could not make safe")
	}
	// The claim did happen in Redis; nothing refreshes it, so it lapses.
	if table.owner[42] != 1000 {
		t.Fatalf("the claim did not happen at all: %v", table.owner)
	}
}

// RR-20261001-07：认领成功但副本扔不掉的玩家，下一次心跳的续租不能把他"续"回服务。
//
// 刷新循环取回租约、副本却没能在预算内扔掉之后，租约在 Redis 里是这个进程的，但没有
// 确认：Admit 拒绝，连接已关（RR-20260930-23）。这时他的本地状态若还留在续期集合
// 里，下一次心跳的 Refresh（用自己的 token 续）会被告知 Held，confirmRenewal 把
// interrupted 清掉、把 validUntil 往后推——于是 Admit 对那份还没销毁的 stale 副本
// 放行，RR-20260920-09 整个契约被续租绕过。承诺：没被取回服务的租约不续、不确认；
// 恢复点只有一个——下一次 Claim 等到那次清除做完（或发现已无常驻副本）再确认。
func TestAClaimWhoseCopyCannotBeDroppedIsNotRevivedByTheNextRenewal(t *testing.T) {
	owners, table, fencer, clock := ownersUnderTest(t)
	owners.evictWait = 50 * time.Millisecond
	ctx := context.Background()
	if _, err := owners.Claim(ctx, 42); err != nil {
		t.Fatal(err)
	}
	fencer.connect(42)
	// From here on the entity is busy: the drop starts, and does not finish
	// within the budget.
	evictor := newBlockingEvictor()
	owners.Evict(evictor)

	// The key vanished — our renewals lapsed — and nobody took the player.
	// The pass retakes the lease in Redis, cannot drop the copy, and leaves
	// the player out of service.
	delete(table.owner, 42)
	owners.renew(ctx)
	if table.owner[42] != 1000 {
		t.Fatalf("the re-claim did not happen at all: %v", table.owner)
	}
	if err := owners.Admit(42); !errors.Is(err, ErrLeaseNotHeld) {
		t.Fatalf("writes are admitted right after a retake whose copy is still resident: %v", err)
	}

	// The next heartbeat. Redis still shows the lease as ours — the re-claim
	// did happen — so a refresh that asks about this player is told Held.
	var asked []int64
	table.refresh = func(playerID int64) playerroute.RefreshResult {
		asked = append(asked, playerID)
		return playerroute.RefreshResult{PlayerID: playerID, Held: table.owner[playerID] == table.sid}
	}
	*clock = clock.Add(playerroute.RefreshInterval)
	owners.renew(ctx)

	if err := owners.Admit(42); !errors.Is(err, ErrLeaseNotHeld) {
		t.Fatalf("the next renewal put the player back in service while the stale copy is still resident: %v", err)
	}
	for _, playerID := range asked {
		if playerID == 42 {
			t.Fatalf("the lease of a player this process is not serving was renewed: refreshed=%v", asked)
		}
	}
	// And the local window was not extended: the lease is left to lapse,
	// exactly as if the process had died holding it.
	*clock = clock.Add(playerroute.Lease)
	if err := owners.Admit(42); !errors.Is(err, ErrLeaseNotHeld) {
		t.Fatalf("the lease was extended for a player this process is not serving: %v", err)
	}

	// Recovery: once the entity is free the drop completes, and the next
	// login's Claim — which joins or re-runs the drop — is served by it.
	close(evictor.release)
	deadline := time.Now().Add(2 * time.Second)
	for time.Now().Before(deadline) {
		mine, err := owners.Claim(ctx, 42)
		if mine && err == nil {
			if err := owners.Admit(42); err != nil {
				t.Fatalf("the player is not served after the drop finally completed: %v", err)
			}
			return
		}
		time.Sleep(5 * time.Millisecond)
	}
	t.Fatal("the player was never taken into service after the entity was released")
}

// A second caller joins the eviction already in flight instead of starting a
// second one — which is also what keeps a claim from being confirmed while an
// older drop of the same player is still running.
func TestASecondDropJoinsTheOneAlreadyRunning(t *testing.T) {
	owners, _, _, _ := ownersUnderTest(t)
	owners.evictWait = 50 * time.Millisecond
	evictor := newBlockingEvictor()
	owners.Evict(evictor)
	ctx := context.Background()

	for range 3 {
		if _, err := owners.Claim(ctx, 42); err == nil {
			t.Fatal("the claim succeeded although the eviction never finished")
		}
	}
	if len(evictor.calls) != 1 {
		t.Fatalf("the eviction was started %d times", len(evictor.calls))
	}

	// Once the entity is free the drop completes, and the next claim is
	// served by it.
	close(evictor.release)
	deadline := time.Now().Add(2 * time.Second)
	for time.Now().Before(deadline) {
		mine, err := owners.Claim(ctx, 42)
		if mine && err == nil {
			return
		}
		time.Sleep(5 * time.Millisecond)
	}
	t.Fatal("the player was never taken into service after the entity was released")
}

// The refresh loop keeps its cadence: one busy entity costs a bounded wait,
// not everybody else's lease.
func TestOneBusyEntityDoesNotHoldUpTheRefreshLoop(t *testing.T) {
	owners, table, _, _ := ownersUnderTest(t)
	owners.evictWait = 50 * time.Millisecond
	evictor := newBlockingEvictor()
	owners.Evict(evictor)
	t.Cleanup(func() { close(evictor.release) })
	ctx := context.Background()

	// Two players held here; one of them will need an eviction it cannot get.
	owners.Evict(&evictorStub{})
	if _, err := owners.Claim(ctx, 42); err != nil {
		t.Fatal(err)
	}
	if _, err := owners.Claim(ctx, 43); err != nil {
		t.Fatal(err)
	}
	owners.Evict(evictor)
	delete(table.owner, 42) // 42's lease lapsed: the pass will try to retake it

	start := time.Now()
	owners.renew(ctx)
	if elapsed := time.Since(start); elapsed > time.Second {
		t.Fatalf("one busy entity held the refresh pass for %s", elapsed)
	}
	// And the other player's lease was renewed by that same pass.
	if err := owners.Admit(43); err != nil {
		t.Fatalf("a bystander lost their lease to somebody else's busy entity: %v", err)
	}
}

// projectionStub is this process's write-ahead log as a hand-back sees it:
// a player's committed writes are either still on their way to Mongo, failed
// to get there, or landed.
type projectionStub struct {
	mu      sync.Mutex
	landed  chan struct{}
	failure error
	asked   []int64
}

// newProjectionStub has nothing in flight.
func newProjectionStub() *projectionStub {
	landed := make(chan struct{})
	close(landed)
	return &projectionStub{landed: landed}
}

// inFlight puts writes on the way; the returned func lands them.
func (stub *projectionStub) inFlight() func() {
	stub.mu.Lock()
	defer stub.mu.Unlock()
	landed := make(chan struct{})
	stub.landed = landed
	return sync.OnceFunc(func() { close(landed) })
}

func (stub *projectionStub) fail(err error) {
	stub.mu.Lock()
	stub.failure = err
	stub.mu.Unlock()
}

func (stub *projectionStub) WaitPlayerProjection(ctx context.Context, playerID int64) error {
	stub.mu.Lock()
	stub.asked = append(stub.asked, playerID)
	landed, failure := stub.landed, stub.failure
	stub.mu.Unlock()
	if failure != nil {
		return failure
	}
	select {
	case <-landed:
		return nil
	case <-ctx.Done():
		return ctx.Err()
	}
}

// RR-20260926-31：闲置交还要等本进程已提交的写入落库，再交出租约。
//
// 下一个所有者只从 Mongo 读取玩家。驱逐忘掉的是内存副本，但这份副本提交过的事务
// 可能还在本进程 WAL 里等待投影；此时释放租约，另一进程会装载落后的文档，两边的
// 版本计数在投影时撞成 fatal。旧实现驱逐后立刻 Release，这里投影未完成（等待超时
// 或投影失败）时租约必须保留并留给下一轮重试；投影完成后才交还。
func TestAHandBackWaitsForThePlayersWritesToReachTheDatabase(t *testing.T) {
	owners, table, _, clock := ownersUnderTest(t)
	projections := newProjectionStub()
	owners.Projections(projections)
	owners.projectionWait = 20 * time.Millisecond
	ctx := context.Background()
	if owned, err := owners.Owns(ctx, 77); err != nil || !owned {
		t.Fatalf("owns: %v %v", owned, err)
	}
	// The step committed a write that is still in the log when the lease
	// goes idle.
	land := projections.inFlight()
	defer land()
	*clock = clock.Add(HandBackIdle + time.Second)
	owners.renew(ctx)
	if table.owner[77] != 1000 || len(table.released) != 0 {
		t.Fatalf("the lease was handed back while the player's writes were still on their way to the database: owner=%v released=%v", table.owner, table.released)
	}
	if err := owners.Admit(77); err != nil {
		t.Fatalf("a hand-back that did not happen left the lease out of service: %v", err)
	}

	// A projection that fails is not a projection that landed either.
	projections.fail(errors.New("projection failed"))
	*clock = clock.Add(HandBackIdle + time.Second)
	owners.renew(ctx)
	if table.owner[77] != 1000 || len(table.released) != 0 {
		t.Fatalf("the lease was handed back after the projection failed: owner=%v released=%v", table.owner, table.released)
	}

	// Once the writes are in Mongo the next pass hands the lease back.
	projections.fail(nil)
	land()
	*clock = clock.Add(HandBackIdle + time.Second)
	owners.renew(ctx)
	if _, held := table.owner[77]; held || len(table.released) != 1 {
		t.Fatalf("the lease was not handed back once the writes had landed: owner=%v released=%v", table.owner, table.released)
	}
	projections.mu.Lock()
	asked := len(projections.asked)
	projections.mu.Unlock()
	if asked != 3 {
		t.Fatalf("hand-back asked about the projection %d times, want once per pass (3)", asked)
	}
}

// RR-20260921-03：归还进行到一半时同一玩家登录，Claim 的回答必须与共享表一致。
//
// 闲置归还在选中玩家的那把锁里置 handingBack，然后撤离副本、等投影落库、Release。
// 旧实现里 Claim 不看 handingBack：只把 Admit 当"是否连续持有"的探针，此时 Redis
// 里的认领还是本进程的，store.Claim 回答 ours，confirmClaim 再把 handingBack 清掉；
// 归还流程随后不回头确认，无条件 Release——登录方拿到 mine=true，共享表里却已无人
// 拥有这个玩家，另一个进程可以合法地装载第二份副本。两种交错都出现过：确认先于
// Release（admitted=false，玩家登录成功却每条消息被拒），Release 先于确认
// （admitted=true，本进程放行写入而 Redis 无主）。
//
// 承诺：Claim 返回 mine=true 时，共享表里这个玩家归本进程、本地准入放行；归还进行中
// 的 Claim 等这次归还结束再决定（受调用方 ctx 约束），归还不会在它脚下 Release。

type claimAnswer struct {
	mine bool
	err  error
}

func claimInBackground(ctx context.Context, owners *PlayerOwners, playerID int64) <-chan claimAnswer {
	answered := make(chan claimAnswer, 1)
	go func() {
		mine, err := owners.Claim(ctx, playerID)
		answered <- claimAnswer{mine, err}
	}()
	return answered
}

// parkedOnHandBack is closed when a Claim of the player starts waiting for
// the hand-back in progress.
func parkedOnHandBack(owners *PlayerOwners, playerID int64) <-chan struct{} {
	parked := make(chan struct{})
	var once sync.Once
	owners.onHandBackWait = func(waiting int64) {
		if waiting == playerID {
			once.Do(func() { close(parked) })
		}
	}
	return parked
}

// waitAsked returns once the hand-back has reached the projection wait for
// the player: the copy is gone and the release is still to come.
func waitAsked(t *testing.T, stub *projectionStub, playerID int64) {
	t.Helper()
	deadline := time.Now().Add(2 * time.Second)
	for time.Now().Before(deadline) {
		stub.mu.Lock()
		for _, asked := range stub.asked {
			if asked == playerID {
				stub.mu.Unlock()
				return
			}
		}
		stub.mu.Unlock()
		time.Sleep(time.Millisecond)
	}
	t.Fatalf("the hand-back never reached the projection wait for %d", playerID)
}

// handBackHeldAtTheProjectionWait owns 77 through a background claim, lets it
// go idle and starts a refresh pass whose hand-back stops after the copy was
// dropped and before the release. The returned func lets the writes land; the
// channel closes when the pass is over.
func handBackHeldAtTheProjectionWait(t *testing.T, owners *PlayerOwners, clock *time.Time) (land func(), renewed <-chan struct{}) {
	t.Helper()
	projections := newProjectionStub()
	owners.Projections(projections)
	owners.projectionWait = time.Minute
	ctx := context.Background()
	if owned, err := owners.Owns(ctx, 77); err != nil || !owned {
		t.Fatalf("owns: %v %v", owned, err)
	}
	land = projections.inFlight()
	t.Cleanup(land)
	*clock = clock.Add(HandBackIdle + time.Second)
	done := make(chan struct{})
	go func() { defer close(done); owners.renew(ctx) }()
	waitAsked(t, projections, 77)
	return land, done
}

func requireClaimMatchesTheTable(t *testing.T, owners *PlayerOwners, table *fakeLeaseTable, playerID int64, got claimAnswer) {
	t.Helper()
	held := table.owner[playerID] == table.sid
	admitted := owners.Admit(playerID) == nil
	t.Logf("mine=%v err=%v admitted=%v redis_owner_held=%v released=%v", got.mine, got.err, admitted, held, table.released)
	if got.mine && !held {
		t.Fatalf("Claim reported mine=true, but the shared table has no owner for %d (another process may load a second copy): admitted=%v released=%v", playerID, admitted, table.released)
	}
	if got.mine && !admitted {
		t.Fatalf("Claim reported mine=true, but this process refuses the player's writes: released=%v", table.released)
	}
	// Nobody else wants this player, so the login must end up served.
	if !got.mine || got.err != nil {
		t.Fatalf("a login during a hand-back was not taken into service: mine=%v err=%v", got.mine, got.err)
	}
}

func TestAClaimDuringAHandBackNeverEndsWithAnUnownedPlayer(t *testing.T) {
	// The claim would be confirmed while the hand-back waits for the
	// projection, and the release would come after it.
	t.Run("confirm-before-release", func(t *testing.T) {
		owners, table, _, clock := ownersUnderTest(t)
		parked := parkedOnHandBack(owners, 77)
		land, renewed := handBackHeldAtTheProjectionWait(t, owners, clock)

		answered := claimInBackground(context.Background(), owners, 77)
		var got claimAnswer
		select {
		case <-parked: // waiting for the hand-back to finish
			land()
			<-renewed
			got = <-answered
		case got = <-answered: // answered inside the window
			land()
			<-renewed
		}
		requireClaimMatchesTheTable(t, owners, table, 77, got)
	})

	// The claim's store.Claim answers "ours" inside the window, and its own
	// drop of the copy is still running when the hand-back releases.
	t.Run("release-before-confirm", func(t *testing.T) {
		owners, table, _, clock := ownersUnderTest(t)
		parked := parkedOnHandBack(owners, 77)
		// Evictions: the background claim's (finds nothing), the hand-back's,
		// then the login claim's, which is held until the test lets it go.
		var calls atomic.Int32
		claimDropStarted := make(chan struct{})
		letClaimDropFinish := make(chan struct{})
		owners.Evict(evictorFunc(func(context.Context, int64) error {
			if calls.Add(1) == 3 {
				close(claimDropStarted)
				<-letClaimDropFinish
			}
			return nil
		}))
		land, renewed := handBackHeldAtTheProjectionWait(t, owners, clock)

		answered := claimInBackground(context.Background(), owners, 77)
		select {
		case <-parked:
		case <-claimDropStarted: // store.Claim already answered "ours"
		}
		land()
		<-renewed
		close(letClaimDropFinish)
		requireClaimMatchesTheTable(t, owners, table, 77, <-answered)
	})

	// The hand-back gives up (the copy could not be dropped): the lease stays
	// in service, and the claim that waited for it is served by it — after
	// joining the drop, because a copy a hand-back started to drop is not a
	// copy to keep serving.
	t.Run("hand-back-gives-up", func(t *testing.T) {
		owners, table, _, clock := ownersUnderTest(t)
		owners.evictWait = time.Minute
		parked := parkedOnHandBack(owners, 77)
		ctx := context.Background()
		if owned, err := owners.Owns(ctx, 77); err != nil || !owned {
			t.Fatalf("owns: %v %v", owned, err)
		}
		handBackDropStarted := make(chan struct{})
		letHandBackDropFail := make(chan struct{})
		var calls atomic.Int32
		owners.Evict(evictorFunc(func(context.Context, int64) error {
			if calls.Add(1) == 1 {
				close(handBackDropStarted)
				<-letHandBackDropFail
				return errors.New("the entity is busy")
			}
			return nil
		}))
		*clock = clock.Add(HandBackIdle + time.Second)
		renewed := make(chan struct{})
		go func() { defer close(renewed); owners.renew(ctx) }()
		<-handBackDropStarted

		answered := claimInBackground(ctx, owners, 77)
		<-parked
		close(letHandBackDropFail)
		<-renewed
		requireClaimMatchesTheTable(t, owners, table, 77, <-answered)
		if len(table.released) != 0 {
			t.Fatalf("a hand-back that gave up released the claim: %v", table.released)
		}
		if calls.Load() != 2 {
			t.Fatalf("the claim that waited did not drop the copy the hand-back had started on: evictions=%d", calls.Load())
		}
	})

	// The wait belongs to the caller: a login whose budget runs out gets an
	// error it can tell apart (login_timeout), and the hand-back carries on.
	t.Run("the-wait-ends-with-the-callers-context", func(t *testing.T) {
		owners, table, _, clock := ownersUnderTest(t)
		parked := parkedOnHandBack(owners, 77)
		land, renewed := handBackHeldAtTheProjectionWait(t, owners, clock)

		ctx, cancel := context.WithCancel(context.Background())
		answered := claimInBackground(ctx, owners, 77)
		<-parked
		cancel()
		got := <-answered
		if got.mine || !errors.Is(got.err, context.Canceled) {
			t.Fatalf("a claim whose caller gave up waiting answered mine=%v err=%v, want the caller's context error", got.mine, got.err)
		}
		land()
		<-renewed
		if _, held := table.owner[77]; held || len(table.released) != 1 {
			t.Fatalf("the hand-back did not complete after the waiting claim gave up: owner=%v released=%v", table.owner, table.released)
		}
		// And the claim that gave up does not keep the next one out.
		if mine, err := owners.Claim(context.Background(), 77); !mine || err != nil {
			t.Fatalf("a later login was not served: mine=%v err=%v", mine, err)
		}
	})
}

// RR-20260921-04：一次刷新回合里，闲置归还占住刷新循环的时间必须短于
// Lease − RefreshInterval。
//
// 归还跑在续租的那条 goroutine 上。旧实现只按"个数"收界：至多 handBackBudget(8)
// 人，每人撤离等 evictBudget(5s)，再加一份投影等待——最坏 45s，超过 Lease(30s)。
// 续租刚在回合之前发过一次，回合期间不再续，本进程其余每一把租约都会在 Redis 里
// 过期、准入先行耗尽。承诺：整个回合有一个时间预算，撤离与投影等待都在预算内；
// 预算用完时没轮到的玩家留到下一轮——租约保留、继续服务，不 Release。
//
// 时间用表自己的时钟记账：每次撤离把时钟拨过一整份 evictBudget 再失败，正是一个
// 卡在长事务后面的实体让刷新循环付出的代价。
func TestAHandBackPassHoldsTheRefreshLoopLessThanTheLeaseAllows(t *testing.T) {
	owners, table, _, clock := ownersUnderTest(t)
	ctx := context.Background()
	const players = handBackBudget + 2
	for playerID := int64(1); playerID <= players; playerID++ {
		if owned, err := owners.Owns(ctx, playerID); err != nil || !owned {
			t.Fatalf("owns %d: %v %v", playerID, owned, err)
		}
	}
	var (
		mu      sync.Mutex
		evicted []int64
	)
	owners.Evict(evictorFunc(func(_ context.Context, playerID int64) error {
		mu.Lock()
		defer mu.Unlock()
		*clock = clock.Add(evictBudget)
		evicted = append(evicted, playerID)
		return errors.New("the entity is busy")
	}))
	*clock = clock.Add(HandBackIdle + time.Second)
	start := *clock
	owners.renew(ctx)
	held := clock.Sub(start)

	mu.Lock()
	started := len(evicted)
	mu.Unlock()
	if limit := playerroute.Lease - playerroute.RefreshInterval; held >= limit {
		t.Errorf("one hand-back pass held the refresh loop for %s (%d evictions at evictBudget %s each), not below Lease(%s) - RefreshInterval(%s) = %s",
			held, started, evictBudget, playerroute.Lease, playerroute.RefreshInterval, limit)
	}
	// Every player the pass did not give back keeps the lease and stays in
	// service: the next pass considers them again.
	for playerID := int64(1); playerID <= players; playerID++ {
		if table.owner[playerID] != table.sid {
			t.Fatalf("player %d's lease was given away by a pass that did not hand it back: %v", playerID, table.owner)
		}
		if err := owners.Admit(playerID); err != nil {
			t.Fatalf("player %d is out of service after the pass: %v", playerID, err)
		}
	}
	if len(table.released) != 0 {
		t.Fatalf("a pass whose evictions all failed released claims: %v", table.released)
	}
}

// The budget itself, as relations between the constants: change any of them
// and this decides again. Below Lease − RefreshInterval so the pass ends
// before a lease renewed one interval ago runs out; at least one eviction
// budget, or no hand-back could ever complete.
func TestTheHandBackPassBudgetFitsInsideTheLease(t *testing.T) {
	if limit := playerroute.Lease - playerroute.RefreshInterval; handBackPassBudget >= limit {
		t.Errorf("handBackPassBudget = %s, not below Lease(%s) - RefreshInterval(%s) = %s", handBackPassBudget, playerroute.Lease, playerroute.RefreshInterval, limit)
	}
	if handBackPassBudget < evictBudget {
		t.Errorf("handBackPassBudget = %s is less than one evictBudget (%s): a busy entity would use up every pass", handBackPassBudget, evictBudget)
	}
}

// The budget also ends the real waits, not only the accounting: evictions
// that never finish stop holding the pass when its budget runs out. Scaled
// down — an eviction wait of 100ms against a pass of 150ms — so the shipped
// count (8 x 100ms) and the budget are far apart.
func TestAHandBackPassStopsWaitingWhenItsBudgetRunsOut(t *testing.T) {
	owners, table, _, clock := ownersUnderTest(t)
	owners.evictWait = 100 * time.Millisecond
	owners.handBackPassWait = 150 * time.Millisecond
	ctx := context.Background()
	const players = handBackBudget + 2
	for playerID := int64(1); playerID <= players; playerID++ {
		if owned, err := owners.Owns(ctx, playerID); err != nil || !owned {
			t.Fatalf("owns %d: %v %v", playerID, owned, err)
		}
	}
	evictor := newBlockingEvictor()
	evictor.calls = make(chan int64, 64)
	owners.Evict(evictor)
	t.Cleanup(func() { close(evictor.release) })
	*clock = clock.Add(HandBackIdle + time.Second)

	start := time.Now()
	owners.renew(ctx)
	elapsed := time.Since(start)
	if unbudgeted := time.Duration(handBackBudget) * owners.evictWait; elapsed >= unbudgeted/2 {
		t.Fatalf("the pass held the refresh loop for %s with a budget of %s (without one it would be %s)", elapsed, owners.handBackPassWait, unbudgeted)
	}
	inService := 0
	for playerID := int64(1); playerID <= players; playerID++ {
		if table.owner[playerID] != table.sid {
			t.Fatalf("player %d's lease was given away by a pass that did not hand it back: %v", playerID, table.owner)
		}
		// The players the pass reached have a drop that never finishes:
		// they keep the lease, and stay out of service until the drop ends
		// (RR-20261004-11). Everybody else is in service.
		err := owners.Admit(playerID)
		if dropRunning(owners, playerID) {
			if !errors.Is(err, ErrLeaseNotHeld) {
				t.Fatalf("player %d is admitted while the drop the pass started is still running: %v", playerID, err)
			}
			continue
		}
		if err != nil {
			t.Fatalf("player %d is out of service after the pass: %v", playerID, err)
		}
		inService++
	}
	if inService == 0 {
		t.Fatal("the pass reached every player; nobody was left for the next pass")
	}
}

// RR-20261004-11：归还的撤离等超时、租约回到服务之后，后台那次撤离还在销毁实体——
// 在它结束之前，谁都不能被放行到这份副本上。
//
// 撤离不可取消（RR-20260920-12）：归还等满 evictWait 就放弃、租约留在服务，而撤离在
// 后台继续，最后把实体 Destroy 掉。旧实现在这段时间里 Admit 照常放行：后台消费者
// （Owns → Admitted）的事务落在一份即将被销毁的副本上；登录的 Claim 看 Admit 通过就
// 当作"没有间断"、不扔副本，直接确认——登录随后取到这份常驻实体、进场，然后被晚到
// 的 Destroy 从脚下拿走（RR-20260921-03 只让"等过归还"的 Claim 加入撤离，归还已经
// 结束才到的登录不在其列）。承诺：撤离进行中 Admit 拒绝；登录的 Claim 因此跨间断、
// 加入那次撤离，等不到就不确认；恢复点是撤离真正结束——租约一直是本进程的、照常
// 续租，结束后自动回到服务（副本已没了就冷加载），不需要谁重新认领。
func TestAHandBackWhoseDropOutlivesItsWaitAdmitsNothingUntilTheDropEnds(t *testing.T) {
	// The hand-back of an idle background claim gives up on the drop after
	// evictWait; the drop itself is still running when this returns.
	handBackGaveUp := func(t *testing.T) (owners *PlayerOwners, table *fakeLeaseTable, clock *time.Time, endDrop func()) {
		t.Helper()
		owners, table, _, clock = ownersUnderTest(t)
		owners.evictWait = 50 * time.Millisecond
		ctx := context.Background()
		if owned, err := owners.Owns(ctx, 77); err != nil || !owned {
			t.Fatalf("owns: %v %v", owned, err)
		}
		evictor := newBlockingEvictor()
		owners.Evict(evictor)
		var once sync.Once
		endDrop = func() { once.Do(func() { close(evictor.release) }) }
		t.Cleanup(endDrop)
		*clock = clock.Add(HandBackIdle + time.Second)
		owners.renew(ctx)
		select {
		case <-evictor.calls:
		default:
			t.Fatal("the hand-back never started the drop")
		}
		if !dropRunning(owners, 77) || table.owner[77] != table.sid || len(table.released) != 0 {
			t.Fatalf("precondition: the drop should still be running and the lease kept: running=%v owner=%v released=%v",
				dropRunning(owners, 77), table.owner, table.released)
		}
		return owners, table, clock, endDrop
	}

	t.Run("background-work", func(t *testing.T) {
		owners, table, clock, endDrop := handBackGaveUp(t)
		if err := owners.Admit(77); err == nil {
			t.Fatal("Admit let work start on player 77 while the hand-back's drop is still destroying the copy in the background")
		}
		if owned, err := owners.Owns(context.Background(), 77); owned || err != nil {
			t.Fatalf("a background consumer was told it owns player 77 while the copy is being destroyed: owned=%v err=%v", owned, err)
		}
		// The lease is not given up meanwhile: the next pass renews it.
		var asked []int64
		table.refresh = func(playerID int64) playerroute.RefreshResult {
			asked = append(asked, playerID)
			return playerroute.RefreshResult{PlayerID: playerID, Held: table.owner[playerID] == table.sid}
		}
		*clock = clock.Add(playerroute.RefreshInterval)
		owners.renew(context.Background())
		if len(asked) != 1 || asked[0] != 77 || table.owner[77] != table.sid {
			t.Fatalf("the lease of a player whose drop is running was not renewed: refreshed=%v owner=%v", asked, table.owner)
		}
		if err := owners.Admit(77); err == nil {
			t.Fatal("the next pass put player 77 back in service while the drop is still running")
		}
		// The drop ends: that is the point the player comes back, with no
		// re-claim needed — the lease never left this process.
		endDrop()
		waitDropEnded(t, owners, 77)
		if err := owners.Admit(77); err != nil {
			t.Fatalf("player 77 did not come back into service when the drop ended: %v", err)
		}
	})

	t.Run("login", func(t *testing.T) {
		owners, _, _, endDrop := handBackGaveUp(t)
		mine, err := owners.Claim(context.Background(), 77)
		if mine && dropRunning(owners, 77) {
			t.Fatalf("a login was taken into service (mine=%v err=%v) on a copy whose drop is still running; it would load and join an entity the drop then destroys", mine, err)
		}
		if mine || !errors.Is(err, errStaleCopyKept) {
			t.Fatalf("a login during the drop answered mine=%v err=%v, want the drop's refusal", mine, err)
		}
		// The lease had no gap, so the refused login does not make this
		// process forget it (abandon is for a lease that did): it is still
		// renewed, and the player comes back when the drop ends.
		owners.mu.Lock()
		kept := owners.local[77] != nil
		owners.mu.Unlock()
		if !kept {
			t.Fatal("a login that could not wait for the drop made this process forget a lease it never stopped holding")
		}
		// Once the drop has ended, the next login is served.
		endDrop()
		waitDropEnded(t, owners, 77)
		if mine, err := owners.Claim(context.Background(), 77); !mine || err != nil {
			t.Fatalf("a login after the drop ended was not served: mine=%v err=%v", mine, err)
		}
		if err := owners.Admit(77); err != nil {
			t.Fatalf("player 77 is not in service after the login: %v", err)
		}
	})
}

func dropRunning(owners *PlayerOwners, playerID int64) bool {
	owners.mu.Lock()
	defer owners.mu.Unlock()
	_, running := owners.evictions[playerID]
	return running
}

func waitDropEnded(t *testing.T, owners *PlayerOwners, playerID int64) {
	t.Helper()
	deadline := time.Now().Add(2 * time.Second)
	for dropRunning(owners, playerID) {
		if time.Now().After(deadline) {
			t.Fatalf("the drop of %d never ended", playerID)
		}
		time.Sleep(time.Millisecond)
	}
}

// RR-20261004-10：同一回合里"租约丢失 → 重新认领"也要在回合预算之内，而且旁观者的
// 续租确认不能排在这些等待之后。
//
// 每把丢失的租约重新认领时都要扔掉间断前的副本，最多等 evictBudget(5s)。旧实现在
// Refresh 结果的循环里逐个做：一批租约同时丢失（进程停顿、Redis 被清）时串行相乘，
// 8 把就是 40s，超过 Lease(30s)——与 RR-20260921-04 的归还回合同形。更糟的是同一个
// 循环里排在后面的 Held 结果到这时才确认：本地窗口从确认时刻起算 Lease，而 Redis 在
// Refresh 时就设好了 TTL，于是本地准入比键多活了几十秒，别的进程此间可以合法接手。
// 承诺：先确认所有续租，再在同一份回合预算（handBackPassBudget）内重新认领、然后
// 归还；预算用完时没轮到的丢失租约保持 interrupted（Admit 拒绝、不碰副本），下一轮
// 再问 Redis；已轮到但副本扔不掉的仍按 RR-20261001-07 abandon，不放行 stale 副本。
func TestARefreshPassRetakingLostLeasesHoldsTheLoopLessThanTheLeaseAllows(t *testing.T) {
	owners, table, _, clock := ownersUnderTest(t)
	ctx := context.Background()
	const lost = handBackBudget
	for playerID := int64(1); playerID <= lost; playerID++ {
		if mine, err := owners.Claim(ctx, playerID); err != nil || !mine {
			t.Fatalf("claim %d: %v %v", playerID, mine, err)
		}
	}
	const bystander = int64(100)
	if mine, err := owners.Claim(ctx, bystander); err != nil || !mine {
		t.Fatalf("claim bystander: %v %v", mine, err)
	}
	var (
		mu      sync.Mutex
		evicted []int64
	)
	owners.Evict(evictorFunc(func(_ context.Context, playerID int64) error {
		mu.Lock()
		defer mu.Unlock()
		*clock = clock.Add(evictBudget)
		evicted = append(evicted, playerID)
		return errors.New("the entity is busy")
	}))
	// Every lease but the bystander's is lost at once, and nobody else took
	// them: each one the pass reaches is re-claimed and has its copy dropped.
	for playerID := int64(1); playerID <= lost; playerID++ {
		delete(table.owner, playerID)
	}
	start := *clock
	owners.renew(ctx)
	held := clock.Sub(start)

	mu.Lock()
	started := len(evicted)
	mu.Unlock()
	if limit := playerroute.Lease - playerroute.RefreshInterval; held >= limit {
		t.Errorf("one refresh pass re-claiming lost leases held the refresh loop for %s (%d evictions at evictBudget %s each), not below Lease(%s) - RefreshInterval(%s) = %s",
			held, started, evictBudget, playerroute.Lease, playerroute.RefreshInterval, limit)
	}
	// The bystander was renewed by this pass: its local window ends when the
	// key Redis just extended does, not later, and it is still in service.
	owners.mu.Lock()
	window := owners.local[bystander].validUntil.Sub(start)
	owners.mu.Unlock()
	if window > playerroute.Lease {
		t.Errorf("the bystander's local window ends %s after the renewal that set its key's TTL (Lease %s): it was confirmed after the re-claims, and admits writes after the key can have expired", window, playerroute.Lease)
	}
	if err := owners.Admit(bystander); err != nil {
		t.Errorf("a bystander renewed at the start of the pass is out of service after it: %v", err)
	}
	// Nobody whose lease was lost is admitted, reached or not.
	var deferred []int64
	owners.mu.Lock()
	for playerID := int64(1); playerID <= lost; playerID++ {
		if owners.local[playerID] != nil {
			deferred = append(deferred, playerID)
		}
	}
	owners.mu.Unlock()
	for playerID := int64(1); playerID <= lost; playerID++ {
		if err := owners.Admit(playerID); !errors.Is(err, ErrLeaseNotHeld) {
			t.Fatalf("player %d, whose lease was lost and whose copy was not dropped, is admitted: %v", playerID, err)
		}
	}
	if len(deferred) == 0 || len(deferred) == lost {
		t.Fatalf("the pass should have reached some of the lost leases and left the rest: started=%d deferred=%v", started, deferred)
	}

	// The next pass, with the entities free again, re-takes the ones this
	// pass did not reach.
	owners.Evict(&evictorStub{})
	*clock = clock.Add(playerroute.RefreshInterval)
	owners.renew(ctx)
	for _, playerID := range deferred {
		if err := owners.Admit(playerID); err != nil {
			t.Fatalf("player %d, left for the next pass, was not re-taken by it: %v", playerID, err)
		}
		if table.owner[playerID] != table.sid {
			t.Fatalf("player %d's lease is not this process's after the re-take: %v", playerID, table.owner)
		}
	}
}

// The shared budget ends the real waits too: drops that never finish stop
// holding the pass when its budget runs out. Scaled down like the hand-back
// one — an eviction wait of 100ms against a pass of 150ms.
func TestARefreshPassStopsWaitingForRetakesWhenItsBudgetRunsOut(t *testing.T) {
	owners, table, _, _ := ownersUnderTest(t)
	owners.evictWait = 100 * time.Millisecond
	owners.handBackPassWait = 150 * time.Millisecond
	ctx := context.Background()
	const lost = handBackBudget
	for playerID := int64(1); playerID <= lost; playerID++ {
		if mine, err := owners.Claim(ctx, playerID); err != nil || !mine {
			t.Fatalf("claim %d: %v %v", playerID, mine, err)
		}
	}
	evictor := newBlockingEvictor()
	evictor.calls = make(chan int64, 64)
	owners.Evict(evictor)
	t.Cleanup(func() { close(evictor.release) })
	for playerID := int64(1); playerID <= lost; playerID++ {
		delete(table.owner, playerID)
	}

	start := time.Now()
	owners.renew(ctx)
	elapsed := time.Since(start)
	if unbudgeted := time.Duration(lost) * owners.evictWait; elapsed >= unbudgeted/2 {
		t.Fatalf("re-claiming lost leases held the refresh loop for %s with a budget of %s (without one it would be %s)", elapsed, owners.handBackPassWait, unbudgeted)
	}
	for playerID := int64(1); playerID <= lost; playerID++ {
		if err := owners.Admit(playerID); !errors.Is(err, ErrLeaseNotHeld) {
			t.Fatalf("player %d, whose lease was lost and whose copy was not dropped, is admitted: %v", playerID, err)
		}
	}
}

// RR-20261004-14：本地准入窗口从 Redis 设下键 TTL 的那次请求起算，不从确认那一刻起算。
//
// 跨间断的认领先 SetNX（键已是自己的则 CompareAndExpire）——键的 TTL 在这一刻设好——
// 再扔掉间断前的副本，这一步最多等 evictBudget(5s)。旧实现等完之后才按当时的 now 起算
// Lease，本地窗口比键多活一整份撤离等待。AdmissionGuard 是留给在途事务的：准入在键
// 可能过期之前 guard 那么久收口，最后一刻放行的事务才来得及在别的进程合法接手之前
// 结束；撤离等满时，准入一直开到键过期那一刻，这段保护整个被吃掉。续租同理：键的
// TTL 在 Refresh 被问的时候设好，Refresh 本身慢（逐个玩家往返、Redis 卡顿）时确认
// 时刻的 now 晚于键。与 RR-20261004-10 修掉的"续租确认排在等待之后"同形。
// 承诺：准入在"设键那次请求发出的时刻 + Lease − AdmissionGuard"之前收口。
func TestAdmissionStopsAGuardBeforeTheKeyRedisSetCanExpire(t *testing.T) {
	// recordAsks makes the table note, on the table's clock, when this
	// process asked Redis to claim; Redis sets the TTL no earlier than that.
	recordAsks := func(owners *PlayerOwners, table *fakeLeaseTable, clock *time.Time) (askedAt func() time.Time) {
		var (
			mu sync.Mutex
			at time.Time
		)
		owners.store = claimHookTable{fakeLeaseTable: table, before: func(int64) error {
			mu.Lock()
			at = *clock
			mu.Unlock()
			return nil
		}}
		return func() time.Time {
			mu.Lock()
			defer mu.Unlock()
			return at
		}
	}
	// slowDrop is the drop of an entity a transaction is holding: it ends
	// after a whole evictBudget on the table's clock.
	slowDrop := func(clock *time.Time) residentEvictor {
		return evictorFunc(func(context.Context, int64) error {
			*clock = clock.Add(evictBudget)
			return nil
		})
	}
	requireAdmissionEndsByTheKey := func(t *testing.T, owners *PlayerOwners, clock *time.Time, setAt time.Time, how string) {
		t.Helper()
		owners.mu.Lock()
		validUntil := owners.local[42].validUntil
		owners.mu.Unlock()
		if keyExpires := setAt.Add(playerroute.Lease); validUntil.After(keyExpires) {
			t.Errorf("%s: the local window ends %s after the key Redis set can expire (asked at +0s, Lease %s, local window until +%s)",
				how, validUntil.Sub(keyExpires), playerroute.Lease, validUntil.Sub(setAt))
		}
		*clock = setAt.Add(playerroute.Lease - AdmissionGuard + time.Second)
		if err := owners.Admit(42); err == nil {
			t.Errorf("%s: a transaction was admitted %s before the key can expire, inside the guard band (%s) reserved for work in flight",
				how, AdmissionGuard-time.Second, AdmissionGuard)
		}
	}

	t.Run("login", func(t *testing.T) {
		owners, table, _, clock := ownersUnderTest(t)
		askedAt := recordAsks(owners, table, clock)
		owners.Evict(slowDrop(clock))
		if mine, err := owners.Claim(context.Background(), 42); !mine || err != nil {
			t.Fatalf("claim: %v %v", mine, err)
		}
		requireAdmissionEndsByTheKey(t, owners, clock, askedAt(), "a login across a gap")
	})

	t.Run("background-claim", func(t *testing.T) {
		owners, table, _, clock := ownersUnderTest(t)
		askedAt := recordAsks(owners, table, clock)
		owners.Evict(slowDrop(clock))
		if owned, err := owners.Owns(context.Background(), 42); !owned || err != nil {
			t.Fatalf("owns: %v %v", owned, err)
		}
		requireAdmissionEndsByTheKey(t, owners, clock, askedAt(), "a background consumer's claim")
	})

	t.Run("refresh-retake", func(t *testing.T) {
		owners, table, _, clock := ownersUnderTest(t)
		askedAt := recordAsks(owners, table, clock)
		ctx := context.Background()
		if mine, err := owners.Claim(ctx, 42); !mine || err != nil {
			t.Fatalf("claim: %v %v", mine, err)
		}
		// The key lapsed and nobody took it: the pass re-takes it, and the
		// drop of the copy from before the gap waits on a busy entity.
		owners.Evict(slowDrop(clock))
		delete(table.owner, 42)
		*clock = clock.Add(playerroute.RefreshInterval)
		owners.renew(ctx)
		if err := owners.Admit(42); err != nil {
			t.Fatalf("precondition: the lapsed lease should have been re-taken: %v", err)
		}
		requireAdmissionEndsByTheKey(t, owners, clock, askedAt(), "a re-take by the refresh loop")
	})

	t.Run("renewal", func(t *testing.T) {
		owners, table, _, clock := ownersUnderTest(t)
		ctx := context.Background()
		if mine, err := owners.Claim(ctx, 42); !mine || err != nil {
			t.Fatalf("claim: %v %v", mine, err)
		}
		// A slow Refresh: the key's TTL is set when it is asked, and the
		// answer comes back seconds later.
		table.refresh = func(playerID int64) playerroute.RefreshResult {
			*clock = clock.Add(3 * time.Second)
			return playerroute.RefreshResult{PlayerID: playerID, Held: true}
		}
		*clock = clock.Add(playerroute.RefreshInterval)
		asked := *clock
		owners.renew(ctx)
		requireAdmissionEndsByTheKey(t, owners, clock, asked, "a renewal")
	})
}

// claimHookTable is the fake table with a step before each Claim: where a
// test notes the moment Redis was asked, or makes a Claim fail AFTER it has
// landed — a SetNX whose reply was lost.
type claimHookTable struct {
	*fakeLeaseTable
	before func(playerID int64) error
}

func (table claimHookTable) Claim(ctx context.Context, playerID int64) (playerroute.Route, error) {
	fail := table.before(playerID)
	route, err := table.fakeLeaseTable.Claim(ctx, playerID)
	if fail != nil {
		return playerroute.Route{}, fail
	}
	return route, err
}

// RR-20261004-14（同一修复单元的另一半）：认领的 SetNX 落地了、回复却丢了，下一轮
// 续租答 Held 也不能把一份没扔掉的副本当成连续持有。
//
// token 按进程固定（RR-20260920-03），Refresh 分不出"续的是间断前的键，还是本进程
// 刚重新 SetNX 的键"。旧实现里跨间断的认领在 store.Claim 报错时什么都不记：刷新循环
// 那条路径上玩家仍是 interrupted、Admit 拒绝，可下一轮 Refresh 答 Held，confirmRenewal
// 就清掉 interrupted、延长窗口——间断前的副本从没扔过，却被重新放行；后台 Owns 那条
// 路径（续租一直 Err、窗口跑完、键过期之后认领）同样被下一轮 Held 续回服务。承诺：
// 跨间断的认领报错时本地状态记为 interrupted；对 interrupted 的租约，Held 不是确认，
// 只说明"键又是我们的了"——按丢失的租约重新认领，扔掉副本再确认。
func TestAClaimRedisDidNotAnswerIsNotConfirmedByTheNextRenewal(t *testing.T) {
	replyLost := errors.New("the reply was lost (the SetNX landed)")
	// lossyClaims arms the next Claim to land in the table and still fail.
	lossyClaims := func(owners *PlayerOwners, table *fakeLeaseTable) (loseNextReply func()) {
		var armed atomic.Bool
		owners.store = claimHookTable{fakeLeaseTable: table, before: func(int64) error {
			if armed.CompareAndSwap(true, false) {
				return replyLost
			}
			return nil
		}}
		return func() { armed.Store(true) }
	}
	requireDroppedBeforeServed := func(t *testing.T, owners *PlayerOwners, evictor *evictorStub) {
		t.Helper()
		if err := owners.Admit(42); err == nil && len(evictor.taken()) == 0 {
			t.Fatalf("the next renewal put player 42 back in service on the copy from before the gap, which was never dropped: dropped=%v", evictor.taken())
		}
		if err := owners.Admit(42); err != nil {
			t.Fatalf("player 42 did not come back into service once the copy was dropped: %v", err)
		}
		if dropped := evictor.taken(); len(dropped) != 1 || dropped[0] != 42 {
			t.Fatalf("the copy from before the gap should be dropped exactly once before serving: dropped=%v", dropped)
		}
	}

	t.Run("refresh-retake", func(t *testing.T) {
		owners, table, fencer, clock := ownersUnderTest(t)
		loseNextReply := lossyClaims(owners, table)
		evictor := &evictorStub{}
		owners.Evict(evictor)
		ctx := context.Background()
		if mine, err := owners.Claim(ctx, 42); !mine || err != nil {
			t.Fatalf("claim: %v %v", mine, err)
		}
		// Logged in, so no pass hands the lease back on the way.
		fencer.connect(42)
		evictor.forget()
		// The key lapsed; the pass re-takes it, and the reply is lost.
		delete(table.owner, 42)
		loseNextReply()
		*clock = clock.Add(playerroute.RefreshInterval)
		owners.renew(ctx)
		if err := owners.Admit(42); !errors.Is(err, ErrLeaseNotHeld) {
			t.Fatalf("precondition: a re-take Redis did not answer must not be admitted: %v", err)
		}
		if table.owner[42] != table.sid || len(evictor.taken()) != 0 {
			t.Fatalf("precondition: the SetNX should have landed with nothing dropped: owner=%v dropped=%v", table.owner, evictor.taken())
		}
		*clock = clock.Add(playerroute.RefreshInterval)
		owners.renew(ctx)
		requireDroppedBeforeServed(t, owners, evictor)
	})

	t.Run("background-claim", func(t *testing.T) {
		owners, table, fencer, clock := ownersUnderTest(t)
		loseNextReply := lossyClaims(owners, table)
		evictor := &evictorStub{}
		owners.Evict(evictor)
		ctx := context.Background()
		if mine, err := owners.Claim(ctx, 42); !mine || err != nil {
			t.Fatalf("claim: %v %v", mine, err)
		}
		fencer.connect(42)
		evictor.forget()
		// This process cannot reach Redis for longer than the lease: every
		// renewal is unknown, admission runs out, the key lapses.
		table.refresh = func(playerID int64) playerroute.RefreshResult {
			return playerroute.RefreshResult{PlayerID: playerID, Err: errors.New("redis unreachable")}
		}
		for i := 0; i < 4; i++ {
			*clock = clock.Add(playerroute.RefreshInterval)
			owners.renew(ctx)
		}
		delete(table.owner, 42)
		// Redis is back. A background consumer asks; its claim lands and the
		// reply does not.
		table.refresh = nil
		loseNextReply()
		if owned, err := owners.Owns(ctx, 42); owned || !errors.Is(err, replyLost) {
			t.Fatalf("precondition: the claim should have failed: owned=%v err=%v", owned, err)
		}
		if table.owner[42] != table.sid || len(evictor.taken()) != 0 {
			t.Fatalf("precondition: the SetNX should have landed with nothing dropped: owner=%v dropped=%v", table.owner, evictor.taken())
		}
		*clock = clock.Add(playerroute.RefreshInterval)
		owners.renew(ctx)
		requireDroppedBeforeServed(t, owners, evictor)
	})

	// The other side of the mark: a claim Redis did not answer, for a lease
	// whose key never stopped being ours, changes nothing. Here Admit refuses
	// only because a hand-back's drop is still running (RR-20261004-11); the
	// player comes back when the drop ends, without a re-take.
	t.Run("a-lease-that-never-lapsed", func(t *testing.T) {
		owners, table, fencer, clock := ownersUnderTest(t)
		loseNextReply := lossyClaims(owners, table)
		owners.evictWait = 50 * time.Millisecond
		ctx := context.Background()
		if owned, err := owners.Owns(ctx, 77); !owned || err != nil {
			t.Fatalf("owns: %v %v", owned, err)
		}
		evictor := newBlockingEvictor()
		owners.Evict(evictor)
		var once sync.Once
		endDrop := func() { once.Do(func() { close(evictor.release) }) }
		t.Cleanup(endDrop)
		*clock = clock.Add(HandBackIdle + time.Second)
		owners.renew(ctx)
		if !dropRunning(owners, 77) || table.owner[77] != table.sid {
			t.Fatalf("precondition: the hand-back's drop should still be running with the lease kept: owner=%v", table.owner)
		}
		loseNextReply()
		if mine, err := owners.Claim(ctx, 77); mine || !errors.Is(err, replyLost) {
			t.Fatalf("precondition: the claim should have failed: mine=%v err=%v", mine, err)
		}
		endDrop()
		waitDropEnded(t, owners, 77)
		if err := owners.Admit(77); err != nil {
			t.Fatalf("a claim Redis did not answer took a lease that never lapsed out of service: %v", err)
		}
		// The next renewal confirms it as the renewal it is: no re-take, no
		// second drop. (Connected, so the pass does not hand it back.)
		fencer.connect(77)
		*clock = clock.Add(playerroute.RefreshInterval)
		owners.renew(ctx)
		if err := owners.Admit(77); err != nil {
			t.Fatalf("player 77 is out of service after the next renewal: %v", err)
		}
		if drops := len(evictor.calls); drops != 1 {
			t.Fatalf("the next renewal re-took a lease that never lapsed: %d drops, want only the hand-back's", drops)
		}
	})
}
