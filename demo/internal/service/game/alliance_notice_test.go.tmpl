package {{GAME_SERVICE_PKG}}

import (
	"context"
	"testing"

	"{{MODULE}}/game/alliancerule"
	"{{MODULE}}/game/handler"
	rpcalliance "{{MODULE}}/internal/rpc/alliance"
	"{{MODULE}}/protocol/msgid"
	"{{MODULE}}/protocol/pb"
	"github.com/tjbdwanghaibo/roost-core/framework/nest"
)

// noticePush is the player connection as the notices see it: who is online,
// and what was pushed to whom.
type noticePush struct {
	online map[int64]bool
	pushed []pb.GuildNoticePush
	to     []int64
}

func (p *noticePush) ActiveSessions(playerID int64) int {
	if p.online[playerID] {
		return 1
	}
	return 0
}

func (p *noticePush) PushPlayer(_ context.Context, playerID int64, messageID uint32, value any) error {
	if messageID != msgid.MsgGuildNotice {
		return nil
	}
	p.to = append(p.to, playerID)
	p.pushed = append(p.pushed, *value.(*pb.GuildNoticePush))
	return nil
}

// A membership notice reaches an ONLINE member: the guild they are shown in
// changes (the display field, through the real ShowGuild transaction) and the
// client gets GuildNotice. An offline member is neither loaded nor pushed —
// the next login reads the mirror. A "left guild 7" that arrives after the
// player already shows guild 9 does not blank guild 9.
func TestAMemberNoticeReachesAnOnlineMember(t *testing.T) {
	online := newScenePlayer(t, 501)
	offline := newScenePlayer(t, 502)
	handler.RegisterShowGuildNestHandlers()
	engine := nest.NewEngine(
		nest.NestOptionWithGetter(sceneGetter{online.ID(): online}),
		nest.NestOptionWithTransactionCommitter(sceneCommitter{}),
		nest.NestOptionWithWorkerPools(nest.WorkerPoolConfig{Workers: 1, QueueCap: 16}, nest.WorkerPoolConfig{}, nest.WorkerPoolConfig{}),
	)
	if err := engine.Start(); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { _ = engine.Shutdown(context.Background()) })
	push := &noticePush{online: map[int64]bool{501: true}}
	notices := guildNotices{nest: engine, push: push}
	ctx := context.Background()

	if err := notices.apply(ctx, &rpcalliance.MemberNotice{AllianceID: 7, PlayerID: 501, Change: alliancerule.MemberJoined, Version: 4}); err != nil {
		t.Fatal(err)
	}
	if got := online.ProfileComp().GuildID(); got != 7 {
		t.Fatalf("online member shows guild %d after a join notice, want 7", got)
	}
	if len(push.pushed) != 1 || push.to[0] != 501 || push.pushed[0].GuildID != 7 || push.pushed[0].Change != alliancerule.MemberJoined || push.pushed[0].Version != 4 {
		t.Fatalf("pushed %v to %v, want one GuildNotice(7, joined, 4) to 501", push.pushed, push.to)
	}

	// Offline: the harness holds no entity 502, so loading it would fail the
	// test through the getter; the notice must not try.
	if err := notices.apply(ctx, &rpcalliance.MemberNotice{AllianceID: 7, PlayerID: 502, Change: alliancerule.MemberJoined, Version: 5}); err != nil {
		t.Fatal(err)
	}
	if offline.ProfileComp().GuildID() != 0 || len(push.pushed) != 1 {
		t.Fatalf("an offline member was touched: shows %d, pushes %d", offline.ProfileComp().GuildID(), len(push.pushed))
	}

	// The player moved to guild 9; a late "left 7" must not hide guild 9, and
	// "left 9" does.
	if err := notices.apply(ctx, &rpcalliance.MemberNotice{AllianceID: 9, PlayerID: 501, Change: alliancerule.MemberJoined, Version: 1}); err != nil {
		t.Fatal(err)
	}
	if err := notices.apply(ctx, &rpcalliance.MemberNotice{AllianceID: 7, PlayerID: 501, Change: alliancerule.MemberLeft, Version: 6}); err != nil {
		t.Fatal(err)
	}
	if got := online.ProfileComp().GuildID(); got != 9 {
		t.Fatalf("a late leave of guild 7 changed the display to %d, want 9", got)
	}
	if err := notices.apply(ctx, &rpcalliance.MemberNotice{AllianceID: 9, PlayerID: 501, Change: alliancerule.MemberKicked, Version: 2}); err != nil {
		t.Fatal(err)
	}
	if got := online.ProfileComp().GuildID(); got != 0 {
		t.Fatalf("kicked from guild 9, still shows %d", got)
	}
}
