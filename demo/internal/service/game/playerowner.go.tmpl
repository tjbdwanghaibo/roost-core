// PlayerOwnerCapability is the name the ownership table is published under, so
// an endpoint can reach it without importing this package.
const PlayerOwnerCapability app.ModName = "{{GAME_SERVICE}}.playerowner"

// PlayerOwners 记录本进程正在为哪些玩家服务（驻留表），并据此回答写准入、做闲置卸载。
//
// 绑定的权威是 account：玩家建角时绑定到一个 game sid（Role.ServerID）；原服并入另一服（别名合服）后由承载服的
// 进程服务（会话里的 server_id 是 Role.ServingServerID）；单个玩家换服（rehome 模块）经 account 把他改绑到另一个 sid。
// 进程只认自己的一个 sid；同一 sid 同一时刻只有一个进程，崩溃重启时的短暂并存由 App 单实例锁处理
// （app.Singleton：任何 Mod Init 之前获取，失锁 fail-stop）。于是“同一玩家至多一个写者”就等于“只在玩家
// 当前绑定的 sid 上为他服务”，不需要按玩家的共享租约。本类型不感知那把锁，也不访问 Redis。
//
// 驻留记录只在通过绑定校验之后建立：登录走 Serve（会话 Claims 里 account 给出的 server_id；在它之前登录端点
// 已经跑过 rehome 模块的进入前检查），后台步骤走 AdmitBound（按当前绑定）。WriteGate 的 Admit 只看记录和
// 卸载状态，所以“这个玩家是不是本服的”由“只有校验通过才会有记录”来保证，网关不需要知道 sid。
//
// 换服：本类型实现 rehome 模块的 Residency（文件末尾），带迁出表 emigrants——从本进程换走的玩家、去了哪、
// 是否还在换服中。迁出表与驻留表在同一把锁下：表里有他，Serve 与 AdmitBound 就不会给他建驻留记录；
// 换服时交出实体成功的那一刻驻留记录被删掉，从此 Admit 拒绝他的写入。迁出表不持久，进程重启后他归谁由 account 回答。
//
// 闲置卸载只是本地内存管理：没有连接、IdleUnload 内没被使用过的玩家，丢掉内存副本并删掉记录，
// 不交出任何东西；之后在本进程重新装载，等待的是 DataEngine 冷加载已有的投影屏障。卸载进行中
// Admit / AdmitBound 拒绝，Serve 等它结束再装载。
//
// 锁：mu 保护 residents 与 evictions，从不跨等待持有。Admit 在 Nest 业务池（short / long）上被调用，只做一次加锁读写。
type PlayerOwners struct {
	sid    int32
	fencer sessionFencer
	evict  residentEvictor
	// evictWait 是 evictBudget；做成字段，测试不必真等五秒来证明等待有界。
	evictWait time.Duration
	now       func() time.Time
	// onUnloadWait 在 Serve 开始等某个玩家的卸载时被调用。只给测试用：测试没有别的办法看到一个
	// goroutine 停在等待上；进程里没有人设置它。
	onUnloadWait func(playerID int64)
	// afterUnloadDone 在 runEviction 关闭 done（唤醒等这次卸载的 Serve）之后被调用。只给测试用：
	// 它让测试在“等待者已被唤醒”与“runEviction 返回”之间插入一次登录，钉住“删除记录必须在关闭
	// done 之前”；进程里没有人设置它，测试在卸载开始之前设置。
	afterUnloadDone func(playerID int64)
	// residentKind 回答 Player 这个 kind 是否声明了 lifetime=resident。常驻的玩家不做闲置卸载：框架只拒绝从内存
	// 卸载常驻实例（ErrEntityResident），卸载却会先让他离开场景，结果是实体留在内存、人已不在场景。
	residentKind func() bool

	// bound 回答一名玩家当前的绑定（rehome 模块的 Binding：先看迁出表，再问 account）。AdmitBound 对没有
	// 驻留记录的玩家问它。nil 表示没有权威可问，按“都绑定在本服”处理——只在测试与单进程部署里出现，
	// NewPlayerOwners 总是装上。
	bound func(ctx context.Context, playerID int64) (sid int32, moving bool, err error)
	// depart 让一名玩家的实体离开本进程并保持屏障（离开场景、DataEngine 交出实体），返回撤屏障的函数。
	// 与 Evict 一样在场景和实体运行时起来之后装上（HandOff）；没有它换服在“离开”这一步失败、被中止。
	depart residentDeparter

	mu        sync.Mutex
	residents map[int64]*resident
	// emigrants 是迁出表：玩家 → 让他离开本进程的那一次换服。受 mu 保护。
	emigrants map[int64]*emigrant
	// evictions 是按玩家去重的在途卸载（单航班）：同一玩家同时至多一个，Serve 加入它而不是再起一个。
	evictions map[int64]*eviction

	cancel context.CancelFunc
	done   chan struct{}
}

// resident 是本进程为之服务过的一个玩家：已经通过绑定校验，最近一次被使用是什么时候。
type resident struct {
	// lastUsed 是这个玩家最近一次被准入或接入服务的时间（Admit / AdmitBound / Serve）。只读的
	// 查看（Resident）不算使用，否则被 matchmaker 看过一眼的玩家永远不会闲置。
	lastUsed time.Time
}

// emigrant 是迁出表的一行。
type emigrant struct {
	move gamerehome.Move
	// moving 为 true 表示换服还没有结论；false 表示 account 已经把他改绑到 move.To。
	moving bool
	since  time.Time
	// release 非空表示实体已经交出，屏障由它撤销。
	release func(context.Context) error
}

// residentDeparter 把一名玩家的实体从本进程交出去：先离开场景，再让 DataEngine 交出实体（已准入的写入落库、
// 卸载、此后写到它的事务被拒绝）。返回的 release 撤掉屏障（它会先卸载期间被读回内存的实例，可能因实体被占用而失败）。
// 失败是确定的“没有交出”。会等待，不能在 Nest 业务 worker 上调用。
type residentDeparter interface {
	DepartPlayer(ctx context.Context, playerID int64) (release func(context.Context) error, err error)
}

// eviction 是一次在途卸载，所有等它的人共享同一个结果。
type eviction struct {
	done chan struct{}
	err  error
}

// sessionFencer 是本进程到某个玩家的连接：有几条，以及怎样断开。
//
// 卸载用 ActiveSessions 判断玩家还在不在玩；停机用 CloseSessions 断开全部服务中的玩家。
type sessionFencer interface {
	CloseSessions(playerID int64, reason error) int
	ActiveSessions(playerID int64) int
}

// residentEvictor 丢掉本进程内存里某个玩家的副本：离开场景、移出实体管理器。
type residentEvictor interface {
	// EvictPlayer 把玩家从本进程移除。玩家不在内存里时也必须安全；不能“删一半”，失败要返回错误：
	// 调用方据此保留驻留记录，玩家继续在本进程服务。
	EvictPlayer(ctx context.Context, playerID int64) error
}

// ErrNotServedHere 是写入路径在本进程此刻不为这个玩家服务时得到的错误：没有驻留记录（没登录到
// 本服、或绑定在别的服），或者他的内存副本正在被卸载。
var ErrNotServedHere = errors.New("player owners: this process is not serving the player right now")

// IdleUnload 是一个玩家在本进程没有连接、也没有被使用多久之后，内存副本被卸载。
//
// 只关系到内存和重新装载的开销，不关系正确性：卸载不交出任何东西，下一次使用在本进程冷加载。
const IdleUnload = 5 * time.Minute

// unloadScanInterval 是卸载 goroutine 扫一次驻留表的间隔。
const unloadScanInterval = 30 * time.Second

// evictBudget 是调用方等一次卸载的上限，不是卸载本身的上限。
//
// 卸载最终走到 EntityManager.Destroy，它等实体的互斥锁、不看 context：实体上有事务，卸载就等着
// 它。所以卸载在自己的 goroutine 上跑到结束，这里只限制“等多久”。等超时的调用方
// 必须当作副本还在：卸载 goroutine 去处理下一个玩家，Serve 返回可重试的超时；卸载结束之前 Admit
// 一直拒绝这个玩家。
const evictBudget = 5 * time.Second

// NewPlayerOwners 用本进程配置里的 sid 建驻留表。
func NewPlayerOwners(registry *app.Registry) (*PlayerOwners, error) {
	identity, err := settings.Identity(registry)
	if err != nil {
		return nil, fmt.Errorf("player owners: %w", err)
	}
	sid := identity.Sid
	if sid <= 0 {
		return nil, fmt.Errorf("player owners: sid is %d; a game process serves the players bound to its sid and needs one", sid)
	}
	owners := newPlayerOwners(sid, nil, time.Now) //glsvet:system-clock residency and idle unload are leases
	// 当前绑定问 rehome 模块：它先看迁出表（就是本表，以 Residency 的名义发布），再问 account。
	owners.bound = func(ctx context.Context, playerID int64) (int32, bool, error) {
		return gamerehome.Binding(ctx, registry, playerID)
	}
	return owners, nil
}

// newPlayerOwners 是测试构造的入口。
func newPlayerOwners(sid int32, fencer sessionFencer, now func() time.Time) *PlayerOwners {
	if now == nil {
		now = time.Now //glsvet:system-clock residency and idle unload are leases
	}
	return &PlayerOwners{
		sid: sid, fencer: fencer, now: now, evictWait: evictBudget,
		residentKind: playerKindIsResident,
		residents: map[int64]*resident{},
		emigrants: map[int64]*emigrant{},
		evictions: map[int64]*eviction{},
	}
}

// HandOff 设置交出玩家实体的实现（换服用）。与 Evict 一样和构造分开。
func (owners *PlayerOwners) HandOff(departer residentDeparter) {
	if owners == nil {
		return
	}
	owners.mu.Lock()
	owners.depart = departer
	owners.mu.Unlock()
}

// Evict 设置丢掉玩家副本的实现。和 Fence 一样与构造分开：场景和实体运行时在驻留表之后才起来。
// 没有它就不卸载任何玩家（内存多占一些，但不会出错）。
func (owners *PlayerOwners) Evict(evictor residentEvictor) {
	if owners == nil {
		return
	}
	owners.mu.Lock()
	owners.evict = evictor
	owners.mu.Unlock()
}

// Fence 设置本进程的连接（玩家 TCP Runtime）。与构造分开，因为传输层在驻留表之后才起来。没有它
// 就不卸载任何玩家：不知道玩家有没有连接，就不能说他闲置。
func (owners *PlayerOwners) Fence(fencer sessionFencer) {
	if owners == nil {
		return
	}
	owners.mu.Lock()
	owners.fencer = fencer
	owners.mu.Unlock()
}

// SID 是本进程的 sid，也就是本进程服务的玩家绑定的那个 sid。
func (owners *PlayerOwners) SID() int32 {
	if owners == nil {
		return 0
	}
	return owners.sid
}

// Serve 是登录时把玩家接入本进程服务：boundSID 是 account 校验会话时给出的角色 ServerID。
//
// boundSID 是握手时的快照。握手之后这名玩家换了服的情形由两处兜住：登录端点在调 Serve 之前跑 rehome 模块的
// 进入前检查（它读会话里的绑定代数与在途换服，必要时问 account）；这里在建记录的同一把锁下复核迁出表。
//
// 四种结果：
//   - boundSID 不是本进程的 sid（含 0，即不知道绑定在哪）：返回 ErrPlayerElsewhere（owner_sid=boundSID），
//     不建记录、不装载。玩家只能在自己绑定的服上服务，客户端改连那个服，不要在本服重试。
//   - 迁出表里有他：换服还没有结论是 rehome_moving，已经换走是 rehome_elsewhere（带他去的服）。不建记录、不装载。
//   - 这个玩家的内存副本正在被卸载，并且在 evictWait 或 ctx 之内没有结束：返回包着
//     context.DeadlineExceeded / ctx 错误的错误，登录回 login_timeout，客户端重试；记录不变。
//   - 否则建立或刷新驻留记录（算一次使用），返回 nil，调用方随后装载实体。
//
// 等卸载是因为卸载会把副本连同场景成员关系一起拿走：先装载、再被卸载拿走，玩家就在一条打开的
// 连接上没有了实体。它在登录连接的 goroutine 上等，不在 Nest worker 上。
func (owners *PlayerOwners) Serve(ctx context.Context, playerID int64, boundSID int32) error {
	if owners == nil {
		return nil
	}
	if boundSID != owners.sid {
		return errcode.Wrap(apperrors.ErrPlayerElsewhere, nil, "player_id", playerID, "owner_sid", boundSID)
	}
	if ctx == nil {
		ctx = context.Background()
	}
	budget := time.NewTimer(owners.evictWait)
	defer budget.Stop()
	for {
		owners.mu.Lock()
		if away := owners.emigrants[playerID]; away != nil {
			owners.mu.Unlock()
			return away.refusal()
		}
		inFlight, unloading := owners.evictions[playerID]
		if !unloading {
			owners.touchLocked(playerID)
			owners.mu.Unlock()
			return nil
		}
		parked := owners.onUnloadWait
		owners.mu.Unlock()
		if parked != nil {
			parked(playerID)
		}
		select {
		case <-inFlight.done:
			// 卸载结束（成功时记录已随它删掉，失败时记录还在）；回到循环开头重新判断。
		case <-budget.C:
			return fmt.Errorf("player owners: player %d is still being unloaded after %s: %w", playerID, owners.evictWait, context.DeadlineExceeded)
		case <-ctx.Done():
			return fmt.Errorf("player owners: waiting for player %d to be unloaded: %w", playerID, ctx.Err())
		}
	}
}

// Admission 是 AdmitBound 的回答。
type Admission struct {
	// Local 为 true：这名玩家归本服，可以在本进程执行（err 非 nil 时是“归本服，但副本正在卸载”）。
	Local bool
	// Moving 为 true：他正在换服，结论未定。哪个服都不要执行，稍后再问。
	Moving bool
	// SID 是他当前绑定的服；Local 为 false 且不在换服时，调用方把工作交给它。
	SID int32
}

// AdmitBound 是后台工作（赠礼步骤之类）的准入，按玩家**当前**的绑定回答，不看命令里携带的 sid
// （那只是发起时的服，用于最初的路由）：
//
//   - 有驻留记录：归本服，刷新记录（算一次使用）。不问任何人。
//   - 迁出表里有他：换服中，或者已经换走（给出他去的服）。
//   - 都没有：问当前绑定（rehome 模块的 Binding → account）。归本服就建驻留记录——建之前在锁内复核迁出表，
//     问的那一会儿他可能刚开始换服；归别的服、换服中都不建记录。问不到返回错误，调用方让消息重投。
//
// Local 为 true 且 err 非 nil 表示玩家归本服、但副本正在卸载，调用方拒绝这一次（消息重投），不转交。
// 问 account 会等待：在步骤消费者的 goroutine 上调用，不在 Nest 业务 worker 上。
func (owners *PlayerOwners) AdmitBound(ctx context.Context, playerID int64) (Admission, error) {
	if owners == nil {
		return Admission{Local: true}, nil
	}
	owners.mu.Lock()
	if owners.emigrants[playerID] == nil && owners.residents[playerID] != nil {
		defer owners.mu.Unlock()
		return owners.admitLocalLocked(playerID)
	}
	bound := owners.bound
	owners.mu.Unlock()
	sid, moving := owners.sid, false
	if bound != nil {
		var err error
		if sid, moving, err = bound(ctx, playerID); err != nil {
			return Admission{}, fmt.Errorf("player owners: binding of player %d: %w", playerID, err)
		}
	}
	switch {
	case moving:
		return Admission{Moving: true, SID: sid}, nil
	case sid != owners.sid:
		return Admission{SID: sid}, nil
	}
	owners.mu.Lock()
	defer owners.mu.Unlock()
	if away := owners.emigrants[playerID]; away != nil {
		// 问的那一会儿他开始换服了（或者权威说“在本服”而本进程的屏障还没撤）：按迁出表回答。
		if away.moving {
			return Admission{Moving: true, SID: owners.sid}, nil
		}
		return Admission{SID: away.move.To}, nil
	}
	return owners.admitLocalLocked(playerID)
}

// admitLocalLocked 接入一名已经确认归本服的玩家。调用方持有 mu。
func (owners *PlayerOwners) admitLocalLocked(playerID int64) (Admission, error) {
	if _, unloading := owners.evictions[playerID]; unloading {
		return Admission{Local: true, SID: owners.sid}, fmt.Errorf("%w: player %d, the copy is being unloaded", ErrNotServedHere, playerID)
	}
	owners.touchLocked(playerID)
	return Admission{Local: true, SID: owners.sid}, nil
}

// touchLocked 建立或刷新玩家的驻留记录，记一次使用。调用方持有 mu，并且已经确认绑定在本服。
func (owners *PlayerOwners) touchLocked(playerID int64) {
	state := owners.residents[playerID]
	if state == nil {
		state = &resident{}
		owners.residents[playerID] = state
	}
	state.lastUsed = owners.now()
}

// Admit 是写准入：本进程此刻能不能在这个玩家身上开始一个新事务？
//
// 只看本地状态：有驻留记录，并且副本没有在卸载。放行算一次使用，正在干活的玩家因此不会被卸载。
// 只加一次锁，不阻塞（在业务池上调用）。
func (owners *PlayerOwners) Admit(playerID int64) error {
	if owners == nil {
		// 没有驻留表：单进程部署，每个玩家都是本进程的。
		return nil
	}
	owners.mu.Lock()
	defer owners.mu.Unlock()
	if away := owners.emigrants[playerID]; away != nil {
		// 迁出表里的玩家——离开中的、已经换走的——不再开始任何新的事：从 Reserve 打上标记的那一刻起。
		// 不等到交出实体：标记之后才准入的请求（他这时去加入一个公会）会让“换服前的检查”在提交之前失效。
		return away.refusal()
	}
	state := owners.residents[playerID]
	if state == nil {
		return fmt.Errorf("%w: player %d has not been taken into service here", ErrNotServedHere, playerID)
	}
	if _, unloading := owners.evictions[playerID]; unloading {
		// 写进去的东西会落在一个马上被销毁的实体上。卸载结束后：成功则记录已删，
		// 下一次使用重新接入；失败则记录还在，从那一刻起照常放行。
		return fmt.Errorf("%w: player %d, the copy is being unloaded", ErrNotServedHere, playerID)
	}
	state.lastUsed = owners.now()
	return nil
}

// AdmitMessage 是接入边界的闸门（accessplayer.WriteGate）：本进程能不能处理这个请求？
//
// 登录豁免：EnterGame 就是建立驻留记录的那条消息（Serve 在里面做绑定校验）。新建请求 EnterCreate 同样豁免：
// 用进服票据握手的新玩家在建成之前，EnterGame 只答 enter_need_create，他的第一条要装载 Player 的消息是 EnterCreate，
// 它的端点与 EnterGame 一样先核对绑定、再 Serve（game/controllers/player/enter_create.go）。其余消息一律按 Admit 判，
// 这样以后新增的端点也被覆盖，检查因此放在这里而不是每个 handler 里。
func (owners *PlayerOwners) AdmitMessage(playerID int64, messageID uint32) error {
	if owners == nil {
		return nil
	}
	if messageID == msgid.MsgEnterGame || messageID == msgid.MsgEnterCreate {
		return nil
	}
	return owners.Admit(playerID)
}

// Resident 只读地回答“这个玩家此刻在本进程服务吗”：有驻留记录，并且副本没有在卸载。
// 不算使用、不建记录；给只决定要不要处理别人放进共享队列的工作的调用方用（matchmaker）。
func (owners *PlayerOwners) Resident(playerID int64) bool {
	if owners == nil {
		return true
	}
	owners.mu.Lock()
	defer owners.mu.Unlock()
	if owners.residents[playerID] == nil {
		return false
	}
	_, unloading := owners.evictions[playerID]
	return !unloading
}

// CloseServedSessions 断开本进程服务中的全部玩家的连接，返回断开的条数。
//
// 停机（包括失锁、DataEngine fatal 之类的 fail-stop）时由 Service.Shutdown 第一个调用：进程要退出了，
// 连接不能留在一个已经不再处理请求的进程上，客户端重连到接替的进程。只有经过 Serve 的玩家能在本进程做事，所以断开有驻留记录的玩家就覆盖了
// 所有能做事的连接；其余连接随传输层 Mod 停止关闭。连接在锁外关闭：关闭会触发会话关闭事件。
func (owners *PlayerOwners) CloseServedSessions(reason error) int {
	if owners == nil {
		return 0
	}
	owners.mu.Lock()
	fencer := owners.fencer
	served := make([]int64, 0, len(owners.residents))
	for playerID := range owners.residents {
		served = append(served, playerID)
	}
	owners.mu.Unlock()
	if fencer == nil {
		return 0
	}
	closed := 0
	for _, playerID := range served {
		closed += fencer.CloseSessions(playerID, reason)
	}
	return closed
}

// Start 启动卸载 goroutine。它只做闲置卸载，别的什么都不做。
func (owners *PlayerOwners) Start(ctx context.Context) {
	if owners == nil {
		return
	}
	loopCtx, cancel := context.WithCancel(ctx)
	owners.cancel, owners.done = cancel, make(chan struct{})
	go owners.unloadLoop(loopCtx)
}

// Stop 停止卸载 goroutine 并等它返回。正在跑的卸载不被打断（它不看 context），只是不再等它。
func (owners *PlayerOwners) Stop() {
	if owners == nil || owners.cancel == nil {
		return
	}
	owners.cancel()
	<-owners.done
	owners.cancel = nil
}

func (owners *PlayerOwners) unloadLoop(ctx context.Context) {
	defer close(owners.done)
	ticker := time.NewTicker(unloadScanInterval)
	defer ticker.Stop()
	for {
		select {
		case <-ctx.Done():
			return
		case <-ticker.C:
		}
		owners.unloadIdle(ctx)
	}
}

// unloadIdle 是一轮闲置卸载，单独拆出来，测试可以不等 ticker 直接驱动。
//
// 选中的条件：没有连接、IdleUnload 内没被使用、没有在卸载。逐个处理，每个最多等 evictWait；等超时的
// 卸载在后台继续，这一轮去处理下一个玩家。Player 声明为常驻（lifetime=resident）时一个都不选：在选人这一步
// 跳过，而不是让卸载先离场景、再被框架拒绝。
func (owners *PlayerOwners) unloadIdle(ctx context.Context) {
	owners.mu.Lock()
	sessions, evictor := owners.fencer, owners.evict
	now := owners.now()
	var idle []int64
	if sessions != nil && evictor != nil && (owners.residentKind == nil || !owners.residentKind()) {
		for playerID, state := range owners.residents {
			if _, unloading := owners.evictions[playerID]; !unloading && now.Sub(state.lastUsed) >= IdleUnload {
				idle = append(idle, playerID)
			}
		}
	}
	owners.mu.Unlock()
	for _, playerID := range idle {
		if ctx.Err() != nil {
			return
		}
		owners.unloadOne(ctx, sessions, evictor, playerID)
	}
}

// unloadOne 卸载一个闲置的玩家。
//
// 连接数在锁外问（传输层有自己的锁），并且在标记之前问。标记时在锁内重新确认仍然闲置：在两者之间
// 登录的玩家，Serve 已经刷新了 lastUsed，这里就放过他；标记之后才到的登录加入这次卸载，结束后重新装载。
func (owners *PlayerOwners) unloadOne(ctx context.Context, sessions sessionFencer, evictor residentEvictor, playerID int64) {
	if sessions.ActiveSessions(playerID) > 0 {
		return
	}
	owners.mu.Lock()
	state := owners.residents[playerID]
	_, unloading := owners.evictions[playerID]
	if state == nil || unloading || owners.now().Sub(state.lastUsed) < IdleUnload {
		owners.mu.Unlock()
		return
	}
	inFlight := &eviction{done: make(chan struct{})}
	owners.evictions[playerID] = inFlight
	wait := owners.evictWait
	owners.mu.Unlock()
	go owners.runEviction(evictor, playerID, inFlight)

	timer := time.NewTimer(wait)
	defer timer.Stop()
	select {
	case <-inFlight.done:
		if inFlight.err != nil {
			slog.Warn("player owners: idle player kept in service because its copy could not be dropped", "player_id", playerID, "err", inFlight.err)
			return
		}
		slog.Info("player owners: idle player unloaded", "player_id", playerID)
	case <-timer.C:
		slog.Warn("player owners: unloading an idle player is taking longer than the wait; it continues in the background", "player_id", playerID, "wait", wait)
	case <-ctx.Done():
	}
}

// runEviction 执行一次卸载，并把结果交给所有等它的人。
//
// 用 Background context：它最终走到的 Destroy 不看 context（见 evictBudget），传截止时间只是一个
// 没人兑现的承诺。成功时驻留记录在关闭 done 之前、同一个临界区里删除：卸载进行中没有人能改这条记录
// （Serve 在等，Admit / AdmitBound 拒绝），而 done 关闭之后醒来的 Serve 建的是一条新记录，不会被这里删掉。
func (owners *PlayerOwners) runEviction(evictor residentEvictor, playerID int64, in *eviction) {
	in.err = evictor.EvictPlayer(context.Background(), playerID)
	owners.mu.Lock()
	if owners.evictions[playerID] == in {
		delete(owners.evictions, playerID)
	}
	if in.err == nil {
		delete(owners.residents, playerID)
	}
	owners.mu.Unlock()
	close(in.done)
	if hook := owners.afterUnloadDone; hook != nil {
		hook(playerID)
	}
}

// --- rehome 模块的 Residency：让一名玩家离开本进程，以及迁出表 ---

// refusal 是迁出表里的玩家来登录时得到的拒绝。
func (away *emigrant) refusal() error {
	if away.moving {
		return gamerehome.Moving(away.move.PlayerID, away.move.To)
	}
	return gamerehome.Elsewhere(away.move.PlayerID, away.move.To)
}

// Reserve 打上“离开中”的标记：从这一刻起他新的请求在写闸门被拒（Admit / AdmitMessage），Serve 与 AdmitBound
// 不再给他建驻留记录，AdmitBound 答“换服中”（saga 步骤退回、不带路由）。
// 已有的驻留记录留着——到交出实体之前，本进程仍是他的写者：标记之前已经准入的请求照常执行完，
// 别的服务发来的通知（公会成员变化）照常写进他的档。
// 副本正在闲置卸载时拒绝：卸载会销毁内存里的实例，让它先结束，玩家稍后再申请。
func (owners *PlayerOwners) Reserve(move gamerehome.Move) error {
	owners.mu.Lock()
	defer owners.mu.Unlock()
	if away := owners.emigrants[move.PlayerID]; away != nil {
		return away.refusal()
	}
	if _, unloading := owners.evictions[move.PlayerID]; unloading {
		return fmt.Errorf("%w: player %d, the copy is being unloaded", ErrNotServedHere, move.PlayerID)
	}
	owners.emigrants[move.PlayerID] = &emigrant{move: move, moving: true, since: owners.now()}
	return nil
}

// Quiesce 让他在本进程里安静下来：断开会话，等到他一条会话都不剩。
//
// 等的是“标记之前已经准入的请求都执行完了”。依据是玩家传输的两条性质（gateway 的 TCP 服务）：一条连接的读循环
// 串行分发请求，同一时刻至多一个在执行；会话要等读循环退出——那个请求的 handler 已经返回，它的 Nest 事务
// 已经提交或失败——之后才从按玩家的会话表里摘掉。所以 ActiveSessions 归零时，本进程里没有任何他自己的请求在执行；
// 新的请求从 Reserve 起就被写闸门拒绝。断开会取消连接的 context：还在等联盟服务应答的入会请求因此很快返回，
// 它在联盟服务那边生效了没有，由离开钩子去问联盟服务（rehome_checks.go）。
//
// 不在这个保证里的：推送失败时被传输提前摘掉的连接（它的 handler 可能还没返回，context 已取消）；
// 不经会话进来的东西——saga 步骤（准入答“换服中”）、成员通知（照常写档，见 Reserve）。
// 没有装连接（Fence）的进程没有会话可等。在 ctx 之内等不到返回错误，调用方中止换服。
func (owners *PlayerOwners) Quiesce(ctx context.Context, move gamerehome.Move) error {
	owners.mu.Lock()
	away, fencer := owners.emigrants[move.PlayerID], owners.fencer
	owners.mu.Unlock()
	if away == nil || away.move.ID != move.ID {
		return fmt.Errorf("player owners: transfer %s of player %d was not reserved", move.ID, move.PlayerID)
	}
	if fencer == nil {
		return nil
	}
	fencer.CloseSessions(move.PlayerID, gamerehome.ErrSessionRehoming)
	ticker := time.NewTicker(quiescePoll)
	defer ticker.Stop()
	for fencer.ActiveSessions(move.PlayerID) > 0 {
		select {
		case <-ctx.Done():
			return fmt.Errorf("player owners: requests of player %d admitted before the move are still running: %w", move.PlayerID, ctx.Err())
		case <-ticker.C:
			// 其间握手进来的连接发不出业务请求（写闸门），一并断开。
			fencer.CloseSessions(move.PlayerID, gamerehome.ErrSessionRehoming)
		}
	}
	return nil
}

// quiescePoll 是 Quiesce 等会话收尾时两次查看之间的间隔。
const quiescePoll = 10 * time.Millisecond

// Depart 让他离开本进程：（再）断开会话 → 离开场景并交出实体（屏障保持）→ 删驻留记录。成功之后
// DataEngine 拒绝写到他的事务。失败是确定的“没有离开”：驻留记录原样，调用方中止换服。
func (owners *PlayerOwners) Depart(ctx context.Context, move gamerehome.Move) error {
	owners.mu.Lock()
	away, fencer, departer := owners.emigrants[move.PlayerID], owners.fencer, owners.depart
	owners.mu.Unlock()
	if away == nil || away.move.ID != move.ID {
		return fmt.Errorf("player owners: transfer %s of player %d was not reserved", move.ID, move.PlayerID)
	}
	if departer == nil {
		return fmt.Errorf("player owners: no way to hand player %d off is assembled", move.PlayerID)
	}
	if fencer != nil {
		fencer.CloseSessions(move.PlayerID, gamerehome.ErrSessionRehoming)
	}
	release, err := departer.DepartPlayer(ctx, move.PlayerID)
	if err != nil {
		return fmt.Errorf("player owners: hand off player %d: %w", move.PlayerID, err)
	}
	owners.mu.Lock()
	defer owners.mu.Unlock()
	delete(owners.residents, move.PlayerID)
	if current := owners.emigrants[move.PlayerID]; current == away {
		away.release = release
	}
	return nil
}

// Settle 落定结论。Committed：记成“已迁走”，屏障保持（没交出过的在这里补交）。Kept / Aborted：撤屏障、
// 删迁出记录，他重新归本进程（驻留记录由下一次 Serve / AdmitBound 建）；Aborted 另外断开他仍连着的会话。
// 撤屏障失败时记录与屏障都保持，返回错误，调用方重试。
func (owners *PlayerOwners) Settle(ctx context.Context, move gamerehome.Move, outcome gamerehome.Outcome) error {
	owners.mu.Lock()
	away, fencer := owners.emigrants[move.PlayerID], owners.fencer
	if outcome == gamerehome.Committed {
		if away == nil || away.move.ID != move.ID {
			away = &emigrant{move: move, moving: true}
			owners.emigrants[move.PlayerID] = away
		}
		if away.moving {
			away.moving, away.since = false, owners.now()
		}
		handed := away.release != nil
		owners.mu.Unlock()
		if handed {
			return nil
		}
		// account 已经改绑而实体还没交出（运维在源服中止到一半时人工提交）：补交。
		return owners.Depart(ctx, move)
	}
	if away == nil || away.move.ID != move.ID {
		owners.mu.Unlock()
		return nil
	}
	release := away.release
	owners.mu.Unlock()
	if release != nil {
		if err := release(ctx); err != nil {
			return fmt.Errorf("player owners: release player %d: %w", move.PlayerID, err)
		}
	}
	owners.mu.Lock()
	if owners.emigrants[move.PlayerID] == away {
		delete(owners.emigrants, move.PlayerID)
	}
	owners.mu.Unlock()
	if outcome == gamerehome.Aborted && fencer != nil {
		fencer.CloseSessions(move.PlayerID, gamerehome.ErrSessionRehomeAborted)
	}
	return nil
}

// Where 回答迁出表里有没有这名玩家。
func (owners *PlayerOwners) Where(playerID int64) (gamerehome.Whereabouts, bool) {
	owners.mu.Lock()
	defer owners.mu.Unlock()
	away := owners.emigrants[playerID]
	if away == nil {
		return gamerehome.Whereabouts{}, false
	}
	return gamerehome.Whereabouts{Move: away.move, Moving: away.moving, Since: away.since}, true
}

var _ gamerehome.Residency = (*PlayerOwners)(nil)

// DepartPlayer 是 demo 对“把这名玩家交出去”的回答（residentDeparter）：离开场景（退订观察者、注销同步对象，
// 与登出同一条路径），再让 DataEngine 交出实体。场景先走：仍有订阅者时，卸载之后框架会为订阅者把实体读回内存。
func (evictor playerEvictor) DepartPlayer(ctx context.Context, playerID int64) (func(context.Context) error, error) {
	if evictor.handOff == nil {
		return nil, fmt.Errorf("player evictor: the dataengine hand-off is not assembled")
	}
	subjectID, err := coreentity.BuildEntityID(playerID, player.EntityKindPlayer)
	if err != nil {
		return nil, err
	}
	if evictor.scene != nil {
		evictor.scene.Leave(ctx, subjectID)
	}
	handed, err := evictor.handOff.HandOffEntity(ctx, subjectID)
	if err != nil {
		return nil, err
	}
	return handed.Release, nil
}

// playerEvictor is the demo's answer to "drop this process's copy of a
// player": off the scene, then out of the entity manager.
//
// The order matters. The room holds the subject's sync state, so a player
// destroyed while still registered would leave the room pointing at a dead
// entity; Scene.Leave unsubscribes the watchers, retires the subject and
// unregisters it, which is the same path a logout takes.
//
// It does NOT delete anything persisted: the document is the authority and is
// exactly what the next load must read. Evicting is forgetting, not deleting.
type playerEvictor struct {
	scene   *Scene
	players *player.Lifecycle
	manager *coreentity.EntityManager
	// handOff is the DataEngine Mod's HandOffEntity, used by DepartPlayer
	// (a player changing servers). nil: no player can be handed off.
	handOff entityHandOff
}

// entityHandOff is the slice of the DataEngine Mod a hand-off uses.
type entityHandOff interface {
	HandOffEntity(ctx context.Context, entityID int64) (*kitdataengine.EntityHandOff, error)
}

func (evictor playerEvictor) EvictPlayer(ctx context.Context, playerID int64) error {
	if evictor.players == nil || evictor.manager == nil {
		return fmt.Errorf("player evictor: not assembled")
	}
	subjectID, err := coreentity.BuildEntityID(playerID, player.EntityKindPlayer)
	if err != nil {
		return err
	}
	// 常驻的玩家只从内存卸载会被框架拒绝（Destroy 返回 ErrEntityResident）；在离开场景之前就拒绝，
	// 否则拒绝时人已经不在场景里了。
	if playerKindIsResident() {
		return fmt.Errorf("player evictor: player %d: %w", playerID, coreentity.ErrEntityResident)
	}
	if evictor.scene != nil {
		evictor.scene.Leave(ctx, subjectID)
	}
	// Resident only. Asking the lifecycle would LOAD the player in order to
	// destroy them, which is a database read and a second copy to answer a
	// question about the first one.
	resident := evictor.manager.GetWithCategory(subjectID, coreentity.MustEntityCategoryOfKind(player.EntityKindPlayer))
	if resident == nil {
		return nil
	}
	typed, ok := resident.(*player.Player)
	if !ok {
		return fmt.Errorf("player evictor: entity %d is a %T", subjectID, resident)
	}
	err = evictor.players.Destroy(ctx, typed, coreentity.DestroyReasonCommon, false)
	switch {
	case err == nil, errors.Is(err, coreentity.ErrEntityRemoved), errors.Is(err, coreentity.ErrEntityNotManaged):
		// Already gone, by this call or by another one. The postcondition —
		// this process has no copy — holds either way.
		return nil
	default:
		return err
	}
}

// playerKindIsResident 报告 Player 这个 kind 是否声明了 lifetime=resident（`//roost:entity lifetime=resident`）。
func playerKindIsResident() bool {
	return coreentity.IsEntityKindResident(player.EntityKindPlayer)
}

var (
	_ residentEvictor  = playerEvictor{}
	_ residentDeparter = playerEvictor{}
)
