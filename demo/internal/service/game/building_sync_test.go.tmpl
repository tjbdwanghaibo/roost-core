// 建筑实体化与同步（可编辑地形方案 §27、§27.10）端到端：建筑是普通的同步实体，走与 Player / Monster 相同的 entitysync
// 链路，订阅跟随玩家与怪（场景的 Manager、提交观察者 on_change、场景主视野、与怪相同的 ShowSubject / HideSubject）。客户端是 terrain_sync_test.go 的 Go 接收端
// （frame.Receiver + 生成的 ApplySyncBuildingDao，与 C# / C++ 同一协议），从回环 socket 读帧。存储是 terrain_test.go 的
// 离线替身；放置规则与参数槽来自工程的配置数据（configs/data，建筑配置表 building / building_param）。

var demoConfigOnce sync.Once

// useDemoConfig 让本进程的缺省配置 Store 是工程的配置数据（configs/data：建筑配置表在里面；同 loadSpawnData）。只装一次；
// 换配置的用例自己换、自己换回。
func useDemoConfig(t *testing.T) {
	t.Helper()
	demoConfigOnce.Do(func() {
		if configdata.DefaultStore() != nil {
			return
		}
		useConfigStore(loadConfigDir(t, filepath.Join("..", "..", "..", "configs", "data")))
	})
}

// useConfigStore 让 store 成为进程的配置：缺省 Store（Nest 之外的 ActiveSnapshot）与请求钉住的运行期快照（Nest 事务里的
// ActiveSnapshot，fctx.RuntimeConfig）。返回换回原来的函数。
func useConfigStore(store *configdata.Store) (restore func()) {
	previousStore, previousConfig := configdata.DefaultStore(), fctx.RuntimeConfig()
	configdata.SetDefaultStore(store)
	fctx.SetRuntimeConfig(store.Current())
	return func() {
		configdata.SetDefaultStore(previousStore)
		fctx.SetRuntimeConfig(previousConfig)
	}
}

// loadConfigDir 装入一个配置目录（全部生成的表）。Store 的加载会把它设成进程的配置（缺省 Store 与运行期快照），这里装完
// 换回原来的，由调用方决定用不用它。
func loadConfigDir(t *testing.T, dir string) *configdata.Store {
	t.Helper()
	previousStore, previousConfig := configdata.DefaultStore(), fctx.RuntimeConfig()
	defer func() {
		configdata.SetDefaultStore(previousStore)
		fctx.SetRuntimeConfig(previousConfig)
	}()
	registry := configdata.NewRegistry()
	if err := generated.RegisterGeneratedConfigData(registry); err != nil {
		t.Fatal(err)
	}
	store := configdata.NewStore(registry, dir)
	if _, err := store.Load(context.Background()); err != nil {
		t.Fatal(err)
	}
	return store
}

// buildingSyncPack 是 8 × 8 块（512m）的平地包：原始值 5000（500m），水位 400m，处处可放。
func buildingSyncPack(t *testing.T, dir string) string {
	t.Helper()
	meta := terrain.Meta{BaseRevision: 1, ChunksX: 8, ChunksY: 8, WaterLevel: 40000}
	path := filepath.Join(dir, "buildings.pack")
	if err := terrain.WritePackFile(path, meta, terrain.Flat(meta, buildingFlat, 3)); err != nil {
		t.Fatal(err)
	}
	return path
}

// startBuildingSyncHarness 起一个接建筑的普通场景进程，接线与生产相同：Nest 装提交观察者（场景按 on_change 发、地形块
// 1 秒一批），场景的世界与 AOI 就是地形图（gamescene.TerrainConfig，与 NewScene 相同），主视野是生产的 sceneMaxVisible，
// attachBuildings 把放置 / 拆除接到场景的 ShowSubject / HideSubject，Start 之后登记启动对账通过的建筑（loadStanding）。
func startBuildingSyncHarness(t *testing.T, pack string, store *memoryChunkStore) *terrainSyncHarness {
	t.Helper()
	return startBuildingSyncHarnessWith(t, pack, store, sceneMaxVisible, true)
}

// startBuildingSyncHarnessWith 同上，主视野的上限由 mainView 给（0 表示不设上限：超额降级的用例用它让会话超过 100）；
// started 为假时不起复制循环，只有测试自己的 Flush（用来让“欠着的 remove”停在两次 Flush 之间）。
func startBuildingSyncHarnessWith(t *testing.T, pack string, store *memoryChunkStore, mainView int, started bool) *terrainSyncHarness {
	t.Helper()
	transport, addr := startScenePlayerTransport(t)
	observer := &sceneSyncObserver{}
	p := startTerrainProcessWith(t, pack, wholeMap, store, func(p *terrainProcess) {
		policy := terrainmap.DefaultPolicy
		policy.EditPointsPerSecond = 0
		p.m.SetPolicy(policy)
	}, nest.NestOptionWithEntitySync(observer))
	bounds := p.m.Meta().Bounds()
	config, err := gamescene.TerrainConfig(bounds)
	if err != nil {
		t.Fatal(err)
	}
	scene, err := newSceneWithObserver(sceneLane{transport: transport}, transport, nil, config, mainView, defaultTerrainSync(bounds), observer)
	if err != nil {
		t.Fatal(err)
	}
	scene.terrain.attach(p.m)
	if scene.attachBuildings(p.m) == nil {
		t.Fatal("the scene takes no buildings")
	}
	scene.watchSessions(transport)
	h := &terrainSyncHarness{ctx: context.Background(), transport: transport, addr: addr, process: p, scene: scene, pack: pack, observer: observer}
	if started {
		if err := scene.Start(h.ctx); err != nil {
			t.Fatal(err)
		}
	}
	h.buildingSync().loadStanding(p.m)
	t.Cleanup(func() { h.close() })
	return h
}

// buildingSync 是场景的建筑接线（放置 / 拆除 → ShowSubject / HideSubject）。
func (h *terrainSyncHarness) buildingSync() *buildingSync { return h.scene.buildings }

// walk 让一个玩家走到 to：与生产的移动相同，场景的主视野跟着玩家的实体走（Interest.Move），地形视野跟着报告的视点走。
func (h *terrainSyncHarness) walk(t *testing.T, playerID int64, to spatial.Point) {
	t.Helper()
	id, err := entity.BuildEntityID(playerID, player.EntityKindPlayer)
	if err != nil {
		t.Fatal(err)
	}
	if err := h.scene.interest.Move(id, to); err != nil {
		t.Fatalf("player %d walking to %v: %v", playerID, to, err)
	}
	h.scene.terrain.moved(playerID, to)
}

// showMonster 与 spawner 一样把一只怪放进场景（ShowSubject：登记、放进主视野）。
func (h *terrainSyncHarness) showMonster(t *testing.T, uniqueID int64, at spatial.Point) int64 {
	t.Helper()
	monster.RegisterEntity()
	id, err := entity.BuildEntityID(uniqueID, monster.EntityKindMonster)
	if err != nil {
		t.Fatal(err)
	}
	built, err := entity.BuildEntity(&entity.EntityCreateParam{IsCreate: true, Kind: monster.EntityKindMonster, Id: id})
	if err != nil {
		t.Fatal(err)
	}
	value := built.(*monster.Monster)
	if err := h.scene.ShowSubject(h.ctx, value.Sync(), value.ID(), at); err != nil {
		t.Fatal(err)
	}
	return value.ID()
}

// heldIn 是客户端此刻持有的、命名空间为 namespace 的对象。
func (client *terrainClient) heldIn(namespace string) map[int64]bool {
	client.mu.Lock()
	defer client.mu.Unlock()
	out := map[int64]bool{}
	for id, ns := range client.namespaces {
		if ns == namespace {
			out[id] = true
		}
	}
	return out
}

// heldCount 是客户端此刻持有的对象数（全部命名空间）。
func (client *terrainClient) heldCount() int {
	client.mu.Lock()
	defer client.mu.Unlock()
	return len(client.namespaces)
}

// lotCentreOf 是一座站着的建筑的占地中心（它在主视野里的位置）。
func lotCentreOf(t *testing.T, h *terrainSyncHarness, id int64) spatial.Point {
	t.Helper()
	gx, gy := building.AnchorOf(id)
	return lotCentre(buildingAt(t, h.process, gx, gy).Lot)
}


// close 关场景（可重复调用）。
func (h *terrainSyncHarness) close() {
	closeCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	_ = h.scene.Close(closeCtx)
}

// clientBuilding 是客户端持有的建筑（Apply 合并好的完整 SyncBuildingDao）；没有时 nil。
func (client *terrainClient) building(id int64) *db.SyncBuildingDao {
	client.mu.Lock()
	defer client.mu.Unlock()
	return client.buildings[id]
}

// heldBuildings 是客户端持有的建筑 ID。
func (client *terrainClient) heldBuildings() []int64 {
	client.mu.Lock()
	defer client.mu.Unlock()
	var out []int64
	for id := range client.buildings {
		out = append(out, id)
	}
	slices.Sort(out)
	return out
}

// buildingMatches 报告客户端的这座建筑是否正是服务端实体此刻的同步字段（ConfigID、Params、属主、锚点、朝向、地基、站着）。
func buildingMatches(got *db.SyncBuildingDao, want building.State) bool {
	if got == nil || !want.Standing {
		return false
	}
	foundation := int32(-1 << 31)
	if want.Leveled {
		foundation = want.Foundation
	}
	var params []int32
	if got.Params != nil {
		params = got.Params.Value
	}
	// 值为零的字段（锚点 0、朝向 0）在全量里可能不带：按零读。
	var gx, gy, facing int32
	if got.GX != nil {
		gx = got.GX.Value
	}
	if got.GY != nil {
		gy = got.GY.Value
	}
	if got.Facing != nil {
		facing = got.Facing.Value
	}
	return got.State != nil && got.State.Value == 1 && got.Owner != nil && got.Owner.Value == want.Owner &&
		got.ConfigID != nil && got.ConfigID.Value == want.ConfigID && slices.Equal(params, want.Params) &&
		int64(gx) == want.Lot.GX && int64(gy) == want.Lot.GY && facing == want.Facing &&
		got.Foundation != nil && got.Foundation.Value == foundation
}

// buildingUpdatesOf 是 frames 里 subject 的全部建筑更新。
func buildingUpdatesOf(frames []receivedFrame, subject int64) []buildingUpdate {
	var out []buildingUpdate
	for _, f := range frames {
		for _, u := range f.buildings {
			if u.subject == subject {
				out = append(out, u)
			}
		}
	}
	return out
}

const (
	buildingViewer    = int64(30201) // 连着 TCP、看建筑的玩家
	buildingNeighbour = int64(30202) // 连着 TCP、站在看建筑的玩家附近的另一个玩家
	buildingBuilder   = buildingOwner // 放置 / 改参数的玩家（不连接）
)

// 建筑与玩家、怪走同一条同步链路、同一个场景主视野（方案 §27、§27.10）：另一个玩家的 TCP 客户端站在 hall 上，看到它出现
// （全量：配置 ID、补齐的参数、锚点、朝向、地基、属主）、参数修改（on_change 增量，只有 Params）；走出主视野（3m 外，主视野
// 离开半径 1.5m）hall 从客户端消失，走到远处的 tower 上看到 tower，走回来 hall 再以全量出现（带此刻的参数）；拆除收到
// remove；同一锚点再放一座（同一个实体）照样出现——包括拆除的 remove 还没发出去就再放（退役之后再登记，先 remove 后 create）。
func TestBuildingsReachAnotherClientOverRealTCP(t *testing.T) {
	h := startBuildingSyncHarness(t, buildingSyncPack(t, t.TempDir()), &memoryChunkStore{})
	m := h.process.m
	// hall 放在 (110, 100)、朝向 1（占地 6 × 8）：占地中心 (112.5m, 103.5m)。看的人先站在那里。
	home := spatial.Point{X: 11250, Y: 10350}
	client := h.join(t, buildingViewer, home)

	// 主视野里的一座 hall，只给第一个参数，第二个取缺省；远处一座 tower，在主视野外。
	hallAt := building.Placement{ConfigID: 2, GX: 110, GY: 100, Facing: 1, Params: []int32{3}}
	placed, err := m.Place(h.ctx, buildingBuilder, 1, hallAt)
	if err != nil {
		t.Fatal(err)
	}
	if !slices.Equal(placed.Building.Params, []int32{3, 0}) || placed.Building.Lot.W != 6 || placed.Building.Lot.H != 8 || lotCentre(placed.Building.Lot) != home {
		t.Fatalf("the placed hall: %+v", placed.Building)
	}
	far, err := m.Place(h.ctx, buildingBuilder, 2, building.Placement{ConfigID: 3, GX: 450, GY: 450})
	if err != nil {
		t.Fatal(err)
	}
	hallID, farID := placed.Building.ID, far.Building.ID
	state := func(id int64) building.State {
		t.Helper()
		gx, gy := building.AnchorOf(id)
		return buildingAt(t, h.process, gx, gy)
	}
	h.flushUntil(t, "the hall on the viewer's client", func() bool { return buildingMatches(client.building(hallID), state(hallID)) })
	if held := client.heldBuildings(); !slices.Equal(held, []int64{hallID}) {
		t.Fatalf("the viewer holds buildings %v, want only the hall %d (the tower is 480m away)", held, hallID)
	}
	frames := client.takeFrames()
	if ups := buildingUpdatesOf(frames, hallID); len(ups) == 0 || !ups[0].full {
		t.Fatalf("the hall entering view: %+v, want a full update first", ups)
	}
	full := buildingUpdatesOf(frames, hallID)[0]

	// 改参数：属主改，客户端收到 Params；非属主、重复序号什么都不写。
	if _, err := m.SetParams(h.ctx, buildingOther, 1, 110, 100, []int32{7, 7}); !errors.Is(err, terrainmap.ErrDenied) {
		t.Fatalf("another player changing the hall: %v", err)
	}
	changed, err := m.SetParams(h.ctx, buildingBuilder, 3, 110, 100, []int32{5, 9})
	if err != nil || !slices.Equal(changed.Building.Params, []int32{5, 9}) {
		t.Fatalf("the owner changing the hall: %+v, %v", changed, err)
	}
	if again, err := m.SetParams(h.ctx, buildingBuilder, 3, 110, 100, []int32{1, 1}); err != nil || !again.Duplicate || !slices.Equal(again.Building.Params, []int32{5, 9}) {
		t.Fatalf("the same change again: %+v, %v", again, err)
	}
	h.flushUntil(t, "the parameter change on the viewer's client", func() bool { return buildingMatches(client.building(hallID), state(hallID)) })
	// 第一次改动可能以全量（重同步）到达：放置事务的脏位在登记之前就记在实体的同步状态上，按 on_change 的合并窗口，新订阅
	// 先只拿快照、保留脏位，于是下一次捕获只能用全量追上（entitysync 的通用规则，玩家、怪同样，方案 §27 记录）。之后的
	// 改动是只带 Params 的增量。
	if ups := buildingUpdatesOf(client.takeFrames(), hallID); len(ups) != 1 || !ups[0].params {
		t.Fatalf("the first parameter change went out as %+v, want one update carrying the parameters", ups)
	}
	if _, err := m.SetParams(h.ctx, buildingBuilder, 4, 110, 100, []int32{6}); err != nil {
		t.Fatal(err)
	}
	h.flushUntil(t, "the second parameter change on the viewer's client", func() bool { return buildingMatches(client.building(hallID), state(hallID)) })
	if got := client.building(hallID).Params.Value; !slices.Equal(got, []int32{6, 0}) {
		t.Fatalf("the client's parameters after [6]: %v, want [6 0] (the second slot back to its default)", got)
	}
	ups := buildingUpdatesOf(client.takeFrames(), hallID)
	if len(ups) != 1 || ups[0].full || !ups[0].params {
		t.Fatalf("the second parameter change went out as %+v, want one delta carrying the parameters", ups)
	}
	delta := ups[0]

	// 走出主视野：3m 外 hall 消失（建筑跟着主视野走，不再有 200m 的建筑视野）；走到 tower 上看到 tower；走回来 hall 以
	// 全量回来（带改过的参数），tower 走掉。
	h.walk(t, buildingViewer, spatial.Point{X: home.X + 300, Y: home.Y})
	h.flushUntil(t, "the hall leaving the main view 3m away", func() bool { return len(client.heldBuildings()) == 0 })
	h.walk(t, buildingViewer, lotCentreOf(t, h, farID))
	h.flushUntil(t, "the tower in the main view", func() bool {
		return slices.Equal(client.heldBuildings(), []int64{farID}) && buildingMatches(client.building(farID), state(farID))
	})
	h.walk(t, buildingViewer, home)
	h.flushUntil(t, "the hall back in view", func() bool {
		return slices.Equal(client.heldBuildings(), []int64{hallID}) && buildingMatches(client.building(hallID), state(hallID))
	})
	if ups := buildingUpdatesOf(client.takeFrames(), hallID); len(ups) == 0 || !ups[0].full {
		t.Fatalf("the hall coming back into view: %+v, want a full update", ups)
	}

	// 拆除：客户端收到 remove；同一锚点再放一座 hut（同一个实体），站到它上面看到它。
	if _, err := m.Remove(h.ctx, buildingBuilder, 5, 110, 100); err != nil {
		t.Fatal(err)
	}
	h.flushUntil(t, "the removal on the viewer's client", func() bool { return len(client.heldBuildings()) == 0 })
	hut, err := m.Place(h.ctx, buildingBuilder, 6, building.Placement{ConfigID: 1, GX: 110, GY: 100, Params: []int32{6}})
	if err != nil || hut.Building.ID != hallID {
		t.Fatalf("a hut on the hall's anchor: %+v, %v", hut, err)
	}
	h.walk(t, buildingViewer, lotCentre(hut.Building.Lot))
	h.flushUntil(t, "the hut on the viewer's client", func() bool { return buildingMatches(client.building(hallID), state(hallID)) })
	if got := client.building(hallID); got.ConfigID.Value != 1 || !slices.Equal(got.Params.Value, []int32{6}) {
		t.Fatalf("the client's hut: %+v", got)
	}
	// 拆了马上再放：客户端最后持有的是新放的 tower（remove 还没发出去时的次序见 TestABuildingPlacedAgainBeforeItsRemoveWentOut）。
	if _, err := m.Remove(h.ctx, buildingBuilder, 7, 110, 100); err != nil {
		t.Fatal(err)
	}
	if _, err := m.Place(h.ctx, buildingBuilder, 8, building.Placement{ConfigID: 3, GX: 110, GY: 100}); err != nil {
		t.Fatal(err)
	}
	h.flushUntil(t, "the tower placed again before the hut's remove went out", func() bool {
		got := client.building(hallID)
		return got != nil && got.ConfigID.Value == 3 && buildingMatches(got, state(hallID))
	})
	if err := client.failure(); err != nil {
		t.Fatal(err)
	}
	if lost := h.scene.manager.Stats().SessionsLost; lost != 0 {
		t.Fatalf("%d replication sessions were lost", lost)
	}
	// 预算（方案 §27）：一座建筑的全量与改参数的增量都只有几十字节。
	t.Logf("building full: component %d bytes (payload %d); parameter delta: component %d bytes (payload %d)",
		full.componentBytes, full.payloadBytes, delta.componentBytes, delta.payloadBytes)
	if full.componentBytes > 160 || delta.componentBytes > 112 {
		t.Fatalf("building updates are bigger than the §27 budget assumed: full %d, delta %d bytes", full.componentBytes, delta.componentBytes)
	}
}

// 拆除的 remove 还没发出去就在同一锚点再放（同一个实体 ID）：拆除经 HideSubject 让 subject 退役、欠看着它的客户端一个
// remove，再放经 ShowSubject 把登记排在退役之后——客户端先收到 remove，再收到新放的 tower 的全量，最后持有 tower。
// 复制循环不跑，两次 Flush 之间的次序是确定的。
func TestABuildingPlacedAgainBeforeItsRemoveWentOut(t *testing.T) {
	h := startBuildingSyncHarnessWith(t, buildingSyncPack(t, t.TempDir()), &memoryChunkStore{}, sceneMaxVisible, false)
	m := h.process.m
	placed, err := m.Place(h.ctx, buildingBuilder, 1, building.Placement{ConfigID: 1, GX: 110, GY: 100})
	if err != nil {
		t.Fatal(err)
	}
	id := placed.Building.ID
	client := h.join(t, buildingViewer, lotCentre(placed.Building.Lot))
	h.flushUntil(t, "the hut on the client", func() bool { return client.building(id) != nil })
	client.takeFrames()
	if _, err := m.Remove(h.ctx, buildingBuilder, 2, 110, 100); err != nil {
		t.Fatal(err)
	}
	if _, err := m.Place(h.ctx, buildingBuilder, 3, building.Placement{ConfigID: 3, GX: 110, GY: 100}); err != nil {
		t.Fatal(err)
	}
	h.flushUntil(t, "the tower placed again on the client", func() bool {
		got := client.building(id)
		return got != nil && got.ConfigID.Value == 3
	})
	gx, gy := building.AnchorOf(id)
	if got := client.building(id); !buildingMatches(got, buildingAt(t, h.process, gx, gy)) {
		t.Fatalf("the client's tower: %+v", got)
	}
	if ups := buildingUpdatesOf(client.takeFrames(), id); len(ups) == 0 || !ups[len(ups)-1].full {
		t.Fatalf("the tower placed again arrived as %+v, want a full update", ups)
	}
	if err := client.failure(); err != nil {
		t.Fatal(err)
	}
}

// 建筑没有自己的订阅来源与同步配置（方案 §27.10）：Manager 的按命名空间配置里只有地形块，会话引用表上限是场景的 100 加
// 地形的 64；按类型的调度里只有地形块（1 秒一批），建筑与玩家、怪一样没有条目、按 Manager 的模式（on_change）发。
func TestBuildingsHaveNoReplicationOfTheirOwn(t *testing.T) {
	limits := terrainNamespaceLimits()
	if _, own := limits[building.SyncNamespaceBuilding]; own || len(limits) != 1 {
		t.Fatalf("the scene manager's namespace limits: %+v, want only %q", limits, terrainNamespace)
	}
	if got := limits[terrainNamespace]; got.MaxObjects != terrainMaxVisible || got.SnapshotBudget.PerSessionObjects != terrainSnapshotsPerFlush {
		t.Fatalf("the terrain namespace: %+v", got)
	}
	if want := frame.DefaultLimits().MaxObjects + terrainMaxVisible; sceneTerrainMaxObjects != want {
		t.Fatalf("a session's object table holds %d, want %d (players, monsters, buildings and the scene 100 + terrain 64)", sceneTerrainMaxObjects, want)
	}
	if sceneTerrainMaxObjects != 164 {
		t.Fatalf("a session's object table holds %d, want 164", sceneTerrainMaxObjects)
	}
	schedules := sceneTypeSchedules()
	if _, own := schedules[uint32(building.EntityKindBuilding)]; own || len(schedules) != 1 {
		t.Fatalf("the scene manager's type schedules: %+v, want only the terrain chunk", schedules)
	}
	if got := schedules[uint32(terrain_chunk.EntityKindTerrainChunk)]; got.Mode != entitysync.ModePeriodic || got.Interval != time.Second {
		t.Fatalf("the terrain chunk's schedule: %+v", got)
	}
	h := startBuildingSyncHarness(t, buildingSyncPack(t, t.TempDir()), &memoryChunkStore{})
	if mode := h.scene.manager.Mode(); mode != entitysync.ModeOnChange {
		t.Fatalf("the scene manager sends %v, want on_change for buildings like for players and monsters", mode)
	}
}

// 四座 tower 围着看的人（占地中心都在 2.12m，客户端要了 2.4m 的视野）：主视野的“最近 64 个”里建筑与玩家、怪一起按距离
// 排，4 座 tower + 60 只更远一点的怪正好 64 个，站在 2.35m 的另一个玩家被挤出主视野。拆掉一座 tower 空出一个位置：AOI 的
// MaxVisible 是近似的（policy.AOIConfig：被忽略的目标在它下一次移动时重新参选，不在空出位置的那一刻），所以另一个玩家
// 动一下才进来。反过来，先被怪占满、后放的 tower 被忽略：建筑从不移动，怪走掉之后看的人自己动一下才看见它们（方案 §27.10
// 记录的 demo 尺度影响；“站着不动看不见”这一半只记日志，不作断言）。
func TestBuildingsTakeMainViewPlacesLikeAnyoneElse(t *testing.T) {
	h := startBuildingSyncHarness(t, buildingSyncPack(t, t.TempDir()), &memoryChunkStore{})
	m := h.process.m
	towers := [][2]int64{{100, 100}, {103, 100}, {100, 103}, {103, 103}}
	for i, at := range towers {
		if _, err := m.Place(h.ctx, buildingBuilder, uint64(i+1), building.Placement{ConfigID: 3, GX: at[0], GY: at[1]}); err != nil {
			t.Fatal(err)
		}
	}
	// 四座 tower 的公共角：到每个占地中心 √(150² + 150²) ≈ 212cm。
	corner := spatial.Point{X: 10250, Y: 10250}
	client := h.join(t, buildingViewer, corner)
	if view, err := h.scene.SetView(buildingViewer, policy.ObserverView{Radius: 240}); err != nil || view.Radius != 240 {
		t.Fatalf("a 2.4m view: %+v, %v", view, err)
	}
	neighbourAt := spatial.Point{X: corner.X, Y: corner.Y + 235}
	neighbourClient := h.join(t, buildingNeighbour, neighbourAt)
	neighbour, err := entity.BuildEntityID(buildingNeighbour, player.EntityKindPlayer)
	if err != nil {
		t.Fatal(err)
	}
	const monsters = sceneMaxVisible - 4
	monsterIDs := make([]int64, 0, monsters)
	for i := range monsters {
		// 216～232cm，一圈排开：比 tower 远、比另一个玩家近。
		r := 216 + float64(i%17)
		angle := 2 * math.Pi * float64(i) / monsters
		at := spatial.Point{X: corner.X + int64(r*math.Cos(angle)), Y: corner.Y + int64(r*math.Sin(angle))}
		monsterIDs = append(monsterIDs, h.showMonster(t, 7600+int64(i), at))
	}
	h.flushUntil(t, "the four towers and the monsters in the main view", func() bool {
		return len(client.heldIn(building.SyncNamespaceBuilding)) == 4 && len(client.heldIn("monster")) == monsters
	})
	if client.heldIn("player")[neighbour] {
		t.Fatalf("the neighbour 2.35m away is still held: the main view holds %d objects", client.heldCount())
	}
	t.Logf("main view full: %d buildings, %d monsters, neighbour held %v (objects held %d: itself + %d in the main view)",
		len(client.heldIn(building.SyncNamespaceBuilding)), len(client.heldIn("monster")), client.heldIn("player")[neighbour], client.heldCount(), client.heldCount()-1)
	if _, err := m.Remove(h.ctx, buildingBuilder, 5, towers[0][0], towers[0][1]); err != nil {
		t.Fatal(err)
	}
	h.flushUntil(t, "the removed tower leaving", func() bool { return len(client.heldIn(building.SyncNamespaceBuilding)) == 3 })
	t.Logf("a tower removed, nobody moved: neighbour held %v", client.heldIn("player")[neighbour])
	h.walk(t, buildingNeighbour, spatial.Point{X: neighbourAt.X, Y: neighbourAt.Y - 1})
	h.flushUntil(t, "the neighbour taking the removed tower's place once it moves", func() bool {
		return client.heldIn("player")[neighbour] && len(client.heldIn("monster")) == monsters
	})

	// 先被怪占满，后放的 tower（比怪远）被忽略；怪走掉 10 只之后，看的人站着不动时 tower 不会自己进来，动 1cm 就进来。
	for _, id := range monsterIDs {
		h.scene.HideSubject(h.ctx, id)
	}
	h.walk(t, buildingNeighbour, spatial.Point{X: corner.X + 30000, Y: corner.Y})
	if _, err := m.Remove(h.ctx, buildingBuilder, 6, towers[1][0], towers[1][1]); err != nil {
		t.Fatal(err)
	}
	h.flushUntil(t, "the main view emptied", func() bool { return client.heldCount() == 3 })
	crowd := make([]int64, 0, sceneMaxVisible)
	for i := range sceneMaxVisible {
		r := 100 + float64(i%50)
		angle := 2 * math.Pi * float64(i) / sceneMaxVisible
		crowd = append(crowd, h.showMonster(t, 7700+int64(i), spatial.Point{X: corner.X + int64(r*math.Cos(angle)), Y: corner.Y + int64(r*math.Sin(angle))}))
	}
	h.flushUntil(t, "a crowd of monsters closer than the towers", func() bool {
		return len(client.heldIn("monster")) == sceneMaxVisible && len(client.heldIn(building.SyncNamespaceBuilding)) == 0
	})
	for i, at := range towers[:2] {
		if _, err := m.Place(h.ctx, buildingBuilder, uint64(7+i), building.Placement{ConfigID: 3, GX: at[0], GY: at[1]}); err != nil {
			t.Fatal(err)
		}
	}
	for _, id := range crowd[:10] {
		h.scene.HideSubject(h.ctx, id)
	}
	h.flushUntil(t, "ten monsters leaving", func() bool { return len(client.heldIn("monster")) == sceneMaxVisible-10 })
	for range 10 {
		if err := h.scene.Flush(h.ctx); err != nil {
			t.Fatal(err)
		}
		time.Sleep(2 * time.Millisecond)
	}
	t.Logf("ten monsters gone, the viewer standing still: %d of 4 towers held (free places %d)",
		len(client.heldIn(building.SyncNamespaceBuilding)), sceneMaxVisible-(client.heldCount()-1))
	h.walk(t, buildingViewer, spatial.Point{X: corner.X + 1, Y: corner.Y})
	h.flushUntil(t, "the towers once the viewer moves", func() bool { return len(client.heldIn(building.SyncNamespaceBuilding)) == 4 })
	for _, c := range []*terrainClient{client, neighbourClient} {
		if err := c.failure(); err != nil {
			t.Fatal(err)
		}
	}
	if lost := h.scene.manager.Stats().SessionsLost; lost != 0 {
		t.Fatalf("%d replication sessions were lost", lost)
	}
}

// 会话超额（D17）时建筑与玩家、怪一起降级：主视野不设上限，97 只怪（1.2～2m）加 4 座 tower（2.12m）加自身是 102 个对象，
// 超过会话的 100。会话不断开，收敛到 100 个：自身、97 只怪与 2 座 tower（建筑与怪同在缺省一类，按距离丢最远的，4 座
// 等距）。拆掉留着的两座，暂缓的两座随即进来。
func TestManyBuildingsDegradeWithTheCrowd(t *testing.T) {
	h := startBuildingSyncHarnessWith(t, buildingSyncPack(t, t.TempDir()), &memoryChunkStore{}, 0, true)
	m := h.process.m
	for i, at := range [][2]int64{{100, 100}, {103, 100}, {100, 103}, {103, 103}} {
		if _, err := m.Place(h.ctx, buildingBuilder, uint64(i+1), building.Placement{ConfigID: 3, GX: at[0], GY: at[1]}); err != nil {
			t.Fatal(err)
		}
	}
	corner := spatial.Point{X: 10250, Y: 10250}
	client := h.join(t, buildingViewer, corner)
	if view, err := h.scene.SetView(buildingViewer, policy.ObserverView{Radius: 240}); err != nil || view.Radius != 240 {
		t.Fatalf("a 2.4m view: %+v, %v", view, err)
	}
	const monsters = 97
	for i := range monsters {
		r := 120 + float64(i%80)
		angle := 2 * math.Pi * float64(i) / monsters
		h.showMonster(t, 7800+int64(i), spatial.Point{X: corner.X + int64(r*math.Cos(angle)), Y: corner.Y + int64(r*math.Sin(angle))})
	}
	disconnectsBefore := sessionLostDisconnects()
	limit := frame.DefaultLimits().MaxObjects
	h.flushUntil(t, "the viewer's session settled at its limit", func() bool {
		stats := h.scene.manager.Stats()
		return stats.OverLimitWaiting == 0 && client.heldCount() == limit && len(client.heldIn("monster")) == monsters
	})
	stats := h.scene.manager.Stats()
	if stats.OverLimitDeferred == 0 {
		t.Fatal("no object was ever deferred: the buildings did not count with the crowd (the test's premise)")
	}
	if got := len(client.heldIn(building.SyncNamespaceBuilding)); got != 2 {
		t.Fatalf("the viewer holds %d towers, want the 2 that fit in %d objects", got, limit)
	}
	if stats.SessionsLost != 0 || sessionLostDisconnects() != disconnectsBefore {
		t.Fatalf("the crowd lost %d sessions", stats.SessionsLost)
	}
	t.Logf("over the limit: deferred %d, evicted %d; held %d objects, %d buildings, %d monsters",
		stats.OverLimitDeferred, stats.OverLimitEvicted, client.heldCount(), len(client.heldIn(building.SyncNamespaceBuilding)), len(client.heldIn("monster")))
	// 拆掉留着的两座：暂缓的两座进来（超额降级的放回不等谁移动）。
	held := client.heldBuildings()
	for i, id := range held {
		gx, gy := building.AnchorOf(id)
		if _, err := m.Remove(h.ctx, buildingBuilder, uint64(5+i), gx, gy); err != nil {
			t.Fatal(err)
		}
	}
	h.flushUntil(t, "the two deferred towers once the held ones are removed", func() bool {
		got := client.heldBuildings()
		return len(got) == 2 && !slices.Contains(got, held[0]) && !slices.Contains(got, held[1]) && client.heldCount() == limit
	})
	if err := client.failure(); err != nil {
		t.Fatal(err)
	}
}

// demo 尺度下主视野对建筑的实际效果（方案 §27.10 的测量）：建筑按占地中心进主视野，主视野进入半径 1.2m、客户端最大
// 2.7m（离开 3m）。站在每座建筑旁边紧挨着的空节点上（离占地中心 (边长 + 1) / 2 米，取短边一侧）：缺省视野四种建筑
// 都看不见；最大视野只看得见 hut（2.5m）与 tower（2m），hall（3.5m）与 keep（6.5m）看不见。站到 keep 的中心才看得见它。
// 这条钉住的是 demo 现在的尺度；主视野的半径若按维护者的决定调整，按新尺度改这里的期望。
func TestBuildingsAtTheDemoMainViewScale(t *testing.T) {
	h := startBuildingSyncHarness(t, buildingSyncPack(t, t.TempDir()), &memoryChunkStore{})
	m := h.process.m
	const wide = buildingNeighbour // 要了最大视野的玩家
	near := h.join(t, buildingViewer, spatial.Point{X: 5000, Y: 5000})
	far := h.join(t, wide, spatial.Point{X: 5000, Y: 5000})
	view, err := h.scene.SetView(wide, policy.ObserverView{Radius: 100_000})
	if err != nil || view.Radius != sceneMaxLeaveRadius-(sceneLeaveRadius-sceneEnterRadius) {
		t.Fatalf("the widest view: %+v, %v", view, err)
	}
	cases := []struct {
		name            string
		placement       building.Placement
		nearSees, wideSees bool
	}{
		{"hut 4×4", building.Placement{ConfigID: 1, GX: 100, GY: 100}, false, true},
		{"tower 3×3", building.Placement{ConfigID: 3, GX: 140, GY: 100}, false, true},
		{"hall 8×6", building.Placement{ConfigID: 2, GX: 180, GY: 100}, false, false},
		{"keep 12×12", building.Placement{ConfigID: 4, GX: 220, GY: 100, Level: true}, false, false},
	}
	for i, c := range cases {
		placed, err := m.Place(h.ctx, buildingBuilder, uint64(i+1), c.placement)
		if err != nil {
			t.Fatalf("%s: %v", c.name, err)
		}
		lot, centre := placed.Building.Lot, lotCentre(placed.Building.Lot)
		// 短边一侧、紧挨着占地的空节点：离中心 (短边 + 1) / 2 米。
		probe := spatial.Point{X: centre.X - (int64(lot.W)+1)*terrain.SampleSpacing/2, Y: centre.Y}
		if lot.H < lot.W {
			probe = spatial.Point{X: centre.X, Y: centre.Y - (int64(lot.H)+1)*terrain.SampleSpacing/2}
		}
		h.walk(t, buildingViewer, probe)
		h.walk(t, wide, probe)
		// 同一处放一只怪作参照：两人都收到它时，同一次政策结算里该进视野的建筑也已经到了。
		marker := h.showMonster(t, 7900+int64(i), spatial.Point{X: probe.X, Y: probe.Y + 10})
		h.flushUntil(t, c.name+": the marker on both clients", func() bool {
			return near.heldIn("monster")[marker] && far.heldIn("monster")[marker]
		})
		id := placed.Building.ID
		nearSees, wideSees := near.heldIn(building.SyncNamespaceBuilding)[id], far.heldIn(building.SyncNamespaceBuilding)[id]
		t.Logf("%s: centre %.1fm from the node next to it; default view (1.2m) sees it %v, widest view (%.1fm) sees it %v",
			c.name, math.Sqrt(float64(spatial.DistanceSquared(centre, probe)))/100, nearSees, float64(view.Radius)/100, wideSees)
		if nearSees != c.nearSees || wideSees != c.wideSees {
			t.Fatalf("%s next to it: default view sees it %v (want %v), widest view %v (want %v)", c.name, nearSees, c.nearSees, wideSees, c.wideSees)
		}
		h.scene.HideSubject(h.ctx, marker)
		if i == len(cases)-1 {
			h.walk(t, buildingViewer, centre)
			h.flushUntil(t, "the keep seen from its centre", func() bool { return near.heldIn(building.SyncNamespaceBuilding)[id] })
		}
	}
}

// 重启之后，同步与库一致：启动对账核对通过的建筑登记进场景，重新登录的客户端走到每座建筑上收到的正是库里的建筑（配置 ID、
// 改过的参数、朝向、地基）；拆掉的那座不出现。
func TestBuildingSyncAfterARestart(t *testing.T) {
	dir := t.TempDir()
	pack := buildingSyncPack(t, dir)
	store := &memoryChunkStore{}
	h := startBuildingSyncHarness(t, pack, store)
	m := h.process.m
	for i, p := range []building.Placement{
		{ConfigID: 2, GX: 110, GY: 100, Facing: 1, Params: []int32{3, 4}},
		{ConfigID: 4, GX: 140, GY: 90, Level: true},
		{ConfigID: 1, GX: 100, GY: 130},
	} {
		if _, err := m.Place(h.ctx, buildingBuilder, uint64(i+1), p); err != nil {
			t.Fatalf("placement %d: %v", i, err)
		}
	}
	if _, err := m.SetParams(h.ctx, buildingBuilder, 4, 110, 100, []int32{6}); err != nil {
		t.Fatal(err)
	}
	removedAt := lotCentre(buildingAt(t, h.process, 100, 130).Lot)
	if _, err := m.Remove(h.ctx, buildingBuilder, 5, 100, 130); err != nil {
		t.Fatal(err)
	}
	want := buildingsOf(h.process)
	if len(want) != 2 || !slices.Equal(want[0].Params, []int32{6, 0}) && !slices.Equal(want[1].Params, []int32{6, 0}) {
		t.Fatalf("before the restart: %+v", want)
	}
	h.close()
	h.process.stop()
	h.process.persist(store)

	again := startBuildingSyncHarness(t, pack, store)
	if again.process.buildingStats != (terrainmap.BuildingStats{Standing: 2}) {
		t.Fatalf("reconcile after the restart: %+v", again.process.buildingStats)
	}
	if n := again.buildingSync().standingCount(); n != 2 {
		t.Fatalf("%d buildings registered for replication after the restart, want 2", n)
	}
	client := again.join(t, buildingViewer, lotCentre(want[0].Lot))
	for _, b := range want {
		again.walk(t, buildingViewer, lotCentre(b.Lot))
		again.flushUntil(t, "a restarted building on a client", func() bool {
			return slices.Equal(client.heldBuildings(), []int64{b.ID}) && buildingMatches(client.building(b.ID), b)
		})
	}
	// 拆掉的那座：站在它原来的位置，参照的怪到了，建筑没有。
	again.walk(t, buildingViewer, removedAt)
	marker := again.showMonster(t, 7990, removedAt)
	again.flushUntil(t, "the marker where the removed hut stood", func() bool { return client.heldIn("monster")[marker] })
	if held := client.heldBuildings(); len(held) != 0 {
		t.Fatalf("the removed hut came back after the restart: %v", held)
	}
	if got := buildingsOf(again.process); !sameBuildings(got, want) {
		t.Fatalf("buildings after the restart:\n%+v\nwant\n%+v", got, want)
	}
}

// 放置 / 拆除的提交后回调可能乱序到达：建筑同步只认锚点块更大的 LotRevision，迟到的“拆了”不会把站着的建筑撤出主视野，
// 迟到的“放了”也不会把拆了的建筑放回来。
func TestBuildingSyncTakesTheLatestRevision(t *testing.T) {
	h := startBuildingSyncHarness(t, buildingSyncPack(t, t.TempDir()), &memoryChunkStore{})
	m, sync := h.process.m, h.buildingSync()
	if _, err := m.Place(h.ctx, buildingBuilder, 1, building.Placement{ConfigID: 1, GX: 110, GY: 100}); err != nil {
		t.Fatal(err)
	}
	id, err := building.EntityID(110, 100)
	if err != nil {
		t.Fatal(err)
	}
	b, _ := h.process.entities.Get(id).(*building.Building)
	lot := terrainmap.BuildingCommit{Building: b, Lot: buildingAt(t, h.process, 110, 100).Lot}
	rev := m.ReconciledBuildings() // 空：建筑是启动之后放的
	if len(rev) != 0 || sync.standingCount() != 1 {
		t.Fatalf("after the placement: reconciled %d, standing %d", len(rev), sync.standingCount())
	}
	// 放置提交写了锚点块的 LotRevision 1：一份修订号 1 的“拆了”是迟到的，丢掉。
	late := lot
	late.Revision, late.Standing = 1, false
	sync.committed(late)
	if sync.standingCount() != 1 {
		t.Fatal("a late removal notice hid a standing building")
	}
	client := h.join(t, buildingViewer, lotCentre(lot.Lot))
	h.flushUntil(t, "the hut on the client", func() bool { return len(client.heldBuildings()) == 1 })
	// 真的拆除（修订号 2），然后迟到的“放了”（修订号 1）：建筑保持撤出。
	if _, err := m.Remove(h.ctx, buildingBuilder, 2, 110, 100); err != nil {
		t.Fatal(err)
	}
	stale := lot
	stale.Revision, stale.Standing = 1, true
	sync.committed(stale)
	if sync.standingCount() != 0 {
		t.Fatal("a late placement notice showed a removed building")
	}
	h.flushUntil(t, "the removal on the client", func() bool { return len(client.heldBuildings()) == 0 })
}

// 改参数（方案 §27）：只有属主能改；同一（玩家, 序号）只生效一次，与笔刷、放置共用账本（用过的序号答 Duplicate）；个数多于槽、
// 值越界、锚点上没有建筑都在写任何东西之前拒绝；没给的槽取缺省值；参数不改变占地（块的记录、占位、地形都不动）。
func TestBuildingParamsChangeOncePerSeqByTheOwner(t *testing.T) {
	p := buildingProcess(t, buildingPack(t, t.TempDir(), 1), &memoryChunkStore{}, nil)
	if _, err := p.m.Place(p.ctx, buildingOwner, 1, tower(10, 10)); err != nil {
		t.Fatal(err)
	}
	if got := buildingAt(t, p, 10, 10).Params; !slices.Equal(got, []int32{1, 0, 3}) {
		t.Fatalf("a tower placed without parameters: %v, want the defaults [1 0 3]", got)
	}
	if _, err := p.m.Brush(p.ctx, buildingOwner, 2, terrain.Brush{Op: terrain.BrushPaint, X: 9000, Y: 9000, Radius: 300, Material: 9}); err != nil {
		t.Fatal(err)
	}
	for _, c := range []struct {
		name   string
		player int64
		seq    uint64
		gx, gy int64
		params []int32
		want   error
	}{
		{"another player", buildingOther, 1, 10, 10, []int32{2}, terrainmap.ErrDenied},
		{"four values for three slots", buildingOwner, 3, 10, 10, []int32{1, 1, 1, 1}, terrainmap.ErrBuildingParams},
		{"a value above its max", buildingOwner, 3, 10, 10, []int32{5}, terrainmap.ErrBuildingParams},
		{"a value below its min", buildingOwner, 3, 10, 10, []int32{0}, terrainmap.ErrBuildingParams},
		{"more values than any building has", buildingOwner, 3, 10, 10, make([]int32, building.MaxParams+1), terrainmap.ErrBuildingParams},
		{"no building on the anchor", buildingOwner, 3, 30, 30, []int32{2}, terrainmap.ErrNoBuilding},
		{"a node that is not the anchor", buildingOwner, 3, 11, 10, []int32{2}, terrainmap.ErrNoBuilding},
	} {
		before := snapshotBuildings(t, p)
		if _, err := p.m.SetParams(p.ctx, c.player, c.seq, c.gx, c.gy, c.params); !errors.Is(err, c.want) {
			t.Fatalf("%s: %v, want %v", c.name, err, c.want)
		}
		if !before.equal(snapshotBuildings(t, p)) {
			t.Fatalf("%s: a refused change wrote something", c.name)
		}
	}
	// 用过的序号（放置的 1、笔刷的 2）答 Duplicate，什么都不写。
	for _, seq := range []uint64{1, 2} {
		before := snapshotBuildings(t, p)
		if r, err := p.m.SetParams(p.ctx, buildingOwner, seq, 10, 10, []int32{4}); err != nil || !r.Duplicate {
			t.Fatalf("a change on used sequence %d: %+v, %v", seq, r, err)
		}
		if !before.equal(snapshotBuildings(t, p)) {
			t.Fatalf("a duplicate change on sequence %d wrote something", seq)
		}
	}
	lotBefore := buildingAt(t, p, 10, 10).Lot
	terrainBefore := snapshotTerrain(p.m)
	r, err := p.m.SetParams(p.ctx, buildingOwner, 3, 10, 10, []int32{4, 1})
	if err != nil || r.Duplicate || !slices.Equal(r.Building.Params, []int32{4, 1, 3}) || r.LastSeq != 3 {
		t.Fatalf("the owner's change: %+v, %v (want [4 1 3]: the third slot keeps its default)", r, err)
	}
	if again, err := p.m.SetParams(p.ctx, buildingOwner, 3, 10, 10, []int32{2}); err != nil || !again.Duplicate || !slices.Equal(again.Building.Params, []int32{4, 1, 3}) {
		t.Fatalf("the same change again: %+v, %v", again, err)
	}
	if got := buildingAt(t, p, 10, 10); got.Lot != lotBefore || !slices.Equal(got.Params, []int32{4, 1, 3}) {
		t.Fatalf("after the change: %+v", got)
	}
	if after := snapshotTerrain(p.m); !slices.Equal(after.ground, terrainBefore.ground) {
		t.Fatal("a parameter change touched the terrain")
	}
	checkBuildingRecords(t, p)
	// 拆了之后不能再改。
	if _, err := p.m.Remove(p.ctx, buildingOwner, 4, 10, 10); err != nil {
		t.Fatal(err)
	}
	if _, err := p.m.SetParams(p.ctx, buildingOwner, 5, 10, 10, []int32{2}); !errors.Is(err, terrainmap.ErrNoBuilding) {
		t.Fatalf("changing a removed building: %v", err)
	}
}

// 配置检查（方案 §27）：跨行规则在启动（guardBuildingConfig 对当前快照）与每次热更新（Validate）执行；热更新不许删已有
// 配置 ID、不许改已有配置的宽高，可以加配置、加参数槽、改范围。被拒的热更新留着旧快照。
func TestBuildingConfigRulesAndReloads(t *testing.T) {
	source := filepath.Join("..", "..", "..", "configs", "data")
	copyConfig := func(t *testing.T) string {
		t.Helper()
		dir := t.TempDir()
		entries, err := os.ReadDir(source)
		if err != nil {
			t.Fatal(err)
		}
		for _, e := range entries {
			raw, err := os.ReadFile(filepath.Join(source, e.Name()))
			if err != nil {
				t.Fatal(err)
			}
			if err := os.WriteFile(filepath.Join(dir, e.Name()), raw, 0o644); err != nil {
				t.Fatal(err)
			}
		}
		return dir
	}
	edit := func(t *testing.T, dir, file string, change func([]map[string]any) []map[string]any) {
		t.Helper()
		path := filepath.Join(dir, file)
		raw, err := os.ReadFile(path)
		if err != nil {
			t.Fatal(err)
		}
		var rows []map[string]any
		if err := json.Unmarshal(raw, &rows); err != nil {
			t.Fatal(err)
		}
		out, err := json.MarshalIndent(change(rows), "", "  ")
		if err != nil {
			t.Fatal(err)
		}
		if err := os.WriteFile(path, out, 0o644); err != nil {
			t.Fatal(err)
		}
	}
	setField := func(id float64, key string, value any) func([]map[string]any) []map[string]any {
		return func(rows []map[string]any) []map[string]any {
			for _, row := range rows {
				if row["id"] == id {
					row[key] = value
				}
			}
			return rows
		}
	}
	dropRow := func(id float64) func([]map[string]any) []map[string]any {
		return func(rows []map[string]any) []map[string]any {
			return slices.DeleteFunc(rows, func(row map[string]any) bool { return row["id"] == id })
		}
	}

	// 热更新也会把 Store 设成进程的配置：用例结束换回来。
	previousStore, previousConfig := configdata.DefaultStore(), fctx.RuntimeConfig()
	t.Cleanup(func() {
		configdata.SetDefaultStore(previousStore)
		fctx.SetRuntimeConfig(previousConfig)
	})
	// 启动：工程的配置合规；跨行规则坏了的配置让启动失败。
	good := loadConfigDir(t, copyConfig(t))
	stop, err := guardBuildingConfig(good)
	if err != nil {
		t.Fatalf("the project's building config: %v", err)
	}
	defer stop()
	catalog, err := building.CatalogOf(good.Current())
	if err != nil || len(catalog) != 4 || len(catalog[3].Params) != 3 || len(catalog[4].Params) != 0 || !catalog[4].MustLevel {
		t.Fatalf("the project's catalog: %+v, %v", catalog, err)
	}
	for _, bad := range []struct {
		name   string
		file   string
		change func([]map[string]any) []map[string]any
	}{
		{"a slot gap", "building_param.json", setField(302, "slot", 5)},
		{"a repeated slot", "building_param.json", setField(302, "slot", 0)},
		{"default above max", "building_param.json", setField(101, "default", 9)},
		{"min above max", "building_param.json", setField(101, "min", 8)},
		{"a repeated name", "building_param.json", setField(202, "name", "wall_color")},
		{"a side wider than a chunk", "building.json", setField(4, "w", 65)},
	} {
		dir := copyConfig(t)
		edit(t, dir, bad.file, bad.change)
		if _, err := guardBuildingConfig(loadConfigDir(t, dir)); !errors.Is(err, building.ErrCatalog) {
			t.Fatalf("start with %s: %v, want ErrCatalog", bad.name, err)
		}
	}

	// 热更新：被拒的留着旧快照；合规的加配置、加槽、改范围照常生效。
	dir := good.Dir()
	for _, refused := range []struct {
		name   string
		file   string
		change func([]map[string]any) []map[string]any
	}{
		{"the hut's width", "building.json", setField(1, "w", 5)},
		{"the tower removed", "building.json", dropRow(3)},
		{"a slot gap", "building_param.json", setField(302, "slot", 5)},
	} {
		raw := map[string][]byte{}
		for _, f := range []string{"building.json", "building_param.json"} {
			raw[f], _ = os.ReadFile(filepath.Join(dir, f))
		}
		if refused.name == "the tower removed" {
			edit(t, dir, "building_param.json", func(rows []map[string]any) []map[string]any {
				return slices.DeleteFunc(rows, func(row map[string]any) bool { return row["building"] == float64(3) })
			})
		}
		edit(t, dir, refused.file, refused.change)
		before := good.Current()
		if _, err := good.ReloadWithReason(context.Background(), "test: "+refused.name); err == nil {
			t.Fatalf("a reload with %s was accepted", refused.name)
		}
		if good.Current() != before {
			t.Fatalf("a refused reload (%s) replaced the snapshot", refused.name)
		}
		for f, b := range raw {
			if err := os.WriteFile(filepath.Join(dir, f), b, 0o644); err != nil {
				t.Fatal(err)
			}
		}
	}
	edit(t, dir, "building.json", func(rows []map[string]any) []map[string]any {
		return append(rows, map[string]any{"id": 5, "name": "well", "model": "building/well", "w": 2, "h": 2, "max_rise": 30, "max_cut": 100, "must_level": false})
	})
	edit(t, dir, "building_param.json", func(rows []map[string]any) []map[string]any {
		rows = setField(101, "max", 15)(rows)
		return append(rows, map[string]any{"id": 102, "building": 1, "slot": 1, "name": "chimney", "min": 0, "max": 1, "default": 1})
	})
	if _, err := good.ReloadWithReason(context.Background(), "test: add a config and a slot"); err != nil {
		t.Fatalf("a compatible reload: %v", err)
	}
	catalog, err = building.CatalogOf(good.Current())
	if err != nil || len(catalog) != 5 || len(catalog[1].Params) != 2 || catalog[1].Params[0].Max != 15 {
		t.Fatalf("after the compatible reload: %+v, %v", catalog, err)
	}
	// 存量值按新配置读：缺的槽取缺省值。
	if got := catalog[1].ParamsOf([]int32{7}); !slices.Equal(got, []int32{7, 1}) {
		t.Fatalf("a stored hut's parameters read on the new config: %v", got)
	}
}

// 重启时配置文件换了（热更新挡不住的情形）：建筑的配置 ID 没有了或宽高变了，启动对账计 Misconfigured、建筑保留、
// 什么都不改，占位照旧挡路。
func TestBuildingReconcileReportsAConfigDrift(t *testing.T) {
	store := &memoryChunkStore{}
	pack := buildingPack(t, t.TempDir(), 1)
	p := buildingProcess(t, pack, store, nil)
	if _, err := p.m.Place(p.ctx, buildingOwner, 1, hut(10, 10)); err != nil {
		t.Fatal(err)
	}
	if _, err := p.m.Place(p.ctx, buildingOwner, 2, tower(30, 30)); err != nil {
		t.Fatal(err)
	}
	want := buildingsOf(p)
	p.stop()
	p.persist(store)

	dir := t.TempDir()
	source := filepath.Join("..", "..", "..", "configs", "data")
	entries, err := os.ReadDir(source)
	if err != nil {
		t.Fatal(err)
	}
	for _, e := range entries {
		raw, _ := os.ReadFile(filepath.Join(source, e.Name()))
		switch e.Name() {
		case "building.json":
			var rows []map[string]any
			_ = json.Unmarshal(raw, &rows)
			rows = slices.DeleteFunc(rows, func(row map[string]any) bool { return row["id"] == float64(3) })
			for _, row := range rows {
				if row["id"] == float64(1) {
					row["w"] = 5
				}
			}
			raw, _ = json.Marshal(rows)
		case "building_param.json":
			var rows []map[string]any
			_ = json.Unmarshal(raw, &rows)
			rows = slices.DeleteFunc(rows, func(row map[string]any) bool { return row["building"] == float64(3) })
			raw, _ = json.Marshal(rows)
		}
		if err := os.WriteFile(filepath.Join(dir, e.Name()), raw, 0o644); err != nil {
			t.Fatal(err)
		}
	}
	t.Cleanup(useConfigStore(loadConfigDir(t, dir)))

	q := buildingProcess(t, pack, store, nil)
	if wantStats := (terrainmap.BuildingStats{Standing: 2, Misconfigured: 2}); q.buildingStats != wantStats {
		t.Fatalf("reconcile with a drifted config: %+v, want %+v", q.buildingStats, wantStats)
	}
	if got := buildingsOf(q); !sameBuildings(got, want) {
		t.Fatalf("buildings after the drift:\n%+v\nwant\n%+v", got, want)
	}
	if len(q.m.ReconciledBuildings()) != 2 {
		t.Fatal("misconfigured buildings are not replicated")
	}
	checkBuildingRecords(t, q)
}
