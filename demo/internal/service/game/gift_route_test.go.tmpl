// A step that runs on a process which does not serve its player writes a
// second copy of the Player document and takes a process down. The gift's
// debit and refund (and the alliance sagas' Player steps) are routed steps: the
// coordinator delivers them only to the durable of the sid the saga was
// started with, so the wrong process never sees them (roost-core SAGA.md,
// 按 sid 确切路由; the delivery itself is pinned in roost-core
// framework/saga step_consumer_test.go). These tests pin the two halves this
// project owns, neither of which needs a Mongo or a bus (§9.11, §9.12):
//
//   - the definitions route exactly the Player steps;
//   - admitBound, on the process the command reached, still checks the
//     player's CURRENT binding against the real ownership table
//     (PlayerOwners.AdmitBound, which asks the account service about a player
//     it has no record of) and answers with the framework's verdicts: run,
//     bounce back to the coordinator with the sid he is bound to now, bounce
//     with no route while he is changing servers, reject a payload with no
//     sid, or retry here while the copy is being unloaded.
//
// The binding tests run on the real account service (memory stores) and two
// real ownership tables, sids 1000 and 1001: a player's server changes there
// the way it does in production — BeginRoleTransfer, CommitRoleTransfer.

const (
	routeLocalSID = int32(1000)
	routeOtherSID = int32(1001)
)

// giftPayload builds the saga state as the coordinator ships it. It does not
// go through gift.Encode, so a test can build the payload Encode refuses.
func giftPayload(t *testing.T, state gift.State) []byte {
	t.Helper()
	payload, err := json.Marshal(state)
	if err != nil {
		t.Fatal(err)
	}
	return payload
}

// giftCommand is a debit command routed to route for a sender bound to fromSID.
func giftCommand(t *testing.T, from int64, fromSID int32, route int32) saga.Command {
	t.Helper()
	now := time.Now()
	return saga.Command{
		ID: "cmd-1", IdempotencyKey: "op-1", SagaID: "saga-1", SagaType: giftitem.Type, DefinitionVersion: giftitem.Version,
		BusinessKey: "gift-1", Step: 0, StepName: "debit", Phase: saga.PhaseForward, Attempt: 1,
		Topic:   giftitem.TopicDebit,
		Payload: giftPayload(t, gift.State{From: from, FromSID: fromSID, To: from + 1, ItemID: 1001, Count: 1}),
		Route:   saga.SidRoute(route), CreatedAt: now, DeadlineAt: now.Add(time.Minute),
	}
}

// routeSteps is one game process with sid local and its real ownership table
// (empty — nobody has logged in). It has no binding authority: a player it
// has no record of counts as bound here. The tests that are about the binding
// use routeWorld instead.
func routeSteps(local int32) (giftSteps, *PlayerOwners) {
	owners := newPlayerOwners(local, nil, nil)
	return giftSteps{owners: owners}, owners
}

// routeWorld is the account service with servers 1000 and 1001 open and one
// role, bound to 1000.
type routeWorld struct {
	accounts *svcaccount.Service
	player   int64
	nextID   int64
}

func (w *routeWorld) Allocate(context.Context, int32) (int64, error) {
	w.nextID++
	return 94_500 + w.nextID, nil
}

func newRouteWorld(t *testing.T) *routeWorld {
	t.Helper()
	names, err := directory.New(versionstore.NewMemoryStore[string, directory.Entry](), directory.Config{
		Normalize: directory.NormalizeLower, DefaultTTL: time.Minute,
	})
	if err != nil {
		t.Fatal(err)
	}
	w := &routeWorld{}
	w.accounts, err = svcaccount.New(svcaccount.Config{
		Accounts: versionstore.NewMemoryStore[string, svcaccount.Account](),
		Roles:    versionstore.NewMemoryStore[int64, svcaccount.Role](),
		Servers:  versionstore.NewMemoryStore[int32, svcaccount.GameServer](),
		Names:    names,
		Slots:    versionstore.NewMemoryStore[string, svcaccount.Slot](),
		Verifier: svcaccount.VerifierFunc(func(_ context.Context, identity svcaccount.Identity) (svcaccount.Verified, error) {
			return svcaccount.Verified{Channel: identity.Channel, OpenID: identity.OpenID}, nil
		}),
		Allocator:     w,
		NameRules:     svcaccount.NameValidatorFunc(func(string) error { return nil }),
		SessionSecret: "route-test-secret",
	})
	if err != nil {
		t.Fatal(err)
	}
	ctx := context.Background()
	for _, sid := range []int32{routeLocalSID, routeOtherSID} {
		if _, err := w.accounts.UpsertServer(ctx, svcaccount.GameServer{ID: sid, Name: fmt.Sprintf("s%d", sid), Status: svcaccount.ServerOpen}); err != nil {
			t.Fatal(err)
		}
	}
	account, err := w.accounts.Login(ctx, svcaccount.Identity{Channel: "store", OpenID: "u1", Credential: "good"})
	if err != nil {
		t.Fatal(err)
	}
	role, err := w.accounts.CreateRole(ctx, account.ID, routeLocalSID, "hero")
	if err != nil {
		t.Fatal(err)
	}
	w.player = role.PlayerID
	return w
}

// routeDeparter stands where the scene and the DataEngine hand-off are: it
// records which players were handed off and released.
type routeDeparter struct{ handed, released []int64 }

func (d *routeDeparter) DepartPlayer(_ context.Context, playerID int64) (func(context.Context) error, error) {
	d.handed = append(d.handed, playerID)
	return func(context.Context) error {
		d.released = append(d.released, playerID)
		return nil
	}, nil
}

// routeServer is one game process of the world: its real ownership table,
// wired the way service.go wires it — the current binding asked through the
// rehome module (the table itself, published as the module's Residency, then
// the account service) — and the gift and alliance steps on top of it.
type routeServer struct {
	registry *app.Registry
	owners   *PlayerOwners
	departer *routeDeparter
	gifts    giftSteps
}

func (w *routeWorld) server(t *testing.T, sid int32) *routeServer {
	t.Helper()
	config := viper.New()
	config.Set("sid", sid)
	registry := app.NewRegistry(config)
	owners, err := NewPlayerOwners(registry)
	if err != nil {
		t.Fatal(err)
	}
	departer := &routeDeparter{}
	owners.HandOff(departer)
	if err := registry.Register(svcaccount.CapabilityName, svcaccount.Accounts(w.accounts)); err != nil {
		t.Fatal(err)
	}
	if err := registry.Register(gamerehome.ResidencyCapability, gamerehome.Residency(owners)); err != nil {
		t.Fatal(err)
	}
	if err := registry.Register(alliance.PlayerBindingCapability, alliancePlayerBinding{owners: owners}); err != nil {
		t.Fatal(err)
	}
	return &routeServer{registry: registry, owners: owners, departer: departer, gifts: giftSteps{owners: owners}}
}

// debit is a gift debit command for the world's player that reached this
// server; the payload says the gift started on startedOn.
func (w *routeWorld) debit(t *testing.T, startedOn, reached int32) saga.Command {
	return giftCommand(t, w.player, startedOn, reached)
}

// allianceDebit is the same command carrying a alliance donation's Player step.
func (w *routeWorld) allianceDebit(t *testing.T, startedOn, reached int32) saga.Command {
	t.Helper()
	payload, err := json.Marshal(alliance.State{PlayerID: w.player, SID: startedOn, Coins: 10})
	if err != nil {
		t.Fatal(err)
	}
	command := giftCommand(t, w.player, startedOn, reached)
	command.SagaType, command.Topic, command.Payload = alliancedonate.Type, alliancedonate.TopicDebit, payload
	return command
}

// expectBounce checks that err is a bounce back to the coordinator with the
// given route ("" = no new route).
func expectBounce(t *testing.T, what string, err error, route string) {
	t.Helper()
	var bounce *saga.StepBounce
	if !errors.As(err, &bounce) || bounce.Route != route {
		t.Fatalf("%s = %v, want a bounce with route %q", what, err, route)
	}
}

// Exactly the steps that write a Player are routed — the debit (whose
// compensation is the refund) of the gift, founding and donation, and the
// reward's grant — and the mail and alliance steps are not: they may run on
// any process. A step routed in the definition but not in the consumers (or
// the other way round) would never be delivered; kitsaga.Steps refuses to
// start such a process.
func TestThePlayerStepsAreRoutedBySid(t *testing.T) {
	for _, definition := range []saga.Definition{giftitem.Definition(), alliancefound.Definition(), alliancedonate.Definition(), alliancereward.Definition()} {
		for _, step := range definition.Steps {
			want := step.Name == "debit" || step.Name == "grant"
			if step.Routed != want {
				t.Errorf("%s step %s: routed=%t, want %t", definition.Type, step.Name, step.Routed, want)
			}
		}
	}
	if _, err := alliance.Encode(alliance.State{PlayerID: 42, Coins: 10}); err == nil {
		t.Fatal("alliance.Encode wrote a Player step state with no sid; its saga could not be routed")
	}
}

// A step for a sender this process serves is admitted.
func TestAdmitRunsTheOwnersOwnStep(t *testing.T) {
	steps, owners := routeSteps(routeLocalSID)
	if err := owners.Serve(context.Background(), 42, routeLocalSID); err != nil {
		t.Fatal(err)
	}
	if err := steps.admitBound(context.Background(), giftCommand(t, 42, routeLocalSID, routeLocalSID)); err != nil {
		t.Fatalf("the owner was refused its own step: %v", err)
	}
}

// The process the sender is bound to runs the step even when the sender is
// offline and has no copy anywhere — the debit and, above all, the refund
// must not wait for them to log in. The table has no record of him, so it asks
// where he is bound (the account service says: here) and takes him into
// service (a resident record, so the idle unload covers the copy Nest loads
// cold for the step), on this sid and nowhere else.
func TestAnOfflineSendersStepRunsOnTheSidTheyAreBoundTo(t *testing.T) {
	world := newRouteWorld(t)
	home := world.server(t, routeLocalSID)
	if home.owners.Resident(world.player) {
		t.Fatal("precondition: the sender is offline and not resident")
	}
	if err := home.gifts.admitBound(context.Background(), world.debit(t, routeLocalSID, routeLocalSID)); err != nil {
		t.Fatalf("the step of an offline sender bound to this sid was refused: %v", err)
	}
	if !home.owners.Resident(world.player) {
		t.Fatal("the admitted step left no resident record: the copy Nest loads for it would never be unloaded")
	}
}

// A command that reached a sid its sender is not bound to is bounced back to
// the coordinator — not nacked, which on a routed durable would only come
// back here — naming the sid he is bound to NOW as the next attempt's route.
// The payload's sid does not decide: here it even names this server (the gift
// "started here"), and the account service says he is bound to 1000. Nothing
// is recorded: a resident record would let this process load the Player while
// its own sid writes it too.
func TestAStepForASenderBoundElsewhereIsBouncedToHisSid(t *testing.T) {
	world := newRouteWorld(t)
	other := world.server(t, routeOtherSID)
	err := other.gifts.admitBound(context.Background(), world.debit(t, routeOtherSID, routeOtherSID))
	expectBounce(t, "a step for a sender bound to sid 1000 that reached 1001", err, saga.SidRoute(routeLocalSID))
	if other.owners.Resident(world.player) {
		t.Fatal("bouncing the step took a player bound to another sid into service here")
	}
	// The alliance sagas' Player steps answer the same way.
	expectBounce(t, "a alliance step for a player bound to sid 1000 that reached 1001",
		allianceruntime.AdmitPlayerStep(context.Background(), other.registry, world.allianceDebit(t, routeOtherSID, routeOtherSID)), saga.SidRoute(routeLocalSID))
	// The account service is away and this process knows nothing of him: a
	// plain error (redelivered here), neither a bounce nor a rejection.
	unreachable := world.server(t, routeOtherSID)
	unreachable.owners.bound = func(context.Context, int64) (int32, bool, error) { return 0, false, errors.New("account is away") }
	err = unreachable.gifts.admitBound(context.Background(), world.debit(t, routeLocalSID, routeOtherSID))
	var bounce *saga.StepBounce
	var rejection *saga.StepRejection
	if err == nil || errors.As(err, &bounce) || errors.As(err, &rejection) || unreachable.owners.Resident(world.player) {
		t.Fatalf("a step whose sender's binding cannot be asked = %v, want a plain error and no resident record", err)
	}
}

// A step for a sender who is changing servers (the rehome module; here the
// transfer is recorded with the real account service) is bounced back to the
// coordinator with no new route (the next attempt goes to the same sid and
// does not spend an attempt — roost-core framework/saga
// TestAStepBouncedDuringAMoveRunsOnceOnTheNewSid pins the coordinator side):
// not run, and nothing is recorded — even on the sid he is still bound to.
// Once the transfer is committed the old sid bounces the same command naming
// the new one, and the new sid admits it. The alliance sagas' Player steps
// follow the same rules.
func TestAStepForAMovingSenderIsBouncedBackToTheSender(t *testing.T) {
	world := newRouteWorld(t)
	ctx := context.Background()
	old, next := world.server(t, routeLocalSID), world.server(t, routeOtherSID)
	command, allianceCommand := world.debit(t, routeLocalSID, routeLocalSID), world.allianceDebit(t, routeLocalSID, routeLocalSID)
	// Begin: the transfer is in flight; he is still bound to 1000.
	if _, err := world.accounts.BeginRoleTransfer(ctx, world.player, svcaccount.TransferRequest{ID: "move-1", FromSID: routeLocalSID, To: routeOtherSID}); err != nil {
		t.Fatal(err)
	}
	expectBounce(t, "a step for a moving sender on the sid he is still bound to", old.gifts.admitBound(ctx, command), "")
	expectBounce(t, "a alliance step for a moving player", allianceruntime.AdmitPlayerStep(ctx, old.registry, allianceCommand), "")
	expectBounce(t, "a step for a moving sender on the sid he is moving to", next.gifts.admitBound(ctx, command), "")
	if old.owners.Resident(world.player) || next.owners.Resident(world.player) {
		t.Fatal("bouncing the step of a moving sender took him into service")
	}
	// Commit: he is bound to 1001 now. The old sid names it; the same command
	// is admitted there, and only there.
	if _, err := world.accounts.CommitRoleTransfer(ctx, world.player, "move-1"); err != nil {
		t.Fatal(err)
	}
	expectBounce(t, "the step on the old sid after the commit", old.gifts.admitBound(ctx, command), saga.SidRoute(routeOtherSID))
	expectBounce(t, "the alliance step on the old sid after the commit", allianceruntime.AdmitPlayerStep(ctx, old.registry, allianceCommand), saga.SidRoute(routeOtherSID))
	if old.owners.Resident(world.player) {
		t.Fatal("the old sid took a player who moved away into service")
	}
	if err := next.gifts.admitBound(ctx, command); err != nil {
		t.Fatalf("the same command on the new sid = %v, want it admitted", err)
	}
	if !next.owners.Resident(world.player) {
		t.Fatal("the admitted step left no resident record on the new sid")
	}
	if err := allianceruntime.AdmitPlayerStep(ctx, next.registry, allianceCommand); err != nil {
		t.Fatalf("the alliance step on the new sid = %v, want it admitted", err)
	}
}

// The same from the inside of the process that is moving him out: the table
// of players moved out (the rehome module's Residency, implemented by the
// ownership table) answers before anybody is asked. From the moment the
// leaving mark is set a step is bounced with no route — the resident record
// he still has does not admit it — and once he has left, the write gate
// refuses him too. After the commit the table names the server he went to;
// after an abort he is served here again.
func TestAStepForAPlayerThisProcessIsMovingOutIsBounced(t *testing.T) {
	world := newRouteWorld(t)
	ctx := context.Background()
	home := world.server(t, routeLocalSID)
	command := world.debit(t, routeLocalSID, routeLocalSID)
	if err := home.owners.Serve(ctx, world.player, routeLocalSID); err != nil {
		t.Fatal(err)
	}
	move := gamerehome.Move{PlayerID: world.player, ID: "move-1", From: routeLocalSID, To: routeOtherSID}
	if err := home.owners.Reserve(move); err != nil {
		t.Fatal(err)
	}
	if err := home.owners.Reserve(move); !errors.Is(err, apperrors.ErrRehomeMoving) {
		t.Fatalf("a second reservation = %v, want rehome_moving", err)
	}
	expectBounce(t, "a step for a player with the leaving mark", home.gifts.admitBound(ctx, command), "")
	// From the mark on the write gate refuses his new requests (RV-20261111-BM-05):
	// a request admitted after the checks could undo what they checked. The
	// login message is exempt — the check before entering answers it.
	if err := home.owners.Admit(world.player); !errors.Is(err, apperrors.ErrRehomeMoving) {
		t.Fatalf("a new request after the leaving mark = %v, want rehome_moving", err)
	}
	if err := home.owners.AdmitMessage(world.player, msgid.MsgEnterGame); err != nil {
		t.Fatalf("the login message after the leaving mark = %v, want it left to the check before entering", err)
	}
	// Quiesce: nothing to wait for in a process with no connections.
	if err := home.owners.Quiesce(ctx, move); err != nil {
		t.Fatal(err)
	}
	// An abort before he left: served here again, nothing was handed off.
	if err := home.owners.Settle(ctx, move, gamerehome.Aborted); err != nil {
		t.Fatal(err)
	}
	if err := home.gifts.admitBound(ctx, command); err != nil || len(home.departer.handed) != 0 {
		t.Fatalf("after the abort the step = %v (handed off %v), want it admitted", err, home.departer.handed)
	}
	if err := home.owners.Admit(world.player); err != nil {
		t.Fatalf("after the abort the write gate = %v, want the player admitted again", err)
	}
	// The move for real: mark, leave, commit.
	move.ID = "move-2"
	if err := home.owners.Reserve(move); err != nil {
		t.Fatal(err)
	}
	if err := home.owners.Depart(ctx, move); err != nil {
		t.Fatal(err)
	}
	if len(home.departer.handed) != 1 || home.departer.handed[0] != world.player {
		t.Fatalf("handed off %v, want the player", home.departer.handed)
	}
	if !errors.Is(home.owners.Admit(world.player), apperrors.ErrRehomeMoving) || home.owners.Resident(world.player) {
		t.Fatal("after the hand-off the write gate still admits the player")
	}
	expectBounce(t, "a step after the hand-off, before the commit", home.gifts.admitBound(ctx, command), "")
	if err := home.owners.Settle(ctx, move, gamerehome.Committed); err != nil {
		t.Fatal(err)
	}
	expectBounce(t, "a step after the commit", home.gifts.admitBound(ctx, command), saga.SidRoute(routeOtherSID))
	if home.owners.Resident(world.player) || len(home.departer.released) != 0 {
		t.Fatalf("after the commit: resident=%v released=%v, want neither", home.owners.Resident(world.player), home.departer.released)
	}
	if where, tracked := home.owners.Where(world.player); !tracked || where.Moving || where.Move.To != routeOtherSID {
		t.Fatalf("the table says %+v (%v), want departed to 1001", where, tracked)
	}
}

// A login with claims from before the move is refused. The session's
// server_id still says 1000 — the static comparison in Serve's caller passes —
// but the check before the login (the rehome module's Admit, which the
// EnterGame endpoint runs through the enter module's registration point) reads
// the table of players moved out, and Serve itself refuses to create a
// resident record for a player in it. On the new server the same player, with
// claims the authenticator wrote after the move, gets in.
func TestALoginWithClaimsFromBeforeTheMoveIsRefused(t *testing.T) {
	world := newRouteWorld(t)
	ctx := context.Background()
	old, next := world.server(t, routeLocalSID), world.server(t, routeOtherSID)
	driver := func(server *routeServer) *gamerehome.Driver {
		built, err := gamerehome.NewDriver(gamerehome.DriverConfig{
			Registry: server.registry, Self: server.owners.SID(), Directory: gamerehome.RegistryDirectory(server.registry),
			Residency: gamerehome.RegistryResidency(server.registry), Profile: routeProfile{},
			EntityID: func(playerID int64) (int64, error) { return playerID, nil },
		})
		if err != nil {
			t.Fatal(err)
		}
		return built
	}
	before := map[string]string{svcaccount.ServerIDClaim: "1000", svcaccount.BindEpochClaim: "0"}
	if err := driver(old).Admit(ctx, world.player, before); err != nil {
		t.Fatalf("before the move the login check = %v, want it passed", err)
	}
	// The move: mark, record with account, leave, commit, settle.
	move := gamerehome.Move{PlayerID: world.player, ID: "move-1", From: routeLocalSID, To: routeOtherSID}
	if err := old.owners.Reserve(move); err != nil {
		t.Fatal(err)
	}
	if _, err := world.accounts.BeginRoleTransfer(ctx, world.player, svcaccount.TransferRequest{ID: move.ID, FromSID: routeLocalSID, To: routeOtherSID}); err != nil {
		t.Fatal(err)
	}
	if err := driver(old).Admit(ctx, world.player, before); !errors.Is(err, apperrors.ErrRehomeMoving) {
		t.Fatalf("during the move the login check = %v, want rehome_moving", err)
	}
	if err := old.owners.Serve(ctx, world.player, routeLocalSID); !errors.Is(err, apperrors.ErrRehomeMoving) {
		t.Fatalf("Serve during the move = %v, want rehome_moving", err)
	}
	if err := old.owners.Depart(ctx, move); err != nil {
		t.Fatal(err)
	}
	if _, err := world.accounts.CommitRoleTransfer(ctx, world.player, move.ID); err != nil {
		t.Fatal(err)
	}
	if err := old.owners.Settle(ctx, move, gamerehome.Committed); err != nil {
		t.Fatal(err)
	}
	err := driver(old).Admit(ctx, world.player, before)
	if sid, known := gamerehome.OwnerSID(err); !errors.Is(err, apperrors.ErrRehomeElsewhere) || !known || sid != routeOtherSID {
		t.Fatalf("after the move the login check with the old claims = %v (owner %d %v), want rehome_elsewhere naming 1001", err, sid, known)
	}
	err = old.owners.Serve(ctx, world.player, routeLocalSID)
	if sid, known := gamerehome.OwnerSID(err); !errors.Is(err, apperrors.ErrRehomeElsewhere) || !known || sid != routeOtherSID {
		t.Fatalf("Serve after the move = %v (owner %d %v), want rehome_elsewhere naming 1001", err, sid, known)
	}
	if old.owners.Resident(world.player) {
		t.Fatal("the old server took a player who moved away into service")
	}
	// The old claims on the NEW server: its own static check refuses them
	// (they name 1000), and so does the login check.
	if err := driver(next).Admit(ctx, world.player, before); !errors.Is(err, apperrors.ErrRehomeElsewhere) {
		t.Fatalf("the old claims on the new server = %v, want rehome_elsewhere", err)
	}
	after := map[string]string{svcaccount.ServerIDClaim: "1001", svcaccount.BindEpochClaim: "1"}
	if err := driver(next).Admit(ctx, world.player, after); err != nil {
		t.Fatalf("the login check on the new server = %v, want it passed", err)
	}
	if err := next.owners.Serve(ctx, world.player, routeOtherSID); err != nil || !next.owners.Resident(world.player) {
		t.Fatalf("Serve on the new server = %v, want the player resident there", err)
	}
}

// routeProfile stands where the Player's rehome transactions are; the login
// check does not touch them.
type routeProfile struct{}

func (routeProfile) Prepare(context.Context, gamerehome.Move) error { return nil }
func (routeProfile) Recheck(context.Context, gamerehome.Move) error { return nil }
func (routeProfile) Cancel(context.Context, int64, string) error    { return nil }
func (routeProfile) Arrive(context.Context, int64, int32) (gamerehome.ArriveResult, error) {
	return gamerehome.ArriveResult{}, nil
}

// A payload with no sender sid cannot be routed: it is rejected (a
// non-retryable failure goes back to the coordinator, logged as an error)
// and nobody is taken into service — even a sender who happens to be resident
// here. Payloads from before from_sid existed are not migrated (maintainer
// decisions 2026-10-05 / 2026-11-11). Encode refuses to write such a gift.
func TestAStepThatNamesNoSenderSidIsRejected(t *testing.T) {
	if _, err := gift.Encode(gift.State{From: 42, To: 43, ItemID: 1001, Count: 1}); err == nil {
		t.Fatal("gift.Encode wrote a gift with no sender sid")
	}
	steps, owners := routeSteps(routeLocalSID)
	if err := owners.Serve(context.Background(), 42, routeLocalSID); err != nil {
		t.Fatal(err)
	}
	var rejection *saga.StepRejection
	if err := steps.admitBound(context.Background(), giftCommand(t, 42, 0, routeLocalSID)); !errors.As(err, &rejection) {
		t.Fatalf("a step whose payload names no sender sid = %v, want a rejection", err)
	}
	quiet, quietOwners := routeSteps(routeLocalSID)
	if err := quiet.admitBound(context.Background(), giftCommand(t, 77, 0, routeLocalSID)); !errors.As(err, &rejection) {
		t.Fatalf("a step whose payload names no sender sid = %v, want a rejection", err)
	}
	if quietOwners.Resident(77) {
		t.Fatal("rejecting a payload with no sender sid took the sender into service")
	}
}

// A sender bound here whose copy is being unloaded is retried here (a plain
// error: the delivery is redelivered to this sid's durable after a backoff
// and finds the unload finished) — neither bounced nor rejected: there is no
// better process for it.
func TestAStepForASenderBeingUnloadedIsRetriedHere(t *testing.T) {
	steps, owners := routeSteps(routeLocalSID)
	if err := owners.Serve(context.Background(), 42, routeLocalSID); err != nil {
		t.Fatal(err)
	}
	owners.mu.Lock()
	owners.evictions[42] = &eviction{done: make(chan struct{})}
	owners.mu.Unlock()
	err := steps.admitBound(context.Background(), giftCommand(t, 42, routeLocalSID, routeLocalSID))
	var bounce *saga.StepBounce
	var rejection *saga.StepRejection
	if !errors.Is(err, ErrNotServedHere) || errors.As(err, &bounce) || errors.As(err, &rejection) {
		t.Fatalf("a step for a sender being unloaded = %v, want a plain refusal wrapping ErrNotServedHere", err)
	}
}

// The alliance sagas' Player steps answer the same way (alliance_saga.go
// admitBound): no sid → reject; this sid's own player → admitted and resident.
// (Bound elsewhere and moving are pinned beside the gift's above.)
func TestAAlliancePlayerStepFollowsTheSameRules(t *testing.T) {
	world := newRouteWorld(t)
	home := world.server(t, routeLocalSID)
	var rejection *saga.StepRejection
	if err := allianceruntime.AdmitPlayerStep(context.Background(), home.registry, world.allianceDebit(t, 0, routeLocalSID)); !errors.As(err, &rejection) {
		t.Fatalf("a alliance step with no sid = %v, want a rejection", err)
	}
	if home.owners.Resident(world.player) {
		t.Fatal("rejecting a alliance step with no sid took the player into service")
	}
	if err := allianceruntime.AdmitPlayerStep(context.Background(), home.registry, world.allianceDebit(t, routeLocalSID, routeLocalSID)); err != nil {
		t.Fatalf("a alliance step for this sid's own player = %v, want it admitted", err)
	}
	if !home.owners.Resident(world.player) {
		t.Fatal("the admitted alliance step left no resident record")
	}
}
