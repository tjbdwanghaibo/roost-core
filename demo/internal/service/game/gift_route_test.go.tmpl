package {{GAME_SERVICE_PKG}}

import (
	"context"
	"encoding/json"
	"errors"
	"testing"
	"time"

	"{{MODULE}}/game/gift"
	"{{MODULE}}/game/guild"
	alliancedonate "{{MODULE}}/saga/alliance_donate"
	alliancefound "{{MODULE}}/saga/alliance_found"
	alliancereward "{{MODULE}}/saga/alliance_reward"
	giftitem "{{MODULE}}/saga/gift_item"
	"github.com/tjbdwanghaibo/roost-core/framework/saga"
