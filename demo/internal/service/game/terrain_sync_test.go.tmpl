// 地形同步（terrain_sync.go，可编辑地形方案 §7 / §9 P2）在生成的真实玩家 TCP 接入上：客户端是一个 Go 实现的接收端
// （entitysync.Decoder + 生成的 ApplySyncTerrainChunkDao，与 C# / C++ 客户端同一协议），从回环 socket 读帧、应用改过的块，
// 断言它与服务端的实体 / 视图逐点相同。存储是 terrain_test.go 的离线替身（提交器只收下记录），同步、编码、传输、
// 解码都是正式代码。

// terrainSyncHarness 是一个 game 进程里与地形同步有关的部分：玩家 TCP 接入、地形（Map + Nest + 实体）与开了地形
// 同步的场景。
type terrainSyncHarness struct {
	ctx       context.Context
	transport *accessplayertcp.Runtime
	addr      string
	process   *terrainProcess
	scene     *Scene
	pack      string
 observer *sceneSyncObserver
}

// startTerrainSyncHarness 起一张 chunksX × chunksY 的地图；场景的世界与地形图一样大（玩家站在哪都在地形图上）。
// radius / maxVisible 是地形视野；policy 是玩家编辑的上限（测量与守卫用例放大半径、关掉限速）。started 为假时不起
// 复制循环，只有测试自己的 Flush（测量按“一次 Flush = 50ms”数）。
func startTerrainSyncHarness(t *testing.T, chunksX, chunksY int32, radius int64, maxVisible int, started bool, mixed ...bool) *terrainSyncHarness {
	t.Helper()
	transport, addr := startScenePlayerTransport(t)
	dir := t.TempDir()
	pack := filepath.Join(dir, "sync.pack")
	meta := terrain.Meta{BaseRevision: 1, ChunksX: chunksX, ChunksY: chunksY, WaterLevel: 40000}
	if err := terrain.WritePackFile(pack, meta, terrain.Generated(meta, terrainSeed)); err != nil {
		t.Fatal(err)
	}
	var observer *sceneSyncObserver
 var options []nest.NestOption
 if len(mixed)>0 && mixed[0] { observer=&sceneSyncObserver{}; options=append(options,nest.NestOptionWithEntitySync(observer)) }
 p := startTerrainProcessWith(t, pack, wholeMap, &memoryChunkStore{}, func(p *terrainProcess) {
		policy := terrainmap.DefaultPolicy
		policy.MaxRadius, policy.EditPointsPerSecond = 2500, 0
		p.m.SetPolicy(policy)
	}, options...)
	bounds := p.m.Meta().Bounds()
	config := gamescene.Config{Width: bounds.Max.X, Height: bounds.Max.Y, BlockSize: 300, Spawn: spatial.Point{X: bounds.Max.X / 2, Y: bounds.Max.Y / 2}}
	scene, err := newSceneWithObserver(sceneLane{transport: transport}, transport, nil, config, gamescene.DefaultView().MaxVisible,
		&terrainSyncConfig{bounds: bounds, radius: radius, maxVisible: maxVisible}, observer)
	if err != nil {
		t.Fatal(err)
	}
	scene.terrain.attach(p.m)
	scene.watchSessions(transport)
	h := &terrainSyncHarness{ctx: context.Background(), transport: transport, addr: addr, process: p, scene: scene, pack: pack, observer:observer}
	if started {
		if err := scene.Start(h.ctx); err != nil {
			t.Fatal(err)
		}
	}
	t.Cleanup(func() {
		closeCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		_ = scene.Close(closeCtx)
	})
	return h
}

// startSubjects 是服务启动时地形同步的那一步（startTerrainSync，service.go 在场景启动之后、玩家能进来之前调用）：
// 本进程写的改过的块装成实体登记，其余块登记就绪标记（方案 §31.9）。不调它的用例只有提交后登记的改过的块。
func (h *terrainSyncHarness) startSubjects(t *testing.T) {
	t.Helper()
	startTerrainSubjects(t, h.scene, h.process)
}

// startTerrainSubjects 是 startSubjects 的进程级写法（分区用例的每个进程同样调用）。
func startTerrainSubjects(t *testing.T, scene *Scene, p *terrainProcess) {
	t.Helper()
	registry := app.NewRegistry(nil)
	if err := registry.Register(mods.ModEntityRuntime, entity.NewManagerAccess(p.entities)); err != nil {
		t.Fatal(err)
	}
	if err := startTerrainSync(registry, scene, p.m); err != nil {
		t.Fatal(err)
	}
}

// brush 是一个玩家的一次编辑，必须成功。
func (h *terrainSyncHarness) brush(t *testing.T, playerID int64, requestID uint64, b terrain.Brush) terrain_chunk.BrushResult {
	t.Helper()
	result, err := h.process.m.Brush(h.ctx, playerID, requestID, b)
	if err != nil {
		t.Fatalf("brush %d/%d %+v: %v", playerID, requestID, b, err)
	}
	return result
}

// join 是登录链路的场景一半：连上、鉴权、Join（会话 held）、scene_ready。
func (h *terrainSyncHarness) join(t *testing.T, playerID int64, at spatial.Point) *terrainClient {
	t.Helper()
	client := dialTerrainClient(t, h.addr, playerID)
	waitActiveSessions(t, h.transport, playerID, 1)
	joinReady(t, h.scene, h.ctx, newScenePlayer(t, playerID), at)
	return client
}

// flushUntil 跑复制直到 cond 成立（最多 10 秒）；返回用了几次 Flush。
func (h *terrainSyncHarness) flushUntil(t *testing.T, what string, cond func() bool) int {
	t.Helper()
	deadline := time.Now().Add(10 * time.Second)
	for flushes := 1; ; flushes++ {
		if err := h.scene.Flush(h.ctx); err != nil {
			t.Fatalf("flush: %v", err)
		}
		if cond() {
			return flushes
		}
		if time.Now().After(deadline) {
			t.Fatalf("timed out waiting for %s", what)
		}
		time.Sleep(2 * time.Millisecond)
	}
}

// chunkID 是块的实体 ID。
func chunkID(t *testing.T, key terrain.ChunkKey) int64 {
	t.Helper()
	return mustChunkID(t, key)
}

// assertClientMatches 断言客户端持有的每一块与服务端的视图（提交后的数据）与实体版本逐点相同，并且正是 want 这些块。
func (h *terrainSyncHarness) assertClientMatches(t *testing.T, client *terrainClient, want []terrain.ChunkKey) {
	t.Helper()
	held := client.snapshot()
	if len(held) != len(want) {
		t.Fatalf("the client holds %d terrain chunks, want %d (%v)", len(held), len(want), want)
	}
	for _, key := range want {
		id := chunkID(t, key)
		got, ok := held[id]
		if !ok {
			t.Fatalf("the client does not hold chunk %v", key)
		}
		chunk, version, _ := h.process.m.View().Chunk(key)
		e, _ := h.process.entities.Get(id).(*terrain_chunk.TerrainChunk)
		if e == nil || e.Dao().GetVersion() != version {
			t.Fatalf("chunk %v: the entity and the view disagree", key)
		}
		if got.Version == nil || got.Version.Value != version || got.BaseRevision == nil || got.BaseRevision.Value != h.process.m.Meta().BaseRevision {
			t.Fatalf("chunk %v: the client has version %v / base revision %v, the server %d / %d", key, got.Version, got.BaseRevision, version, h.process.m.Meta().BaseRevision)
		}
		if got.Heights == nil || !slices.Equal(got.Heights.Value, chunk.Heights) {
			t.Fatalf("chunk %v version %d: the client's heights differ from the server's", key, version)
		}
		if got.Materials == nil || !sameMaterials(got.Materials.Value, chunk.Materials) {
			t.Fatalf("chunk %v version %d: the client's materials differ from the server's", key, version)
		}
	}
}

// terrainClient 是一个读帧、应用地形块与建筑的客户端（建筑用生成的 ApplySyncBuildingDao，building_sync_test.go）。别的
// 命名空间（玩家、怪）只记个数与位置。
type terrainClient struct {
	connection net.Conn
	mu         sync.Mutex
	receiver   *entitysync.Decoder
	refs       map[frame.ObjectRef]int64 // 对象引用 → subject（实体 ID）
	namespaces map[int64]string
	chunks     map[int64]*db.SyncTerrainChunkDao
	buildings  map[int64]*db.SyncBuildingDao
	frames     []receivedFrame
	err        error
	// positions 是别的命名空间里带 pos_x / pos_y 的 subject（玩家、怪）最近收到的位置，movedAt 是收到它的时刻；
	// chunkAt 是每块最近一次地形更新收到的时刻（移动纠偏用例比较两者的先后，terrain_move_test.go）。
	positions map[int64]spatial.Point
	movedAt   map[int64]time.Time
	chunkAt   map[int64]time.Time
}

// receivedFrame 是收到的一帧：线上字节（16 字节包头 + 帧）、帧本身的字节，以及其中每个地形更新。
type receivedFrame struct {
	wireBytes, frameBytes int
	full                  bool
	terrain               []terrainUpdate
	// removed 是这一帧里被 remove 的地形块（subject）。
	removed []int64
	others                int
 otherIDs []int64
	// buildings 是这一帧里的建筑更新（building_sync_test.go）。
	buildings []buildingUpdate
}

// buildingUpdate 是一帧里的一个建筑更新：componentBytes 是 EntitySync 组件（subject 头 + 载荷），payloadBytes 是 DAO 同步 PB。
type buildingUpdate struct {
	subject                      int64
	full                         bool
	componentBytes, payloadBytes int
	params                       bool // 带了 Params 字段
}

// sameMaterials 比较客户端收到的材质（DAO 同步的 repeated uint32，Go 侧 []uint16）与服务端视图的每点 1 字节。
func sameMaterials(got []uint16, want []byte) bool {
	if len(got) != len(want) {
		return false
	}
	for i, v := range got {
		if v != uint16(want[i]) {
			return false
		}
	}
	return true
}

// terrainUpdate 是一帧里的一个地形块更新：componentBytes 是 EntitySync 组件（subject 头 + 载荷），payloadBytes 是
// DAO 同步 PB（方案 §7.1 的“DAO 组件 payload”口径）。
type terrainUpdate struct {
	subject                      int64
	full                         bool
	componentBytes, payloadBytes int
	heightsDelta                 bool
	heightUpdates                int
	materials                    bool // 带了材质字段（按下标增量或整字段）
	materialsDelta               bool
	materialUpdates              int
}

func dialTerrainClient(t *testing.T, addr string, playerID int64) *terrainClient {
	t.Helper()
	connection, err := net.Dial("tcp", addr)
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { _ = connection.Close() })
	if err := writeSceneFrame(connection, 0, 1, []byte("session:"+strconv.FormatInt(playerID, 10)+":ticket")); err != nil {
		t.Fatal(err)
	}
	_ = connection.SetReadDeadline(time.Now().Add(2 * time.Second))
	if _, _, err := readSceneFrame(connection); err != nil {
		t.Fatalf("player %d authentication: %v", playerID, err)
	}
	_ = connection.SetReadDeadline(time.Time{})
	// 缺省帧上限就够：会话的引用表合起来可持有 164 个，但每帧对象数仍按场景的 Limits.MaxObjects（100）切分。
	client := &terrainClient{connection: connection, receiver: entitysync.NewDecoder(frame.DefaultLimits()),
		refs: map[frame.ObjectRef]int64{}, namespaces: map[int64]string{}, chunks: map[int64]*db.SyncTerrainChunkDao{}, buildings: map[int64]*db.SyncBuildingDao{},
		positions: map[int64]spatial.Point{}, movedAt: map[int64]time.Time{}, chunkAt: map[int64]time.Time{}}
	go client.read()
	return client
}

func (client *terrainClient) read() {
	for {
		packet, err := wire.Read(client.connection, 16<<20)
		if err != nil {
			return
		}
		if packet.MsgID != msgid.MsgEntitySync {
			continue
		}
		client.mu.Lock()
		received := receivedFrame{wireBytes: wire.HeaderSize + len(packet.Payload), frameBytes: len(packet.Payload)}
		var decoded entitysync.ReceivedFrame
		if decoded, err = client.receiver.Decode(packet.Payload); err == nil {
			err = client.apply(decoded, &received)
		} else if errors.Is(err, entitysync.ErrStaleFrame) {
			err = nil
		}
		if err != nil && client.err == nil {
			client.err = err
		}
		client.frames = append(client.frames, received)
		client.mu.Unlock()
	}
}

// apply 应用一帧（持 mu）：Full 先清空旧对象；地形块用生成的 ApplySyncTerrainChunkDao（全量时基线为 nil）。
func (client *terrainClient) apply(f entitysync.ReceivedFrame, received *receivedFrame) error {
	if f.Kind == frame.Full {
		received.full = true
		clear(client.refs)
		clear(client.namespaces)
		clear(client.chunks)
		clear(client.buildings)
	}
	for _, object := range f.Objects {
		if object.Operation == frame.ObjectRemove {
			subject := client.refs[object.Ref]
			if client.namespaces[subject] == "terrain" {
				received.removed = append(received.removed, subject)
			}
			delete(client.refs, object.Ref)
			delete(client.namespaces, subject)
			delete(client.chunks, subject)
			delete(client.buildings, subject)
			continue
		}
		for _, component := range object.Components {
			update := component.Update
			client.refs[object.Ref] = update.SubjectID
			client.namespaces[update.SubjectID] = update.Namespace
			if update.Namespace == "building" {
				raw := update.Payload.BytesCopy()
				patch, err := db.UnmarshalSyncBuildingDao(raw)
				if err != nil {
					return err
				}
				previous := client.buildings[update.SubjectID]
				if update.Full {
					previous = nil
				}
				next, err := db.ApplySyncBuildingDao(patch, previous)
				if err != nil {
					return fmt.Errorf("apply building %d: %w", update.SubjectID, err)
				}
				client.buildings[update.SubjectID] = next
				received.buildings = append(received.buildings, buildingUpdate{subject: update.SubjectID, full: update.Full,
					componentBytes: component.Size, payloadBytes: len(raw), params: patch.Params != nil})
				continue
			}
			if update.Namespace != "terrain" {
				received.others++
 received.otherIDs=append(received.otherIDs,update.SubjectID)
				if (update.Namespace == "player" || update.Namespace == "monster") && update.Payload.Len() > 0 {
					fields, err := clientsync.DecodeFields(update)
					if err != nil {
						return fmt.Errorf("decode %s subject %d: %w", update.Namespace, update.SubjectID, err)
					}
					x, movedX := fields["pos_x"]
					y, movedY := fields["pos_y"]
					if movedX || movedY {
						at := client.positions[update.SubjectID]
						if movedX {
							at.X = asInt64(x)
						}
						if movedY {
							at.Y = asInt64(y)
						}
						client.positions[update.SubjectID] = at
						client.movedAt[update.SubjectID] = time.Now()
					}
				}
				continue
			}
			raw := update.Payload.BytesCopy()
			patch, err := db.UnmarshalSyncTerrainChunkDao(raw)
			if err != nil {
				return err
			}
			previous := client.chunks[update.SubjectID]
			if update.Full {
				previous = nil
			}
			next, err := db.ApplySyncTerrainChunkDao(patch, previous)
			if err != nil {
				return fmt.Errorf("apply terrain chunk %d: %w", update.SubjectID, err)
			}
			client.chunks[update.SubjectID] = next
			client.chunkAt[update.SubjectID] = time.Now()
			u := terrainUpdate{subject: update.SubjectID, full: update.Full, componentBytes: component.Size, payloadBytes: len(raw), materials: patch.Materials != nil}
			if patch.Heights != nil {
				u.heightsDelta, u.heightUpdates = patch.Heights.Delta, len(patch.Heights.Updates)
			}
			if patch.Materials != nil {
				u.materialsDelta, u.materialUpdates = patch.Materials.Delta, len(patch.Materials.Updates)
			}
			received.terrain = append(received.terrain, u)
		}
	}
	return nil
}

// snapshot 是客户端当前持有的改过的地形块（Version ≥ 1；Apply 返回的视图只读，这里只给引用）。没改过的块的就绪标记
// （Version 0，方案 §31.9）不在其中，见 terrainObjects。
func (client *terrainClient) snapshot() map[int64]*db.SyncTerrainChunkDao {
	client.mu.Lock()
	defer client.mu.Unlock()
	if client.err != nil {
		panic(fmt.Sprintf("the terrain client failed: %v", client.err))
	}
	out := make(map[int64]*db.SyncTerrainChunkDao, len(client.chunks))
	for id, c := range client.chunks {
		if c.Version != nil && c.Version.Value >= 1 {
			out[id] = c
		}
	}
	return out
}

// terrainObjects 是客户端当前持有的全部地形对象：改过的块与就绪标记（Version 0）。
func (client *terrainClient) terrainObjects() map[int64]*db.SyncTerrainChunkDao {
	client.mu.Lock()
	defer client.mu.Unlock()
	if client.err != nil {
		panic(fmt.Sprintf("the terrain client failed: %v", client.err))
	}
	return maps.Clone(client.chunks)
}

func (client *terrainClient) failure() error {
	client.mu.Lock()
	defer client.mu.Unlock()
	return client.err
}

// held 是客户端持有的对象数：改过的地形块（就绪标记不算，见 terrainObjects）与别的命名空间。
func (client *terrainClient) held() (terrainObjects, others int) {
	client.mu.Lock()
	defer client.mu.Unlock()
	for id, ns := range client.namespaces {
		switch ns {
		case "terrain":
			if c := client.chunks[id]; c != nil && c.Version != nil && c.Version.Value >= 1 {
				terrainObjects++
			}
		case "building":
		default:
			others++
		}
	}
	return terrainObjects, others
}

func (client *terrainClient) version(id int64) int64 {
	client.mu.Lock()
	defer client.mu.Unlock()
	if c := client.chunks[id]; c != nil && c.Version != nil {
		return c.Version.Value
	}
	return -1
}

// takeFrames 返回并清掉到目前为止收到的帧。
func (client *terrainClient) takeFrames() []receivedFrame {
	client.mu.Lock()
	defer client.mu.Unlock()
	out := client.frames
	client.frames = nil
	return out
}

// lastUpdate 是 frames 里 subject 的最后一个地形更新及其所在帧。
func lastUpdate(frames []receivedFrame, subject int64) (terrainUpdate, receivedFrame, bool) {
	for i := len(frames) - 1; i >= 0; i-- {
		for j := len(frames[i].terrain) - 1; j >= 0; j-- {
			if frames[i].terrain[j].subject == subject {
				return frames[i].terrain[j], frames[i], true
			}
		}
	}
	return terrainUpdate{}, receivedFrame{}, false
}

func centreOf(key terrain.ChunkKey) spatial.Point {
	b := key.Bounds()
	return spatial.Point{X: (b.Min.X + b.Max.X) / 2, Y: (b.Min.Y + b.Max.Y) / 2}
}

const terrainBuilder = int64(31000) // 改地形的另一个玩家（不连接）

// 方案 §9 P2：客户端收到改过的块的全量（进入视野）与增量（之后的编辑），断线重连后与服务端块版本、数据逐点一致。
// 顺带核对增量的形状：r=5m 的高度编辑与 r=3m 的改材质都是按下标的增量，守卫（>1000 点）的整平是整字段高度、
// 大面积改材质是整字段材质（D11：材质也按下标增量，维护者 2026-11-08）。
func TestTerrainChunksReachAClientOverRealTCPAndMatchAfterAReconnect(t *testing.T) {
	h := startTerrainSyncHarness(t, 8, 8, terrainViewRadius, terrainMaxVisible, true)
	at := centreOf(terrain.ChunkKey{X: 4, Y: 4})
	near := []terrain.ChunkKey{{X: 4, Y: 4}, {X: 5, Y: 4}, {X: 3, Y: 3}}
	far := terrain.ChunkKey{X: 0, Y: 7} // 远在 200m 视野外
	h.brush(t, terrainBuilder, 1, terrain.Brush{Op: terrain.BrushRaise, X: at.X, Y: at.Y, Radius: 800, Falloff: terrain.FalloffSmooth, Strength: 30})
	h.brush(t, terrainBuilder, 2, terrain.Brush{Op: terrain.BrushPaint, X: centreOf(near[1]).X, Y: centreOf(near[1]).Y, Radius: 600, Material: 9})
	h.brush(t, terrainBuilder, 3, terrain.Brush{Op: terrain.BrushFlatten, X: centreOf(near[2]).X, Y: centreOf(near[2]).Y, Radius: 900, Falloff: terrain.FalloffLinear, Target: 2000})
	h.brush(t, terrainBuilder, 4, terrain.Brush{Op: terrain.BrushRaise, X: centreOf(far).X, Y: centreOf(far).Y, Radius: 500, Strength: 10})
	if n := h.scene.terrain.shownCount(); n != 4 {
		t.Fatalf("%d edited chunks are subjects, want 4", n)
	}

	const playerID = int64(30001)
	client := h.join(t, playerID, at)
	h.flushUntil(t, "the edited chunks in view", func() bool { n, _ := client.held(); return n == len(near) })
	h.assertClientMatches(t, client, near)
	for _, f := range client.takeFrames() {
		for _, u := range f.terrain {
			if !u.full {
				t.Fatalf("a chunk entering view arrived as a delta")
			}
		}
	}

	// 增量：r=5m 抬高、r=3m / r=12m 改材质、玩家上限 r=16m 改材质（材质守卫）、守卫整平、守卫改材质，各一次。
	centre := chunkID(t, near[0])
	step := func(requestID uint64, b terrain.Brush, check func(terrainUpdate)) {
		t.Helper()
		version := h.brush(t, terrainBuilder, requestID, b).Chunks[0].Version
		h.flushUntil(t, "the delta", func() bool { return client.failure() != nil || client.version(centre) == version })
		if err := client.failure(); err != nil {
			t.Fatalf("request %d: %v", requestID, err)
		}
		update, _, ok := lastUpdate(client.takeFrames(), centre)
		if !ok || update.full {
			t.Fatalf("request %d: no delta for the edited chunk (%+v)", requestID, update)
		}
		check(update)
		h.assertClientMatches(t, client, near)
	}
	step(5, terrain.Brush{Op: terrain.BrushRaise, X: at.X + 100, Y: at.Y + 50, Radius: 500, Falloff: terrain.FalloffLinear, Strength: 20}, func(u terrainUpdate) {
		if !u.heightsDelta || u.heightUpdates == 0 || u.materials {
			t.Fatalf("an r=5m raise went out as %+v, want per-index heights only", u)
		}
	})
	step(6, terrain.Brush{Op: terrain.BrushPaint, X: at.X, Y: at.Y, Radius: 300, Material: 33}, func(u terrainUpdate) {
		if !u.materials || !u.materialsDelta || u.materialUpdates == 0 || u.materialUpdates > 30 || u.heightUpdates != 0 || u.payloadBytes > 1000 {
			t.Fatalf("an r=3m paint went out as %+v, want per-index materials only", u)
		}
	})
	// 材质守卫 500 点（维护者 2026-11-08）：r=12m 改材质（约 450 点）仍按下标；玩家上限 r=16m（约 800 点，在一块内）
	// 走整字段，约 4.1KB（按下标时约 5.3～6.4KB）。
	step(12, terrain.Brush{Op: terrain.BrushPaint, X: at.X, Y: at.Y, Radius: 1200, Material: 34}, func(u terrainUpdate) {
		if !u.materials || !u.materialsDelta || u.materialUpdates < 400 || u.materialUpdates > terrain_chunk.MaterialsGuard || u.heightUpdates != 0 {
			t.Fatalf("an r=12m paint went out as %+v, want per-index materials under the guard", u)
		}
	})
	step(13, terrain.Brush{Op: terrain.BrushPaint, X: at.X, Y: at.Y, Radius: 1600, Material: 35}, func(u terrainUpdate) {
		if !u.materials || u.materialsDelta || u.heightUpdates != 0 || u.payloadBytes < 4000 || u.payloadBytes > 5000 {
			t.Fatalf("an r=16m paint went out as %+v, want the whole materials field (over the 500-point guard)", u)
		}
	})
	step(7, terrain.Brush{Op: terrain.BrushFlatten, X: at.X, Y: at.Y, Radius: 2400, Target: 1900}, func(u terrainUpdate) {
		if u.heightsDelta || u.payloadBytes < 8000 {
			t.Fatalf("a guarded flatten went out as %+v, want the whole heights field", u)
		}
	})
	step(11, terrain.Brush{Op: terrain.BrushPaint, X: at.X, Y: at.Y, Radius: 2400, Material: 66}, func(u terrainUpdate) {
		if !u.materials || u.materialsDelta || u.heightUpdates != 0 || u.payloadBytes < 4000 || u.payloadBytes > 5000 {
			t.Fatalf("a guarded paint went out as %+v, want the whole materials field and no heights", u)
		}
	})

	// 断线：连接关掉，场景把玩家移出；不在线时改两块、新改一块。
	_ = client.connection.Close()
	deadline := time.Now().Add(5 * time.Second)
	for h.scene.Members() != 0 && time.Now().Before(deadline) {
		time.Sleep(5 * time.Millisecond)
	}
	if h.scene.Members() != 0 {
		t.Fatal("the disconnected player is still in the scene")
	}
	h.brush(t, terrainBuilder, 8, terrain.Brush{Op: terrain.BrushLower, X: at.X - 200, Y: at.Y, Radius: 700, Falloff: terrain.FalloffSmooth, Strength: 15})
	h.brush(t, terrainBuilder, 9, terrain.Brush{Op: terrain.BrushPaint, X: centreOf(near[1]).X, Y: centreOf(near[1]).Y, Radius: 1000, Material: 44})
	newly := terrain.ChunkKey{X: 4, Y: 5}
	h.brush(t, terrainBuilder, 10, terrain.Brush{Op: terrain.BrushRaise, X: centreOf(newly).X, Y: centreOf(newly).Y, Radius: 400, Strength: 5})
	_ = h.scene.Flush(h.ctx)

	again := h.join(t, playerID, at)
	want := append(slices.Clone(near), newly)
	h.flushUntil(t, "the edited chunks after the reconnect", func() bool { n, _ := again.held(); return n == len(want) })
	h.assertClientMatches(t, again, want)
	if err := again.failure(); err != nil {
		t.Fatal(err)
	}
	if lost := h.scene.manager.Stats().SessionsLost; lost != 0 {
		t.Fatalf("%d replication sessions were lost", lost)
	}
}

// chunksWithin 是中心离 at 不超过 radius 的块（地形 Interest 按块中心进视野，方案 §7；与 AOI 的实现无关地独立算出）。
func chunksWithin(meta terrain.Meta, at spatial.Point, radius int64) map[int64]terrain.ChunkKey {
	out := map[int64]terrain.ChunkKey{}
	for y := int32(0); y < meta.ChunksY; y++ {
		for x := int32(0); x < meta.ChunksX; x++ {
			key := terrain.ChunkKey{X: x, Y: y}
			if spatial.DistanceSquared(centreOf(key), at) <= radius*radius {
				id, _ := terrain_chunk.EntityID(key)
				out[id] = key
			}
		}
	}
	return out
}

// assertTerrainObjects 断言客户端持有的地形对象恰好覆盖 want（within 为 nil 时）或在 want 与 within 之间（离开滞回），
// 且每个对象都是服务端此刻对这块的说法：改过的块与服务端视图逐点相同，没改过的块是就绪标记（Version 0、当前
// BaseRevision、不带高度与材质）。
func (h *terrainSyncHarness) assertTerrainObjects(t *testing.T, client *terrainClient, want, within map[int64]terrain.ChunkKey) {
	t.Helper()
	held := client.terrainObjects()
	rev := h.process.m.Meta().BaseRevision
	for id, key := range want {
		if held[id] == nil {
			t.Fatalf("the client holds %d terrain objects, want every one of the %d chunks in view: no object for %v, so it cannot be confirmed", len(held), len(want), key)
		}
	}
	var edited []terrain.ChunkKey
	for id, got := range held {
		key, inView := want[id]
		if !inView && within != nil {
			key, inView = within[id]
		}
		if !inView {
			t.Fatalf("the client holds chunk %v outside the view", terrain_chunk.KeyOf(id))
		}
		_, version, _ := h.process.m.View().Chunk(key)
		if version >= 1 {
			edited = append(edited, key)
			continue
		}
		if got.Version == nil || got.Version.Value != 0 || got.BaseRevision == nil || got.BaseRevision.Value != rev || (got.Heights != nil && len(got.Heights.Value) != 0) || (got.Materials != nil && len(got.Materials.Value) != 0) {
			t.Fatalf("chunk %v was never edited: the client has %+v, want the base marker (version 0, base revision %d, no data)", key, got, rev)
		}
	}
	h.assertClientMatches(t, client, edited)
}

// 方案 §31.9（§31.7 ③ A，维护者 2026-11-10）：客户端的重建调度缺省要求依赖块“已确认”，确认要有服务端的说法。地形视野里
// 的每一块都下发一个 TerrainChunk 对象——改过的块是实体，没改过的块是就绪标记（Version 0）——所以客户端能把“这块没改过”
// 与“全量还没到”分开。核对：进场时视野里每一块都到；第一次改一块时同一个对象从标记换成实体的全量（没有 remove，确认
// 不中断）；移动中新进入视野的块同样到、离开的被 remove；断线重连后重新得到视野里的每一块。真实 TCP 与生产的启动步骤
// （startTerrainSync）。
func TestTerrainEveryChunkInViewReachesTheClient(t *testing.T) {
	h := startTerrainSyncHarness(t, 8, 8, terrainViewRadius, terrainMaxVisible, false)
	meta := h.process.m.Meta()
	at := centreOf(terrain.ChunkKey{X: 4, Y: 4})
	// 启动前改过 (4,4)：启动时它装成实体，其余块登记标记。
	h.brush(t, terrainBuilder, 1, terrain.Brush{Op: terrain.BrushRaise, X: at.X + 500, Y: at.Y, Radius: 400, Falloff: terrain.FalloffSmooth, Strength: 20})
	h.startSubjects(t)

	const playerID = int64(30011)
	client := h.join(t, playerID, at)
	// 块中心到视点的距离是 64m 的 √(dx² + dy²) 倍，200m 视野正好不落在任何块中心上：29 块。
	want := chunksWithin(meta, at, terrainViewRadius)
	if len(want) != 29 {
		t.Fatalf("the premise: %d chunk centres within %dm, want 29", len(want), terrainViewRadius/100)
	}
	settle := func(what string, done func() bool) int {
		t.Helper()
		for flushes := 1; flushes <= 64; flushes++ {
			if err := h.scene.Flush(h.ctx); err != nil {
				t.Fatal(err)
			}
			deadline := time.Now().Add(200 * time.Millisecond)
			for !done() && time.Now().Before(deadline) {
				time.Sleep(time.Millisecond)
			}
			if done() {
				return flushes
			}
		}
		return -1
	}
	holdsAll := func(set map[int64]terrain.ChunkKey) func() bool {
		return func() bool {
			held := client.terrainObjects()
			for id := range set {
				if held[id] == nil {
					return false
				}
			}
			return true
		}
	}
	flushes := settle("every chunk in view", holdsAll(want))
	h.assertTerrainObjects(t, client, want, nil)
	t.Logf("entering: %d terrain objects (1 edited, %d base markers) in %d flushes (snapshot budget %d per flush)", len(want), len(want)-1, flushes, terrainSnapshotsPerFlush)

	// 第一次改视野里一块没改过的块：同一个对象从 Version 0 换成实体的全量，不 remove。
	first := terrain.ChunkKey{X: 5, Y: 4}
	firstID := chunkID(t, first)
	client.takeFrames()
	version := h.brush(t, terrainBuilder, 2, terrain.Brush{Op: terrain.BrushRaise, X: centreOf(first).X, Y: centreOf(first).Y, Radius: 300, Strength: 10}).Chunks[0].Version
	if settle("the first edit", func() bool { return client.version(firstID) == version }) < 0 {
		t.Fatalf("the first edit of %v did not reach the client (holds version %d)", first, client.version(firstID))
	}
	frames := client.takeFrames()
	for _, f := range frames {
		if slices.Contains(f.removed, firstID) {
			t.Fatalf("the first edit of %v removed its object before the entity's full: the client would unconfirm it for a frame", first)
		}
	}
	if u, _, ok := lastUpdate(frames, firstID); !ok || !u.full {
		t.Fatalf("the first edit of %v reached the client as %+v, want the entity's full over the marker", first, u)
	}
	h.assertTerrainObjects(t, client, want, nil)

	// 移动：视点移到 (2,4) 的中心（128m）。新进入视野的块都到；还在的不动；离开半径（220m）以外的被 remove。
	moved := centreOf(terrain.ChunkKey{X: 2, Y: 4})
	h.scene.terrain.moved(playerID, moved)
	nowWant := chunksWithin(meta, moved, terrainViewRadius)
	stay := chunksWithin(meta, moved, terrainViewRadius+terrainViewHysteresis)
	if settle("the chunks entering view", func() bool {
		if !holdsAll(nowWant)() {
			return false
		}
		for id := range client.terrainObjects() {
			if _, ok := stay[id]; !ok {
				return false
			}
		}
		return true
	}) < 0 {
		t.Fatalf("after the move the client holds %d terrain objects; want the %d in view, none beyond %dm", len(client.terrainObjects()), len(nowWant), (terrainViewRadius+terrainViewHysteresis)/100)
	}
	h.assertTerrainObjects(t, client, nowWant, stay)

	// 断线重连：新会话重新得到视野里的每一块（标记没有变化，也要重发）。
	_ = client.connection.Close()
	deadline := time.Now().Add(5 * time.Second)
	for h.scene.Members() != 0 && time.Now().Before(deadline) {
		time.Sleep(5 * time.Millisecond)
	}
	if h.scene.Members() != 0 {
		t.Fatal("the disconnected player is still in the scene")
	}
	client = h.join(t, playerID, moved)
	if settle("every chunk in view after the reconnect", holdsAll(nowWant)) < 0 {
		t.Fatalf("after the reconnect the client holds %d terrain objects, want the %d in view", len(client.terrainObjects()), len(nowWant))
	}
	h.assertTerrainObjects(t, client, nowWant, nil)
	if stats := h.scene.manager.Stats(); stats.SessionsLost != 0 || stats.OverLimitDeferred != 0 {
		t.Fatalf("%d sessions lost, %d objects deferred over a limit", stats.SessionsLost, stats.OverLimitDeferred)
	}
}

// 方案 §9 P2：视野里改过的块多于 MaxVisible（64）时，会话持有恰好 64 块、没有对象被暂缓（OverLimitWaiting 0）——即使主视野里
// 还有 40 个怪（40 + 自己 + 64 = 105，超过缺省上限 100；地形的 64 单独计，玩家 / 怪仍是 100）。地形的全量受地形自己的
// 快照预算（每会话每 Flush 4 个）分摊；玩家与怪不占它，第一次 Flush 就全部到达（决策 D15）。不起复制循环，Flush 只由
// 测试跑，次数可数。
func TestATerrainViewAtItsCapKeepsTheSession(t *testing.T) {
	// 视野 500m：12 × 12 块（768m）的中心看得见约 190 块的中心，改其中 100 块。
	h := startTerrainSyncHarness(t, 12, 12, 50000, terrainMaxVisible, false)
	at := centreOf(terrain.ChunkKey{X: 6, Y: 6})
	edited := 0
	for y := int32(1); y < 11 && edited < 100; y++ {
		for x := int32(1); x < 11 && edited < 100; x++ {
			c := centreOf(terrain.ChunkKey{X: x, Y: y})
			edited++
			h.brush(t, terrainBuilder, uint64(edited), terrain.Brush{Op: terrain.BrushRaise, X: c.X, Y: c.Y, Radius: 200, Strength: 3})
		}
	}
	monster.RegisterEntity()
	for i := range int64(40) {
		id, err := entity.BuildEntityID(7300+i, monster.EntityKindMonster)
		if err != nil {
			t.Fatal(err)
		}
		built, err := entity.BuildEntity(&entity.EntityCreateParam{IsCreate: true, Kind: monster.EntityKindMonster, Id: id})
		if err != nil {
			t.Fatal(err)
		}
		m := built.(*monster.Monster)
		if err := h.scene.ShowSubject(h.ctx, m.Sync(), m.ID(), spatial.Point{X: at.X + 10 + i, Y: at.Y + 5}); err != nil {
			t.Fatal(err)
		}
	}
	const playerID = int64(30002)
	client := h.join(t, playerID, at)
	started := time.Now()
	firstFlush := true
	var othersAfterFirst, terrainAfterFirst int
	flushes := h.flushUntil(t, "the full terrain view and the monsters", func() bool {
		if firstFlush {
			// 第一次 Flush 的帧已经推到回环 socket；等客户端读完再数。
			deadline := time.Now().Add(2 * time.Second)
			for {
				terrainAfterFirst, othersAfterFirst = client.held()
				if othersAfterFirst == 41 || time.Now().After(deadline) {
					break
				}
				time.Sleep(time.Millisecond)
			}
			firstFlush = false
		}
		terrainHeld, others := client.held()
		return terrainHeld == terrainMaxVisible && others == 41
	})
	took := time.Since(started)
	for range 5 {
		_ = h.scene.Flush(h.ctx)
	}
	if stats := h.scene.manager.Stats(); stats.SessionsLost != 0 || stats.OverLimitDeferred != 0 {
		t.Fatalf("%d replication sessions lost, %d objects deferred over a limit (object limit %d): the view's cap keeps the session inside it",
			stats.SessionsLost, stats.OverLimitDeferred, h.scene.sessionObjects+terrainMaxVisible)
	}
	if n := h.transport.ActiveSessions(playerID); n != 1 {
		t.Fatalf("the player has %d connections, want 1", n)
	}
	terrainHeld, others := client.held()
	if terrainHeld != terrainMaxVisible || others != 41 {
		t.Fatalf("the client holds %d chunks and %d other objects, want %d and 41", terrainHeld, others, terrainMaxVisible)
	}
	// 快照预算只管地形：怪与自己（41 个）第一次 Flush 全部到达，地形第一次只到 4 块；64 块地形每次 Flush 至多 4 个全量，
	// 至少 16 次 Flush。
	if othersAfterFirst != 41 || terrainAfterFirst > terrainSnapshotsPerFlush {
		t.Fatalf("after the first flush the client holds %d other objects and %d chunks, want all 41 others (no budget) and at most %d chunks",
			othersAfterFirst, terrainAfterFirst, terrainSnapshotsPerFlush)
	}
	if flushes < (terrainMaxVisible+terrainSnapshotsPerFlush-1)/terrainSnapshotsPerFlush {
		t.Fatalf("the whole view arrived in %d flushes; the terrain snapshot budget of %d per flush was not applied", flushes, terrainSnapshotsPerFlush)
	}
	t.Logf("edited chunks %d, chunks held %d, other objects %d, flushes to the full view %d (%v)", edited, terrainHeld, others, flushes, took)
}

// 决策 D15：地形的对象上限与快照预算不影响玩家和怪。开了地形（视野里一块改过的块都没有）时，玩家与怪收到的每一帧
// 与不开地形时逐字节相同：进入视野不按地形的每会话 4 个延后，离开视野照常 remove，Hold / Ready 后的全量也一样。
func TestTerrainLeavesPlayerAndMonsterReplicationByteIdentical(t *testing.T) {
	run := func(withTerrain bool) [][]byte {
		recorder := newSceneRecorder()
		config := gamescene.DefaultConfig()
		var terrainConfig *terrainSyncConfig
		if withTerrain {
			terrainConfig = defaultTerrainSync(spatial.Rect{Max: spatial.Point{X: config.Width, Y: config.Height}})
		}
		scene, err := newSceneWith(sceneLane{transport: recorder}, recorder, nil, config, config.View.MaxVisible, terrainConfig)
		if err != nil {
			t.Fatal(err)
		}
		t.Cleanup(func() {
			closeCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
			defer cancel()
			_ = scene.Close(closeCtx)
		})
		if (scene.terrain != nil) != withTerrain {
			t.Fatalf("terrain sync on=%v, want %v", scene.terrain != nil, withTerrain)
		}
		ctx := context.Background()
		monster.RegisterEntity()
		monsters := make([]*monster.Monster, 0, 12)
		for i := range int64(12) {
			id, err := entity.BuildEntityID(7500+i, monster.EntityKindMonster)
			if err != nil {
				t.Fatal(err)
			}
			built, err := entity.BuildEntity(&entity.EntityCreateParam{IsCreate: true, Kind: monster.EntityKindMonster, Id: id})
			if err != nil {
				t.Fatal(err)
			}
			m := built.(*monster.Monster)
			monsters = append(monsters, m)
			if err := scene.ShowSubject(ctx, m.Sync(), m.ID(), spatial.Point{X: config.Spawn.X + 30 + i, Y: config.Spawn.Y}); err != nil {
				t.Fatal(err)
			}
		}
		const observer = int64(32001)
		var joined []int64
		for i := range int64(3) {
			subject := newScenePlayer(t, observer+i)
			joinReady(t, scene, ctx, subject, spatial.Point{X: config.Spawn.X + i, Y: config.Spawn.Y})
			joined = append(joined, subject.ID())
		}
		var frames [][]byte
		flush := func() {
			if err := scene.Flush(ctx); err != nil {
				t.Fatal(err)
			}
			for _, push := range recorder.take(observer) {
				frames = append(frames, push.Payload)
			}
			frames = append(frames, nil) // Flush 的分界
		}
		flush()
		flush()
		// 怪离开视野（remove）、一个玩家离场、观察者 Hold / Ready 重新开始。
		scene.HideSubject(ctx, monsters[0].ID())
		scene.Leave(ctx, joined[2])
		flush()
		if err := scene.manager.HoldSession(entitysync.SessionID(observer)); err != nil {
			t.Fatal(err)
		}
		if err := scene.manager.ReadySession(entitysync.SessionID(observer)); err != nil {
			t.Fatal(err)
		}
		flush()
		flush()
		if lost := scene.manager.Stats().SessionsLost; lost != 0 {
			t.Fatalf("%d sessions lost", lost)
		}
		return frames
	}
	plain, withTerrain := run(false), run(true)
	// 前提：第一次 Flush 就送达 12 个怪、两个玩家与观察者自己——超过地形每会话 4 个的预算，所以如果预算套在玩家 / 怪
	// 身上，这里的帧就会不同。
	created := 0
	for _, raw := range plain {
		if raw == nil {
			break
		}
		decoded, err := entitysync.DecodeFrame(raw, frame.DefaultLimits())
		if err != nil {
			t.Fatal(err)
		}
		for _, object := range decoded.Objects {
			if object.Operation == frame.ObjectCreate {
				created++
			}
		}
	}
	if created <= terrainSnapshotsPerFlush {
		t.Fatalf("the first flush created %d objects; the premise needs more than the terrain budget of %d", created, terrainSnapshotsPerFlush)
	}
	if len(plain) != len(withTerrain) {
		t.Fatalf("the observer got %d frames (with flush marks) without terrain, %d with terrain", len(plain), len(withTerrain))
	}
	for i := range plain {
		if !bytes.Equal(plain[i], withTerrain[i]) {
			t.Fatalf("frame %d differs once terrain sync is on: players and monsters must replicate exactly as without terrain", i)
		}
	}
	t.Logf("%d frames byte-identical; first flush created %d objects", len(plain), created)
}

// 决策 D15 的另一半：地形的 64 不放宽玩家 / 怪的上限。开了地形，101 个玩家挤在一起（每人要持有自己与另外 100 人，
// 101 > 100）：与 TestACrowdOverflowingASessionShrinksTheViewInsteadOfDisconnecting 不开地形时相同——不断开（超额降级，
// D17），每人在玩家 / 怪这一类里恰好持有 100 个（自己 + 最近的 99 人），引用表合起来是 164 也不让玩家占地形的名额。
func TestTerrainDoesNotWidenThePlayerObjectLimit(t *testing.T) {
	recorder := newSceneRecorder()
	config := gamescene.DefaultConfig()
	scene, err := newSceneWith(sceneLane{transport: recorder}, recorder, nil, config, 0,
		defaultTerrainSync(spatial.Rect{Max: spatial.Point{X: config.Width, Y: config.Height}}))
	if err != nil {
		t.Fatal(err)
	}
	scene.watchSessions(recorder)
	t.Cleanup(func() {
		closeCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		_ = scene.Close(closeCtx)
	})
	ctx := context.Background()
	disconnectsBefore := sessionLostDisconnects()
	const players = 101
	ids := make([]int64, 0, players)
	subjects := make(map[int64]int64, players)
	positions := make(map[int64]spatial.Point, players)
	for i := range int64(players) {
		playerID := 33000 + i
		at := spatial.Point{X: config.Spawn.X + i%12, Y: config.Spawn.Y + i/12}
		subject := newScenePlayer(t, playerID)
		joinReady(t, scene, ctx, subject, at)
		ids = append(ids, playerID)
		subjects[playerID] = subject.ID()
		positions[subject.ID()] = at
	}
	flushOverCrowd(t, scene, ctx)
	if stats := scene.manager.Stats(); stats.SessionsLost != 0 || stats.OverLimitDeferred == 0 {
		t.Fatalf("with terrain on: %d sessions lost, %d objects ever deferred (want 0 lost and the crowd overflowing)", stats.SessionsLost, stats.OverLimitDeferred)
	}
	if got := sessionLostDisconnects() - disconnectsBefore; got != 0 {
		t.Fatalf("%d players disconnected for a lost session", got)
	}
	for _, playerID := range ids {
		held := heldSubjects(t, recorder.take(playerID))
		if len(held) != frame.DefaultLimits().MaxObjects || !held[subjects[playerID]] {
			t.Fatalf("player %d holds %d objects with terrain on, want itself among exactly the player limit %d", playerID, len(held), frame.DefaultLimits().MaxObjects)
		}
		assertDroppedAreFarthest(t, playerID, positions[subjects[playerID]], subjects[playerID], held, positions)
	}
}

// 地形块超过它自己的上限（视野上限配成 80 > 64）：与玩家 / 怪超过 100 相同——不断开、不截断（超额降级，D17）。Manager
// 暂缓放不下的块并通知地形的 Interest，视野收紧到 64、从最远的块开始退订；真实 TCP 下客户端最终恰好持有离它最近的
// 64 块，与地形 Interest 要它持有的集合一致。之后玩家走到改过的块稀少的角落：视野里的块少于上限，不再有暂缓。
func TestTerrainChunksOverTheirLimitShrinkTheView(t *testing.T) {
	h := startTerrainSyncHarness(t, 12, 12, 50000, terrainMaxVisible+16, false)
	h.scene.watchSessions(h.transport)
	at := centreOf(terrain.ChunkKey{X: 6, Y: 6})
	edited := map[int64]spatial.Point{}
	for y := int32(1); y < 11 && len(edited) < 100; y++ {
		for x := int32(1); x < 11 && len(edited) < 100; x++ {
			key := terrain.ChunkKey{X: x, Y: y}
			c := centreOf(key)
			h.brush(t, terrainBuilder, uint64(len(edited)+1), terrain.Brush{Op: terrain.BrushRaise, X: c.X, Y: c.Y, Radius: 200, Strength: 3})
			edited[chunkID(t, key)] = c
		}
	}
	disconnectsBefore := sessionLostDisconnects()
	const playerID = int64(30003)
	client := h.join(t, playerID, at)
	// 视野里改过的块（约 100 块）多于 64：收敛到“客户端持有 64 块、与 Interest 要的一致、没有暂缓”。
	wanted := func() map[int64]bool {
		seen := map[int64]bool{}
		for _, id := range h.scene.terrain.interest.Seen(playerID) {
			seen[id] = true
		}
		return seen
	}
	converged := func() bool {
		held := client.snapshot()
		want := wanted()
		if len(held) != terrainMaxVisible || len(want) != terrainMaxVisible || h.scene.manager.Stats().OverLimitWaiting != 0 {
			return false
		}
		for id := range held {
			if !want[id] {
				return false
			}
		}
		return true
	}
	flushes := h.flushUntil(t, "the terrain view settling at its limit", converged)
	stats := h.scene.manager.Stats()
	if stats.SessionsLost != 0 || stats.OverLimitDeferred == 0 {
		t.Fatalf("stats %+v: want no session lost and some chunks deferred (the test's premise)", stats)
	}
	if got := sessionLostDisconnects() - disconnectsBefore; got != 0 {
		t.Fatalf("%d disconnects for a lost session", got)
	}
	if n := h.transport.ActiveSessions(playerID); n != 1 {
		t.Fatalf("the player has %d connections, want 1", n)
	}
	held := map[int64]bool{}
	for id := range client.snapshot() {
		held[id] = true
	}
	assertDroppedAreFarthest(t, playerID, at, 0, held, edited)
	// 客户端拿到的每一块都与服务端一致（全量完整、没有截断）。
	var keys []terrain.ChunkKey
	for y := int32(0); y < 12; y++ {
		for x := int32(0); x < 12; x++ {
			if held[chunkID(t, terrain.ChunkKey{X: x, Y: y})] {
				keys = append(keys, terrain.ChunkKey{X: x, Y: y})
			}
		}
	}
	h.assertClientMatches(t, client, keys)
	// 走到角落：视野里改过的块少于上限，原先被去掉的块里够得着的补上，不再有暂缓。
	corner := centreOf(terrain.ChunkKey{X: 1, Y: 1})
	h.scene.terrain.moved(playerID, corner)
	h.flushUntil(t, "the corner view", func() bool {
		held := client.snapshot()
		want := wanted()
		if len(want) == 0 || len(want) >= terrainMaxVisible || len(held) != len(want) || h.scene.manager.Stats().OverLimitWaiting != 0 {
			return false
		}
		for id := range held {
			if !want[id] {
				return false
			}
		}
		return true
	})
	if lost := h.scene.manager.Stats().SessionsLost; lost != 0 {
		t.Fatalf("%d sessions lost", lost)
	}
	t.Logf("settled at %d chunks after %d flushes; %d chunks ever deferred", terrainMaxVisible, flushes, stats.OverLimitDeferred)
}

// ---- 测量（方案 §7.1 / §9 P2，材质改列表、编辑配额后重测）：ROOST_TERRAIN_MEASURE=1 时运行，数字写进证据目录 ----

func measuring(t *testing.T) {
	t.Helper()
	if os.Getenv("ROOST_TERRAIN_MEASURE") == "" {
		t.Skip("ROOST_TERRAIN_MEASURE not set (measurements, see docs/maintenance/evidence/terrain-quota-20261108)")
	}
}

// 单块增量的实际字节：r=5m 高度增量、材质按下标增量（单独与同时改高度；同时改的两项各在没改过材质的地方）、
// 守卫整字段、进入视野的全量。
func TestTerrainMeasureUpdateBytes(t *testing.T) {
	measuring(t)
	h := startTerrainSyncHarness(t, 8, 8, terrainViewRadius, terrainMaxVisible, false)
	key := terrain.ChunkKey{X: 4, Y: 4}
	at := centreOf(key)
	h.brush(t, terrainBuilder, 1, terrain.Brush{Op: terrain.BrushRaise, X: at.X, Y: at.Y, Radius: 300, Strength: 1})
	client := h.join(t, 30010, at)
	h.flushUntil(t, "the chunk", func() bool { n, _ := client.held(); return n == 1 })
	id := chunkID(t, key)
	report := func(name string) {
		update, f, ok := lastUpdate(client.takeFrames(), id)
		if !ok {
			t.Fatalf("%s: no update", name)
		}
		t.Logf("MEASURE %-40s payload=%6d component=%6d frame=%6d wire=%6d heights_delta=%v height_updates=%d materials=%v materials_delta=%v material_updates=%d",
			name, update.payloadBytes, update.componentBytes, f.frameBytes, f.wireBytes, update.heightsDelta, update.heightUpdates, update.materials, update.materialsDelta, update.materialUpdates)
	}
	report("full snapshot (enter view)")
	// 每项的笔刷在同一次 Flush 之前做完（同一块的多次编辑合成一个增量，与真实的 50ms 合批相同）。材质编号 < 128 时
	// 值是 1 字节 varint，≥ 128 时 2 字节，两种都测。
	request := uint64(10)
	for _, tc := range []struct {
		name    string
		brushes []terrain.Brush
	}{
		{"raise r=5m linear", []terrain.Brush{{Op: terrain.BrushRaise, X: at.X, Y: at.Y, Radius: 500, Falloff: terrain.FalloffLinear, Strength: 20}}},
		{"raise r=5m constant (81 points)", []terrain.Brush{{Op: terrain.BrushRaise, X: at.X, Y: at.Y, Radius: 500, Strength: 20}}},
		{"raise r=16m smooth", []terrain.Brush{{Op: terrain.BrushRaise, X: at.X, Y: at.Y, Radius: 1600, Falloff: terrain.FalloffSmooth, Strength: 40}}},
		{"paint r=5m material 21", []terrain.Brush{{Op: terrain.BrushPaint, X: at.X, Y: at.Y, Radius: 500, Material: 21}}},
		{"paint r=5m material 200", []terrain.Brush{{Op: terrain.BrushPaint, X: at.X, Y: at.Y, Radius: 500, Material: 200}}},
		{"raise r=5m linear + paint r=5m (21)", []terrain.Brush{
			{Op: terrain.BrushRaise, X: at.X, Y: at.Y + 1500, Radius: 500, Falloff: terrain.FalloffLinear, Strength: 20},
			{Op: terrain.BrushPaint, X: at.X, Y: at.Y + 1500, Radius: 500, Material: 21},
		}},
		{"raise r=5m linear + paint r=5m (200)", []terrain.Brush{
			{Op: terrain.BrushRaise, X: at.X, Y: at.Y - 1500, Radius: 500, Falloff: terrain.FalloffLinear, Strength: 20},
			{Op: terrain.BrushPaint, X: at.X, Y: at.Y - 1500, Radius: 500, Material: 200},
		}},
		{"paint r=10m material 22", []terrain.Brush{{Op: terrain.BrushPaint, X: at.X, Y: at.Y, Radius: 1000, Material: 22}}},
		{"paint r=16m material 21 (player cap)", []terrain.Brush{{Op: terrain.BrushPaint, X: at.X, Y: at.Y, Radius: 1600, Material: 21}}},
		{"paint r=16m material 200 (player cap)", []terrain.Brush{{Op: terrain.BrushPaint, X: at.X, Y: at.Y, Radius: 1600, Material: 200}}},
		{"paint r=24m (guard, whole materials)", []terrain.Brush{{Op: terrain.BrushPaint, X: at.X, Y: at.Y, Radius: 2400, Material: 23}}},
		{"flatten r=24m (guard, whole heights)", []terrain.Brush{{Op: terrain.BrushFlatten, X: at.X, Y: at.Y, Radius: 2400, Target: 777}}},
	} {
		var version int64
		for _, b := range tc.brushes {
			request++
			version = h.brush(t, terrainBuilder, request, b).Chunks[0].Version
		}
		h.flushUntil(t, tc.name, func() bool { return client.version(id) == version })
		report(tc.name)
	}
	// 持久文档大小（整文档 BSON，Marshal 即投影整文档写入的内容）：Heights 与 Materials 都是 BSON int32 数组。
	if e, _ := h.process.entities.Get(id).(*terrain_chunk.TerrainChunk); e != nil {
		t.Logf("MEASURE stored document (whole BSON) bytes=%d", len(e.Dao().Marshal()))
	}
}

// 下行字节 / 秒的模拟（方案 §7.1 两档）。单进程、离线存储，复制循环不起：模拟时间按“拍”走，一拍 = 50ms = 一次
// Flush，每拍之前做这一拍的编辑 / 移动；客户端是同一进程里的真实 TCP 接收端。测的是一个观察者收到的下行字节，
// 不是时延；同一块在同一拍里的多次编辑合成一个增量（与真实的 50ms 合批相同）。
func TestTerrainMeasureDownlinkScenarios(t *testing.T) {
	measuring(t)
	const ticksPerSecond = 20
	// warm 是不计入的预热拍数（tick 照常调用，拍号从 0 连续编号）：配额档用它跳过开头每人一满桶的突发。
	runWarm := func(t *testing.T, name string, warm, seconds int, setup func(h *terrainSyncHarness) spatial.Point, tick func(h *terrainSyncHarness, tick int, observer int64)) {
		h := startTerrainSyncHarness(t, 16, 16, terrainViewRadius, terrainMaxVisible, false)
		at := setup(h)
		const observer = int64(30020)
		client := h.join(t, observer, at)
		for range 60 { // 先把进入视野的全量发完，测的是之后的稳态
			_ = h.scene.Flush(h.ctx)
		}
		for i := range warm {
			tick(h, i, observer)
			if err := h.scene.Flush(h.ctx); err != nil {
				t.Fatal(err)
			}
		}
		time.Sleep(50 * time.Millisecond)
		client.takeFrames()
		for i := warm; i < warm+seconds*ticksPerSecond; i++ {
			tick(h, i, observer)
			if err := h.scene.Flush(h.ctx); err != nil {
				t.Fatal(err)
			}
		}
		time.Sleep(100 * time.Millisecond)
		frames := client.takeFrames()
		var wire, payload, full, delta int
		for _, f := range frames {
			if len(f.terrain) == 0 {
				continue
			}
			wire += f.wireBytes
			for _, u := range f.terrain {
				payload += u.payloadBytes
				if u.full {
					full++
				} else {
					delta++
				}
			}
		}
		if err := client.failure(); err != nil {
			t.Fatal(err)
		}
		if lost := h.scene.manager.Stats().SessionsLost; lost != 0 {
			t.Fatalf("%d sessions lost", lost)
		}
		t.Logf("MEASURE %-50s %7.1f KB/s on the wire (%7.1f KB/s DAO payload), %d full + %d delta chunk updates in %d s",
			name, float64(wire)/1024/float64(seconds), float64(payload)/1024/float64(seconds), full, delta, seconds)
	}
	run := func(t *testing.T, name string, seconds int, setup func(h *terrainSyncHarness) spatial.Point, tick func(h *terrainSyncHarness, tick int, observer int64)) {
		runWarm(t, name, 0, seconds, setup, tick)
	}
	// 建造热点：观察者站在块 (8,8) 中心，附近 20 人每人每秒一次编辑（落在观察者 ±40m 内，轮流：每拍一人），材质比例
	// 0 / 50% / 100%（带材质的编辑 = 一次抬高 + 同一处一次改材质）。笔刷 r=5m（方案 §7.1 的假设）；另测玩家半径上限
	// r=16m 两档，看笔刷大小对下行的影响。
	for _, c := range []struct{ radius, share int }{{500, 0}, {500, 50}, {500, 100}, {1600, 0}, {1600, 100}} {
		name := fmt.Sprintf("hotspot_material_%d", c.share)
		label := fmt.Sprintf("hot spot, 20 editors x 1/s, %d%% with material", c.share)
		if c.radius != 500 {
			name = fmt.Sprintf("hotspot_r%dm_material_%d", c.radius/100, c.share)
			label = fmt.Sprintf("hot spot r=%dm, 20 editors x 1/s, %d%% with material", c.radius/100, c.share)
		}
		t.Run(name, func(t *testing.T) {
			rng := rand.New(rand.NewPCG(7, uint64(c.share)))
			var request uint64
			centre := centreOf(terrain.ChunkKey{X: 8, Y: 8})
			run(t, label, 20, func(h *terrainSyncHarness) spatial.Point {
				return centre
			}, func(h *terrainSyncHarness, tick int, _ int64) {
				editor := tick % 20
				x, y := centre.X+rng.Int64N(8000)-4000, centre.Y+rng.Int64N(8000)-4000
				request++
				h.brush(t, terrainBuilder+int64(editor), request, terrain.Brush{Op: terrain.BrushRaise, X: x, Y: y, Radius: int64(c.radius), Falloff: terrain.FalloffLinear, Strength: 5})
				if editor*100/20 < c.share {
					request++
					h.brush(t, terrainBuilder+int64(editor), request, terrain.Brush{Op: terrain.BrushPaint, X: x, Y: y, Radius: int64(c.radius), Material: byte(tick)})
				}
			})
		})
	}
	// 配额满速的建造热点（维护者 2026-11-08：每人每秒 270 个改动点，令牌桶容量 270、满桶可透支一次、每次至少 20 点）：
	// 附近 20 人每拍（50ms）都尝试自己的下一笔，配额允许就做、同一拍里接着做下一笔，被拒（ErrRateLimited）就等下一拍。
	// 一轮是在 ±40m 内随机一处的几笔（抬高，或抬高 + 同处改材质），做完换一处。热点里的 9 块先改过一次、全量在预热
	// 里发完；每人在头 3 秒内的随机一拍开始编辑（真实玩家不会同一拍开工、步调一致），再预热 2 秒，跳过开头每人一满桶
	// 加一次透支的突发，测的是稳态的增量下行。配额用模拟时钟（拍号 × 50ms）。
	type quotaStroke struct {
		op     terrain.BrushOp
		radius int64
	}
	for _, c := range []struct {
		name    string
		label   string
		rounds  [][]quotaStroke // 编辑者 i 用 rounds[i % len(rounds)]
		seconds int
	}{
		{"quota_r5m_raise", "quota hot spot, 20 editors, r=5m raise", [][]quotaStroke{{{terrain.BrushRaise, 500}}}, 20},
		{"quota_r5m_raise_paint", "quota hot spot, 20 editors, r=5m raise + paint", [][]quotaStroke{{{terrain.BrushRaise, 500}, {terrain.BrushPaint, 500}}}, 20},
		{"quota_r16m_raise", "quota hot spot, 20 editors, r=16m raise", [][]quotaStroke{{{terrain.BrushRaise, 1600}}}, 20},
		{"quota_r16m_raise_paint", "quota hot spot, 20 editors, r=16m raise + paint", [][]quotaStroke{{{terrain.BrushRaise, 1600}, {terrain.BrushPaint, 1600}}}, 20},
		{"quota_mixed", "quota hot spot, 20 editors, mixed r=5m/r=16m (+paint)", [][]quotaStroke{
			{{terrain.BrushRaise, 500}, {terrain.BrushPaint, 500}},
			{{terrain.BrushRaise, 1600}},
			{{terrain.BrushRaise, 1600}, {terrain.BrushPaint, 1600}},
			{{terrain.BrushRaise, 500}},
		}, 20},
		{"quota_r5m_raise_paint_60s", "quota hot spot, 20 editors, r=5m raise + paint", [][]quotaStroke{{{terrain.BrushRaise, 500}, {terrain.BrushPaint, 500}}}, 60},
		{"quota_r16m_raise_paint_60s", "quota hot spot, 20 editors, r=16m raise + paint", [][]quotaStroke{{{terrain.BrushRaise, 1600}, {terrain.BrushPaint, 1600}}}, 60},
	} {
		t.Run(c.name, func(t *testing.T) {
			rng := rand.New(rand.NewPCG(13, uint64(len(c.name))))
			centre := centreOf(terrain.ChunkKey{X: 8, Y: 8})
			start := time.Unix(1_800_000_000, 0)
			clock := start
			type editor struct {
				x, y   int64
				stroke int
				begin  int // 开始编辑的拍号
			}
			editors := make([]editor, 20)
			var request uint64
			var points, edits, refused int
			const warm = 100 // 5 秒
			var counting bool
			runWarm(t, c.label, warm, c.seconds, func(h *terrainSyncHarness) spatial.Point {
				for y := int32(7); y <= 9; y++ {
					for x := int32(7); x <= 9; x++ {
						at := centreOf(terrain.ChunkKey{X: x, Y: y})
						request++
						h.brush(t, terrainBuilder, request, terrain.Brush{Op: terrain.BrushRaise, X: at.X, Y: at.Y, Radius: 300, Strength: 1})
					}
				}
				h.process.m.SetPolicy(terrainmap.DefaultPolicy)
				h.process.m.SetClock(func() time.Time { return clock })
				for i := range editors {
					editors[i] = editor{x: centre.X + rng.Int64N(8000) - 4000, y: centre.Y + rng.Int64N(8000) - 4000, begin: rng.IntN(60)}
				}
				return centre
			}, func(h *terrainSyncHarness, tick int, _ int64) {
				clock = start.Add(time.Duration(tick) * 50 * time.Millisecond)
				counting = tick >= warm
				for i := range editors {
					e := &editors[i]
					if tick < e.begin {
						continue
					}
					round := c.rounds[i%len(c.rounds)]
					for {
						stroke := round[e.stroke]
						b := terrain.Brush{Op: stroke.op, X: e.x, Y: e.y, Radius: stroke.radius, Falloff: terrain.FalloffLinear, Strength: 5, Material: byte(tick)}
						heights, materials, err := h.process.m.View().BrushChanges(b, h.process.m.Policy().Limits)
						if err != nil {
							t.Fatal(err)
						}
						request++
						if _, err := h.process.m.Brush(h.ctx, terrainBuilder+1+int64(i), request, b); errors.Is(err, terrainmap.ErrRateLimited) {
							if counting {
								refused++
							}
							break
						} else if err != nil {
							t.Fatalf("editor %d: %v", i, err)
						}
						if counting {
							points += max(heights+materials, terrainmap.DefaultPolicy.MinEditPoints)
							edits++
						}
						e.stroke++
						if e.stroke == len(round) {
							e.stroke, e.x, e.y = 0, centre.X+rng.Int64N(8000)-4000, centre.Y+rng.Int64N(8000)-4000
						}
					}
				}
			})
			t.Logf("MEASURE   %-50s charged %.0f points/s (%.0f per editor), %.1f edits/s, %d attempts refused for quota",
				c.label, float64(points)/float64(c.seconds), float64(points)/float64(c.seconds)/20, float64(edits)/float64(c.seconds), refused)
		})
	}
	// 跑图进入改过的区域：观察者从块 (1,8) 中心向东匀速跑 30 秒（6 m/s 跑步、12 m/s 坐骑），沿途全部 / 20% 的块改过
	// （每块一次小编辑）。
	for _, c := range []struct{ speed, share int }{{6, 100}, {6, 20}, {12, 100}, {12, 20}} {
		t.Run(fmt.Sprintf("run_%dmps_edited_%d", c.speed, c.share), func(t *testing.T) {
			rng := rand.New(rand.NewPCG(11, uint64(c.share)))
			var at spatial.Point
			run(t, fmt.Sprintf("running at %d m/s, %d%% of the chunks edited", c.speed, c.share), 30, func(h *terrainSyncHarness) spatial.Point {
				request := uint64(0)
				for y := int32(0); y < 16; y++ {
					for x := int32(0); x < 16; x++ {
						if rng.IntN(100) >= c.share {
							continue
						}
						centre := centreOf(terrain.ChunkKey{X: x, Y: y})
						request++
						h.brush(t, terrainBuilder, request, terrain.Brush{Op: terrain.BrushRaise, X: centre.X, Y: centre.Y, Radius: 300, Strength: 2})
					}
				}
				at = centreOf(terrain.ChunkKey{X: 1, Y: 8})
				return at
			}, func(h *terrainSyncHarness, _ int, observer int64) {
				at.X += int64(c.speed) * 100 / ticksPerSecond
				// 直接移动地形视点（场景的移动链路在提交后做同一件事，按 terrainViewStep 节流，见 terrainMoves；这里省掉
				// 玩家实体的移动事务）。
				if err := h.scene.terrain.interest.MoveView(observer, at); err != nil {
					t.Fatal(err)
				}
			})
		})
	}
}

// 单次编辑在 Nest short 池的耗时与单格吞吐：Map.Brush 端到端（Nest 准入 → 锁 4 块以内 → handler → 提交（离线提交器，
// 不含 WAL / Mongo）→ 提交后装视图 → 回复）。handler 本身的计算另见 gameplay/terrain 的 BenchmarkBrushApplyPlayerRadius。
func TestTerrainMeasureBrushCost(t *testing.T) {
	measuring(t)
	pack := writeTerrainPackSized(t, t.TempDir(), 16, 16)
	p := startTerrainProcessWith(t, pack, wholeMap, &memoryChunkStore{}, func(p *terrainProcess) {
		policy := terrainmap.DefaultPolicy
		policy.MaxRadius, policy.EditPointsPerSecond = 2500, 0
		p.m.SetPolicy(policy)
	})
	// 先把要用到的块都建出来，测的是改块事务本身。
	for y := int32(0); y < 16; y++ {
		for x := int32(0); x < 16; x++ {
			c := centreOf(terrain.ChunkKey{X: x, Y: y})
			if _, err := p.m.Brush(p.ctx, 1, uint64(y*16+x+1), terrain.Brush{Op: terrain.BrushPaint, X: c.X, Y: c.Y, Radius: 100, Material: 1}); err != nil {
				t.Fatal(err)
			}
		}
	}
	var seq uint64 // 玩家 2 的编辑序号：按玩家单调递增（D18）
	measure := func(name string, n int, brushOf func(i int) terrain.Brush) {
		durations := make([]time.Duration, n)
		for i := range n {
			b := brushOf(i)
			seq++
			started := time.Now()
			if _, err := p.m.Brush(p.ctx, 2, seq, b); err != nil {
				t.Fatal(err)
			}
			durations[i] = time.Since(started)
		}
		sort.Slice(durations, func(a, b int) bool { return durations[a] < durations[b] })
		var total time.Duration
		for _, d := range durations {
			total += d
		}
		t.Logf("MEASURE %-40s n=%d mean=%v p50=%v p99=%v max=%v", name, n, total/time.Duration(n), durations[n/2], durations[n*99/100], durations[n-1])
	}
	measure("brush r=5m linear (points, 1 chunk)", 2000, func(i int) terrain.Brush {
		c := centreOf(terrain.ChunkKey{X: int32(i % 16), Y: int32(i / 16 % 16)})
		return terrain.Brush{Op: terrain.BrushRaise, X: c.X, Y: c.Y, Radius: 500, Falloff: terrain.FalloffLinear, Strength: 1 + uint16(i%3)}
	})
	measure("brush r=16m smooth on a corner (4 chunks)", 1000, func(i int) terrain.Brush {
		k := terrain.ChunkKey{X: int32(1 + i%14), Y: int32(1 + i/14%14)}
		return terrain.Brush{Op: terrain.BrushRaise, X: k.Origin().X, Y: k.Origin().Y, Radius: 1600, Falloff: terrain.FalloffSmooth, Strength: 1 + uint16(i%3)}
	})
	measure("flatten r=24m (whole-field guard)", 500, func(i int) terrain.Brush {
		c := centreOf(terrain.ChunkKey{X: int32(i % 16), Y: int32(i / 16 % 16)})
		return terrain.Brush{Op: terrain.BrushFlatten, X: c.X, Y: c.Y, Radius: 2400, Target: uint16(1000 + i%7*50)}
	})
	// 配额开着（额度大到不拒）：多出来的是事务之前在视图上数改动点数（View.BrushChanges，不复制块数据）。
	policy := p.m.Policy()
	policy.EditPointsPerSecond = 1 << 30
	p.m.SetPolicy(policy)
	measure("brush r=5m linear, quota on", 2000, func(i int) terrain.Brush {
		c := centreOf(terrain.ChunkKey{X: int32(i % 16), Y: int32(i / 16 % 16)})
		return terrain.Brush{Op: terrain.BrushRaise, X: c.X, Y: c.Y, Radius: 500, Falloff: terrain.FalloffLinear, Strength: 1 + uint16(i%3)}
	})
	measure("brush r=16m smooth on a corner, quota on", 1000, func(i int) terrain.Brush {
		k := terrain.ChunkKey{X: int32(1 + i%14), Y: int32(1 + i/14%14)}
		return terrain.Brush{Op: terrain.BrushRaise, X: k.Origin().X, Y: k.Origin().Y, Radius: 1600, Falloff: terrain.FalloffSmooth, Strength: 1 + uint16(i%3)}
	})
	policy.EditPointsPerSecond = 0
	p.m.SetPolicy(policy)
	// 吞吐：8 个编辑者各改自己的一列块（互不争锁），每人 500 次。
	started := time.Now()
	var wg sync.WaitGroup
	for editor := range 8 {
		wg.Go(func() {
			for i := range 500 {
				c := centreOf(terrain.ChunkKey{X: int32(editor * 2), Y: int32(i % 16)})
				if _, err := p.m.Brush(p.ctx, int64(100+editor), uint64(i+1), terrain.Brush{Op: terrain.BrushRaise, X: c.X, Y: c.Y, Radius: 500, Falloff: terrain.FalloffLinear, Strength: 1}); err != nil {
					t.Error(err)
					return
				}
			}
		})
	}
	wg.Wait()
	t.Logf("MEASURE throughput: 8 editors x 500 r=5m edits on distinct chunks = %.0f edits/s (offline committer, 4 short workers)", 4000/time.Since(started).Seconds())
}

func writeTerrainPackSized(t *testing.T, dir string, chunksX, chunksY int32) string {
	t.Helper()
	path := filepath.Join(dir, fmt.Sprintf("terrain-%dx%d.pack", chunksX, chunksY))
	meta := terrain.Meta{BaseRevision: 1, ChunksX: chunksX, ChunksY: chunksY, WaterLevel: 40000}
	if err := terrain.WritePackFile(path, meta, terrain.Generated(meta, terrainSeed)); err != nil {
		t.Fatal(err)
	}
	return path
}

// 与生产共用 observer 构造路径：正式 Nest 编辑 → 提交门 → scene 类型调度 → TCP → DAO Apply。
// 不运行后台循环，用 Flush 控制检查点；最终到期由真实单调时间驱动，虚拟 999/1000ms 边界另在框架测试。
func TestTerrainMixedCadenceOverTCP(t *testing.T) {
 h:=startTerrainSyncHarness(t,2,1,20000,64,false,true)
 if h.scene.manager.Mode()!=entitysync.ModeOnChange {t.Fatal("production scene did not select on_change")}
 key:=terrain.ChunkKey{}
 at:=centreOf(key)
 brush:=terrain.Brush{Op:terrain.BrushRaise,X:at.X,Y:at.Y,Radius:300,Strength:1}
 first:=h.brush(t,terrainBuilder,1,brush).Chunks[0].Version
 if err:=h.scene.manager.Drain(h.ctx);err!=nil{t.Fatal(err)}
 client:=h.join(t,30101,at)
 id:=chunkID(t,key)
 h.flushUntil(t,"initial snapshot",func()bool{return client.version(id)==first})
 // 同一正式 Nest 引擎也驱动玩家事务，验证没有被地形的周期一起延迟。
 mover:=newScenePlayer(t,30103)
 moverClient:=dialTerrainClient(t,h.addr,30103)
 _ = moverClient
 waitActiveSessions(t,h.transport,30103,1)
 joinReady(t,h.scene,h.ctx,mover,at)
 h.process.entities.Add(mover)
 counters:=newSceneWorld(t)
 h.process.entities.Add(counters)
 handler.RegisterAddExpNestHandlers()
 hasMover:=func()bool{client.mu.Lock();defer client.mu.Unlock();_,ok:=client.namespaces[mover.ID()];return ok}
 h.flushUntil(t,"visible player",hasMover)
 client.takeFrames()
 started:=time.Now()
 var final int64
 for request:=uint64(2);request<=4;request++ {final=h.brush(t,terrainBuilder,request,brush).Chunks[0].Version}
 if gained,err:=syncsender.NewAddExpSender(h.process.engine).MultiSync_AddExp(h.ctx,mover.ID(),counters.ID(),250);err!=nil||gained==0{t.Fatalf("player transaction: %d %v",gained,err)}
 hasPlayerUpdate:=func()bool{client.mu.Lock();defer client.mu.Unlock();for _,f:=range client.frames{for _,id:=range f.otherIDs{if id==mover.ID(){return true}}};return false}
 h.flushUntil(t,"on_change player while terrain waits",hasPlayerUpdate)
 if time.Since(started)>500*time.Millisecond {t.Fatal("fixture too slow to check pre-deadline window")}
 if client.version(id)!=first{t.Fatal("terrain changed before its 1s deadline")}
 h.flushUntil(t,"merged terrain delta",func()bool{return client.version(id)==final})
 if elapsed:=time.Since(started);elapsed<900*time.Millisecond{t.Fatalf("terrain sent too early: %v",elapsed)}
 updates:=0
 for _,f:=range client.takeFrames(){for _,u:=range f.terrain{if u.subject==id{updates++}}}
 if updates!=1 {t.Fatalf("got %d terrain updates, want one merged update",updates)}
 h.assertClientMatches(t,client,[]terrain.ChunkKey{key})
 // 新订阅不能消费旧订阅的待发变化。
 next:=h.brush(t,terrainBuilder,5,brush).Chunks[0].Version
 newcomer:=h.join(t,30102,at)
 h.flushUntil(t,"new observer snapshot",func()bool{return newcomer.version(id)==next})
 if client.version(id)!=final{t.Fatal("new observer advanced old observer early")}
 last:=h.brush(t,terrainBuilder,6,brush).Chunks[0].Version
 h.flushUntil(t,"both observers converge",func()bool{return client.version(id)==last&&newcomer.version(id)==last})
 h.assertClientMatches(t,client,[]terrain.ChunkKey{key})
 h.assertClientMatches(t,newcomer,[]terrain.ChunkKey{key})
}
