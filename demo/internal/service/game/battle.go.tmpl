// The lockstep half of the demo: when the matchmaker forms a duel, this
// process opens a lockstep room for it, the two clients submit one input per
// frame, and the room broadcasts numbered frames until the battle's frame
// budget runs out.
//
// What the framework owns (roost-core/sync/lockstep): sequencing inputs into
// frames with a bounded submit window and per-seat replay protection,
// packing the last few frames into every broadcast packet so a lost one
// heals without a retransmission, paging history to a reconnecting session,
// and judging keyframe hash reports into a desync verdict.
//
// What this file owns: the room's lifetime, the serial loop that drives it,
// and the wire. `lockstep.Match` is single-owner state — no locks inside —
// so every call into it happens on one goroutine here; endpoints hand work
// over through a channel instead of calling the room directly.
//
// The wire is deliberately the demo's existing player TCP connection:
// broadcasts go out as server pushes of msg 10102 carrying the lockstep
// packet itself (RS v2 Lockstep flag, no PB wrapper), and inputs come back as
// ordinary requests (10015). Lockstep does not require a datagram lane — it
// requires that frames arrive; the redundancy in the packet is what makes a
// lossy lane work, and a UDP/KCP deployment swaps lockstep.TCPSender for the
// nettransport sender without touching the room.
//
// 两条发送通道经 lockstep.TCPSender（battleLanes）：实时帧只准入，Tick 不等任何连接；
// 追帧页在嵌入 TCP 下经 TCPRuntime.PushLockstepSessionWritten 入队并等写出，追帧随链路放慢，
// 慢连接不会因追帧积压超过出站上限被关闭。等写出只发生在 Match 为追帧页起的 goroutine（launchSend）上，
// 不在房间的 Tick 协程，也不在业务 worker（端点只把命令投进 channel）。独立 Gate 部署拿不到 TCPRuntime，
// 追帧页仍只准入（Gate 写出 socket 后没有回执给 Game），见 battleLinks 与 KNOWN-LIMITS。
// BattleCapability is the name the battle manager is published under, so the
// player endpoints can reach it without importing this package (they are
// imported BY it, through the protocol binding — the same cycle the push
// transport is looked up around).
const BattleCapability app.ModName = "{{GAME_SERVICE}}.battle"

const (
	// battleCommandBuffer bounds the per-battle command queue. A client
	// spraying inputs cannot grow it: past the bound the endpoint gets a
	// coded busy error, which is the backpressure a lockstep input deserves
	// (the frame it targeted will have been cut by the time it drains).
	battleCommandBuffer = 256
	// battleStartGrace is how long a room waits for its seats to send their
	// first input before it starts cutting frames anyway. It is its own
	// timer: a client that never arrives must not stall the others, and an
	// absent seat's frames are simply empty (optimistic frame locking).
	// Waiting for a command to arrive before starting made this constant a
	// lie — with nobody typing, no frame was ever cut.
	battleStartGrace = 2 * time.Second
	// battleMaxLifetime is the absolute cap on one room, distinct from the
	// grace: it bounds the whole life (grace + every frame + the drain
	// window + slack), so a room whose ticker or clients misbehave still
	// releases its goroutine. In a healthy battle the frame budget ends the
	// room long before this.
	battleMaxLifetime = battleStartGrace + 4*time.Second + time.Duration(battle.Frames)*battle.TickRate
	// battleDrainWindow keeps the room answering after its last frame is
	// cut. A client reports the hash it sampled at a keyframe only once it
	// has applied that frame, so the last keyframe's reports always arrive
	// after the simulation is over — a room that closed on the last tick
	// would refuse exactly the reports its desync verdict needs. Results
	// and anti-cheat checks live in this window too.
	battleDrainWindow = 2 * time.Second
)

// battlePush hands one lockstep packet to one player connection, named by the
// access layer's session id (gateway.Principal.SessionID).
type battlePush func(ctx context.Context, session string, messageID uint32, packet []byte) error

// battleManager owns every battle room in this process.
type battleManager struct {
	// push only admits a packet to the connection's outbound queue (live
	// frames); pushWritten also waits until the packet is written to the
	// socket (catch-up pages). See battleLinks for where they come from.
	push        battlePush
	pushWritten battlePush

	mu     sync.Mutex
	rooms  map[string]*battleRoom
	closed bool
	wg     sync.WaitGroup
}

// battleRoom is one match's room plus the goroutine that owns it.
type battleRoom struct {
	id       string
	seats    map[int64]lockstep.PlayerID // player id → seat
	commands chan battleCommand
	// connections binds the seats to the connections they speak from; the
	// room's two lanes resolve through it.
	connections *battleConnections
	// stop asks the room's goroutine to end (shutdown); done is closed by
	// that goroutine when it has. The commands channel is never closed:
	// endpoints may still be writing to it while shutdown runs.
	stop chan struct{}
	done chan struct{}
	// cut counts the frames this room has cut. It is read by tests and by
	// anything that wants a room's progress without touching the room.
	cut atomic.Int64
}

// battleCommand is one piece of work for the room's goroutine. reply is
// buffered by the sender, so the loop never blocks on a caller that left.
type battleCommand struct {
	seat lockstep.PlayerID
	// connection is the access-layer session the message arrived on: the
	// seat receives frames on the connection it last spoke from.
	connection  string
	frame       lockstep.FrameID
	payload     []byte
	hashFrame   lockstep.FrameID
	hash        uint64
	catchupFrom lockstep.FrameID
	catchup     bool
	reply       chan error
}

// battleConnections maps a room's lockstep sessions to player connections.
//
// A seat is attached to the connection its first message (input, hash report
// or catch-up request) arrived on, under a lockstep session id of its own; a
// message from another connection — a reconnect, the demo's session ids are
// unique per connection — attaches that one under a fresh id, so a session id
// never spans two connections (lockstep.TCPSender's contract) and the old
// connection's catch-up is dropped. A seat that has not spoken receives
// nothing: frames cut before it joins reach it by catch-up, which the client
// asks for when its first packet shows a gap.
//
// join runs on the room's goroutine only; resolve is also called by the
// goroutines the Match sends catch-up pages from, hence the lock.
type battleConnections struct {
	mu    sync.Mutex
	byID  map[nettransport.SessionID]string
	seats map[lockstep.PlayerID]nettransport.SessionID
	last  nettransport.SessionID
}

func newBattleConnections() *battleConnections {
	return &battleConnections{byID: make(map[nettransport.SessionID]string), seats: make(map[lockstep.PlayerID]nettransport.SessionID)}
}

// resolve is lockstep.TCPSender's resolver: lockstep session → connection.
func (connections *battleConnections) resolve(id nettransport.SessionID) (string, bool) {
	connections.mu.Lock()
	defer connections.mu.Unlock()
	connection, ok := connections.byID[id]
	return connection, ok
}

// join attaches seat to connection unless it already is. Owned by the room's
// goroutine (it calls room.Attach).
func (connections *battleConnections) join(room *lockstep.Match, seat lockstep.PlayerID, connection string) error {
	if connection == "" {
		return errors.New("battle: the message did not say which connection it came on")
	}
	connections.mu.Lock()
	previous, attached := connections.seats[seat]
	if attached && connections.byID[previous] == connection {
		connections.mu.Unlock()
		return nil
	}
	connections.last++
	id := connections.last
	connections.byID[id] = connection
	connections.mu.Unlock()
	if err := room.Attach(seat, id); err != nil {
		connections.mu.Lock()
		delete(connections.byID, id)
		connections.mu.Unlock()
		return err
	}
	connections.mu.Lock()
	if attached {
		delete(connections.byID, previous)
	}
	connections.seats[seat] = id
	connections.mu.Unlock()
	return nil
}

// battleLiveLane is the room's live lane: lockstep.TCPSender's datagram lane
// (admission only) with the demo's tolerance for one receiver missing a
// frame. A player whose connection is gone or full is not something the room
// should abandon the frame for: the other seats still get it, and this one
// heals from the next packet's redundant frames or catches up.
type battleLiveLane struct {
	sender   *lockstep.TCPSender
	battleID string
}

func (lane battleLiveLane) SendDatagram(ctx context.Context, session nettransport.SessionID, packet []byte) error {
	if err := lane.sender.SendDatagram(ctx, session, packet); err != nil {
		slog.Debug("battle: frame not delivered", "battle_id", lane.battleID, "session", uint64(session), "err", err)
	}
	return nil
}

func (lane battleLiveLane) MaxDatagramPayload() int { return lane.sender.MaxDatagramPayload() }

// battleLanes builds a room's two lanes over the player connections. The
// catch-up lane is the TCPSender itself: its errors (a page that timed out
// waiting for a slow link, a connection that is gone) reach the Match, which
// counts them toward CatchupMaxFailures.
func (manager *battleManager) battleLanes(battleID string, connections *battleConnections) (nettransport.DatagramSender, nettransport.ReliableSender, error) {
	sender, err := lockstep.NewTCPSender(msgid.MsgBattleFrame, 0, connections.resolve, manager.push, manager.pushWritten)
	if err != nil {
		return nil, nil, fmt.Errorf("battle: lanes for %s: %w", battleID, err)
	}
	return battleLiveLane{sender: sender, battleID: battleID}, sender, nil
}

// battleLinks picks the two pushes from the player TCP Runtime.
//
// Embedded TCP (the generated default, accessplayertcp.Mod) has a
// TCPRuntime: live frames go through PushLockstepSession (admission only) and
// catch-up pages through PushLockstepSessionWritten (enqueue and wait until
// written), so catch-up follows the link.
//
// A standalone Gate deployment (accessplayertcp.IngressMod) has no
// TCPRuntime: the Game only knows its own queue took the packet, and the Gate
// does not report back when it wrote one to the socket. Both lanes then only
// admit, and a catch-up page is not slowed by the link — that needs a Gate
// receipt, a protocol change the maintainer deferred (KNOWN-LIMITS “Lockstep
// 追帧链路背压（独立 Gate）”).
func battleLinks(runtime *accessplayertcp.Runtime) (push, pushWritten battlePush, err error) {
	if runtime == nil || runtime.PlayerRuntime == nil {
		return nil, nil, errors.New("battle: player tcp runtime is unavailable")
	}
	push = runtime.PushLockstepSession
	if runtime.TCPRuntime == nil {
		return push, push, nil
	}
	return push, runtime.TCPRuntime.PushLockstepSessionWritten, nil
}

func newBattleManager(registry *app.Registry) (*battleManager, error) {
	runtime, _ := app.Lookup[*accessplayertcp.Runtime](registry, accessplayertcp.Name)
	push, pushWritten, err := battleLinks(runtime)
	if err != nil {
		return nil, err
	}
	return &battleManager{push: push, pushWritten: pushWritten, rooms: make(map[string]*battleRoom)}, nil
}

// battleFrameBudget is what a room cuts before it drains; it is here so the
// lifetime cap and the tests read the same number the contract declares.
var battleFrameBudget = battle.Frames

// Open starts a room for a formed match. It is called from the matchmaker
// after Commit, once per match; a second call for the same id is ignored, so
// a retried Commit or a second process reading the same match cannot open
// two rooms.
func (manager *battleManager) Open(battleID string, members []int64) error {
	if manager == nil {
		return errors.New("battle: manager is nil")
	}
	if battleID == "" || len(members) == 0 {
		return fmt.Errorf("battle: match %q has no members", battleID)
	}
	manager.mu.Lock()
	if manager.closed {
		manager.mu.Unlock()
		return errors.New("battle: manager is shutting down")
	}
	if _, exists := manager.rooms[battleID]; exists {
		manager.mu.Unlock()
		return nil
	}
	seats := make(map[int64]lockstep.PlayerID, len(members))
	for index, member := range members {
		seats[member] = battle.Seat(index)
	}
	connections := newBattleConnections()
	live, catchup, err := manager.battleLanes(battleID, connections)
	if err != nil {
		manager.mu.Unlock()
		return err
	}
	room, err := lockstep.NewMatch(lockstep.MatchConfig{
		Sequencer: lockstep.SequencerConfig{
			Players:      battle.Seats(len(members)),
			SubmitWindow: battle.SubmitWindow,
			MaxInputBytes: battle.MaxInputBytes,
		},
		RedundancyDepth:    battle.RedundancyDepth,
		MaxDatagramBytes:   battle.MaxDatagramBytes,
		CatchupBatchFrames: battle.CatchupBatchFrames,
		Datagrams:          live,
		Reliable:           catchup,
		OnDesync: func(verdict lockstep.DesyncVerdict) {
			// A verdict is the framework telling the game that some seat's
			// simulation no longer matches the quorum's. A real game kicks
			// or resyncs; the demo records it. 机器人应另外断言裁决结果；
			// 一次正常样本没有 desync 不等于覆盖全部分歧情况。
			slog.Error("battle: desync verdict", "battle_id", battleID, "frame", verdict.Frame, "outliers", verdict.Outliers)
		},
	})
	if err != nil {
		manager.mu.Unlock()
		return fmt.Errorf("battle: open %s: %w", battleID, err)
	}
	// No seat is attached yet: each joins on the connection its first
	// message arrives on (battleConnections).
	managed := &battleRoom{id: battleID, seats: seats, connections: connections, commands: make(chan battleCommand, battleCommandBuffer), stop: make(chan struct{}), done: make(chan struct{})}
	manager.rooms[battleID] = managed
	manager.wg.Add(1)
	manager.mu.Unlock()
	go manager.run(managed, room)
	slog.Info("battle: room open", "battle_id", battleID, "seats", len(seats), "frames", battle.Frames)
	return nil
}

// run is the room's single owner. Everything that touches the lockstep room
// happens here: commands from endpoints, and one Tick per interval.
func (manager *battleManager) run(managed *battleRoom, room *lockstep.Match) {
	defer manager.wg.Done()
	defer close(managed.done)
	defer room.Close()
	defer manager.forget(managed.id)

	ticker := time.NewTicker(battle.TickRate)
	defer ticker.Stop()
	ctx := context.Background()
	// Two independent timers, two different jobs: grace decides WHEN frames
	// start, lifetime decides when the room gives up whatever happened.
	grace := time.NewTimer(battleStartGrace)
	defer grace.Stop()
	lifetime := time.NewTimer(battleMaxLifetime)
	defer lifetime.Stop()
	started := false
	cut := 0
	for cut < battle.Frames {
		select {
		case <-managed.stop:
			slog.Info("battle: room stopped", "battle_id", managed.id, "frames_cut", cut)
			return
		case command := <-managed.commands:
			// The first input opens the battle early: the clients are here,
			// so there is no reason to wait out the grace.
			started = true
			command.reply <- managed.apply(ctx, room, command)
		case <-grace.C:
			// Nobody spoke within the grace. Start anyway — the seats that
			// are missing contribute empty frames, and the ones that arrive
			// late catch up from history.
			if !started {
				started = true
				slog.Info("battle: starting without a first input", "battle_id", managed.id, "grace", battleStartGrace)
			}
		case <-ticker.C:
			if !started {
				continue
			}
			if _, err := room.Tick(ctx); err != nil {
				// Tick joins the per-receiver send errors; the adapter
				// already swallows an offline player, so anything here is
				// worth seeing.
				slog.Warn("battle: tick", "battle_id", managed.id, "frame", cut, "err", err)
			}
			cut++
			managed.cut.Store(int64(cut))
		case <-lifetime.C:
			slog.Info("battle: room reached its maximum lifetime", "battle_id", managed.id, "frames_cut", cut)
			return
		}
	}
	// The simulation is over; the room is not. Keep answering (hash reports
	// for the last keyframe, a late catch-up) until the drain window ends.
	drain := time.NewTimer(battleDrainWindow)
	defer drain.Stop()
	for {
		select {
		case <-managed.stop:
			slog.Info("battle: room stopped while draining", "battle_id", managed.id, "frames_cut", cut)
			return
		case command := <-managed.commands:
			command.reply <- managed.apply(ctx, room, command)
		case <-drain.C:
			slog.Info("battle: room finished", "battle_id", managed.id, "frames_cut", cut)
			return
		}
	}
}

// apply runs one command against the room. It is only ever called from run.
// The seat joins (or follows) the connection the command came on first, so a
// catch-up request or the first input already has somewhere to send to.
func (managed *battleRoom) apply(ctx context.Context, room *lockstep.Match, command battleCommand) error {
	if err := managed.connections.join(room, command.seat, command.connection); err != nil {
		return err
	}
	if command.catchup {
		return room.StartCatchup(command.seat, command.catchupFrom)
	}
	var joined error
	if len(command.payload) > 0 {
		if _, err := room.SubmitInput(command.seat, command.frame, command.payload); err != nil {
			joined = errors.Join(joined, err)
		}
	}
	if command.hashFrame > 0 {
		if err := room.ReportHash(command.seat, command.hashFrame, command.hash); err != nil {
			joined = errors.Join(joined, err)
		}
	}
	_ = ctx
	return joined
}

// SubmitBattleInput is the endpoint's entry point: one client's per-frame
// message (input, optional keyframe hash report, optional catch-up
// request), and connection, the access-layer session it arrived on
// (gateway.Principal.SessionID) — the room sends this seat's frames there.
// Plain parameters, because the caller is the player controller in another
// package — it holds this manager through an interface it declares itself,
// not through this package's types.
func (manager *battleManager) SubmitBattleInput(ctx context.Context, battleID string, playerID int64, connection string, frame uint32, payload []byte, hashFrame uint32, hash uint64, catchupFrom uint32) error {
	return manager.submit(ctx, battleID, playerID, battleCommand{
		connection:  connection,
		frame:       lockstep.FrameID(frame),
		payload:     payload,
		hashFrame:   lockstep.FrameID(hashFrame),
		hash:        hash,
		catchupFrom: lockstep.FrameID(catchupFrom),
		catchup:     catchupFrom > 0,
	})
}

// submit hands one command to the battle's goroutine and waits for its
// verdict.
func (manager *battleManager) submit(ctx context.Context, battleID string, playerID int64, command battleCommand) error {
	if manager == nil {
		return errors.New("battle: manager is nil")
	}
	manager.mu.Lock()
	managed, exists := manager.rooms[battleID]
	manager.mu.Unlock()
	if !exists {
		return errcode.Wrap(apperrors.ErrBattleNotFound, nil, "battle_id", battleID)
	}
	seat, seated := managed.seats[playerID]
	if !seated {
		return errcode.Wrap(apperrors.ErrBattleNotSeated, nil, "battle_id", battleID, "player_id", playerID)
	}
	command.seat = seat
	command.reply = make(chan error, 1)
	// Non-blocking: a full queue means this input is already late, so the
	// client is told now instead of waiting behind frames that have been cut.
	select {
	case managed.commands <- command:
	default:
		return errcode.Wrap(apperrors.ErrBattleBusy, nil, "battle_id", battleID)
	}
	select {
	case err := <-command.reply:
		return err
	case <-managed.done:
		// The room ended between the send and the reply: whatever this
		// input was for is over.
		return errcode.Wrap(apperrors.ErrBattleNotFound, nil, "battle_id", battleID)
	case <-ctx.Done():
		return ctx.Err()
	}
}

func (manager *battleManager) forget(battleID string) {
	manager.mu.Lock()
	delete(manager.rooms, battleID)
	manager.mu.Unlock()
}

// Close stops every room and waits for their goroutines. Rooms are
// in-process state: a restart ends the battles it was hosting, which is why
// a production deployment gives a battle its own process and a way to
// resume — the framework pages history to a reconnecting session, but only
// while the room is alive.
func (manager *battleManager) Close() {
	if manager == nil {
		return
	}
	manager.mu.Lock()
	if manager.closed {
		manager.mu.Unlock()
		return
	}
	manager.closed = true
	rooms := make([]*battleRoom, 0, len(manager.rooms))
	for _, managed := range manager.rooms {
		rooms = append(rooms, managed)
	}
	manager.mu.Unlock()
	for _, managed := range rooms {
		close(managed.stop)
	}
	manager.wg.Wait()
}
