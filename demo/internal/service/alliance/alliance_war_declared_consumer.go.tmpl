package alliance

import (
	"context"
	"encoding/json"
	"fmt"

	"{{MODULE}}/game/effects"
	rpcalliance "{{MODULE}}/internal/rpc/alliance"
	"github.com/tjbdwanghaibo/roost-core/framework/app"
	"github.com/tjbdwanghaibo/roost-core/framework/nestwal"
	fnats "github.com/tjbdwanghaibo/roost-core/infra/network/nats"
	kitdataengine "github.com/tjbdwanghaibo/roost-core/wiring/dataengine"
)

// AllianceWarDeclaredEffectDurable names the JetStream consumer for the
// enemy side of cross-instance war declarations.
const AllianceWarDeclaredEffectDurable = "alliance-war-declared"

// startAllianceWarDeclaredEffectConsumer records the enemy side
// (rpcalliance.Service.HandleWarDeclared).
func startAllianceWarDeclaredEffectConsumer(ctx context.Context, registry *app.Registry, service *rpcalliance.Service) (fnats.IJetStreamSubscription, error) {
	consumer := kitdataengine.EffectConsumer{Durable: AllianceWarDeclaredEffectDurable, Topic: effects.TopicAllianceWarDeclared}
	return kitdataengine.SubscribeEffects(ctx, registry, consumer, func(ctx context.Context, envelope nestwal.EffectEnvelope) error {
		var event effects.AllianceWarDeclared
		if err := json.Unmarshal(envelope.Payload, &event); err != nil {
			return kitdataengine.PoisonEffect(fmt.Errorf("alliance.war_declared consumer: decode effect %s: %w", envelope.EffectID, err))
		}
		return service.HandleWarDeclared(ctx, event)
	})
}
