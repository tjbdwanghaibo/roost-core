package alliance

import (
	"context"
	"encoding/json"
	"fmt"

	"{{MODULE}}/game/effects"
	rpcalliance "{{MODULE}}/internal/rpc/alliance"
	"github.com/tjbdwanghaibo/roost-core/framework/app"
	"github.com/tjbdwanghaibo/roost-core/framework/nestwal"
	fnats "github.com/tjbdwanghaibo/roost-core/infra/network/nats"
	kitdataengine "github.com/tjbdwanghaibo/roost-core/wiring/dataengine"
)

// AllianceMemberChangedEffectDurable names the consumer of the best-effort
// membership notices: the NATS queue group every alliance instance joins, so
// each notice is handled by one of them. (Until 2026-11-05 this was the
// JetStream durable "alliance-member-changed" of a reliable effect that also
// finished guards; that durable is no longer used — the project is not
// deployed, so it is not migrated.)
const AllianceMemberChangedEffectDurable = "alliance-member-notice"

// startAllianceMemberChangedEffectConsumer sends membership notices to game
// servers (rpcalliance.Service.HandleMemberChanged). Best effort, as the
// effect: no inbox, no redelivery.
func startAllianceMemberChangedEffectConsumer(ctx context.Context, registry *app.Registry, service *rpcalliance.Service) (fnats.IJetStreamSubscription, error) {
	consumer := kitdataengine.EffectConsumer{Durable: AllianceMemberChangedEffectDurable, Topic: effects.TopicAllianceMemberChanged, Delivery: effects.DeliveryAllianceMemberChanged}
	return kitdataengine.SubscribeEffects(ctx, registry, consumer, func(ctx context.Context, envelope nestwal.EffectEnvelope) error {
		var event effects.AllianceMemberChanged
		if err := json.Unmarshal(envelope.Payload, &event); err != nil {
			return kitdataengine.PoisonEffect(fmt.Errorf("alliance.member_changed consumer: decode effect %s: %w", envelope.EffectID, err))
		}
		return service.HandleMemberChanged(ctx, event)
	})
}
