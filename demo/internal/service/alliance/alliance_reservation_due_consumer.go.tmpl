package alliance

import (
	"context"
	"encoding/json"
	"fmt"

	"{{MODULE}}/game/effects"
	rpcalliance "{{MODULE}}/internal/rpc/alliance"
	"github.com/tjbdwanghaibo/roost-core/framework/app"
	"github.com/tjbdwanghaibo/roost-core/framework/nestwal"
	fnats "github.com/tjbdwanghaibo/roost-core/infra/network/nats"
	kitdataengine "github.com/tjbdwanghaibo/roost-core/wiring/dataengine"
)

// AllianceReservationDueEffectDurable names the consumer of the best-effort
// reservation-deadline notices: the NATS queue group every alliance instance
// joins. (Until 2026-11-05 this was the JetStream durable
// "alliance-reservation-due" of a reliable effect; that durable is no longer
// used — the project is not deployed, so it is not migrated.)
const AllianceReservationDueEffectDurable = "alliance-reservation-heal"

// startAllianceReservationDueEffectConsumer settles expired reservations with
// their alliance (rpcalliance.Service.HandleReservationDue). Best effort: a
// notice that is lost, or whose alliance cannot be reached, leaves the
// reservation pending until the next request that finds the guard held heals
// it the same way — the guard is never released on the clock alone.
func startAllianceReservationDueEffectConsumer(ctx context.Context, registry *app.Registry, service *rpcalliance.Service) (fnats.IJetStreamSubscription, error) {
	consumer := kitdataengine.EffectConsumer{Durable: AllianceReservationDueEffectDurable, Topic: effects.TopicAllianceReservationDue, Delivery: effects.DeliveryAllianceReservationDue}
	return kitdataengine.SubscribeEffects(ctx, registry, consumer, func(ctx context.Context, envelope nestwal.EffectEnvelope) error {
		var event effects.AllianceReservationDue
		if err := json.Unmarshal(envelope.Payload, &event); err != nil {
			return kitdataengine.PoisonEffect(fmt.Errorf("alliance.reservation_due consumer: decode effect %s: %w", envelope.EffectID, err))
		}
		return service.HandleReservationDue(ctx, event)
	})
}
