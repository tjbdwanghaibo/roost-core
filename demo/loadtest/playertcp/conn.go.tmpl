// Package playertcp selects the shared Robot transport used by embedded TCP and Gate.
package playertcp

import (
 "context"
 "github.com/tjbdwanghaibo/roost-core/robot/transport"
)

const TransportType = transport.PlayerTCPType
const AuthMessageID = transport.AuthMessageID

func AuthPacket(token string) *transport.Packet { return transport.AuthPacket(token) }

// 所有线协议与序列关联归公共 Robot 维护，生成工程只保留业务鉴权入口。
func Register() error {
 return transport.RegisterDialer(TransportType, func(ctx context.Context, cfg transport.Config)(transport.Conn,error) {
  return transport.DialPlayerTCP(ctx,cfg)
 })
}
func MustRegister() { if err := Register(); err != nil { panic(err) } }
