package handler

import (
	"{{MODULE}}/game/view"
	sceneentity "{{MODULE}}/game/entities/scene"
	"github.com/tjbdwanghaibo/roost-core/infra/base/spatial"
)

// handlerEnterScene puts a player on the map, at the position it was last
// saved at when that point is still usable and at the nearest free one when
// it is not.
//
// Resolving the point is the scene's job (PathFind.Place searches outward in
// rings), writing it is the player's: a remembered position can become
// unusable while the player is away — the map is reloaded from configuration
// on every start — and a login that failed because the ground changed would
// be a login nobody can fix.
//
// The remembered position is the SAVED one (PlayerDao.SavedPosX/Y): the live
// position is `nopersist` and is zero in a freshly loaded
// player. A player that is still on this map (a reconnect while it stayed
// loaded) keeps where it is.
//
// The player is entered with the scene's Space (actor.InterestMoves): from
// here on every step it takes is queued for the AOI in the step's own
// transaction. Joining the replication — the subject, the session — is the
// endpoint's next call (Scene.Join), after this commits.
//
//roost:nest rollback=undo durability=async
func handlerEnterScene(target view.IMapEntity, area sceneentity.ISceneEntity, spawnX int64, spawnY int64) (spatial.Point, error) {
	if err := area.AdmitPlayer(target.ID()); err != nil {
		return spatial.Point{}, err
	}
	component := target.Map()
	if component.InScene() && component.SceneID() == area.ID() {
		return component.Pos(), nil
	}
	preferred := component.SavedPos()
	if preferred.X == 0 && preferred.Y == 0 {
		preferred = spatial.Point{X: spawnX, Y: spawnY}
	}
	at, err := area.PathFind().Place(preferred)
	if err != nil {
		return spatial.Point{}, err
	}
	return component.EnterScene(area.ID(), area.Space(), at)
}

// Ordinary login only. Never consult a transfer flag outside the Player transaction or use
// a default-field spawn for a different destination map. Slot, live position, saved position
// and transfer-specific placement marker either commit together or all roll back.
//roost:nest rollback=undo durability=async
func handlerPlaceOrdinaryPlayer(target view.PlayerEntity, area sceneentity.ISceneEntity, sid int32) (view.OrdinaryPlacement, error) {
	spawn := area.SpawnPoint()
	id, placed := target.Rehome().PendingArrival(sid)
	if id == "" || placed {
		at, err := handlerEnterScene(target, area, spawn.X, spawn.Y)
		return view.OrdinaryPlacement{At: at, Arriving: id != ""}, err
	}
	if err := area.AdmitPlayer(target.ID()); err != nil {
		return view.OrdinaryPlacement{}, err
	}
	at, err := area.PathFind().Place(spawn)
	if err != nil {
		return view.OrdinaryPlacement{}, err
	}
	m := target.Map()
	if m.InScene() {
		if err := m.LeaveScene(); err != nil {
			return view.OrdinaryPlacement{}, err
		}
	}
	at, err = m.EnterScene(area.ID(), area.Space(), at)
	if err != nil {
		return view.OrdinaryPlacement{}, err
	}
	if err := m.Body().Map.Save(); err != nil {
		return view.OrdinaryPlacement{}, err
	}
	if err := target.Rehome().MarkPlaced(sid, id); err != nil {
		return view.OrdinaryPlacement{}, err
	}
	return view.OrdinaryPlacement{At: at, Arriving: true}, nil
}

// On a placement error the controller cannot infer intent from a zero return value. Check
// only on that error path: a failed transfer placement must not run the entered/arrival hooks.
//roost:nest rollback=undo durability=memory
func handlerPendingOrdinaryArrival(target view.IRehomeEntity, sid int32) (bool, error) {
	id, _ := target.Rehome().PendingArrival(sid)
	return id != "", nil
}
