package handler

import (
	player "{{MODULE}}/game/entities/player"
	team "{{MODULE}}/game/entities/team"
	"{{MODULE}}/game/partition"
	apperrors "{{MODULE}}/internal/errors"
	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/infra/base/errcode"
)

// handlerTeamInvite 让队长邀请另一名玩家（分区场景的组队，维护者 2026-11-04 第 4 项 = A）。邀请人还没有队伍时，这一笔
// 事务就把端点刚建出的 Team 建成（他是队长与第一名成员），并在同一笔事务里写他自己的缓存——之后他的 Base 心跳就按成员表
// 发快照。被邀请的人不在这里写（他在别的进程上）：他拿着队伍 ID 来 TeamAccept。
//
// 锁序：Team 是 Remote 托管（rank 1），分布式锁在 Player 的本地锁之前取。规模上限、邀请过期是 scene.partition.team
// 的配置，由端点作参数传进来（声明一次、加载时校验一次）。
//
//roost:nest rollback=undo durability=strict
func handlerTeamInvite(target team.IRosterEntity, inviter player.IProfileEntity, inviteeID int64, sid int32, maxMembers int32, inviteTTLSeconds int64, nowUnix int64) (team.Info, error) {
	node := partition.Node()
	if node == nil {
		return team.Info{}, apperrors.ErrSceneNotPartitioned
	}
	roster := target.RosterComp()
	self := inviter.ProfileComp().Owner()
	inviterID := entity.GetUniqueIDFromEntityID(inviter.ID())
	switch current := self.TeamID(); {
	case current == 0:
		if err := roster.Found(inviterID, sid); err != nil {
			return team.Info{}, err
		}
		node.SetGroup(self, teamGroup(roster.Snapshot()))
	case current != target.ID():
		return team.Info{}, errcode.Wrap(apperrors.ErrTeamExists, nil, "team_id", current)
	}
	if err := roster.Invite(inviterID, inviteeID, int(maxMembers), nowUnix, nowUnix+inviteTTLSeconds); err != nil {
		return team.Info{}, err
	}
	return roster.Snapshot(), nil
}
