package handler

import (
	player "{{MODULE}}/game/entities/player"
	team "{{MODULE}}/game/entities/team"
	"{{MODULE}}/game/partition"
	apperrors "{{MODULE}}/internal/errors"
	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/infra/base/errcode"
)

// handlerTeamAccept 让被邀请的玩家入队：成员表（Team，权威）与他自己的缓存（Player.TeamID 与成员表）在同一笔事务里写；
// 提交之后把新成员表通知给全部成员的 Base（Node.NotifyGroup，至多一次；丢了由各 Base 的周期重读兜底）。sid 是他的 Base。
// 已经在这支队里是无变化的成功（客户端与传输会重试），照样再通知一次。
//
//roost:nest rollback=undo durability=strict
func handlerTeamAccept(target team.IRosterEntity, member player.IProfileEntity, sid int32, maxMembers int32, nowUnix int64) (team.Info, error) {
	node := partition.Node()
	if node == nil {
		return team.Info{}, apperrors.ErrSceneNotPartitioned
	}
	roster := target.RosterComp()
	self := member.ProfileComp().Owner()
	if current := self.TeamID(); current != 0 && current != target.ID() {
		return team.Info{}, errcode.Wrap(apperrors.ErrTeamExists, nil, "team_id", current)
	}
	if err := roster.Accept(entity.GetUniqueIDFromEntityID(member.ID()), sid, int(maxMembers), nowUnix); err != nil {
		return team.Info{}, err
	}
	info := roster.Snapshot()
	g := teamGroup(info)
	node.SetGroup(self, g)
	node.NotifyGroup(g, nil)
	return info, nil
}
