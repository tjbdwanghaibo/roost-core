package handler

import (
	"time"

	"{{MODULE}}/game/alliancerule"
	alliance "{{MODULE}}/game/entities/alliance"
)

// handlerAllianceReject drops an application; leader only.
//
//roost:nest rollback=undo durability=strict
func handlerAllianceReject(target alliance.IRosterEntity, requestID string, actorID int64, applicantID int64, retentionSeconds int64, nowUnix int64) (alliancerule.Answer, error) {
	roster := target.RosterComp()
	outcome, err := roster.Execute(requestID, nowUnix, time.Duration(retentionSeconds)*time.Second, func() (int64, error) {
		return applicantID, roster.Reject(actorID, applicantID)
	})
	return answer(roster, outcome, err)
}
