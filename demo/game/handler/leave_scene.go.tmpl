package handler

import (
	"{{MODULE}}/game/view"
	"{{MODULE}}/game/actor"
	sceneentity "{{MODULE}}/game/entities/scene"
	"fmt"
)

// handlerLeaveScene takes a player off the map in its own transaction:
// MapBasic.Leave saves the position first (SaveOnLeave: only when the scene,
// the position or the facing changed since the last save), clears the scene
// id and, after commit, leaves the AOI space.
//
// It is what a player leaving this process goes through — an idle unload, a
// hand-off to another server (playerEvictor) — so the last steps are in the
// saved fields before the copy is dropped, instead of whatever the 10-second
// periodic save (actor.SavePeriod) last wrote. A player that is not on a map
// has nothing to save: no error.
//
//roost:nest rollback=undo durability=async
func handlerLeaveScene(target view.IMapEntity) error {
	component := target.Map()
	if !component.InScene() {
		return nil
	}
	return component.LeaveScene()
}

// Release the ordinary player's place and save its last position in the same transaction.
// Partition eviction keeps its original single-Player LeaveScene handler.
//roost:nest rollback=undo durability=async
func handlerLeaveOrdinaryScene(target view.IMapEntity, area sceneentity.ISceneEntity) error {
	if m := target.Map(); m.InScene() && m.SceneID() != area.ID() {
		return fmt.Errorf("leave: player is on another map")
	}
	if err := handlerLeaveScene(target); err != nil {
		return err
	}
	area.DepartPlayer(target.ID())
	return nil
}

// No cold load just to clean a slot. Recheck under the scene guard, so a reloaded/rejoined player wins.
//roost:nest rollback=undo durability=async
func handlerForgetUnloadedScenePlayer(area sceneentity.ISceneEntity, subjectID int64) error {
	if actor.KnownUnloaded(subjectID) {
		area.DepartPlayer(subjectID)
	}
	return nil
}
