// 登录计数在唯一的 World 上：每次登录都要经过它。承诺是“登录计数写进 WAL 就回复，不在 World 上等 fsync”——
// 否则 World 的吞吐就是“每次 fsync 记一人”，千人登录潮里后来的玩家在 World 队列里等光请求预算（M-15）。
// 这里的 WAL 写入照收、fsync 永远不回（heldWAL）：几次登录计数都必须在盘回应之前答完，每次都写进了 WAL，
// 计数正确。strict 在第一笔就停住（锁内等盘）；pipelined 同样停住（锁外等票据，同一实体的后继等它的回复）。
func TestALoginCountDoesNotWaitForTheDiskOnTheWorld(t *testing.T) {
	world.RegisterEntity()
	RegisterRecordEnterNestHandlers()
	worldID, err := entity.BuildEntityID(1, world.EntityKindWorld)
	if err != nil {
		t.Fatal(err)
	}
	built, err := entity.BuildEntity(&entity.EntityCreateParam{IsCreate: true, Kind: world.EntityKindWorld, Id: worldID})
	if err != nil {
		t.Fatalf("build world: %v", err)
	}
	counters := built.(*world.World)
	wal := newHeldWAL()
	engine := nest.NewEngine(
		nest.NestOptionWithGetter(multiEntityGetter{worldID: built}),
		nest.NestOptionWithTransactionCommitter(wal),
		nest.NestOptionWithWorkerPools(nest.WorkerPoolConfig{Workers: 4, QueueCap: 16}, nest.WorkerPoolConfig{}, nest.WorkerPoolConfig{}),
	)
	if err := engine.Start(); err != nil {
		t.Fatalf("start nest: %v", err)
	}
	t.Cleanup(func() { _ = engine.Shutdown(context.Background()) })
	t.Cleanup(wal.releaseAll)

	const logins = 8
	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
	defer cancel()
	sender := syncsender.NewRecordEnterSender(engine)
	results := make(chan error, logins)
	for range logins {
		go func() { results <- sender.Sync_RecordEnter(ctx, counters.ID()) }()
	}
	for range logins {
		if err := <-results; err != nil {
			t.Fatalf("a login count did not answer while the disk had not acknowledged an fsync: %v "+
				"(the World waits for the disk under its own ordering, so it counts one login per fsync)", err)
		}
	}
	if got := wal.written(); got != logins {
		t.Fatalf("%d login counts reached the WAL, want %d: the count must still be written before it answers", got, logins)
	}
	if got := counters.Dao().GetPlayersEntered(); got != logins {
		t.Fatalf("the World counted %d logins, want %d", got, logins)
	}
}

// heldWAL 是一个“写入照收、fsync 永远不回”的 WAL（直到 releaseAll）：Commit 记下写入的记录，durability 达到
// strict 的记录要等 fsync，就停在这里（与 nestwal 一样，async 写入即返回）；pipelined 的 Enqueue 立即给票据，
// 票据在 releaseAll 之前不完成。
type heldWAL struct {
	released chan struct{}
	once     sync.Once
	mu       sync.Mutex
	records  int
	lsn      uint64
}

func newHeldWAL() *heldWAL { return &heldWAL{released: make(chan struct{})} }

func (w *heldWAL) releaseAll() { w.once.Do(func() { close(w.released) }) }

func (w *heldWAL) written() int {
	w.mu.Lock()
	defer w.mu.Unlock()
	return w.records
}

func (w *heldWAL) Commit(ctx context.Context, record dataengine.CommitRecord) error {
	w.mu.Lock()
	w.records++
	w.mu.Unlock()
	if record.Durability < dataengine.DurabilityStrict {
		return nil
	}
	select {
	case <-w.released:
		return nil
	case <-ctx.Done():
		return ctx.Err()
	}
}

func (w *heldWAL) Enqueue(_ context.Context, _ dataengine.CommitRecord) (nest.CommitTicket, error) {
	w.mu.Lock()
	defer w.mu.Unlock()
	w.records++
	w.lsn++
	return heldTicket{lsn: w.lsn, wal: w}, nil
}

func (w *heldWAL) DurableLSN() uint64 {
	select {
	case <-w.released:
		w.mu.Lock()
		defer w.mu.Unlock()
		return w.lsn
	default:
		return 0
	}
}

type heldTicket struct {
	lsn uint64
	wal *heldWAL
}

func (t heldTicket) LSN() uint64           { return t.lsn }
func (t heldTicket) Done() <-chan struct{} { return t.wal.released }
func (t heldTicket) Err() error            { return nil }
