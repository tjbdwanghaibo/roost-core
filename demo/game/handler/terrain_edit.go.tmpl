package handler

import (
	"{{MODULE}}/game/components/terrainsurface"
	"{{MODULE}}/game/components/terrainledger"
	terrain_cell_editor "{{MODULE}}/game/entities/terrain_cell_editor"
	terrain_chunk "{{MODULE}}/game/entities/terrain_chunk"
	terrain_editor "{{MODULE}}/game/entities/terrain_editor"
	"{{MODULE}}/game/terrainmap"
	"github.com/tjbdwanghaibo/roost-core/gameplay/terrain"
)

// 地形块的改块事务与账本的读取 / 发号（可编辑地形，game/terrainmap 发起）。改块事务都是 rollback=undo durability=strict：
// 回复与视图更新都在 WAL 持久之后，回滚的事务由生成 setter 的逆操作还原 DAO、不改变视图。第一次改的块、第一次编辑的
// 玩家账本由调用方先经 lifecycle 的 GetOrCreate 建出空实体（handler 只能锁已存在的实体）。handler 是包级函数，前两个
// 经 terrainmap.Active() 拿到本进程的 Map。

// handlerTerrainEdit 在一块地形上应用一组采样点改动（P1 的内部写入口，Map.Edit 发起）：用原始块填满第一次改的块、
// 写入改动、Version + 1，返回新 Version。
//
//roost:nest rollback=undo durability=strict
func handlerTerrainEdit(target terrain_chunk.ISurfaceEntity, edits []terrainsurface.PointEdit) (int64, error) {
	m := terrainmap.Active()
	if m == nil {
		return 0, terrainmap.ErrDisabled
	}
	return m.ApplyEdit(target, edits)
}

// handlerTerrainBrush 是玩家的一次笔刷编辑（P2，Map.Brush 发起）：targets 是笔刷覆盖到的全部块（至多 4 块），editor 是
// 这个玩家的编辑账本（T01/T02），Nest 按锁序（块 World 在前、账本 PlayerScoped 在后）一起锁住；一笔事务里按（玩家, seq）
// 判重、算笔刷、逐块写、序号记进账本（terrainmap.Map.ApplyBrush）。
//
//roost:nest rollback=undo durability=strict
func handlerTerrainBrush(targets []terrain_chunk.ISurfaceEntity, editor terrain_editor.ILedgerEntity, seq int64, brush terrain.Brush) (terrainsurface.BrushResult, error) {
	m := terrainmap.Active()
	if m == nil {
		return terrainsurface.BrushResult{}, terrainmap.ErrDisabled
	}
	return m.ApplyBrush(targets, editor, seq, brush)
}

// handlerTerrainBrushPart 是分区场景里格执行 Base 转发来的一次笔刷（P5，Map.Exec 发起：经 cellworld 扩展消息转发来的
// 请求，或 Base 就是本进程时直接调用；名字沿用拆分设计，维护者 2026-11-10 撤回跨格笔刷后格执行整笔）：targets 是笔刷覆盖
// 到的全部块（都归本进程写），editor 是玩家在本格的账本
// （TerrainCellEditor）；判重、算笔刷、写块、记序号同 TerrainBrush（terrainmap.Map.ApplyBrushPart）。
//
//roost:nest rollback=undo durability=strict
func handlerTerrainBrushPart(targets []terrain_chunk.ISurfaceEntity, editor terrain_cell_editor.ILedgerEntity, seq int64, brush terrain.Brush) (terrainsurface.BrushResult, error) {
	m := terrainmap.Active()
	if m == nil {
		return terrainsurface.BrushResult{}, terrainmap.ErrDisabled
	}
	return m.ApplyBrushPart(targets, editor, seq, brush)
}

// handlerTerrainEditIssue 是分区场景里玩家的 Base 给一次编辑发号（P5，转发之前，terrainmap.ApplyIssue）：在玩家面向客户端的
// 账本（TerrainEditor）里判这个序号——过期 / 超前拒绝，新的记下，发过的答 Again（客户端的重试，照样再转发）。strict：
// 记下之后才转发，所以 LastSeq 查询答的序号覆盖每一个可能已在某个格执行了的编辑。
//
//roost:nest rollback=undo durability=strict
func handlerTerrainEditIssue(editor terrain_editor.ILedgerEntity, seq int64) (terrainledger.Issue, error) {
	return terrainmap.ApplyIssue(editor, seq)
}

// handlerTerrainEditSeq 读玩家编辑账本已应用的最大序号（Map.LastSeq 发起：客户端不知道上一次用到哪里时续号用）。只读，
// 在账本的锁内读，看到的是已提交的值。
//
//roost:nest
func handlerTerrainEditSeq(editor terrain_editor.ILedgerEntity) (int64, error) {
	return editor.LedgerComp().LastSeq(), nil
}

// handlerTerrainDiscard 丢弃一块基于旧原始地形的改动（维护者 2026-11-08：原始地形换版后改过的块丢弃改动；Map.Load
// 在启动时、发布 Map 之前发起，所以不经 terrainmap.Active()）：记录仍基于 staleRevision、且它不是当前包的
// currentRevision 时重置为 Version 0 的空记录，返回是否重置（SurfaceComponent.Discard）。
//
//roost:nest rollback=undo durability=strict
func handlerTerrainDiscard(target terrain_chunk.ISurfaceEntity, staleRevision int64, currentRevision int64) (bool, error) {
	return target.SurfaceComp().Discard(staleRevision, currentRevision), nil
}
