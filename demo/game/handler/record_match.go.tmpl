package handler

import world "{{MODULE}}/game/entities/world"

// handlerRecordMatch is called by the game service's matchmaker after the
// match service committed a group. The remote call happened first, outside
// any Entity lock; only the count crosses into the World.
//
//roost:nest rollback=undo durability=strict
func handlerRecordMatch(target world.IStatsEntity) error {
	target.StatsComp().RecordMatch()
	return nil
}
