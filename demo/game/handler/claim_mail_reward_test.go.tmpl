package handler

import (
	"context"
	"path/filepath"
	"testing"

	generated "{{MODULE}}/configs/generated"
	player "{{MODULE}}/game/entities/player"
	syncsender "{{MODULE}}/game/handler/syncsender"
	"github.com/tjbdwanghaibo/roost-core/configdata"
	"github.com/tjbdwanghaibo/roost-core/dataengine"
