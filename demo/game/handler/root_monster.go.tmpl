package handler

import (
	monster "{{MODULE}}/game/entities/monster"
)

// handlerRootMonster applies (rooted) or dispels the root buff on a monster
// and answers whether it is rooted afterwards. It is the GM's
// `monster_root`; a game applies the same buff from a skill.
//
// The buff is the only thing it writes. Everything else follows from it in
// the same transaction: the Rooted state is derived from the buff's tag
// (combatcomponent.BindStates), the state gate freezes the move group (the
// walk in progress pauses where it is), and the DAO mirror the client draws
// is written by the state's watcher. A refused commit takes the buff back
// and the state with it.
//
//roost:nest rollback=undo durability=async
func handlerRootMonster(target monster.IActorEntity, rooted bool) (bool, error) {
	target.ActorComp().SetRooted(rooted)
	return target.ActorComp().Rooted(), nil
}
