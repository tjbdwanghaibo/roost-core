package handler

import (
	"time"

	player "{{MODULE}}/game/entities/player"
	"{{MODULE}}/game/gift"
	apperrors "{{MODULE}}/internal/errors"
	giftitem "{{MODULE}}/saga/gift_item"
	"github.com/tjbdwanghaibo/roost-core/infra/base/errcode"
	"github.com/tjbdwanghaibo/roost-core/framework/saga"
)

// handlerStartGift starts the gift saga from inside the sender's Nest
// transaction. It changes nothing on the Player: it checks, under the
// Player's lock, that the items are there, and emits the saga start intent
// into the same Nest WAL record — the Data Engine outbox delivers it to the
// saga coordinator (saga.start effect), which then commands the steps. The
// check is advisory: the items can still be spent before the debit step
// runs, and then the debit refuses with the same coded error and the saga
// fails with nothing to compensate. Committing a real reservation here would
// be the stronger design; the demo keeps the Bag simple.
//
// The business key comes from the endpoint (sender, session, frame
// sequence) and the saga id is derived from it (saga.IDOf): a retried frame
// reaches the coordinator as the same start and is folded into the existing
// saga. The client gets the key back and asks GiftStatus with it.
//
// fromSID is the sid of the process running this transaction — the sender's
// bound sid, because a player is only served on the sid their role is bound
// to. The debit and its refund change the sender's Player, so the saga is
// routed by it: StartRequest.Route = saga.SidRoute(fromSID), and the
// coordinator delivers those two steps to that sid's consumers only
// (gift_saga.go). A gift that names no sid could not be routed, and Encode
// refuses it; the coordinator refuses a routed saga without a route too.
//
//roost:nest rollback=undo durability=strict
func handlerStartGift(target player.IBagEntity, fromPlayerID int64, fromSID int32, toPlayerID int64, itemID int64, count int32, sagaID string) (string, error) {
	if count <= 0 {
		return "", errcode.Wrap(apperrors.ErrBagCountInvalid, nil, "item_id", itemID, "count", count)
	}
	if have := target.BagComp().Count(itemID); have < int64(count) {
		return "", errcode.Wrap(apperrors.ErrBagShort, nil, "item_id", itemID, "have", have, "want", count)
	}
	state, err := gift.Encode(gift.State{From: fromPlayerID, FromSID: fromSID, To: toPlayerID, ItemID: itemID, Count: count})
	if err != nil {
		return "", err
	}
	if err := saga.EmitStart(saga.StartRequest{
		Type: giftitem.Type, DefinitionVersion: giftitem.Version, BusinessKey: sagaID,
		Data: state, DeadlineAt: time.Now().Add(gift.Deadline), //glsvet:system-clock a saga deadline is the coordinator's system time
		Route: saga.SidRoute(fromSID),
	}); err != nil {
		return "", err
	}
	return sagaID, nil
}
