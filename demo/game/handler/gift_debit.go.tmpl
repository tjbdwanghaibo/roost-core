package handler

import (
	player "{{MODULE}}/game/entities/player"
	"github.com/tjbdwanghaibo/roost-core/framework/saga"
	"github.com/tjbdwanghaibo/roost-core/infra/base/errcode"
)

// handlerGiftDebit is the gift saga's debit step: take count of itemID out of
// the sender's Bag, and — in the same transaction — record that this command
// ran and what it decided.
//
// That last part is what makes the debit take effect at most once per gift.
// The Bag change and the operation's receipt (in the sender's Player,
// PlayerDao.SagaReceipts) are one WAL record. The generated dispatch calls
// step.Begin(target) before this function: a redelivery, or a later attempt
// of the same step, finds the receipt and replays it instead of debiting
// again, and an attempt that finds no receipt after its deadline is skipped
// (roost-core SAGA.md, 原生步骤执行契约). The result goes back to the
// coordinator once this transaction is durable.
//
// A business refusal (the sender no longer has the items) also commits: no
// mutation, just the receipt of a refusal, because a refusal the coordinator
// never hears is a saga that waits out its deadline. Only an infrastructure
// error returns — that rolls everything back and leaves the outcome unknown to
// the consumer, which naks the command: the redelivery runs this again (no
// receipt was written), and the next attempt comes from the coordinator after
// the step timeout.
//
//roost:nest rollback=undo durability=strict
func handlerGiftDebit(target player.IBagEntity, itemID int64, count int32, step saga.NativeStep) (int32, error) {
	left, err := target.BagComp().RemoveItem(itemID, count)
	if err != nil {
		code, reason := errcode.ClientError(err)
		if code == errcode.CodeInternal {
			return 0, err
		}
		return 0, step.Complete(false, reason)
	}
	return left, step.Complete(true, "")
}
