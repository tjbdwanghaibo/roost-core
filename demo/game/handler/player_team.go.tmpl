package handler

import (
	player "{{MODULE}}/game/entities/player"
)

// handlerPlayerTeam 读玩家自己副本里的队伍 ID（分区场景的组队）：“我在哪支队伍”只取本地锁，不取队伍的分布式锁。
// 副本与成员表在同一笔 [Team, Player] 事务里写（team_*.go）；别人解散队伍时由成员表通知或重读清掉。
//
//roost:nest rollback=undo durability=strict
func handlerPlayerTeam(target player.IProfileEntity) (int64, error) {
	return target.ProfileComp().Owner().TeamID(), nil
}
