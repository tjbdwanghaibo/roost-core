package handler

import (
	player "{{MODULE}}/game/entities/player"
	"github.com/tjbdwanghaibo/roost-core/framework/saga"
	"github.com/tjbdwanghaibo/roost-core/infra/base/errcode"
)

// handlerGuildCredit is a guild saga's native step that puts count of itemID
// into the player's Bag: the refund of the founding fee or the donation
// (the debit's compensation) and the alliance reward (the reward saga's
// grant). Receipt and items are one WAL record (see handlerGuildDebit), so it
// takes effect at most once per operation.
//
// A full stack is a business refusal (bag_stack_full): for the grant it is what
// makes the coordinator compensate the claim (the alliance releases it, and
// the player may claim again once there is room); for a refund it is a
// refused compensation, which the coordinator marks manual_required.
//
//roost:nest rollback=undo durability=pipelined
func handlerGuildCredit(target player.IBagEntity, itemID int64, count int32, step saga.NativeStep) (int32, error) {
	have, err := target.BagComp().Add(itemID, int64(count))
	if err != nil {
		code, reason := errcode.ClientError(err)
		if code == errcode.CodeInternal {
			return 0, err
		}
		return 0, step.Complete(false, reason)
	}
	return int32(have), step.Complete(true, "")
}
