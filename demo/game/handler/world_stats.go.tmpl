package handler

import world "{{MODULE}}/game/entities/world"

// handlerWorldStats is a read: the result value leaves the lock, the World
// does not. A read handler still runs under the lock, so it sees one
// consistent pair of counters.
//
//roost:nest
func handlerWorldStats(target world.IStatsEntity) (world.Stats, error) {
	return target.StatsComp().Snapshot(), nil
}
