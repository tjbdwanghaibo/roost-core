// 档案（名字、等级、经验）是 profile 模块的，它自己的规则由模块的场景钉住（game/handler/profile_test.go）。
// 这里钉的是 demo 在它之上的东西：Player 与 World 两个实体的发放要么都成、要么都不动；升级的两个后果
// （属性、mailbox.profile_reward 这个 effect）经模块的升级钩子随同一笔事务走。

// 两个正数溢出不能被当作成功经验发放；Player 与 World 必须一起保持原值。
func TestExperienceAdditionRejectsOverflow(t *testing.T) {
	subject, counters, client, committer := newDungeonClaimHarnessWithCommitter(t)
	RegisterAddExpNestHandlers()
	sender := syncsender.NewAddExpSender(client)
	ctx := context.Background()
	if _, err := sender.MultiSync_AddExp(ctx, subject.ID(), counters.ID(), 1); err != nil {
		t.Fatal(err)
	}
	before := len(committer.records)
	level := subject.ProfileComp().Level()
	_, err := sender.MultiSync_AddExp(ctx, subject.ID(), counters.ID(), math.MaxInt64)
	if err == nil {
		t.Fatalf("overflow accepted: player exp=%d world exp=%d", subject.ProfileComp().Exp(), counters.StatsComp().Snapshot().ExpGranted)
	}
	// Player 这一半先被问到：经验加法放不下，是档案模块的 profile_exp_overflow。
	if !errors.Is(err, apperrors.ErrProfileExpOverflow) {
		t.Fatalf("err=%v, want profile_exp_overflow", err)
	}
	if subject.ProfileComp().Exp() != 1 || subject.ProfileComp().Level() != level || counters.StatsComp().Snapshot().ExpGranted != 1 || len(committer.records) != before {
		t.Fatal("rejected experience grant changed player, world or commit records")
	}
}

// 平坦等级曲线允许直接除余；靠近存储上限的大额合法奖励也无需逐级循环。
func TestExperienceGrantAtStorageLimit(t *testing.T) {
	subject, counters, client, committer := newDungeonClaimHarnessWithCommitter(t)
	RegisterAddExpNestHandlers()
	sender := syncsender.NewAddExpSender(client)
	wantLevels := int64(math.MaxInt32) - int64(subject.ProfileComp().Level())
	amount := wantLevels*gameprofile.ProfileExpPerLevel + gameprofile.ProfileExpPerLevel - 1
	gained, err := sender.MultiSync_AddExp(context.Background(), subject.ID(), counters.ID(), amount)
	if err != nil || int64(gained) != wantLevels || subject.ProfileComp().Level() != math.MaxInt32 || subject.ProfileComp().Exp() != gameprofile.ProfileExpPerLevel-1 || counters.StatsComp().Snapshot().ExpGranted != amount {
		t.Fatalf("valid boundary grant: gained=%d err=%v level=%d exp=%d", gained, err, subject.ProfileComp().Level(), subject.ProfileComp().Exp())
	}
	before := len(committer.records)
	if _, err := sender.MultiSync_AddExp(context.Background(), subject.ID(), counters.ID(), 1); err == nil || len(committer.records) != before || subject.ProfileComp().Exp() != gameprofile.ProfileExpPerLevel-1 {
		t.Fatal("grant beyond level storage limit was not refused without changes")
	}
}

// World 累计超限时 Player 的经验、等级、属性与升级效果都不变，也没有新的提交记录。
func TestWorldExperienceOverflowLeavesThePlayerUnchanged(t *testing.T) {
	subject, counters, client, committer := newDungeonClaimHarnessWithCommitter(t)
	RegisterAddExpNestHandlers()
	if _, err := nest.RunIsolatedTransaction(context.Background(), &recordingCommitter{}, "seed-world-exp", func() (any, error) {
		counters.Dao().SetExpGranted(math.MaxInt64)
		return nil, nil
	}); err != nil {
		t.Fatal(err)
	}
	level := subject.ProfileComp().Level()
	beforeAttrs, ok := subject.AttributeComp().Final()
	if !ok {
		t.Fatal("missing final attributes")
	}
	hp, attack := beforeAttrs.HP, beforeAttrs.Attack
	_, err := syncsender.NewAddExpSender(client).MultiSync_AddExp(context.Background(), subject.ID(), counters.ID(), gameprofile.ProfileExpPerLevel)
	afterAttrs, ok := subject.AttributeComp().Final()
	if err == nil || !ok || subject.ProfileComp().Level() != level || subject.ProfileComp().Exp() != 0 || counters.StatsComp().Snapshot().ExpGranted != math.MaxInt64 || len(committer.records) != 0 || afterAttrs.HP != hp || afterAttrs.Attack != attack {
		t.Fatalf("world overflow changed player, attributes or effect: err=%v", err)
	}
}

// 副本领奖走同一道校验，超限时不得留下“已领取”账本或奖励效果。
func TestWorldExperienceOverflowLeavesTheDungeonClaimUnpaid(t *testing.T) {
	const now int64 = 1_800_000_000
	pinBusinessClock(t, now)
	subject, counters, client, committer := newDungeonClaimHarnessWithCommitter(t)
	if _, err := nest.RunIsolatedTransaction(context.Background(), &recordingCommitter{}, "seed-world-exp-claim", func() (any, error) {
		counters.Dao().SetExpGranted(math.MaxInt64)
		return nil, nil
	}); err != nil {
		t.Fatal(err)
	}
	level := subject.ProfileComp().Level()
	_, err := syncsender.NewClaimDungeonSender(client).MultiSync_ClaimDungeon(context.Background(), subject.ID(), counters.ID(), "overflow-run", gameprofile.ProfileExpPerLevel, now, clearsSeason)
	if err == nil || subject.ProfileComp().DungeonRunClaimed("overflow-run") || subject.ProfileComp().DungeonClears(clearsSeason) != 0 || subject.ProfileComp().Level() != level || subject.ProfileComp().Exp() != 0 || counters.StatsComp().Snapshot().ExpGranted != math.MaxInt64 || len(committer.records) != 0 {
		t.Fatalf("world overflow left a claim or reward committed: err=%v", err)
	}
}

// 等级的存储类型也是边界；即使只加一级也不能绕回负数。
func TestExperienceLevelRejectsOverflow(t *testing.T) {
	subject, counters, client, committer := newDungeonClaimHarnessWithCommitter(t)
	RegisterAddExpNestHandlers()
	// 仅在测试初始化时写入边界状态；实际发放仍经正式 Sender/Nest 路径。
	if _, err := nest.RunIsolatedTransaction(context.Background(), &recordingCommitter{}, "seed-max-level", func() (any, error) {
		subject.Dao().GetProfile().SetLevel(math.MaxInt32)
		return nil, nil
	}); err != nil {
		t.Fatal(err)
	}
	_, err := syncsender.NewAddExpSender(client).MultiSync_AddExp(context.Background(), subject.ID(), counters.ID(), 100)
	if err == nil || subject.ProfileComp().Level() != math.MaxInt32 || subject.ProfileComp().Exp() != 0 || counters.StatsComp().Snapshot().ExpGranted != 0 || len(committer.records) != 0 {
		t.Fatalf("level overflow was not rejected atomically: err=%v level=%d", err, subject.ProfileComp().Level())
	}
}

// 超限的发放必须在任何 DAO 写入之前被拒绝，而不是写完再靠 rollback=undo 撤回：这里在一笔照常提交的事务里
// 直接调用 handler 并吞掉它的错误，提交下来的 Player 经验、等级、副本账本与 World 累计必须与调用前相同。
// （只靠回滚兜底的写法在这里会把已写的 Player 与“已领取”账本提交出去。）
func TestExperienceOverflowIsRefusedBeforeAnyWrite(t *testing.T) {
	const now int64 = 1_800_000_000
	pinBusinessClock(t, now)
	subject, counters, _, _ := newDungeonClaimHarnessWithCommitter(t)
	ctx := context.Background()
	committer := &recordingCommitter{}
	if _, err := nest.RunIsolatedTransaction(ctx, committer, "seed-world-exp", func() (any, error) {
		counters.Dao().SetExpGranted(math.MaxInt64)
		return nil, nil
	}); err != nil {
		t.Fatal(err)
	}
	level := subject.ProfileComp().Level()
	calls := map[string]func() error{
		"add_exp": func() error {
			_, err := handlerAddExp(subject, counters, gameprofile.ProfileExpPerLevel)
			return err
		},
		"claim_dungeon": func() error {
			_, err := handlerClaimDungeon(subject, counters, "refused-run", gameprofile.ProfileExpPerLevel, now, now, clearsSeason)
			return err
		},
	}
	for name, call := range calls {
		var handlerErr error
		if _, err := nest.RunIsolatedTransaction(ctx, committer, "swallow-"+name, func() (any, error) {
			handlerErr = call()
			return nil, nil
		}); err != nil {
			t.Fatalf("%s: commit the swallowed call: %v", name, err)
		}
		// Player 这一半放得下，拒绝来自 World 的累计：demo 自己的 exp_amount。
		if code, _ := errcode.ClientError(handlerErr); code != 100004 {
			t.Fatalf("%s: code=%d, want exp_amount (100004): %v", name, code, handlerErr)
		}
		if subject.ProfileComp().Exp() != 0 || subject.ProfileComp().Level() != level || subject.ProfileComp().DungeonRunClaimed("refused-run") || counters.StatsComp().Snapshot().ExpGranted != math.MaxInt64 {
			t.Fatalf("%s wrote before refusing: want level %d, exp=%d level=%d claimed=%v world=%d", name, level, subject.ProfileComp().Exp(), subject.ProfileComp().Level(), subject.ProfileComp().DungeonRunClaimed("refused-run"), counters.StatsComp().Snapshot().ExpGranted)
		}
	}
}

// 升级事务的奖励 effect 来自 mailbox/profile 联动；demo 仅覆盖奖励规则。
// 两实体 AddExp 与模块 ProfileAddExp 都必须带同一条奖励快照，没升级则没有 effect。
func TestLevelUpCarriesTheRewardEffectInTheSameCommit(t *testing.T) {
	const now int64 = 1_800_000_000
	pinBusinessClock(t, now)
	subject, counters, client, committer := newDungeonClaimHarnessWithCommitter(t)
	RegisterAddExpNestHandlers()
	RegisterProfileAddExpNestHandlers()
	ctx := context.Background()

	// levelUps 是上一笔提交里的 mailbox.profile_reward；同时要求这笔提交确实是新的一笔。
	seen := 0
	levelUps := func(what string) []mailbox.ProfileReward {
		t.Helper()
		if len(committer.records) != seen+1 {
			t.Fatalf("%s: %d commits so far, want %d", what, len(committer.records), seen+1)
		}
		seen = len(committer.records)
		var out []mailbox.ProfileReward
		for _, effect := range committer.records[seen-1].Effects {
			if effect.Topic != mailbox.TopicProfileReward {
				t.Fatalf("%s: unexpected effect %q", what, effect.Topic)
			}
			var event mailbox.ProfileReward
			if err := json.Unmarshal(effect.Payload, &event); err != nil {
				t.Fatalf("%s: decode the effect: %v", what, err)
			}
			out = append(out, event)
		}
		return out
	}
	wantOne := func(what string, got []mailbox.ProfileReward, level int32) {
		t.Helper()
		if len(got) != 1 || got[0].PlayerID != subject.UniqueID() || got[0].Level != level {
			t.Fatalf("%s: effects = %+v, want one level-up of player %d to level %d", what, got, subject.UniqueID(), level)
		}
	}
	startLevel := subject.ProfileComp().Level()
	startAttrs, ok := subject.AttributeComp().Final()
	if !ok {
		t.Fatal("missing final attributes")
	}
	startHP := startAttrs.HP

	// 没升级：经验涨了，没有 effect。
	sender := syncsender.NewAddExpSender(client)
	if gained, err := sender.MultiSync_AddExp(ctx, subject.ID(), counters.ID(), 40); err != nil || gained != 0 {
		t.Fatalf("add 40 exp: gained=%d err=%v", gained, err)
	}
	if got := levelUps("a grant below a level"); len(got) != 0 {
		t.Fatalf("a grant that did not level up emitted %+v", got)
	}
	// 升一级：一条 effect，等级是升级之后的等级；属性跟着涨。
	if gained, err := sender.MultiSync_AddExp(ctx, subject.ID(), counters.ID(), 60); err != nil || gained != 1 {
		t.Fatalf("add 60 exp: gained=%d err=%v", gained, err)
	}
	wantOne("a level-up through AddExp", levelUps("a level-up through AddExp"), startLevel+1)
	if after, _ := subject.AttributeComp().Final(); after.HP <= startHP {
		t.Fatalf("the level-up did not raise the attributes: HP %d -> %d", startHP, after.HP)
	}
	// 连升多级：仍是一条，带最后的等级。
	if gained, err := sender.MultiSync_AddExp(ctx, subject.ID(), counters.ID(), 3*gameprofile.ProfileExpPerLevel); err != nil || gained != 3 {
		t.Fatalf("add 300 exp: gained=%d err=%v", gained, err)
	}
	wantOne("three levels at once", levelUps("three levels at once"), startLevel+4)
	// 副本领奖走同一个钩子。
	claim, err := syncsender.NewClaimDungeonSender(client).MultiSync_ClaimDungeon(ctx, subject.ID(), counters.ID(), "level-up-run", gameprofile.ProfileExpPerLevel, now, clearsSeason)
	if err != nil || !claim.Claimed || claim.LevelsGained != 1 {
		t.Fatalf("claim: %+v err=%v", claim, err)
	}
	wantOne("a level-up through the dungeon claim", levelUps("a level-up through the dungeon claim"), startLevel+5)
	// 模块自己的发经验 handler 也走同一个钩子。
	if gained, err := syncsender.NewProfileAddExpSender(client).Sync_ProfileAddExp(ctx, subject.ID(), gameprofile.ProfileExpPerLevel); err != nil || gained != 1 {
		t.Fatalf("ProfileAddExp: gained=%d err=%v", gained, err)
	}
	wantOne("a level-up through the module's ProfileAddExp", levelUps("a level-up through the module's ProfileAddExp"), startLevel+6)
}
