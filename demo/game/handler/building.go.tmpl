// handlerBuildingRebase 是启动对账里的一座建筑（Map.ReconcileBuildings 发起，Install 之后）：核对建筑与块上的占地记录
// 一致、配置对得上，原始地形换版时按新版本处置（terrainmap.Map.ApplyRebase）。lot 是块记录里的占地（terrainsurface.Lot 的打包值）。
//
//roost:nest rollback=undo durability=strict
func handlerBuildingRebase(targets []terrain_chunk.ISurfaceEntity, site building.ISiteEntity, lot int64) (buildingsite.Rebase, error) {
	m := terrainmap.Active()
	if m == nil {
		return buildingsite.Rebase{}, terrainmap.ErrDisabled
	}
	return m.ApplyRebase(targets, site, lot)
}
