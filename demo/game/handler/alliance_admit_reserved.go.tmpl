package handler

import (
	"time"

	"{{MODULE}}/game/alliancerule"
	alliance "{{MODULE}}/game/entities/alliance"
)

// handlerAllianceAdmitReserved is step 2 of a join whose guard is on another
// instance: the guard has been reserved for (this alliance, requestID), and
// this seats the player under the same request id. The service confirms the
// guard with a direct ResolveGuard afterwards (a lost one is healed from this
// roster); a rejection is recorded too, so a reservation the guard later
// settles by this request's receipt can never turn into a seat. The answer
// names the membership it made (Member) for the service's notice.
//
//roost:nest rollback=undo durability=strict
func handlerAllianceAdmitReserved(target alliance.IRosterEntity, requestID string, actorID int64, playerID int64, callerSID int32, viaApplication bool, maxMembers int32, retentionSeconds int64, nowUnix int64) (alliancerule.Answer, error) {
	roster := target.RosterComp()
	var joined alliancerule.MemberChange
	outcome, err := roster.Execute(requestID, nowUnix, time.Duration(retentionSeconds)*time.Second, func() (int64, error) {
		homeSID, err := roster.AdmissionHome(actorID, playerID, callerSID, viaApplication, int(maxMembers))
		if err != nil {
			return playerID, err
		}
		roster.Admit(playerID, homeSID, requestID, nowUnix)
		joined = alliancerule.MemberChange{PlayerID: playerID, HomeSID: homeSID, Change: alliancerule.MemberJoined}
		return playerID, nil
	})
	reply, err := answer(roster, outcome, err)
	reply.Member = joined
	return reply, err
}
