package handler

import (
	"time"

	world "{{MODULE}}/game/entities/world"
)

// handlerTickWorldTimers fires the World's due timers.
//
// The framework's timer driver (world.TimerDriver) delivers it when the
// World's earliest deadline is due, carrying the business time of the
// delivery; nothing ticks the World on a schedule. The FIRING happens here,
// inside the World's Nest lock: whatever a timer callback changes, and the
// removal or renewal of the node that fired, land in one WAL record, and the
// driver sees the new earliest deadline only after that record commits. A
// scheduler ticked outside the lock would have to write back afterwards, and
// the window between the two writes is where a timer fires twice after a
// crash.
//
// Its Nest name must be world.TimerTickHandler, the name the driver delivers
// to (tick_world_timers_test.go). It returns how many nodes are still armed,
// which is what a test asserts.
//
//roost:nest rollback=undo durability=strict
func handlerTickWorldTimers(target world.ITimerEntity, nowUnixMilli int64) (int32, error) {
	return int32(target.TimerComp().Tick(time.UnixMilli(nowUnixMilli))), nil
}
