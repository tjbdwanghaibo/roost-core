package handler

import (
	player "{{MODULE}}/game/entities/player"
)

// handlerShowGuild sets which guild the player is shown in (PlayerDao.GuildID,
// nopersist,sync) and reports whether it changed. Nothing is persisted: the
// alliance service's roster is the authority, and this is the display copy the
// game fills at login from the guard mirror, after the player's own join /
// leave, and on a membership notice. The sync field carries it to the client
// and to nearby players.
//
// replaces makes the change conditional: when it is not 0 the field changes
// only if it still shows replaces. A "left guild 7" notice that arrives after
// the player has already joined guild 9 must not blank guild 9; it hides only
// the guild it is about.
//
//roost:nest rollback=undo durability=strict
func handlerShowGuild(target player.IProfileEntity, guildID int64, replaces int64) (bool, error) {
	profile := target.ProfileComp()
	current := profile.GuildID()
	if current == guildID || (replaces != 0 && current != replaces) {
		return false, nil
	}
	profile.SetGuild(guildID)
	return true, nil
}
