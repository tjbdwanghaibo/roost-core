package terrainmap

// 分区场景的跨格编辑与建筑（可编辑地形 P5，T08；方案 §30）。
//
// 玩家连在自己的 Base 进程上，块只归包含它的格的进程写。一次编辑（笔刷 / 放置 / 拆除 / 改参数）由 Base 拆成“每个格一份”
// 的子请求，转发给写这些块的格进程（Forwarder：本进程的那一份直接执行，别的经 cellworld 扩展消息，接线在
// internal/service/<game>/terrain_relay.go），各格各自一笔 strict 事务。跨格不是原子的（D5）：各格独立提交，接缝靠各格
// 的副本推送最终一致（T05）。
//
// 身份与判重（D18 的延伸）：
//   - 客户端的身份仍是（玩家, 序号）。Base 先在玩家面向客户端的账本（TerrainEditor，全局库，只有玩家的 Base 写）里“发号”
//     （handler TerrainEditIssue，strict）：过期 / 超前照旧拒绝（terrain_seq）；新的记下；发过的（客户端的重试）答 Again、
//     照样再转发。记下在转发之前落盘，所以 LastSeq 查询答的数覆盖每一个可能已在某个格执行了的序号，客户端从 LastSeq + 1
//     续号不会撞上任何格里已用过的序号。
//   - 子请求的身份是（玩家, 序号, 格）：每个格有玩家的一份账本（TerrainCellEditor，dbscope=sid：每个格进程写自己的库），
//     与这个格的块同一笔事务，同一（玩家, 序号）在一个格至多执行一次。重发、重试、格重启后的重放都只答 Duplicate，
//     不会双写。格的账本不判超前（Base 判过）。
//
// 结论（每个格一份，Outcome）：Applied（这次执行了）/ Duplicate（以前执行过）/ Refused（确定什么都没写，带原因）/
// Unknown（期限内没拿到结论，或格的事务结果未知：可能已经生效）。汇总（RelayResult.Err）：都 Applied / Duplicate 是成功；
// 有 Unknown 答 ErrPending（不论别的格）；否则答第一个拒绝的原因——已执行的格保留（部分成功，答复逐块列出结论）。
//
// 责任方：
//   - 部分格拒绝：不补、不回滚（D5）；答复让客户端知道哪些块做了。
//   - 期限内没有结论：Base 在期限内按同一身份重发（Forwarder），格的账本去重；期限到了答 ErrPending，由客户端用同一个
//     序号重发（与单格“结果未知”的规则相同）；重发时 Base 的账本答 Again，再转发一遍，已执行的格答 Duplicate、没执行的
//     格这次执行。
//   - 格重启：块、格账本都是 strict 持久，重启后的重发得到 Duplicate 或执行；Base 重启：面向客户端的账本是 strict 持久，
//     客户端重发同上。Base 不持久“没完成的编辑”——客户端不再重发时，结果未知的那一部分停在它实际的状态（执行了或没有）。
//
// 配额（D16，Base 扣）：Base 没有装这些块，按 Footprint（每块覆盖的采样点数，几何上限）预扣；格答回实际改动的点数，
// 按结论多退：Applied 计实际点数、Unknown 计它的 Footprint（可能已生效，不退）、Refused / Duplicate 计 0；合计至少
// MinEditPoints。建筑：放置预扣 MinEditPoints + 占地面积（整平时），Applied 计 MinEditPoints + 实际整平点数；拆除、改参数
// 计 MinEditPoints。配额只在 Base 的进程内存（重启从满桶开始，与普通场景相同）。
//
// 建筑：占地覆盖的块必须都归同一个格（ErrBuildCrossCell）：一座建筑是一个实体，放置要在一笔事务里锁住占地覆盖的全部
// 块，跨格占地要跨进程事务，首版拒绝（方案 D7，§30 待确认）。

import (
	"context"
	"errors"
	"fmt"
	"slices"
	"sync"

	building "{{MODULE}}/game/entities/building"
	terrain_cell_editor "{{MODULE}}/game/entities/terrain_cell_editor"
	terrain_chunk "{{MODULE}}/game/entities/terrain_chunk"
	terrain_editor "{{MODULE}}/game/entities/terrain_editor"
	"github.com/tjbdwanghaibo/roost-core/gameplay/terrain"
)

var (
	// ErrPending：转发出去的一部分在期限内没拿到结论（或格的事务结果未知），可能已经生效。客户端用同一个序号重发：已执行
	// 的格答 Duplicate，没执行的格这次执行。
	ErrPending = errors.New("terrain: the edit's result in some cell is not known yet; send it again with the same sequence")
	// ErrBuildCrossCell：建筑的占地覆盖了两个格的块（分区场景首版拒绝，方案 §30）。
	ErrBuildCrossCell = errors.New("terrain: the building's lot straddles two cells")
	// ErrCellFailed：格答复了一个没有归类的失败（读库、建实体出错之类，确定没有执行）。答 internal。
	ErrCellFailed = errors.New("terrain: the cell could not run the edit")
)

// PartOp 是一份子请求的操作。
type PartOp uint8

const (
	PartBrush  PartOp = 1
	PartPlace  PartOp = 2
	PartRemove PartOp = 3
	PartParams PartOp = 4
)

// PartRequest 是 Base 转发给一个格的子请求：身份（PlayerID, Seq）与客户端的请求相同，格的账本按（玩家, 序号）判本格的
// 那一部分。笔刷整笔转发，格自己算出覆盖到的块里归它写的那几块（各格按同一几何拆分，不需要 Base 说是哪几块）。
type PartRequest struct {
	Op       PartOp
	PlayerID int64
	Seq      int64
	// Brush 是 PartBrush 的笔刷。
	Brush terrain.Brush
	// Placement 是 PartPlace 的放置。
	Placement building.Placement
	// GX、GY 是 PartRemove / PartParams 的锚点，Params 是 PartParams 的参数。
	GX, GY int64
	Params []int32
}

// Outcome 是一份子请求的结论。
type Outcome uint8

const (
	// OutcomeApplied：格这次执行并提交了它的那一部分。
	OutcomeApplied Outcome = 1
	// OutcomeDuplicate：格的账本说这一部分以前执行过，这次什么都没写。
	OutcomeDuplicate Outcome = 2
	// OutcomeRefused：格确定什么都没写（Refusal 是原因）。
	OutcomeRefused Outcome = 3
	// OutcomeUnknown：期限内没拿到结论，或格的事务结果未知（WAL 超时、提交被拒之类）：可能已经生效。
	OutcomeUnknown Outcome = 4
)

func (o Outcome) String() string {
	switch o {
	case OutcomeApplied:
		return "applied"
	case OutcomeDuplicate:
		return "duplicate"
	case OutcomeRefused:
		return "refused"
	case OutcomeUnknown:
		return "unknown"
	}
	return fmt.Sprintf("outcome(%d)", uint8(o))
}

// PartAnswer 是一份子请求的结论。
type PartAnswer struct {
	Outcome Outcome
	// Refusal 是 OutcomeRefused 的原因：本包的哨兵错误之一（跨进程时按 RefusalCode / RefusalErr 换码），errors.Is 可判。
	Refusal error
	// Chunks 是这一部分锁住的每一块此后的版本（Applied / Duplicate）。
	Chunks []terrain_chunk.ChunkVersion
	// Points 是 Applied 时实际改动的点数（笔刷：高度、材质各算一次；放置：整平改的节点数），Base 按它多退预扣的配额。
	Points int
	// LastSeq 是格的账本此后的 LastSeq（诊断用；面向客户端的是 Base 账本的 LastSeq）。
	LastSeq int64
	// Building 是建筑操作之后建筑的状态（Applied / Duplicate）。
	Building building.State
}

// Forwarder 是 Base 转发子请求的通道（分区场景的接线实现它）。
type Forwarder interface {
	// OwnerOf 是写这一块的格进程的 sid（分区网格）；false 表示没有格写它。
	OwnerOf(key terrain.ChunkKey) (int32, bool)
	// Forward 把 req 交给 sid 的格执行并等它的结论：期限内按同一身份反复重发（格按（玩家, 序号）去重），拿不到结论答
	// OutcomeUnknown；sid 是本进程时直接执行。会阻塞到结论或期限：只能在 Nest 业务 worker 之外调用。
	Forward(ctx context.Context, sid int32, req PartRequest) PartAnswer
}

// RelayPart 是一次转发编辑里一个格的那一部分：格的 sid、这一部分的块（笔刷：覆盖到的块里归这个格的；建筑：占地覆盖的块，
// 拆除 / 改参数：锚点所在的块）与它的结论。
type RelayPart struct {
	SID    int32
	Chunks []terrain.ChunkKey
	Answer PartAnswer
}

// RelayResult 是 Base 上一次转发编辑的结果：各部分（按 sid 升序）、玩家面向客户端的账本此后的 LastSeq，与这个序号是否
// 以前发过（Again：客户端的重试）。
type RelayResult struct {
	Parts   []RelayPart
	LastSeq int64
	Again   bool
}

// Err 汇总各部分（见包说明“结论”）：都 Applied / Duplicate 时为 nil；有 Unknown 时是 ErrPending；否则是第一个拒绝的原因
// （按 sid 升序；部分格可能已执行）。
func (r RelayResult) Err() error {
	var refused error
	for _, part := range r.Parts {
		switch part.Answer.Outcome {
		case OutcomeUnknown:
			return fmt.Errorf("%w: cell %d", ErrPending, part.SID)
		case OutcomeRefused:
			if refused == nil {
				refused = fmt.Errorf("cell %d: %w", part.SID, part.Answer.Refusal)
			}
		case OutcomeApplied, OutcomeDuplicate:
		default:
			return fmt.Errorf("%w: cell %d answered %v", ErrPending, part.SID, part.Answer.Outcome)
		}
	}
	return refused
}

// Duplicate 报告每一部分都答 Duplicate（这次什么都没写，整笔以前已执行过）。
func (r RelayResult) Duplicate() bool {
	for _, part := range r.Parts {
		if part.Answer.Outcome != OutcomeDuplicate {
			return false
		}
	}
	return len(r.Parts) > 0
}

// ---- Base 一侧 ----

// RelayBrush 是分区场景的 Base 上玩家的一次笔刷（协议 TerrainEdit 的端点调用）：校验参数与 Policy → 按 Footprint 预扣配额
// → 权限钩子 → 面向客户端的账本发号（过期 / 超前在这里拒绝）→ 按格拆分、并行转发 → 按结论退配额。返回的错误只有转发之前
// 的拒绝（同 Brush：ErrBrush / ErrNotOwned（覆盖到没有格写的块）/ ErrRateLimited / ErrDenied / ErrStale / ErrSeqAhead 与
// 基础设施错误）；转发之后的结论在 RelayResult 里（RelayResult.Err 汇总）。会等数据库、WAL 与别的进程：只能在 Nest 业务
// worker 之外调用。
func (m *Map) RelayBrush(ctx context.Context, playerID int64, seq uint64, brush terrain.Brush, fw Forwarder) (RelayResult, error) {
	if m == nil {
		return RelayResult{}, ErrDisabled
	}
	keys, err := m.checkBrushParams(playerID, seq, brush)
	if err != nil {
		return RelayResult{}, err
	}
	parts, err := splitByOwner(keys, fw)
	if err != nil {
		return RelayResult{}, err
	}
	footprint := brush.Footprint(m.meta)
	total := 0
	for _, n := range footprint {
		total += n
	}
	charge := m.charge(playerID, max(total, m.policy.MinEditPoints))
	if !charge.ok {
		return RelayResult{}, fmt.Errorf("%w: player %d: the edit may change %d points", ErrRateLimited, playerID, charge.points)
	}
	if m.rules != nil {
		if err := m.rules.AllowEdit(ctx, playerID, brush, keys); err != nil {
			charge.settle(m.policy.MinEditPoints)
			return RelayResult{}, fmt.Errorf("%w: %w", ErrDenied, err)
		}
	}
	result, err := m.issueAndForward(ctx, playerID, int64(seq), parts, fw, PartRequest{Op: PartBrush, PlayerID: playerID, Seq: int64(seq), Brush: brush})
	if err != nil {
		charge.refundUnlessUnknown(err, m.policy.MinEditPoints)
		return RelayResult{}, err
	}
	used := 0
	for _, part := range result.Parts {
		switch part.Answer.Outcome {
		case OutcomeApplied:
			used += part.Answer.Points
		case OutcomeUnknown:
			for _, key := range part.Chunks {
				used += footprint[key]
			}
		}
	}
	charge.settle(max(used, m.policy.MinEditPoints))
	return result, nil
}

// RelayPlace 是分区场景的 Base 上玩家放置一座建筑：校验配置、参数、朝向、占地在图里（同 Place 的事务前检查，不看块归属）
// → 占地覆盖的块必须归同一个格（ErrBuildCrossCell）→ 预扣 MinEditPoints + 占地面积（整平时）→ 权限钩子 → 发号 → 转发给
// 那个格 → 按结论退配额。错误与结论同 RelayBrush。
func (m *Map) RelayPlace(ctx context.Context, playerID int64, seq uint64, p building.Placement, fw Forwarder) (RelayResult, error) {
	if m == nil {
		return RelayResult{}, ErrDisabled
	}
	if !m.BuildingsEnabled() {
		return RelayResult{}, ErrBuildingsDisabled
	}
	lot, err := m.checkPlacementParams(playerID, seq, p)
	if err != nil {
		return RelayResult{}, err
	}
	keys := lot.Chunks()
	parts, err := splitByOwner(keys, fw)
	if err != nil {
		return RelayResult{}, err
	}
	if len(parts) != 1 {
		return RelayResult{}, fmt.Errorf("%w: lot %v covers chunks of %d cells", ErrBuildCrossCell, lot, len(parts))
	}
	p.Params = slices.Clone(p.Params)
	points := m.policy.MinEditPoints
	if p.Level {
		points += int(lot.W) * int(lot.H)
	}
	charge := m.charge(playerID, points)
	if !charge.ok {
		return RelayResult{}, fmt.Errorf("%w: player %d: the placement may cost %d points", ErrRateLimited, playerID, points)
	}
	if rules, ok := m.rules.(BuildRules); ok {
		if err := rules.AllowBuild(ctx, playerID, p, keys); err != nil {
			charge.settle(m.policy.MinEditPoints)
			return RelayResult{}, fmt.Errorf("%w: %w", ErrDenied, err)
		}
	}
	result, err := m.issueAndForward(ctx, playerID, int64(seq), parts, fw, PartRequest{Op: PartPlace, PlayerID: playerID, Seq: int64(seq), Placement: p})
	if err != nil {
		charge.refundUnlessUnknown(err, m.policy.MinEditPoints)
		return RelayResult{}, err
	}
	switch answer := result.Parts[0].Answer; answer.Outcome {
	case OutcomeApplied:
		charge.settle(m.policy.MinEditPoints + answer.Points)
	case OutcomeRefused, OutcomeDuplicate:
		charge.settle(m.policy.MinEditPoints)
	}
	return result, nil
}

// RelayRemove / RelayParams 是分区场景的 Base 上属主拆除锚点在节点 (gx, gy) 的建筑、改它的参数：锚点所在的块的格执行
// （它按自己的占位表找占地，找不到答 ErrNoBuilding）。配额 MinEditPoints。错误与结论同 RelayBrush。
func (m *Map) RelayRemove(ctx context.Context, playerID int64, seq uint64, gx, gy int64, fw Forwarder) (RelayResult, error) {
	return m.relayAnchored(ctx, PartRequest{Op: PartRemove, PlayerID: playerID, Seq: int64(seq), GX: gx, GY: gy}, seq, fw)
}

func (m *Map) RelayParams(ctx context.Context, playerID int64, seq uint64, gx, gy int64, params []int32, fw Forwarder) (RelayResult, error) {
	if len(params) > building.MaxParams {
		return RelayResult{}, fmt.Errorf("%w: %d values, at most %d", ErrBuildingParams, len(params), building.MaxParams)
	}
	return m.relayAnchored(ctx, PartRequest{Op: PartParams, PlayerID: playerID, Seq: int64(seq), GX: gx, GY: gy, Params: slices.Clone(params)}, seq, fw)
}

func (m *Map) relayAnchored(ctx context.Context, req PartRequest, seq uint64, fw Forwarder) (RelayResult, error) {
	if m == nil {
		return RelayResult{}, ErrDisabled
	}
	if !m.BuildingsEnabled() {
		return RelayResult{}, ErrBuildingsDisabled
	}
	if err := checkIdentity(req.PlayerID, seq); err != nil {
		return RelayResult{}, err
	}
	if _, err := building.UniqueID(req.GX, req.GY); err != nil {
		return RelayResult{}, fmt.Errorf("%w: %w", ErrBuild, err)
	}
	key := terrain.ChunkKey{X: int32(req.GX / terrain.ChunkSamples), Y: int32(req.GY / terrain.ChunkSamples)}
	if !m.meta.Contains(key) {
		return RelayResult{}, fmt.Errorf("%w: anchor (%d, %d) is outside the map", ErrBuild, req.GX, req.GY)
	}
	parts, err := splitByOwner([]terrain.ChunkKey{key}, fw)
	if err != nil {
		return RelayResult{}, err
	}
	charge := m.charge(req.PlayerID, m.policy.MinEditPoints)
	if !charge.ok {
		return RelayResult{}, fmt.Errorf("%w: player %d: a building operation", ErrRateLimited, req.PlayerID)
	}
	return m.issueAndForward(ctx, req.PlayerID, int64(seq), parts, fw, req)
}

// splitByOwner 把块按写它们的格分组（按 sid 升序，块按 (Y, X) 升序）；有块没有格写时答 ErrNotOwned。
func splitByOwner(keys []terrain.ChunkKey, fw Forwarder) ([]RelayPart, error) {
	bySID := map[int32][]terrain.ChunkKey{}
	for _, key := range keys {
		sid, ok := fw.OwnerOf(key)
		if !ok || sid == 0 {
			return nil, fmt.Errorf("%w: no cell writes chunk %v", ErrNotOwned, key)
		}
		bySID[sid] = append(bySID[sid], key)
	}
	parts := make([]RelayPart, 0, len(bySID))
	for sid, chunks := range bySID {
		parts = append(parts, RelayPart{SID: sid, Chunks: chunks})
	}
	slices.SortFunc(parts, func(a, b RelayPart) int { return int(a.SID) - int(b.SID) })
	return parts, nil
}

// issueAndForward 在面向客户端的账本里发号，然后把 req 并行转发给每一部分的格、等齐结论。
func (m *Map) issueAndForward(ctx context.Context, playerID, seq int64, parts []RelayPart, fw Forwarder, req PartRequest) (RelayResult, error) {
	issue, err := m.issue(ctx, playerID, seq)
	if err != nil {
		return RelayResult{}, err
	}
	var wg sync.WaitGroup
	for i := range parts {
		wg.Go(func() { parts[i].Answer = fw.Forward(ctx, parts[i].SID, req) })
	}
	wg.Wait()
	return RelayResult{Parts: parts, LastSeq: issue.LastSeq, Again: issue.Again}, nil
}

// issue 是 Base 的发号：玩家面向客户端的账本（TerrainEditor）第一次用时建出，一笔 strict 事务（handler TerrainEditIssue）。
func (m *Map) issue(ctx context.Context, playerID, seq int64) (terrain_editor.Issue, error) {
	ledger, err := m.ledgerFor(ctx, playerID)
	if err != nil {
		return terrain_editor.Issue{}, err
	}
	issue, err := m.editor.Sync_TerrainEditIssue(ctx, ledger, seq)
	if err != nil {
		return terrain_editor.Issue{}, fmt.Errorf("terrain: player %d edit ledger: %w", playerID, err)
	}
	return issue, nil
}

// ApplyIssue 是 handler TerrainEditIssue 的业务（分区场景的 Base，转发之前）：在玩家面向客户端的账本里判序号——Stale /
// Ahead 答 *SeqError（什么都不写）；Duplicate 答 Again（这个序号发过：客户端的重试，照样再转发）；Fresh 记下。账本的锁内、
// rollback=undo 事务里运行，只读写内存。
func ApplyIssue(editor terrain_editor.ILedgerEntity, seq int64) (terrain_editor.Issue, error) {
	if seq < 1 {
		return terrain_editor.Issue{}, fmt.Errorf("%w: edit sequence %d", ErrBrush, seq)
	}
	ledger := editor.LedgerComp()
	switch verdict := ledger.Check(seq); verdict {
	case terrain_editor.Duplicate:
		return terrain_editor.Issue{Again: true, LastSeq: ledger.LastSeq()}, nil
	case terrain_editor.Stale, terrain_editor.Ahead:
		return terrain_editor.Issue{}, &SeqError{PlayerID: ledger.PlayerID(), Seq: seq, LastSeq: ledger.LastSeq(), Verdict: verdict}
	}
	ledger.Record(seq)
	return terrain_editor.Issue{LastSeq: ledger.LastSeq()}, nil
}

// quotaCharge 是一次预扣：settle 按实际用掉的点数退回多扣的部分（至多退到 0）。
type quotaCharge struct {
	m        *Map
	playerID int64
	points   int
	ok       bool
}

// charge 预扣 points 点（规则同 Brush 的“配额”：余额够或桶满时透支一次）；Policy 不限时什么都不扣、ok 为真。
func (m *Map) charge(playerID int64, points int) quotaCharge {
	c := quotaCharge{m: m, playerID: playerID, points: points, ok: true}
	if rate := m.policy.EditPointsPerSecond; rate > 0 {
		c.ok = m.quota.take(playerID, points, rate)
	} else {
		c.points = 0
	}
	return c
}

func (c quotaCharge) settle(used int) {
	if rate := c.m.policy.EditPointsPerSecond; rate > 0 && c.points > used {
		c.m.quota.refund(c.playerID, c.points-used, rate)
	}
}

// refundUnlessUnknown：发号之前或发号被拒（确定什么都没转发）退到 floor；发号的事务结果未知（可能已记下、但没有转发）也
// 退——没有任何格执行，配额只花在请求本身。
func (c quotaCharge) refundUnlessUnknown(_ error, floor int) { c.settle(floor) }

// ---- 格一侧 ----

// EnableCell 让本进程执行 Base 转发来的子请求（分区场景里托管格的进程，P5）：cellEditors 是玩家在本格的账本的 lifecycle。
// Install 之前调用。不托管格的进程不调用，Exec 一律答 ErrNotOwned。
func (m *Map) EnableCell(cellEditors CellEditors) { m.cellEditors = cellEditors }

// Exec 执行 Base 转发来的一份子请求（分区场景托管格的进程，P5）：不扣配额、不调权限钩子（Base 做过），账本是玩家在本格的
// TerrainCellEditor。拒绝（确定什么都没写）答 OutcomeRefused；事务出错而结果未知答 OutcomeUnknown。会等数据库与 WAL：
// 只能在 Nest 业务 worker 之外调用（接线在自己的 goroutine 上调用它）。
func (m *Map) Exec(ctx context.Context, req PartRequest) PartAnswer {
	if m == nil {
		return refusedAnswer(ErrDisabled)
	}
	if m.cellEditors == nil {
		return refusedAnswer(fmt.Errorf("%w: this process hosts no cell", ErrNotOwned))
	}
	switch req.Op {
	case PartBrush:
		return m.execBrush(ctx, req)
	case PartPlace, PartRemove, PartParams:
		if !m.BuildingsEnabled() {
			return refusedAnswer(ErrBuildingsDisabled)
		}
		return m.execBuilding(ctx, req)
	}
	return refusedAnswer(fmt.Errorf("%w: unknown operation %d", ErrBrush, req.Op))
}

func refusedAnswer(err error) PartAnswer { return PartAnswer{Outcome: OutcomeRefused, Refusal: err} }

// answerOf 把格上一次执行的结果换成结论：拒绝在写之前（refusedBeforeWriting）或事务之前的错误是 Refused；事务本身的别的错误
// （提交被拒、WAL 超时）是 Unknown。
func answerOf(err error, inTransaction bool) PartAnswer {
	if !inTransaction || refusedBeforeWriting(err) || errors.Is(err, ErrBuildingConfig) || errors.Is(err, ErrBuildingParams) {
		return refusedAnswer(err)
	}
	return PartAnswer{Outcome: OutcomeUnknown, Refusal: err}
}

func (m *Map) execBrush(ctx context.Context, req PartRequest) PartAnswer {
	if _, err := m.checkBrushParams(req.PlayerID, uint64(req.Seq), req.Brush); err != nil {
		return refusedAnswer(err)
	}
	part := m.ownedPart(req.Brush)
	if len(part) == 0 {
		return refusedAnswer(fmt.Errorf("%w: the brush covers no chunk written here", ErrNotOwned))
	}
	for _, key := range part {
		if cause := m.unloadableErr(key); cause != nil {
			return refusedAnswer(fmt.Errorf("%w: chunk %v: %v", ErrUnloadable, key, cause))
		}
	}
	ledger, err := m.cellLedgerFor(ctx, req.PlayerID)
	if err != nil {
		return answerOf(err, false)
	}
	ids, err := m.chunkIDs(ctx, part)
	if err != nil {
		return answerOf(err, false)
	}
	result, err := m.editor.MultiGroupSync_TerrainBrushPart(ctx, ids, ledger, req.Seq, req.Brush)
	if err != nil {
		return answerOf(err, true)
	}
	answer := PartAnswer{Outcome: OutcomeApplied, Chunks: result.Chunks, Points: result.Points, LastSeq: result.LastSeq}
	if result.Duplicate {
		answer.Outcome, answer.Points = OutcomeDuplicate, 0
	}
	return answer
}

func (m *Map) execBuilding(ctx context.Context, req PartRequest) PartAnswer {
	var (
		lot  terrain_chunk.Lot
		keys []terrain.ChunkKey
	)
	switch req.Op {
	case PartPlace:
		var err error
		if lot, keys, err = m.checkPlacement(req.PlayerID, uint64(req.Seq), req.Placement); err != nil {
			return refusedAnswer(err)
		}
	default:
		if err := checkIdentity(req.PlayerID, uint64(req.Seq)); err != nil {
			return refusedAnswer(err)
		}
		if _, err := building.UniqueID(req.GX, req.GY); err != nil {
			return refusedAnswer(fmt.Errorf("%w: %w", ErrBuild, err))
		}
		found := false
		if lot, found = m.lotAnchoredAt(req.GX, req.GY); !found {
			return refusedAnswer(fmt.Errorf("%w: anchor (%d, %d)", ErrNoBuilding, req.GX, req.GY))
		}
		keys = lot.Chunks()
		if err := m.checkChunks(keys); err != nil {
			return refusedAnswer(err)
		}
	}
	ledger, err := m.cellLedgerFor(ctx, req.PlayerID)
	if err != nil {
		return answerOf(err, false)
	}
	site, err := m.siteFor(ctx, lot)
	if err != nil {
		return answerOf(err, false)
	}
	var result building.Result
	switch req.Op {
	case PartParams:
		result, err = m.buildingSender.MultiSync_BuildingParamsPart(ctx, site.ID(), ledger, req.Seq, slices.Clone(req.Params))
	default:
		ids, idErr := m.chunkIDs(ctx, keys)
		if idErr != nil {
			return answerOf(idErr, false)
		}
		if req.Op == PartPlace {
			result, err = m.buildingSender.MultiGroupSync_BuildingPlacePart(ctx, ids, site.ID(), ledger, req.Seq, req.Placement)
		} else {
			result, err = m.buildingSender.MultiGroupSync_BuildingRemovePart(ctx, ids, site.ID(), ledger, req.Seq)
		}
	}
	if err != nil {
		return answerOf(err, true)
	}
	answer := PartAnswer{Outcome: OutcomeApplied, Chunks: result.Chunks, Points: result.Points, LastSeq: result.LastSeq, Building: result.Building}
	if result.Duplicate {
		answer.Outcome, answer.Points = OutcomeDuplicate, 0
	}
	return answer
}

// cellLedgerFor 返回玩家在本格的账本的实体 ID，第一次用时建出（GetOrCreate：库里有就冷加载）。
func (m *Map) cellLedgerFor(ctx context.Context, playerID int64) (int64, error) {
	unique, err := terrain_cell_editor.UniqueID(playerID)
	if err != nil {
		return 0, fmt.Errorf("%w: %w", ErrBrush, err)
	}
	ledger, _, err := m.cellEditors.GetOrCreate(ctx, unique)
	if err != nil {
		return 0, fmt.Errorf("terrain: player %d cell ledger: %w", playerID, err)
	}
	return ledger.ID(), nil
}

// ---- 跨进程的拒绝原因 ----

// refusals 是可以跨进程传的拒绝原因（下标就是线上的码；0 是没有归类的失败，Base 答 ErrCellFailed）。只能在末尾追加。
var refusals = []error{
	nil, ErrDisabled, ErrBrush, ErrNotOwned, ErrUnloadable, ErrOccupied, ErrStale, ErrSeqAhead, ErrDenied,
	ErrBuildingsDisabled, ErrBuild, ErrBuildingConfig, ErrBuildingParams, ErrSlope, ErrUnderwater, ErrBuildingLimit,
	ErrNoBuilding, ErrLotMismatch,
}

// RefusalCode 是拒绝原因的线上码：refusals 里第一个 errors.Is 成立的下标；没有归类时 0。
func RefusalCode(err error) uint8 {
	for i, sentinel := range refusals {
		if sentinel != nil && errors.Is(err, sentinel) {
			return uint8(i)
		}
	}
	return 0
}

// RefusalErr 是线上码还原的拒绝原因（detail 是格那边的错误文本，只用于日志）：码 0 或未知码是 ErrCellFailed。
func RefusalErr(code uint8, detail string) error {
	if int(code) < len(refusals) && refusals[code] != nil {
		return fmt.Errorf("%w (cell: %s)", refusals[code], detail)
	}
	return fmt.Errorf("%w: %s", ErrCellFailed, detail)
}
