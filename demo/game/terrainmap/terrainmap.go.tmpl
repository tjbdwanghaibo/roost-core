// Package terrainmap 是格进程内的可编辑地形（可编辑地形方案 P1 的实体接入、P2 的编辑与同步）：原始地形包（gameplay/terrain
// 的 Pack）、本进程装入的块（terrain.View）与被改过的块的持久记录（TerrainChunk 实体，game/entities/terrain_chunk）之间的接线。
//
// 一个进程一张 Map，由 game 服务在 Init 里按 scene.terrain 打开、装入、发布（internal/service/<game>/terrain.go）；
// 不配 scene.terrain.pack 就没有 Map，其余功能不受影响。
//
// 装入（Load，启动阶段，做 I/O）：本进程负责的区域（Region.Load：分区场景里是本格外扩 Ghost 带，不分区是整张图）
// 里的每一块，有持久记录（Version ≥ 1）的用记录 SetOverlay，其余从包里 LoadBase。哪些块有记录：用 DataEngine 的
// Store 按 `_id ∈ 本区域候选块的实体 ID` 分批查（ID 由块坐标确定，候选集有界），不全表扫描。记录基于另一版原始
// 地形的块（原始地形换了版本）：本进程写的块丢弃改动（维护者 2026-11-08，见 Map.Load），邻格的块不装入。
//
// 玩家编辑（Brush，P2）：校验（笔刷参数、半径 / 块数 / 增量上限、频率、领地 / 权限钩子）→ 玩家的编辑账本与覆盖到的块
// （至多 4 块）第一次用的先 GetOrCreate → 一笔多实体 Nest 事务（handler TerrainBrush，目标 = 这些块 + 账本）：按
// （玩家, 编辑序号）判重（账本，game/entities/terrain_editor）、在锁内从当前数据算笔刷（gameplay/terrain 的
// Brush.Apply）、建筑占位钩子、逐块写（整字段守卫）、序号记进账本；提交被接受后才逐块装进视图并通知同步
// （afterCommit），回滚的事务不改变视图，也不留下序号。
//
// 内部写入口（Edit，P1）：一块一笔事务写一组采样点，运维命令与测试用。
//
// 查询（Height / Material / IsWater / Probe）委托视图：不取锁、只读内存，任何 goroutine（含 Nest short 池）可调。
package terrainmap

import (
	"cmp"
	"context"
	"errors"
	"fmt"
	"log/slog"
	"maps"
	"math"
	"slices"
	"sync"
	"sync/atomic"
	"time"

	coredata "github.com/tjbdwanghaibo/roost-core/framework/dataengine"
	"github.com/tjbdwanghaibo/roost-core/framework/nest"
	"github.com/tjbdwanghaibo/roost-core/gameplay/terrain"
	"github.com/tjbdwanghaibo/roost-core/infra/base/spatial"
	db "{{MODULE}}/db"
	terrain_cell_editor "{{MODULE}}/game/entities/terrain_cell_editor"
	terrain_chunk "{{MODULE}}/game/entities/terrain_chunk"
	terrain_editor "{{MODULE}}/game/entities/terrain_editor"
)

var (
	// ErrDisabled：本进程没有地形（没配 scene.terrain.pack）。
	ErrDisabled = errors.New("terrain: this process runs no terrain")
	// ErrNotOwned：块不归本进程写（不在本格里：邻格 Ghost 带里的块在这里只读，地图外或别的格的块根本没装）。
	ErrNotOwned = errors.New("terrain: chunk is not written by this process")
	// ErrUnloadable：块的持久记录装不进视图（基于另一版原始地形，或记录损坏），这一块不可查也不可改，等运维处理。
	// 同时满足 errors.Is(err, terrain.ErrNotLoaded)。
	ErrUnloadable = fmt.Errorf("terrain: chunk record could not be loaded: %w", terrain.ErrNotLoaded)
	// ErrBrush：笔刷参数不合法或超出玩家编辑的上限（Policy：半径、增量、块数），或玩家 ID / 编辑序号不在范围内（序号
	// 1～MaxInt64，玩家 ID 1～entity.UniqueIDMask）。同时满足
	// errors.Is(err, terrain.ErrInvalidBrush) 的是参数本身不合法，满足 terrain.ErrOutOfMap 的是中心在地图外。
	ErrBrush = errors.New("terrain: brush refused")
	// ErrRateLimited：玩家的改动点数配额不够这次编辑（Policy.EditPointsPerSecond），整笔拒绝、不部分执行。
	ErrRateLimited = errors.New("terrain: edit point quota used up")
	// ErrDenied：领地 / 权限规则（Rules.AllowEdit）拒绝。
	ErrDenied = errors.New("terrain: edit not allowed here")
	// ErrOccupied：编辑会改到建筑占着的点（Rules.Occupied）。
	ErrOccupied = errors.New("terrain: the edit touches ground a building stands on")
	// ErrStale：编辑序号低于玩家账本的窗口（LastSeq − 64 以下）：已无法确定它当时是否应用过，这次不执行、不写。
	// 错误值是 *SeqError（带 LastSeq）。
	ErrStale = errors.New("terrain: edit sequence is older than the ledger window")
	// ErrSeqAhead：编辑序号比玩家账本的 LastSeq 大出 terrain_editor.MaxSeqAhead 以上（客户端的计数器坏了）：不执行、
	// 不写。错误值是 *SeqError（带 LastSeq）。
	ErrSeqAhead = errors.New("terrain: edit sequence is too far ahead of the ledger")
)

// SeqError 是账本拒绝一个编辑序号（ErrStale 或 ErrSeqAhead）：LastSeq 是玩家账本此刻已应用的最大序号，客户端据此
// 续号（新编辑用 LastSeq + 1 起）。errors.Is 对 ErrStale / ErrSeqAhead 按 Verdict 成立。
type SeqError struct {
	PlayerID int64
	Seq      int64
	LastSeq  int64
	Verdict  terrain_editor.Verdict
}

func (e *SeqError) Error() string {
	return fmt.Sprintf("terrain: player %d edit sequence %d is %v (ledger last %d)", e.PlayerID, e.Seq, e.Verdict, e.LastSeq)
}

// Is 让 errors.Is(err, ErrStale) / errors.Is(err, ErrSeqAhead) 按判定成立。
func (e *SeqError) Is(target error) bool {
	return target == ErrStale && e.Verdict == terrain_editor.Stale || target == ErrSeqAhead && e.Verdict == terrain_editor.Ahead
}

// loadWorkers 是启动时并行 LoadBase 的 goroutine 数。实测 1w 地图装满一个格（2304 块）单线程约 120ms、8 路约 29ms
// （gameplay/terrain 证据目录）；不做成配置。
const loadWorkers = 8

// recordBatch 是一次 Store 查询带的候选实体 ID 个数（`_id $in` 的数组长度）。
const recordBatch = 256

// Region 是本进程在地图上的范围（世界坐标，半开矩形）。Own 是本进程写的块所在的区域（分区场景里是本格），
// 必须对齐块边界（原点与边长都是 terrain.ChunkSize 的整数倍：块不跨格）；Load 是要装入视图的区域（Own 外扩
// Ghost 带），不必对齐，与它相交的块都装。两者都会被裁到地图范围内。
type Region struct {
	Own  spatial.Rect
	Load spatial.Rect
}

// Chunks 是 TerrainChunk 的 lifecycle（生成的 *lifecycle.TerrainChunkLifecycle）。
type Chunks interface {
	GetOrCreate(ctx context.Context, uniqueID int64) (*terrain_chunk.TerrainChunk, bool, error)
}

// Editors 是玩家编辑账本的 lifecycle（生成的 *lifecycle.TerrainEditorLifecycle）。
type Editors interface {
	GetOrCreate(ctx context.Context, uniqueID int64) (*terrain_editor.TerrainEditor, bool, error)
}

// CellEditors 是分区场景里玩家在本格的编辑账本的 lifecycle（生成的 *lifecycle.TerrainCellEditorLifecycle，P5）。
type CellEditors interface {
	GetOrCreate(ctx context.Context, uniqueID int64) (*terrain_cell_editor.TerrainCellEditor, bool, error)
}

// Editor 是改块事务的 Sender（生成的 syncsender.TerrainEditSender：handler 文件 game/handler/terrain_edit.go 里的 handler）。
type Editor interface {
	Sync_TerrainEdit(ctx context.Context, id int64, edits []terrain_chunk.PointEdit) (int64, error)
	MultiGroupSync_TerrainBrush(ctx context.Context, targets []int64, editor int64, seq int64, brush terrain.Brush) (terrain_chunk.BrushResult, error)
	MultiGroupSync_TerrainBrushPart(ctx context.Context, targets []int64, editor int64, seq int64, brush terrain.Brush) (terrain_chunk.BrushResult, error)
	Sync_TerrainDiscard(ctx context.Context, id int64, staleRevision int64, currentRevision int64) (bool, error)
	Sync_TerrainEditSeq(ctx context.Context, editor int64) (int64, error)
	Sync_TerrainEditIssue(ctx context.Context, editor int64, seq int64) (terrain_editor.Issue, error)
}

// seqLedger 是事务里判重的编辑账本：不分区时是玩家的 TerrainEditor（判重与面向客户端的序号是同一份），分区场景的格上是
// 玩家在本格的 TerrainCellEditor（P5：判 Base 转发来的编辑，不判超前）。只在账本实体的 Nest 锁内调用。
type seqLedger interface {
	Check(seq int64) terrain_editor.Verdict
	Record(seq int64)
	LastSeq() int64
	PlayerID() int64
	Buildings() int64
	AddBuildings(delta int64)
}

// Policy 是玩家编辑的上限（方案 §4 / §8.1 初值）。不做成配置：它们与客户端的笔刷 UI 一起定，改了要让客户端知道；
// 测试与运维入口可以用 SetPolicy 换一份。
type Policy struct {
	// MaxRadius 是玩家笔刷的最大半径（世界单位）：1600（16m）。此时一次最多覆盖 4 块、单块最多约 800 点：改高度低于
	// 整字段守卫（terrain_chunk.HeightsGuard 1000），改材质超过 500 点时走材质守卫（MaterialsGuard）整字段写。
	MaxRadius int64
	// MaxChunks 是一次编辑最多覆盖的块数：4（一笔多块事务的目标组上限）。
	MaxChunks int
	// MaxStrength 是抬高 / 降低在中心处的最大增量（高度原始值，1 = 10cm）：50（5m）。
	MaxStrength uint16
	// Limits 是编辑后的高度范围：基岩 0（地图基准高度）、上限 16383（基准之上 1638.3m：低于 16384 时同步全量每点
	// 2 字节，方案 §2）。
	Limits terrain.Limits
	// EditPointsPerSecond 是每个玩家每秒的改动点数配额（令牌桶：每秒补这么多、最多攒这么多）：270。
	// 维护者 2026-11-08 选定，2026-11-09 落地。按事务前 View.BrushChanges 估算，高度、材质分别计点，
	// 至少 MinEditPoints；满桶允许一次透支。此前 300 点档的小笔刷热点超出 50KB/s 目标，270 的历史临时测量
	// 见方案 §17；不是任意人数/分布下的硬带宽上限。0 表示不限（测试与运维入口）。规则见 Brush 的“配额”。
	EditPointsPerSecond int
	// MinEditPoints 是每次编辑至少计的点数：20。没改到值的编辑（已到上限再抬高、刷成同一种材质）与重复请求也要开一笔
	// 事务、记序号；不设下限时它们不占配额，一个玩家每秒可以发任意多次。20 约等于一次块更新在线上的固定开销
	// （帧头、组件头与包头约 110～144 字节 ÷ 每点约 7.5 字节），稳态平均配额相当于每秒 13.5 次此类请求（初始桶另有突发额度）。
	MinEditPoints int
	// MaxBuildings 是每个玩家同时站着的建筑数上限（可编辑地形 P4）：16。按玩家编辑账本的建筑数在放置事务里判断；0 表示
	// 不限（测试与运维入口）。demo 取值，没有玩法实测。
	MaxBuildings int
}

// DefaultPolicy 是方案 §8.1 的初值（MaxStrength 与 Limits 方案没给数，见各字段说明）。
var DefaultPolicy = Policy{
	MaxRadius: 1600, MaxChunks: 4, MaxStrength: 50, Limits: terrain.Limits{Bedrock: 0, Ceiling: 16383},
	EditPointsPerSecond: 270, MinEditPoints: 20, MaxBuildings: 16,
}

// Rules 是业务给编辑的钩子（方案 §4“领地 / 权限规则由业务提供钩子”、“不能改有建筑占位的点”）。nil 表示都放行。
type Rules interface {
	// AllowEdit 是领地 / 权限：玩家能不能在这些块上用这个笔刷。在 Nest 之外、事务之前调用（可以读别的服务），返回
	// 非 nil 即拒绝，Brush 把它包成 ErrDenied。
	AllowEdit(ctx context.Context, playerID int64, brush terrain.Brush, chunks []terrain.ChunkKey) error
	// Occupied 是业务另外的占位（地形块上的建筑占地之外：例如任务道具、临时禁区），返回 true 的点不能改、不能放建筑、
	// 不能走。建筑本身的占位不经这里（块的 Lots，P4，见 building.go）。在改块事务里、块的锁内调用（Nest short 池），也被
	// 行走判定调用：只能读内存，不能阻塞、不能 I/O。
	Occupied(key terrain.ChunkKey, index int32) bool
}

// SampleEdit 是对一个世界采样点的改动：(GX, GY) 是 1m 采样网格上的坐标（世界坐标 = G × terrain.SampleSpacing），
// Height 是高度原始值（1 = 10cm），Material 是材质编号。
type SampleEdit struct {
	GX, GY   int64
	Height   uint16
	Material byte
}

// LoadStats 是一次 Load 的结果。
type LoadStats struct {
	// Chunks 是 Region.Load 里的块数（地图内）。
	Chunks int
	// Overlays 是用持久记录装入的块，Base 是从包装入的块。
	Overlays, Base int
	// Discarded 是持久记录基于另一版原始地形、本进程写这块、已丢弃改动并按原始块装入的块（维护者 2026-11-08）。
	Discarded int
	// StaleBase 是持久记录基于另一版原始地形、没有装入的块：邻格的块（不归本进程写，不越权丢弃），或丢弃失败的块。
	StaleBase int
	// Corrupt 是记录或原始块损坏、没有装入的块。
	Corrupt int
}

// Map 是本进程的地形。
//
// 锁与所有权：pack、view、meta、region、chunks、editors、editor 在 Open 之后不变；view 自己保证并发（查询无锁）。unloadable
// 由 mu 保护：Load 里写（启动阶段，发布之前），之后只有邻格的副本（ApplyReplica，P3）把 Ghost 带里的块从中移出。
// Map 拥有 pack：Close 关闭它。
type Map struct {
	pack    *terrain.Pack
	view    *terrain.View
	meta    terrain.Meta
	region  Region
	chunks  Chunks
	editors Editors
	editor  Editor

	mu sync.Mutex
	// unloadable 是装不进视图的块及原因（基于旧原始地形的记录、损坏的记录或原始块）。不自动丢弃或改写数据库里的
	// 记录：这些块查询返回 ErrNotLoaded、改块返回 ErrUnloadable，换版后的旧编辑怎么处理由维护者 / 产品决定。
	unloadable map[terrain.ChunkKey]error
	// commitFailures 是提交后装入视图失败的次数（正常不会发生：Apply 已校验形状与版本；发生即视图落后于数据库，
	// 直到重启重新装入）。
	commitFailures atomic.Int64

	// policy、rules 在 Install 之前设定（SetPolicy / SetRules），之后只读。
	policy Policy
	rules  Rules
	// quota 是每个玩家的改动点数配额（令牌桶，进程内存，与 scene_view 的限速同一做法：不持久、重启清零）。
	quota pointQuota
	// committed 是提交后的通知（地形同步把第一次改过的块登记为 subject）；nil 时不通知。见 SetCommitted。
	committed atomic.Pointer[func(*terrain_chunk.TerrainChunk)]

	// occupancy 是进程内给行走判定的建筑占位表（building.go）：Load 时按块记录建好，建筑事务提交后按修订号换新。
	occupancy occupancyTable
	// buildings、buildingSender 在 EnableBuildings 之后非 nil（只在不分区的普通场景）；Install 之前设定，之后只读。
	buildings      Buildings
	buildingSender BuildingSender
	// buildingCommitted 是建筑放置 / 拆除提交后的通知（建筑同步把站着的建筑登记为 subject、拆掉的撤出视野）；nil 时不通知。
	// 见 SetBuildingCommitted。
	buildingCommitted atomic.Pointer[func(BuildingCommit)]
	// reconciled 是启动对账核对通过的站着的建筑（ReconcileBuildings 写一次，之后只读）：建筑同步启动时按它登记 subject。
	reconciled []BuildingCommit

	// cellEditors 在 EnableCell 之后非 nil（分区场景里托管格的进程，P5）：本格执行 Base 转发来的编辑时用的账本。Install 之前
	// 设定，之后只读。
	cellEditors CellEditors
	// lotsCommitted 是块上的占地（Lots）提交并发布之后的通知（分区场景：把占位推给邻格的 Ghost 带，P5）；nil 时不通知。
	lotsCommitted atomic.Pointer[func(terrain.ChunkKey)]
}

// Open 打开原始地形包、建空视图。region 由 regionOf 按包的地图参数算出（调用方据此把分区格裁到地图里）。
func Open(path string, regionOf func(terrain.Meta) (Region, error), chunks Chunks, editors Editors, editor Editor) (*Map, error) {
	if regionOf == nil || chunks == nil || editors == nil || editor == nil {
		return nil, errors.New("terrain: region, chunk and editor lifecycles and edit sender are required")
	}
	pack, err := terrain.OpenPack(path)
	if err != nil {
		return nil, err
	}
	meta := pack.Meta()
	region, err := regionOf(meta)
	if err == nil {
		region, err = clipRegion(region, meta)
	}
	if err != nil {
		_ = pack.Close()
		return nil, err
	}
	return &Map{
		pack: pack, view: terrain.NewView(pack), meta: meta, region: region,
		chunks: chunks, editors: editors, editor: editor, unloadable: map[terrain.ChunkKey]error{},
		policy: DefaultPolicy, quota: pointQuota{now: time.Now}, occupancy: newOccupancyTable(meta),
	}, nil
}

// clipRegion 把区域裁到地图里，并检查 Own 对齐块边界。
func clipRegion(r Region, meta terrain.Meta) (Region, error) {
	own := spatial.NormalizeRect(r.Own)
	if !own.Empty() && (own.Min.X%terrain.ChunkSize != 0 || own.Min.Y%terrain.ChunkSize != 0 || own.Max.X%terrain.ChunkSize != 0 || own.Max.Y%terrain.ChunkSize != 0) {
		return Region{}, fmt.Errorf("terrain: the area this process writes %v is not aligned to chunks of %d: a chunk would straddle two cells", own, terrain.ChunkSize)
	}
	bounds := meta.Bounds()
	return Region{Own: intersect(own, bounds), Load: intersect(spatial.NormalizeRect(r.Load), bounds)}, nil
}

func intersect(a, b spatial.Rect) spatial.Rect {
	r := spatial.Rect{
		Min: spatial.Point{X: max(a.Min.X, b.Min.X), Y: max(a.Min.Y, b.Min.Y)},
		Max: spatial.Point{X: min(a.Max.X, b.Max.X), Y: min(a.Max.Y, b.Max.Y)},
	}
	if r.Empty() {
		return spatial.Rect{}
	}
	return r
}

// Meta 是地图参数（包头）。
func (m *Map) Meta() terrain.Meta { return m.meta }

// Region 是本进程写与装入的范围（已裁到地图里）。
func (m *Map) Region() Region { return m.region }

// View 是本进程的地形视图（只读用途：查询、取块数据）。写入只经 Load 与改块事务。
func (m *Map) View() *terrain.View { return m.view }

// Owns 报告块是否归本进程写（整块在 Region.Own 里）。
func (m *Map) Owns(key terrain.ChunkKey) bool {
	if !m.meta.Contains(key) {
		return false
	}
	b, own := key.Bounds(), m.region.Own
	return b.Min.X >= own.Min.X && b.Min.Y >= own.Min.Y && b.Max.X <= own.Max.X && b.Max.Y <= own.Max.Y
}

// Keys 是 Region.Load 里地图内的块（行优先）。
func (m *Map) Keys() []terrain.ChunkKey {
	var keys []terrain.ChunkKey
	for key := range terrain.ChunksIn(m.region.Load) {
		if m.meta.Contains(key) {
			keys = append(keys, key)
		}
	}
	return keys
}

// Unloadable 返回装不进视图的块及原因（副本）。
func (m *Map) Unloadable() map[terrain.ChunkKey]error {
	m.mu.Lock()
	defer m.mu.Unlock()
	return maps.Clone(m.unloadable)
}

func (m *Map) unloadableErr(key terrain.ChunkKey) error {
	m.mu.Lock()
	defer m.mu.Unlock()
	return m.unloadable[key]
}

func (m *Map) markUnloadable(key terrain.ChunkKey, cause error) {
	m.mu.Lock()
	m.unloadable[key] = cause
	m.mu.Unlock()
}

// ---- Ghost 带副本（可编辑地形方案 P3，D14）----
//
// 分区场景里 Region.Load 比 Region.Own 多出的一圈（Ghost 带）是邻格写的块：启动时按库里的记录装入（快照），之后由
// 写它的格进程推送（gameplay/terrain 的 Replicator，demo 的接线在 internal/service/<game>/terrain_partition.go）。这里
// 只是视图一侧的规则：版本只进不退，拥有者说“原始块”时按原始块装入，装入成功的块不再是 unloadable。

// GhostKeys 是 Region.Load 里不归本进程写的块（行优先）：分区场景里邻格的 Ghost 带，不分区时为空。
func (m *Map) GhostKeys() []terrain.ChunkKey {
	var keys []terrain.ChunkKey
	for _, key := range m.Keys() {
		if !m.Owns(key) {
			keys = append(keys, key)
		}
	}
	return keys
}

// ReplicaHeld 是 Ghost 带里一块在本进程视图里的版本（副本订阅时报给拥有者）：0 是原始块，≥ 1 是覆盖块，-1 是装不进
// 视图（启动时记录基于另一版原始地形、损坏）或没装着——拥有者据此把当前状态（含“原始块”）发来。
func (m *Map) ReplicaHeld(key terrain.ChunkKey) int64 {
	if m.unloadableErr(key) != nil {
		return -1
	}
	version, loaded := m.view.Version(key)
	if !loaded {
		return -1
	}
	return version
}

// ApplyReplica 把拥有者推来的一块的当前状态装进视图（只接受 Ghost 带里、不归本进程写的块）：o.Version ≥ 1 是覆盖块，
// 比视图里旧的答 terrain.ErrStaleOverlay；o.Version == 0 表示拥有者那里是原始块（从没改过，或原始地形换版后丢弃了改动，
// D13），视图里已有覆盖块时同样答 ErrStaleOverlay（同一原始地形版本内拥有者的版本不回退；换版前后的消息由
// Replicator 按 BaseRevision 丢弃），否则按原始块装入。装入成功后这块不再是 unloadable（例如启动时读到邻格还没丢弃的
// 旧记录，拥有者丢弃之后这里撤回到原始块）。调用方是 Replicator 的 goroutine：读包、解压在那里做。
func (m *Map) ApplyReplica(key terrain.ChunkKey, o terrain.Overlay) error {
	if !m.meta.Contains(key) || m.Owns(key) || intersect(m.region.Load, key.Bounds()).Empty() {
		return fmt.Errorf("%w: chunk %v is not in this process's ghost band", ErrNotOwned, key)
	}
	if o.Version >= 1 {
		if err := m.view.SetOverlay(key, o); err != nil {
			return err
		}
	} else {
		if version, loaded := m.view.Version(key); loaded && version >= 1 {
			return fmt.Errorf("%w: the owner says base, this view holds version %d", terrain.ErrStaleOverlay, version)
		}
		if err := m.view.LoadBase(key); err != nil {
			return err
		}
	}
	m.mu.Lock()
	delete(m.unloadable, key)
	m.mu.Unlock()
	return nil
}

// CommitFailures 是提交后装入视图失败的次数（见 Map.commitFailures）。
func (m *Map) CommitFailures() int64 { return m.commitFailures.Load() }

// Load 装入 Region.Load 里的全部块：有持久记录（Version ≥ 1）的用记录 SetOverlay，其余（没有记录、或记录是还没
// 提交过改动的空实体）从包里 LoadBase。只在启动阶段、发布之前调用一次：做 Mongo 读、文件 I/O 与 Nest 事务，不能在
// Nest 业务 worker 上调用。
//
// 记录基于另一版原始地形（BaseRevision 与包不同，原始地形换了版本）：
//   - 本进程写的块：丢弃改动（维护者 2026-11-08）——经正式写路径（GetOrCreate 冷加载 + handler TerrainDiscard 的
//     strict 事务）把记录重置为 Version 0 的空记录，然后按原始块装入、计入 Discarded、记 Warn。为什么是重置而不是
//     删档见 terrain_chunk.SurfaceComponent.Discard。丢弃失败时不装入、计入 StaleBase、记 Error：不用原始块盖住还在
//     库里的旧记录（否则查询与库不一致，下一次改动还会被 BaseRevision 校验拒绝）。
//   - 邻格 Ghost 带里的块（不归本进程写）：不越权丢弃，不装入、计入 StaleBase；它的格进程启动时会丢弃，本进程重启后
//     读到的是 Version 0 的记录、按原始块装入（P3 之前 Ghost 带只在启动时读一次快照）。
//
// 记录或原始块损坏的块不装入、计入 Corrupt。不装入的块之后查询返回 ErrNotLoaded、改块返回 ErrUnloadable。其余
// 错误（读库失败、读包 I/O 失败）返回错误，调用方不应发布这张 Map。
func (m *Map) Load(ctx context.Context, store coredata.Store) (LoadStats, error) {
	keys := m.Keys()
	stats := LoadStats{Chunks: len(keys)}
	records, err := ReadRecords(ctx, store, keys)
	if err != nil {
		return stats, err
	}
	var base []terrain.ChunkKey
	for _, key := range keys {
		record, ok := records[key]
		if ok && record.err == nil && len(record.lots) > 0 {
			// 建筑占地（P4）：不论这块有没有地形改动（Version 0 的记录也可以有占地），也不论下面是否丢弃地形改动（丢弃不动
			// 占地，换版后的建筑由 ReconcileBuildings 处置），按记录发布给行走判定。Ghost 带里邻格的块同样按库里已提交的
			// 记录装入（P5），之后由地形副本跟上（修订号只进不退）。
			m.occupancy.publish(key, record.lotRevision, record.lots)
		}
		switch {
		case !ok:
			base = append(base, key)
		case record.err != nil:
			m.markUnloadable(key, record.err)
			stats.Corrupt++
			slog.Error("terrain: chunk record is corrupt; the chunk is not loaded", "chunk", key.String(), "err", record.err)
		case !record.edited:
			base = append(base, key) // 空实体：建了、还没提交过改动
		default:
			err := m.view.SetOverlay(key, record.overlay)
			switch {
			case err == nil:
				stats.Overlays++
			case errors.Is(err, terrain.ErrBaseRevision) && m.Owns(key):
				// 原始地形换了版本：丢弃这块的改动（维护者 2026-11-08），成功后按原始块装入。
				if derr := m.discard(ctx, key, record.overlay.BaseRevision); derr != nil {
					m.markUnloadable(key, errors.Join(err, derr))
					stats.StaleBase++
					slog.Error("terrain: chunk record is based on another base revision and discarding its edits failed; the chunk is not loaded and its record is left as it is",
						"chunk", key.String(), "record_base_revision", record.overlay.BaseRevision, "pack_base_revision", m.meta.BaseRevision, "version", record.overlay.Version, "err", derr)
					continue
				}
				stats.Discarded++
				slog.Warn("terrain: chunk record was based on another base revision; its edits were discarded and the chunk is back to the base pack",
					"chunk", key.String(), "record_base_revision", record.overlay.BaseRevision, "pack_base_revision", m.meta.BaseRevision, "version", record.overlay.Version)
				base = append(base, key)
			case errors.Is(err, terrain.ErrBaseRevision):
				// 邻格的块：只有写它的格进程能丢弃（不越权写），这里不装入，直到它的格进程处理、本进程重启再读。
				m.markUnloadable(key, err)
				stats.StaleBase++
				slog.Error("terrain: a neighbouring cell's chunk record is based on another base revision; the chunk is not loaded until its cell discards the edits",
					"chunk", key.String(), "record_base_revision", record.overlay.BaseRevision, "pack_base_revision", m.meta.BaseRevision, "version", record.overlay.Version)
			default:
				m.markUnloadable(key, err)
				stats.Corrupt++
				slog.Error("terrain: chunk record does not fit the view; the chunk is not loaded", "chunk", key.String(), "err", err)
			}
		}
	}
	loaded, corrupt, err := m.loadBase(ctx, base)
	stats.Base, stats.Corrupt = loaded, stats.Corrupt+corrupt
	return stats, err
}

// loadBase 用 loadWorkers 个 goroutine 从包里装入 keys。坏块（ErrCorruptChunk）记入 unloadable 并跳过，别的错误
// 停止派发、等已开始的读完后返回第一个错误。
func (m *Map) loadBase(ctx context.Context, keys []terrain.ChunkKey) (loaded, corrupt int, err error) {
	var (
		next     atomic.Int64
		nLoaded  atomic.Int64
		nCorrupt atomic.Int64
		firstErr error
		errOnce  sync.Once
		failed   atomic.Bool
		workers  sync.WaitGroup
	)
	for range min(loadWorkers, len(keys)) {
		workers.Go(func() {
			for !failed.Load() {
				i := int(next.Add(1) - 1)
				if i >= len(keys) {
					return
				}
				if err := ctx.Err(); err != nil {
					errOnce.Do(func() { firstErr = err })
					failed.Store(true)
					return
				}
				key := keys[i]
				switch err := m.view.LoadBase(key); {
				case err == nil:
					nLoaded.Add(1)
				case errors.Is(err, terrain.ErrCorruptChunk):
					m.markUnloadable(key, err)
					nCorrupt.Add(1)
					slog.Error("terrain: base chunk is corrupt; the chunk is not loaded", "chunk", key.String(), "err", err)
				default:
					errOnce.Do(func() { firstErr = fmt.Errorf("terrain: load base chunk %v: %w", key, err) })
					failed.Store(true)
					return
				}
			}
		})
	}
	workers.Wait()
	return int(nLoaded.Load()), int(nCorrupt.Load()), firstErr
}

// Record 是一块的持久记录读出来的结果（ReadRecords）。
type Record struct {
	overlay terrain.Overlay
	edited  bool  // Version ≥ 1
	err     error // 记录解不开（schema 不符、损坏）
	// lots、lotRevision 是站在这块上的建筑占地（P4）。
	lots        []terrain_chunk.Lot
	lotRevision int64
}

// Lots 是记录里站在这块上的建筑占地。
func (r Record) Lots() []terrain_chunk.Lot { return r.lots }

// Overlay 是记录的数据；Edited 为 false（Version 0 的空实体）时为零值。
func (r Record) Overlay() (terrain.Overlay, bool) { return r.overlay, r.edited }

// Err 是这条记录解不开的原因；nil 表示可用。
func (r Record) Err() error { return r.err }

// ReadRecords 读 keys 里有持久记录的块：经 DataEngine 的 Store（与实体冷加载同一个读入口：逻辑库到物理库的映射、
// 墓碑过滤都在那里），每批 recordBatch 个候选实体 ID 一次 `_id $in` 查询，只返回存在的记录；没有记录的块不在结果里。
// 每条记录按生成 DAO 的 RestorePersisted 解码（只接受当前 schema）。单条记录解不开不影响别的记录，放进 Record.err；
// 读库本身失败返回错误。
//
// 调用时机：启动阶段 DataEngine 已排空历史 WAL（Runtime.Start 的恢复屏障），且一个 sid 只有一个进程、块只归本格
// 的进程写，所以库里就是这些块的最新已提交状态；邻格 Ghost 带的块读到的是读那一刻的快照（之后的变化由 P3 推送）。
func ReadRecords(ctx context.Context, store coredata.Store, keys []terrain.ChunkKey) (map[terrain.ChunkKey]Record, error) {
	if store == nil {
		return nil, coredata.ErrStoreRequired
	}
	proto := db.NewTerrainChunkDao()
	ids := make([]int64, 0, recordBatch)
	byID := make(map[int64]terrain.ChunkKey, len(keys))
	out := map[terrain.ChunkKey]Record{}
	flush := func() error {
		if len(ids) == 0 {
			return nil
		}
		docs, err := store.Load(ctx, coredata.LoadSpec{
			Database: proto.DbName(), Scope: coredata.ResolveDatabaseScope(proto), Resource: proto.CollName(),
			Filter: map[string]any{"_id": map[string]any{"$in": ids}}, BatchSize: 64,
		})
		if err != nil {
			return fmt.Errorf("terrain: read chunk records: %w", err)
		}
		for _, doc := range docs {
			key, ok := byID[doc.Key.ID]
			if !ok {
				return fmt.Errorf("terrain: store answered entity %d, which was not asked for", doc.Key.ID)
			}
			out[key] = decodeRecord(doc)
		}
		ids = ids[:0]
		return nil
	}
	for _, key := range keys {
		id, err := terrain_chunk.EntityID(key)
		if err != nil {
			return nil, err
		}
		byID[id] = key
		ids = append(ids, id)
		if len(ids) == recordBatch {
			if err := flush(); err != nil {
				return nil, err
			}
		}
	}
	if err := flush(); err != nil {
		return nil, err
	}
	return out, nil
}

func decodeRecord(doc coredata.RawDocument) Record {
	if doc.Enveloped {
		return Record{err: fmt.Errorf("terrain: entity %d record is a Remote envelope; TerrainChunk is not remote", doc.Key.ID)}
	}
	dao := db.NewTerrainChunkDao()
	dao.SetId(doc.Key.ID)
	if err := dao.RestorePersisted(doc.Data, doc.Schema, doc.Version); err != nil {
		return Record{err: fmt.Errorf("terrain: entity %d record: %w", doc.Key.ID, err)}
	}
	overlay, edited, err := terrain_chunk.OverlayOf(dao)
	if err != nil {
		return Record{err: fmt.Errorf("terrain: entity %d record: %w", doc.Key.ID, err)}
	}
	lots, err := terrain_chunk.LotsOf(dao)
	if err != nil {
		return Record{err: fmt.Errorf("terrain: entity %d record: %w", doc.Key.ID, err)}
	}
	return Record{overlay: overlay, edited: edited, lots: lots, lotRevision: dao.GetLotRevision()}
}

// Edit 是 P1 的内部写入口：把 edits 按块分组，每块一笔改块事务（块坐标升序），返回每块提交后的 Version。
//
// 每一块：检查归本进程写、记录可用 → lifecycle 的 GetOrCreate（第一次改这块时建出空实体：DataEngine 补一笔 strict
// 事务落库）→ 改块事务（handler TerrainEdit）。块之间不是原子的：中途失败时前面的块已经提交，返回已提交的部分与
// 错误（多块原子的玩家编辑见 Brush）。会等数据库与 WAL：只能在 Nest 业务 worker 之外调用（启动、运维命令、测试、I/O 池）。
func (m *Map) Edit(ctx context.Context, edits []SampleEdit) (map[terrain.ChunkKey]int64, error) {
	if m == nil {
		return nil, ErrDisabled
	}
	byChunk := map[terrain.ChunkKey][]terrain_chunk.PointEdit{}
	for _, edit := range edits {
		key, index := terrain.PointIndex(edit.GX*terrain.SampleSpacing, edit.GY*terrain.SampleSpacing)
		if !m.meta.Contains(key) {
			return nil, fmt.Errorf("%w: sample (%d, %d)", terrain.ErrOutOfMap, edit.GX, edit.GY)
		}
		if !m.Owns(key) {
			return nil, fmt.Errorf("%w: chunk %v (sample (%d, %d))", ErrNotOwned, key, edit.GX, edit.GY)
		}
		if cause := m.unloadableErr(key); cause != nil {
			return nil, fmt.Errorf("%w: chunk %v: %v", ErrUnloadable, key, cause)
		}
		byChunk[key] = append(byChunk[key], terrain_chunk.PointEdit{Index: int32(index), Height: edit.Height, Material: edit.Material})
	}
	keys := slices.SortedFunc(maps.Keys(byChunk), func(a, b terrain.ChunkKey) int {
		return cmp.Or(cmp.Compare(a.Y, b.Y), cmp.Compare(a.X, b.X))
	})
	versions := make(map[terrain.ChunkKey]int64, len(keys))
	for _, key := range keys {
		unique, err := terrain_chunk.UniqueID(key)
		if err != nil {
			return versions, err
		}
		chunk, _, err := m.chunks.GetOrCreate(ctx, unique)
		if err != nil {
			return versions, fmt.Errorf("terrain: chunk %v: %w", key, err)
		}
		version, err := m.editor.Sync_TerrainEdit(ctx, chunk.ID(), byChunk[key])
		if err != nil {
			return versions, fmt.Errorf("terrain: edit chunk %v: %w", key, err)
		}
		versions[key] = version
	}
	return versions, nil
}

// ApplyEdit 是改块 handler 的业务：在本块的 Nest 锁与 rollback=undo 事务内运行（handler TerrainEdit），只读内存，
// 可以在 short 池里执行。
//
// Version 0（第一次改这块）时从视图取原始块（必须装着、且是原始块）作初值。改动写进 DAO 后由 afterCommit 登记
// 提交后装视图：提交被接受才 SetOverlay 给视图；事务回滚（handler 之后的步骤失败、提交被拒）时回调不执行，视图不变。
func (m *Map) ApplyEdit(target terrain_chunk.ISurfaceEntity, edits []terrain_chunk.PointEdit) (int64, error) {
	surface := target.SurfaceComp()
	key := surface.Owner().Key()
	if !m.Owns(key) {
		return 0, fmt.Errorf("%w: chunk %v", ErrNotOwned, key)
	}
	if cause := m.unloadableErr(key); cause != nil {
		return 0, fmt.Errorf("%w: chunk %v: %v", ErrUnloadable, key, cause)
	}
	var base terrain.Chunk
	if surface.Version() == 0 {
		chunk, _, err := m.baseFor(surface)
		if err != nil {
			return 0, err
		}
		base = chunk
	}
	version, err := surface.Apply(m.meta.BaseRevision, base, edits)
	if err != nil {
		return 0, err
	}
	m.afterCommit(surface.Owner())
	return version, nil
}

// baseFor 是一块编辑前的数据：记录有数据（Version ≥ 1）时是记录，否则是视图里的原始块（必须装着、且是原始块）。
// 在块的锁内调用（handler），只读内存。
func (m *Map) baseFor(surface *terrain_chunk.SurfaceComponent) (data terrain.Chunk, fromRecord bool, err error) {
	key := surface.Owner().Key()
	if data, ok, err := surface.Data(); err != nil || ok {
		return data, ok, err
	}
	chunk, version, loaded := m.view.Chunk(key)
	if !loaded {
		return terrain.Chunk{}, false, fmt.Errorf("%w: chunk %v", terrain.ErrNotLoaded, key)
	}
	if version != 0 {
		// 视图里有覆盖块、实体却没有提交过改动：两边不一致，不能拿覆盖块当原始数据，也不能用原始数据覆盖它。
		return terrain.Chunk{}, false, fmt.Errorf("terrain: chunk %v: view holds overlay version %d but the entity has none", key, version)
	}
	return chunk, false, nil
}

// afterCommit 是改块事务“提交后装视图”的一步（P1 的 ApplyEdit 与 P2 的 ApplyBrush 共用）：在 handler 里、DAO 写完
// 之后调用，取这块新数据的副本，登记为提交后回调——提交被接受才 SetOverlay 给视图并通知同步（SetCommitted），事务
// 回滚（handler 之后的步骤失败、提交被拒）时回调不执行，视图与同步都不变。不在事务里时立即执行。
func (m *Map) afterCommit(chunk *terrain_chunk.TerrainChunk) {
	overlay, ok, err := chunk.SurfaceComp().Overlay()
	if err != nil {
		// Apply 写之前已校验记录的材质值域、写入口只接受 byte，这里不会失败；万一失败，视图保留旧数据（与 commit
		// 失败同样计数、记 Error，重启后按数据库重新装入）。
		m.commitFailures.Add(1)
		slog.Error("terrain: a committed chunk has data the view cannot take", "chunk", chunk.Key().String(), "err", err)
		return
	}
	if !ok {
		return // Version 0（丢弃后的空记录）：没有可覆盖的数据
	}
	key := chunk.Key()
	commit := func() {
		m.commit(key, overlay)
		if notify := m.committed.Load(); notify != nil {
			(*notify)(chunk)
		}
	}
	if !nest.AfterCommit(commit) {
		commit()
	}
}

// commit 把提交后的块装进视图。两笔改同一块的事务的提交后回调可能乱序到达：旧版本被视图拒绝（ErrStaleOverlay），
// 视图里已是更新的那份，忽略即可；别的错误说明视图与数据库不一致，记 Error 并计数（重启后按数据库重新装入）。
func (m *Map) commit(key terrain.ChunkKey, overlay terrain.Overlay) {
	err := m.view.SetOverlay(key, overlay)
	if err == nil || errors.Is(err, terrain.ErrStaleOverlay) {
		return
	}
	m.commitFailures.Add(1)
	slog.Error("terrain: a committed chunk could not be put into the view; queries see the previous data until a restart", "chunk", key.String(), "version", overlay.Version, "err", err)
}

// SetPolicy 换玩家编辑的上限（缺省 DefaultPolicy）。Install 之前调用。
func (m *Map) SetPolicy(p Policy) { m.policy = p }

// Policy 是当前的玩家编辑上限。
func (m *Map) Policy() Policy { return m.policy }

// SetRules 装上业务的领地 / 权限与建筑占位钩子（nil 表示都放行）。Install 之前调用。
func (m *Map) SetRules(r Rules) { m.rules = r }

// SetCommitted 登记改块提交后的通知（地形同步用它把改过的块登记为 subject）：在提交后回调里调用，参数是刚提交的块
// 实体；不得阻塞。nil 取消。
func (m *Map) SetCommitted(notify func(*terrain_chunk.TerrainChunk)) {
	if notify == nil {
		m.committed.Store(nil)
		return
	}
	m.committed.Store(&notify)
}

// EditedOwned 是本进程写的、视图里是覆盖块（被改过、Version ≥ 1）的块（行优先）。地形同步启动时把它们装成实体、
// 登记为 subject。
func (m *Map) EditedOwned() []terrain.ChunkKey {
	var keys []terrain.ChunkKey
	for _, key := range m.Keys() {
		if version, loaded := m.view.Version(key); loaded && version > 0 && m.Owns(key) {
			keys = append(keys, key)
		}
	}
	return keys
}

// discard 丢弃一块基于旧原始地形（staleRevision）的改动：冷加载实体（GetOrCreate：记录在库里，读出来）、一笔 strict
// 事务把记录重置为 Version 0（handler TerrainDiscard）。只在 Load 里、对本进程写的块调用（启动阶段，会等 Mongo 与 WAL）。
func (m *Map) discard(ctx context.Context, key terrain.ChunkKey, staleRevision int64) error {
	unique, err := terrain_chunk.UniqueID(key)
	if err != nil {
		return err
	}
	chunk, _, err := m.chunks.GetOrCreate(ctx, unique)
	if err != nil {
		return fmt.Errorf("terrain: load chunk %v to discard its edits: %w", key, err)
	}
	reset, err := m.editor.Sync_TerrainDiscard(ctx, chunk.ID(), staleRevision, m.meta.BaseRevision)
	if err != nil {
		return fmt.Errorf("terrain: discard chunk %v: %w", key, err)
	}
	if !reset {
		// 读记录之后它变了（一个 sid 一个进程、块只归本格写，正常不会发生）：不知道库里现在是什么，不按原始块装入。
		return fmt.Errorf("terrain: chunk %v: the record is no longer based on revision %d; not discarded", key, staleRevision)
	}
	return nil
}

// Brush 是玩家编辑的入口（协议 TerrainEdit 的端点调用）：校验 → 扣改动点数配额 → 权限 → 玩家的编辑账本与覆盖到的块
// 第一次用的先建实体 → 一笔多实体事务。返回本次锁住的每一块提交后的版本与账本的 LastSeq；已经应用过的（玩家, 序号）
// 返回 Duplicate，不再改一次。会等数据库与 WAL：只能在 Nest 业务 worker 之外调用（玩家端点、运维命令、测试）。
//
// 编辑身份与判重（T01/T02，方案 D18）：
//   - 一次编辑的身份是（玩家 ID, 编辑序号 seq），两者原样比较，不混合、不截断。seq 由客户端按玩家单调递增地取：新编辑
//     用上一次的序号 + 1（跳号可以），结果未知（超时、断线）时用同一个 seq 重发。客户端不知道上一次用到哪里时（会话开始、
//     重装、换设备）先用 LastSeq 查询，从 LastSeq + 1 开始。
//   - 判重在玩家的编辑账本（game/entities/terrain_editor）里、与改块同一笔事务：账本记已应用的最大序号 LastSeq 与它
//     下面 64 个序号的应用位图。seq > LastSeq 是新编辑；[LastSeq−64, LastSeq] 里应用过的答 Duplicate、没应用过的照常
//     执行（乱序到达）；更小的答 ErrStale（已无法确定当时是否应用过，宁可不做）；比 LastSeq 大出
//     terrain_editor.MaxSeqAhead 以上答 ErrSeqAhead。后两者是 *SeqError，带 LastSeq。
//   - 同一（玩家, 序号）至多执行一次，不依赖窗口外的记录还在：窗口只决定答 Duplicate 还是 ErrStale，不会让旧请求再执行。
//     账本持久、重启后原样读回；事务回滚时序号一起撤销（同一序号重试会执行）；拒绝的请求不记序号。
//
// 拒绝（全部在写任何东西之前，拒绝时零写入）：
//   - ErrDisabled：本进程没有地形；
//   - ErrBrush：玩家 ID 或序号不在范围内（序号 1～MaxInt64）、笔刷参数不合法（terrain.ErrInvalidBrush）、中心在地图外
//     （terrain.ErrOutOfMap）、超出 Policy（半径、增量、块数）；
//   - ErrNotOwned / ErrUnloadable：覆盖到的块不归本进程写（P2 单格；跨格转发是 P3）或装不进来；
//   - ErrRateLimited：改动点数配额不够（见下）；
//   - ErrDenied：Rules.AllowEdit 拒绝；
//   - ErrOccupied：改到建筑占位（事务里判断，整笔回滚）；
//   - ErrStale / ErrSeqAhead：序号在账本窗口之外（事务里判断，整笔回滚）。
//
// 配额（Policy.EditPointsPerSecond，维护者 2026-11-08 取代“每秒 2 次”；0 表示不限）：
//   - 点数：参数校验通过后，在视图当前数据上算这次会改变的高度点数 + 材质点数（View.BrushChanges：共享边上的点只算
//     一次，一个点两者都改算 2），至少 MinEditPoints。是锁外的估算：别人的编辑在估算与上锁之间提交了，实际改变的
//     点数可能不同，按估算计、不事后对账。
//   - 扣：桶里够这次的点数就扣；桶是满的也放行一次（透支，扣成负数），之后要等补回到满才能再透支、补到够才能做小编辑。
//     所以单次超过桶上限的编辑（玩家 r=16m 笔刷约 650～800 点、整平 / 地基这类大操作）照样可以做，只是做完要等：长期平均
//     仍是每秒 EditPointsPerSecond 点，一次最多多出一个编辑的量。不够时整笔拒绝（ErrRateLimited），不部分执行。
//   - 退：确定什么都没改时退回到 MinEditPoints（重复请求、AllowEdit 拒绝、建实体失败、事务里的拒绝如
//     ErrOccupied / ErrStale / ErrSeqAhead）——没有同步下行，只花了一次请求的开销，按最低点数计（重复请求也占配额，但重试一次大编辑不被扣
//     两遍）。提交失败、结果未知（WAL 超时等）不退：可能已经生效。
//   - 拒绝发生在扣之前的（参数、归属、配额本身）不计。
//
// 失败语义：GetOrCreate 成功、事务失败时，第一次改的块留下 Version 0 的空实体（P1 同样），装入时按原始块看待；第一次
// 编辑的玩家留下 LastSeq 0 的空账本。事务结果未知（WAL 超时等）时调用方用同一序号重试：已提交则得到 Duplicate，没提交
// 则这次生效（重试须在之后的新编辑把它挤出窗口之前，否则答 ErrStale——不会执行第二次，但也确认不了第一次）；刚做完
// 一次透支的大编辑时，重试要等配额补满（ErrRateLimited 之后退避再试）。
func (m *Map) Brush(ctx context.Context, playerID int64, seq uint64, brush terrain.Brush) (terrain_chunk.BrushResult, error) {
	if m == nil {
		return terrain_chunk.BrushResult{}, ErrDisabled
	}
	keys, err := m.checkBrush(playerID, seq, brush)
	if err != nil {
		return terrain_chunk.BrushResult{}, err
	}
	refund := func() {}
	if rate := m.policy.EditPointsPerSecond; rate > 0 {
		points, err := m.editPoints(brush)
		if err != nil {
			return terrain_chunk.BrushResult{}, err
		}
		if !m.quota.take(playerID, points, rate) {
			return terrain_chunk.BrushResult{}, fmt.Errorf("%w: player %d: the edit changes %d points", ErrRateLimited, playerID, points)
		}
		refund = func() { m.quota.refund(playerID, points-m.policy.MinEditPoints, rate) }
	}
	if m.rules != nil {
		if err := m.rules.AllowEdit(ctx, playerID, brush, keys); err != nil {
			refund()
			return terrain_chunk.BrushResult{}, fmt.Errorf("%w: %w", ErrDenied, err)
		}
	}
	ledger, err := m.ledgerFor(ctx, playerID)
	if err != nil {
		refund()
		return terrain_chunk.BrushResult{}, err
	}
	ids := make([]int64, 0, len(keys))
	for _, key := range keys {
		unique, err := terrain_chunk.UniqueID(key)
		if err != nil {
			refund()
			return terrain_chunk.BrushResult{}, err
		}
		chunk, _, err := m.chunks.GetOrCreate(ctx, unique)
		if err != nil {
			refund()
			return terrain_chunk.BrushResult{}, fmt.Errorf("terrain: chunk %v: %w", key, err)
		}
		ids = append(ids, chunk.ID())
	}
	result, err := m.editor.MultiGroupSync_TerrainBrush(ctx, ids, ledger, int64(seq), brush)
	if err != nil {
		if refusedBeforeWriting(err) {
			refund()
		}
		return terrain_chunk.BrushResult{}, fmt.Errorf("terrain: brush: %w", err)
	}
	if result.Duplicate {
		refund()
	}
	return result, nil
}

// editPoints 是一次编辑计入配额的点数：视图当前数据上会改变的高度点数 + 材质点数，至少 Policy.MinEditPoints。
func (m *Map) editPoints(brush terrain.Brush) (int, error) {
	heights, materials, err := m.view.BrushChanges(brush, m.policy.Limits)
	if err != nil {
		return 0, fmt.Errorf("terrain: count the points the brush changes: %w", err)
	}
	return max(heights+materials, m.policy.MinEditPoints), nil
}

// refusedBeforeWriting 报告事务的错误是不是 ApplyBrush 在第一次写之前的拒绝（整笔回滚，确定什么都没改）。
func refusedBeforeWriting(err error) bool {
	return errors.Is(err, ErrOccupied) || errors.Is(err, ErrBrush) || errors.Is(err, ErrNotOwned) || errors.Is(err, ErrUnloadable) ||
		errors.Is(err, ErrStale) || errors.Is(err, ErrSeqAhead) ||
		errors.Is(err, ErrBuild) || errors.Is(err, ErrSlope) || errors.Is(err, ErrUnderwater) || errors.Is(err, ErrBuildingLimit) ||
		errors.Is(err, ErrNoBuilding) || errors.Is(err, ErrDenied) || errors.Is(err, ErrLotMismatch)
}

// ledgerFor 返回玩家编辑账本的实体 ID，第一次用时建出（GetOrCreate：库里有就冷加载）。
func (m *Map) ledgerFor(ctx context.Context, playerID int64) (int64, error) {
	unique, err := terrain_editor.UniqueID(playerID)
	if err != nil {
		return 0, fmt.Errorf("%w: %w", ErrBrush, err)
	}
	ledger, _, err := m.editors.GetOrCreate(ctx, unique)
	if err != nil {
		return 0, fmt.Errorf("terrain: player %d edit ledger: %w", playerID, err)
	}
	return ledger.ID(), nil
}

// LastSeq 是玩家编辑账本已应用的最大序号（0 = 还没有编辑过）：客户端不知道上一次用到哪里时（会话开始、重装、换设备）
// 先查它，新编辑从 LastSeq + 1 开始（协议 TerrainEdit 的 Seq = 0）。一笔只读的锁内读取；计 MinEditPoints 点配额（与
// 重复请求同价，防止刷），配额不够答 ErrRateLimited。第一次查询的玩家建出空账本（GetOrCreate）。会等数据库：只能在
// Nest 业务 worker 之外调用。
func (m *Map) LastSeq(ctx context.Context, playerID int64) (int64, error) {
	if m == nil {
		return 0, ErrDisabled
	}
	if rate := m.policy.EditPointsPerSecond; rate > 0 && !m.quota.take(playerID, m.policy.MinEditPoints, rate) {
		return 0, fmt.Errorf("%w: player %d: asking for the last edit sequence", ErrRateLimited, playerID)
	}
	ledger, err := m.ledgerFor(ctx, playerID)
	if err != nil {
		return 0, err
	}
	last, err := m.editor.Sync_TerrainEditSeq(ctx, ledger)
	if err != nil {
		return 0, fmt.Errorf("terrain: player %d edit ledger: %w", playerID, err)
	}
	return last, nil
}

// checkBrush 是事务之前的校验（只读内存），返回覆盖到的块：参数与 Policy（checkBrushParams），覆盖到的块都归本进程写、
// 都装得进来。
func (m *Map) checkBrush(playerID int64, seq uint64, brush terrain.Brush) ([]terrain.ChunkKey, error) {
	keys, err := m.checkBrushParams(playerID, seq, brush)
	if err != nil {
		return nil, err
	}
	for _, key := range keys {
		if !m.Owns(key) {
			return nil, fmt.Errorf("%w: chunk %v", ErrNotOwned, key)
		}
		if cause := m.unloadableErr(key); cause != nil {
			return nil, fmt.Errorf("%w: chunk %v: %v", ErrUnloadable, key, cause)
		}
	}
	return keys, nil
}

// checkBrushParams 是不看块归属的那部分校验（分区场景的 Base 转发之前也查它，P5）：（玩家, 序号）的范围、笔刷参数、
// Policy 的半径 / 增量 / 块数，返回覆盖到的块。
func (m *Map) checkBrushParams(playerID int64, seq uint64, brush terrain.Brush) ([]terrain.ChunkKey, error) {
	p := m.policy
	if seq == 0 || seq > math.MaxInt64 {
		return nil, fmt.Errorf("%w: player %d edit sequence %d outside 1..%d", ErrBrush, playerID, seq, int64(math.MaxInt64))
	}
	if _, err := terrain_editor.UniqueID(playerID); err != nil {
		return nil, fmt.Errorf("%w: %w", ErrBrush, err)
	}
	if err := brush.Validate(m.meta, p.Limits); err != nil {
		return nil, fmt.Errorf("%w: %w", ErrBrush, err)
	}
	if brush.Radius > p.MaxRadius {
		return nil, fmt.Errorf("%w: radius %d over the limit %d", ErrBrush, brush.Radius, p.MaxRadius)
	}
	if (brush.Op == terrain.BrushRaise || brush.Op == terrain.BrushLower) && brush.Strength > p.MaxStrength {
		return nil, fmt.Errorf("%w: strength %d over the limit %d", ErrBrush, brush.Strength, p.MaxStrength)
	}
	keys := brush.Chunks(m.meta)
	if len(keys) == 0 {
		return nil, fmt.Errorf("%w: the brush covers no sample point", ErrBrush)
	}
	if len(keys) > p.MaxChunks {
		return nil, fmt.Errorf("%w: the brush covers %d chunks, at most %d", ErrBrush, len(keys), p.MaxChunks)
	}
	return keys, nil
}

// ApplyBrush 是 handler TerrainBrush 的业务：在目标组（笔刷覆盖到的块）与玩家编辑账本一起锁住（Nest 已排序全部取锁）
// 的 rollback=undo 事务里运行，只读内存、整数运算，可以在 short 池里执行（r=16m 四块约十几微秒，见方案 P2 实施结果）。
//
//  1. 判重：账本对 seq 答 Duplicate → 返回 Duplicate，什么都不写；答 Stale / Ahead → *SeqError（整笔回滚，什么都不写）。
//  2. 校验：每块归本进程写、可用；目标组正是笔刷覆盖到的块（防止调用方给错目标）。
//  3. 在锁内从当前数据算笔刷（Version 0 的块用视图里的原始块），建筑占位钩子查每个改动点。
//  4. 写：有改动的块 SurfaceComponent.Apply（整字段守卫、Version + 1），账本 Record(seq)（没有一块改到值也记：这次
//     编辑已经“执行过”，重放应答 Duplicate），提交后逐块装视图并通知同步（afterCommit）。
//
// 1～3 的拒绝在第一次写之前；4 之后不会失败。事务回滚（提交被拒）时块与账本都由 setter 的逆操作还原，提交后回调不执行。
func (m *Map) ApplyBrush(targets []terrain_chunk.ISurfaceEntity, editor terrain_editor.ILedgerEntity, seq int64, brush terrain.Brush) (terrain_chunk.BrushResult, error) {
	return m.applyBrush(targets, editor.LedgerComp(), seq, brush)
}

// ApplyBrushPart 是 handler TerrainBrushPart 的业务（分区场景的格执行 Base 转发来的笔刷，P5；名字沿用拆分设计，维护者
// 2026-11-10 撤回跨格笔刷之后格执行整笔）：同 ApplyBrush，账本是玩家在本格的 TerrainCellEditor，目标组同样是笔刷覆盖到的
// 全部块、都归本进程写。
func (m *Map) ApplyBrushPart(targets []terrain_chunk.ISurfaceEntity, editor terrain_cell_editor.ILedgerEntity, seq int64, brush terrain.Brush) (terrain_chunk.BrushResult, error) {
	return m.applyBrush(targets, editor.LedgerComp(), seq, brush)
}

// applyBrush 是 ApplyBrush / ApplyBrushPart 的共同部分（步骤见 ApplyBrush）。
func (m *Map) applyBrush(targets []terrain_chunk.ISurfaceEntity, ledger seqLedger, seq int64, brush terrain.Brush) (terrain_chunk.BrushResult, error) {
	if seq < 1 {
		return terrain_chunk.BrushResult{}, fmt.Errorf("%w: edit sequence %d", ErrBrush, seq)
	}
	surfaces := make([]*terrain_chunk.SurfaceComponent, len(targets))
	for i, target := range targets {
		surfaces[i] = target.SurfaceComp()
	}
	slices.SortFunc(surfaces, func(a, b *terrain_chunk.SurfaceComponent) int {
		ka, kb := a.Owner().Key(), b.Owner().Key()
		return cmp.Or(cmp.Compare(ka.Y, kb.Y), cmp.Compare(ka.X, kb.X))
	})
	versions := func() []terrain_chunk.ChunkVersion {
		out := make([]terrain_chunk.ChunkVersion, len(surfaces))
		for i, surface := range surfaces {
			out[i] = terrain_chunk.ChunkVersion{Key: surface.Owner().Key(), Version: surface.Version()}
		}
		return out
	}
	switch verdict := ledger.Check(seq); verdict {
	case terrain_editor.Duplicate:
		return terrain_chunk.BrushResult{Duplicate: true, Chunks: versions(), LastSeq: ledger.LastSeq()}, nil
	case terrain_editor.Stale, terrain_editor.Ahead:
		return terrain_chunk.BrushResult{}, &SeqError{PlayerID: ledger.PlayerID(), Seq: seq, LastSeq: ledger.LastSeq(), Verdict: verdict}
	}
	want := brush.Chunks(m.meta)
	if len(want) == 0 || len(want) != len(surfaces) {
		return terrain_chunk.BrushResult{}, fmt.Errorf("%w: the brush covers %d chunks, the transaction holds %d", ErrBrush, len(want), len(surfaces))
	}
	before := make(map[terrain.ChunkKey]terrain.Chunk, len(surfaces))
	fresh := make(map[terrain.ChunkKey]bool, len(surfaces))
	occupancy := make(map[terrain.ChunkKey]terrain_chunk.Occupancy, len(surfaces))
	for i, surface := range surfaces {
		key := surface.Owner().Key()
		if key != want[i] {
			return terrain_chunk.BrushResult{}, fmt.Errorf("%w: the transaction holds chunk %v, the brush covers %v", ErrBrush, key, want[i])
		}
		if !m.Owns(key) {
			return terrain_chunk.BrushResult{}, fmt.Errorf("%w: chunk %v", ErrNotOwned, key)
		}
		if cause := m.unloadableErr(key); cause != nil {
			return terrain_chunk.BrushResult{}, fmt.Errorf("%w: chunk %v: %v", ErrUnloadable, key, cause)
		}
		data, fromRecord, err := m.baseFor(surface)
		if err != nil {
			return terrain_chunk.BrushResult{}, err
		}
		if occupancy[key], err = surface.Occupancy(); err != nil {
			return terrain_chunk.BrushResult{}, err
		}
		before[key], fresh[key] = data, !fromRecord
	}
	changes, err := brush.Apply(m.meta, m.policy.Limits, before)
	if err != nil {
		return terrain_chunk.BrushResult{}, fmt.Errorf("%w: %w", ErrBrush, err)
	}
	byKey := make(map[terrain.ChunkKey][]terrain_chunk.PointEdit, len(changes))
	points := 0
	for _, change := range changes {
		edits := make([]terrain_chunk.PointEdit, len(change.Points))
		occupied := occupancy[change.Key]
		was := before[change.Key]
		for i, p := range change.Points {
			// 建筑占地在块的锁里读（块的 Lots，与放置同一把锁）；业务另外的占位经钩子。
			if occupied.Has(p.Index) || m.rules != nil && m.rules.Occupied(change.Key, p.Index) {
				return terrain_chunk.BrushResult{}, fmt.Errorf("%w: chunk %v point %d", ErrOccupied, change.Key, p.Index)
			}
			edits[i] = terrain_chunk.PointEdit{Index: p.Index, Height: p.Height, Material: p.Material}
			// 实际改动的点数（口径同配额：高度、材质各算一次）：分区场景的 Base 按它多退预扣的配额。
			if p.Height != was.Heights[p.Index] {
				points++
			}
			if p.Material != was.Materials[p.Index] {
				points++
			}
		}
		byKey[change.Key] = edits
	}
	// 校验完毕，开始写。
	for _, surface := range surfaces {
		key := surface.Owner().Key()
		if edits, ok := byKey[key]; ok {
			var base terrain.Chunk
			if fresh[key] {
				base = before[key]
			}
			if _, err := surface.Apply(m.meta.BaseRevision, base, edits); err != nil {
				// Apply 的校验与上面相同，这里不会失败；万一失败，返回错误让整笔事务回滚。
				return terrain_chunk.BrushResult{}, err
			}
			m.afterCommit(surface.Owner())
		}
	}
	ledger.Record(seq)
	return terrain_chunk.BrushResult{Chunks: versions(), LastSeq: ledger.LastSeq(), Points: points}, nil
}

// pointQuota 是每个玩家的改动点数令牌桶：每秒补 rate 个、最多攒 rate 个，满桶时可以透支一次（见 Brush 的“配额”）。
// 只在进程内存（与 scene_view 的主视野限速同一做法）：重启或玩家换进程后从满桶开始。
type pointQuota struct {
	now     func() time.Time
	mu      sync.Mutex
	buckets map[int64]bucket
}

// bucket 是一个玩家的桶：tokens 是 at 时刻的余额，透支后为负。
type bucket struct {
	tokens float64
	at     time.Time
}

// pointQuotaPrune 是桶表超过多少个时顺手清掉已经攒满的桶（满桶与没有桶等价）。
const pointQuotaPrune = 4096

// refill 返回补到 now 的桶（没有桶时是满桶）。调用方持有 mu。
func (q *pointQuota) refill(playerID int64, now time.Time, rate int) bucket {
	b, ok := q.buckets[playerID]
	if !ok {
		return bucket{tokens: float64(rate), at: now}
	}
	b.tokens = min(float64(rate), b.tokens+now.Sub(b.at).Seconds()*float64(rate))
	b.at = now
	return b
}

// take 扣 points 个点：余额够、或桶是满的（透支一次）就扣下并返回 true；否则不扣、返回 false。
func (q *pointQuota) take(playerID int64, points, rate int) bool {
	now := q.now()
	q.mu.Lock()
	defer q.mu.Unlock()
	if q.buckets == nil {
		q.buckets = map[int64]bucket{}
	}
	if len(q.buckets) > pointQuotaPrune {
		for id, b := range q.buckets {
			if b.tokens+now.Sub(b.at).Seconds()*float64(rate) >= float64(rate) {
				delete(q.buckets, id)
			}
		}
	}
	b := q.refill(playerID, now, rate)
	if b.tokens < float64(points) && b.tokens < float64(rate) {
		q.buckets[playerID] = b
		return false
	}
	b.tokens -= float64(points)
	q.buckets[playerID] = b
	return true
}

// refund 退回 points 个点（补完不超过上限）。points ≤ 0 时什么都不做。
func (q *pointQuota) refund(playerID int64, points, rate int) {
	if points <= 0 {
		return
	}
	now := q.now()
	q.mu.Lock()
	defer q.mu.Unlock()
	if _, ok := q.buckets[playerID]; !ok {
		return // 已被清掉：是满桶
	}
	b := q.refill(playerID, now, rate)
	b.tokens = min(float64(rate), b.tokens+float64(points))
	q.buckets[playerID] = b
}

// SetClock 换配额用的时钟（测试用）。Install 之前调用。
func (m *Map) SetClock(now func() time.Time) { m.quota.now = now }

// Walker 是本进程地形上的行走规则（可编辑地形方案 §22，P3 移动与寻路）：视图、首版规则 terrain.DefaultWalkRules，
// 占位钩子 = 建筑占位表（P4，提交后发布，见 building.go）或 Rules.Occupied（业务另外的占位）。Bounds 留空，由场景按
// 自己的世界范围填。查询只读视图与占位表、不取锁，可以在 Nest short 池里调用；SetRules 之后再取。
//
// 建筑放下之后，行走与寻路在占位表发布（提交后回调）之后才绕开它：WAL 落盘到回调执行之间的几毫秒里，已经在走的角色
// 可能还会走进刚放的占地（与地形改动的视图更新同一个窗口）。
func (m *Map) Walker() terrain.Walker {
	rules := m.rules
	return terrain.Walker{View: m.view, Rules: terrain.DefaultWalkRules, Occupied: func(key terrain.ChunkKey, index int32) bool {
		return m.occupancy.occupied(key, index) || rules != nil && rules.Occupied(key, index)
	}}
}

// Height / Material / IsWater / Probe 委托视图（算法与错误见 gameplay/terrain 的 View）。
func (m *Map) Height(x, y int64) (int32, error)         { return m.view.Height(x, y) }
func (m *Map) Material(x, y int64) (byte, error)        { return m.view.Material(x, y) }
func (m *Map) IsWater(x, y int64) (bool, error)         { return m.view.IsWater(x, y) }
func (m *Map) Probe(x, y int64) (terrain.Ground, error) { return m.view.Probe(x, y) }

// Close 撤下发布（若本 Map 是当前的）并关闭原始地形包。之后不能再装块；已装入的块仍可查询。
func (m *Map) Close() error {
	if m == nil {
		return nil
	}
	active.CompareAndSwap(m, nil)
	return m.pack.Close()
}

// active 是本进程当前的 Map，给改块 handler 用（handler 是包级函数，拿不到服务对象；与 game/partition 的 Node 同一做法）。
var active atomic.Pointer[Map]

// Install 发布本进程的 Map；Load 完成之后、服务开始接请求之前调用。
func Install(m *Map) { active.Store(m) }

// Active 返回本进程当前的 Map；没有地形时为 nil。
func Active() *Map { return active.Load() }
