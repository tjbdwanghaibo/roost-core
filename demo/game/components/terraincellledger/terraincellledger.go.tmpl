package terraincellledger

import (
	"{{MODULE}}/game/view"
	"fmt"

	"{{MODULE}}/game/components/terrainledger"
	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

// Owner 是 TerrainCellLedger 组件的宿主（TerrainCellEditor 的接线见 game/entities/terrain_cell_editor/ledger_component.go）：view 的 TerrainCellEditorEntity。
// 只在实体被 Nest 锁住期间使用。
type Owner = view.TerrainCellEditorEntity

// Component 是玩家在本格的编辑账本，数据全部在 TerrainCellEditorDao（回滚统一走 DAO 的生成 setter 逆操作）。判定用
// terrainledger.SeqWindow，唯一的差别是不答 Ahead（见 TerrainCellEditor 的说明）。方法只在本实体的 Nest 锁内调用。
type Component struct {
	entity.ComponentBase
	owner Owner
}

// NewComponent 是组件工厂；TerrainCellEditor 在 game/entities/terrain_cell_editor/ledger_component.go 登记它。
func NewComponent(value any, _ *entity.EntityCreateParam) (entity.ComponentInterfaceBase, error) {
	owner, ok := value.(Owner)
	if !ok {
		return nil, fmt.Errorf("terraincellledger component: owner %T does not implement terraincellledger.Owner", value)
	}
	return &Component{owner: owner}, nil
}

func (component *Component) Name() string { return "terrain_cell_editor_ledger" }

// Owner is available only while the Entity is alive and locked by Nest.
func (component *Component) Owner() Owner { return component.owner }

// Window 是账本当前的值。
func (component *Component) Window() terrainledger.SeqWindow {
	dao := component.owner.Dao()
	return terrainledger.SeqWindow{Last: dao.GetLastSeq(), Bits: uint64(dao.GetWindow())}
}

// PlayerID 是账本所属的玩家。
func (component *Component) PlayerID() int64 { return entity.GetUniqueIDFromEntityID(component.owner.ID()) }

// LastSeq 是本格已应用的最大序号（0 = 还没有）。
func (component *Component) LastSeq() int64 { return component.owner.Dao().GetLastSeq() }

// Check 判断序号 seq（须 ≥ 1），只读：同 SeqWindow.Check，但比 LastSeq 大多少都答 Fresh（超前由 Base 的账本判过）。
func (component *Component) Check(seq int64) terrainledger.Verdict {
	if verdict := component.Window().Check(seq); verdict != terrainledger.Ahead {
		return verdict
	}
	return terrainledger.Fresh
}

// Record 记下本格已应用的序号 seq（须是 Check 答 Fresh 的序号），在同一笔事务里调用，回滚时一起撤销。
func (component *Component) Record(seq int64) {
	next := component.Window().Record(seq)
	dao := component.owner.Dao()
	dao.SetLastSeq(next.Last)
	dao.SetWindow(int64(next.Bits))
}

// Buildings 是这个玩家站在本格里的建筑数。
func (component *Component) Buildings() int64 { return component.owner.Dao().GetBuildings() }

// AddBuildings 在放置（+1）/ 拆除（−1）的同一笔事务里改建筑数。
func (component *Component) AddBuildings(delta int64) {
	dao := component.owner.Dao()
	dao.SetBuildings(dao.GetBuildings() + delta)
}
