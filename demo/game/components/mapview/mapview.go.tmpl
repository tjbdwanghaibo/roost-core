	apperrors "{{MODULE}}/internal/errors"
)

// Owner 是 Map 组件的宿主（Player 的接线见 game/entities/player/map_component.go）：view 的 PlayerEntity，
// 加上把 DAO 的同步脏位交给订阅主体（PublishSyncDirty）与分区场景的 Base 接口（cellworld.BasePlayer：
// cell.base 心跳与属性面板更新把宿主交给 Node；实体一侧的实现在 game/entities/player/cell_base.go）。
// 只在实体被 Nest 锁住期间使用。
type Owner interface {
	view.PlayerEntity
	PublishSyncDirty()
	cellworld.BasePlayer
}

// Component 是 demo 的业务适配：位置字段、协议和 cellworld Base 留在这里，
// 实际移动、回滚和移动心跳由 actor 模块的同一份 Body 实现。它不再构造第二份 Move/MapBasic。
// 所有方法在 Player 的 Nest 锁内调用，返回错误必须交给 Nest，不能吞错提交半次移动。
type Component struct {
	entity.ComponentBase
	owner    Owner
	body     *actor.Body
	host     *heartbeat.Host // 与 Body 共用；cell.base 是独立业务注册，不推进普通移动。
	cellBase *heartbeat.Reg
}

// NewComponent 是组件工厂；Player 在 game/entities/player/map_component.go 登记它。
func NewComponent(value any, _ *entity.EntityCreateParam) (entity.ComponentInterfaceBase, error) {
	owner, ok := value.(Owner)
	if !ok {
		return nil, fmt.Errorf("mapview component: owner %T does not implement mapview.Owner", value)
	}
	return &Component{owner: owner}, nil
}

func (c *Component) Name() string      { return "map" }
func (c *Component) Owner() Owner    { return c.owner }
func (c *Component) Body() *actor.Body { return c.body }

func (c *Component) OnInitFinish(*entity.EntityCreateParam, bool) error {
	// demo 寻路最多访问4096节点，不能因共用默认256点预算而缩短既有有效路线。
	body, err := actor.New(c.owner, actor.Config{Fields: playerFields{c.owner}, Save: c.save, MaxPathPoints: 4096, Surface: actor.Surface})
	if err != nil {
		return err
	}
	c.body, c.host = body, body.Host
	if err := c.registerCellBase(); err != nil {
		body.Close()
		return err
	}
	return nil
}
func (c *Component) OnDestroy(entity.EntityDestroyReason) {
	if c.body != nil {
		c.body.Close()
	}
}
func (c *Component) Pos() spatial.Point      { return c.body.Position() }
func (c *Component) Facing() movement.Facing { return c.body.Map.Facing() }
func (c *Component) SceneID() int64          { return c.body.Map.SceneID() }
func (c *Component) InScene() bool           { return c.body.Map.InScene() }
func (c *Component) SavedPos() spatial.Point {
	d := c.owner.Dao()
	return spatial.Point{X: d.GetSavedPosX(), Y: d.GetSavedPosY()}
}
func (c *Component) SavedFacing() movement.Facing {
	return movement.Facing(c.owner.Dao().GetSavedFacing())
}

// EnterScene 仍接受 Scene 已验证的放置点；Space 是 demo bridge 的位移接线，
// SceneReady/Join/分区视图继续由 bridge 管理，不让共享 Body 再建第二个观察者入口。
func (c *Component) EnterScene(sceneID int64, space movement.Space, at spatial.Point) (spatial.Point, error) {
	if sceneID == 0 {
		return spatial.Point{}, errcode.Wrap(apperrors.ErrScenePosition, nil, "scene_id", sceneID)
	}
	if err := c.body.Enter(actor.Environment{ID: sceneID, Space: space, Ground: actor.Ground{}, Surface: actor.Surface(), Time: actor.WorldTime()}, at, c.SavedFacing()); err != nil {
		return spatial.Point{}, err
	}
	return c.Pos(), nil
}
func (c *Component) LeaveScene() error { return c.body.Leave() }

// Teleport 保留 demo 的可信瞬移规则，位置和停止当前移动现在一起随 Nest undo 回滚。
// ground 是场景的地面（handler 交 gamescene.Terrain；这里只用它判断能否站立，见 view.MapGround）。
func (c *Component) Teleport(ground view.MapGround, to spatial.Point) error {
	if ground == nil || !c.InScene() {
		return errcode.Wrap(apperrors.ErrScenePosition, nil, "reason", "no terrain or scene")
	}
	if !ground.Standable(to) {
		from := c.Pos()
		return errcode.Wrap(apperrors.ErrScenePosition, nil, "from_x", from.X, "from_y", from.Y, "to_x", to.X, "to_y", to.Y)
	}
	if err := c.body.Map.SetPos(to); err != nil {
		return err
	}
	c.body.Stop()
	return nil
}

// WalkTo / Follow 返回真实 movement 令牌。线上 ActionID 是本次移动的不透明编号，
// 0代表未启动；令牌不持久化。转换溢出返回错误，整个调用必须由 Nest 回滚。
func (c *Component) WalkTo(path []spatial.Point) (int64, error) {
	if !c.InScene() {
		return 0, errcode.Wrap(apperrors.ErrScenePosition, nil, "reason", "not in a scene")
	}
	if err := c.body.Walk(path, actor.PlayerSpeed); err != nil {
		return 0, err
	}
	return c.moveToken()
}
func (c *Component) Follow(target int64) (int64, error) {
	if !c.InScene() {
		return 0, errcode.Wrap(apperrors.ErrScenePosition, nil, "reason", "not in a scene")
	}
	if err := c.body.Follow(target, actor.PlayerSpeed, actor.FollowKeep); err != nil {
		return 0, err
	}
	return c.moveToken()
}
func (c *Component) moveToken() (int64, error) {
	token := c.body.Move.Token()
	if token > math.MaxInt64 {
		return 0, fmt.Errorf("map: movement token exceeds wire range")
	}
	return int64(token), nil
}
func (c *Component) Walking() bool { return c.body.Move.Moving() }
func (c *Component) save(sceneID int64, at spatial.Point, facing movement.Facing) error {
	d := c.owner.Dao()
	d.SetSavedSceneID(sceneID)
	d.SetSavedPosX(at.X)
	d.SetSavedPosY(at.Y)
	d.SetSavedFacing(int32(facing))
	return nil
}

// playerFields 保留 demo 的 DAO/公开视图字段词汇；Body 只通过 movement.Fields 写它们。
type playerFields struct{ owner Owner }

func (f playerFields) SceneID() int64     { return f.owner.Dao().GetSceneID() }
func (f playerFields) SetSceneID(v int64) { f.owner.Dao().SetSceneID(v); f.owner.PublishSyncDirty() }
func (f playerFields) Pos() spatial.Point {
	d := f.owner.Dao()
	return spatial.Point{X: d.GetPosX(), Y: d.GetPosY()}
}
func (f playerFields) SetPos(v spatial.Point) {
	d := f.owner.Dao()
	d.SetPosX(v.X)
	d.SetPosY(v.Y)
	f.owner.PublishSyncDirty()
}
func (f playerFields) Facing() movement.Facing { return movement.Facing(f.owner.Dao().GetFacing()) }
func (f playerFields) SetFacing(v movement.Facing) {
	f.owner.Dao().SetFacing(int32(v))
	f.owner.PublishSyncDirty()
}

