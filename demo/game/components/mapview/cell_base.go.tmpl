package mapview

import (
	"{{MODULE}}/game/modules/cellworldhost"

	"github.com/tjbdwanghaibo/roost-core/gameplay/heartbeat"
)

// 分区场景（scene.partition，gameplay/cellworld）里玩家不在进程间移动：本进程是它的 Base，它在地图上的那一份是所在格的
// SceneActor（cellworld 模块自带的实体）。Base 一侧的路由心跳（"cell.base"，Node.BaseBeat）挂在这个组件的心跳宿主上，
// 登记本身是模块的（cellworldhost.RegisterBaseBeat）；cellworld.BasePlayer 的实体方法在 game/entities/player/cell_base.go。

// registerCellBase registers the routing beat when this process runs a
// partitioned scene; it is started by the Node when the player enters it.
func (c *Component) registerCellBase() error {
	reg, err := cellworldhost.RegisterBaseBeat(c.host, c.owner)
	if err != nil {
		return err
	}
	c.cellBase = reg
	return nil
}

// 属性变化后 Cell 面板的更新不在这个组件上，监听 event.AttributeChanged 的是 Player 自己（game/entities/player/cell_base.go
// 的 OnAttributeChanged）：面板由 Player 的 CellPanel 算出，交给 Node 的也是 Player（cellworld.BasePlayer）。mapview 已按
// 组件包写法挂载（comp:"mapview.CompTypeMap"），组件上同样可以写 //roost:listen；迁移时只改结构，监听没有挪。

// CellBaseBeat 是 cell.base 心跳的登记（本进程不跑分区场景时为 nil）；Player 的 StartBase 用它。
func (c *Component) CellBaseBeat() *heartbeat.Reg { return c.cellBase }
