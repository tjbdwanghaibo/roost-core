package lifecycle

import (
	"context"
	"errors"
	"fmt"

	sceneentity "{{MODULE}}/game/entities/scene"
	gamescene "{{MODULE}}/game/scene"
	"github.com/tjbdwanghaibo/roost-core/framework/app"
	engine "github.com/tjbdwanghaibo/roost-core/framework/dataengine/engine"
	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/infra/base/spatial"
)

// WorldSceneUniqueID is the demo's one map. A game with many maps mints an id
// per map instead; nothing below assumes there is only one except this
// constant.
const WorldSceneUniqueID int64 = 1

// EnsureWorldScene creates or loads the scene this process runs, built on
// config (its map: WorldSceneConfig, or the editable terrain's map —
// gamescene.TerrainConfig). It is called once in the game service's Init,
// before anything can put a player on a map: a scene is built from
// configuration (`noPersist`), so "load" here means "build it again", and the
// id is what makes it the same scene to everyone who names it.
//
// It is the generated GetOrCreate with the map carried along: the generated
// lifecycle creates an Entity without a creation parameter, and a Scene's map
// is fixed when it is built (OnInitFinish reads gamescene.Config from the
// parameter). A scene that already exists on another map is an error, not a
// silent mismatch between the map the service believes in and the one the
// walks are checked against.
func EnsureWorldScene(ctx context.Context, registry *app.Registry, config gamescene.Config) (*sceneentity.Scene, error) {
	lifecycle, err := SceneFromRegistry(registry)
	if err != nil {
		return nil, err
	}
	return lifecycle.GetOrCreateOn(ctx, WorldSceneUniqueID, config)
}

// GetOrCreateOn is GetOrCreate building the scene on config (see
// EnsureWorldScene); an existing scene must already be on that map.
func (lifecycle *SceneLifecycle) GetOrCreateOn(ctx context.Context, uniqueID int64, config gamescene.Config) (*sceneentity.Scene, error) {
	value, err := lifecycle.Get(ctx, uniqueID)
	if errors.Is(err, engine.ErrEntityAggregateNotFound) || errors.Is(err, ErrSceneNotFound) {
		var created entity.IThreadSafeEntity
		created, err = lifecycle.access.Create(&entity.EntityCreateParam{
			IsCreate: true,
			UniqueID: uniqueID,
			Kind:     sceneentity.EntityKindScene,
			Category: entity.MustEntityCategoryOfKind(sceneentity.EntityKindScene),
			Param:    config,
		})
		if errors.Is(err, entity.ErrEntityExists) {
			value, err = lifecycle.Get(ctx, uniqueID)
		} else if err == nil {
			typed, ok := created.(*sceneentity.Scene)
			if !ok {
				return nil, fmt.Errorf("scene: created Entity has type %T", created)
			}
			value = typed
		}
	}
	if err != nil {
		return nil, fmt.Errorf("scene: ensure singleton: %w", err)
	}
	config = config.Normalize()
	want := spatial.Rect{Max: spatial.Point{X: config.Width, Y: config.Height}}
	terrain := value.Terrain()
	if terrain == nil {
		return nil, fmt.Errorf("scene: singleton %d is being destroyed", uniqueID)
	}
	if got := terrain.Bounds(); got != want {
		return nil, fmt.Errorf("scene: singleton %d already exists on the map %v, not %v", uniqueID, got, want)
	}
	return value, nil
}

// WorldSceneConfig is the map of a scene without editable terrain (and of a
// partitioned scene's Scene Entity): the default field. With a terrain map
// the ordinary scene is built on gamescene.TerrainConfig instead; the spawn
// point is the same on both.
func WorldSceneConfig() gamescene.Config { return gamescene.DefaultConfig() }
