// The guild endpoints. The guild is the alliance service's (game/guild): this
// process cannot write it — it has no Remote write runtime — so every write is
// an alliance RPC or a saga whose guild step is one, and every guild read is a
// mirror read of the alliance. Which guild the player is in is the player's
// own copy (PlayerDao.GuildID, persisted and synced): written in the player's
// transaction after their own join / leave / founding succeeded, by a
// membership notice while they are online, and at login checked against the
// guild's mirror — or, when it shows none, looked up from the alliance
// service (refreshGuild). What the endpoints still decide from it is the cheap part:
// a name that is invalid on its face, a request from a player shown in no
// guild. Those pre-checks are advisory and may be stale; the alliance service
// decides again on its roster, and its answer wins.
//
// Mirror reads are Monotonic: with no version they serve the cache within its
// staleness bound and load on a miss (a Cached read never loads, so a guild
// this process never saw would read as missing once the shared L2 entry
// expired); with GuildInfoRequest.MinVersion, the version a write answered
// with, they never show a state older than that write.

// HandleFoundGuild starts the found saga: the fee is debited, then the
// alliance service founds the guild, and a refusal refunds the fee. The answer
// is "accepted" with the saga key; GuildOpStatus reports the guild founded.
func (controller *Controller) HandleFoundGuild(context *playeraccess.Context, request *pb.FoundGuildRequest) (*pb.GuildResponse, error) {
	if context == nil || request == nil {
		return nil, fmt.Errorf("found_guild endpoint: context and request are required")
	}
	// The name rule is the service's own (alliancerule.ValidateName); a name
	// that is invalid on its face is refused before any coin moves.
	if err := alliancerule.ValidateName(request.Name); err != nil {
		return guildRefusal(context, "found_guild", err), nil
	}
	if shown, err := controller.shownGuild(context); err != nil {
		return guildRefusal(context, "found_guild", err), nil
	} else if shown != 0 {
		return guildRefusal(context, "found_guild", errcode.Wrap(apperrors.ErrAllianceMembership, nil, "alliance_id", shown)), nil
	}
	cost := controller.guildSettings.FoundCost
	return controller.startGuildOp(context, guild.OpFound, guild.State{Coins: cost, Name: request.Name, OpenJoin: request.OpenJoin}, cost)
}

// HandleJoinGuild joins an open guild: one alliance RPC to the instance that
// owns it (the generated client finds it through the route registration), with
// a request id from this frame, answered with the guild after the join.
func (controller *Controller) HandleJoinGuild(context *playeraccess.Context, request *pb.JoinGuildRequest) (*pb.GuildResponse, error) {
	if context == nil || request == nil {
		return nil, fmt.Errorf("join_guild endpoint: context and request are required")
	}
	target, err := rpcalliance.AllianceTarget(request.GuildID)
	if request.GuildID <= 0 || err != nil {
		return guildRefusal(context, "join_guild", errcode.Wrap(apperrors.ErrGuildMissing, err, "guild_id", request.GuildID)), nil
	}
	sid, err := controller.boundSID()
	if err != nil {
		return guildRefusal(context, "join_guild", err), nil
	}
	requestID := guild.RequestID("join", context.PlayerID, context.Session.Principal().SessionID, context.Seq)
	reply, err := controller.alliances.Join(context.Context(), requestID, context.PlayerID, sid, target)
	if err != nil {
		return guildRefusal(context, "join_guild", err), nil
	}
	controller.showGuild(context, reply.Alliance.AllianceID, 0)
	return guildReply(reply.Alliance, reply.ServedBySID), nil
}

// HandleLeaveGuild leaves the guild the player is shown in. A stale copy at
// worst names a guild the player already left: the service answers that from
// its roster.
func (controller *Controller) HandleLeaveGuild(context *playeraccess.Context, request *pb.LeaveGuildRequest) (*pb.GuildResponse, error) {
	if context == nil || request == nil {
		return nil, fmt.Errorf("leave_guild endpoint: context and request are required")
	}
	shown, err := controller.shownGuild(context)
	if err != nil {
		return guildRefusal(context, "leave_guild", err), nil
	}
	if shown == 0 {
		return guildRefusal(context, "leave_guild", errcode.Wrap(apperrors.ErrGuildMissing, nil, "player_id", context.PlayerID)), nil
	}
	target, err := rpcalliance.AllianceTarget(shown)
	if err != nil {
		return guildRefusal(context, "leave_guild", err), nil
	}
	sid, err := controller.boundSID()
	if err != nil {
		return guildRefusal(context, "leave_guild", err), nil
	}
	requestID := guild.RequestID("leave", context.PlayerID, context.Session.Principal().SessionID, context.Seq)
	reply, err := controller.alliances.Leave(context.Context(), requestID, context.PlayerID, sid, target)
	if err != nil {
		return guildRefusal(context, "leave_guild", err), nil
	}
	controller.showGuild(context, 0, shown)
	return guildReply(reply.Alliance, reply.ServedBySID), nil
}

// HandleGuildInfo reads a guild from its mirror: by id, or the one the player
// is shown in.
func (controller *Controller) HandleGuildInfo(context *playeraccess.Context, request *pb.GuildInfoRequest) (*pb.GuildResponse, error) {
	if context == nil || request == nil {
		return nil, fmt.Errorf("guild_info endpoint: context and request are required")
	}
	guildID := request.GuildID
	if guildID == 0 {
		shown, err := controller.shownGuild(context)
		if err != nil {
			return guildRefusal(context, "guild_info", err), nil
		}
		guildID = shown
	}
	view, err := controller.allianceMirror(context, guildID, request.MinVersion)
	if err != nil {
		return guildRefusal(context, "guild_info", err), nil
	}
	return guildReply(view, 0), nil
}

// HandleDonateGuild starts the donate saga: the coins are debited, then
// recorded in the guild's funds and the member's contribution; a refusal (no
// longer a member) refunds them.
func (controller *Controller) HandleDonateGuild(context *playeraccess.Context, request *pb.DonateGuildRequest) (*pb.GuildResponse, error) {
	if context == nil || request == nil {
		return nil, fmt.Errorf("donate_guild endpoint: context and request are required")
	}
	if request.Amount <= 0 {
		return guildRefusal(context, "donate_guild", errcode.Wrap(apperrors.ErrAllianceAmount, nil, "amount", request.Amount)), nil
	}
	shown, err := controller.shownGuild(context)
	if err != nil {
		return guildRefusal(context, "donate_guild", err), nil
	}
	if shown == 0 {
		return guildRefusal(context, "donate_guild", errcode.Wrap(apperrors.ErrGuildMissing, nil, "player_id", context.PlayerID)), nil
	}
	return controller.startGuildOp(context, guild.OpDonate, guild.State{Coins: request.Amount, AllianceID: shown}, request.Amount)
}

// HandleClaimGuildReward starts the reward saga: the alliance service marks
// this period's reward as claimed, then the game grants it; a full bag
// releases the claim.
func (controller *Controller) HandleClaimGuildReward(context *playeraccess.Context, request *pb.ClaimGuildRewardRequest) (*pb.GuildResponse, error) {
	if context == nil || request == nil {
		return nil, fmt.Errorf("claim_guild_reward endpoint: context and request are required")
	}
	shown, err := controller.shownGuild(context)
	if err != nil {
		return guildRefusal(context, "claim_guild_reward", err), nil
	}
	if shown == 0 {
		return guildRefusal(context, "claim_guild_reward", errcode.Wrap(apperrors.ErrGuildMissing, nil, "player_id", context.PlayerID)), nil
	}
	return controller.startGuildOp(context, guild.OpReward, guild.State{}, 0)
}

// HandleGuildOpStatus reports a guild saga by its key, for the player who
// started it.
func (controller *Controller) HandleGuildOpStatus(context *playeraccess.Context, request *pb.GuildOpStatusRequest) (*pb.GuildOpStatusResponse, error) {
	if context == nil || request == nil {
		return nil, fmt.Errorf("guild_op_status endpoint: context and request are required")
	}
	const unknown = "unknown"
	var sagaType string
	switch request.Op {
	case guild.OpFound:
		sagaType = alliancefound.Type
	case guild.OpDonate:
		sagaType = alliancedonate.Type
	case guild.OpReward:
		sagaType = alliancereward.Type
	default:
		return &pb.GuildOpStatusResponse{Status: unknown}, nil
	}
	engine, ok := app.Lookup[*saga.Engine](controller.registry, mods.ModSaga)
	if !ok || engine == nil {
		return nil, fmt.Errorf("guild_op_status endpoint: capability %q not found; the saga mod is not assembled", mods.ModSaga)
	}
	if request.SagaKey == "" {
		return &pb.GuildOpStatusResponse{Status: unknown}, nil
	}
	record, err := engine.GetByBusinessKey(context.Context(), sagaType, request.SagaKey)
	if err != nil {
		if errors.Is(err, saga.ErrNotFound) {
			return &pb.GuildOpStatusResponse{Status: unknown}, nil
		}
		code, reason := errcode.ClientError(err)
		slog.Error("guild_op_status: saga read failed", "player_id", context.PlayerID, "saga_key", request.SagaKey, "err", err)
		return &pb.GuildOpStatusResponse{Code: code, Reason: reason}, nil
	}
	// Someone else's key reads as unknown: a key is not a capability.
	state, err := guild.Decode(record.Data)
	if err != nil || state.PlayerID != context.PlayerID {
		return &pb.GuildOpStatusResponse{Status: unknown}, nil
	}
	if request.Op == guild.OpFound && record.Status == saga.StatusCompleted && state.AllianceID != 0 {
		// The founder's own copy, in case the founding's notice was lost: the
		// completed saga is the alliance service's answer. Idempotent.
		controller.showGuild(context, state.AllianceID, 0)
	}
	return &pb.GuildOpStatusResponse{Status: record.Status.String(), Step: int32(record.Step), LastError: record.LastError, GuildID: state.AllianceID}, nil
}

// startGuildOp starts a guild saga from inside the player's transaction
// (StartGuildOp: checks the coins, emits the start in the same WAL record).
func (controller *Controller) startGuildOp(context *playeraccess.Context, op string, state guild.State, coins int32) (*pb.GuildResponse, error) {
	endpoint := op + "_guild"
	sid, err := controller.boundSID()
	if err != nil {
		return guildRefusal(context, endpoint, err), nil
	}
	state.PlayerID, state.SID = context.PlayerID, sid
	data, err := guild.Encode(state)
	if err != nil {
		return nil, fmt.Errorf("%s endpoint: %w", endpoint, err)
	}
	playerID, err := entity.BuildEntityID(context.PlayerID, player.EntityKindPlayer)
	if err != nil {
		return nil, fmt.Errorf("%s endpoint: %w", endpoint, err)
	}
	key := guild.BusinessKey(op, context.PlayerID, context.Session.Principal().SessionID, context.Seq)
	started, err := syncsender.NewStartGuildOpSender(controller.NestClient()).Sync_StartGuildOp(context.Context(), playerID, op, data, coins, key)
	if err != nil {
		code, reason := errcode.ClientError(err)
		if code == errcode.CodeInternal {
			slog.Error(endpoint+" failed", "player_id", context.PlayerID, "err", err)
		}
		return &pb.GuildResponse{Code: code, Reason: reason}, nil
	}
	return &pb.GuildResponse{SagaKey: started}, nil
}

// shownGuild reads the guild the player is shown in (PlayerDao.GuildID),
// under the player's lock: the player's own copy of their membership, 0 for
// none. Advisory: the alliance service decides every guild write on its roster.
func (controller *Controller) shownGuild(context *playeraccess.Context) (int64, error) {
	playerID, err := entity.BuildEntityID(context.PlayerID, player.EntityKindPlayer)
	if err != nil {
		return 0, err
	}
	return syncsender.NewPlayerGuildSender(controller.NestClient()).Sync_PlayerGuild(context.Context(), playerID)
}

// allianceMirror reads a guild; minVersion > 0 asks for a state no older than
// that version (the player's own write).
func (controller *Controller) allianceMirror(context *playeraccess.Context, guildID int64, minVersion int64) (alliancerule.View, error) {
	if guildID <= 0 {
		return alliancerule.View{}, errcode.Wrap(apperrors.ErrGuildMissing, nil, "player_id", context.PlayerID)
	}
	target, err := rpcalliance.AllianceTarget(guildID)
	if err != nil {
		return alliancerule.View{}, errcode.Wrap(apperrors.ErrGuildMissing, err, "guild_id", guildID)
	}
	var after entity.RemoteObservation
	if minVersion > 0 {
		after.StateVersion = uint64(minVersion)
	}
	value, found, err := controller.allianceMirrors.Read(context.Context(), target, entity.RemoteReadMonotonic, after)
	if err != nil {
		return alliancerule.View{}, errcode.Wrap(apperrors.ErrGuildBusy, err, "guild_id", guildID)
	}
	if !found || !value.Value.Founded() {
		return alliancerule.View{}, errcode.Wrap(apperrors.ErrGuildMissing, nil, "guild_id", guildID)
	}
	return value.Value.View(guildID, int64(value.Observation.StateVersion)), nil
}

// showGuild updates the player's copy after their own join or leave (or a
// founding they asked the status of). Best effort: a copy left stale is
// corrected by a notice or checked at the next login.
func (controller *Controller) showGuild(context *playeraccess.Context, guildID int64, replaces int64) {
	playerID, err := entity.BuildEntityID(context.PlayerID, player.EntityKindPlayer)
	if err == nil {
		_, err = syncsender.NewShowGuildSender(controller.NestClient()).Sync_ShowGuild(context.Context(), playerID, guildID, replaces)
	}
	if err != nil {
		slog.Warn("guild: display not updated", "player_id", context.PlayerID, "guild_id", guildID, "err", err)
	}
}

// refreshGuild brings the player's copy in line with the alliance service at
// login, best effort (a failure leaves the copy as it is and is logged; the
// login goes on):
//
//   - the copy shows a guild: it is checked against that guild's mirror — a
//     guild that no longer exists, or whose roster no longer has the player
//     (a leave or kick whose notice the player missed while offline), is
//     hidden;
//   - the copy shows none: the alliance service is asked which guild the
//     player is in (lookupGuild) — a membership made while they were offline
//     (an approval; the notice found nobody online) is shown.
func (controller *Controller) refreshGuild(context *playeraccess.Context) {
	shown, err := controller.shownGuild(context)
	if err != nil {
		slog.Warn("enter_game: guild copy not read", "player_id", context.PlayerID, "err", err)
		return
	}
	if shown == 0 {
		controller.lookupGuild(context)
		return
	}
	target, err := rpcalliance.AllianceTarget(shown)
	if err != nil {
		controller.showGuild(context, 0, shown)
		return
	}
	value, found, err := controller.allianceMirrors.Read(context.Context(), target, entity.RemoteReadMonotonic, entity.RemoteObservation{})
	if err != nil {
		slog.Warn("enter_game: guild not checked against its mirror", "player_id", context.PlayerID, "guild_id", shown, "err", err)
		return
	}
	if _, member := value.Value.Members[context.PlayerID]; !found || !value.Value.Founded() || !member {
		controller.showGuild(context, 0, shown)
	}
}

// guildLookupTimeout bounds the login's question to the alliance service: a
// share of the login's dispatch budget, so an alliance service that does not
// answer delays the login by at most this and never fails it.
const guildLookupTimeout = time.Second

// lookupGuild asks the alliance service which guild the player is in
// (Membership on the player's guard: the roster's answer, the guard healed
// first if it is stale) and shows it. It runs in the login endpoint — the
// player access goroutine, not a Nest pool — and changes the copy in the
// player's own transaction (ShowGuild). A player who never had a guard is
// answered "entity not found": no guild, nothing to show. Any other failure
// is logged and leaves the copy at none; the next notice or login makes up
// for it.
func (controller *Controller) lookupGuild(context *playeraccess.Context) {
	target, err := rpcalliance.GuardTarget(context.PlayerID)
	if err != nil {
		return
	}
	ctx, cancel := stdcontext.WithTimeout(context.Context(), guildLookupTimeout)
	defer cancel()
	reply, err := controller.alliances.Membership(ctx, target)
	switch {
	case err == nil:
	case servicerpc.Classify(err) == servicerpc.OutcomeRejected:
		return // no guard: never in a guild
	default:
		slog.Warn("enter_game: guild not looked up; the copy stays at none until the next notice or login", "player_id", context.PlayerID, "err", err)
		return
	}
	if guildID := reply.State.AllianceID; guildID != 0 {
		controller.showGuild(context, guildID, 0)
	}
}

// boundSID is this process's sid: every player served here is bound to it
// (PlayerOwners), and it is the caller sid the alliance service records for
// membership notices and the sid the guild sagas' Player steps run on.
func (controller *Controller) boundSID() (int32, error) {
	owners, err := controller.PlayerOwners()
	if err != nil {
		return 0, err
	}
	return owners.SID(), nil
}

// guildRefusal is a refused guild request, coded for the client (guild.Answer).
func guildRefusal(context *playeraccess.Context, endpoint string, err error) *pb.GuildResponse {
	code, reason, internal := guild.Answer(err)
	if internal {
		slog.Warn(endpoint+": alliance service answer", "player_id", context.PlayerID, "code", code, "err", err)
	}
	return &pb.GuildResponse{Code: code, Reason: reason}
}

// guildReply is a guild on the wire.
func guildReply(view alliancerule.View, servedBy int32) *pb.GuildResponse {
	return &pb.GuildResponse{
		GuildID: view.AllianceID, Name: view.Name, Members: int32(len(view.Members)), ServedBySID: servedBy,
		LeaderID: view.LeaderID, Funds: view.Funds, Version: view.Version,
	}
}
