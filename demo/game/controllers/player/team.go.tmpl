// 分区场景的组队端点（维护者 2026-11-04 第 4 项 = A）：邀请 / 接受 / 离队 / 解散 / 查看。成员表在 Remote 托管的 Team
// 实体上，每个端点是一笔 [Team, Player] 事务（Team 的分布式锁 + Player 的本地锁，成员表与本人的副本同一笔提交）；端点只决定队伍 ID 从哪来（新队伍：
// 持久计数器，不能用进程内的运行期 ID）。普通场景的进程上它们答 scene_not_partitioned：普通场景的组队是匹配。
//
// 规则（原型缺省，scene.partition.team 声明、加载时校验）：一名玩家同时只在一支队伍里；只有队长能邀请与解散；邀请
// invite_ttl 后过期；成员数不超过 max_members。队友的位置 / HP 不从这里来：每名队员的 Base 把快照发给其他队员的
// Base，经队伍面板（组关系视野）推给客户端。

func (controller *Controller) HandleTeamInvite(context *playeraccess.Context, request *pb.TeamInviteRequest) (*pb.TeamResponse, error) {
	if context == nil || request == nil {
		return nil, fmt.Errorf("team_invite endpoint: context and request are required")
	}
	return controller.teamCall(context, "invite", func(ctx gocontext.Context, partition scenePartition, self int64) (team.Info, error) {
		maxMembers, ttl := partition.TeamRules()
		current, err := syncsender.NewPlayerTeamSender(controller.NestClient()).Sync_PlayerTeam(ctx, self)
		if err != nil {
			return team.Info{}, err
		}
		target := current
		if target == 0 {
			// 新队伍：先保留一个持久 ID、建出实体（远端实体要先在存储里才能被加锁加载），再由邀请那一笔事务建成。
			unique, err := controller.nextTeamID(ctx)
			if err != nil {
				return team.Info{}, err
			}
			teams, err := controller.Teams()
			if err != nil {
				return team.Info{}, err
			}
			created, err := teams.Create(ctx, unique)
			if err != nil {
				return team.Info{}, err
			}
			target = created.ID()
			if err := controller.shareTeam(ctx, target); err != nil {
				return team.Info{}, err
			}
		}
		return syncsender.NewTeamInviteSender(controller.NestClient()).MultiSync_TeamInvite(ctx, target, self,
			request.Invitee, controller.ServerSID(), maxMembers, int64(ttl.Seconds()))
	})
}

func (controller *Controller) HandleTeamAccept(context *playeraccess.Context, request *pb.TeamAcceptRequest) (*pb.TeamResponse, error) {
	if context == nil || request == nil {
		return nil, fmt.Errorf("team_accept endpoint: context and request are required")
	}
	return controller.teamCall(context, "accept", func(ctx gocontext.Context, partition scenePartition, self int64) (team.Info, error) {
		if !entity.MatchEntityID(request.TeamID, team.EntityKindTeam) {
			return team.Info{}, errcode.Wrap(apperrors.ErrTeamMissing, nil, "team_id", request.TeamID)
		}
		maxMembers, _ := partition.TeamRules()
		return syncsender.NewTeamAcceptSender(controller.NestClient()).MultiSync_TeamAccept(ctx, request.TeamID, self,
			controller.ServerSID(), maxMembers)
	})
}

func (controller *Controller) HandleTeamLeave(context *playeraccess.Context, request *pb.TeamLeaveRequest) (*pb.TeamResponse, error) {
	if context == nil || request == nil {
		return nil, fmt.Errorf("team_leave endpoint: context and request are required")
	}
	return controller.teamCall(context, "leave", func(ctx gocontext.Context, _ scenePartition, self int64) (team.Info, error) {
		current, err := controller.currentTeam(ctx, self)
		if err != nil {
			return team.Info{}, err
		}
		return syncsender.NewTeamLeaveSender(controller.NestClient()).MultiSync_TeamLeave(ctx, current, self)
	})
}

