// HandleTeamInfo 读自己所在队伍的成员表（同时刷新本 Base 的缓存：走的是重读那一笔 [Team, Player] 事务）。不在队伍里时
// 答空的队伍 ID。
func (controller *Controller) HandleTeamInfo(context *playeraccess.Context, request *pb.TeamInfoRequest) (*pb.TeamResponse, error) {
	if context == nil || request == nil {
		return nil, fmt.Errorf("team_info endpoint: context and request are required")
	}
	return controller.teamCall(context, "info", func(ctx gocontext.Context, _ scenePartition, self int64) (team.Info, error) {
		current, err := syncsender.NewPlayerTeamSender(controller.NestClient()).Sync_PlayerTeam(ctx, self)
		if err != nil || current == 0 {
			return team.Info{}, err
		}
		info, err := syncsender.NewTeamSyncSender(controller.NestClient()).MultiSync_TeamSync(ctx, current, self)
		if err != nil {
			return team.Info{}, err
		}
		if _, in := info.Seats[entity.GetUniqueIDFromEntityID(self)]; !in {
			return team.Info{}, nil
		}
		return info, nil
	})
}

// teamCall 是五个端点共同的外壳：普通场景答 scene_not_partitioned，拿不到队伍的分布式锁答 team_busy（可重试），其余
// 业务码原样回给客户端，内部错误记日志。
func (controller *Controller) teamCall(context *playeraccess.Context, stage string, call func(gocontext.Context, scenePartition, int64) (team.Info, error)) (*pb.TeamResponse, error) {
	partition := controller.Partition()
	if partition == nil {
		code, reason := errcode.ClientError(apperrors.ErrSceneNotPartitioned)
		return &pb.TeamResponse{Code: code, Reason: reason}, nil
	}
	self, err := entity.BuildEntityID(context.PlayerID, player.EntityKindPlayer)
	if err != nil {
		return nil, fmt.Errorf("team_%s endpoint: %w", stage, err)
	}
	info, err := call(context.Context(), partition, self)
	if err != nil {
		if errors.Is(err, corenest.ErrNestTimeout) {
			err = errcode.Wrap(apperrors.ErrTeamBusy, nil, "stage", stage)
		}
		code, reason := errcode.ClientError(err)
		if code == errcode.CodeInternal {
			slog.Error("team endpoint failed", "stage", stage, "player_id", context.PlayerID, "err", err)
		}
		return &pb.TeamResponse{Code: code, Reason: reason}, nil
	}
	return &pb.TeamResponse{TeamID: info.TeamID, Leader: info.Leader, Members: info.Members, Ver: info.Ver}, nil
}

// shareTeam 让新队伍可以从任何 Base 写：Remote 托管实体缺省由第一个写者独占，别的进程的写被 fence 拒绝
// （entity.ErrRemoteFenced）；队员在不同 Base 上都要改同一份成员表，所以建队的进程先认领、再切到共享模式（框架现有的
// ClaimRemoteOwnership / EnterRemoteSharedMode，与 SLG 联盟的用法相同），之后每一笔 [Team, Player] 事务都经分布式锁写。
// 共享模式下实体不能挂心跳，Team 没有心跳。失败时这个 ID 留下一个没建成的空实体（版本 0），玩家的副本没写，下一次邀请
// 换一个新 ID。
func (controller *Controller) shareTeam(ctx gocontext.Context, id int64) error {
	remote, ok := app.Lookup[entity.IRemoteEntityManager](controller.registry, mods.ModRemoteEntity)
	if !ok || remote == nil {
		return errors.New("team: the remote entity runtime is unavailable")
	}
	lease, err := remote.ClaimRemoteOwnership(ctx, id)
	if err != nil {
		return fmt.Errorf("team %d: claim: %w", id, err)
	}
	if !lease.Shared {
		if _, err := remote.EnterRemoteSharedMode(ctx, id); err != nil {
			return fmt.Errorf("team %d: enter shared mode: %w", id, err)
		}
	}
	return nil
}

// currentTeam 是玩家自己副本里的队伍 ID（本地锁）；不在队伍里答 team_missing。
func (controller *Controller) currentTeam(ctx gocontext.Context, self int64) (int64, error) {
	current, err := syncsender.NewPlayerTeamSender(controller.NestClient()).Sync_PlayerTeam(ctx, self)
	if err != nil {
		return 0, err
	}
	if current == 0 {
		return 0, errcode.Wrap(apperrors.ErrTeamMissing, nil, "player_id", entity.GetUniqueIDFromEntityID(self))
	}
	return current, nil
}

// Teams is the team lifecycle: creating the aggregate a new team's lock is taken on.
func (controller *Controller) Teams() (*lifecycle.TeamLifecycle, error) {
	if controller == nil || controller.teams == nil {
		return nil, errors.New("player controller: team lifecycle is unavailable")
	}
	return controller.teams, nil
}

// nextTeamID 保留一个持久的队伍号（Mongo 计数器 `$inc`）：同 sid 的下一个进程、别的 sid 的进程都不会再发出它。
func (controller *Controller) nextTeamID(ctx gocontext.Context) (int64, error) {
	if controller == nil || controller.teamIDs == nil {
		return 0, fmt.Errorf("team id allocator: persistent counter is unavailable")
	}
	var counter struct {
		Next int64 `bson:"next"`
	}
	err := controller.teamIDs.FindOneAndUpdate(ctx,
		bson.M{"_id": "team"},
		bson.M{"$inc": bson.M{"next": int64(1)}}, &counter,
		fmongo.FindOneAndUpdateOption{Upsert: true, ReturnAfter: true})
	if err != nil {
		return 0, fmt.Errorf("team id allocator: reserve: %w", err)
	}
	if counter.Next <= 0 || uint64(counter.Next) >= entity.StaticUniqueIDBase {
		return 0, fmt.Errorf("team id allocator: counter outside dynamic range: %d", counter.Next)
	}
	return counter.Next, nil
}
