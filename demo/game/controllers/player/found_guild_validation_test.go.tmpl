package player

import (
	"context"
	"errors"
	"testing"

	corenest "github.com/tjbdwanghaibo/roost-core/framework/nest"
	"github.com/tjbdwanghaibo/roost-core/infra/storage/mongo/mongotest"
	"go.mongodb.org/mongo-driver/v2/bson"
	playerentity "{{MODULE}}/game/entities/player"
	playeraccess "{{MODULE}}/game/playeraccess"
	"{{MODULE}}/protocol/pb"
)

type guildLookupStub struct {
	corenest.Client
	reads int
	err   error
}

func (client *guildLookupStub) Request(context.Context, corenest.HandlerName, int64, corenest.Params, ...corenest.SendOpt) (any, error) {
	client.reads++
	return int64(0), client.err
}

// 无效名称在保留 ID、创建持久公会前就必须拒绝，不能把失败请求变成数据库里的空壳。
func TestFoundGuildRejectsAnEmptyNameBeforeReadingOrReserving(t *testing.T) {
	playerentity.RegisterEntity()
	coll := mongotest.NewClient().Collection("test", "guild_ids")
	if err := coll.Seed(bson.M{"_id": "guild", "next": int64(7)}); err != nil {
		t.Fatal(err)
	}
	client := &guildLookupStub{}
	controller := &Controller{nestClient: client, guildIDs: coll}
	response, err := controller.HandleFoundGuild(&playeraccess.Context{PlayerID: 42}, &pb.FoundGuildRequest{})
	var counter struct {
		Next int64 `bson:"next"`
	}
	if readErr := coll.FindOne(context.Background(), bson.M{"_id": "guild"}, &counter); readErr != nil {
		t.Fatal(readErr)
	}
	if err != nil || response == nil || response.Code != 100016 || counter.Next != 7 || client.reads != 0 {
		t.Fatalf("invalid name reached dependencies: response=%+v err=%v next=%d reads=%d", response, err, counter.Next, client.reads)
	}
}

func TestFoundGuildWithANameStillReachesTheExistingGuildCheck(t *testing.T) {
	playerentity.RegisterEntity()
	client := &guildLookupStub{err: errors.New("existing-guild lookup unavailable")}
	controller := &Controller{nestClient: client}
	response, err := controller.HandleFoundGuild(&playeraccess.Context{PlayerID: 42}, &pb.FoundGuildRequest{Name: "valid"})
	if err != nil || response == nil || response.Code == 0 || response.Code == 100016 || client.reads != 1 {
		t.Fatalf("valid name did not reach the existing-guild check: response=%+v err=%v reads=%d", response, err, client.reads)
	}
}
