// allianceStub is the alliance service as the game endpoints see it: the
// generated client's interface. Methods a test does not set panic (the nil
// embedded interface), so an endpoint that calls something unexpected fails.
type allianceStub struct {
	rpcalliance.Alliance
	join      func(requestID string, callerID int64, callerSID int32, target int64) (rpcalliance.Reply, error)
	leave     func(requestID string, callerID int64, callerSID int32, target int64) (rpcalliance.Reply, error)
	joinCalls int
}

func (s *allianceStub) Join(_ context.Context, requestID string, callerID int64, callerSID int32, target int64) (rpcalliance.Reply, error) {
	s.joinCalls++
	return s.join(requestID, callerID, callerSID, target)
}

func (s *allianceStub) Leave(_ context.Context, requestID string, callerID int64, callerSID int32, target int64) (rpcalliance.Reply, error) {
	return s.leave(requestID, callerID, callerSID, target)
}

// mirrorStub serves fixed snapshots: entity id -> (payload, version).
type mirrorStub map[int64]struct {
	payload any
	version uint64
}

func (m mirrorStub) ReadSnapshot(_ context.Context, read entity.RemoteSnapshotRead) (entity.RemoteSnapshotEnvelope, bool, error) {
	entry, ok := m[read.Key.EntityID]
	if !ok {
		return entity.RemoteSnapshotEnvelope{}, false, nil
	}
	if read.After.StateVersion > entry.version {
		return entity.RemoteSnapshotEnvelope{}, false, fmt.Errorf("stale: %d < %d", entry.version, read.After.StateVersion)
	}
	raw, err := bson.Marshal(entry.payload)
	if err != nil {
		return entity.RemoteSnapshotEnvelope{}, false, err
	}
	schema := entity.RemoteSnapshotSchema(read.Key.Kind, read.Key.Scope)
	return entity.RemoteSnapshotEnvelope{
		Key: read.Key, StateVersion: entry.version, MarkerEpoch: 1, RouteEpoch: 1, Schema: schema, Codec: 1,
		Payload: entity.CopyFrozenRemoteSnapshotPayload(raw),
	}, true, nil
}

// guildController is a controller whose guild dependencies are stubs: the
// alliance RPC, both mirrors over one snapshot table, Nest recording calls.
func guildController(t *testing.T, alliances rpcalliance.Alliance, snapshots mirrorStub) (*Controller, *recordingNest) {
	t.Helper()
	playerentity.RegisterEntity()
	alliance.RegisterEntity()
	alliance_member.RegisterEntity()
	allianceMirrors, err := alliance.NewAllianceMirrorReader(snapshots)
	if err != nil {
		t.Fatal(err)
	}
	memberMirrors, err := alliance_member.NewAllianceMemberMirrorReader(snapshots)
	if err != nil {
		t.Fatal(err)
	}
	nest := &recordingNest{}
	controller := &Controller{
		registry: app.NewRegistry(viper.New()), nestClient: nest,
		alliances: alliances, allianceMirrors: allianceMirrors, memberMirrors: memberMirrors,
	}
	var published playerOwners = &sidOwners{}
	controller.owners.Store(&published)
	return controller, nest
}

func guildContext(seq uint32) *playeraccess.Context {
	return &playeraccess.Context{BaseCtx: context.Background(), Session: boundTo(1300), PlayerID: stuckPlayerID, MsgID: msgid.MsgJoinGuild, Seq: seq}
}

// A name that is invalid on its face is refused (alliance_name) before any
// coin moves or the service is asked: no Nest call, no mirror read, no RPC.
func TestFoundGuildRefusesAnInvalidNameBeforeAnythingMoves(t *testing.T) {
	controller, nest := guildController(t, &allianceStub{}, nil)
	for _, name := range []string{"", "   ", "\t\n", "guild\x00name", "guild\u0085name", "bad\xffbytes"} {
		response, err := controller.HandleFoundGuild(guildContext(1), &pb.FoundGuildRequest{Name: name})
		if err != nil || response == nil || response.Code != apperrors.ErrAllianceName.Code() || nest.handler != "" {
			t.Fatalf("name %q: response=%+v err=%v nest=%q", name, response, err, nest.handler)
		}
	}
}

// Founding is a saga, started from the player's transaction with the fee as
// the coins it checks; a player the mirror shows in a guild is refused first.
func TestFoundGuildStartsTheSagaWithTheFee(t *testing.T) {
	controller, nest := guildController(t, &allianceStub{}, mirrorStub{})
	guardID, _ := rpcalliance.GuardTarget(stuckPlayerID)
	controller.guildSettings.FoundCost = 100
	response, err := controller.HandleFoundGuild(guildContext(2), &pb.FoundGuildRequest{Name: "valid"})
	if err != nil || response.Code != 0 || response.SagaKey == "" {
		t.Fatalf("found_guild = %+v, %v", response, err)
	}
	if nest.handler != "handlerStartGuildOp" || len(nest.params) < 3 || nest.params[0] != "found" || nest.params[2] != int32(100) {
		t.Fatalf("found_guild called %q with %v, want handlerStartGuildOp(found, state, 100, key)", nest.handler, nest.params)
	}

	controller, nest = guildController(t, &allianceStub{}, mirrorStub{guardID: {payload: bson.M{"alliance_id": int64(7)}, version: 3}})
	response, err = controller.HandleFoundGuild(guildContext(3), &pb.FoundGuildRequest{Name: "valid"})
	if err != nil || response.Code != apperrors.ErrAllianceMembership.Code() || nest.handler != "" {
		t.Fatalf("found_guild by a member = %+v, %v (nest %q)", response, err, nest.handler)
	}
}

// Joining is one RPC to the service, with the frame's request id and this
// process's sid; the service's four answers reach the client as codes, and a
// success shows the guild on the player.
func TestJoinGuildGoesThroughTheAllianceRPC(t *testing.T) {
	alliance.RegisterEntity()
	target, _ := rpcalliance.AllianceTarget(7)
	for _, tc := range []struct {
		name string
		err  error
		code int32
	}{
		{"joined", nil, 0},
		{"full", apperrors.ErrAllianceFull, apperrors.ErrAllianceFull.Code()},
		{"nobody founded it", servicerpc.EntityNotFound(target), apperrors.ErrGuildMissing.Code()},
		{"no instance ready", fmt.Errorf("call: %w", fnats.ErrNoResponders), apperrors.ErrGuildBusy.Code()},
		{"being moved", servicerpc.Redirect(3001, errors.New("fenced")), apperrors.ErrGuildMoved.Code()},
		{"no answer in time", fmt.Errorf("call: %w", context.DeadlineExceeded), apperrors.ErrGuildPending.Code()},
	} {
		t.Run(tc.name, func(t *testing.T) {
			var gotRequest string
			var gotSID int32
			stub := &allianceStub{join: func(requestID string, callerID int64, callerSID int32, got int64) (rpcalliance.Reply, error) {
				if callerID != stuckPlayerID || got != target {
					t.Errorf("Join(caller %d, target %d), want (%d, %d)", callerID, got, stuckPlayerID, target)
				}
				gotRequest, gotSID = requestID, callerSID
				view := alliancerule.View{AllianceID: 7, Name: "seven", LeaderID: 1, Members: []alliancerule.MemberView{{PlayerID: 1}, {PlayerID: stuckPlayerID}}, Version: 5}
				return rpcalliance.Reply{Alliance: view, ServedBySID: 3001}, tc.err
			}}
			controller, nest := guildController(t, stub, nil)
			response, err := controller.HandleJoinGuild(guildContext(9), &pb.JoinGuildRequest{GuildID: 7})
			if err != nil || response.Code != tc.code {
				t.Fatalf("join_guild = %+v, %v; want code %d", response, err, tc.code)
			}
			if gotRequest == "" || gotSID != 1300 {
				t.Fatalf("Join request id %q from sid %d, want a request id from sid 1300", gotRequest, gotSID)
			}
			if tc.err != nil {
				if nest.handler != "" {
					t.Fatalf("a refused join changed the display: %q", nest.handler)
				}
				return
			}
			if response.GuildID != 7 || response.Members != 2 || response.ServedBySID != 3001 || response.Version != 5 {
				t.Fatalf("join answer = %+v", response)
			}
			if nest.handler != "handlerShowGuild" || nest.params[0] != int64(7) {
				t.Fatalf("display after a join: %q %v", nest.handler, nest.params)
			}
		})
	}
}

// Reading a guild reads its mirror: the player's own through the guard
// mirror; MinVersion makes the read refuse a state older than the write.
func TestGuildInfoReadsTheMirrors(t *testing.T) {
	alliance.RegisterEntity()
	alliance_member.RegisterEntity()
	guardID, _ := rpcalliance.GuardTarget(stuckPlayerID)
	allianceID, _ := rpcalliance.AllianceTarget(7)
	snapshots := mirrorStub{
		guardID:    {payload: bson.M{"alliance_id": int64(7)}, version: 2},
		allianceID: {payload: bson.M{"name": "seven", "leader_id": int64(1), "funds": int64(40), "members": bson.M{"1": bson.M{"role": int32(2)}, "4242": bson.M{"role": int32(1)}}}, version: 6},
	}
	controller, _ := guildController(t, &allianceStub{}, snapshots)
	response, err := controller.HandleGuildInfo(guildContext(4), &pb.GuildInfoRequest{})
	if err != nil || response.Code != 0 || response.GuildID != 7 || response.Name != "seven" || response.Members != 2 || response.Funds != 40 || response.Version != 6 {
		t.Fatalf("guild_info (mine) = %+v, %v", response, err)
	}
	if response, _ := controller.HandleGuildInfo(guildContext(5), &pb.GuildInfoRequest{GuildID: 7, MinVersion: 9}); response.Code != apperrors.ErrGuildBusy.Code() {
		t.Fatalf("guild_info older than the write = %+v, want guild_busy", response)
	}
	if response, _ := controller.HandleGuildInfo(guildContext(6), &pb.GuildInfoRequest{GuildID: 8}); response.Code != apperrors.ErrGuildMissing.Code() {
		t.Fatalf("guild_info of a guild nobody founded = %+v, want guild_missing", response)
	}
}
