// EnterGame is the demo's login, called by the enter domain's endpoint
// (game/controllers/enter/enter_game.go; the protocol and its domain are the
// enter module's). It makes sure the authenticated player has a Player Entity.
// A Nest handler addresses an Entity that exists; a first login has none, so
// this endpoint goes through the lifecycle instead of a Sender. GetOrCreate is
// safe to race: two logins of the same new player both end holding the one
// Entity, and only one of them sees Created.
func (controller *Controller) EnterGame(context *playeraccess.Context, request *pb.EnterGameRequest) (*pb.EnterGameResponse, error) {
	if context == nil || request == nil {
		return nil, fmt.Errorf("enter_game endpoint: context and request are required")
	}
	// 先校验绑定，再装载实体，因为装载正是被把关的那件事。玩家建角时由 account 绑定到一个 game sid
	// （Role.ServerID），之后不迁移；原服并入另一服（别名合服）后由承载服服务（Role.ServingServerID）。一个
	// Player 只能在承载他的 sid 上驻留，同一 sid 只有一个进程（App 单实例锁）。所以“这次登录该不该在这里
	// 服务”是一个静态判断：会话 Claims 里认证器从 account 取来的 server_id（承载服）是否等于本进程的 sid。
	//
	// 不是本服的登录按名拒绝（player_elsewhere，带 owner_sid），客户端改连那个服的网关，不要在本服重试。
	// Claims 里没有 server_id 说明认证器被换掉了、没有记下绑定：fail-closed，同样拒绝（owner_sid=0，
	// 客户端重新 SelectRole），并记 Error 日志，因为这是部署 / 代码问题，不是客户端连错了服。
	owners, ownersErr := controller.PlayerOwners()
	if ownersErr != nil {
		slog.Error("enter_game: ownership unavailable", "player_id", context.PlayerID, "err", ownersErr)
		code, reason := errcode.ClientError(ownersErr)
		return &pb.EnterGameResponse{Code: code, Reason: reason}, nil
	}
	boundSID, bound := BoundServerID(context.Session)
	if !bound {
		slog.Error("enter_game: the session carries no server_id claim; refusing the login (the authenticator must record the role's server)", "player_id", context.PlayerID)
		code, reason := errcode.ClientError(errcode.Wrap(apperrors.ErrPlayerElsewhere, nil, "player_id", context.PlayerID, "owner_sid", 0))
		return &pb.EnterGameResponse{Code: code, Reason: reason}, nil
	}
	// 换服（rehome 模块）的进入前检查，在把玩家接入服务、装载实体之前：他正在换服答 rehome_moving，已经绑定到
	// 别的服答 rehome_elsewhere（带他现在的服）。握手之后才换走的玩家，会话里的 server_id 仍是本服，上面的静态比较
	// 拦不住——检查读的是会话里的绑定代数与在途换服、本进程的迁出表（驻留表以 Residency 的名义发布的那一张），
	// 必要时问 account；换回本服的玩家也在这里撤掉旧的屏障。它是 enter 模块的登记点（game/enter 的 OnEntering，
	// rehome 与 enter 的联动登记），所以别的功能以后登记的检查同样在这里生效。
	if err := gameenter.RunEntering(context.Context(), controller.registry, gameenter.Entering{
		PlayerID: context.PlayerID, Claims: context.Session.Principal().Claims,
	}); err != nil {
		code, reason := errcode.ClientError(err)
		if code == errcode.CodeInternal {
			slog.Error("enter_game: a check before entering failed", "player_id", context.PlayerID, "err", err)
		}
		response := &pb.EnterGameResponse{Code: code, Reason: reason}
		if sid, known := gamerehome.OwnerSID(err); known {
			response.OwnerSID = sid
		}
		return response, nil
	}
	// Taking the player into service — waiting out an unload of their
	// previous copy, then the load — runs on its own budget, a share of this
	// request's dispatch deadline (player_access.tcp.login_timeout). A cold
	// load waits for this player's projections to reach the store; if the
	// store is down that wait does not end on its own, and it must not hold
	// the connection: the client gets login_timeout
	// and retries. What is left of the dispatch budget covers the answer and
	// the placement steps below.
	//
	// Running out of budget stops the WAITING, nothing else. A load another
	// login of the same player is sharing goes on for them; nothing admitted
	// is undone. EnterGame is safe to retry: GetOrCreate finds the Entity a
	// timed-out attempt may have created.
	loginCtx, cancelLogin := controller.loginContext(context.Context())
	defer cancelLogin()
	if err := owners.Serve(loginCtx, context.PlayerID, boundSID); err != nil {
		if answer, cutShort := loginCutShort(context.PlayerID, "serve", err); cutShort {
			return answer, nil
		}
		if errors.Is(err, apperrors.ErrPlayerElsewhere) {
			slog.Warn("enter_game: player is bound to another server", "player_id", context.PlayerID, "owner_sid", boundSID)
			code, reason := errcode.ClientError(err)
			return &pb.EnterGameResponse{Code:code, Reason:reason, OwnerSID:boundSID},nil
		} else if sid, moved := gamerehome.OwnerSID(err); moved {
			// 检查与接入之间他刚被换走（迁出表在建驻留记录的同一把锁下复核）。
			code, reason := errcode.ClientError(err)
			return &pb.EnterGameResponse{Code: code, Reason: reason, OwnerSID: sid}, nil
		} else {
			slog.Error("enter_game: player not taken into service", "player_id", context.PlayerID, "err", err)
		}
		code, reason := errcode.ClientError(err)
		return &pb.EnterGameResponse{Code: code, Reason: reason}, nil
	}
	subject, created, err := controller.Players().GetOrCreate(loginCtx, context.PlayerID)
	cancelLogin()
	if err != nil {
		if answer, cutShort := loginCutShort(context.PlayerID, "load", err); cutShort {
			return answer, nil
		}
		code, reason := errcode.ClientError(err)
		if code == errcode.CodeInternal {
			slog.Error("enter_game failed", "player_id", context.PlayerID, "err", err)
		}
		return &pb.EnterGameResponse{Code: code, Reason: reason}, nil
	}
	// The World counts the login in its own transaction: a different Entity,
	// a different lock, a separate Nest call after the Player one completed.
	// The enter module's first-time initialization (EnterInit), sent on every
	// login: "done or not" is a fact on the Player (PlayerDao.Enter), so a
	// Player created by a login that crashed before this point is initialized
	// by the next one, and a repeated login does nothing. The new player's
	// grants are written in game/entities/player/enter_first.go.
	entered, err := syncsender.NewEnterInitSender(controller.NestClient()).Sync_EnterInit(context.Context(), subject.ID())
	if err != nil {
		code, reason := errcode.ClientError(err)
		if code == errcode.CodeInternal {
			slog.Error("enter_game: first-time initialization failed", "player_id", context.PlayerID, "err", err)
		}
		return &pb.EnterGameResponse{Code: code, Reason: reason}, nil
	}
	if err := syncsender.NewRecordEnterSender(controller.NestClient()).Sync_RecordEnter(context.Context(), controller.WorldID()); err != nil {
		slog.Warn("enter_game: world did not record the login", "player_id", context.PlayerID, "err", err)
	}
	// On the map. The position is the player's own state, so it is written in
	// a transaction like everything else; the scene only answers "where can
	// this player stand".
	//
	// In a partitioned scene (scene.partition) this process is the player's
	// Base and the map is the cells': there is no local ground to stand on,
	// and Join enters the player through the cell its snapshot position is in.
	spawn := lifecycle.WorldSceneConfig().Spawn
	var at spatial.Point
	if controller.Partition() == nil {
		at, err = syncsender.NewEnterSceneSender(controller.NestClient()).MultiSync_EnterScene(context.Context(), subject.ID(), controller.WorldSceneID(), spawn.X, spawn.Y)
	}
	if err != nil {
		slog.Warn("enter_game: player not placed on the map", "player_id", context.PlayerID, "err", err)
	} else if scene, sceneErr := controller.Scene(); sceneErr != nil {
		slog.Warn("enter_game: no scene to join", "player_id", context.PlayerID, "err", sceneErr)
	} else if joinErr := scene.Join(context.Context(), subject, at); joinErr != nil {
		// Placed on the map but not replicated: the player can play, they
		// just do not see the others until the next login.
		slog.Warn("enter_game: player did not join the replicated scene", "player_id", context.PlayerID, "err", joinErr)
	}
	// The guild the player is shown in (PlayerDao.GuildID, the player's own
	// persisted copy) is brought in line with the alliance service at every
	// login, which makes up for membership notices the player missed while
	// offline (alliance_notice.go in the service package): a guild shown is
	// checked against its mirror (a leave or kick), and when none is shown
	// the alliance service is asked which guild the player is in (an
	// approval). Best effort, bounded (guildLookupTimeout) — the guild is the
	// alliance service's, and a failure leaves the copy as it is without
	// failing the login.
	controller.refreshGuild(context)
	// The enter module's hooks (game/enter): what other modules do when a
	// player enters, each written as that module's glue with the enter module
	// because both are installed. A failed hook is logged and does not fail the
	// login. The hooks get the session's claims (Entered.Claims) — the facts
	// the authenticator recorded from account — beside the first-enter time.
	//
	//   - chat (game/chat/chat_enter.go) puts the player in this process's
	//     online set, so from now on they receive world-channel pushes.
	//   - mailbox (game/controllers/mailbox/mailbox_enter.go) is the login half
	//     of mail.LazyBroadcast: server-wide mail (AudienceBroadcast) sent while
	//     this player was offline reaches the mailbox now. The mail service
	//     records the profile and merges every broadcast that is this player's
	//     exactly once; List and Summary top up from the same profile
	//     afterwards. The profile is the module's BroadcastProfileOnEnter, read
	//     from the claims: registered when the role was created
	//     (RoleCreatedAtClaim), in the scope of the serving server
	//     (ServerIDClaim — boundSID above, checked by Serve) and, for a role
	//     whose origin server was merged into this one, of the origin too
	//     (OriginServerIDClaim). Without LazyBroadcast configured
	//     (internal/service/mail/collaborators.go Broadcast()) it is a no-op.
	//     A game with guild-wide broadcasts adds mail.GuildScope(guild) in that
	//     function and pulls again when a membership notice says the player
	//     joined or left.
	gameenter.RunEntered(context.Context(), controller.registry, gameenter.Entered{
		PlayerID: context.PlayerID, InitResult: entered, Claims: context.Session.Principal().Claims,
	})
	// The login announcement stays the demo's own decision: the game says so on
	// the world channel through the chat module's privileged system path — a
	// client cannot publish there. The request id is the session and frame, so
	// a retried login frame is announced once.
	requestID := fmt.Sprintf("enter:%d:%s:%d", context.PlayerID, context.Session.Principal().SessionID, context.Seq)
	if err := controller.Chat().AnnounceWorld(context.Context(), fmt.Sprintf("player %d entered the world", context.PlayerID), requestID); err != nil {
		slog.Warn("enter_game: login not announced on the world channel", "player_id", context.PlayerID, "err", err)
	}
	return &pb.EnterGameResponse{PlayerID: context.PlayerID, Created: created, First: entered.First}, nil
}

// loginContext is the login step's share of the request: the configured
// login budget when the transport publishes one, otherwise the request's own
// deadline alone.
func (controller *Controller) loginContext(parent stdcontext.Context) (stdcontext.Context, stdcontext.CancelFunc) {
	if budget := controller.LoginTimeout(); budget > 0 {
		return stdcontext.WithTimeout(parent, budget)
	}
	return stdcontext.WithCancel(parent)
}

// loginCutShort answers a serve or load whose wait was cut short: the login
// budget ran out, or the connection closed under it (a newer login of the
// same session replaced it, and the answer goes nowhere). Both are named —
// login_timeout, retry — rather than reported as a server error, and logged
// as what they are, not in the error log. Any other failure is not its
// business.
func loginCutShort(playerID int64, step string, err error) (*pb.EnterGameResponse, bool) {
	switch {
	case errors.Is(err, stdcontext.DeadlineExceeded):
		slog.Warn("enter_game: login budget exhausted", "step", step, "player_id", playerID, "err", err)
	case errors.Is(err, stdcontext.Canceled):
		slog.Info("enter_game: login abandoned, its connection closed", "step", step, "player_id", playerID, "err", err)
	default:
		return nil, false
	}
	code, reason := errcode.ClientError(errcode.Wrap(apperrors.ErrLoginTimeout, err, "player_id", playerID))
	return &pb.EnterGameResponse{Code: code, Reason: reason}, true
}

// BoundServerID 读会话里 account 给出的承载服：认证器（internal/access/player/tcp/auth.go 的
// newPrincipal）以 svcaccount.ServerIDClaim 为键写进 Principal.Claims 的 Role.ServingServerID。没有合服时
// 它就是角色建角时绑定的原服；原服并入本服（别名合服）之后，原服的角色在这里读到的是本服，登录照常通过，
// 比较逻辑不变。原服另在 svcaccount.OriginServerIDClaim，路由与驻留不读它。没有会话、没有这个 claim、
// 或值不是正整数都回答 false，由调用方 fail-closed。
//
// 导出是为了让认证器那一侧的测试（tcp/auth_test.go）用登录端点真正使用的读取函数核对自己写的
// Principal：认证器归应用所有、可以被改写，两边对不上时登录会一律 fail-closed。
func BoundServerID(session gateway.Session) (int32, bool) {
	if session == nil {
		return 0, false
	}
	raw, ok := session.Principal().Claims[svcaccount.ServerIDClaim]
	if !ok {
		return 0, false
	}
	sid, err := strconv.ParseInt(raw, 10, 32)
	if err != nil || sid <= 0 {
		return 0, false
	}
	return int32(sid), true
}
