package controllers

import (
	"errors"
	"fmt"
	"log/slog"

	playeraccess "github.com/tjbdwanghaibo/roost-core/infra/network/playeraccess"
	apperrors "{{MODULE}}/internal/errors"
	"{{MODULE}}/protocol/pb"
	"github.com/tjbdwanghaibo/roost-core/gameplay/cellworld"
	"github.com/tjbdwanghaibo/roost-core/infra/base/errcode"
)

// HandleAttackTarget confirms only the Base's admission (or the original admission on replay).
// An AttackResult push, not this response, is evidence about settlement on the Cell.
func (controller *Controller) HandleAttackTarget(context *playeraccess.Context, request *pb.AttackTargetRequest) (*pb.AttackTargetResponse, error) {
	if context == nil || request == nil {
		return nil, fmt.Errorf("attack_target endpoint: context and request are required")
	}
	partition := controller.Partition()
	if partition == nil {
		code, reason := errcode.ClientError(apperrors.ErrSceneNotPartitioned)
		return &pb.AttackTargetResponse{Code: code, Reason: reason}, nil
	}
	hit, err := partition.AttackConnection(context.Context(), context.PlayerID, context.Session, request.Target, request.RequestID)
	if err != nil {
		switch {
		case errors.Is(err, cellworld.ErrNotInWorld):
			err = apperrors.ErrPartitionNotEntered
		case errors.Is(err, cellworld.ErrAttackRequestInvalid):
			err = apperrors.ErrAttackRequestInvalid
		case errors.Is(err, cellworld.ErrAttackRequestExpired):
			err = apperrors.ErrAttackRequestExpired
		case errors.Is(err, cellworld.ErrAttackRequestConflict):
			err = apperrors.ErrAttackRequestConflict
		}
		code, reason := errcode.ClientError(partitionSessionError(err))
		if code == errcode.CodeInternal {
			slog.Error("attack_target failed", "player_id", context.PlayerID, "target", request.Target, "err", err)
		}
		return &pb.AttackTargetResponse{Code: code, Reason: reason}, nil
	}
	return &pb.AttackTargetResponse{Seq: hit.Seq, AttackID: hit.ID}, nil
}
