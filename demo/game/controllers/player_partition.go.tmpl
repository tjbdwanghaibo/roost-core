package controllers

import (
	"context"
	"errors"

	"github.com/tjbdwanghaibo/roost-core/infra/network/gateway"
	apperrors "{{MODULE}}/internal/errors"

	"{{MODULE}}/game/terrainmap"

	"github.com/tjbdwanghaibo/roost-core/framework/app"
	"github.com/tjbdwanghaibo/roost-core/gameplay/cellworld"
)

// scenePartition is the slice of the game service's partitioned scene
// (scene.partition, internal/service/<game>/partition.go) the endpoints use.
// It is published only on a process whose scene is partitioned, so its
// absence is how an endpoint knows the scene is an ordinary one.
type scenePartition interface {
	// MoveIntent forwards a velocity to the cell that owns the player now.
	MoveConnection(ctx context.Context, playerID int64, session gateway.Session, vx, vy int64) error
	// AttackTarget admits one attack or returns the receipt for an already admitted request.
	AttackConnection(ctx context.Context, playerID int64, session gateway.Session, target, requestID int64) (cellworld.HitID, error)
	// TerrainForwarder is how the player's terrain edits and building operations
	// reach the cells that write their chunks (editable terrain P5); nil
	// without terrain.
	TerrainForwarder() terrainmap.Forwarder
}

// Keep transport supersession distinct from a missing route or an internal failure.
func partitionSessionError(err error) error {
	if errors.Is(err, cellworld.ErrStaleSession) {
		return apperrors.ErrPartitionStaleSession
	}
	return err
}

// partitionCapability is what the game service publishes its partitioned
// scene under.
const partitionCapability app.ModName = "{{GAME_SERVICE}}.scene.partition"

// Partition is this process's partitioned scene, or nil when its scene is an
// ordinary one.
func (controller *Controller) Partition() scenePartition {
	if controller == nil || controller.registry == nil {
		return nil
	}
	partition, ok := app.Lookup[scenePartition](controller.registry, partitionCapability)
	if !ok || partition == nil {
		return nil
	}
	return partition
}

// terrainForwarder is the partitioned scene's forwarder for terrain edits, or
// nil on an ordinary scene (the edit runs on this process, terrainmap.Map.Brush).
func (controller *Controller) terrainForwarder() terrainmap.Forwarder {
	if partition := controller.Partition(); partition != nil {
		return partition.TerrainForwarder()
	}
	return nil
}
