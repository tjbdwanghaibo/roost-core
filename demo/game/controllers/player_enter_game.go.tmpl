// EnterGame 只适配 demo 的协议和宿主资源。会话选路、进入前检查、进场与通知的顺序归 enter 模块。
func (controller *Controller) EnterGame(context *playeraccess.Context, request *pb.EnterGameRequest) (*pb.EnterGameResponse, error) {
	if context == nil || request == nil {
		return nil, fmt.Errorf("enter_game endpoint: context and request are required")
	}
	owners, boundSID, refusal := controller.boundHere(context, "enter_game")
	if refusal != nil {
		return &pb.EnterGameResponse{Code: refusal.code, Reason: refusal.reason, OwnerSID: refusal.ownerSID}, nil
	}
	a := demoEnterAttempt{controller: controller, owners: owners, playerID: context.PlayerID, boundSID: boundSID}
	entered, err := gamelogin.EnterSessionWithPlacement(context.Context(), controller.registry, gamelogin.Entering{PlayerID: a.playerID, Claims: context.Session.Principal().Claims}, gamelogin.Loads{LoadOrCreate: a.loadOrCreate, Existing: a.existing}, a.place)
	if err != nil {
		code, reason := errcode.ClientError(err)
		if code == errcode.CodeInternal {
			slog.ErrorContext(context.Context(), "enter_game failed", "player_id", a.playerID, "err", err)
		}
		sid := a.ownerHint
		if sid == 0 {
			sid, _ = gamerehome.OwnerSID(err)
		}
		return &pb.EnterGameResponse{Code: code, Reason: reason, OwnerSID: sid}, nil
	}
	// 公告在模块所有进入后钩子返回之后投递，由合并器批量发，不占登录预算等待发送。
	if announcer, ok := controller.LoginAnnouncer(); ok {
		announcer.Entered(a.playerID)
	} else {
		slog.Debug("enter_game: no login announcer is running; the login is not announced", "player_id", a.playerID)
	}
	slog.InfoContext(context.Context(), "enter: player entered", "player_id", a.playerID, "first", entered.First, "created", a.created, "server_id", boundSID)
	return &pb.EnterGameResponse{PlayerID: a.playerID, Created: a.created, First: entered.First}, nil
}

// 每次请求一份，不能在 Controller 上缓存：subject 给进场步骤，Created 与 OwnerSID 只用于 demo 的旧回包。
type demoEnterAttempt struct {
	controller          *Controller
	owners              playerOwners
	playerID            int64
	boundSID, ownerHint int32
	subject             *player.Player
	created             bool
}

// 只有 Serve 和冷加载共享 login_timeout。返回时及时释放它，初始化、进场和模块钩子继续使用原请求 ctx。
func (a *demoEnterAttempt) serveAndLoad(ctx stdcontext.Context, load func(stdcontext.Context) (*player.Player, error)) error {
	loginCtx, cancel := a.controller.loginContext(ctx)
	defer cancel()
	if err := a.owners.Serve(loginCtx, a.playerID, a.boundSID); err != nil {
		if timeout, cut := loginTimeout(a.playerID, "serve", err); cut {
			return timeout
		}
		if errors.Is(err, apperrors.ErrPlayerElsewhere) {
			a.ownerHint = a.boundSID
		}
		return err
	}
	var err error
	a.subject, err = load(loginCtx)
	if err != nil {
		failure, _ := loginTimeout(a.playerID, "load", err)
		return failure
	}
	return nil
}

func (a *demoEnterAttempt) loadOrCreate(ctx stdcontext.Context) (gamelogin.InitResult, error) {
	err := a.serveAndLoad(ctx, func(loginCtx stdcontext.Context) (*player.Player, error) {
		subject, created, err := a.controller.Players().GetOrCreate(loginCtx, a.playerID)
		a.created = created
		return subject, err
	})
	if err != nil {
		return gamelogin.InitResult{}, err
	}
	return syncsender.NewEnterInitSender(a.controller.NestClient()).Sync_EnterInit(ctx, a.subject.ID())
}

func (a *demoEnterAttempt) existing(ctx stdcontext.Context) (gamelogin.InitResult, error) {
	err := a.serveAndLoad(ctx, func(loginCtx stdcontext.Context) (*player.Player, error) {
		subject, err := a.controller.Players().Get(loginCtx, a.playerID)
		if errors.Is(err, player.ErrNotFound) || errors.Is(err, engine.ErrEntityAggregateNotFound) {
			return nil, gamelogin.ErrNeedCreate
		}
		return subject, err
	})
	if err != nil {
		return gamelogin.InitResult{}, err
	}
	return syncsender.NewEnterExistingSender(a.controller.NestClient()).Sync_EnterExisting(ctx, a.subject.ID())
}

func (a *demoEnterAttempt) place(ctx stdcontext.Context, entered gamelogin.Entered) error {
	if entered.First {
		slog.InfoContext(ctx, "enter: first entry confirmed", "player_id", a.playerID)
	}
	// 计数只投递，不等待共享 World 的持久提交。初始化已经提交，这里超时也不会把玩家变回新号。
	if err := handlersender.NewRecordEnterSender(a.controller.NestClient()).Send_RecordEnter(ctx, a.controller.WorldID()); err != nil {
		slog.Warn("enter_game: world did not record the login", "player_id", a.playerID, "err", err)
	}
	beforePlacement(ctx)
	if err := ctx.Err(); err != nil {
		failure, _ := loginTimeout(a.playerID, "place", err)
		return failure
	}
	// 普通地图先落位再订阅；分区场景由 Join 经 Cell 放置，不能先写本地地图。两条路都只尝试一次。
	var at spatial.Point
	if a.controller.Partition() == nil {
		spawn := sceneentity.WorldSceneConfig().Spawn
		var err error
		at, err = syncsender.NewEnterSceneSender(a.controller.NestClient()).MultiSync_EnterScene(ctx, a.subject.ID(), a.controller.WorldSceneID(), spawn.X, spawn.Y)
		if err != nil {
			slog.Warn("enter_game: player not placed on the map", "player_id", a.playerID, "err", err)
			return nil
		}
	}
	scene, err := a.controller.Scene()
	if err != nil {
		slog.Warn("enter_game: no scene to join", "player_id", a.playerID, "err", err)
		return nil
	}
	if err := scene.Join(ctx, a.subject, at); err != nil {
		slog.Warn("enter_game: player did not join the replicated scene", "player_id", a.playerID, "err", err)
	}
	return nil
}

// beforePlacement 是测试缝：EnterGame 在检查分发期限、进场景之前调它。生产代码里什么都不做；测试
// （enter_login_export_test.go 的 HoldBeforePlacementForTest）用它让期限恰好在这一步之前用完。
var beforePlacement = func(stdcontext.Context) {}

// loginContext is the login step's share of the request: the configured
// login budget when the transport publishes one, otherwise the request's own
// deadline alone.
func (controller *Controller) loginContext(parent stdcontext.Context) (stdcontext.Context, stdcontext.CancelFunc) {
	if budget := controller.LoginTimeout(); budget > 0 {
		return stdcontext.WithTimeout(parent, budget)
	}
	return stdcontext.WithCancel(parent)
}

// loginTimeout turns a serve or load whose wait was cut short into the
// login_timeout error; any other failure is returned as it is with false.
// EnterCreate shares it: its serve and load run on the same budget.
func loginTimeout(playerID int64, step string, err error) (error, bool) {
	switch {
	case errors.Is(err, stdcontext.DeadlineExceeded):
		slog.Warn("login budget exhausted", "step", step, "player_id", playerID, "err", err)
	case errors.Is(err, stdcontext.Canceled):
		slog.Info("login abandoned, its connection closed", "step", step, "player_id", playerID, "err", err)
	default:
		return err, false
	}
	return errcode.Wrap(apperrors.ErrLoginTimeout, err, "player_id", playerID), true
}

// loginRefusal 是 boundHere 的拒绝：答给客户端的码、原因，以及该连的服（0 表示不知道，客户端重新选角）。
type loginRefusal struct {
	code     int32
	reason   string
	ownerSID int32
}

// boundHere 是两个登录端点（EnterGame、EnterCreate）共用的静态归属检查，在任何别的检查、接入服务与装载之前。
//
// 玩家建角时由 account 绑定到一个 game sid（Role.ServerID），之后不迁移；原服并入另一服（别名合服）后由承载服服务
// （Role.ServingServerID）。一个 Player 只能在承载他的 sid 上驻留，同一 sid 只有一个进程（App 单实例锁）。所以
// “这次登录该不该在这里服务”是一个静态判断：会话 Claims 里认证器从 account 取来的 server_id（承载服）是否等于本进程的 sid。
//
//   - 不是本服：按名拒绝（player_elsewhere，带 owner_sid），客户端改连那个服的网关，不要在本服重试。不问驻留表。
//   - Claims 里没有 server_id：认证器被换掉了、没有记下绑定。fail-closed，同样拒绝（owner_sid=0，客户端重新选角），
//     并记 Error 日志，因为这是部署 / 代码问题，不是客户端连错了服。
//   - 驻留表取不到：答内部错误。
//
// 握手之后才换走的玩家，会话里的 server_id 仍是本服，这里拦不住；那是进入前检查（rehome 模块）与驻留表的迁出表管的事。
// 驻留表的 Serve 里还有同一个比较，这里先做是为了让“不是本服”的会话在跑任何检查之前就得到带 owner_sid 的回答。
func (controller *Controller) boundHere(context *playeraccess.Context, endpoint string) (playerOwners, int32, *loginRefusal) {
	owners, err := controller.PlayerOwners()
	if err != nil {
		slog.Error(endpoint+": ownership unavailable", "player_id", context.PlayerID, "err", err)
		code, reason := errcode.ClientError(err)
		return nil, 0, &loginRefusal{code: code, reason: reason}
	}
	boundSID, bound := BoundServerID(context.Session)
	if !bound {
		slog.Error(endpoint+": the session carries no server_id claim; refusing (the authenticator must record the role's server)", "player_id", context.PlayerID)
		code, reason := errcode.ClientError(errcode.Wrap(apperrors.ErrPlayerElsewhere, nil, "player_id", context.PlayerID, "owner_sid", 0))
		return nil, 0, &loginRefusal{code: code, reason: reason}
	}
	if boundSID != owners.SID() {
		slog.Warn(endpoint+": player is bound to another server", "player_id", context.PlayerID, "owner_sid", boundSID)
		code, reason := errcode.ClientError(errcode.Wrap(apperrors.ErrPlayerElsewhere, nil, "player_id", context.PlayerID, "owner_sid", boundSID))
		return nil, 0, &loginRefusal{code: code, reason: reason, ownerSID: boundSID}
	}
	return owners, boundSID, nil
}

// BoundServerID 读会话里 account 给出的承载服：认证器（登录模块的 game/modules/login，Claims）以
// svcaccount.ServerIDClaim 为键写进 Principal.Claims 的 Role.ServingServerID。没有合服时
// 它就是角色建角时绑定的原服；原服并入本服（别名合服）之后，原服的角色在这里读到的是本服，登录照常通过，
// 比较逻辑不变。原服另在 svcaccount.OriginServerIDClaim，路由与驻留不读它。没有会话、没有这个 claim、
// 或值不是正整数都回答 false，由调用方 fail-closed。
//
// 导出是为了让认证器那一侧的测试（tcp/login_claims_test.go）用登录端点真正使用的读取函数核对认证器写的
// Principal：认证器的规则留给工程改（game/modules/login），两边对不上时登录会一律 fail-closed。
func BoundServerID(session gateway.Session) (int32, bool) {
	if session == nil {
		return 0, false
	}
	raw, ok := session.Principal().Claims[svcaccount.ServerIDClaim]
	if !ok {
		return 0, false
	}
	sid, err := strconv.ParseInt(raw, 10, 32)
	if err != nil || sid <= 0 {
		return 0, false
	}
	return int32(sid), true
}
