package partition_test

import (
	"context"
	"errors"
	"reflect"
	"testing"

	db "{{MODULE}}/db"
	player "{{MODULE}}/game/entities/player"
	"{{MODULE}}/game/partition"
	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/framework/nest"
	"github.com/tjbdwanghaibo/roost-core/gameplay/cellworld"
)

// 两个 DAO 都承载 cellworld.ActorState：同一份映射。
var (
	_ partition.CellDao = (*db.SceneActorDao)(nil)
	_ partition.CellDao = (*db.MonsterDao)(nil)
)

type nullCommitter struct{}

func (nullCommitter) Commit(context.Context, nest.CommitRecord) error { return nil }

func sampleState(id int64, kind cellworld.EntityKind, seq uint64) cellworld.ActorState {
	return cellworld.ActorState{
		EntityState: cellworld.EntityState{ID: id, Kind: kind, Base: 1000, X: 2990, Y: 1500, VX: 120, VY: -30, HP: 70,
			Ver: cellworld.Version{Epoch: 3, Seq: seq}, Idle: kind == cellworld.KindNPC},
		Role: cellworld.RoleFrozen, LastInput: 9,
		Applied:    []cellworld.AppliedHit{{Hit: cellworld.HitID{Attacker: 77, Seq: 1}, At: 100}, {Hit: cellworld.HitID{Attacker: 78, Seq: 4}, At: 200}},
		Handoff:    &cellworld.HandoffState{Target: cellworld.CellID{Col: 1}, Epoch: 3, StartedAt: 300, LastSent: 400},
		RetryAfter: 5, LeaseUntil: 6, WritebackAt: 7,
	}
}

// The mapping is the whole state: what goes in comes out, for both entities' DAOs.
func TestCellStateRoundTripsThroughBothDAOs(t *testing.T) {
	for _, tc := range []struct {
		name string
		dao  partition.CellDao
		kind cellworld.EntityKind
	}{
		{"scene actor", db.NewSceneActorDao(), cellworld.KindPlayer},
		{"monster", db.NewMonsterDao(), cellworld.KindNPC},
	} {
		t.Run(tc.name, func(t *testing.T) {
			want := sampleState(42, tc.kind, 10)
			partition.WriteActor(tc.dao, want)
			if got := partition.ReadActor(tc.dao, 42, tc.kind); !reflect.DeepEqual(got, want) {
				t.Fatalf("read back\n got %+v\nwant %+v", got, want)
			}
			// What is read is a copy: changing it does not change the DAO (cellworld's value semantics).
			got := partition.ReadActor(tc.dao, 42, tc.kind)
			got.Applied[0].At, got.Handoff.Epoch = 999, 999
			if again := partition.ReadActor(tc.dao, 42, tc.kind); !reflect.DeepEqual(again, want) {
				t.Fatalf("a read copy reached the DAO: %+v", again)
			}
			// Back to Real: the handoff and the dedup list go.
			real := want
			real.Role, real.Handoff, real.Applied = cellworld.RoleReal, nil, nil
			partition.WriteActor(tc.dao, real)
			if got := partition.ReadActor(tc.dao, 42, tc.kind); got.Handoff != nil || got.Applied != nil || got.Role != cellworld.RoleReal {
				t.Fatalf("after clearing: %+v", got)
			}
		})
	}
}

// A beat or handler that fails restores the cell state through the generated setters' undo (D8 = A): the whole point
// of keeping it in a generated DAO.
func TestCellStateRollsBackWithTheTransaction(t *testing.T) {
	dao := db.NewSceneActorDao()
	before := sampleState(42, cellworld.KindPlayer, 10)
	partition.WriteActor(dao, before)
	failure := errors.New("install failed after the write")
	_, err := nest.RunIsolatedTransaction(context.Background(), nullCommitter{}, "cell_state_rollback", func() (any, error) {
		next := sampleState(42, cellworld.KindPlayer, 11)
		next.X, next.HP, next.Role = 3100, 50, cellworld.RoleReal
		next.Applied = append(next.Applied, cellworld.AppliedHit{Hit: cellworld.HitID{Attacker: 79, Seq: 1}, At: 500})
		next.Handoff = nil
		partition.WriteActor(dao, next)
		return nil, failure
	})
	if !errors.Is(err, failure) {
		t.Fatalf("transaction: %v", err)
	}
	if got := partition.ReadActor(dao, 42, cellworld.KindPlayer); !reflect.DeepEqual(got, before) {
		t.Fatalf("not restored\n got %+v\nwant %+v", got, before)
	}
}

// The Player's routing state: the live position is the non-persisted PosX / PosY, and the persisted snapshot
// position (SavedPosX / SavedPosY / SavedSceneID) is written only when an accepted write-back advances the snapshot
// version — the fixed moment, not every witness.
func TestBaseStateWritesTheSnapshotPositionOnlyOnAWriteBack(t *testing.T) {
	dao := db.NewPlayerDao()
	player.RegisterEntity()
	id, err := entity.BuildEntityID(7, player.EntityKindPlayer)
	if err != nil {
		t.Fatal(err)
	}
	dao.SetId(id)
	const sceneID = 12345
	// CellHP and the snapshot are persisted fields: their setters only run inside a transaction (as in the Node's
	// handlers and the Player's beat).
	write := func(st cellworld.BaseState) {
		t.Helper()
		if _, err := nest.RunIsolatedTransaction(context.Background(), nullCommitter{}, "base_state", func() (any, error) {
			partition.WriteBase(dao, st, sceneID)
			return nil, nil
		}); err != nil {
			t.Fatal(err)
		}
	}
	st := cellworld.BaseState{Actor: 7, InWorld: true, Cell: 1001, Epoch: 2, X: 2900, Y: 1500, HP: 100, IntentSeq: 3, VX: 100, AttackSeq: 4, Shown: true, ShownGen: 3}
	write(st)
	if got := partition.ReadBase(dao); !reflect.DeepEqual(got, st) {
		t.Fatalf("read back\n got %+v\nwant %+v", got, st)
	}
	if dao.GetSavedSceneID() != 0 || dao.GetSavedPosX() != 0 {
		t.Fatalf("a witness wrote the stored position: scene %d x %d", dao.GetSavedSceneID(), dao.GetSavedPosX())
	}
	st.X, st.HP, st.SnapVer = 3010, 80, cellworld.Version{Epoch: 2, Seq: 40}
	write(st)
	if dao.GetSavedSceneID() != sceneID || dao.GetSavedPosX() != 3010 || dao.GetCellHP() != 80 || dao.GetCellSnapSeq() != 40 {
		t.Fatalf("a write-back did not reach the stored fields: scene %d x %d hp %d seq %d", dao.GetSavedSceneID(), dao.GetSavedPosX(), dao.GetCellHP(), dao.GetCellSnapSeq())
	}
	st.X = 3050
	write(st)
	if dao.GetSavedPosX() != 3010 {
		t.Fatalf("a witness after the write-back moved the stored position to %d", dao.GetSavedPosX())
	}
}
