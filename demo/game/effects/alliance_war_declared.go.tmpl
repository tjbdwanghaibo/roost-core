package effects

import (
	"encoding/json"
	"fmt"
	"strconv"

	"github.com/tjbdwanghaibo/roost-core/framework/nest"
)

// TopicAllianceWarDeclared is recorded when an alliance declares war on an
// alliance on another service instance (plan §2.9, decision 4 A: two steps,
// eventually consistent). The declaring side has recorded the war; the
// consumer (the alliance service) records it on the enemy's side under the
// same request id. Between two alliances on one instance the declaration is a
// single transaction and records no effect.
const TopicAllianceWarDeclared = "alliance.war_declared"

// AllianceWarDeclared is the payload.
type AllianceWarDeclared struct {
	AllianceID int64  `json:"alliance_id"`
	EnemyID    int64  `json:"enemy_id"`
	RequestID  string `json:"request_id"`
}

// EmitAllianceWarDeclared records the effect on the current Nest
// transaction, keyed by the enemy alliance.
func EmitAllianceWarDeclared(event AllianceWarDeclared) error {
	payload, err := json.Marshal(event)
	if err != nil {
		return fmt.Errorf("effects: encode %s: %w", TopicAllianceWarDeclared, err)
	}
	return nest.Emit(nest.Effect{Topic: TopicAllianceWarDeclared, Key: strconv.FormatInt(event.EnemyID, 10), Payload: payload})
}
