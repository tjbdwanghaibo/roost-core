package effects

import (
	"encoding/json"
	"fmt"
	"strconv"

	"github.com/tjbdwanghaibo/roost-core/framework/nest"
)

// TopicAllianceMemberChanged is emitted by every alliance write that seats or
// unseats a player. It is best effort (DeliveryAllianceMemberChanged): it is
// not in the transaction's WAL record, writes no outbox or inbox, and is sent
// over NATS once after the write is durable; a process that stops in between,
// or a full send queue, loses it. Its consumer (internal/service/alliance)
// only sends the player's game server a membership notice, itself best effort
// — a lost one is made up at the player's next login or next notice.
//
// It does not finish the player's AllianceMember guard: a guard on the same
// instance changes in the same transaction, one on another instance is
// finished by a direct call, and a call that is lost is healed by the next
// request that finds the guard held (rpc/alliance guard.go, healGuard).
const TopicAllianceMemberChanged = "alliance.member_changed"

// DeliveryAllianceMemberChanged is how the effect travels; its consumer
// subscribes with the same value.
const DeliveryAllianceMemberChanged = nest.EffectBestEffort

// Membership changes.
const (
	MemberJoined = "joined"
	MemberLeft   = "left"
	MemberKicked = "kicked"
)

// AllianceMemberChanged is the payload.
type AllianceMemberChanged struct {
	AllianceID int64  `json:"alliance_id"`
	PlayerID   int64  `json:"player_id"`
	HomeSID    int32  `json:"home_sid"`
	Change     string `json:"change"`
	// Version is the alliance's state version this change produced.
	Version int64 `json:"version"`
}

// EmitAllianceMemberChanged emits the effect on the current Nest
// transaction, keyed by the player.
func EmitAllianceMemberChanged(event AllianceMemberChanged) error {
	payload, err := json.Marshal(event)
	if err != nil {
		return fmt.Errorf("effects: encode %s: %w", TopicAllianceMemberChanged, err)
	}
	return nest.Emit(nest.Effect{Topic: TopicAllianceMemberChanged, Key: strconv.FormatInt(event.PlayerID, 10), Payload: payload, Delivery: DeliveryAllianceMemberChanged})
}
