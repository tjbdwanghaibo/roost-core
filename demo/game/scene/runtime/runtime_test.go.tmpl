type testScene struct{ id int64 }

func (s testScene) ID() int64 { return s.id }

func newTestRuntime(t *testing.T) *Runtime {
	t.Helper()
	runtime, err := New(testScene{id: 1}, scene.Config{Width: 20, Height: 20, BlockSize: 5})
	if err != nil {
		t.Fatalf("new runtime: %v", err)
	}
	if err := runtime.Start(); err != nil {
		t.Fatalf("start runtime: %v", err)
	}
	t.Cleanup(func() { runtime.Stop(entity.DestroyReasonCommon) })
	return runtime
}

// The map's edges are the map's business: a point outside it is not walkable,
// whatever anybody else thinks.
func TestTerrainRefusesWhatIsOutsideOrTaken(t *testing.T) {
	runtime := newTestRuntime(t)
	terrain := runtime.Terrain()

	if !terrain.Walkable(spatial.Point{X: 0, Y: 0}) {
		t.Error("the origin is inside a 20x20 map")
	}
	if terrain.Walkable(spatial.Point{X: 20, Y: 0}) {
		t.Error("x=20 is outside a map of width 20")
	}
	if terrain.Walkable(spatial.Point{X: -1, Y: 0}) {
		t.Error("a negative coordinate is outside the map")
	}

	wall := spatial.Point{X: 5, Y: 5}
	if err := terrain.Occupy(wall); err != nil {
		t.Fatalf("occupy: %v", err)
	}
	if terrain.Walkable(wall) {
		t.Error("an occupied point is still walkable")
	}
	if err := terrain.Occupy(wall); err == nil {
		t.Error("the same point was occupied twice")
	}
	terrain.Release(wall)
	if !terrain.Walkable(wall) {
		t.Error("a released point did not become walkable again")
	}
}

// Place is what makes a login survive a map that changed while the player was
// away: it answers with the NEAREST free point, not merely a free one.
func TestPlaceFindsTheNearestFreePoint(t *testing.T) {
	runtime := newTestRuntime(t)
	terrain, pathFind := runtime.Terrain(), runtime.PathFind()

	preferred := spatial.Point{X: 10, Y: 10}
	if got, err := pathFind.Place(preferred); err != nil || got != preferred {
		t.Fatalf("Place on a free point = %v, %v; want the point itself", got, err)
	}
	if err := terrain.Occupy(preferred); err != nil {
		t.Fatal(err)
	}
	got, err := pathFind.Place(preferred)
	if err != nil {
		t.Fatalf("Place next to a taken point: %v", err)
	}
	if got == preferred {
		t.Fatal("Place returned the point it was told is taken")
	}
	if dx, dy := got.X-preferred.X, got.Y-preferred.Y; dx < -1 || dx > 1 || dy < -1 || dy > 1 {
		t.Errorf("Place returned %v, which is not adjacent to %v", got, preferred)
	}
}

// A route exists around an obstacle and does not exist through a wall. The
// second half is the one worth asserting: a pathfinder that answers "yes"
// everywhere is a pathfinder nobody notices is broken.
func TestPathRoutesAroundAndRefusesThrough(t *testing.T) {
	runtime := newTestRuntime(t)
	terrain, pathFind := runtime.Terrain(), runtime.PathFind()

	from, to := spatial.Point{X: 0, Y: 10}, spatial.Point{X: 19, Y: 10}
	if path, err := pathFind.Path(from, to); err != nil || len(path) == 0 {
		t.Fatalf("open field path = %d points, %v", len(path), err)
	}
	// A wall across the whole map, with no gap.
	for y := int64(0); y < 20; y++ {
		if err := terrain.Occupy(spatial.Point{X: 10, Y: y}); err != nil {
			t.Fatal(err)
		}
	}
	if path, err := pathFind.Path(from, to); err == nil {
		t.Fatalf("a path of %d points was found through a solid wall", len(path))
	}
}

// Systems stop in reverse order and stay callable afterwards: a request that
// found the scene a moment before it closed must get an error, not a panic.
func TestStoppedSystemsAnswerInsteadOfPanicking(t *testing.T) {
	runtime := newTestRuntime(t)
	runtime.Stop(entity.DestroyReasonCommon)

	if runtime.Terrain().Walkable(spatial.Point{X: 1, Y: 1}) {
		t.Error("a stopped terrain reports a walkable point")
	}
	if err := runtime.Terrain().Occupy(spatial.Point{X: 1, Y: 1}); err == nil {
		t.Error("a stopped terrain accepted an occupancy")
	}
	if _, err := runtime.PathFind().Place(spatial.Point{X: 1, Y: 1}); err == nil {
		t.Error("a stopped pathfinder answered")
	}
}

// Scene 的系统访问器“可以从任何地方调用”（Scene 实体注释：endpoint、
// spawner 的定时器、AOI tick），场景关闭时可能有寻路正在进行。旧 PathFindSystem.Stop 无锁把 terrain 置
// nil，与并发的 Path / Place 读同一字段是数据竞争（-race 报告），而且 Place 先判 nil 再用，两次读之间被置
// nil 会解引用空指针。地形系统自带锁、停止后自己回答 “stopped”，寻路系统不需要清空这个指针。
func TestPathFindingWhileTheSceneStopsIsSafe(t *testing.T) {
	runtime := newTestRuntime(t)
	pathFind := runtime.PathFind()
	var stopped atomic.Bool
	started := make(chan struct{})
	done := make(chan struct{})
	go func() {
		defer close(done)
		_, _ = pathFind.Place(spatial.Point{X: 1, Y: 1})
		close(started)
		for {
			_, _ = pathFind.Place(spatial.Point{X: 1, Y: 1})
			_, _ = pathFind.Path(spatial.Point{X: 0, Y: 0}, spatial.Point{X: 3, Y: 3})
			if stopped.Load() {
				return
			}
		}
	}()
	<-started
	runtime.Stop(entity.DestroyReasonCommon)
	stopped.Store(true)
	<-done
	if _, err := pathFind.Place(spatial.Point{X: 1, Y: 1}); err == nil {
		t.Error("a stopped pathfinder answered")
	}
}

// Without a height field (no scene.terrain.pack, or a partitioned scene) the
// map is exactly the flat grid it always was: Standable is Walkable, a route
// is spatial.FindPath's over the same grid, and Place answers the same point.
// Checked over random points and obstacles, not a hand-picked few.
func TestWithoutASurfaceTheMapIsTheFlatGrid(t *testing.T) {
	runtime := newTestRuntime(t)
	terrain, pathFind := runtime.Terrain(), runtime.PathFind()
	if terrain.Surface() != nil {
		t.Fatal("a new scene has a height field")
	}
	rng := rand.New(rand.NewPCG(7, 11))
	reference, err := spatial.NewGridTerrain(20, 20)
	if err != nil {
		t.Fatal(err)
	}
	for range 60 {
		wall := spatial.Point{X: rng.Int64N(20), Y: rng.Int64N(20)}
		if terrain.Occupy(wall) == nil {
			_ = reference.SetBlocked(wall, true)
		}
	}
	for range 400 {
		a := spatial.Point{X: rng.Int64N(24) - 2, Y: rng.Int64N(24) - 2}
		b := spatial.Point{X: rng.Int64N(24) - 2, Y: rng.Int64N(24) - 2}
		if terrain.Standable(a) != terrain.Walkable(a) {
			t.Fatalf("Standable(%v) differs from Walkable without a height field", a)
		}
		got, gotErr := pathFind.Path(a, b)
		want, wantErr := spatial.FindPath(reference, a, b, spatial.PathOptions{MaxVisited: maxPathVisited})
		if !slices.Equal(got, want) || !errors.Is(gotErr, wantErr) && (gotErr != nil || wantErr != nil) {
			t.Fatalf("Path(%v, %v) = %v %v, the flat grid says %v %v", a, b, got, gotErr, want, wantErr)
		}
	}
}

// writeFlatPack writes a one-chunk pack at world height 0 (raw 1000 over a
// −100m base), with the given samples raised or lowered.
func writeFlatPack(t *testing.T, raw map[[2]int64]uint16) *terrain.Pack {
	t.Helper()
	path := filepath.Join(t.TempDir(), "flat.pack")
	meta := terrain.Meta{BaseRevision: 1, ChunksX: 1, ChunksY: 1, HeightBase: -10000, WaterLevel: -50}
	err := terrain.WritePackFile(path, meta, func(terrain.ChunkKey) (terrain.Chunk, error) {
		c := terrain.NewChunk()
		for i := range c.Heights {
			c.Heights[i] = 1000
		}
		for g, h := range raw {
			c.Heights[g[1]*terrain.ChunkSamples+g[0]] = h
		}
		return c, nil
	})
	if err != nil {
		t.Fatal(err)
	}
	pack, err := terrain.OpenPack(path)
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { _ = pack.Close() })
	return pack
}

// With a height field the scene's map follows it: routes go around what is
// too steep, a deep pond without swimming is not a place to stand, Place
// steps by ground nodes to the nearest standable one, and the walker is
// bounded to the scene (a route never leaves it). Taking it down restores the
// flat grid.
func TestASurfaceRoutesAndPlacesOnTheHeightField(t *testing.T) {
	runtime, err := New(testScene{id: 1}, scene.Config{Width: 1000, Height: 1000, BlockSize: 100})
	if err != nil {
		t.Fatal(err)
	}
	if err := runtime.Start(); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { runtime.Stop(entity.DestroyReasonCommon) })
	raw := map[[2]int64]uint16{}
	for gy := int64(0); gy <= 8; gy++ {
		raw[[2]int64{5, gy}] = 1020 // a 2m wall with a gap at the top row
	}
	raw[[2]int64{2, 2}] = 970 // a 3m-deep pond sample
	view := terrain.NewView(writeFlatPack(t, raw))
	if err := view.LoadBase(terrain.ChunkKey{}); err != nil {
		t.Fatal(err)
	}
	dry := terrain.DefaultWalkRules
	dry.SwimSpeed = 0
	ground, pathFind := runtime.Terrain(), runtime.PathFind()
	ground.SetSurface(&terrain.Walker{View: view, Rules: dry})
	if got := ground.Surface().Bounds; got != ground.Bounds() {
		t.Fatalf("the installed walker is bounded to %v, want the scene %v", got, ground.Bounds())
	}

	route, err := pathFind.Path(spatial.Point{X: 100, Y: 100}, spatial.Point{X: 900, Y: 100})
	if err != nil {
		t.Fatalf("a route around the wall: %v", err)
	}
	if !slices.ContainsFunc(route, func(p spatial.Point) bool { return p.X == 500 && p.Y == 900 }) {
		t.Fatalf("the route %v does not go through the gap at (500, 900)", route)
	}
	if ground.Standable(spatial.Point{X: 200, Y: 200}) {
		t.Fatal("a deep pond without swimming is standable")
	}
	if got, err := pathFind.Place(spatial.Point{X: 210, Y: 190}); err != nil || got == (spatial.Point{X: 210, Y: 190}) || !ground.Standable(got) {
		t.Fatalf("Place next to the pond = %v %v, want the nearest standable node", got, err)
	}
	if _, err := pathFind.Path(spatial.Point{X: 100, Y: 100}, spatial.Point{X: 200, Y: 200}); !errors.Is(err, spatial.ErrNoPath) {
		t.Fatalf("a route into the pond: %v, want no path", err)
	}
	if _, err := pathFind.Path(spatial.Point{X: 100, Y: 100}, spatial.Point{X: 1500, Y: 100}); err == nil {
		t.Fatal("a route out of the scene")
	}

	ground.SetSurface(nil)
	if ground.Surface() != nil || !ground.Standable(spatial.Point{X: 200, Y: 200}) {
		t.Fatal("taking the height field down did not restore the flat grid")
	}
}

// A scene built on the terrain map (scene.TerrainConfig, an ordinary scene
// with editable terrain) is the terrain map: the ground, the walker and the
// spawns cover all of it — far beyond the default 1000 × 1000 — and nothing
// outside it. The spawn table's points (inside the default map) still spawn
// on standable ground.
func TestASceneOnTheTerrainMapCoversAllOfIt(t *testing.T) {
	view := terrain.NewView(writeFlatPack(t, nil))
	if err := view.LoadBase(terrain.ChunkKey{}); err != nil {
		t.Fatal(err)
	}
	bounds := view.Meta().Bounds()
	config, err := scene.TerrainConfig(bounds)
	if err != nil {
		t.Fatal(err)
	}
	loadSpawnTable(t)
	runtime, err := New(testScene{id: 1}, config)
	if err != nil {
		t.Fatal(err)
	}
	if err := runtime.Start(); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { runtime.Stop(entity.DestroyReasonCommon) })
	ground, pathFind := runtime.Terrain(), runtime.PathFind()
	ground.SetSurface(&terrain.Walker{View: view, Rules: terrain.DefaultWalkRules})
	if ground.Bounds() != bounds || ground.Surface().Bounds != bounds {
		t.Fatalf("the scene is %v and its walker %v, want the terrain map %v", ground.Bounds(), ground.Surface().Bounds, bounds)
	}
	edge := bounds.Max.X
	for _, p := range []spatial.Point{{X: edge - 1, Y: edge - 1}, {X: 5000, Y: 100}, {X: 100, Y: 5000}} {
		if !ground.Standable(p) {
			t.Fatalf("%v inside the terrain map is not standable", p)
		}
	}
	for _, p := range []spatial.Point{{X: edge, Y: 100}, {X: 100, Y: edge}, {X: -1, Y: 100}} {
		if ground.Standable(p) || ground.Walkable(p) {
			t.Fatalf("%v outside the terrain map is standable", p)
		}
	}
	route, err := pathFind.Path(spatial.Point{X: 5900, Y: 5900}, spatial.Point{X: edge - 50, Y: edge - 50})
	if err != nil || route[len(route)-1] != (spatial.Point{X: edge - 50, Y: edge - 50}) {
		t.Fatalf("a route to the far corner: %v %v", route, err)
	}
	if _, err := pathFind.Path(spatial.Point{X: 5900, Y: 5900}, spatial.Point{X: edge + 50, Y: 5900}); err == nil {
		t.Fatal("a route out of the terrain map")
	}
	if got, err := pathFind.Place(spatial.Point{X: edge + 50, Y: 3000}); err != nil || !bounds.Contains(got) || !ground.Standable(got) {
		t.Fatalf("Place just outside the map = %v %v, want a standable node inside it", got, err)
	}
	requests := runtime.Refresh().Due(time.Now())
	if len(requests) == 0 {
		t.Fatal("no spawns on the terrain map")
	}
	for _, request := range requests {
		if !ground.Standable(request.At) {
			t.Fatalf("spawn %+v is not standable", request)
		}
	}
}
