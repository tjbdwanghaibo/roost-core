package sceneruntime

import (
	"fmt"
	"sync"

	"{{MODULE}}/game/scene"
	coreentity "github.com/tjbdwanghaibo/roost-core/entity"
	"github.com/tjbdwanghaibo/roost-core/spatial"
)

// Interest radii. BlockSize is the AOI grid's cell and the relationship
// between them is the one that matters: the number of cells an observer
// subscribes to is (⌈2·LeaveRadius/BlockSize⌉+1)², so a cell about the size
// of the view radius gives the classic nine cells. Making cells much smaller
// than the radius does not make the AOI more accurate — the radius check is
// exact either way — it only multiplies the bookkeeping every time an
// observer moves. Nothing in the framework enforces this ratio
// (W-2026-09-18-05), so it is written down here.
const (
	InterestEnterRadius = 120
	InterestLeaveRadius = 150
)

const (
	// SourceSpatial is distance; SourceSelf is "you always see yourself";
	// SourceTeam is the demo's one social relationship.
	SourceSpatial = "spatial"
	SourceSelf    = "self"
	SourceTeam    = "team"
)

// InterestSystem is the scene's answer to "who should be receiving whose
// state". It owns the spatial index, the relation sources, and the
// aggregation between them.
//
// Aggregation is the part worth reading. A pair (observer, subject) can be
// held by more than one source at once — a teammate standing next to you is
// both spatial and team — so the system counts sources: the FIRST source to
// claim a pair produces a subscribe, and only the LAST source to drop it
// produces an unsubscribe. Without that, a teammate walking out of view would
// take the team subscription with them, and the bug would only appear when
// two sources overlap and then separate.
//
// spatial.InterestManager is documented as not safe for concurrent use, so
// this system carries the lock that makes it so — every method here is
// callable from any goroutine, which is the rule for scene systems.
type InterestSystem struct {
	mu       sync.Mutex
	interest *spatial.InterestManager
	self     *RelationSource
	team     *RelationSource
	sources  []scene.Source

	// held maps a pair to the sources currently claiming it, and to whether
	// the aggregator has already told the transport about it.
	held map[interestPair]*interestHold

	// retry holds the pairs whose subscribe the transport refused, waiting
	// for the next Tick to say them again. See SubscribeFailed.
	retry []interestPair
}

type interestPair struct{ observer, subject int64 }

type interestHold struct {
	bands      map[string]int
	subscribed bool
	band       int
}

func (s *InterestSystem) Name() string { return SystemNameInterest }

func (s *InterestSystem) Init(ctx *Context) error {
	bounds := spatial.Rect{Max: spatial.Point{X: ctx.Config.Width, Y: ctx.Config.Height}}
	manager, err := spatial.NewInterestManager(spatial.InterestConfig{
		Bounds:      bounds,
		BlockSize:   ctx.Config.BlockSize,
		EnterRadius: InterestEnterRadius,
		LeaveRadius: InterestLeaveRadius,
		// Bands is deliberately empty: a band only means something once the
		// packer can pack less for a far one, and the generated field masks
		// are private to the DAO package (W-2026-09-18-02). One band until
		// that is settled; the aggregation below already carries bands so
		// that day is a configuration change.
	})
	if err != nil {
		return err
	}
	s.mu.Lock()
	defer s.mu.Unlock()
	s.interest = manager
	s.self = NewRelationSource(SourceSelf)
	s.team = NewRelationSource(SourceTeam)
	s.sources = []scene.Source{spatialSource{manager: manager}, s.self, s.team}
	s.held = make(map[interestPair]*interestHold)
	return nil
}

func (s *InterestSystem) Start() error { return nil }

func (s *InterestSystem) Stop(coreentity.EntityDestroyReason) {
	s.mu.Lock()
	defer s.mu.Unlock()
	s.interest = nil
	s.sources = nil
	s.held = nil
	s.retry = nil
}

// spatialSource adapts the core manager to the Source interface. Flush is
// called with the system's lock already held, which is why it does not take
// one of its own.
type spatialSource struct{ manager *spatial.InterestManager }

func (spatialSource) Name() string { return SourceSpatial }

func (s spatialSource) Flush() []spatial.InterestEvent { return s.manager.Flush() }

// Enter puts a player in: it both sees and is seen, and it sees itself. The
// self relationship is a source rather than a special case in the bridge —
// the spatial source refuses to let anything observe itself, and "I always
// see myself" is not a fact about distance.
func (s *InterestSystem) Enter(id int64, at spatial.Point) error {
	s.mu.Lock()
	defer s.mu.Unlock()
	if s.interest == nil {
		return fmt.Errorf("scene interest: stopped")
	}
	if err := s.interest.AddSubject(id, at); err != nil {
		return err
	}
	if err := s.interest.AddObserver(id, at); err != nil {
		return err
	}
	s.self.Set(id, []int64{id})
	return nil
}

func (s *InterestSystem) Move(id int64, to spatial.Point) error {
	s.mu.Lock()
	defer s.mu.Unlock()
	if s.interest == nil {
		return fmt.Errorf("scene interest: stopped")
	}
	// Both, and in this order: the two tables are separate, and a subject
	// that moved without its observer having moved would see the world from
	// where it used to be.
	if err := s.interest.MoveSubject(id, to); err != nil {
		return err
	}
	return s.interest.MoveObserver(id, to)
}

func (s *InterestSystem) Leave(id int64) error {
	s.mu.Lock()
	defer s.mu.Unlock()
	if s.interest == nil {
		return fmt.Errorf("scene interest: stopped")
	}
	s.self.Clear(id)
	s.team.Clear(id)
	s.team.Forget(id)
	if err := s.interest.RemoveObserver(id); err != nil {
		return err
	}
	return s.interest.RemoveSubject(id)
}

// Show / MoveShown / Hide are for things that are seen but do not see: a
// monster, a dropped item. They are the same spatial calls without the
// observer half.
func (s *InterestSystem) Show(id int64, at spatial.Point) error {
	s.mu.Lock()
	defer s.mu.Unlock()
	if s.interest == nil {
		return fmt.Errorf("scene interest: stopped")
	}
	return s.interest.AddSubject(id, at)
}

func (s *InterestSystem) MoveShown(id int64, to spatial.Point) error {
	s.mu.Lock()
	defer s.mu.Unlock()
	if s.interest == nil {
		return fmt.Errorf("scene interest: stopped")
	}
	return s.interest.MoveSubject(id, to)
}

func (s *InterestSystem) Hide(id int64) error {
	s.mu.Lock()
	defer s.mu.Unlock()
	if s.interest == nil {
		return fmt.Errorf("scene interest: stopped")
	}
	s.team.Forget(id)
	return s.interest.RemoveSubject(id)
}

func (s *InterestSystem) Team() scene.Relations {
	s.mu.Lock()
	defer s.mu.Unlock()
	return s.team
}

// Tick drains every source and aggregates. It returns what changed, so a
// caller that has nothing to do costs one map lookup per event and no
// transport calls at all.
func (s *InterestSystem) Tick() []scene.SubscriptionChange {
	s.mu.Lock()
	defer s.mu.Unlock()
	if s.held == nil {
		return nil
	}
	var changes []scene.SubscriptionChange
	for _, source := range s.sources {
		name := source.Name()
		for _, event := range source.Flush() {
			if change, ok := s.apply(name, event); ok {
				changes = append(changes, change)
			}
		}
	}
	// Retries last, so that a pair a source event already spoke for in THIS
	// tick is not said twice: apply re-subscribes such a pair on the way
	// past, and the drain skips whatever is subscribed again.
	return append(changes, s.drainRetriesLocked()...)
}

// SubscribeFailed takes back a subscribe the transport refused.
//
// apply marks a pair subscribed BEFORE anyone has spoken to the transport —
// that is what makes the source counting work — so a refused subscribe leaves
// the system believing in a subscription that does not exist. rebandLocked
// then re-emits only when the BAND changes, and Tick turns nothing but source
// events into changes: the pair is never mentioned again and the observer
// never sees that subject for the rest of the session (RR-20260920-06).
//
// Clearing the flag on its own would not be enough, precisely because there
// is no event left to fold — so the pair is queued, and the next Tick says it
// again. The queue is bounded by the held set: an entry is only added for a
// pair that is held and not already queued, and every entry is taken off at
// the next drain.
func (s *InterestSystem) SubscribeFailed(observer, subject int64) {
	s.mu.Lock()
	defer s.mu.Unlock()
	if s.held == nil {
		return
	}
	key := interestPair{observer: observer, subject: subject}
	hold := s.held[key]
	if hold == nil {
		// The pair was released between the emit and the refusal. There is
		// nothing to retry, and no unsubscribe to send either: the transport
		// never accepted it.
		return
	}
	if !hold.subscribed {
		// A held pair is subscribed unless it is queued, so this is a second
		// refusal for a retry already waiting: one entry per pair.
		return
	}
	hold.subscribed = false
	s.retry = append(s.retry, key)
}

// drainRetriesLocked re-emits the queued subscribes. A pair that has since
// been released, or that this same tick has already re-subscribed, is dropped
// silently: the queue is a reminder, not a record of intent — s.held is that.
func (s *InterestSystem) drainRetriesLocked() []scene.SubscriptionChange {
	if len(s.retry) == 0 {
		return nil
	}
	queued := s.retry
	s.retry = nil
	changes := make([]scene.SubscriptionChange, 0, len(queued))
	for _, key := range queued {
		hold := s.held[key]
		if hold == nil || hold.subscribed {
			continue
		}
		hold.subscribed = true
		hold.band = bestBand(hold.bands)
		changes = append(changes, scene.SubscriptionChange{Observer: key.observer, Subject: key.subject, Subscribe: true, Profile: bandProfile(hold.band), Retry: true})
	}
	if len(changes) == 0 {
		return nil
	}
	return changes
}

// apply folds one source's event into the pair's held set and reports the
// subscription change it caused, if any.
func (s *InterestSystem) apply(source string, event spatial.InterestEvent) (scene.SubscriptionChange, bool) {
	key := interestPair{observer: event.Observer, subject: event.Subject}
	hold := s.held[key]
	switch event.Kind {
	case spatial.InterestLeave:
		if hold == nil {
			return scene.SubscriptionChange{}, false
		}
		delete(hold.bands, source)
		if len(hold.bands) > 0 {
			// Another source still wants it. Only the band can change.
			return s.rebandLocked(key, hold)
		}
		delete(s.held, key)
		if !hold.subscribed {
			return scene.SubscriptionChange{}, false
		}
		return scene.SubscriptionChange{Observer: key.observer, Subject: key.subject}, true
	default:
		band := event.Band
		if band < 0 {
			band = 0
		}
		if hold == nil {
			hold = &interestHold{bands: make(map[string]int, 2), band: band}
			s.held[key] = hold
		}
		hold.bands[source] = band
		if !hold.subscribed {
			// Optimistic, and deliberately so: the pair counts as subscribed
			// from here, and the transport tells us otherwise through
			// SubscribeFailed. This branch is also how a queued retry gets
			// said again when a source event reaches it first.
			hold.subscribed = true
			hold.band = bestBand(hold.bands)
			return scene.SubscriptionChange{Observer: key.observer, Subject: key.subject, Subscribe: true, Profile: bandProfile(hold.band)}, true
		}
		return s.rebandLocked(key, hold)
	}
}

func (s *InterestSystem) rebandLocked(key interestPair, hold *interestHold) (scene.SubscriptionChange, bool) {
	band := bestBand(hold.bands)
	if band == hold.band || !hold.subscribed {
		return scene.SubscriptionChange{}, false
	}
	hold.band = band
	return scene.SubscriptionChange{Observer: key.observer, Subject: key.subject, Subscribe: true, Profile: bandProfile(band)}, true
}

// bestBand is the merge rule when sources disagree: the most detailed one
// wins (band 0 is nearest). A relationship therefore outranks distance, which
// is what "I see my teammate wherever they are" means — and what it costs is
// recorded in W-2026-09-18-08.
func bestBand(bands map[string]int) int {
	best := -1
	for _, band := range bands {
		if best < 0 || band < best {
			best = band
		}
	}
	if best < 0 {
		return 0
	}
	return best
}

func bandProfile(band int) coreentity.SyncProfile {
	if band <= 0 {
		return coreentity.SyncProfile{}
	}
	return coreentity.SyncProfile{Key: fmt.Sprintf("band%d", band), LOD: uint8(band)}
}

var _ scene.Interest = (*InterestSystem)(nil)
