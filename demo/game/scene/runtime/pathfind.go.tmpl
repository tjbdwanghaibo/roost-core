package sceneruntime

import (
	"fmt"
	"sync/atomic"

	"{{MODULE}}/game/scene"
	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/gameplay/terrain"
	"github.com/tjbdwanghaibo/roost-core/infra/base/spatial"
)

// maxPathVisited bounds a search. A* over an open field is cheap; A* toward a
// goal walled off from the start is a full sweep of the map, and a request
// that can make the server do that is a request that will be sent in a loop.
const maxPathVisited = 4096

// maxPlaceRings bounds the outward search for a free point. Past this the
// answer is "the area is full", which the caller can act on — unlike a search
// that eventually succeeds a hundred units away from where the player meant
// to be.
const maxPlaceRings = 16

// PathFindSystem answers routing questions. It holds no state of its own: the
// terrain is the state, and this system's lock is the terrain's read lock,
// taken for the duration of one search so the grid cannot change underneath
// A*.
//
// terrain is set once in Init and never cleared. The Scene hands this system
// to callers that hold no Scene lock (the spawner's timer, an endpoint), so a
// search can be running while the scene stops; Stop only flips stopped, and
// the terrain answers "stopped" on its own once it is stopped. Clearing the
// pointer in Stop raced every in-flight Path / Place and could nil it between
// their check and their use.
type PathFindSystem struct {
	terrain *TerrainSystem
	stopped atomic.Bool
}

func (p *PathFindSystem) Name() string { return SystemNamePathFind }

func (p *PathFindSystem) Init(ctx *Context) error {
	p.terrain = ctx.Runtime.terrain
	if p.terrain == nil {
		return fmt.Errorf("scene pathfind: terrain system is required")
	}
	return nil
}

func (p *PathFindSystem) Start() error { return nil }

func (p *PathFindSystem) Stop(entity.EntityDestroyReason) { p.stopped.Store(true) }

func (p *PathFindSystem) Path(from, to spatial.Point) ([]spatial.Point, error) {
	if p.stopped.Load() || p.terrain == nil {
		return nil, fmt.Errorf("scene pathfind: stopped")
	}
	if surface := p.terrain.Surface(); surface != nil {
		return p.pathOn(surface, from, to)
	}
	var path []spatial.Point
	err := p.terrain.withSearchView(func(view spatial.Terrain) error {
		found, err := spatial.FindPath(view, from, to, spatial.PathOptions{MaxVisited: maxPathVisited})
		if err != nil {
			return err
		}
		path = found
		return nil
	})
	return path, err
}

// pathOn is Path over the height field (editable terrain, P3): an
// eight-direction A* over the 1m ground nodes with the same slope / step /
// drop / water rules a walk is checked by, distance plus climb as the cost,
// within the same maxPathVisited (terrain.Walker.FindPath). The route goes
// through node positions, so every leg crosses one node boundary — exactly
// the steps the walk will check. It reads the terrain view without a lock;
// an edit committed during the search is either seen whole or not at all
// per chunk.
//
// No route is cached: a request computes its route once and the walk checks
// the live ground at every node, so an edit after the search (a ditch dug
// across the route) stops the walk where the ground refuses it (Blocked),
// and the next request routes around it. The grid's occupancy (Occupy) is
// not part of the node graph — the demo occupies nothing; a walk still asks
// the grid at every point it enters.
//
// Errors keep their meaning for the caller: out of the map or a chunk not
// loaded is "no route" here (terrain.ErrOutOfMap / ErrNotLoaded under
// ErrNoPath's handling), the budget is spatial.ErrPathBudgetExhausted.
func (p *PathFindSystem) pathOn(surface *terrain.Walker, from, to spatial.Point) ([]spatial.Point, error) {
	route, err := surface.FindPath(from, to, maxPathVisited)
	if err != nil {
		return nil, err
	}
	return route.Points, nil
}

// Place searches outward in square rings from preferred and returns the first
// walkable point. Rings rather than a scan: the nearest free point is what a
// caller means by "put me near here", and a scan would answer with whatever
// the iteration order happened to reach first.
func (p *PathFindSystem) Place(preferred spatial.Point) (spatial.Point, error) {
	if p.stopped.Load() || p.terrain == nil {
		return spatial.Point{}, fmt.Errorf("scene pathfind: stopped")
	}
	if p.terrain.Standable(preferred) {
		return preferred, nil
	}
	// On a height field a step of one world unit stays on the same 1m
	// ground node, so the rings step by nodes instead: the nearest standable
	// node within maxPlaceRings metres.
	step := int64(1)
	if p.terrain.Surface() != nil {
		step = terrain.SampleSpacing
	}
	for ring := int64(1); ring <= maxPlaceRings; ring++ {
		for dx := -ring; dx <= ring; dx++ {
			for dy := -ring; dy <= ring; dy++ {
				// Only the ring's edge: the inside was covered by the
				// previous rounds.
				if dx != -ring && dx != ring && dy != -ring && dy != ring {
					continue
				}
				candidate := spatial.Point{X: preferred.X + dx*step, Y: preferred.Y + dy*step}
				if p.terrain.Standable(candidate) {
					return candidate, nil
				}
			}
		}
	}
	return spatial.Point{}, fmt.Errorf("scene pathfind: no free point within %d of (%d,%d)", maxPlaceRings*step, preferred.X, preferred.Y)
}

var _ scene.PathFind = (*PathFindSystem)(nil)
