package scene

import (
	"fmt"
	"time"

	"github.com/tjbdwanghaibo/roost-core/gameplay/terrain"
	"github.com/tjbdwanghaibo/roost-core/infra/base/spatial"
)

// Package scene is the contract between the Scene Entity and the systems that
// make it up. Both sides import this package and neither imports the other,
// which is what keeps the Entity and its runtime in separate packages without
// an import cycle.
//
// Every system here is declared as an interface for two reasons. The Scene
// Entity hands these out to whoever asks (`scene.Terrain()`), so callers
// depend on what a system promises rather than on how it is built; and each
// implementation is free to carry its own lock, which is the rule for this
// runtime: **a system is safe to call from any goroutine**. The Entity's own
// lock orders transactions over entity STATE; it says nothing about a
// neighbour query arriving from a timer, so the systems do not lean on it.

// Config shapes a scene. Width and Height are the map in world units,
// BlockSize is the AOI grid's cell, Spawn is where a player with no
// remembered position starts, and View is the main view of the scene's
// replication (the area of interest every player, monster and building is
// seen through).
type Config struct {
	Width     int64
	Height    int64
	BlockSize int64
	Spawn     spatial.Point
	View      View
}

// View 是场景主视野（场景同步 policy.Interest 的 AOI 视野，玩家、怪、建筑共用一个）的尺度，世界单位厘米：
//   - EnterRadius / LeaveRadius：缺省视野的进入 / 离开半径，差值是滞回量（站在边上不反复进出）；
//   - MinRadius / MaxLeaveRadius / RadiusStep：客户端可以要的视野（scene_view）先夹到 [MinRadius, MaxLeaveRadius − 滞回量]，
//     再从 MinRadius 起按 RadiusStep 向下取整；客户端最大视野（进入半径）= MaxLeaveRadius − 滞回量；
//   - MaxVisible：主视野“最近 N 个”（AOI 的 MaxVisible：范围里多于 N 个时只留最近的 N 个）。一个会话能持有的对象数
//     （场景 Manager 的 Limits.MaxObjects）由它推出：N + 自身 / 场景 / 队友 3 + 留给关系视野的 33
//     （internal/service/<game>/scene.go 的 sceneSessionObjects），所以名额与会话上限一起随尺度定。
//
// 观察者的块预算按 MaxLeaveRadius / Config.BlockSize 算（(⌈2·MaxLeaveRadius / BlockSize⌉ + 1)² 块，policy 的缺省上限 1024），
// 所以视野与块边长要一起定：TerrainConfig 把两者一起放大。
type View struct {
	EnterRadius    int64
	LeaveRadius    int64
	MinRadius      int64
	MaxLeaveRadius int64
	RadiusStep     int64
	MaxVisible     int
}

// DefaultView 是 demo 原来的尺度：进入 1.2m、离开 1.5m、客户端 0.6m～2.7m（离开 3m）、步长 0.3m、最近 64 个（会话 100），
// 按 0.6m/s 走路的人设计，配 100（1m）的块：最坏每个观察者 64 块。不开地形的场景与分区场景的 Base 都用它（分区场景的 witness 半径按它的离开
// 上限校验：settings.PartitionMaxBaseLeaveRadius）。
func DefaultView() View {
	return View{EnterRadius: 120, LeaveRadius: 150, MinRadius: 60, MaxLeaveRadius: DefaultMaxLeaveRadius, RadiusStep: 30, MaxVisible: 64}
}

// DefaultMaxLeaveRadius 是 DefaultView 的离开上限（常量，供分区场景的编译期一致性断言）。
const DefaultMaxLeaveRadius = 300

// TerrainView 是开地形的普通场景的主视野：游戏尺度（维护者 2026-11-10 口径“一般视野是 32m 左右”“同步的 entity 数量一般是
// 128 左右”，可编辑地形方案 §29；§28 的 30m / 64 个由它取代）。进入 32m（正好一个 AOI 块边长）、离开 35.2m（滞回 10%）、
// 客户端 16m～64m（离开 67.2m，客户端最大约缺省的 2 倍）、步长 3.2m、最近 128 个（会话 164）。最小值与步长按原尺度的比例
// （最小 = 缺省的一半、步长 = 滞回量），32m 与 64m 都在量化网格上（16 + 5 × 3.2、16 + 15 × 3.2）；滞回取 3m 时 16m 起
// 按 3m 取整得不到 32m 与 64m。建筑边长 3～12m、按占地中心进视野，人站在建筑旁边看得见它（keep 中心离旁边的节点 6.5m）；
// 玩家与怪用同一个视野。
func TerrainView() View {
	return View{EnterRadius: 3200, LeaveRadius: 3520, MinRadius: 1600, MaxLeaveRadius: 6720, RadiusStep: 320, MaxVisible: 128}
}

// TerrainBlockSize 是开地形的普通场景的 AOI 块边长（32m，半个地形块）。视野放大到游戏尺度后块边长 100 不再可用：缺省视野
// 每个观察者 72² = 5184 块、客户端最大视野 136² = 18496 块，都超过 policy 的观察者块预算 1024，构造即拒绝
// （ErrInterestBudget）。32m 时缺省视野最坏 4² = 16 块、最大视野 6² = 36 块。方案 §28 在 30m 视野上同机交替测量选定
// （32m 与 16m 每次复制在噪声内相同、都比 10m 快，32m 订阅的块最少），§29 在 32m 视野、2048m 地图上复核。
const TerrainBlockSize = 3200
// DefaultConfig is the demo's one map: a 1000×1000 field on a 100-unit grid,
// seen at the demo's scale (DefaultView).
func DefaultConfig() Config {
	return Config{Width: 1000, Height: 1000, BlockSize: 100, Spawn: spatial.Point{X: 500, Y: 500}, View: DefaultView()}
}

// TerrainConfig is an ordinary scene's map with editable terrain: the terrain
// map itself (terrain.Meta.Bounds — origin (0, 0), one world unit is a
// centimetre), so every place of the map can be walked to and nothing outside
// it can, seen at the game's scale (TerrainView on TerrainBlockSize blocks:
// editable terrain plan §29). The spawn point stays the default map's (a
// terrain map is at least one chunk, 64m, so it always contains it).
//
// A map larger than maxTerrainArea (2048m × 2048m, 32 × 32 chunks) is
// refused, with a reason: a world that size is a partitioned scene's
// (scene.partition), not one process's. The limit is the ordinary scene's
// map budget, not the AOI block table's (2048m is 64 × 64 blocks of 32m,
// about 0.2MiB of index): the whole terrain of an ordinary scene is loaded
// into the one process, and plan §29 measured that load at 2048m (the
// maintainer's 2026-11-10 bar: one process holds at least 2048m × 2048m).
func TerrainConfig(bounds spatial.Rect) (Config, error) {
	config := DefaultConfig()
	bounds = spatial.NormalizeRect(bounds)
	if bounds.Min != (spatial.Point{}) || bounds.Empty() {
		return Config{}, fmt.Errorf("scene: terrain map %v must start at (0, 0) and not be empty", bounds)
	}
	if bounds.Max.X > maxTerrainArea/bounds.Max.Y {
		return Config{}, fmt.Errorf("scene: terrain map %d × %d is too large for an ordinary scene: at most %dm² (about %dm × %dm); use a partitioned scene (scene.partition) for a map this size",
			bounds.Max.X, bounds.Max.Y, maxTerrainArea/100/100, maxTerrainSide/100, maxTerrainSide/100)
	}
	cols, rows := spatial.DivideCeil(bounds.Max.X, TerrainBlockSize), spatial.DivideCeil(bounds.Max.Y, TerrainBlockSize)
	if cols > spatial.MaxBlockCount/rows {
		// 面积上限之内不会发生（2048m 见方是 64 × 64 块）；留着是为了块边长将来改小时不会悄悄越过块表上限。
		return Config{}, fmt.Errorf("scene: terrain map %d × %d needs %d × %d AOI blocks of %d, at most %d", bounds.Max.X, bounds.Max.Y, cols, rows, TerrainBlockSize, spatial.MaxBlockCount)
	}
	config.Width, config.Height = bounds.Max.X, bounds.Max.Y
	config.BlockSize, config.View = TerrainBlockSize, TerrainView()
	return config, nil
}

// maxTerrainSide is the side of the largest square map TerrainConfig accepts
// (world units: 2048m), and maxTerrainArea its area.
const (
	maxTerrainSide = 2048 * 100
	maxTerrainArea = maxTerrainSide * maxTerrainSide
)

func (c Config) Normalize() Config {
	if c.Width <= 0 {
		c.Width = DefaultConfig().Width
	}
	if c.Height <= 0 {
		c.Height = DefaultConfig().Height
	}
	if c.BlockSize <= 0 {
		c.BlockSize = DefaultConfig().BlockSize
	}
	// 没给视野（零值）取 demo 原尺度：分区场景的 Base 世界、测试夹具手写的 Config 都是这样。
	if c.View == (View{}) {
		c.View = DefaultView()
	}
	// 给了半径没给名额：取 demo 原尺度的 64（0 在 AOI 里是“不限”，会让会话上限推不出来）。
	if c.View.MaxVisible <= 0 {
		c.View.MaxVisible = DefaultView().MaxVisible
	}
	return c
}

// Terrain is the map itself: where the edges are, what can be stood on, and
// who is standing where in the sense of "this point is taken".
//
// Occupancy is here rather than in the AOI index because it is a property of
// the GROUND, not of who is looking: two objects cannot share a point whether
// or not anybody can see them.
type Terrain interface {
	Bounds() spatial.Rect
	// Walkable reports whether a point is inside the map and not blocked.
	Walkable(point spatial.Point) bool
	// Occupy takes a point for an object, failing if it is out of bounds or
	// already taken. Release gives it back.
	Occupy(point spatial.Point) error
	Release(point spatial.Point)
	// MoveOccupied is Occupy(to) + Release(from) as one step, so a failed
	// move cannot lose the object's own point.
	MoveOccupied(from, to spatial.Point) error

	// Surface is the map's height field (editable terrain, P3 movement and
	// pathfinding: slopes, steps, drops and swimming by gameplay/terrain's
	// Walker), nil when there is none — no scene.terrain.pack, or a
	// partitioned scene whose positions belong to the cells. Without it every
	// walk, route and placement is exactly the flat grid's.
	Surface() *terrain.Walker
	// SetSurface installs the height field (the game service, once, after the
	// terrain is loaded and before a player can join); the walker is bounded
	// to this map. Nil takes it down.
	SetSurface(walker *terrain.Walker)
	// Standable reports whether something may be put at the point: Walkable,
	// and on a height field a ground node that can be entered (loaded, not
	// occupied, not deep water without swimming). It is the check for a
	// teleport, a spawn or a route's goal; a walk already under way is
	// checked step by step instead (movement.Surface), so it can leave a node
	// it could not have been put on.
	Standable(point spatial.Point) bool
}

// PathFind answers "can I get there" and "where can I stand".
type PathFind interface {
	// Path is the walkable route between two points, start and goal
	// included. It fails when no route exists within the search budget.
	Path(from, to spatial.Point) ([]spatial.Point, error)
	// Place finds somewhere to stand at or near preferred: the spawn point
	// of a player whose remembered position is now blocked, the landing spot
	// of a respawned monster. It searches outward in rings, so the result is
	// the nearest free point, not merely a free one.
	Place(preferred spatial.Point) (spatial.Point, error)
}

// Entity is what the runtime needs from the Scene that owns it. It is
// deliberately tiny: a system that wants more of the Entity is a system that
// is about to create an import cycle.
type Entity interface {
	ID() int64
}

// Who receives whose state is not part of this contract any more: the
// area-of-interest policy lives in roost-core (`entitysync/policy.Interest`)
// and is assembled by the replication bridge, which is also the only place
// that knows about sessions. The scene runtime is the MAP — where things are
// and where they may stand — and the policy asks it nothing; it keeps its own
// spatial index from the same Config.

// --- 刷新：场景该有多少东西活着 ---

// SpawnRequest is one thing the scene wants created. The refresh system does
// not create it: building an Entity needs the lifecycle, the lifecycle needs
// the entity packages, and the entity packages hold this runtime — so the
// system says what it wants and the assembly does it.
type SpawnRequest struct {
	// Group is the spawn table row this came from; the assembly hands it back
	// with Spawned so the system can count the population per row.
	Group    int32
	Template int32
	HP       int64
	At       spatial.Point
}

// Refresh keeps the scene's population at what the spawn table says.
type Refresh interface {
	// Due returns what should be created now: one request per missing
	// member whose respawn delay has elapsed. Calling it twice without
	// Spawned in between returns the same requests again — the system counts
	// what it has been TOLD exists, not what it has asked for, because a
	// spawn that failed must be asked for again.
	Due(now time.Time) []SpawnRequest
	// Spawned reports a created member. Until it is called the member does
	// not count towards the group.
	Spawned(group int32, id int64)
	// Died reports a member gone and queues its slot for the group's respawn
	// delay.
	Died(id int64, now time.Time)
	// Alive lists every member the system believes exists, for the assembly
	// to clean up on shutdown.
	Alive() []int64
}
