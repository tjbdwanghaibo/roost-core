package clientsync

import (
	"{{MODULE}}/db"
	"fmt"
	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

// DecodeFields 将公开的 PB patch 转为机器人按字段名读取的视图。
// 未出现在 patch 中的字段不更新；该动态入口只接受字段替换；集合差分接入应使用生成的 ApplySyncX 后读取 Values。
func DecodeFields(update entity.SubjectSyncUpdate) (map[string]any, error) {
	if update.Payload.Codec() != 2 {
		return nil, fmt.Errorf("unsupported DAO sync codec %d", update.Payload.Codec())
	}
	switch update.Namespace {
	case "player":
		patch, err := db.UnmarshalSyncPlayerDao(update.Payload.BytesCopy())
		if err != nil {
			return nil, err
		}
		return patch.Values()
	case "monster":
		patch, err := db.UnmarshalSyncMonsterDao(update.Payload.BytesCopy())
		if err != nil {
			return nil, err
		}
		return patch.Values()
	case "scene":
		patch, err := db.UnmarshalSyncSceneDao(update.Payload.BytesCopy())
		if err != nil {
			return nil, err
		}
		return patch.Values()
	case "building":
		// 开地形的场景把站着的建筑放进主视野（与怪同一条链路，building_sync.go）：机器人与演练程序的帧里会有它。
		patch, err := db.UnmarshalSyncBuildingDao(update.Payload.BytesCopy())
		if err != nil {
			return nil, err
		}
		return patch.Values()
	default:
		return nil, fmt.Errorf("unknown sync namespace %q", update.Namespace)
	}
}

// 档案是 profile 模块的两个顶层同步字段，DecodeFields 给出的是它们的整值：键 profile 下是别的玩家也看得到的
// 那一半（名字、等级），键 profile_private 下是只给本人的那一半（等级内经验）。下面三个函数按这个形状读。

// PlayerName 读一名玩家的名字；这份视图里没有 profile 时 ok 为假。
func PlayerName(fields map[string]any) (name string, ok bool) {
	profile, ok := fields["profile"].(db.SyncProfileState)
	return profile.Name, ok
}

// PlayerLevel 读一名玩家的等级；这份视图里没有 profile 时 ok 为假。
func PlayerLevel(fields map[string]any) (level int32, ok bool) {
	profile, ok := fields["profile"].(db.SyncProfileState)
	return profile.Level, ok
}

// PlayerExp 读玩家本人的等级内经验；这份视图里没有 profile_private 时（别的玩家的视图都没有）ok 为假。
func PlayerExp(fields map[string]any) (exp int64, ok bool) {
	private, ok := fields["profile_private"].(db.SyncProfilePrivateState)
	return private.Exp, ok
}

// PlayerCoins 读玩家自己的钱包；没有 wallet 的视图不能按余额零处理。
func PlayerCoins(fields map[string]any) (coins int64, ok bool) {
	wallet, ok := fields["wallet"].(db.SyncWalletState)
	return wallet.Coins, ok
}
