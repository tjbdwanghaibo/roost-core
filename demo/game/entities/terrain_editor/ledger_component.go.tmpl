package terrain_editor

import (
	"{{MODULE}}/game/components/terrainledger"
	"{{MODULE}}/game/view"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type=2012
const CompTypeLedger entity.ComponentType = 2012

// LedgerComponent 是 game/components/terrainledger 的组件在 TerrainEditor 上的名字（生成接线与 handler 用它）；业务在那个包里。
type LedgerComponent = terrainledger.Component

// ILedgerEntity is the narrow lock-safe view for Nest handlers.
type ILedgerEntity interface {
	entity.IThreadSafeEntity
	LedgerComp() *LedgerComponent
}

// TerrainLedger 是账本组件在 game/view 里的名字（view.TerrainLedgerHolder）：组件类型名是 Ledger，生成器按这个手写访问器把 Holder 嵌进 view.TerrainEditorEntity。
func (e *TerrainEditor) TerrainLedger() view.TerrainLedger { return e.LedgerComp() }

func init() {
	entity.RegisterComponentFactory(CompTypeLedger, terrainledger.NewComponent)
}
