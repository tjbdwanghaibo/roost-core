package alliance_member

import (
	db "{{MODULE}}/db"
	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

const EntityKindAllianceMember entity.EntityKind = 7

// IAllianceMemberEntity is the lock-safe business view used by Nest handlers.
type IAllianceMemberEntity interface{ entity.IThreadSafeEntity }

// AllianceMember is one player's alliance guard, owned by the alliance
// service: its unique id is the player's. It is not preloaded (one per
// player who ever joined): an instance loads it on the first request routed
// to it, and the instance that creates it first owns it (the claim is atomic,
// plan §2.5). It enforces "one player, one alliance" across alliances
// that may be on different service instances (game/alliancerule, plan §2.5)
// and is not a second roster — the alliance's Members is the authority.
//
// remote=managed, EntityCategoryRemote and service=alliance for the same
// reasons as Alliance.
//
//roost:entity id=7 entityKind=EntityKindAllianceMember category=entity.EntityCategoryRemote remote=managed service=alliance
type AllianceMember struct {
	*entity.RemoteEntityBase
	entity.ComponentManager
	entity.DaoManager
	guard *GuardComponent       `comp:"CompTypeGuard"`
	dao   *db.AllianceMemberDao `dao:"alliance_member"`
}
