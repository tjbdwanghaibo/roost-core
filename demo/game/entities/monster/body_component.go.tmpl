package monster

import (
	"{{MODULE}}/game/components/monsterbody"
	"{{MODULE}}/game/view"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type=2100
const CompTypeBody entity.ComponentType = 2100

// BodyComponent 是 game/components/monsterbody 的组件在 Monster 上的名字（生成接线与 handler 用它）；业务在那个包里。
type BodyComponent = monsterbody.Component

// IBodyEntity is the narrow lock-safe view for Nest handlers.
type IBodyEntity interface {
	entity.IThreadSafeEntity
	BodyComp() *BodyComponent
}

// MonsterBody 是身体组件在 game/view 里的名字（view.MonsterBodyHolder）：组件类型名是 Body，生成器按这个手写访问器把 Holder 嵌进 view.MonsterEntity。
func (monster *Monster) MonsterBody() view.MonsterBody { return monster.BodyComp() }

func init() {
	entity.RegisterComponentFactory(CompTypeBody, monsterbody.NewComponent)
}
