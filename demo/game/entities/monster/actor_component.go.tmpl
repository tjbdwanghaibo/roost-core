package monster

import (
	"{{MODULE}}/game/components/monsteractor"
	"{{MODULE}}/game/view"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/gameplay/movement"
)

//roost:component type=2101
const CompTypeActor entity.ComponentType = 2101

// ActorComponent 是 game/components/monsteractor 的组件在 Monster 上的名字（生成接线与 handler 用它）；业务在那个包里。
type ActorComponent = monsteractor.Component

// IActorEntity is the narrow lock-safe view for Nest handlers that drive a
// monster.
type IActorEntity interface {
	entity.IThreadSafeEntity
	ActorComp() *ActorComponent
}

// MapBasic and MoveComponent make the Monster a movement.MapOwner and a
// movement.MoveOwner: the walk parts live in the MonsterActor component.
func (monster *Monster) MapBasic() *movement.MapBasic { return monster.ActorComp().MapBasic() }

func (monster *Monster) MoveComponent() *movement.Move { return monster.ActorComp().Move() }

var (
	_ movement.MapOwner  = (*Monster)(nil)
	_ movement.MoveOwner = (*Monster)(nil)
)

// MonsterActor 是行动组件在 game/view 里的名字（view.MonsterActorHolder）：组件类型名是 Actor，生成器按这个手写访问器把 Holder 嵌进 view.MonsterEntity。
func (monster *Monster) MonsterActor() view.MonsterActor { return monster.ActorComp() }

func init() {
	entity.RegisterComponentFactory(CompTypeActor, monsteractor.NewComponent)
}
