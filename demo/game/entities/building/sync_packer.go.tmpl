package building

import (
	"fmt"

	db "{{MODULE}}/db"
	"github.com/tjbdwanghaibo/roost-core/framework/dataengine"
	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

// BuildingSyncCodec 是建筑同步载荷的编码号：载荷是 BuildingDao 的同步 PB（MarshalSync），客户端交给生成的
// ApplySyncBuildingDao（C# / C++ 用同一份 dao_sync.proto 的生成 Apply）。与 Player / Monster 的 packer 同一个形状：
// 同步链路对“不是玩家的东西”没有特例（方案 §27）。
const BuildingSyncCodec uint16 = 2

// buildingViews：建筑的同步字段——State、Owner、ConfigID、Params、Facing、GX、GY、Foundation（DAO 上全部标了 sync 的字段；
// 占地宽高与 BaseRevision 只持久，不下发）——对谁都公开，三个视图字段相同：near 是场景主视野给的层级（与玩家、怪同一个），
// team 是队伍关系视野的层级（建筑不会是队员，场景的 Interest 要求每类实体都声明它用到的每个层级），default 是缺省视图。
// 优先级与 Player / Monster 的同名视图一致（Manager 只有一张优先级表，entity.MergeSyncViewPriorities 要求一致）。
var buildingViews, buildingViewsErr = dataengine.NewSyncViewSet(db.BuildingDaoSyncFields(),
	entity.NamedSyncView{Profile: entity.SyncProfile{}, Fields: []string{"*"}, Priority: -1},
	entity.NamedSyncView{Profile: entity.SyncProfile{Key: "near"}, Fields: []string{"*"}, Priority: 0},
	entity.NamedSyncView{Profile: entity.SyncProfile{Key: "team"}, Fields: []string{"*"}, Priority: -1},
)

// SyncViews 是 Building 的视图集，用途同 player.SyncViews。
func SyncViews() (*entity.SyncViewSet, error) { return buildingViews, buildingViewsErr }

// NewBuildingSyncPacker 是实体标记 subjectPacker= 指名的工厂。全量与增量都是按字段的 MarshalSync：一座建筑的同步字段
// 合起来几十字节，改参数时整个 Params 字段重发（至多 8 个 int32），不需要按下标的变化树。
func NewBuildingSyncPacker(value entity.IThreadSafeEntity) entity.SubjectSyncPacker {
	owner, _ := value.(*Building)
	return buildingSyncPacker{building: owner}
}

type buildingSyncPacker struct{ building *Building }

func (packer buildingSyncPacker) PackSubjectSnapshot(profile entity.SyncProfile) (entity.FrozenSyncPayload, error) {
	return packer.pack(profile, dataengine.AllFields, false)
}

func (packer buildingSyncPacker) PackSubjectDelta(profile entity.SyncProfile, mask uint64) (entity.FrozenSyncPayload, error) {
	return packer.pack(profile, mask, true)
}

// pack 只交出视图允许的字段；未知视图返回 entity.ErrSyncViewUnknown，不扩大字段权限。
// pack 编码视图允许的字段。delta 为真时是增量：DAO 补丁不带实体 ID（MarshalSyncDelta，客户端沿用基线的），
// 全量仍带。
func (packer buildingSyncPacker) pack(profile entity.SyncProfile, mask uint64, delta bool) (entity.FrozenSyncPayload, error) {
	if buildingViewsErr != nil {
		return entity.FrozenSyncPayload{}, fmt.Errorf("building sync packer: %w", buildingViewsErr)
	}
	if packer.building == nil {
		return entity.FrozenSyncPayload{}, fmt.Errorf("building sync packer: the entity is not a *Building")
	}
	view, ok := buildingViews.Lookup(profile)
	if !ok {
		return entity.FrozenSyncPayload{}, fmt.Errorf("%w: %+v", entity.ErrSyncViewUnknown, profile)
	}
	if mask &= view.Fields; mask == 0 {
		return entity.FrozenSyncPayload{}, nil
	}
	var raw []byte
	if delta {
		raw = packer.building.Dao().MarshalSyncDelta(mask)
	} else {
		raw = packer.building.Dao().MarshalSync(mask)
	}
	if len(raw) == 0 {
		return entity.FrozenSyncPayload{}, nil
	}
	return entity.TakeFrozenSyncPayload(BuildingSyncCodec, raw), nil
}
