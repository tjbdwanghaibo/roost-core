package building

import (
	"fmt"
	"slices"

	db "{{MODULE}}/db"
	terrain_chunk "{{MODULE}}/game/entities/terrain_chunk"
	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type=2013
const CompTypeSite entity.ComponentType = 2013

// Placement 是一次放置请求（越过 Nest 边界的值，生成的 Sender 只依赖这里）：建筑配置 ID、修改参数值（个数不多于配置的
// 槽数，没给的取缺省值，见 Spec.Normalize）、锚点节点（占地左下角的 1m 采样点）、朝向 0～3、是否整平地基。Params 由调用方
// 交出、之后不再改。
type Placement struct {
	ConfigID int32
	Params   []int32
	GX, GY   int64
	Facing   int32
	Level    bool
}

// Lot 是这次放置在配置 spec 上的占地：配置的宽高按朝向转（1、3 时互换）。朝向不合法时 ok 为 false。
func (p Placement) Lot(spec Spec) (terrain_chunk.Lot, bool) { return spec.Lot(p.GX, p.GY, p.Facing) }

// Result 是一次放置 / 拆除 / 改参数（handler BuildingPlace / BuildingRemove / BuildingParams）的结果：Duplicate 表示这个（玩家, 序号）已经应用过、
// 这次什么都没写；Building 是建筑此刻的状态（拆除后 State 为 0）；Chunks 是占地覆盖的每一块此后的地形版本（整平改了
// 地形的块版本加一；改参数不碰块，为空）；LastSeq 是玩家编辑账本此后的 LastSeq。
type Result struct {
	Duplicate bool
	Building  State
	Chunks    []terrain_chunk.ChunkVersion
	LastSeq   int64
}

// Rebase 是一次换版对账（handler BuildingRebase）的结论：Rebased 表示建筑原来基于另一版原始地形（From），这次按当前版本
// 处置了；Levelled 表示在新地形上重新整平了地基；Unfit 非 nil 表示处置之后不合规（在水下、高差超限），建筑仍保留；
// Misconfigured 非 nil 表示建筑的配置 ID 在当前配置里没有了、或按配置与朝向推出的占地与存下的占地不同（配置改了宽高），
// 建筑仍保留、什么都不改（每次启动都查，与原始地形是否换版无关）。
type Rebase struct {
	Rebased       bool
	From          int64
	Levelled      bool
	Unfit         error
	Misconfigured error
}

// State 是建筑的一份只读快照（Site 的字段；Params 是副本）。
type State struct {
	ID           int64
	Standing     bool
	Owner        int64
	ConfigID     int32
	Params       []int32
	Facing       int32
	Lot          terrain_chunk.Lot
	Foundation   int32 // 整平地基的世界高度（厘米）；Leveled 为 false 时没有意义
	Leveled      bool
	BaseRevision int64
}

// SiteComponent 是一座建筑的数据，全部在 BuildingDao（回滚统一走 DAO，组件不持有需要回滚的内存状态）。方法只在本实体的
// Nest 锁内调用。
type SiteComponent struct {
	entity.ComponentBase
	owner *Building
}

// ISiteEntity is the narrow lock-safe view for Nest handlers.
type ISiteEntity interface {
	entity.IThreadSafeEntity
	SiteComp() *SiteComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeSite, func(owner any, _ *entity.EntityCreateParam) (entity.ComponentInterfaceBase, error) {
		typed, ok := owner.(*Building)
		if !ok {
			return nil, fmt.Errorf("building site component: owner %T is not *Building", owner)
		}
		return &SiteComponent{owner: typed}, nil
	})
}

func (component *SiteComponent) Name() string { return "building_site" }

// Owner is available only while the Entity is alive and locked by Nest.
func (component *SiteComponent) Owner() *Building { return component.owner }

// noFoundation 是 BuildingDao.Foundation 里“没有整平”的值。
const noFoundation = -1 << 31

// State 是建筑当前的快照。
func (component *SiteComponent) State() State {
	b := component.Owner()
	dao := b.Dao()
	gx, gy := b.Anchor()
	s := State{
		ID: b.ID(), Standing: dao.GetState() == 1, Owner: dao.GetOwner(), ConfigID: dao.GetConfigID(), Params: params(dao),
		Facing: dao.GetFacing(),
		Lot: terrain_chunk.Lot{GX: gx, GY: gy, W: dao.GetW(), H: dao.GetH()}, BaseRevision: dao.GetBaseRevision(),
	}
	if f := dao.GetFoundation(); f != noFoundation {
		s.Foundation, s.Leveled = f, true
	}
	return s
}

// Standing 报告这里是否站着一座建筑。
func (component *SiteComponent) Standing() bool { return component.Owner().Dao().GetState() == 1 }

// Place 记下一座新建筑（放置事务里，调用方已完成全部校验）。params 是按配置补齐、校验过的参数值；foundation 是整平
// 地基的世界高度（厘米），leveled 为 false 时不整平。锚点由实体 ID 决定，lot 的锚点必须与它相同。
func (component *SiteComponent) Place(owner int64, p Placement, params []int32, lot terrain_chunk.Lot, foundation int32, leveled bool, baseRevision int64) error {
	gx, gy := component.Owner().Anchor()
	if lot.GX != gx || lot.GY != gy {
		return fmt.Errorf("building %d: anchor (%d, %d) is not the lot's %v", component.Owner().ID(), gx, gy, lot)
	}
	if !leveled {
		foundation = noFoundation
	}
	dao := component.Owner().Dao()
	dao.SetState(1)
	dao.SetOwner(owner)
	dao.SetConfigID(p.ConfigID)
	dao.SetParamsAll(slices.Clone(params))
	dao.SetFacing(p.Facing)
	dao.SetGX(int32(gx))
	dao.SetGY(int32(gy))
	dao.SetW(lot.W)
	dao.SetH(lot.H)
	dao.SetFoundation(foundation)
	dao.SetBaseRevision(baseRevision)
	component.Owner().PublishSyncDirty()
	return nil
}

// SetParams 改修改参数值（改参数事务里，调用方已按配置校验过）：只写 Params，不碰占地；值与现在相同时不写。
func (component *SiteComponent) SetParams(values []int32) {
	dao := component.Owner().Dao()
	if slices.Equal(params(dao), values) {
		return
	}
	dao.SetParamsAll(slices.Clone(values))
	component.Owner().PublishSyncDirty()
}

// Rebase 记下建筑已按新的原始地形版本处置（原始地形换版后的对账，见 terrainmap 的建筑对账）。
func (component *SiteComponent) Rebase(baseRevision int64) {
	component.Owner().Dao().SetBaseRevision(baseRevision)
}

// AnchorRecorded 报告 DAO 里的锚点（GX / GY）是否等于实体 ID 推出的锚点（对账核对；两者总在放置事务里一起写）。
func (component *SiteComponent) AnchorRecorded() bool {
	gx, gy := component.Owner().Anchor()
	dao := component.Owner().Dao()
	return int64(dao.GetGX()) == gx && int64(dao.GetGY()) == gy
}

// Clear 拆除：State 置 0、字段清空（不删档，同一锚点之后可以再放）。
func (component *SiteComponent) Clear() {
	dao := component.Owner().Dao()
	dao.SetState(0)
	dao.SetOwner(0)
	dao.SetConfigID(0)
	dao.SetParamsAll(nil)
	dao.SetFacing(0)
	dao.SetGX(0)
	dao.SetGY(0)
	dao.SetW(0)
	dao.SetH(0)
	dao.SetFoundation(0)
	dao.SetBaseRevision(0)
	component.Owner().PublishSyncDirty()
}

// params 是 DAO 里参数值的副本。
func params(dao *db.BuildingDao) []int32 {
	out := make([]int32, dao.ParamsLen())
	for i := range out {
		out[i], _ = dao.GetParams(i)
	}
	return out
}

// Equal 报告两份快照是否相同（State 含切片，不能用 ==）。
func (s State) Equal(o State) bool {
	return s.ID == o.ID && s.Standing == o.Standing && s.Owner == o.Owner && s.ConfigID == o.ConfigID &&
		slices.Equal(s.Params, o.Params) && s.Facing == o.Facing && s.Lot == o.Lot && s.Foundation == o.Foundation &&
		s.Leveled == o.Leveled && s.BaseRevision == o.BaseRevision
}
