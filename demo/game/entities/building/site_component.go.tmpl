package building

import (
	"{{MODULE}}/game/components/buildingsite"
	"{{MODULE}}/game/view"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type=2013
const CompTypeSite entity.ComponentType = 2013

// SiteComponent 是 game/components/buildingsite 的组件在 Building 上的名字（生成接线与 handler 用它）；业务在那个包里。
type SiteComponent = buildingsite.Component

// ISiteEntity is the narrow lock-safe view for Nest handlers.
type ISiteEntity interface {
	entity.IThreadSafeEntity
	SiteComp() *SiteComponent
}

// BuildingSite 是建筑组件在 game/view 里的名字（view.BuildingSiteHolder）：组件类型名是 Site，生成器按这个手写访问器把 Holder 嵌进 view.BuildingEntity。
func (b *Building) BuildingSite() view.BuildingSite { return b.SiteComp() }

func init() {
	entity.RegisterComponentFactory(CompTypeSite, buildingsite.NewComponent)
}
