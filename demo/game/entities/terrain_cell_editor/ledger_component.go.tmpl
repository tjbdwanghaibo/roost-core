package terrain_cell_editor

import (
	"{{MODULE}}/game/components/terraincellledger"
	"{{MODULE}}/game/view"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type=2014
const CompTypeLedger entity.ComponentType = 2014

// LedgerComponent 是 game/components/terraincellledger 的组件在 TerrainCellEditor 上的名字（生成接线与 handler 用它）；业务在那个包里。
type LedgerComponent = terraincellledger.Component

// ILedgerEntity is the narrow lock-safe view for Nest handlers.
type ILedgerEntity interface {
	entity.IThreadSafeEntity
	LedgerComp() *LedgerComponent
}

// TerrainCellLedger 是账本组件在 game/view 里的名字（view.TerrainCellLedgerHolder）：组件类型名是 Ledger，生成器按这个手写访问器把 Holder 嵌进 view.TerrainCellEditorEntity。
func (e *TerrainCellEditor) TerrainCellLedger() view.TerrainCellLedger { return e.LedgerComp() }

func init() {
	entity.RegisterComponentFactory(CompTypeLedger, terraincellledger.NewComponent)
}
