package alliance

import (
	"cmp"
	"slices"

	"{{MODULE}}/game/alliancerule"
)

// AllianceMirror is what a game server reads of an alliance: the snapshot the
// owning alliance instance publishes after every commit (Remote mirror, plan
// §2.4), decoded into the fields declared here — the owner DAO's persisted
// keys (db/def/alliance.go); receipts and join request ids are not read.
//
// It is read-only and eventually consistent. Cached reads may be up to
// remote_entity.cached_max_staleness old; a read right after this player's own
// write asks Monotonic with the version the write RPC answered, so it never
// shows a state older than that write. Nothing decides a write from it: the
// alliance service decides on its authoritative state.
//
// The generated NewAllianceMirrorReader binds it to
// wiring/remoteentity.MirrorSource (the game's remote_mirror Mod).
//
//roost:mirror entityKind=EntityKindAlliance coll=alliance
type AllianceMirror struct {
	Name         string                       `bson:"name"`
	LeaderID     int64                        `bson:"leader_id"`
	OpenJoin     bool                         `bson:"open_join"`
	Funds        int64                        `bson:"funds"`
	Members      map[int64]AllianceMirrorSeat `bson:"members"`
	Applications map[int64]struct{}           `bson:"applications"`
	Wars         map[int64]int64              `bson:"wars"`
}

// AllianceMirrorSeat is one member as the mirror carries it.
type AllianceMirrorSeat struct {
	Role         int32 `bson:"role"`
	HomeSID      int32 `bson:"home_sid"`
	Contribution int64 `bson:"contribution"`
}

// Founded reports whether the snapshot is a founded alliance. An alliance id
// that was minted but whose founding expired exists only as an empty record
// (alliance_expired): a reader treats it as missing.
func (m AllianceMirror) Founded() bool { return m.LeaderID != 0 }

// View is the mirror in the shape a write answers with (alliancerule.View,
// the reply of every alliance write), so the game shows a write's reply and a
// later mirror read the same way. version is the snapshot's state version.
func (m AllianceMirror) View(allianceID int64, version int64) alliancerule.View {
	view := alliancerule.View{
		AllianceID: allianceID, Name: m.Name, LeaderID: m.LeaderID, OpenJoin: m.OpenJoin, Funds: m.Funds, Version: version,
	}
	for playerID, seat := range m.Members {
		view.Members = append(view.Members, alliancerule.MemberView{PlayerID: playerID, Role: seat.Role, Contribution: seat.Contribution})
	}
	slices.SortFunc(view.Members, func(a, b alliancerule.MemberView) int { return cmp.Compare(a.PlayerID, b.PlayerID) })
	for playerID := range m.Applications {
		view.Applicants = append(view.Applicants, playerID)
	}
	slices.Sort(view.Applicants)
	for enemyID := range m.Wars {
		view.Wars = append(view.Wars, enemyID)
	}
	slices.Sort(view.Wars)
	return view
}
