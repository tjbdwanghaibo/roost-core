//roost:component type=2008
const CompTypeRoster entity.ComponentType = 2008

// RosterComponent is the alliance's rules: who is in it, who may do what,
// and the request receipts.
//
// Every write follows one shape (alliancerule.Execute): look the request id
// up, check everything the write depends on, then change the DAO — so a
// rejection changes nothing but its own receipt — and only then record
// effects. It keeps no state of its own; everything a transaction changes is
// in the DAO, whose undo is the rollback.
type RosterComponent struct {
	entity.ComponentBase
	owner *Alliance
}

// IRosterEntity is the narrow lock-safe view for Nest handlers using this
// component. The generated Entity wire implements the getter.
type IRosterEntity interface {
	entity.IThreadSafeEntity
	RosterComp() *RosterComponent
}

func init() {
	entity.RegisterComponentFactory(CompTypeRoster, func(owner any, _ *entity.EntityCreateParam) (entity.ComponentInterfaceBase, error) {
		typed, ok := owner.(*Alliance)
		if !ok {
			return nil, fmt.Errorf("roster component: owner %T is not *Alliance", owner)
		}
		return &RosterComponent{owner: typed}, nil
	})
}

func (component *RosterComponent) Name() string { return "roster" }

// Owner is available only while the Entity is alive and locked by Nest.
func (component *RosterComponent) Owner() *Alliance { return component.owner }

// AllianceID is the alliance's unique id (the id without kind bits).
func (component *RosterComponent) AllianceID() int64 {
	return entity.GetUniqueIDFromEntityID(component.owner.ID())
}

// Execute runs one write with its receipt (alliancerule.Execute) at the
// alliance's current state version.
func (component *RosterComponent) Execute(requestID string, nowUnix int64, retention time.Duration, apply func() (int64, error)) (alliancerule.Outcome, error) {
	return alliancerule.Execute(rosterReceipts{dao: component.owner.Dao()}, requestID, component.owner.EntityVersion(), nowUnix, retention, apply)
}

// Receipt reads the receipt of requestID.
func (component *RosterComponent) Receipt(requestID string) (alliancerule.Receipt, bool) {
	return rosterReceipts{dao: component.owner.Dao()}.Receipt(requestID)
}

// Settle answers what became of requestID for playerID. seated reports
// whether the player holds a seat under requestID now (a request that
// succeeded may have been followed by a leave); decided whether the request
// has an answer (a receipt) after the call.
//
// decide makes the answer final: the recorded receipt when there is one,
// otherwise — the player is seated under requestID (its receipt was pruned) —
// a success receipt, or a rejection receipt (alliance_expired) written now, so
// a delivery of that request that is still in flight is refused when it
// arrives. Without decide nothing is written: a request still in flight stays
// undecided (decided false) and may still seat the player.
//
// The AllianceMember guard's healing calls it (one player, one alliance): the
// alliance is the authority on whether the player is in, and after a deciding
// Settle no admission under requestID can change that any more — it replays
// the recorded answer.
func (component *RosterComponent) Settle(requestID string, playerID int64, decide bool, nowUnix int64, retention time.Duration) (outcome alliancerule.Outcome, decided, seated bool, err error) {
	seatedUnder := func() bool {
		seat, ok := component.Seat(playerID)
		return ok && seat.GetJoinRequestID() == requestID
	}
	if !decide {
		receipt, found := component.Receipt(requestID)
		return alliancerule.Outcome{Receipt: receipt}, found, seatedUnder(), nil
	}
	outcome, err = component.Execute(requestID, nowUnix, retention, func() (int64, error) {
		if seatedUnder() {
			return playerID, nil
		}
		return 0, errcode.Wrap(apperrors.ErrAllianceExpired, nil, "request_id", requestID)
	})
	return outcome, err == nil, err == nil && seatedUnder(), err
}

// Founded reports whether the alliance has been founded (has a leader).
func (component *RosterComponent) Founded() bool { return component.owner.Dao().GetLeaderID() != 0 }

// Seat returns a member's seat.
func (component *RosterComponent) Seat(playerID int64) (*db.AllianceSeat, bool) {
	seat, ok := component.owner.Dao().GetMembers(playerID)
	return seat, ok && seat != nil
}

// Found makes a fresh alliance entity into an alliance led by leaderID.
func (component *RosterComponent) Found(name string, leaderID int64, homeSID int32, openJoin bool, joinRequestID string, nowUnix int64) error {
	if err := alliancerule.ValidateName(name); err != nil {
		return err
	}
	if component.Founded() {
		// The id was minted for this request; an alliance already founded under
		// it is a broken id allocator, not something to answer the player with.
		return fmt.Errorf("alliance %d is already founded", component.AllianceID())
	}
	dao := component.owner.Dao()
	dao.SetName(name)
	dao.SetLeaderID(leaderID)
	dao.SetOpenJoin(openJoin)
	dao.SetCreatedAtUnix(nowUnix)
	dao.SetMembers(leaderID, newSeat(alliancerule.RoleLeader, homeSID, joinRequestID, nowUnix))
	return nil
}

// Apply records playerID's application.
func (component *RosterComponent) Apply(playerID int64, homeSID int32, nowUnix int64) error {
	if !component.Founded() {
		return errcode.Wrap(apperrors.ErrAllianceMissing, nil, "alliance_id", component.AllianceID())
	}
	dao := component.owner.Dao()
	if _, member := component.Seat(playerID); member {
		return errcode.Wrap(apperrors.ErrAllianceMembership, nil, "player_id", playerID)
	}
	if _, applied := dao.GetApplications(playerID); applied {
		return errcode.Wrap(apperrors.ErrAllianceApplication, nil, "player_id", playerID)
	}
	application := &db.AllianceApplication{}
	application.SetAppliedAtUnix(nowUnix)
	application.SetHomeSID(homeSID)
	dao.SetApplications(playerID, application)
	return nil
}

// Reject drops applicantID's application; only the leader may.
func (component *RosterComponent) Reject(actorID, applicantID int64) error {
	if err := component.requireLeader(actorID); err != nil {
		return err
	}
	dao := component.owner.Dao()
	if _, applied := dao.GetApplications(applicantID); !applied {
		return errcode.Wrap(apperrors.ErrAllianceApplication, nil, "player_id", applicantID)
	}
	dao.DelApplications(applicantID)
	return nil
}

// AdmissionHome checks that actorID may admit playerID now and returns the
// game server the new member belongs to. viaApplication: the leader approves
// a pending application (its home sid is the one recorded at Apply);
// otherwise the player joins an open alliance themselves (callerSID is
// theirs). Capacity is checked here, against maxMembers.
//
// It checks only the alliance. The player's guard (not already in or joining
// another alliance) is the AllianceMember's part; the caller checks it in the
// same transaction or reserved it before.
func (component *RosterComponent) AdmissionHome(actorID, playerID int64, callerSID int32, viaApplication bool, maxMembers int) (int32, error) {
	if !component.Founded() {
		return 0, errcode.Wrap(apperrors.ErrAllianceMissing, nil, "alliance_id", component.AllianceID())
	}
	if _, member := component.Seat(playerID); member {
		return 0, errcode.Wrap(apperrors.ErrAllianceMembership, nil, "player_id", playerID)
	}
	dao := component.owner.Dao()
	homeSID := callerSID
	if viaApplication {
		if err := component.requireLeader(actorID); err != nil {
			return 0, err
		}
		application, applied := dao.GetApplications(playerID)
		if !applied || application == nil {
			return 0, errcode.Wrap(apperrors.ErrAllianceApplication, nil, "player_id", playerID)
		}
		homeSID = application.GetHomeSID()
	} else if actorID != playerID || !dao.GetOpenJoin() {
		return 0, errcode.Wrap(apperrors.ErrAllianceDenied, nil, "player_id", playerID, "open_join", dao.GetOpenJoin())
	}
	if dao.MembersLen() >= maxMembers {
		return 0, errcode.Wrap(apperrors.ErrAllianceFull, nil, "members", dao.MembersLen(), "max_members", maxMembers)
	}
	return homeSID, nil
}

// Admit seats playerID (after AdmissionHome) and drops their application.
func (component *RosterComponent) Admit(playerID int64, homeSID int32, joinRequestID string, nowUnix int64) {
	dao := component.owner.Dao()
	dao.SetMembers(playerID, newSeat(alliancerule.RoleMember, homeSID, joinRequestID, nowUnix))
	if _, applied := dao.GetApplications(playerID); applied {
		dao.DelApplications(playerID)
	}
}

// CheckRemoval checks that actorID may remove targetID: a member leaving
// (actor == target), or the leader kicking a member. The leader can do
// neither to themselves: leadership is transferred first.
func (component *RosterComponent) CheckRemoval(actorID, targetID int64) error {
	if _, member := component.Seat(targetID); !member {
		return errcode.Wrap(apperrors.ErrAllianceMissing, nil, "player_id", targetID)
	}
	if targetID == component.owner.Dao().GetLeaderID() {
		return errcode.Wrap(apperrors.ErrAllianceLeader, nil, "player_id", targetID)
	}
	if actorID == targetID {
		return nil
	}
	return component.requireLeader(actorID)
}

// Remove takes targetID's seat (after CheckRemoval) and returns what the
// membership was: its join request id and the member's home sid.
func (component *RosterComponent) Remove(targetID int64) (string, int32) {
	seat, _ := component.Seat(targetID)
	joinRequestID, homeSID := seat.GetJoinRequestID(), seat.GetHomeSID()
	component.owner.Dao().DelMembers(targetID)
	return joinRequestID, homeSID
}

// Transfer makes newLeaderID the leader; only the leader may.
func (component *RosterComponent) Transfer(actorID, newLeaderID int64) error {
	if err := component.requireLeader(actorID); err != nil {
		return err
	}
	next, member := component.Seat(newLeaderID)
	if !member || newLeaderID == actorID {
		return errcode.Wrap(apperrors.ErrAllianceMissing, nil, "player_id", newLeaderID)
	}
	previous, _ := component.Seat(actorID)
	previous.SetRole(alliancerule.RoleMember)
	next.SetRole(alliancerule.RoleLeader)
	component.owner.Dao().SetLeaderID(newLeaderID)
	return nil
}

// Donate adds amount to the alliance's funds and to the member's
// contribution. The resource it comes from is the player's, on the game
// server: the game side debits it first (a native saga step on the Player,
// the donate saga) and this write is the saga's next step, idempotent by
// request id.
func (component *RosterComponent) Donate(actorID, amount int64) error {
	seat, member := component.Seat(actorID)
	if !member {
		return errcode.Wrap(apperrors.ErrAllianceMissing, nil, "player_id", actorID)
	}
	dao := component.owner.Dao()
	if amount <= 0 || dao.GetFunds() > math.MaxInt64-amount || seat.GetContribution() > math.MaxInt64-amount {
		return errcode.Wrap(apperrors.ErrAllianceAmount, nil, "amount", amount)
	}
	dao.SetFunds(dao.GetFunds() + amount)
	seat.SetContribution(seat.GetContribution() + amount)
	return nil
}

// CheckWar checks that this alliance may be at war with enemyID: not itself,
// not already at war with it, and below alliancerule.MaxWars. Both sides of a
// declaration check it.
func (component *RosterComponent) CheckWar(enemyID int64) error {
	if !component.Founded() {
		return errcode.Wrap(apperrors.ErrAllianceMissing, nil, "alliance_id", component.AllianceID())
	}
	dao := component.owner.Dao()
	if _, at := dao.GetWars(enemyID); at || enemyID == component.AllianceID() || dao.WarsLen() >= alliancerule.MaxWars {
		return errcode.Wrap(apperrors.ErrAllianceWar, nil, "alliance_id", component.AllianceID(), "enemy_id", enemyID)
	}
	return nil
}

// DeclareWar checks that actorID leads this alliance and that it may be at
// war with enemyID.
func (component *RosterComponent) DeclareWar(actorID, enemyID int64) error {
	if err := component.requireLeader(actorID); err != nil {
		return err
	}
	return component.CheckWar(enemyID)
}

// RecordWar records the war with enemyID (after the checks).
func (component *RosterComponent) RecordWar(enemyID, nowUnix int64) {
	component.owner.Dao().SetWars(enemyID, nowUnix)
}

// View is the alliance as answered to callers, at version.
func (component *RosterComponent) View(version int64) alliancerule.View {
	dao := component.owner.Dao()
	view := alliancerule.View{
		AllianceID: component.AllianceID(), Name: dao.GetName(), LeaderID: dao.GetLeaderID(),
		OpenJoin: dao.GetOpenJoin(), Funds: dao.GetFunds(), Version: version,
	}
	dao.RangeMembers(func(playerID int64, seat *db.AllianceSeat) bool {
		if seat != nil {
			view.Members = append(view.Members, alliancerule.MemberView{PlayerID: playerID, Role: seat.GetRole(), Contribution: seat.GetContribution()})
		}
		return true
	})
	slices.SortFunc(view.Members, func(a, b alliancerule.MemberView) int { return cmp.Compare(a.PlayerID, b.PlayerID) })
	dao.RangeApplications(func(playerID int64, _ *db.AllianceApplication) bool {
		view.Applicants = append(view.Applicants, playerID)
		return true
	})
	slices.Sort(view.Applicants)
	dao.RangeWars(func(enemyID int64, _ int64) bool {
		view.Wars = append(view.Wars, enemyID)
		return true
	})
	slices.Sort(view.Wars)
	return view
}

// CurrentVersion is the state version the alliance is at now (outside a
// write: what Info reports).
func (component *RosterComponent) CurrentVersion() int64 { return component.owner.EntityVersion() }

func (component *RosterComponent) requireLeader(actorID int64) error {
	if !component.Founded() {
		return errcode.Wrap(apperrors.ErrAllianceMissing, nil, "alliance_id", component.AllianceID())
	}
	if actorID == 0 || actorID != component.owner.Dao().GetLeaderID() {
		return errcode.Wrap(apperrors.ErrAllianceDenied, nil, "player_id", actorID)
	}
	return nil
}

func newSeat(role int32, homeSID int32, joinRequestID string, nowUnix int64) *db.AllianceSeat {
	seat := &db.AllianceSeat{}
	seat.SetRole(role)
	seat.SetHomeSID(homeSID)
	seat.SetJoinRequestID(joinRequestID)
	seat.SetJoinedAtUnix(nowUnix)
	return seat
}

// rosterReceipts adapts AllianceDao.Requests to alliancerule.ReceiptStore.
type rosterReceipts struct{ dao *db.AllianceDao }

func (r rosterReceipts) Receipt(requestID string) (alliancerule.Receipt, bool) {
	stored, ok := r.dao.GetRequests(requestID)
	if !ok || stored == nil {
		return alliancerule.Receipt{}, false
	}
	return alliancerule.Receipt{Code: stored.GetCode(), Version: stored.GetVersion(), Subject: stored.GetSubject(), AtUnix: stored.GetAtUnix()}, true
}

func (r rosterReceipts) PutReceipt(requestID string, receipt alliancerule.Receipt) {
	stored := &db.AllianceReceipt{}
	stored.SetCode(receipt.Code)
	stored.SetVersion(receipt.Version)
	stored.SetSubject(receipt.Subject)
	stored.SetAtUnix(receipt.AtUnix)
	r.dao.SetRequests(requestID, stored)
}

func (r rosterReceipts) DeleteReceipt(requestID string) { r.dao.DelRequests(requestID) }

func (r rosterReceipts) RangeReceipts(f func(string, alliancerule.Receipt) bool) {
	r.dao.RangeRequests(func(requestID string, stored *db.AllianceReceipt) bool {
		if stored == nil {
			return true
		}
		return f(requestID, alliancerule.Receipt{Code: stored.GetCode(), Version: stored.GetVersion(), Subject: stored.GetSubject(), AtUnix: stored.GetAtUnix()})
	})
}
