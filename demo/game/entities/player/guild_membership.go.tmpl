package player

// 这个文件是 demo 自己的，不属于 profile 模块：玩家身上那份“我在哪个公会”的副本。
//
// 方法挂在 ProfileComponent 上（组件本身是 profile 模块装进来的，同一个包里可以给它加方法），因为公会的
// handler 一直是经 IProfileEntity 这个窄接口拿到玩家的；为两个 DAO 字段的读写另立一个组件，要多占一个组件号、
// 多一份工厂与接线，行为上没有任何区别。状态在 demo 自己的 PlayerDao.GuildID 里，不在模块的 Profile 里。

// GuildID is the guild this player is shown in, or 0: the player's own
// persisted copy of their membership (PlayerDao.GuildID). The alliance
// service's roster is the only authority on membership; the game's guild
// endpoints use this copy only for advisory pre-checks.
func (component *ProfileComponent) GuildID() int64 {
	return component.Owner().Dao().GetGuildID()
}

// SetGuild changes the player's copy: after this player's own join / leave /
// founding, on a membership notice, or at login when the guild's mirror no
// longer has the player (game/handler/show_guild.go). It is persisted with
// the player's transaction.
func (component *ProfileComponent) SetGuild(guildID int64) {
	component.Owner().Dao().SetGuildID(guildID)
	component.Owner().PublishSyncDirty()
}
