package player

import (
	"fmt"
	db "{{MODULE}}/db"

	"github.com/tjbdwanghaibo/roost-core/framework/dataengine"
	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

// PlayerSyncCodec identifies the payload format on the wire. A client that
// does not know this number must not guess at the bytes; changing the format
// means changing this number, and the subject's SchemaVersion decides whether
// a client gets a resync.
const PlayerSyncCodec uint16 = 2

// NewPlayerSyncPacker is the factory named by the entity's subjectPacker
// marker. Its signature is Core's: the framework hands the built Entity in and
// expects the packer that serializes it.
func NewPlayerSyncPacker(value entity.IThreadSafeEntity) entity.SubjectSyncPacker {
	owner, _ := value.(*Player)
	return playerSyncPacker{player: owner}
}

// Player 的同步视图（同步视图由业务按 DAO 字段声明：维护者 2026-11-10“同步视图的问题，业务层处理 DAO 的视图”）。
// 字段名是生成 DAO 的字段词汇表（字段位变化不要求手工改掩码）；谁拿到哪个视图由订阅方给出（场景主视野、队伍关系视野、
// 分区场景的自身绑定，见 internal/service/game/scene.go 的 sceneLayers），packer 只认这里声明过的视图，未知视图报错、
// 不扩大字段权限。字段 × 视图：
//
//	字段                                   default（本人）  near（他人）  team（队友）  far  self（分区场景本人）
//	name、level、equipment、guild_id         ✓               ✓             ✓             name、level  ✓
//	pos_x、pos_y、scene_id                   ✓               ✓             ✓             ✓    —
//	facing                                   ✓               ✓             ✓             —    —
//	cell_hp、cell_max_hp（血条）             ✓               ✓             ✓             —    —
//	exp、gold、bag、wallet                   ✓               —             —             —    ✓
//	attr_base、attr_final、cell_attack、cell_power  ✓        —             —             —    —
//
// default 是普通场景里玩家经 self 看自己（policy.InterestConfig.SelfLayer 零值）：全部同步字段。near 是场景主视野里
// 的其他玩家；team 是队伍关系视野（不论距离），与 near 同样的字段——单独一个身份，队友面板要多给（例如 attr_final）时
// 只改这一行，不影响旁人；priority 比 near 小，队友同时在主视野里时订阅保持 team，走近走远不换视图、不重发全量。
// far 是距离分档的示例（场景没配分档，不用）。self 见下。packer 在实体锁内执行，不再加锁、不阻塞。
type playerSyncPacker struct{ player *Player }

// playerPublicFields 是别的玩家看得见的字段（near / team）。
var playerPublicFields = []string{"Name", "Level", "PosX", "PosY", "SceneID", "Facing", "Equipment", "GuildID", "CellHP", "CellMaxHP"}

var playerViews, playerViewsErr = dataengine.NewSyncViewSet(db.PlayerDaoSyncFields(),
	entity.NamedSyncView{Profile: entity.SyncProfile{}, Fields: []string{"*"}, Priority: -1},
	entity.NamedSyncView{Profile: entity.SyncProfile{Key: "near"}, Fields: playerPublicFields, Priority: 0},
	entity.NamedSyncView{Profile: entity.SyncProfile{Key: "team"}, Fields: playerPublicFields, Priority: -1},
	entity.NamedSyncView{Profile: entity.SyncProfile{Key: "far", LOD: 1}, Fields: []string{"Name", "Level", "PosX", "PosY", "SceneID"}, Priority: 10},
	// self is what a member of a partitioned scene gets of its own Player (maintainer decision E4 = A): its own
	// state. Not the position and not the HP — the scene actor's mirror carries those, and the partitioned scene's
	// position and HP live on the cell; not the attribute maps either (which combat field lives where in a
	// partitioned scene waits on the maintainer, FEATURE §11).
	entity.NamedSyncView{Profile: entity.SyncProfile{Key: "self"}, Fields: []string{"Name", "Level", "Exp", "Gold", "Bag", "Wallet", "Equipment", "GuildID"}, Priority: 0},
)

// SyncViews 是 Player 的视图集（不可变，可共享）：场景把它交给 Interest（policy.InterestConfig.ViewSets）在构造时核对
// 每个层级都已声明，并用各视图的优先级配置 Manager（entity.MergeSyncViewPriorities）。
func SyncViews() (*entity.SyncViewSet, error) { return playerViews, playerViewsErr }

// A snapshot is what a brand-new subscriber gets, and what a resync produces:
// every synced field, not only the dirty ones.
func (packer playerSyncPacker) PackSubjectSnapshot(profile entity.SyncProfile) (entity.FrozenSyncPayload, error) {
	return packer.pack(profile, dataengine.AllFields, false)
}

// A delta carries exactly the fields the mask names. The mask is the one the
// generated setters accumulated, handed over by Player.PublishSyncDirty.
func (packer playerSyncPacker) PackSubjectDelta(profile entity.SyncProfile, mask uint64) (entity.FrozenSyncPayload, error) {
	return packer.pack(profile, mask, true)
}

// pack 编码视图允许的字段。delta 为真时是增量：DAO 补丁不带实体 ID（MarshalSyncDelta，客户端沿用基线的），
// 全量仍带。
func (packer playerSyncPacker) pack(profile entity.SyncProfile, mask uint64, delta bool) (entity.FrozenSyncPayload, error) {
	if packer.player == nil {
		return entity.FrozenSyncPayload{}, fmt.Errorf("player sync packer: no entity")
	}
	// MarshalSync returns nil when the mask names nothing this DAO syncs. An
	// empty payload is a legitimate answer (the subject was marked for a
	// field that is not replicated); returning an error here would fail the
	// whole prepare for every profile.
	if playerViewsErr != nil {
		return entity.FrozenSyncPayload{}, playerViewsErr
	}
	view, ok := playerViews.Lookup(profile)
	if !ok {
		return entity.FrozenSyncPayload{}, fmt.Errorf("%w: %+v", entity.ErrSyncViewUnknown, profile)
	}
	mask &= view.Fields
	if mask == 0 {
		return entity.FrozenSyncPayload{}, nil
	}
	var raw []byte
	if delta {
		raw = packer.player.Dao().MarshalSyncDelta(mask)
	} else {
		raw = packer.player.Dao().MarshalSync(mask)
	}
	if len(raw) == 0 {
		return entity.FrozenSyncPayload{}, nil
	}
	// TakeFrozenSyncPayload transfers ownership: MarshalSync just built these
	// bytes and nobody else holds them, so there is nothing to copy.
	return entity.TakeFrozenSyncPayload(PlayerSyncCodec, raw), nil
}
