// Player 作为分区场景的 Base：映射是 cellworld 模块的（game/modules/cellworldhost 的 ReadBase / WriteBase，模块场景
// 用替身覆盖映射本身），这里核对 demo 的 PlayerDao 接上之后的事：字段经生成 setter 回滚、持久字段经正式编码与文件 WAL
// 恢复。

// demo 的 PlayerDao 声明了模块要的全部 Base 字段（恢复快照与死亡回执是模块追加的 CellworldBase）。
var _ cellworldhost.BaseDao = (*db.PlayerDao)(nil)

type nullCommitter struct{}

func (nullCommitter) Commit(context.Context, nest.CommitRecord) error { return nil }

// The Player's routing state: the live position is the non-persisted PosX / PosY, and the persisted snapshot
// position (SavedPosX / SavedPosY / SavedSceneID) is written only when an accepted write-back advances the snapshot
// version — the fixed moment, not every witness.
func TestBaseStateWritesTheSnapshotPositionOnlyOnAWriteBack(t *testing.T) {
	dao := db.NewPlayerDao()
	player.RegisterEntity()
	id, err := entity.BuildEntityID(7, player.EntityKindPlayer)
	if err != nil {
		t.Fatal(err)
	}
	dao.SetId(id)
	const sceneID = 12345
	// CellHP and the snapshot are persisted fields: their setters only run inside a transaction (as in the Node's
	// handlers and the Player's beat).
	write := func(st cellworld.BaseState) {
		t.Helper()
		if _, err := nest.RunIsolatedTransaction(context.Background(), nullCommitter{}, "base_state", func() (any, error) {
			cellworldhost.WriteBase(dao, st, sceneID)
			return nil, nil
		}); err != nil {
			t.Fatal(err)
		}
	}
	st := cellworld.BaseState{Actor: 7, InWorld: true, Cell: 1001, Epoch: 2, X: 2900, Y: 1500, HP: 100, IntentSeq: 3, VX: 100, AttackSeq: 4, Shown: true,
		Panel: cellworld.Panel{MaxHP: 110, Attack: 12, Power: 35, Ver: 2}, PanelAcked: 1, PanelSentAt: 50, PanelSince: 40, PanelUnknown: true,
		GroupSentAt: 60, GroupSyncAt: 70, GroupViewID: 9001, GroupViewVer: 3, Entry: 80}
	write(st)
	if got := cellworldhost.ReadBase(dao, sceneID); !reflect.DeepEqual(got, st) {
		t.Fatalf("read back\n got %+v\nwant %+v", got, st)
	}
	if dao.GetSavedSceneID() != 0 || dao.GetSavedPosX() != 0 {
		t.Fatalf("a witness wrote the stored position: scene %d x %d", dao.GetSavedSceneID(), dao.GetSavedPosX())
	}
	st.X, st.HP, st.SnapVer = 3010, 80, cellworld.Version{Epoch: 2, Seq: 40}
	write(st)
	if dao.GetSavedSceneID() != sceneID || dao.GetSavedPosX() != 3010 || dao.GetCellHP() != 80 || dao.GetCellSnapSeq() != 40 {
		t.Fatalf("a write-back did not reach the stored fields: scene %d x %d hp %d seq %d", dao.GetSavedSceneID(), dao.GetSavedPosX(), dao.GetCellHP(), dao.GetCellSnapSeq())
	}
	st.X = 3050
	write(st)
	if dao.GetSavedPosX() != 3010 {
		t.Fatalf("a witness after the write-back moved the stored position to %d", dao.GetSavedPosX())
	}
	// 经正式持久编码再水合，不能只检查当前进程里 getter 仍能读到 Entry。
	reloaded := db.NewPlayerDao()
	reloaded.SetId(id)
	if err := reloaded.RestorePersisted(dao.MarshalPersist(dataengine.AllFields), db.PlayerDaoSchemaVersion, 1); err != nil {
		t.Fatal(err)
	}
	if got := cellworldhost.ReadBase(reloaded, sceneID).Entry; got != st.Entry {
		t.Fatalf("persisted entry = %d, want %d", got, st.Entry)
	}
}

// Base 重启后 Player 从库里重新装载：实时位置（PosX / PosY，不持久）是零、不在世界里。进场位置取持久的快照位置
// （SavedPosX / SavedPosY，只有记在这个分区场景之下才算），不是 spawn（维护者 2026-11-03 追加第 1 项）。
func TestReloadedPlayerEntersAtItsSavedPosition(t *testing.T) {
	const sceneID = 12345
	reloaded := func(savedScene int64) *db.PlayerDao {
		dao := db.NewPlayerDao()
		player.RegisterEntity()
		id, err := entity.BuildEntityID(8, player.EntityKindPlayer)
		if err != nil {
			t.Fatal(err)
		}
		dao.SetId(id)
		// 模拟从库里装载的持久字段：持久字段的 setter 要在事务里调用。
		if _, err := nest.RunIsolatedTransaction(context.Background(), nullCommitter{}, "restore", func() (any, error) {
			dao.SetSavedSceneID(savedScene)
			dao.SetSavedPosX(1200)
			dao.SetSavedPosY(1450)
			dao.SetCellHP(70)
			return nil, nil
		}); err != nil {
			t.Fatal(err)
		}
		return dao
	}
	if got := cellworldhost.ReadBase(reloaded(sceneID), sceneID); got.InWorld || got.X != 1200 || got.Y != 1450 || got.HP != 70 {
		t.Fatalf("a reloaded player reads %+v, want its saved position (1200, 1450) and hp 70", got)
	}
	if got := cellworldhost.ReadBase(reloaded(999), sceneID); got.X != 0 || got.Y != 0 {
		t.Fatalf("a position saved under another scene was used: %+v", got)
	}
}

// 第 3 项 = A：升级 / 换装的那笔 Player 事务把新面板与序号写进路由状态（持久字段，序号跨 Base 重启单调）；事务失败时
// 面板随等级一起回滚，Node 在提交后才发它，所以回滚的面板从没发出去过。
func TestPendingPanelRollsBackWithTheTransaction(t *testing.T) {
	dao := db.NewPlayerDao()
	player.RegisterEntity()
	id, err := entity.BuildEntityID(9, player.EntityKindPlayer)
	if err != nil {
		t.Fatal(err)
	}
	dao.SetId(id)
	const sceneID = 12345
	before := cellworld.BaseState{Actor: 9, InWorld: true, Cell: 1001, Epoch: 1, HP: 100,
		Panel: cellworld.Panel{MaxHP: 110, Attack: 12, Power: 35, Ver: 1}, PanelAcked: 1}
	if _, err := nest.RunIsolatedTransaction(context.Background(), nullCommitter{}, "enter", func() (any, error) {
		cellworldhost.WriteBase(dao, before, sceneID)
		return nil, nil
	}); err != nil {
		t.Fatal(err)
	}
	failure := errors.New("a later step of the level-up failed")
	_, err = nest.RunIsolatedTransaction(context.Background(), nullCommitter{}, "level_up", func() (any, error) {
		next := cellworldhost.ReadBase(dao, sceneID)
		next.Panel = cellworld.Panel{MaxHP: 120, Attack: 14, Power: 40, Ver: 2}
		next.PanelSince = 77
		cellworldhost.WriteBase(dao, next, sceneID)
		return nil, failure
	})
	if !errors.Is(err, failure) {
		t.Fatalf("transaction: %v", err)
	}
	if got := cellworldhost.ReadBase(dao, sceneID); got.Panel != before.Panel || got.PanelAcked != 1 || got.PanelSince != 0 {
		t.Fatalf("pending panel not rolled back: %+v acked %d since %d, want %+v", got.Panel, got.PanelAcked, got.PanelSince, before.Panel)
	}
	if dao.GetCellPanelVer() != 1 || dao.GetCellMaxHP() != 110 {
		t.Fatalf("stored panel ver %d max hp %d, want 1 and 110", dao.GetCellPanelVer(), dao.GetCellMaxHP())
	}
}

// 真实文件 WAL：恢复快照、奖励与死亡去重回执一起提交，确认后才发回执；Mongo 尚未投影也能从 WAL 恢复。
func TestCellDeathRewardAndRecoverySurviveFileWAL(t *testing.T) {
	ctx := context.Background()
	dir := t.TempDir()
	wal, err := nestwal.Open(nestwal.DefaultOptions(dir))
	if err != nil {
		t.Fatal(err)
	}
	projector, err := engine.NewProjector(wal, unusedProjection{}, engine.ProjectorOptions{ManualReplay: true})
	if err != nil {
		t.Fatal(err)
	}
	defer projector.Close(ctx)
	defer wal.Close(ctx)
	player.RegisterEntity()
	id, err := entity.BuildEntityID(871, player.EntityKindPlayer)
	if err != nil {
		t.Fatal(err)
	}
	dao := db.NewPlayerDao()
	dao.SetId(id)
	acknowledged := false
	_, err = nest.RunIsolatedTransaction(ctx, projector, "cellworld_death", func() (any, error) {
		if err := cellworldhost.RecordDeathReceipt(dao.GetCellworldBase(), 781, 9, 8); err != nil {
			return nil, err
		}
		dao.GetWallet().SetCoins(17)
		cellworldhost.WriteBase(dao, cellworld.BaseState{Entry: 3, HP: 0, Recovery: cellworld.RecoveryState{Revision: 1, Effects: []cellworld.TimedEffect{{Key: "shield", Stacks: 2, Value: 7, ExpiresAt: 2000000000000}}, Cooldowns: []cellworld.Cooldown{{Key: "dash", ReadyAt: 2000000000001}}}}, 123)
		nest.CurrentRollbackTx().AfterCommit(func() { acknowledged = wal.Stats().Appended == 1 && wal.Stats().Syncs > 0 })
		return nil, nil
	})
	if err != nil || !acknowledged {
		t.Fatalf("commit=%v acknowledged=%v", err, acknowledged)
	}
	if err := projector.Close(ctx); err != nil {
		t.Fatal(err)
	}
	if err := wal.Close(ctx); err != nil {
		t.Fatal(err)
	}
	reopened, err := nestwal.Open(nestwal.DefaultOptions(dir))
	if err != nil {
		t.Fatal(err)
	}
	defer reopened.Close(ctx)
	records := 0
	err = reopened.Replay(ctx, func(_ nest.CommitFence, record nest.CommitRecord) error {
		records++
		if record.Durability != dataengine.DurabilityStrict || len(record.Mutations) != 1 {
			return fmt.Errorf("unexpected commit: %+v", record)
		}
		mutation := record.Mutations[0]
		if mutation.Kind != dataengine.MutationPut {
			return fmt.Errorf("first write is not a full image")
		}
		restored := db.NewPlayerDao()
		restored.SetId(id)
		if err := restored.RestorePersisted(mutation.Data, mutation.Schema, mutation.NextVersion); err != nil {
			return err
		}
		life, ok := restored.GetCellworldBase().GetDeathReceipts(781)
		recovered := cellworldhost.ReadBase(restored, 123)
		if !ok || life != 9 || restored.GetWallet().GetCoins() != 17 || recovered.Entry != 3 || len(recovered.Recovery.Effects) != 1 || len(recovered.Recovery.Cooldowns) != 1 {
			return fmt.Errorf("incomplete recovered death transaction")
		}
		return nil
	})
	if err != nil || records != 1 {
		t.Fatalf("replay records=%d err=%v", records, err)
	}
}

// 本用例特意停在 WAL 恢复边界，不能将它记成 Mongo 落库验收。
type unusedProjection struct{}

func (unusedProjection) Project(context.Context, dataengine.CommitRecord) error {
	return errors.New("projection was not requested")
}
