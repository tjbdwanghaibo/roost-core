package player

import (
	"{{MODULE}}/game/components/mapview"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/gameplay/movement"
)

//roost:component type=2004
const CompTypeMap entity.ComponentType = 2004

// MapComponent 是 game/components/mapview 的组件在 Player 上的名字（生成接线与 handler 用它）；业务在那个包里。
type MapComponent = mapview.Component

type IMapEntity interface {
	entity.IThreadSafeEntity
	MapComp() *MapComponent
}

// MapBasic and MoveComponent make the Player a movement.MapOwner and a
// movement.MoveOwner: the walk parts are the Map component's actor Body.
func (p *Player) MapBasic() *movement.MapBasic  { return p.MapComp().Body().Map }
func (p *Player) MoveComponent() *movement.Move { return p.MapComp().Body().Move }

var (
	_ movement.MapOwner  = (*Player)(nil)
	_ movement.MoveOwner = (*Player)(nil)
)

func init() {
	entity.RegisterComponentFactory(CompTypeMap, mapview.NewComponent)
}
