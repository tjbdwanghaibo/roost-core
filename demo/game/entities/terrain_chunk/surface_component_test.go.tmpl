package terrain_chunk

import (
	"context"
	"errors"
	"slices"
	"testing"

	db "{{MODULE}}/db"
	"github.com/tjbdwanghaibo/roost-core/framework/entity"
	"github.com/tjbdwanghaibo/roost-core/framework/nest"
	"github.com/tjbdwanghaibo/roost-core/gameplay/terrain"
)

// 改块的规则在 SurfaceComponent 上：第一次改用原始块填满、之后要求同一版原始地形；全部校验在第一次写之前；每次提交
// Version + 1；失败或回滚的事务把 DAO 原样还原（rollback=undo 的生成 setter 逆操作）；Applied 有界。这里直接在一笔
// 本地事务里调（handler 里就是这样被调用的），提交器只收下记录。

type nullCommitter struct{}

func (nullCommitter) Commit(context.Context, nest.CommitRecord) error { return nil }

var errAfterWrite = errors.New("a later step of the transaction failed")

func newTestChunk(t *testing.T, key terrain.ChunkKey) *TerrainChunk {
	t.Helper()
	RegisterEntity()
	unique, err := UniqueID(key)
	if err != nil {
		t.Fatal(err)
	}
	e, err := NewTerrainChunk(&entity.EntityCreateParam{IsCreate: true, UniqueID: unique, Kind: EntityKindTerrainChunk})
	if err != nil {
		t.Fatal(err)
	}
	return e
}

// in 在一笔独立事务（rollback=undo）里跑 f；f 返回错误时事务回滚。
func in(e *TerrainChunk, f func(*SurfaceComponent) error) error {
	_, err := nest.RunIsolatedTransaction(context.Background(), nullCommitter{}, "terrain_surface", func() (any, error) {
		return nil, f(e.SurfaceComp())
	})
	return err
}

func testBase() terrain.Chunk {
	c := terrain.NewChunk()
	for i := range c.Heights {
		c.Heights[i] = uint16(3000 + i%97)
		c.Materials[i] = byte(i % 5)
	}
	return c
}

func overlayOf(t *testing.T, e *TerrainChunk) terrain.Overlay {
	t.Helper()
	o, ok, err := e.SurfaceComp().Overlay()
	if err != nil || !ok {
		t.Fatalf("the chunk has no overlay (err %v)", err)
	}
	return o
}

func TestTerrainChunkIDRoundTrip(t *testing.T) {
	RegisterEntity()
	for _, key := range []terrain.ChunkKey{{X: 0, Y: 0}, {X: 1, Y: 0}, {X: 0, Y: 1}, {X: 156, Y: 156}, {X: terrain.MaxChunksPerSide - 1, Y: terrain.MaxChunksPerSide - 1}} {
		id, err := EntityID(key)
		if err != nil {
			t.Fatalf("%v: %v", key, err)
		}
		if id <= 0 || KeyOf(id) != key {
			t.Fatalf("%v: entity id %d decodes to %v", key, id, KeyOf(id))
		}
	}
	for _, key := range []terrain.ChunkKey{{X: -1, Y: 0}, {X: 0, Y: terrain.MaxChunksPerSide}} {
		if _, err := UniqueID(key); err == nil {
			t.Fatalf("%v: an id for a chunk outside any map", key)
		}
	}
}

func TestTerrainChunkFirstEditStartsFromTheBase(t *testing.T) {
	e := newTestChunk(t, terrain.ChunkKey{X: 1, Y: 2})
	base := testBase()
	if _, ok, _ := e.SurfaceComp().Overlay(); ok {
		t.Fatal("a new chunk already has an overlay")
	}
	var version int64
	if err := in(e, func(s *SurfaceComponent) (err error) {
		version, err = s.Apply(7, base, []PointEdit{{Index: 0, Height: 1, Material: 9}, {Index: 4095, Height: 65535, Material: base.Materials[4095]}})
		return err
	}); err != nil {
		t.Fatal(err)
	}
	if version != 1 {
		t.Fatalf("first edit made version %d, want 1", version)
	}
	got := overlayOf(t, e)
	want := base.Clone()
	want.Heights[0], want.Materials[0], want.Heights[4095] = 1, 9, 65535
	if got.BaseRevision != 7 || got.Version != 1 || !slices.Equal(got.Heights, want.Heights) || !slices.Equal(got.Materials, want.Materials) {
		t.Fatalf("after the first edit: revision %d version %d, heights/materials equal to base+edits: %v/%v",
			got.BaseRevision, got.Version, slices.Equal(got.Heights, want.Heights), slices.Equal(got.Materials, want.Materials))
	}
	// 之后的改动不再需要原始块；同一版原始地形照常改，Version 继续加。
	if err := in(e, func(s *SurfaceComponent) (err error) {
		version, err = s.Apply(7, terrain.Chunk{}, []PointEdit{{Index: 64, Height: 42, Material: 3}})
		return err
	}); err != nil || version != 2 {
		t.Fatalf("second edit: version %d, err %v", version, err)
	}
	if h, _ := e.Dao().GetHeights(64); h != 42 {
		t.Fatalf("height at 64 is %d, want 42", h)
	}
	// Overlay 是副本：改它不影响 DAO。
	got = overlayOf(t, e)
	got.Heights[64] = 0
	if h, _ := e.Dao().GetHeights(64); h != 42 {
		t.Fatal("the overlay shares memory with the DAO")
	}
}

func TestTerrainChunkRefusalsWriteNothing(t *testing.T) {
	e := newTestChunk(t, terrain.ChunkKey{X: 0, Y: 0})
	base := testBase()
	short := terrain.Chunk{Heights: base.Heights[:10], Materials: base.Materials}
	if err := in(e, func(s *SurfaceComponent) error { _, err := s.Apply(1, short, nil); return err }); !errors.Is(err, terrain.ErrInvalidChunk) {
		t.Fatalf("a short base: %v, want ErrInvalidChunk", err)
	}
	if err := in(e, func(s *SurfaceComponent) error {
		_, err := s.Apply(1, base, []PointEdit{{Index: terrain.ChunkPoints, Height: 1}})
		return err
	}); !errors.Is(err, terrain.ErrInvalidChunk) {
		t.Fatalf("an index past the chunk: %v, want ErrInvalidChunk", err)
	}
	if v := e.SurfaceComp().Version(); v != 0 || e.Dao().HeightsLen() != 0 {
		t.Fatalf("a refused first edit wrote: version %d, %d heights", v, e.Dao().HeightsLen())
	}
	if err := in(e, func(s *SurfaceComponent) error {
		_, err := s.Apply(1, base, []PointEdit{{Index: 5, Height: 5}})
		return err
	}); err != nil {
		t.Fatal(err)
	}
	before := overlayOf(t, e)
	// 记录基于版本 1，包已是版本 2：拒绝，不覆盖旧记录。
	if err := in(e, func(s *SurfaceComponent) error {
		_, err := s.Apply(2, base, []PointEdit{{Index: 5, Height: 6}})
		return err
	}); !errors.Is(err, terrain.ErrBaseRevision) {
		t.Fatalf("an edit on another base revision: %v, want ErrBaseRevision", err)
	}
	if after := overlayOf(t, e); after.Version != before.Version || !slices.Equal(after.Heights, before.Heights) {
		t.Fatal("a refused edit changed the chunk")
	}
}

func TestTerrainChunkRolledBackEditRestoresTheDAO(t *testing.T) {
	e := newTestChunk(t, terrain.ChunkKey{X: 3, Y: 3})
	base := testBase()
	// 第一次改就回滚：DAO 回到空实体（Version 0、没有数据）。
	if err := in(e, func(s *SurfaceComponent) error {
		if _, err := s.Apply(1, base, []PointEdit{{Index: 1, Height: 1, Material: 1}}); err != nil {
			return err
		}
		return errAfterWrite
	}); !errors.Is(err, errAfterWrite) {
		t.Fatalf("rolled-back first edit: %v", err)
	}
	if v := e.SurfaceComp().Version(); v != 0 || e.Dao().HeightsLen() != 0 || e.Dao().MaterialsLen() != 0 {
		t.Fatalf("after a rolled-back first edit: version %d, %d heights, %d materials", v, e.Dao().HeightsLen(), e.Dao().MaterialsLen())
	}
	if err := in(e, func(s *SurfaceComponent) error {
		_, err := s.Apply(1, base, []PointEdit{{Index: 1, Height: 11, Material: 4}})
		return err
	}); err != nil {
		t.Fatal(err)
	}
	before := overlayOf(t, e)
	if err := in(e, func(s *SurfaceComponent) error {
		if _, err := s.Apply(1, terrain.Chunk{}, []PointEdit{{Index: 1, Height: 12, Material: 0}, {Index: 2, Height: 13, Material: 0}}); err != nil {
			return err
		}
		s.RecordApplied(99)
		return errAfterWrite
	}); !errors.Is(err, errAfterWrite) {
		t.Fatalf("rolled-back edit: %v", err)
	}
	after := overlayOf(t, e)
	if after.Version != before.Version || !slices.Equal(after.Heights, before.Heights) || !slices.Equal(after.Materials, before.Materials) || e.SurfaceComp().WasApplied(99) {
		t.Fatal("a rolled-back edit left changes in the DAO")
	}
}

func TestTerrainChunkAppliedIsBounded(t *testing.T) {
	e := newTestChunk(t, terrain.ChunkKey{X: 0, Y: 1})
	for id := uint64(1); id <= AppliedRing+5; id++ {
		if err := in(e, func(s *SurfaceComponent) error { s.RecordApplied(id); return nil }); err != nil {
			t.Fatal(err)
		}
	}
	if n := e.Dao().AppliedLen(); n != AppliedRing {
		t.Fatalf("applied holds %d ids, want %d", n, AppliedRing)
	}
	for id := uint64(1); id <= 5; id++ {
		if e.SurfaceComp().WasApplied(id) {
			t.Fatalf("edit %d should have been dropped as the oldest", id)
		}
	}
	for id := uint64(6); id <= AppliedRing+5; id++ {
		if !e.SurfaceComp().WasApplied(id) {
			t.Fatalf("edit %d is missing", id)
		}
	}
}

// syncPatch 是 DAO 自上次确认以来的同步增量（packer 的 PackSubjectDelta 发的就是它），并确认掉这些变化（像一次
// 成功的同步）。没有任何变化时返回 nil；patch.Heights / patch.Materials 为 nil 表示这段增量没有改这个字段。
func syncPatch(t *testing.T, e *TerrainChunk) *db.SyncTerrainChunkDao {
	t.Helper()
	// 与同步管理器取增量的方式相同：字段掩码是这段时间 setter 标脏的字段，变化树给出字段内改了哪些下标。
	tracker := e.Dao().DirtyTracker()
	version := tracker.SyncChangeVersion()
	mask := tracker.TakeSyncDirty()
	raw := e.Dao().MarshalSyncChanges(mask)
	tracker.AcknowledgeSyncChanges(version)
	if mask == 0 {
		return nil
	}
	patch, err := db.UnmarshalSyncTerrainChunkDao(raw)
	if err != nil {
		t.Fatal(err)
	}
	return patch
}

// heightsPatch 是 syncPatch 的 Heights 字段（没有高度变化时 nil）。
func heightsPatch(t *testing.T, e *TerrainChunk) *db.SyncTerrainChunkDaoHeightsField {
	t.Helper()
	if patch := syncPatch(t, e); patch != nil {
		return patch.Heights
	}
	return nil
}

// startedChunk 是改过一次（用 base 填满、无改动）且已同步的块：之后的增量只含新改动。
func startedChunk(t *testing.T, key terrain.ChunkKey, base terrain.Chunk) *TerrainChunk {
	t.Helper()
	e := newTestChunk(t, key)
	if err := in(e, func(s *SurfaceComponent) error { _, err := s.Apply(1, base, nil); return err }); err != nil {
		t.Fatal(err)
	}
	syncPatch(t, e) // 第一次改的整块数据算作已同步
	return e
}

// 整字段守卫（方案 §4）：一次提交在本块改动超过 HeightsGuard（1000）个高度时整字段写，同步增量是整字段替换；
// 不超过时逐点写，同步增量按下标。两条路径写出的数据相同（同一组改动分别走守卫与逐点，结果逐点相等）。
func TestTerrainChunkWholeFieldGuard(t *testing.T) {
	base := testBase()
	edits := func(n int) []PointEdit {
		out := make([]PointEdit, n)
		for i := range out {
			index := int32(i * 3)
			out[i] = PointEdit{Index: index, Height: base.Heights[index] + 7, Material: base.Materials[index]}
		}
		return out
	}
	start := func(key terrain.ChunkKey) *TerrainChunk { return startedChunk(t, key, base) }

	guarded := start(terrain.ChunkKey{X: 4, Y: 4})
	if err := in(guarded, func(s *SurfaceComponent) error {
		_, err := s.Apply(1, terrain.Chunk{}, edits(HeightsGuard+1))
		return err
	}); err != nil {
		t.Fatal(err)
	}
	if patch := heightsPatch(t, guarded); patch == nil || patch.Delta || len(patch.Value) != terrain.ChunkPoints {
		t.Fatalf("%d changed heights went out as delta=%v with %d values, want the whole field", HeightsGuard+1, patch.Delta, len(patch.Value))
	}

	// 同一组改动分两笔逐点写（各不超过阈值）。
	pointwise := start(terrain.ChunkKey{X: 5, Y: 4})
	all := edits(HeightsGuard + 1)
	for _, part := range [][]PointEdit{all[:HeightsGuard], all[HeightsGuard:]} {
		if err := in(pointwise, func(s *SurfaceComponent) error { _, err := s.Apply(1, terrain.Chunk{}, part); return err }); err != nil {
			t.Fatal(err)
		}
		if patch := heightsPatch(t, pointwise); patch == nil || !patch.Delta || len(patch.Updates) != len(part) {
			t.Fatalf("%d changed heights went out as %v, want one update per point", len(part), patch)
		}
	}
	if g, p := overlayOf(t, guarded), overlayOf(t, pointwise); !slices.Equal(g.Heights, p.Heights) || !slices.Equal(g.Materials, p.Materials) {
		t.Fatal("the whole-field guard and point writes left different data")
	}
	// 值没变的点不算改动：1001 个“改成原值”的点不触发守卫，也不写。
	same := make([]PointEdit, HeightsGuard+1)
	for i := range same {
		h, _ := guarded.Dao().GetHeights(i)
		m, _ := guarded.Dao().GetMaterials(i)
		same[i] = PointEdit{Index: int32(i), Height: h, Material: byte(m)}
	}
	if err := in(guarded, func(s *SurfaceComponent) error { _, err := s.Apply(1, terrain.Chunk{}, same); return err }); err != nil {
		t.Fatal(err)
	}
	if patch := heightsPatch(t, guarded); patch != nil {
		t.Fatalf("unchanged heights produced a heights patch %+v", patch)
	}
}

// Discard（原始地形换版后丢弃改动）只重置仍基于旧版本的记录；重置后是 Version 0 的空记录，下一次改动从当前原始块
// 重新开始；Applied 保留。
func TestTerrainChunkDiscardResetsOnlyAStaleRecord(t *testing.T) {
	e := newTestChunk(t, terrain.ChunkKey{X: 2, Y: 2})
	base := testBase()
	if err := in(e, func(s *SurfaceComponent) error {
		_, err := s.Apply(1, base, []PointEdit{{Index: 9, Height: 9, Material: 9}})
		s.RecordApplied(77)
		return err
	}); err != nil {
		t.Fatal(err)
	}
	discard := func(stale, current int64) (reset bool) {
		t.Helper()
		if err := in(e, func(s *SurfaceComponent) error { reset = s.Discard(stale, current); return nil }); err != nil {
			t.Fatal(err)
		}
		return reset
	}
	if discard(1, 1) || discard(3, 2) {
		t.Fatal("a record on the current revision, or on another stale revision, was reset")
	}
	if v := e.SurfaceComp().Version(); v != 1 {
		t.Fatalf("a refused discard changed the version to %d", v)
	}
	if !discard(1, 2) {
		t.Fatal("a record on the old revision was not reset")
	}
	if _, ok, _ := e.SurfaceComp().Overlay(); ok || e.Dao().HeightsLen() != 0 || e.Dao().MaterialsLen() != 0 || e.SurfaceComp().BaseRevision() != 0 {
		t.Fatal("a discarded record still has data")
	}
	if !e.SurfaceComp().WasApplied(77) {
		t.Fatal("the discard dropped the applied ids")
	}
	if discard(1, 2) {
		t.Fatal("a second discard reset again")
	}
	next := base.Clone()
	next.Heights[0] = 500 // 新一版原始地形
	if err := in(e, func(s *SurfaceComponent) error {
		_, err := s.Apply(2, next, []PointEdit{{Index: 1, Height: 1, Material: 1}})
		return err
	}); err != nil {
		t.Fatal(err)
	}
	if got := overlayOf(t, e); got.BaseRevision != 2 || got.Version != 1 || got.Heights[0] != 500 || got.Heights[9] != base.Heights[9] {
		t.Fatalf("the edit after a discard: revision %d version %d, h[0]=%d h[9]=%d", got.BaseRevision, got.Version, got.Heights[0], got.Heights[9])
	}
}

// 材质与高度一样按下标增量（D11，维护者 2026-11-08：下行预算低于 50KB/s）：一次提交在本块改动不超过 MaterialsGuard
// （1000）个材质时逐点写，同步增量按下标；超过时整字段。只改材质的提交不带高度，只改高度的不带材质。两条路径的数据
// 相同。
func TestTerrainChunkMaterialsGoOutPerPointUnderTheGuard(t *testing.T) {
	base := testBase()
	paint := func(n int) []PointEdit {
		out := make([]PointEdit, n)
		for i := range out {
			index := int32(i * 3)
			out[i] = PointEdit{Index: index, Height: base.Heights[index], Material: base.Materials[index] + 200}
		}
		return out
	}

	pointwise := startedChunk(t, terrain.ChunkKey{X: 6, Y: 4}, base)
	all := paint(MaterialsGuard + 1)
	for _, part := range [][]PointEdit{all[:MaterialsGuard], all[MaterialsGuard:]} {
		if err := in(pointwise, func(s *SurfaceComponent) error { _, err := s.Apply(1, terrain.Chunk{}, part); return err }); err != nil {
			t.Fatal(err)
		}
		patch := syncPatch(t, pointwise)
		if patch == nil || patch.Materials == nil || !patch.Materials.Delta || len(patch.Materials.Updates) != len(part) || patch.Heights != nil {
			t.Fatalf("%d changed materials went out as %+v, want one material update per point and no heights", len(part), patch)
		}
		for _, edit := range part {
			if got, ok := patch.Materials.Updates[uint64(edit.Index)]; !ok || got != uint16(edit.Material) {
				t.Fatalf("material update at %d is %d (present %v), want %d", edit.Index, got, ok, edit.Material)
			}
		}
	}

	guarded := startedChunk(t, terrain.ChunkKey{X: 7, Y: 4}, base)
	if err := in(guarded, func(s *SurfaceComponent) error { _, err := s.Apply(1, terrain.Chunk{}, all); return err }); err != nil {
		t.Fatal(err)
	}
	if patch := syncPatch(t, guarded); patch == nil || patch.Materials == nil || patch.Materials.Delta || len(patch.Materials.Value) != terrain.ChunkPoints || patch.Heights != nil {
		t.Fatalf("%d changed materials went out as %+v, want the whole materials field and no heights", MaterialsGuard+1, patch)
	}
	if g, p := overlayOf(t, guarded), overlayOf(t, pointwise); !slices.Equal(g.Materials, p.Materials) || !slices.Equal(g.Heights, p.Heights) {
		t.Fatal("the materials guard and point writes left different data")
	}
	want := base.Clone()
	for _, edit := range all {
		want.Materials[edit.Index] = edit.Material
	}
	if got := overlayOf(t, guarded); !slices.Equal(got.Materials, want.Materials) {
		t.Fatal("the painted materials are not base + edits")
	}

	// 只改高度：增量里没有材质。
	if err := in(guarded, func(s *SurfaceComponent) error {
		_, err := s.Apply(1, terrain.Chunk{}, []PointEdit{{Index: 10, Height: 1, Material: want.Materials[10]}})
		return err
	}); err != nil {
		t.Fatal(err)
	}
	if patch := syncPatch(t, guarded); patch == nil || patch.Materials != nil || patch.Heights == nil || !patch.Heights.Delta {
		t.Fatalf("a height-only edit went out as %+v, want a heights delta and no materials", patch)
	}
}

// 两个列表共享每 DAO 4096 个节点的变化预算（framework/dataengine 的 maxSyncChangeNodes）。单笔提交在两个守卫之内
// （各 1000 点）用到约 2004 个节点，两个字段都还是按下标的增量；同一块在确认之前累计更多这样的提交、超过预算时，
// 框架整树回退，两个字段都按整字段发出（数据仍正确）。所以守卫按字段各自计数就够，不需要按两者合计。
func TestTerrainChunkHeightsAndMaterialsShareTheChangeBudget(t *testing.T) {
	base := testBase()
	edits := func(from int) []PointEdit {
		out := make([]PointEdit, 0, HeightsGuard)
		for i := from; len(out) < HeightsGuard; i++ {
			out = append(out, PointEdit{Index: int32(i), Height: base.Heights[i] + 3, Material: base.Materials[i] + 100})
		}
		return out
	}
	e := startedChunk(t, terrain.ChunkKey{X: 8, Y: 4}, base)
	first := edits(0)
	if err := in(e, func(s *SurfaceComponent) error { _, err := s.Apply(1, terrain.Chunk{}, first); return err }); err != nil {
		t.Fatal(err)
	}
	patch := syncPatch(t, e)
	if patch == nil || patch.Heights == nil || !patch.Heights.Delta || len(patch.Heights.Updates) != HeightsGuard ||
		patch.Materials == nil || !patch.Materials.Delta || len(patch.Materials.Updates) != MaterialsGuard {
		t.Fatalf("1000 heights + 1000 materials in one commit went out as %+v, want two per-point deltas", patch)
	}

	// 不确认：三笔各 1000 + 1000 个不同下标，第二笔后约 4005 个节点（还在预算内），第三笔超过预算。
	tracker := e.Dao().DirtyTracker()
	for _, from := range []int{1000, 2000, 3000} {
		part := edits(from)
		if err := in(e, func(s *SurfaceComponent) error { _, err := s.Apply(1, terrain.Chunk{}, part); return err }); err != nil {
			t.Fatal(err)
		}
	}
	version := tracker.SyncChangeVersion()
	raw := e.Dao().MarshalSyncChanges(tracker.TakeSyncDirty())
	tracker.AcknowledgeSyncChanges(version)
	merged, err := db.UnmarshalSyncTerrainChunkDao(raw)
	if err != nil {
		t.Fatal(err)
	}
	if merged.Heights == nil || merged.Heights.Delta || len(merged.Heights.Value) != terrain.ChunkPoints ||
		merged.Materials == nil || merged.Materials.Delta || len(merged.Materials.Value) != terrain.ChunkPoints {
		t.Fatalf("three unacknowledged commits of 2000 changed points each went out as heights %+v materials %+v, want both whole fields", merged.Heights != nil && merged.Heights.Delta, merged.Materials != nil && merged.Materials.Delta)
	}
	got := overlayOf(t, e)
	for i := range 4000 {
		if got.Heights[i] != base.Heights[i]+3 || got.Materials[i] != base.Materials[i]+100 {
			t.Fatalf("point %d is %d/%d after the edits", i, got.Heights[i], got.Materials[i])
		}
	}
	for i, v := range merged.Materials.Value {
		if byte(v) != got.Materials[i] || v > 255 {
			t.Fatalf("whole materials field differs at %d: %d vs %d", i, v, got.Materials[i])
		}
	}
}

// DAO 的材质是 []uint16，terrain 与原始地形包里是每点 1 字节：记录里出现 > 255 的值（不是本程序写出的）按损坏拒绝，
// Overlay / OverlayOf / Data 报 ErrInvalidChunk，Apply 在写之前拒绝、什么都不写；不截断。
func TestTerrainChunkMaterialOutsideAByteIsRefused(t *testing.T) {
	e := startedChunk(t, terrain.ChunkKey{X: 9, Y: 4}, testBase())
	if err := in(e, func(s *SurfaceComponent) error { s.Owner().Dao().SetMaterialsAt(17, 256); return nil }); err != nil {
		t.Fatal(err)
	}
	if _, _, err := e.SurfaceComp().Overlay(); !errors.Is(err, terrain.ErrInvalidChunk) {
		t.Fatalf("an overlay with material 256: %v, want ErrInvalidChunk", err)
	}
	if _, _, err := OverlayOf(e.Dao()); !errors.Is(err, terrain.ErrInvalidChunk) {
		t.Fatalf("OverlayOf with material 256: %v, want ErrInvalidChunk", err)
	}
	if _, _, err := e.SurfaceComp().Data(); !errors.Is(err, terrain.ErrInvalidChunk) {
		t.Fatalf("Data with material 256: %v, want ErrInvalidChunk", err)
	}
	version := e.SurfaceComp().Version()
	if err := in(e, func(s *SurfaceComponent) error {
		_, err := s.Apply(1, terrain.Chunk{}, []PointEdit{{Index: 1, Height: 1, Material: 1}})
		return err
	}); !errors.Is(err, terrain.ErrInvalidChunk) {
		t.Fatalf("an edit on a record with material 256: %v, want ErrInvalidChunk", err)
	}
	if v, _ := e.Dao().GetMaterials(17); e.SurfaceComp().Version() != version || v != 256 {
		t.Fatalf("a refused edit wrote: version %d → %d, material %d", version, e.SurfaceComp().Version(), v)
	}
}
