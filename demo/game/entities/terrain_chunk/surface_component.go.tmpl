package terrain_chunk

import (
	"{{MODULE}}/game/components/terrainsurface"
	"{{MODULE}}/game/view"

	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

//roost:component type=2011
const CompTypeSurface entity.ComponentType = 2011

// SurfaceComponent 是 game/components/terrainsurface 的组件在 TerrainChunk 上的名字（生成接线与 handler 用它）；业务在那个包里。
type SurfaceComponent = terrainsurface.Component

// ISurfaceEntity is the narrow lock-safe view for Nest handlers.
type ISurfaceEntity interface {
	entity.IThreadSafeEntity
	SurfaceComp() *SurfaceComponent
}

// TerrainSurface 是块面组件在 game/view 里的名字（view.TerrainSurfaceHolder）：组件类型名是 Surface，生成器按这个手写访问器把 Holder 嵌进 view.TerrainChunkEntity。
func (c *TerrainChunk) TerrainSurface() view.TerrainSurface { return c.SurfaceComp() }

func init() {
	entity.RegisterComponentFactory(CompTypeSurface, terrainsurface.NewComponent)
}
