package team

import (
	db "{{MODULE}}/db"
	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

const EntityKindTeam entity.EntityKind = 10

// Team 是分区场景里的一支队伍（维护者 2026-11-04 第 4 项 = A）：邀请 / 接受 / 离队 / 解散的组队关系，不开战斗房间。
//
// remote=managed、service={{GAME_SERVICE}}、共享模式：队员在不同的 Base 进程（都是 {{GAME_SERVICE}} 服务的进程）上，都要改同一份
// 成员表，所以它不属于其中任何一个进程——谁拿到它的分布式锁，谁在那一笔事务里是它的 owner（建队时切到共享模式，见
// controllers/player/team.go 的 shareTeam）。service= 声明它归 {{GAME_SERVICE}} 服务：handler 只在这个服务的 Nest 上注册，
// 别的服务（alliance）的 Remote 运行时拒绝认领与写它（无缝大世界方案 §14）。成员表只在这里（权威）；每名队员的 Player 上有一份缓存
// （TeamID 持久，成员表与版本不持久），队伍面板按缓存把队员快照发给别的 Base（gameplay/cellworld 的 group.go）。
// 普通场景、匹配、锁步战斗都不碰它。
//
// Category：EntityCategoryRemote（rank 1）：分布式锁在任何本地锁之前取，[Team, Player] 的事务在每个进程上都是
// 先 Team 后 Player。
//
//roost:entity id=10 entityKind=EntityKindTeam category=entity.EntityCategoryRemote remote=managed service={{GAME_SERVICE}}
type Team struct {
	*entity.RemoteEntityBase
	entity.ComponentManager
	entity.DaoManager
	roster *RosterComponent `comp:"CompTypeRoster"`
	dao    *db.TeamDao      `dao:"team"`
}
