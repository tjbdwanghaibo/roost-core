package alliance_shard

import (
	db "{{MODULE}}/db"
	"github.com/tjbdwanghaibo/roost-core/framework/entity"
)

const EntityKindAllianceShard entity.EntityKind = 8

// IAllianceShardEntity is the lock-safe business view used by Nest handlers.
type IAllianceShardEntity interface{ entity.IThreadSafeEntity }

// AllianceShard is the alliance service instance's timer host: one per
// service sid, its unique id is the sid. A plain local entity (not Remote),
// persisted through the Data Engine and recovered from this sid's WAL, like
// any entity the instance owns; the service creates it before it answers its
// first request.
//
// Category Other: a transaction that holds a guard (Remote, rank 1) takes the
// shard after it, to arm or disarm the guard's reservation deadline.
// service=alliance: only the alliance service loads it and registers its
// handlers (a local kind is not in anyone's ForeignKinds — it has no Remote
// ownership to take).
//
//roost:entity id=8 entityKind=EntityKindAllianceShard category=entity.EntityCategoryOther service=alliance
type AllianceShard struct {
	*entity.EntityBase
	entity.ComponentManager
	entity.DaoManager
	dao   *db.AllianceShardDao `dao:"alliance_shard"`
	timer *TimerComponent      `comp:"CompTypeTimer"`
}
