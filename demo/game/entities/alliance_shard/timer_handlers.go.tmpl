package alliance_shard

import (
	"log/slog"
	"time"

	db "{{MODULE}}/db"
	"{{MODULE}}/game/effects"
	"github.com/tjbdwanghaibo/roost-core/framework/nest/entitytimer"
)

// AllianceShard's timer types. The type is stored with each node and finds
// its callback again after a restart: never renumber a published type.
const (
	// TimerTypeReservation is a guard reservation's deadline: Param1 is the
	// player, Param2 the alliance, the payload the request id.
	TimerTypeReservation int32 = 1
)

// reservationRetry is how soon a deadline whose notice could not be emitted
// (registered on the transaction) fires again.
const reservationRetry = 5 * time.Second

func (component *TimerComponent) registerTimerHandlers(handlers *entitytimer.Handlers) {
	handlers.Register(TimerTypeReservation, component.onReservationDue)
}

// ArmReservation arms the deadline of the guard reservation (playerID,
// allianceID, requestID) at deadline, in the transaction that made the
// reservation.
func (component *TimerComponent) ArmReservation(playerID, allianceID int64, requestID string, deadline time.Time) int64 {
	return component.NewTimerAt(deadline, TimerTypeReservation, playerID, allianceID, []byte(requestID))
}

// DisarmReservation removes the deadline of requestID for playerID, in the
// transaction that settled the reservation. Reports whether one was armed.
func (component *TimerComponent) DisarmReservation(playerID int64, requestID string) bool {
	var found int64
	component.owner.Dao().RangeTimers(func(id int64, node *db.AllianceShardTimerNode) bool {
		if node != nil && node.GetType() == TimerTypeReservation && node.GetParam1() == playerID && node.GetPayload() == requestID {
			found = id
			return false
		}
		return true
	})
	return found != 0 && component.RemoveTimer(found)
}

// onReservationDue runs inside the shard's Nest lock: it only emits the
// best-effort notice; its consumer settles the request with the alliance. A
// lost notice is made up by the next request that finds the guard held.
func (component *TimerComponent) onReservationDue(fire entitytimer.Fire) time.Duration {
	event := effects.AllianceReservationDue{PlayerID: fire.Param1, AllianceID: fire.Param2, RequestID: string(fire.Payload)}
	if err := effects.EmitAllianceReservationDue(event); err != nil {
		slog.Error("alliance shard: reservation deadline notice not emitted; retrying",
			"player_id", event.PlayerID, "alliance_id", event.AllianceID, "request_id", event.RequestID, "retry_in", reservationRetry, "err", err)
		return reservationRetry
	}
	return 0
}
