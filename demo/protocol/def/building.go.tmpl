//go:build protocoldef

package protocoldef

// 建筑（可编辑地形 P4）：放置、拆除一座建筑。本轮建筑本身不同步，放置者按答复显示；别的玩家看到建筑的同步方式待定
// （可编辑地形方案 §25）。整平改了的地形走地形块的同步。坐标单位是 1m 节点（世界采样点，世界坐标 = 节点 × 100 厘米）。

// BuildingRequest 是一次放置或拆除。
//
//   - Seq：编辑序号，与玩家 ID 一起是请求的身份，与 TerrainEdit 共用同一个序号空间与同一份服务端账本（D18）：新请求用
//     上一次的序号 + 1，结果未知时用同一个 Seq 重发（已生效的答 Duplicate）；不知道上一次用到哪里时先发 TerrainEdit 的
//     Seq = 0 查询。取值 1～2^63−1。
//   - Op：1 放置、2 拆除（拆除只看 GX、GY：锚点上的建筑，只有属主能拆）。
//   - Kind：建筑类型（demo：1 hut 4×4、2 hall 8×6、3 tower 3×3）；GX、GY：锚点（占地左下角节点）；Facing：0～3，1、3 时
//     宽高互换；Level：放置时把占地整平到占地各节点的平均高度（地形编辑，计改动点数配额）。
type BuildingRequest struct {
	Seq    uint64 `pb:"1"`
	Op     int32  `pb:"2"`
	Kind   int32  `pb:"3"`
	GX     int64  `pb:"4"`
	GY     int64  `pb:"5"`
	Facing int32  `pb:"6"`
	Level  bool   `pb:"7"`
}

// BuildingResponse 答复一次放置 / 拆除：Code 0 时 Standing / BuildingID / Foundation 是建筑此刻的状态（拆除后 Standing 为
// false），Chunks 是占地覆盖的每一块此后的地形版本，Duplicate 表示这个 Seq 已经生效过、这次什么都没做。LastSeq 是服务端
// 此刻已应用的最大序号（Code 0 与 terrain_seq 时给出）。拒绝时什么都没写。
// Codes: terrain_disabled, building_disabled（分区场景）, building_bad, terrain_not_owned, terrain_unavailable, terrain_rate,
// terrain_denied（权限，或拆除别人的建筑）, terrain_occupied（锚点或占地已有建筑）, building_slope, building_underwater,
// building_limit, building_missing, terrain_seq。
type BuildingResponse struct {
	Code       int32                 `pb:"1"`
	Reason     string                `pb:"2"`
	Duplicate  bool                  `pb:"3"`
	Standing   bool                  `pb:"4"`
	BuildingID int64                 `pb:"5"`
	Foundation int32                 `pb:"6"`
	Leveled    bool                  `pb:"7"`
	Chunks     []TerrainChunkVersion `pb:"8"`
	LastSeq    int64                 `pb:"9"`
}

//roost:protocol group=game handler=player
type BuildingProtocol interface {
	//roost:msg id=10039
	Building(BuildingRequest) BuildingResponse
}
