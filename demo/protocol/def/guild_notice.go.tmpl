//go:build protocoldef

package protocoldef

// GuildNoticePush is sent when the alliance service tells this game server
// that an online player's membership changed (joined, left, kicked). Best
// effort: a player who was offline, or whose notice was lost, sees the change
// at the next login, which reads the guild mirror.
type GuildNoticePush struct {
	GuildID int64  `pb:"1"`
	Change  string `pb:"2"`
	Version int64  `pb:"3"`
}

//roost:protocol group=game handler=player
type GuildNoticeProtocol interface {
	//roost:msg id=10104
	GuildNotice() GuildNoticePush
}
