// Command terrainpack writes the demo's terrain base pack (gameplay/terrain
// format): a small deterministic map, the same bytes on every machine for the
// same flags, so the game service and a client can load one pack and agree on
// every height.
//
//	go run ./cmd/terrainpack -out configs/terrain/demo.pack
//	go run ./cmd/terrainpack -out configs/terrain/demo.pack -shape generated -seed 1
//
// The default shape is flat ground (terrain.Flat): every sample at -ground,
// 1m above -water-level unless given, all grass. Every step is walkable under
// the 45° walk rules, and digging a little over 1m turns the hole into water
// (filling it back makes it land again), so the editable terrain can be shown
// straight away. -shape generated is the rolling procedural terrain
// (terrain.Generated, seeded) that tests, benchmarks and the client golden
// files use; under the 45° walk rules most of its steps are too steep, so it
// is not the default any more.
//
// Then point the game at it (configs/service/config.<game>.yaml):
//
//	scene:
//	  terrain:
//	    pack: configs/terrain/demo.pack
//
// One chunk is 64m × 64m (6400 world units, centimetres); the map starts at
// the world origin. The defaults (16 × 16 chunks, 1024m × 1024m) are the
// largest map an ordinary scene takes (2^20 AOI blocks of 1m; the block table
// costs about 56MiB and about 3ms more marking per GC, editable terrain plan
// §23), and a partitioned scene of four 51200 cells covers it exactly
// (cell_size: 51200, cols: 2, rows: 2). A real game's pack comes from its
// artists' height and material maps (terrain.RAWImport), not from here.
//
// Regional water levels (editable terrain D3, pack format 2) are repeatable
// -water-region flags of chunk rectangles, half-open, that must not overlap:
//
//	go run ./cmd/terrainpack -chunks-x 4 -chunks-y 2 -water-region 2,0,4,1,45000
//
// puts chunks x 2..3, y 0 under a 450m lake surface; every other chunk keeps
// -water-level. A level of -2147483648 means a dry region.
//
// Bump -base-revision whenever the base terrain changes, including HeightBase.
// Owned old-revision edits are reset through the entity/DataEngine path (D13);
// never silently reinterpret an existing pack or edited samples at a new base.
// Left at 0 it is picked by shape: 2 for the flat ground (the default pack
// changed from the procedural terrain to flat ground, so its revision moved
// on), 1 for the procedural terrain (the same terrain the default pack used
// to be).
package main

import (
	"errors"
	"flag"
	"fmt"
	"io"
	"math"
	"os"
	"path/filepath"
	"strconv"
	"strings"

	"github.com/tjbdwanghaibo/roost-core/gameplay/terrain"
)

const (
	shapeFlat      = "flat"
	shapeGenerated = "generated"
	// flatAboveWater 是平地缺省高出水位的量（厘米）：挖下去超过 1m 就是水，超过 1.5m 要游泳（涉水 50cm），一笔笔刷
	// （强度至多 5m）就能演示“挖坑成湖”；填回 1m 以上又是陆地。
	flatAboveWater = 100
	// 各形状缺省的 BaseRevision（D13：同一个版本号只对应一份原始地形）。缺省包从起伏地形换成平地，所以平地取 2；
	// 起伏地形仍是 1，与以前的缺省包是同一份地形。
	flatRevision      = 2
	generatedRevision = 1
)

func main() {
	if err := run(os.Args[1:], os.Stdout); err != nil && !errors.Is(err, flag.ErrHelp) {
		fail(err)
	}
}

// run 使用独立 FlagSet，校验收窄前的数值；高度基准与水位都是厘米、互相独立。
func run(args []string, output io.Writer) error {
	flags := flag.NewFlagSet("terrainpack", flag.ContinueOnError)
	flags.SetOutput(output)
	out := flags.String("out", "configs/terrain/demo.pack", "where to write the pack (written to a temporary file, synced, then renamed)")
	chunksX := flags.Int64("chunks-x", 16, "chunks along X (64m each)")
	chunksY := flags.Int64("chunks-y", 16, "chunks along Y (64m each)")
	shape := flags.String("shape", shapeFlat, "the base terrain: flat (every sample at -ground) or generated (rolling procedural terrain from -seed)")
	ground := flags.Int64("ground", 0, "world height of the flat ground, in centimetres, a multiple of 10 (default: 1m above -water-level, or 0 without water)")
	seed := flags.Uint64("seed", 1, "seed of the procedural terrain (-shape generated only)")
	revision := flags.Int64("base-revision", 0, "the base terrain's revision, recorded in the pack header and in every edited chunk (default: 2 for flat, 1 for generated)")
	heightBase := flags.Int64("height-base", -10000, "world height of raw height 0, in centimetres (default -100m)")
	waterLevel := flags.Int64("water-level", 40000, "global water level, in world centimetres; independent of height-base")
	var regions waterRegions
	flags.Var(&regions, "water-region", "a regional water level `minX,minY,maxX,maxY,level`: half-open chunk rectangle, level in world centimetres (repeatable, no overlaps)")
	if err := flags.Parse(args); err != nil {
		return err
	}
	if flags.NArg() != 0 {
		return fmt.Errorf("unexpected positional arguments: %v", flags.Args())
	}
	given := map[string]bool{}
	flags.Visit(func(f *flag.Flag) { given[f.Name] = true })
	if *chunksX < 1 || *chunksX > math.MaxInt32 || *chunksY < 1 || *chunksY > math.MaxInt32 {
		return fmt.Errorf("chunk dimensions must be in [1, %d]", int64(math.MaxInt32))
	}
	if *heightBase < math.MinInt32 || *heightBase > math.MaxInt32 || *waterLevel < math.MinInt32 || *waterLevel > math.MaxInt32 {
		return fmt.Errorf("height-base and water-level must fit int32 centimetres")
	}
	switch {
	case *shape != shapeFlat && *shape != shapeGenerated:
		return fmt.Errorf("shape %q: want %s or %s", *shape, shapeFlat, shapeGenerated)
	case *shape == shapeFlat && given["seed"]:
		return fmt.Errorf("-seed applies to -shape %s only", shapeGenerated)
	case *shape == shapeGenerated && given["ground"]:
		return fmt.Errorf("-ground applies to -shape %s only", shapeFlat)
	}
	if !given["base-revision"] {
		*revision = generatedRevision
		if *shape == shapeFlat {
			*revision = flatRevision
		}
	}

	meta := terrain.Meta{
		BaseRevision: *revision, ChunksX: int32(*chunksX), ChunksY: int32(*chunksY),
		HeightBase: int32(*heightBase), WaterLevel: int32(*waterLevel), WaterRegions: regions,
	}
	if err := meta.Validate(); err != nil {
		return err
	}
	src := terrain.Generated(meta, *seed)
	if *shape == shapeFlat {
		if !given["ground"] {
			*ground = 0
			if meta.WaterLevel != math.MinInt32 {
				*ground = int64(meta.WaterLevel) + flatAboveWater
			}
		}
		raw, err := flatRaw(*ground, *heightBase)
		if err != nil {
			return err
		}
		src = terrain.Flat(meta, raw, terrain.GenGrass)
	}
	if err := os.MkdirAll(filepath.Dir(*out), 0o755); err != nil {
		return err
	}
	if err := terrain.WritePackFile(*out, meta, src); err != nil {
		return err
	}
	_, err := fmt.Fprintf(output, "terrainpack: wrote %s: %s, %d x %d chunks, base revision %d, height base %d, water level %d, %d water regions\n", *out, describe(*shape, *ground, *seed), meta.ChunksX, meta.ChunksY, meta.BaseRevision, meta.HeightBase, meta.WaterLevel, len(meta.WaterRegions))
	return err
}

// flatRaw 把平地的世界高度换成高度原始值：必须正好落在 10cm 一档上、在 [0, 65535] 里（不四舍五入、不截断）。
func flatRaw(ground, heightBase int64) (uint16, error) {
	d := ground - heightBase
	if d < 0 || d%terrain.HeightStep != 0 || d/terrain.HeightStep > math.MaxUint16 {
		return 0, fmt.Errorf("ground %d cm: with height base %d it must be a multiple of %d cm in [%d, %d]",
			ground, heightBase, terrain.HeightStep, heightBase, heightBase+math.MaxUint16*terrain.HeightStep)
	}
	return uint16(d / terrain.HeightStep), nil
}

func describe(shape string, ground int64, seed uint64) string {
	if shape == shapeFlat {
		return fmt.Sprintf("flat ground at %d", ground)
	}
	return fmt.Sprintf("generated terrain, seed %d", seed)
}

// waterRegions 是可重复的 -water-region 参数。每个值五个整数，按 int32 解析（越界即报错，不截断）；区域规则（在图内、
// 不重叠、个数上限）由 terrain.Meta.Validate 在写包之前检查。
type waterRegions []terrain.WaterRegion

func (r *waterRegions) String() string { return fmt.Sprint([]terrain.WaterRegion(*r)) }

func (r *waterRegions) Set(value string) error {
	parts := strings.Split(value, ",")
	if len(parts) != 5 {
		return fmt.Errorf("water region %q: want minX,minY,maxX,maxY,level", value)
	}
	var v [5]int32
	for i, part := range parts {
		n, err := strconv.ParseInt(strings.TrimSpace(part), 10, 32)
		if err != nil {
			return fmt.Errorf("water region %q: %w", value, err)
		}
		v[i] = int32(n)
	}
	*r = append(*r, terrain.WaterRegion{MinX: v[0], MinY: v[1], MaxX: v[2], MaxY: v[3], Level: v[4]})
	return nil
}

func fail(err error) {
	fmt.Fprintln(os.Stderr, "terrainpack:", err)
	os.Exit(1)
}
