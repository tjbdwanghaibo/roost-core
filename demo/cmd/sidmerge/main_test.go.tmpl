package main

import (
	"testing"

	db "{{MODULE}}/db"
	"github.com/tjbdwanghaibo/roost-core/wiring/sidmerge"
)

// 合服清单按本工程自己的配置与 DAO 声明给出：game-demo 的 DAO 都在逻辑库 main。其中只有地形格账本
// TerrainCellEditor 是 dbscope=sid（分区场景每个格进程写自己的 <物理名>_<sid>），所以 main 是混合库：按 sid 的部分
// 由 sidmerge migrate 搬（不开分区的工程这部分没有文档，搬的是空集），其余 DAO 照共享库处理，要求两侧把 main
// 映射到同一位置；持久总线清单列出生成配置里的 JetStream 用法。
func TestTheChecklistReadsThisProjectsConfigAndDAOs(t *testing.T) {
	cfg, err := loadConfig("../../" + defaultConfig)
	if err != nil {
		t.Fatal(err)
	}
	list, err := sidmerge.BuildChecklist(sidmerge.Server{Config: cfg}, nil)
	if err != nil {
		t.Fatal(err)
	}
	if list.SID <= 0 {
		t.Fatalf("checklist sid = %d, want the config's sid", list.SID)
	}
	var main *sidmerge.DatabaseItem
	for i := range list.Databases {
		if list.Databases[i].Logical == db.DatabaseMain {
			main = &list.Databases[i]
		}
	}
	if len(list.Databases) != 1 || main == nil || !main.ServerScoped || main.Physical == "" {
		t.Fatalf("databases = %+v, want only the logical database %q, scoped by sid for TerrainCellEditor", list.Databases, db.DatabaseMain)
	}
	persistent := map[string]bool{}
	for _, item := range list.Bus {
		persistent[item.Name] = item.Persistent
	}
	// 生成配置：syncbus 走 JetStream（每个 sid 一组 durable），RPC 走 core NATS。
	if !persistent["syncbus"] || persistent["service rpc"] || !persistent["saga stream"] {
		t.Fatalf("bus items = %+v", list.Bus)
	}
	if len(remoteManaged) != 2 || remoteManaged[0] != db.AllianceDaoDBName+"/"+db.AllianceDaoCollection ||
		remoteManaged[1] != db.AllianceMemberDaoDBName+"/"+db.AllianceMemberDaoCollection {
		t.Fatalf("remoteManaged = %v, want the alliance service's two collections", remoteManaged)
	}
}
