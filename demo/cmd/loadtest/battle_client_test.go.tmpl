package main

import (
	"context"
	"net"
	"testing"
	"time"

	"github.com/tjbdwanghaibo/roost-core/framework/sync/lockstep"
	"github.com/tjbdwanghaibo/roost-core/robot/protocol"
	"github.com/tjbdwanghaibo/roost-core/robot/session"
	"github.com/tjbdwanghaibo/roost-core/robot/transport"

	"{{MODULE}}/game/battle"
	"{{MODULE}}/protocol/msgid"
	"{{MODULE}}/protocol/pb"
)

// 战斗客户端的输入不等应答：房间按自己的时钟切帧，客户端每帧等一个往返就会每帧落后一个往返（toxiproxy 演练里
// 200ms ± 100ms 的链路上每个机器人都在第 10 帧左右被答“battle not found”）。这里的对端只收不答：输入必须立刻
// 发出、按帧顺序到达；关键帧哈希仍然等应答，所以对端不答时它要等到期限。
func TestBattleInputsDoNotWaitForTheirAnswers(t *testing.T) {
	client, server := net.Pipe()
	t.Cleanup(func() { _ = client.Close(); _ = server.Close() })
	protocols := protocol.NewRegistry(pbCodec{})
	registerPushes(protocols)
	robotSession := session.New(transport.NewTCPConn(client, 0), protocols)
	t.Cleanup(func() { _ = robotSession.Close() })

	received := make(chan *transport.Packet, 16)
	go func() {
		for {
			packet, err := transport.ReadPacketFrom(server, 0)
			if err != nil {
				close(received)
				return
			}
			received <- packet
		}
	}()

	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
	defer cancel()
	sink := &battleSink{ctx: ctx, session: robotSession, battleID: "b1", state: battle.NewState(), seats: battle.Seats(2)}
	start := time.Now()
	for frame := lockstep.FrameID(1); frame <= 5; frame++ {
		if err := sink.SubmitInput(frame, battle.Encode(battle.Input{DX: 1})); err != nil {
			t.Fatalf("input for frame %d: %v", frame, err)
		}
	}
	if took := time.Since(start); took > time.Second {
		t.Fatalf("five inputs took %s against a peer that never answers: each one waited for its answer", took)
	}
	for frame := uint32(1); frame <= 5; frame++ {
		select {
		case packet := <-received:
			request, err := pb.UnmarshalBattleInputRequest(packet.Payload)
			if err != nil {
				t.Fatalf("packet %d does not decode as a BattleInputRequest: %v", frame, err)
			}
			if packet.MsgID != msgid.MsgBattleInput || request.Frame != frame || request.BattleID != "b1" {
				t.Fatalf("packet %d: msg %d frame %d battle %q", frame, packet.MsgID, request.Frame, request.BattleID)
			}
		case <-time.After(time.Second):
			t.Fatalf("the input for frame %d never reached the peer", frame)
		}
	}

	// 哈希报告要应答：对端不答，它在期限内一直等着，期限到了报错。
	hashCtx, hashCancel := context.WithTimeout(context.Background(), 150*time.Millisecond)
	defer hashCancel()
	sink.ctx = hashCtx
	if err := sink.ReportHash(battle.KeyframeInterval, 42); err == nil {
		t.Fatal("a hash report returned without an answer")
	}
}
