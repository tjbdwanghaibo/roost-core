// -login portal 的凭据那一段：机器人对着真的登录入口（portal 模块的处理器，真实的 account 内存存储，工程自己的
// 身份校验）走三次 HTTP，拿到的握手票据登录模块的认证器认。入口的字段名改了、机器人没跟着改，这里就红。
// 握手之后的 EnterStatus / EnterCreate / EnterGame 在下面的 TestPortalRobotAfterTheHandshake 里对着按脚本应答的
// 对端跑（离线）；真实进程上由 scripts/test-demo-login.sh 跑。

// portalFrontDoor 起一个登录入口：account 里只有 1000 服是开放的。
func portalFrontDoor(t *testing.T) (*svcaccount.Service, string, versionstore.Store[string, svcaccount.Account]) {
	t.Helper()
	now := func() time.Time { return time.Unix(1_800_000_000, 0) }
	names, err := directory.New(versionstore.NewMemoryStore[string, directory.Entry](), directory.Config{Normalize: directory.NormalizeLower, DefaultTTL: time.Minute, Now: now})
	if err != nil {
		t.Fatal(err)
	}
	next := int64(100_000)
	stored := versionstore.NewMemoryStore[string, svcaccount.Account]()
	accounts, err := svcaccount.New(svcaccount.Config{
		Accounts:      stored,
		Roles:         versionstore.NewMemoryStore[int64, svcaccount.Role](),
		Servers:       versionstore.NewMemoryStore[int32, svcaccount.GameServer](),
		Slots:         versionstore.NewMemoryStore[string, svcaccount.Slot](),
		Names:         names,
		Verifier:      accountcollaborators.Verifier(),
		Allocator:     svcaccount.AllocatorFunc(func(context.Context, int32) (int64, error) { next++; return next, nil }),
		NameRules:     accountcollaborators.NameRules(),
		SessionSecret: "loadtest-portal-secret",
		Now:           now,
		SystemNow:     now,
	})
	if err != nil {
		t.Fatal(err)
	}
	if _, err := accounts.UpsertServer(context.Background(), svcaccount.GameServer{ID: 1000, Name: "s1000", Status: svcaccount.ServerOpen}); err != nil {
		t.Fatal(err)
	}
	frontDoor, err := portal.New(portal.Options{Accounts: accounts})
	if err != nil {
		t.Fatal(err)
	}
	engine := httpserver.NewEngine()
	if err := frontDoor.RegisterRoutes(webroute.NewRegistrar(engine)); err != nil {
		t.Fatal(err)
	}
	server := httptest.NewServer(engine)
	t.Cleanup(server.Close)
	return accounts, server.URL, stored
}

// handshakeTicket 读回握手帧里的票据。
func handshakeTicket(t *testing.T, packet *transport.Packet) string {
	t.Helper()
	ticket, _, err := wire.DecodeAuth(packet.Payload)
	if err != nil {
		t.Fatalf("the auth packet does not decode: %v", err)
	}
	return string(ticket)
}

func TestPortalLoginHandsTheRobotAnEnterTicketTheHandshakeTakes(t *testing.T) {
	accounts, url, _ := portalFrontDoor(t)
	login := newPortalLogin(url+"/", 1000)
	authenticator := gamelogin.Authenticator{Accounts: accounts}

	rb := robot.NewContext(robot.Config{ID: 7, PlayerID: 900_007})
	packet, err := login.authPacket(rb)
	if err != nil {
		t.Fatalf("portal login: %v", err)
	}
	ticket := handshakeTicket(t, packet)
	if !strings.HasPrefix(ticket, "enter:") {
		t.Fatalf("the handshake ticket is %q, want enter:<ticket>", ticket)
	}
	principal, err := authenticator.Authenticate(context.Background(), ticket)
	if err != nil || principal.PlayerID != 100_001 || !gamelogin.EnterTicketSession(principal.Claims) {
		t.Fatalf("the handshake with the robot's ticket: %+v, %v", principal, err)
	}
	// 新号：入口不知道玩家号，机器人还带着临时号；要新建时用的名字已经在黑板上，不超过档案的 16 个字符。
	if rb.PlayerID != 900_007 {
		t.Fatalf("the robot adopted player id %d before the game answered", rb.PlayerID)
	}
	name, _ := rb.Blackboard.String(createNameKey)
	if name == "" || len(name) > 16 || strings.ContainsAny(name, " \t") {
		t.Fatalf("the name for EnterCreate is %q, want 1..16 characters without blanks", name)
	}

	// 同一个机器人再连：入口的清单里已经有它的角色，玩家号从那里来；握手解析到同一名玩家。
	packet, err = login.authPacket(rb)
	if err != nil {
		t.Fatalf("portal login again: %v", err)
	}
	if rb.PlayerID != 100_001 {
		t.Fatalf("the returning robot's player id is %d, want 100001 from the server list", rb.PlayerID)
	}
	if again, err := authenticator.Authenticate(context.Background(), handshakeTicket(t, packet)); err != nil || again.PlayerID != 100_001 {
		t.Fatalf("the second handshake: %+v, %v", again, err)
	}
	// 回来的机器人在这里就认定了玩家号，found_alliance 读的联盟名随之写好，且是服务认的名字（以前 portal 这条路写的
	// 是旧键，请求里没有名字，控制器答“联盟名无效”）。
	if allianceName, _ := rb.Blackboard.String("alliance_name"); alliancerule.ValidateName(allianceName) != nil || !strings.Contains(allianceName, "100001") {
		t.Fatalf("the returning robot's alliance name is %q", allianceName)
	}

	// login_as 的另一个身份是另一个账号、另一名玩家，名字也不同。
	rb.Blackboard.Set(identityKey, "member")
	packet, err = login.authPacket(rb)
	if err != nil {
		t.Fatalf("portal login as another identity: %v", err)
	}
	if other, err := authenticator.Authenticate(context.Background(), handshakeTicket(t, packet)); err != nil || other.PlayerID != 100_002 {
		t.Fatalf("the other identity's handshake: %+v, %v", other, err)
	}
	if otherName, _ := rb.Blackboard.String(createNameKey); otherName == name || len(otherName) > 16 {
		t.Fatalf("the other identity's name is %q (the first was %q)", otherName, name)
	}
}

// 走不通的三种：要进的服不在清单里（没登记）、入口拒绝（被封的账号）、入口不可达。每一种都是错误，没有握手帧。
func TestPortalLoginFailsWithoutATicket(t *testing.T) {
	_, url, stored := portalFrontDoor(t)
	rb := robot.NewContext(robot.Config{ID: 1})

	if packet, err := newPortalLogin(url, 1001).authPacket(rb); err == nil || packet != nil || !strings.Contains(err.Error(), "server 1001 is not in the list") {
		t.Fatalf("a server that is not registered: packet %v, err %v", packet, err)
	}
	down := newPortalLogin("http://127.0.0.1:1", 1000)
	if packet, err := down.authPacket(rb); err == nil || packet != nil {
		t.Fatalf("an unreachable front door: packet %v, err %v", packet, err)
	}
	// 被拒绝的登录：把这名机器人的账号封掉之后再登录。
	login := newPortalLogin(url, 1000)
	if _, err := login.authPacket(rb); err != nil {
		t.Fatal(err)
	}
	accountID := svcaccount.Identity{Channel: "demo", OpenID: "robot-" + login.nonce + "-1"}.AccountID()
	if _, _, err := stored.Update(context.Background(), accountID, func(current svcaccount.Account, found bool) (svcaccount.Account, bool, error) {
		current.Banned = true
		return current, found, nil
	}); err != nil {
		t.Fatal(err)
	}
	if packet, err := login.authPacket(rb); err == nil || packet != nil || !strings.Contains(err.Error(), "portal /portal/") {
		t.Fatalf("a banned account: packet %v, err %v", packet, err)
	}
}

// scriptedGame 是按脚本应答的游戏服对端（离线）：机器人在 net.Pipe 一端，对端读出每个请求交给 answer，
// 把返回的包写回（应答带请求的 msg id 与 seq；推送用 push）。received 是对端按到达顺序收到的请求。
type scriptedGame struct {
	mu       sync.Mutex
	conn     net.Conn
	received []*transport.Packet
}

func newScriptedGame(t *testing.T, protocols *protocol.Registry, answer func(*transport.Packet) []*transport.Packet) (*scriptedGame, *session.Session) {
	t.Helper()
	client, server := net.Pipe()
	game := &scriptedGame{conn: server}
	robotSession := session.New(transport.NewTCPConn(client, 0), protocols, nil)
	t.Cleanup(func() { _ = robotSession.Close(); _ = server.Close() })
	go func() {
		for {
			packet, err := transport.ReadPacketFrom(server, 0)
			if err != nil {
				return
			}
			game.mu.Lock()
			game.received = append(game.received, packet)
			game.mu.Unlock()
			if replies := answer(packet); len(replies) > 0 {
				game.write(replies...)
			}
		}
	}()
	return game, robotSession
}

func (game *scriptedGame) write(packets ...*transport.Packet) {
	game.mu.Lock()
	defer game.mu.Unlock()
	_ = transport.WritePacketsTo(game.conn, packets)
}

// push 发一条服务端推送（FlagPush、seq 0）。
func (game *scriptedGame) push(msgID uint32, payload []byte) {
	game.write(&transport.Packet{MsgID: msgID, Flags: wire.FlagPush, Payload: payload})
}

// requests 是对端收到的请求的 msg id，按到达顺序。
func (game *scriptedGame) requests() []uint32 {
	game.mu.Lock()
	defer game.mu.Unlock()
	ids := make([]uint32, 0, len(game.received))
	for _, packet := range game.received {
		ids = append(ids, packet.MsgID)
	}
	return ids
}

// answerTo 是对一个请求的应答包。
func answerTo(t *testing.T, request *transport.Packet, payload []byte, err error) []*transport.Packet {
	if err != nil {
		t.Errorf("encode the answer to msg %d: %v", request.MsgID, err)
		return nil
	}
	return []*transport.Packet{{MsgID: request.MsgID, Seq: request.Seq, Payload: payload}}
}

// portalRobot 是装好 -login portal 的 enter_game 的机器人，连在一个按脚本应答的对端上。
func portalRobot(t *testing.T, answer func(*transport.Packet) []*transport.Packet) (*robot.Context, *action.Registry, *scriptedGame) {
	t.Helper()
	protocols := protocol.NewRegistry(pbCodec{})
	actions := action.NewRegistry()
	newPortalLogin("http://127.0.0.1:1", 1000).registerEnter(actions, protocols)
	registerPushes(protocols)
	game, robotSession := newScriptedGame(t, protocols, answer)
	rb := robot.NewContext(robot.Config{ID: 3, PlayerID: 900_003, Protocols: protocols})
	rb.RunAction = actions.Run
	rb.SetSession(robotSession)
	rb.Blackboard.Set(createNameKey, "rtest_3")
	return rb, actions, game
}

// 握手之后的三步（离线）：机器人的 enter_game（-login portal）对着按脚本应答的游戏服。服务器告知要新建时先
// EnterCreate（名字取自黑板）再 EnterGame；告知不用新建时只 EnterGame；告知带码时不再发任何请求；告知没来时
// 当作要新建，已建成的 enter_created 也算过；EnterGame 带码时失败；玩家号取自 EnterGame 的应答。
func TestPortalRobotAfterTheHandshake(t *testing.T) {
	const player = int64(100_042)
	// standard 是正常的游戏服：EnterCreate 答 created（或 createdCode），EnterGame 答 enterCode。
	standard := func(t *testing.T, createCode, enterCode int32, names *[]string) func(*transport.Packet) []*transport.Packet {
		return func(request *transport.Packet) []*transport.Packet {
			switch request.MsgID {
			case msgid.MsgEnterCreate:
				create, err := pb.UnmarshalEnterCreateRequest(request.Payload)
				if err != nil {
					t.Errorf("EnterCreate does not decode: %v", err)
					return nil
				}
				*names = append(*names, create.Name)
				payload, err := pb.MarshalEnterCreateResponse(&pb.EnterCreateResponse{Code: createCode})
				return answerTo(t, request, payload, err)
			case msgid.MsgEnterGame:
				answer := &pb.EnterGameResponse{Code: enterCode}
				if enterCode == 0 {
					answer.PlayerID, answer.First = player, true
				} else {
					answer.Reason = "enter_need_create"
				}
				payload, err := pb.MarshalEnterGameResponse(answer)
				return answerTo(t, request, payload, err)
			}
			t.Errorf("unexpected request msg %d", request.MsgID)
			return nil
		}
	}
	// run 起 enter_game，100 毫秒后（机器人已在等告知；它最多等 1 秒）推 notice（nil 时不推）。
	// 告知 need_create=false、码 0 时 PB 编码是空的载荷，照样是一条推送。
	run := func(t *testing.T, rb *robot.Context, actions *action.Registry, game *scriptedGame, notice *pb.EnterStatusPush) error {
		done := make(chan error, 1)
		go func() {
			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
			defer cancel()
			done <- actions.Run(ctx, rb, "enter_game", nil)
		}()
		if notice != nil {
			payload, err := pb.MarshalEnterStatusPush(notice)
			if err != nil {
				t.Fatal(err)
			}
			time.Sleep(100 * time.Millisecond)
			game.push(msgid.MsgEnterStatus, payload)
		}
		return <-done
	}
	same := func(got []uint32, want ...uint32) bool {
		if len(got) != len(want) {
			return false
		}
		for i := range got {
			if got[i] != want[i] {
				return false
			}
		}
		return true
	}

	t.Run("need_create", func(t *testing.T) {
		var names []string
		rb, actions, game := portalRobot(t, standard(t, 0, 0, &names))
		if err := run(t, rb, actions, game, &pb.EnterStatusPush{NeedCreate: true}); err != nil {
			t.Fatalf("enter_game: %v", err)
		}
		if got := game.requests(); !same(got, msgid.MsgEnterCreate, msgid.MsgEnterGame) {
			t.Fatalf("the game received %v, want EnterCreate then EnterGame", got)
		}
		if len(names) != 1 || names[0] != "rtest_3" {
			t.Fatalf("EnterCreate asked for %v, want the name on the blackboard", names)
		}
		if id, _ := rb.Blackboard.Int64("player_id"); rb.PlayerID != player || id != player {
			t.Fatalf("the robot adopted %d (blackboard %d), want %d from EnterGame", rb.PlayerID, id, player)
		}
	})
	t.Run("already_created", func(t *testing.T) {
		var names []string
		rb, actions, game := portalRobot(t, standard(t, 0, 0, &names))
		if err := run(t, rb, actions, game, &pb.EnterStatusPush{}); err != nil {
			t.Fatalf("enter_game: %v", err)
		}
		if got := game.requests(); !same(got, msgid.MsgEnterGame) {
			t.Fatalf("the game received %v, want EnterGame alone (the notice said no create)", got)
		}
	})
	t.Run("refused_by_the_notice", func(t *testing.T) {
		var names []string
		rb, actions, game := portalRobot(t, standard(t, 0, 0, &names))
		elsewhere := apperrors.ErrLoginElsewhere.Code()
		err := run(t, rb, actions, game, &pb.EnterStatusPush{Code: elsewhere, Reason: "login_elsewhere"})
		if err == nil || !strings.Contains(err.Error(), "will not serve") || !strings.Contains(err.Error(), "login_elsewhere") {
			t.Fatalf("enter_game after a refusing notice: %v", err)
		}
		if got := game.requests(); len(got) != 0 {
			t.Fatalf("the robot went on after the refusal and sent %v", got)
		}
	})
	t.Run("no_notice_created_already", func(t *testing.T) {
		var names []string
		rb, actions, game := portalRobot(t, standard(t, apperrors.ErrEnterCreated.Code(), 0, &names))
		start := time.Now()
		if err := run(t, rb, actions, game, nil); err != nil {
			t.Fatalf("enter_game without a notice: %v", err)
		}
		if waited := time.Since(start); waited < enterStatusWait {
			t.Fatalf("the robot went on after %v, before the notice window (%v) closed", waited, enterStatusWait)
		}
		if got := game.requests(); !same(got, msgid.MsgEnterCreate, msgid.MsgEnterGame) {
			t.Fatalf("the game received %v, want EnterCreate (answered enter_created) then EnterGame", got)
		}
	})
	t.Run("enter_refused", func(t *testing.T) {
		var names []string
		rb, actions, game := portalRobot(t, standard(t, 0, apperrors.ErrEnterNeedCreate.Code(), &names))
		err := run(t, rb, actions, game, &pb.EnterStatusPush{})
		if err == nil || !strings.Contains(err.Error(), "enter_need_create") {
			t.Fatalf("enter_game answered enter_need_create: %v", err)
		}
		if rb.PlayerID != 900_003 {
			t.Fatalf("a refused EnterGame adopted player id %d", rb.PlayerID)
		}
	})
}

