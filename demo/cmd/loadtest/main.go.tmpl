const profileName = "demo"

func main() {
	endpoint := flag.String("endpoint", "127.0.0.1:7000", "player TCP address")
	count := flag.Int("count", 10, "robot population")
	executor := flag.String("executor", "pool", "pool, looping, or arrival-rate; rates count whole scenarios, not messages")
	rate := flag.Float64("rate", 10, "arrival-rate scenarios started per second")
	maxConcurrent := flag.Int("max-concurrent", 1024, "arrival-rate in-flight robot limit")
	seed := flag.Int64("seed", 1, "reproducible scenario RNG seed")
	rampStep := flag.Int("ramp-step", 1, "robots started per ramp step")
	rampInterval := flag.Duration("ramp-interval", 0, "delay between population ramp steps")
	reportPath := flag.String("report", "", "optional JSON report output file")
	duration := flag.Duration("duration", 0, "bound the run; 0 lets every robot finish its scenario once")
	scenarioDir := flag.String("scenarios", "loadtest/scenarios", "directory of scenario YAML files")
	scenarioName := flag.String("scenario", "demo", "scenario to run")
	firstPlayerID := flag.Int64("first-player-id", 900_000, "provisional id for robot i before the account service allocates its real one")
	maxErrorRate := flag.Float64("max-error-rate", 0, "threshold: failed robots / finished robots")
	// The scenario deliberately waits for matchmaking (poll every 250ms while
	// the matchmaker ticks every 500ms), so a whole-scenario p95 of a few
	// hundred milliseconds is the floor, not a regression.
	maxP95 := flag.Float64("max-p95", 16.0, "threshold: scenario cost p95, seconds; a regression bound, not an SLO. The scenario waits on four asynchronous chains (reward mail, two gift sagas, match) and then plays a lockstep battle for its full frame budget: the slowest robot of a healthy run takes 7-10s (two game servers on one machine at the top of that range), so the bound is about twice that. The p95 is estimated from power-of-two buckets narrowed to the observed fastest and slowest robot; with 10 robots or fewer it is the slowest robot")
	metricsAddr := flag.String("metrics-addr", "", "serve this process's metrics at http://<addr>/metrics for Prometheus (deploy/dev/observability scrapes 127.0.0.1:9300)")
	loginMode := flag.String("login", "bus", "how robots log in: bus (Login → CreateRole → SelectRole on the account service over -account-nats, session ticket on the handshake) or portal (the front door at -portal: login → server list → enter ticket, then EnterStatus / EnterCreate / EnterGame)")
	portalURL := flag.String("portal", "http://127.0.0.1:8081", "-login portal: base URL of the front door (web.addr in config.account.yaml)")
	accountNATS := flag.String("account-nats", "nats://127.0.0.1:4222", "-login bus: NATS url of the bus the account service answers on; robots log in for real (Login → CreateRole → SelectRole) and present session tickets")
	natsPrefix := flag.String("nats-prefix", "{{PROJECT}}", "bus subject prefix (nats.prefix in the services' configs; generated from the project name)")
	serverID := flag.Int("server-id", 1000, "the game server's sid, which roles are created on")
	gameOps := flag.String("game-ops", "127.0.0.1:9100", "ops address of that game server (ops.addr in config.game.yaml); the guild_offline_join scenario runs its operator step there (gm.player.join_guild)")
	adminToken := flag.String("admin-token", "dev-gm-token", "ops admin token for that operator step (ops.admin_token in config.game.yaml)")
	flag.Parse()

	if *metricsAddr != "" {
		go serveMetrics(*metricsAddr)
	}

	// The credential path. bus needs the account service's bus; portal needs
	// nothing but HTTP, like a client.
	var login robotLogin
	switch *loginMode {
	case "bus":
		accounts, err := newAccountLogin(*accountNATS, *natsPrefix, int32(*serverID))
		if err != nil {
			fmt.Fprintf(os.Stderr, "loadtest: %v\n", err)
			os.Exit(1)
		}
		defer accounts.Close()
		login = accounts
	case "portal":
		login = newPortalLogin(*portalURL, int32(*serverID))
	default:
		fmt.Fprintf(os.Stderr, "loadtest: -login %q is not bus or portal\n", *loginMode)
		os.Exit(2)
	}

	cfg := runner.Config{Executor: runner.Executor(*executor), Count: *count, Rate: *rate, MaxConcurrent: *maxConcurrent, Seed: *seed, Duration: *duration, Scenario: *scenarioName, Ramp: runner.Ramp{Step: *rampStep, Interval: *rampInterval}, Transport: transport.Config{Type: playertcp.TransportType, Endpoint: *endpoint}}
	if cfg.Executor != runner.ExecutorPool && cfg.Duration <= 0 {
		fmt.Fprintln(os.Stderr, "loadtest: looping/arrival-rate requires a positive -duration")
		os.Exit(2)
	}
	ops := gameOpsClient{addr: *gameOps, token: *adminToken, http: &http.Client{Timeout: 15 * time.Second}}
	if err := run(cfg, *scenarioDir, *firstPlayerID, *maxErrorRate, *maxP95, *reportPath, login, ops); err != nil {
		fmt.Fprintf(os.Stderr, "loadtest: %v\n", err)
		os.Exit(1)
	}
}

func run(cfg runner.Config, scenarioDir string, firstPlayerID int64, maxErrorRate, maxP95 float64, reportPath string, login robotLogin, ops gameOpsClient) error {
	playertcp.MustRegister()

	protocols := protocol.NewRegistry(pbCodec{})
	actions := action.NewRegistry()
	scenarios := scenario.NewRegistry()
	registerCalls(actions, protocols)
	login.registerEnter(actions, protocols)
	registerOfflineJoin(actions, protocols, ops)
	registerPushes(protocols)
	if err := loadScenarios(scenarios, scenarioDir); err != nil {
		return err
	}

	manager := loadtest.New(loadtest.Config{
		Profiles: map[string]loadtest.Profile{
			profileName: {
				Run: cfg,
				Thresholds: []loadtest.Threshold{
					{Metric: "error_rate", Max: maxErrorRate},
					{Metric: "drop_rate", Max: 0},
					{Metric: "p95", Max: maxP95},
				},
			},
		},
		RunnerOptions: []runner.Option{
			runner.WithActionRegistry(actions),
			runner.WithScenarioRegistry(scenarios),
			runner.WithProtocolRegistry(protocols),
			runner.WithIdentityProvider(func(index int) (int64, error) {
				return firstPlayerID + int64(index), nil
			}),
			// The handshake credential is a session ticket the account
			// service minted for this robot's role — the same path a real
			// client takes; see internal/access/player/tcp/auth.go.
			runner.WithAuthProvider(login.authPacket),
		},
	})

	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()
	started, err := manager.Start(ctx, loadtest.StartRequest{Profile: profileName})
	if err != nil {
		return err
	}
	snapshot, err := waitForRun(ctx, manager, started.RunID)
	if err != nil {
		return err
	}
	report, err := json.MarshalIndent(snapshot, "", "  ")
	if err != nil {
		return err
	}
	if reportPath != "" {
		if err := os.WriteFile(reportPath, append(report, '\n'), 0o644); err != nil {
			return fmt.Errorf("write report: %w", err)
		}
	}
	fmt.Println(string(report))
	if snapshot.State != loadtest.StateFinished {
		// snapshot.Error names the violated threshold with its actual value
		// and bound, or the runner's error; the JSON above has every verdict.
		return fmt.Errorf("run %s ended %s (%s): %s", snapshot.RunID, snapshot.State, snapshot.StopReason, snapshot.Error)
	}
	return nil
}

// robotLogin is how a robot gets onto the game: the handshake credential, and
// the scenario's enter_game action. The two belong together — which ticket
// was presented decides what the server expects next.
type robotLogin interface {
	// authPacket is the handshake frame for this robot's next connect.
	authPacket(rb *robot.Context) (*transport.Packet, error)
	// registerEnter registers the action the scenarios call enter_game.
	registerEnter(actions *action.Registry, protocols *protocol.Registry)
}

// registerEnter for the bus login: a session-ticket session is loaded or
// created by EnterGame itself, so enter_game is the plain call.
func (login *accountLogin) registerEnter(actions *action.Registry, protocols *protocol.Registry) {
	action.MustRegisterCall[pb.EnterGameRequest, pb.EnterGameResponse](actions, protocols, "enter_game", msgid.MsgEnterGame,
		action.OnResp(func(_ *robot.Context, resp *pb.EnterGameResponse) error {
			return coded(resp.Code, resp.Reason)
		}))
}

// portalLogin is the client's path through the front door (the portal
// module): three HTTP calls on the account process, none of which needs the
// bus or a secret.
//
//	POST /portal/login    channel demo, credential demo:<open_id>  -> account ticket
//	POST /portal/servers  account ticket                            -> the server must be listed
//	POST /portal/enter    account ticket, server id                 -> enter:<ticket>
//
// The robot does not learn its player id here: the front door does not know
// it for a new account (the mapping is made by the handshake). It is adopted
// from the EnterGame answer.
type portalLogin struct {
	base     string
	serverID int32
	nonce    string
	http     *http.Client
}

func newPortalLogin(base string, serverID int32) *portalLogin {
	return &portalLogin{
		base: strings.TrimRight(base, "/"), serverID: serverID,
		nonce: strconv.FormatInt(time.Now().UnixNano()%1_000_000_000, 36),
		http:  &http.Client{Timeout: 10 * time.Second},
	}
}

// post sends one front-door request and decodes the answer. A refusal
// ("ok": false) is an error carrying the front door's code and reason.
func (login *portalLogin) post(ctx context.Context, path string, request, response any) error {
	body, err := json.Marshal(request)
	if err != nil {
		return err
	}
	httpRequest, err := http.NewRequestWithContext(ctx, http.MethodPost, login.base+path, bytes.NewReader(body))
	if err != nil {
		return err
	}
	httpRequest.Header.Set("Content-Type", "application/json")
	answer, err := login.http.Do(httpRequest)
	if err != nil {
		return fmt.Errorf("portal %s: %w", path, err)
	}
	defer answer.Body.Close()
	raw, err := io.ReadAll(io.LimitReader(answer.Body, 1<<20))
	if err != nil {
		return fmt.Errorf("portal %s: %w", path, err)
	}
	var verdict struct {
		OK     bool   `json:"ok"`
		Code   int64  `json:"code"`
		Reason string `json:"reason"`
		Error  string `json:"error"`
	}
	if err := json.Unmarshal(raw, &verdict); err != nil {
		return fmt.Errorf("portal %s: http %d, not JSON: %w", path, answer.StatusCode, err)
	}
	if !verdict.OK {
		return fmt.Errorf("portal %s: http %d code %d %s%s", path, answer.StatusCode, verdict.Code, verdict.Reason, verdict.Error)
	}
	return json.Unmarshal(raw, response)
}

// createNameKey is the blackboard key of the name the next EnterCreate asks for.
const createNameKey = "create_name"

func (login *portalLogin) authPacket(rb *robot.Context) (*transport.Packet, error) {
	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()
	// The same identities as the bus login: one account per robot, plus one
	// per login_as name.
	identity, _ := rb.Blackboard.Get(identityKey)
	name, _ := identity.(string)
	openID := fmt.Sprintf("robot-%s-%d", login.nonce, rb.ID)
	// The name is the game's now (the profile module's rule: at most 16
	// characters), asked for in EnterCreate.
	createName := fmt.Sprintf("r%s_%d", login.nonce, rb.ID)
	if name != "" {
		openID += "-" + name
		createName += name[:1]
	}
	var loggedIn struct {
		AccountTicket string `json:"account_ticket"`
	}
	if err := login.post(ctx, "/portal/login", map[string]any{"channel": "demo", "open_id": openID, "credential": "demo:" + openID}, &loggedIn); err != nil {
		return nil, err
	}
	var listed struct {
		Servers []struct {
			ServerID int32 `json:"server_id"`
			Role     *struct {
				PlayerID int64 `json:"player_id"`
			} `json:"role"`
		} `json:"servers"`
	}
	if err := login.post(ctx, "/portal/servers", map[string]any{"account_ticket": loggedIn.AccountTicket}, &listed); err != nil {
		return nil, err
	}
	found := false
	for _, server := range listed.Servers {
		if server.ServerID != login.serverID {
			continue
		}
		found = true
		if server.Role != nil {
			// A returning identity: the front door knows the player.
			rb.PlayerID = server.Role.PlayerID
			rb.Blackboard.Set("player_id", rb.PlayerID)
		}
	}
	if !found {
		return nil, fmt.Errorf("portal: server %d is not in the list of %d servers (accountctl upsert-server -sid %d)", login.serverID, len(listed.Servers), login.serverID)
	}
	var entered struct {
		Ticket string `json:"ticket"`
	}
	if err := login.post(ctx, "/portal/enter", map[string]any{"account_ticket": loggedIn.AccountTicket, "server_id": login.serverID}, &entered); err != nil {
		return nil, err
	}
	rb.Blackboard.Set(createNameKey, createName)
	return playertcp.AuthPacket(entered.Ticket), nil
}

// enterStatusWait is how long enter_game waits for the server's EnterStatus
// before going on without it. The notice is only a notice: it can be lost, or
// land before this action listens.
const enterStatusWait = time.Second

// registerEnter for the portal login: an enter-ticket session must create
// first. enter_game waits for EnterStatus; when it says need_create — or does
// not arrive — it sends EnterCreate (a player already built answers
// enter_created, which is as good), then EnterGame. The player id the
// handshake resolved is adopted from the EnterGame answer.
func (login *portalLogin) registerEnter(actions *action.Registry, protocols *protocol.Registry) {
	protocols.MustRegisterDecoder(msgid.MsgEnterStatus, protocol.DecodeTyped(msgid.MsgEnterStatus, pb.UnmarshalEnterStatusPush))
	action.MustRegisterCall[pb.EnterCreateRequest, pb.EnterCreateResponse](actions, protocols, "enter_create", msgid.MsgEnterCreate,
		action.MapField[pb.EnterCreateResponse]("Name", createNameKey),
		action.OnResp(func(_ *robot.Context, resp *pb.EnterCreateResponse) error {
			if resp.Code == apperrors.ErrEnterCreated.Code() {
				return nil
			}
			return coded(resp.Code, resp.Reason)
		}))
	action.MustRegisterCall[pb.EnterGameRequest, pb.EnterGameResponse](actions, protocols, "enter_game_built", msgid.MsgEnterGame,
		action.OnResp(func(rb *robot.Context, resp *pb.EnterGameResponse) error {
			if err := coded(resp.Code, resp.Reason); err != nil {
				return err
			}
			rb.PlayerID = resp.PlayerID
			rb.Blackboard.Set("player_id", rb.PlayerID)
			rb.Blackboard.Set("guild_name", fmt.Sprintf("robot guild %d", rb.PlayerID))
			return nil
		}))
	actions.MustRegister(action.Func{ActionName: "enter_game", Handle: func(ctx context.Context, rb *robot.Context, param any) error {
		robotSession := rb.Session()
		if robotSession == nil {
			return fmt.Errorf("session not connected")
		}
		needCreate := true
		waitCtx, cancel := context.WithTimeout(ctx, enterStatusWait)
		pushed, err := robotSession.WaitPush(waitCtx, msgid.MsgEnterStatus, nil)
		cancel()
		if err == nil {
			status, ok := pushed.Value.(*pb.EnterStatusPush)
			if !ok {
				return fmt.Errorf("unexpected EnterStatus type %T", pushed.Value)
			}
			if err := coded(status.Code, status.Reason); err != nil {
				return fmt.Errorf("the server will not serve this session: %w", err)
			}
			needCreate = status.NeedCreate
		} else if ctx.Err() != nil {
			return ctx.Err()
		}
		if needCreate {
			if err := actions.Run(ctx, rb, "enter_create", nil); err != nil {
				return err
			}
		}
		return actions.Run(ctx, rb, "enter_game_built", param)
	}})
}

// accountLogin is the real credential path: the robot process talks to the
// account service over the bus exactly the way a login server would, and
// hands the resulting ticket to the game's TCP handshake. Each run uses fresh
// open ids (the run nonce is part of the id), because an account may hold one
// role per server and there is no role listing to recover an old PlayerID.
type accountLogin struct {
	bus      *bus.Bus
	accounts svcaccount.Accounts
	serverID int32
	nonce    string
}

func newAccountLogin(url, prefix string, serverID int32) (*accountLogin, error) {
	assembly, err := natsdriver.Assemble(fnats.DefaultConfig(url), natsdriver.ClientOptions{})
	if err != nil {
		return nil, fmt.Errorf("account login: connect %s: %w", url, err)
	}
	b := bus.New(assembly.Client, assembly.RPC, nil, bus.Config{SvcType: "loadtest", Prefix: prefix, WorkerNum: 2, QueueCap: 256})
	if err := b.Start(); err != nil {
		return nil, fmt.Errorf("account login: start bus: %w", err)
	}
	client, err := svcaccount.NewBusClient(b, "", 0)
	if err != nil {
		b.Stop()
		return nil, fmt.Errorf("account login: %w", err)
	}
	return &accountLogin{bus: b, accounts: client, serverID: serverID, nonce: strconv.FormatInt(time.Now().UnixNano()%1_000_000_000, 36)}, nil
}

func (login *accountLogin) Close() {
	if login != nil && login.bus != nil {
		login.bus.Stop()
	}
}

// authPacket runs Login → CreateRole → SelectRole for one robot. The demo
// verifier accepts channel "demo" with credential "demo:<open_id>"; a real
// channel would hand out a platform token here. The role's PlayerID — the
// one the account service allocated — replaces the robot's provisional id.
func (login *accountLogin) authPacket(rb *robot.Context) (*transport.Packet, error) {
	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()
	// A robot may play more than one role: login_as names the identity the
	// next connect logs in as ("" is the robot's own). Each identity is its
	// own account whose role is created once; connecting again as the same
	// identity logs in and selects the role it already has.
	identity, _ := rb.Blackboard.Get(identityKey)
	name, _ := identity.(string)
	openID := fmt.Sprintf("robot-%s-%d", login.nonce, rb.ID)
	roleName := "robot_" + login.nonce + "_" + strconv.Itoa(rb.ID)
	if name != "" {
		openID += "-" + name
		roleName += "_" + name
	}
	account, err := login.accounts.Login(ctx, svcaccount.Identity{Channel: "demo", OpenID: openID, Credential: "demo:" + openID})
	if err != nil {
		return nil, fmt.Errorf("account login: %w", err)
	}
	playerID, known := rb.Blackboard.Get("role:" + name)
	if !known {
		role, err := login.accounts.CreateRole(ctx, account.ID, login.serverID, roleName)
		if err != nil {
			return nil, fmt.Errorf("account create role: %w", err)
		}
		playerID = role.PlayerID
		rb.Blackboard.Set("role:"+name, role.PlayerID)
	}
	session, err := login.accounts.SelectRole(ctx, account.ID, playerID.(int64))
	if err != nil {
		return nil, fmt.Errorf("account select role: %w", err)
	}
	rb.PlayerID = playerID.(int64)
	rb.Blackboard.Set("player_id", rb.PlayerID)
	// Every robot founds its own guild, under a name of its own: names are not
	// unique in the alliance service, but a per-robot name keeps a run's
	// guilds apart when reading them back.
	rb.Blackboard.Set("guild_name", fmt.Sprintf("robot guild %d", rb.PlayerID))
	return playertcp.AuthPacket(fmt.Sprintf("session:%d:%s", rb.PlayerID, session.Token)), nil
}

// serveMetrics exposes the robot-side registry — the only place the scenario
// and per-call histograms live — the same way every roost process does.
func serveMetrics(addr string) {
	mux := http.NewServeMux()
	mux.HandleFunc("/metrics", func(w http.ResponseWriter, _ *http.Request) {
		w.Header().Set("Content-Type", "text/plain; version=0.0.4")
		_, _ = w.Write(metrics.PrometheusText(metrics.Snapshot()))
	})
	server := &http.Server{Addr: addr, Handler: mux, ReadHeaderTimeout: 5 * time.Second}
	if err := server.ListenAndServe(); err != nil && !errors.Is(err, http.ErrServerClosed) {
		fmt.Fprintf(os.Stderr, "loadtest: metrics endpoint: %v\n", err)
	}
}

// identityKey is the blackboard key login_as sets and authPacket reads.
const identityKey = "identity"

// gameOpsClient runs operator commands on the game server's ops listener
// (POST /admin/execute, the GM surface of internal/service/<game>/gm.go).
type gameOpsClient struct {
	addr, token string
	http        *http.Client
}

func (ops gameOpsClient) execute(ctx context.Context, name string, payload any) (map[string]any, error) {
	body, err := json.Marshal(map[string]any{"name": name, "payload": payload})
	if err != nil {
		return nil, err
	}
	request, err := http.NewRequestWithContext(ctx, http.MethodPost, "http://"+ops.addr+"/admin/execute", strings.NewReader(string(body)))
	if err != nil {
		return nil, err
	}
	request.Header.Set("Content-Type", "application/json")
	request.Header.Set("X-Admin-Token", ops.token)
	response, err := ops.http.Do(request)
	if err != nil {
		return nil, fmt.Errorf("%s on the game's ops %s: %w", name, ops.addr, err)
	}
	defer response.Body.Close()
	raw, _ := io.ReadAll(io.LimitReader(response.Body, 1<<20))
	if response.StatusCode != http.StatusOK {
		return nil, fmt.Errorf("%s on the game's ops %s: %s %s", name, ops.addr, response.Status, strings.TrimSpace(string(raw)))
	}
	var decoded struct {
		Data map[string]any `json:"data"`
	}
	if err := json.Unmarshal(raw, &decoded); err != nil {
		return nil, fmt.Errorf("%s: %w: %s", name, err, raw)
	}
	return decoded.Data, nil
}

// registerOfflineJoin is the guild_offline_join scenario's half (alliance
// plan §2.5B, decision D): a player made a guild member while offline sees
// the guild at the next login. Nobody tells the game process about it at the
// time — the membership notice finds nobody online — so the login asks the
// alliance service (refreshGuild → Membership) and writes the answer into the
// player's copy. Without that question "my guild" stays empty until the next
// notice, which may never come.
//
// One robot plays two roles: its own founds an open guild through the found
// saga, then a second one (login_as member) logs in once and disconnects.
// The operator step (gm.player.join_guild on the game's ops) joins the member
// to the guild — and only once the game holds no session of the member: the
// command refuses while one is there, so the retry around it is the barrier
// that makes "offline" a fact, not a timing. Then the member logs in again
// and reads "my guild" with no guild id and the version the join answered:
// it must be the founder's guild with the member in it.
func registerOfflineJoin(actions *action.Registry, protocols *protocol.Registry, ops gameOpsClient) {
	// login_as {identity}: the identity the next connect logs in as.
	actions.MustRegister(action.Func{ActionName: "login_as", Handle: func(_ context.Context, rb *robot.Context, param any) error {
		rb.Blackboard.Set(identityKey, action.ParamsOf(rb, param).String("identity", ""))
		return nil
	}})
	// disconnect closes the robot's connection; the server sees the socket
	// close like any client going away.
	actions.MustRegister(action.Func{ActionName: "disconnect", Handle: func(_ context.Context, rb *robot.Context, _ any) error {
		rb.SetSession(nil)
		return nil
	}})
	// join_guild_offline: the operator joins the current identity (offline)
	// to the guild on the blackboard (the one the found saga reported).
	actions.MustRegister(action.Func{ActionName: "join_guild_offline", Handle: func(ctx context.Context, rb *robot.Context, _ any) error {
		raw, _ := rb.Blackboard.Get("guild_id")
		guildID, _ := raw.(int64)
		if guildID == 0 {
			return fmt.Errorf("join_guild_offline: no guild on the blackboard; found one first")
		}
		data, err := ops.execute(ctx, "gm.player.join_guild", map[string]any{
			"player_id": rb.PlayerID, "guild_id": guildID, "request_id": fmt.Sprintf("robot-offline-join-%d", rb.PlayerID),
		})
		if err != nil {
			return err
		}
		if joined, _ := data["joined"].(bool); !joined {
			return fmt.Errorf("player %d still has %v session(s) on the game; not joined yet", rb.PlayerID, data["sessions"])
		}
		version, _ := data["version"].(float64)
		members, _ := data["members"].(float64)
		rb.Blackboard.Set("min_version", int64(version))
		rb.Blackboard.Set("offline_join_members", int64(members))
		return nil
	}})
	// my_guild reads "the guild I am in" (no guild id: the player's own copy,
	// then the guild's mirror at least as new as the join).
	action.MustRegisterCall[pb.GuildInfoRequest, pb.GuildResponse](actions, protocols, "my_guild", msgid.MsgGuildInfo,
		action.MapField[pb.GuildResponse]("GuildID", "my_guild_query_id"),
		action.OnResp(func(rb *robot.Context, resp *pb.GuildResponse) error {
			raw, _ := rb.Blackboard.Get("guild_id")
			want, _ := raw.(int64)
			if err := coded(resp.Code, resp.Reason); err != nil {
				return fmt.Errorf("player %d joined guild %d while offline, then logged in: my guild answers %w", rb.PlayerID, want, err)
			}
			rawMembers, _ := rb.Blackboard.Get("offline_join_members")
			members, _ := rawMembers.(int64)
			if resp.GuildID != want || int64(resp.Members) < members {
				return fmt.Errorf("player %d joined guild %d (%d members) while offline, then logged in: my guild is %d with %d members",
					rb.PlayerID, want, members, resp.GuildID, resp.Members)
			}
			return nil
		}))
}

// registerCalls turns the project's request/response pairs into actions a
// scenario can name. Request fields fill from the scenario param (snake_case
// of the json tag) or the blackboard. The generated pb types carry no
// GetCode(), so each call checks Code itself: a coded failure from the server
// is a failed robot, which is what makes this a regression test.
func registerCalls(actions *action.Registry, protocols *protocol.Registry) {
	// enter_game is registered by the login in use (robotLogin.registerEnter):
	// what a session must send before EnterGame depends on how it shook hands.
	action.MustRegisterCall[pb.AddItemRequest, pb.AddItemResponse](actions, protocols, "add_item", msgid.MsgAddItem,
		action.OnResp(func(_ *robot.Context, resp *pb.AddItemResponse) error {
			return coded(resp.Code, resp.Reason)
		}))
	action.MustRegisterCall[pb.AddExpRequest, pb.AddExpResponse](actions, protocols, "add_exp", msgid.MsgAddExp,
		action.OnResp(func(_ *robot.Context, resp *pb.AddExpResponse) error {
			return coded(resp.Code, resp.Reason)
		}))
	// join_queue remembers the ticket on the blackboard under the name
	// poll_match's request field resolves to (ticket_id).
	action.MustRegisterCall[pb.JoinQueueRequest, pb.JoinQueueResponse](actions, protocols, "join_queue", msgid.MsgJoinQueue,
		action.OnResp(func(rb *robot.Context, resp *pb.JoinQueueResponse) error {
			if err := coded(resp.Code, resp.Reason); err != nil {
				return err
			}
			rb.Blackboard.Set("ticket_id", resp.TicketID)
			return nil
		}))
	// poll_match fails while the ticket is still waiting, so a Retry node
	// around it is the wait-for-match loop.
	action.MustRegisterCall[pb.PollMatchRequest, pb.PollMatchResponse](actions, protocols, "poll_match", msgid.MsgPollMatch,
		action.OnResp(func(rb *robot.Context, resp *pb.PollMatchResponse) error {
			if err := coded(resp.Code, resp.Reason); err != nil {
				return err
			}
			if resp.State != "matched" {
				return fmt.Errorf("ticket still %s", resp.State)
			}
			rb.Blackboard.Set("match_id", resp.MatchID)
			// The members, in the order the match service returned them:
			// that order is the lockstep seat order, so the battle action
			// can work out which seat this robot holds.
			rb.Blackboard.Set("match_members", append([]int64(nil), resp.Members...))
			return nil
		}))
	// send_chat publishes through the chat service; the world channel fans
	// the stored line back to every online robot, including the sender, so
	// the scenario can wait for its own push (msg 10101).
	action.MustRegisterCall[pb.ChatSendRequest, pb.ChatSendResponse](actions, protocols, "send_chat", msgid.MsgChatSend,
		action.OnResp(func(rb *robot.Context, resp *pb.ChatSendResponse) error {
			if err := coded(resp.Code, resp.Reason); err != nil {
				return err
			}
			if resp.Seq <= 0 {
				return fmt.Errorf("chat message stored without a sequence")
			}
			rb.Blackboard.Set("chat_seq", resp.Seq)
			return nil
		}))
	// chat_history is the reconnect path: reading back must return at least
	// the line this robot just sent (the login announcement is there too).
	action.MustRegisterCall[pb.ChatHistoryRequest, pb.ChatHistoryResponse](actions, protocols, "chat_history", msgid.MsgChatHistory,
		action.OnResp(func(_ *robot.Context, resp *pb.ChatHistoryResponse) error {
			if err := coded(resp.Code, resp.Reason); err != nil {
				return err
			}
			if len(resp.Messages) == 0 {
				return fmt.Errorf("chat history came back empty after a publish")
			}
			return nil
		}))
	// The mailbox is the mailbox module's (MailboxList / MailboxClaim).
	// mailbox_list fails until the level-up reward has arrived (the effect
	// chain is asynchronous: WAL → outbox → JetStream → consumer → mail.Send),
	// so a Retry node around it is the wait; the first claimable mail's id goes
	// on the blackboard under mailbox_claim's request field (mail_id).
	// Claimable is the module's answer: the mail service would reserve it AND
	// the attachment is a kind this build can grant (an item, through the
	// mailbox + bag glue).
	action.MustRegisterCall[pb.MailboxListRequest, pb.MailboxListResponse](actions, protocols, "mailbox_list", msgid.MsgMailboxList,
		action.OnResp(func(rb *robot.Context, resp *pb.MailboxListResponse) error {
			if err := coded(resp.Code, resp.Reason); err != nil {
				return err
			}
			for _, mail := range resp.Mails {
				if mail.Claimable && mail.HasAttachment {
					rb.Blackboard.Set("mail_id", mail.MailID)
					return nil
				}
			}
			return fmt.Errorf("no claimable mail yet (%d in the box)", len(resp.Mails))
		}))
	// Every mail this scenario claims carries an item (the level-up reward,
	// the gift): the answer names the kind, the item id, how many this mail
	// granted and how many of that item the bag holds afterwards.
	action.MustRegisterCall[pb.MailboxClaimRequest, pb.MailboxClaimResponse](actions, protocols, "mailbox_claim", msgid.MsgMailboxClaim,
		action.OnResp(func(rb *robot.Context, resp *pb.MailboxClaimResponse) error {
			if err := coded(resp.Code, resp.Reason); err != nil {
				return err
			}
			if resp.AttachmentType != "item" || resp.AttachmentID <= 0 || resp.Amount <= 0 || resp.Held < resp.Amount {
				return fmt.Errorf("claim granted nothing: type=%q id=%d amount=%d held=%d", resp.AttachmentType, resp.AttachmentID, resp.Amount, resp.Held)
			}
			// Remember what the bag holds so a replay can be judged.
			rb.Blackboard.Set("claimed_held", resp.Held)
			return nil
		}))
	// The same claim again. The mail service refuses a mail it has already
	// committed (a coded answer), and if it ever lets one through, the
	// Player's ledger (PlayerDao.MailboxLedger) makes the grant a no-op —
	// either way the bag must not grow. Without the ledger the second grant
	// is a second stack, which is the window a lost CommitClaim opens.
	action.MustRegisterCall[pb.MailboxClaimRequest, pb.MailboxClaimResponse](actions, protocols, "mailbox_claim_replay", msgid.MsgMailboxClaim,
		action.OnResp(func(rb *robot.Context, resp *pb.MailboxClaimResponse) error {
			raw, _ := rb.Blackboard.Get("claimed_held")
			before, _ := raw.(int64)
			if resp.Code != 0 {
				// A coded refusal is the expected answer for a mail the
				// service has already committed.
				return nil
			}
			if resp.Held > before {
				return fmt.Errorf("replayed claim granted again: bag %d → %d", before, resp.Held)
			}
			return nil
		}))
	// enter_dungeon opens a run with the session service and remembers its
	// id for finish_dungeon (request field run_id).
	// send_gift starts the gift saga and remembers its id for gift_status
	// (request field saga_id). send_gift_self is the same call with the
	// recipient taken from the blackboard's player_id: a robot knows no
	// other robot's id, and a gift to oneself still crosses both domains
	// (Bag debit, then a mail to claim).
	giftStarted := action.OnResp(func(rb *robot.Context, resp *pb.SendGiftResponse) error {
		if err := coded(resp.Code, resp.Reason); err != nil {
			return err
		}
		if resp.SagaID == "" {
			return fmt.Errorf("send_gift returned no saga id")
		}
		rb.Blackboard.Set("saga_id", resp.SagaID)
		return nil
	})
	action.MustRegisterCall[pb.SendGiftRequest, pb.SendGiftResponse](actions, protocols, "send_gift", msgid.MsgSendGift, giftStarted)
	action.MustRegisterCall[pb.SendGiftRequest, pb.SendGiftResponse](actions, protocols, "send_gift_self", msgid.MsgSendGift, giftStarted,
		action.MapField[pb.SendGiftResponse]("ToPlayerID", "player_id"))
	// gift_status fails while the saga is still running, so a retry node
	// polls it; once terminal, the status goes on the blackboard for
	// expect_gift to judge (a step's own OnResp cannot see scenario params).
	action.MustRegisterCall[pb.GiftStatusRequest, pb.GiftStatusResponse](actions, protocols, "gift_status", msgid.MsgGiftStatus,
		action.OnResp(func(rb *robot.Context, resp *pb.GiftStatusResponse) error {
			if err := coded(resp.Code, resp.Reason); err != nil {
				return err
			}
			switch resp.Status {
			case "completed", "compensated", "failed", "manual_required":
				rb.Blackboard.Set("gift_status", resp.Status)
				rb.Blackboard.Set("gift_error", resp.LastError)
				return nil
			}
			return fmt.Errorf("gift saga still %s (step %d)", resp.Status, resp.Step)
		}))
	actions.MustRegister(action.Func{ActionName: "expect_gift", Handle: func(_ context.Context, rb *robot.Context, param any) error {
		want := action.ParamsOf(rb, param).String("status", "completed")
		got, _ := rb.Blackboard.Get("gift_status")
		if got != want {
			lastError, _ := rb.Blackboard.Get("gift_error")
			return fmt.Errorf("gift saga ended %v, want %s (last error: %v)", got, want, lastError)
		}
		return nil
	}})
	// move: one step on the map. The response carries the position the
	// server settled on — a refused move answers with where the player still
	// is, so a client snaps back instead of drifting.
	action.MustRegisterCall[pb.MoveRequest, pb.MoveResponse](actions, protocols, "move", msgid.MsgMove,
		action.OnResp(func(rb *robot.Context, resp *pb.MoveResponse) error {
			if err := coded(resp.Code, resp.Reason); err != nil {
				return err
			}
			rb.Blackboard.Set("pos_x", resp.X)
			rb.Blackboard.Set("pos_y", resp.Y)
			return nil
		}))
	// The same move onto a point outside the map. The server must refuse it,
	// and a demo whose map accepts anything is a demo that proves nothing
	// about terrain.
	action.MustRegisterCall[pb.MoveRequest, pb.MoveResponse](actions, protocols, "move_out_of_bounds", msgid.MsgMove,
		action.OnResp(func(rb *robot.Context, resp *pb.MoveResponse) error {
			if resp.Code == 0 {
				return fmt.Errorf("a move to a point outside the map was accepted: (%d,%d)", resp.X, resp.Y)
			}
			raw, _ := rb.Blackboard.Get("pos_x")
			if before, ok := raw.(int64); ok && resp.X != before {
				return fmt.Errorf("a refused move answered with x=%d, want the position the player still has (%d)", resp.X, before)
			}
			return nil
		}))
	// move_target: send a goal and let the server walk there (the client
	// sends intent, the player's own heartbeat moves it). The answer
	// ActionID is the opaque movement token (not an actionflow queue index);
	// the answer says the walk started and where it starts; the walk itself
	// arrives as replicated positions, which move_arrive waits for.
	action.MustRegisterCall[pb.MoveTargetRequest, pb.MoveTargetResponse](actions, protocols, "move_target", msgid.MsgMoveTarget,
		action.OnResp(func(rb *robot.Context, resp *pb.MoveTargetResponse) error {
			if err := coded(resp.Code, resp.Reason); err != nil {
				return err
			}
			if resp.ActionID == 0 {
				return fmt.Errorf("move_target started no walk (the robot already stands on the goal at %d,%d?)", resp.X, resp.Y)
			}
			return nil
		}))
	// move_arrive: the walk is the server's, so the robot judges it by what
	// it was replicated — its own subject's pos_x / pos_y reaching the goal.
	actions.MustRegister(action.Func{ActionName: "move_arrive", Handle: expectArrival})
	// equip: wear the sword the scenario granted. The response says which
	// slot it went in — the client does not choose, because a slot is a
	// property of the item.
	action.MustRegisterCall[pb.EquipmentEquipRequest, pb.EquipmentEquipResponse](actions, protocols, "equip", msgid.MsgEquipmentEquip,
		action.OnResp(func(rb *robot.Context, resp *pb.EquipmentEquipResponse) error {
			if err := coded(resp.Code, resp.Reason); err != nil {
				return err
			}
			if resp.Slot == 0 {
				return fmt.Errorf("the item was equipped into slot 0")
			}
			rb.Blackboard.Set("equipped_slot", int64(resp.Slot))
			return nil
		}))
	// activity_standing: the server-wide window this robot is contributing
	// to. The clear above counted exactly one point — and the REPLAY of that
	// clear counted none, because finish_dungeon contributes only from the
	// call that paid the reward (a replay does not contribute at all; the
	// coordinator's per-run reservation additionally covers a retried call
	// within one window) — so the assertion is an exact 1, not "at least 1".
	// An off-by-one here is a contribution being counted twice across a
	// service boundary.
	action.MustRegisterCall[pb.ActivityStandingRequest, pb.ActivityStandingResponse](actions, protocols, "activity_standing", msgid.MsgActivityStanding,
		action.OnResp(func(rb *robot.Context, resp *pb.ActivityStandingResponse) error {
			if err := coded(resp.Code, resp.Reason); err != nil {
				return err
			}
			if resp.ActivityID == "" {
				return fmt.Errorf("no activity window is open")
			}
			if resp.ClosesAtUnix <= 0 {
				return fmt.Errorf("window %s has no close deadline", resp.ActivityID)
			}
			raw, _ := rb.Blackboard.Get("contributed_activity_id")
			contributed, _ := raw.(string)
			if contributed == "" {
				return fmt.Errorf("the clear never reported which window took its point")
			}
			if resp.ActivityID == contributed {
				if resp.Score != 1 || resp.Progress != 1 {
					return fmt.Errorf("window %s counted score=%d progress=%d for one dungeon clear (and its replay), want 1/1",
						resp.ActivityID, resp.Score, resp.Progress)
				}
			} else {
				// The window rolled between the clear and this call — a
				// 5-minute boundary, not a miscount. The point stayed in the
				// window it landed in and settles with it, so what must hold
				// HERE is the opposite: a fresh window must not have inherited
				// it. Asserting an exact 1 across a boundary is what made this
				// gate fail for a reason unrelated to what it tests.
				if resp.Score != 0 || resp.Progress != 0 {
					return fmt.Errorf("window %s is not the one that took the point (%s) yet already counts score=%d progress=%d",
						resp.ActivityID, contributed, resp.Score, resp.Progress)
				}
			}
			rb.Blackboard.Set("activity_id", resp.ActivityID)
			return nil
		}))
	// The guild is the alliance service's (game/guild in the generated
	// project). found_guild, donate_guild and claim_guild_reward change the
	// robot's Bag as well, so each starts a saga and answers with its key;
	// guild_op_status polls it (in a retry node, like gift_status) and
	// expect_guild_op judges the end. join_guild / leave_guild are one alliance
	// RPC each, answered with the guild after the write and the alliance
	// instance that served it (served_by). guild_info reads the guild mirror:
	// eventually consistent, so the scenario reads it in a retry node too.
	guildStarted := func(op string) action.CallOption[pb.GuildResponse] {
		return action.OnResp(func(rb *robot.Context, resp *pb.GuildResponse) error {
			if err := coded(resp.Code, resp.Reason); err != nil {
				return err
			}
			if resp.SagaKey == "" {
				return fmt.Errorf("%s_guild was accepted without a saga key", op)
			}
			rb.Blackboard.Set("guild_op", op)
			rb.Blackboard.Set("guild_saga", resp.SagaKey)
			return nil
		})
	}
	action.MustRegisterCall[pb.FoundGuildRequest, pb.GuildResponse](actions, protocols, "found_guild", msgid.MsgFoundGuild,
		action.MapField[pb.GuildResponse]("Name", "guild_name"), guildStarted("found"))
	action.MustRegisterCall[pb.DonateGuildRequest, pb.GuildResponse](actions, protocols, "donate_guild", msgid.MsgDonateGuild, guildStarted("donate"))
	action.MustRegisterCall[pb.ClaimGuildRewardRequest, pb.GuildResponse](actions, protocols, "claim_guild_reward", msgid.MsgClaimGuildReward, guildStarted("reward"))
	action.MustRegisterCall[pb.GuildOpStatusRequest, pb.GuildOpStatusResponse](actions, protocols, "guild_op_status", msgid.MsgGuildOpStatus,
		action.MapField[pb.GuildOpStatusResponse]("Op", "guild_op"),
		action.MapField[pb.GuildOpStatusResponse]("SagaKey", "guild_saga"),
		action.OnResp(func(rb *robot.Context, resp *pb.GuildOpStatusResponse) error {
			if err := coded(resp.Code, resp.Reason); err != nil {
				return err
			}
			switch resp.Status {
			case "completed", "compensated", "failed", "manual_required":
				rb.Blackboard.Set("guild_op_status", resp.Status)
				rb.Blackboard.Set("guild_op_error", resp.LastError)
				if resp.GuildID != 0 {
					rb.Blackboard.Set("guild_id", resp.GuildID)
				}
				return nil
			}
			return fmt.Errorf("guild saga still %s (step %d)", resp.Status, resp.Step)
		}))
	actions.MustRegister(action.Func{ActionName: "expect_guild_op", Handle: func(_ context.Context, rb *robot.Context, param any) error {
		want := action.ParamsOf(rb, param).String("status", "completed")
		got, _ := rb.Blackboard.Get("guild_op_status")
		if got != want {
			op, _ := rb.Blackboard.Get("guild_op")
			lastError, _ := rb.Blackboard.Get("guild_op_error")
			return fmt.Errorf("guild %v saga ended %v, want %s (last error: %v)", op, got, want, lastError)
		}
		return nil
	}})
	guildAnswered := action.OnResp(func(rb *robot.Context, resp *pb.GuildResponse) error {
		if err := coded(resp.Code, resp.Reason); err != nil {
			return err
		}
		if resp.ServedBySID == 0 {
			return fmt.Errorf("the answer does not say which alliance instance served it")
		}
		rb.Blackboard.Set("guild_version", resp.Version)
		return nil
	})
	action.MustRegisterCall[pb.JoinGuildRequest, pb.GuildResponse](actions, protocols, "join_guild", msgid.MsgJoinGuild, guildAnswered)
	action.MustRegisterCall[pb.LeaveGuildRequest, pb.GuildResponse](actions, protocols, "leave_guild", msgid.MsgLeaveGuild, guildAnswered)
	// guild_info with no id reads "the guild I am in": the robot's own copy
	// (PlayerDao.GuildID, set when its found saga's status was read), then
	// the guild's mirror. It has to agree with what the found saga reported,
	// and a guild has at least its founder.
	action.MustRegisterCall[pb.GuildInfoRequest, pb.GuildResponse](actions, protocols, "guild_info", msgid.MsgGuildInfo,
		action.OnResp(func(rb *robot.Context, resp *pb.GuildResponse) error {
			if err := coded(resp.Code, resp.Reason); err != nil {
				return err
			}
			raw, _ := rb.Blackboard.Get("guild_id")
			founded, _ := raw.(int64)
			if founded != 0 && resp.GuildID != founded {
				return fmt.Errorf("the mirror says guild %d, the one the robot founded is %d", resp.GuildID, founded)
			}
			if resp.Members < 1 {
				return fmt.Errorf("guild %d reports %d members", resp.GuildID, resp.Members)
			}
			return nil
		}))
	// purchase: a paid order end to end, across two processes. The endpoint
	// signs a callback (the demo plays the payment provider), the platform
	// service records and delivers the order, the grant lands in Redis and
	// the game drains it into the bag under the Player's lock.
	//
	// What is asserted is the part that is easy to get wrong: the bag count
	// has to MOVE by the product's count. A purchase that answers success
	// without the goods arriving — because the drain silently failed, or
	// because the grant was deleted before the transaction committed — would
	// otherwise look exactly like a working one.
	action.MustRegisterCall[pb.PurchaseRequest, pb.PurchaseResponse](actions, protocols, "purchase", msgid.MsgPurchase,
		action.OnResp(func(rb *robot.Context, resp *pb.PurchaseResponse) error {
			if err := coded(resp.Code, resp.Reason); err != nil {
				return err
			}
			if resp.OrderID == "" {
				return fmt.Errorf("the purchase produced no order id")
			}
			if !resp.Delivered {
				return fmt.Errorf("order %s was recorded but not delivered", resp.OrderID)
			}
			if resp.BagCount < resp.Count {
				return fmt.Errorf("order %s delivered %d of item %d but the bag holds %d",
					resp.OrderID, resp.Count, resp.ItemID, resp.BagCount)
			}
			rb.Blackboard.Set("purchase_bag_count", int64(resp.BagCount))
			rb.Blackboard.Set("purchase_order_id", resp.OrderID)
			return nil
		}))
	// purchase_again: buying the same product a second time is a SECOND
	// ORDER — the order id is derived from the frame sequence, so this is not
	// a replay and it must be paid. The assertion is the one that would catch
	// a ledger keyed on something coarser than the order (a product, a
	// player): the bag has to move by the product's count again.
	//
	// The replay direction — the same order id granted twice — cannot be
	// reached from a client, because a client cannot resend a frame sequence.
	// It is asserted against the real handler in game/handler/
	// grant_purchase_test.go instead, which is where that window lives.
	action.MustRegisterCall[pb.PurchaseRequest, pb.PurchaseResponse](actions, protocols, "purchase_again", msgid.MsgPurchase,
		action.OnResp(func(rb *robot.Context, resp *pb.PurchaseResponse) error {
			if err := coded(resp.Code, resp.Reason); err != nil {
				return err
			}
			rawCount, _ := rb.Blackboard.Get("purchase_bag_count")
			first, _ := rawCount.(int64)
			rawOrder, _ := rb.Blackboard.Get("purchase_order_id")
			if previous, _ := rawOrder.(string); previous == resp.OrderID {
				return fmt.Errorf("two purchases produced the same order id %q", resp.OrderID)
			}
			if int64(resp.BagCount) != first+int64(resp.Count) {
				return fmt.Errorf("a second order for %d of item %d moved the bag from %d to %d",
					resp.Count, resp.ItemID, first, resp.BagCount)
			}
			return nil
		}))
	// leaderboard_top: the leaderboard module's read — the top page with the
	// caller's own standing in the same answer. Every robot cleared a
	// dungeon, so every robot must be ON the board — and its own value must
	// be exactly 1 no matter how many times it replayed the finish, which is
	// what submitting the clear count as a snapshot promises. The standing
	// is checked rather than the page: with more robots than a page holds,
	// most of them are not on it.
	action.MustRegisterCall[pb.LeaderboardTopRequest, pb.LeaderboardTopResponse](actions, protocols, "leaderboard_top", msgid.MsgLeaderboardTop,
		action.OnResp(func(rb *robot.Context, resp *pb.LeaderboardTopResponse) error {
			if err := coded(resp.Code, resp.Reason); err != nil {
				return err
			}
			rawPlayer, _ := rb.Blackboard.Get("player_id")
			playerID, _ := rawPlayer.(int64)
			if !resp.MyOnBoard || resp.MyRank <= 0 {
				return fmt.Errorf("player %d cleared a dungeon but is not on the board (total %d)", playerID, resp.Total)
			}
			if resp.MyScore != 1 {
				return fmt.Errorf("player %d counted %d clears for one run", playerID, resp.MyScore)
			}
			for _, row := range resp.Rows {
				if row.PlayerID == playerID && (row.Score != resp.MyScore || row.Rank != resp.MyRank) {
					return fmt.Errorf("player %d is rank %d with %d on the page but rank %d with %d in its own standing",
						playerID, row.Rank, row.Score, resp.MyRank, resp.MyScore)
				}
			}
			return nil
		}))
	// battle: the lockstep half. The scenario reaches it with match_id on
	// the blackboard (join_queue → the matchmaker's MatchFound push), and
	// this action runs a real client of roost-core/sync/lockstep for the length
	// of one battle: it feeds every BattleFrame push into a LockstepBot,
	// the bot applies the frames to the demo simulation in order, and the
	// bot's sink sends this client's input (and its keyframe hashes) back
	// through the BattleInput request. The run fails if the bot turns
	// terminal (a gap it could not heal, a simulation that diverged) or if
	// the battle does not reach its frame budget in time.
	actions.MustRegister(action.Func{ActionName: "battle", Handle: runBattle})
	// scene_watch / scene_expect are the client half of sync=true. The watch
	// installs a push capture and decodes every state frame the server sends
	// this client — reliable snapshots whole, deltas reassembled from their
	// fragments — exactly as a real client would. The expect judges what
	// arrived at the end of the run, so the two are separate actions: a
	// capture installed after the change has already been pushed sees
	// nothing.
	actions.MustRegister(action.Func{ActionName: "scene_watch", Handle: watchScene})
	// scene_ready: the decoder is installed (scene_watch above), so the
	// server may start sending. Until this call the session is held and no
	// frame is produced for it — which is what makes the first snapshot
	// impossible to miss.
	action.MustRegisterCall[pb.SceneReadyRequest, pb.SceneReadyResponse](actions, protocols, "scene_ready", msgid.MsgSceneReady,
		action.OnResp(func(_ *robot.Context, resp *pb.SceneReadyResponse) error {
			return coded(resp.Code, resp.Reason)
		}))
	actions.MustRegister(action.Func{ActionName: "scene_expect", Handle: expectScene})
	// scene_alive: this client's replication session is still open at the
	// end of the run (see expectSceneAlive).
	actions.MustRegister(action.Func{ActionName: "scene_alive", Handle: expectSceneAlive})
	action.MustRegisterCall[pb.EnterDungeonRequest, pb.EnterDungeonResponse](actions, protocols, "enter_dungeon", msgid.MsgEnterDungeon,
		action.OnResp(func(rb *robot.Context, resp *pb.EnterDungeonResponse) error {
			if err := coded(resp.Code, resp.Reason); err != nil {
				return err
			}
			if resp.RunID == "" || resp.State != "open" {
				return fmt.Errorf("dungeon run not opened: id=%q state=%q", resp.RunID, resp.State)
			}
			rb.Blackboard.Set("run_id", resp.RunID)
			return nil
		}))
	action.MustRegisterCall[pb.FinishDungeonRequest, pb.FinishDungeonResponse](actions, protocols, "finish_dungeon", msgid.MsgFinishDungeon,
		action.OnResp(func(rb *robot.Context, resp *pb.FinishDungeonResponse) error {
			if err := coded(resp.Code, resp.Reason); err != nil {
				return err
			}
			if resp.State != "succeeded" || resp.ExpGranted <= 0 {
				return fmt.Errorf("dungeon not resolved as a clear: state=%q exp=%d", resp.State, resp.ExpGranted)
			}
			// Which window took this clear's point. activity_standing below
			// needs it: a window lasts 5 minutes and the standing endpoint
			// answers about whichever one is current when it is asked, so
			// without this the robot would be asserting a count in a window
			// it never contributed to.
			if resp.ActivityID == "" {
				return fmt.Errorf("the clear did not say which activity window took its point")
			}
			rb.Blackboard.Set("contributed_activity_id", resp.ActivityID)
			return nil
		}))
	// The same call again, on the same run id. Finish is idempotent, so the
	// service answers with the run as it stands — and the reward must not be
	// paid a second time. A demo that pays here lets a client replay one
	// frame for unlimited experience.
	action.MustRegisterCall[pb.FinishDungeonRequest, pb.FinishDungeonResponse](actions, protocols, "finish_dungeon_replay", msgid.MsgFinishDungeon,
		action.OnResp(func(_ *robot.Context, resp *pb.FinishDungeonResponse) error {
			if err := coded(resp.Code, resp.Reason); err != nil {
				return err
			}
			if resp.State != "succeeded" {
				return fmt.Errorf("replayed finish did not answer with the run as it stands: state=%q", resp.State)
			}
			if resp.ExpGranted != 0 || resp.LevelsGained != 0 {
				return fmt.Errorf("replayed finish was paid again: exp=%d levels=%d", resp.ExpGranted, resp.LevelsGained)
			}
			return nil
		}))
	// skill_catalog: the server compiled game/skills/*.json at startup and
	// lists the ids; the demo ships one, and a warning-free compile is part
	// of the regression.
	action.MustRegisterCall[pb.SkillCatalogRequest, pb.SkillCatalogResponse](actions, protocols, "skill_catalog", msgid.MsgSkillCatalog,
		action.OnResp(func(_ *robot.Context, resp *pb.SkillCatalogResponse) error {
			if err := coded(resp.Code, resp.Reason); err != nil {
				return err
			}
			if len(resp.Skills) == 0 || !strings.HasPrefix(resp.Skills[0], "skill.") {
				return fmt.Errorf("skill catalog is empty or malformed: %v", resp.Skills)
			}
			if resp.Warnings != 0 {
				return fmt.Errorf("skill catalog compiled with %d warnings", resp.Warnings)
			}
			return nil
		}))
	action.MustRegisterCall[pb.WorldStatsRequest, pb.WorldStatsResponse](actions, protocols, "world_stats", msgid.MsgWorldStats,
		action.OnResp(func(_ *robot.Context, resp *pb.WorldStatsResponse) error {
			if err := coded(resp.Code, resp.Reason); err != nil {
				return err
			}
			if resp.PlayersEntered <= 0 || resp.MatchesFormed <= 0 {
				return fmt.Errorf("world counters not moving: entered=%d matches=%d", resp.PlayersEntered, resp.MatchesFormed)
			}
			return nil
		}))
}

// registerPushes lets the session decode server pushes the scenario waits on.
func registerPushes(protocols *protocol.Registry) {
	protocols.MustRegisterDecoder(msgid.MsgMatchFound, protocol.DecodeTyped(msgid.MsgMatchFound, pb.UnmarshalMatchFoundPush))
	protocols.MustRegisterDecoder(msgid.MsgChatMessage, protocol.DecodeTyped(msgid.MsgChatMessage, pb.UnmarshalChatMessagePush))
	// No decoder for BattleFrame (10102): the room sends the lockstep packet
	// itself with the Lockstep flag, and the battle action's capture reads it
	// raw — a PB decoder would try to parse those bytes as a message.
	// The scene's state frames. A push whose id has no decoder is dropped
	// before any capture sees it, so registering it is not optional bookkeeping.
	protocols.MustRegisterDecoder(msgid.MsgEntitySync, protocol.DecodeTyped(msgid.MsgEntitySync, pb.UnmarshalEntitySyncPush))
	// BattleInput is sent by the battle action, not by a registered call, so
	// its codec entries are installed here: the request encoder and the
	// response decoder both route through pbCodec like every other message.
	protocols.MustRegisterEncoder(msgid.MsgBattleInput, func(value any) ([]byte, error) { return pbCodec{}.Marshal(value) })
	protocols.MustRegisterDecoder(msgid.MsgBattleInput, protocol.DecodeTyped(msgid.MsgBattleInput, pb.UnmarshalBattleInputResponse))
}

func coded(code int32, reason string) error {
	if code == 0 {
		return nil
	}
	return fmt.Errorf("response code %d: %s", code, reason)
}

// loadScenarios registers every YAML file in dir.
func loadScenarios(registry *scenario.Registry, dir string) error {
	files, err := filepath.Glob(filepath.Join(dir, "*.yaml"))
	if err != nil {
		return err
	}
	if len(files) == 0 {
		return fmt.Errorf("no scenario files in %s", dir)
	}
	sort.Strings(files)
	for _, file := range files {
		raw, err := os.ReadFile(file)
		if err != nil {
			return err
		}
		if err := scenario.RegisterSpec(registry, raw); err != nil {
			return fmt.Errorf("%s: %w", file, err)
		}
	}
	return nil
}

func waitForRun(ctx context.Context, manager *loadtest.Manager, runID string) (loadtest.RunSnapshot, error) {
	ticker := time.NewTicker(200 * time.Millisecond)
	defer ticker.Stop()
	for {
		for _, run := range manager.History(loadtest.HistoryRequest{Limit: 10}).Runs {
			if run.RunID == runID {
				return run, nil
			}
		}
		select {
		case <-ctx.Done():
			_, _ = manager.Stop(context.Background(), loadtest.StopRequest{RunID: runID, Reason: "interrupted"})
			return loadtest.RunSnapshot{}, errors.New("interrupted")
		case <-ticker.C:
		}
	}
}

