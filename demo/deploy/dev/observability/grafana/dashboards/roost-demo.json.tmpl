      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(player_tcp_dispatch_duration_sum_nanos{job=\"{{GAME_SERVICE}}\"}[1m])) / sum(rate(player_tcp_dispatch_duration_count{job=\"{{GAME_SERVICE}}\"}[1m])) / 1e6",
          "legendFormat": "avg",
          "refId": "A"
        }
      ]
