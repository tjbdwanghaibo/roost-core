        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "在线连接",
      "id": 2,
      "description": "当前已完成握手的连接数。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(player_tcp_connections{job=\"{{GAME_SERVICE}}\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "请求速率 / 错误",
      "id": 3,
      "description": "dispatch error 非零说明有端点把业务错误当 error 返回了——它应当换成响应里的 Code。rejected 是连接被上限拒绝：同一 IP 超过 player_access.tcp.max_connections_per_ip（默认 128）时握手前就被关掉，压测机器人全从一个 IP 来，-count 超过它就会大面积 'auth send: robot session: closed'。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(player_tcp_dispatch_duration_count{job=\"{{GAME_SERVICE}}\"}[1m]))",
          "legendFormat": "dispatch/s",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(player_tcp_dispatch_error_total{job=\"{{GAME_SERVICE}}\"}[1m]))",
          "legendFormat": "dispatch errors/s（端点返回 error → 断连）",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(player_tcp_auth_failure_total{job=\"{{GAME_SERVICE}}\"}[1m]))",
          "legendFormat": "auth failures/s",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(player_tcp_frame_error_total{job=\"{{GAME_SERVICE}}\"}[1m]))",
          "legendFormat": "frame errors/s",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (reason)(rate(player_tcp_connection_rejected_total{job=\"{{GAME_SERVICE}}\"}[1m]))",
          "legendFormat": "rejected/s {{reason}}",
          "refId": "E"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "端到端分发时延（平均，ms）",
      "id": 4,
      "description": "从收到帧到写出响应，含 Nest 排队、锁、落库屏障。Duration 类指标只有 count/sum/max，分位数看下面的机器人面板。",
