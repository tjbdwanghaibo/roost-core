package dbdef

// MonsterDao is a monster's state, and every field is `nopersist,sync`.
//
// A monster is rebuilt by the spawner on every start, so nothing here is
// worth storing — but it IS worth replicating, and giving it a DAO keeps one
// rule true everywhere: **a position lives in a DAO and is read and written
// through a component**. A monster that kept its position in a plain struct
// field would be the one object in the demo whose position has a different
// authority from everyone else's, and the first piece of code that had to
// handle both would get it wrong.
//
// The generated marshaller is the same one the Player uses, so the packer is
// the same shape too: `MarshalSync(mask)` in, bytes out.
//
// `nocoll` says there is no collection: no Mongo collection name is invented
// for it, and the generator emits no storage path (no collection constant,
// no PrepareMutation, no RestorePersisted) — only the accessors, the rollback
// snapshot and the sync marshaller. Every field must stay `nopersist`, and only
// a `noPersist=true` entity may use it; both are checked at generation time.
//
//roost:dao nocoll
type MonsterDao struct {
	// Buff / 冷却的恢复快照：玩家持久，空间代理临时；不传内部账本给客户端。
	CellSpawnGeneration uint64        `dao:"nopersist,nosync" store:"cell_spawn_generation"`
	CellLife            uint64        `dao:"nopersist,nosync" store:"cell_life"`
	CellDeath           *CellDeath    `dao:"nopersist,nosync" store:"cell_death"`
	CellDeathAcked      bool          `dao:"nopersist,nosync" store:"cell_death_acked"`
	CellDeathNextAt     int64         `dao:"nopersist,nosync" store:"cell_death_next"`
	CellRecovery        *CellRecovery `dao:"nopersist,nosync" store:"cell_recovery"`
	// 共享授权及锁外 I/O 的本地续行身份；经 DAO setter 回滚。
	CellOwnership *CellOwnership `dao:"nopersist,nosync" store:"cell_ownership"`
	// Template is which row of the spawn table this monster came from; a
	// client needs it to know what to draw.
	Template int32 `dao:"nopersist,sync" store:"template"`
	PosX     int64 `dao:"nopersist,sync" store:"pos_x"`
	PosY     int64 `dao:"nopersist,sync" store:"pos_y"`
	HP       int64 `dao:"nopersist,sync" store:"hp"`
	// Facing is the direction of the last step (movement.Facing), drawn by
	// the client like the player's.
	Facing int32 `dao:"nopersist,sync" store:"facing"`
	// SceneID is which scene the monster is in (movement.Fields).
	SceneID int64 `dao:"nopersist,sync" store:"scene_id"`
	// Rooted mirrors the actor.Rooted state bit (a root buff is on), so a
	// client can draw it: the state set itself is not packed, the DAO is.
	// Written by the state watcher in the same transaction as the buff, so
	// it rolls back with it.
	Rooted bool `dao:"nopersist,sync" store:"rooted"`

	// The Cell* fields are the monster's state as a walker of a partitioned
	// scene (scene.partition, gameplay/cellworld; maintainer decision D5 = A):
	// velocity, version, role, handoff and the damage dedup list. Position and
	// HP are PosX / PosY / HP above. They carry the same names and keys as
	// SceneActorDao's, so game/partition maps both with one function, and a
	// monster of an ordinary scene never writes them. `nopersist,nosync`: a
	// partitioned monster is seen by clients through the Base process's Sync
	// mirror, not through this entity's own subject.
	CellVX          int64        `dao:"nopersist,nosync" store:"cell_vx"`
	CellVY          int64        `dao:"nopersist,nosync" store:"cell_vy"`
	CellEpoch       uint64       `dao:"nopersist,nosync" store:"cell_epoch"`
	CellSeq         uint64       `dao:"nopersist,nosync" store:"cell_seq"`
	CellIdle        bool         `dao:"nopersist,nosync" store:"cell_idle"`
	CellBase        int32        `dao:"nopersist,nosync" store:"cell_base"`
	CellRole        int32        `dao:"nopersist,nosync" store:"cell_role"`
	CellLastInput   uint64       `dao:"nopersist,nosync" store:"cell_last_input"`
	CellRetryAfter  int64        `dao:"nopersist,nosync" store:"cell_retry_after"`
	CellLeaseUntil  int64        `dao:"nopersist,nosync" store:"cell_lease_until"`
	CellWritebackAt int64        `dao:"nopersist,nosync" store:"cell_writeback_at"`
	CellApplied     []CellHit    `dao:"nopersist,nosync" store:"cell_applied"`
	CellHandoff     *CellHandoff `dao:"nopersist,nosync" store:"cell_handoff"`
	// The battle panel (cellworld.Panel, item 3 = A), same names as
	// SceneActorDao's; a monster has none today (zero = no panel).
	CellMaxHP    int64  `dao:"nopersist,nosync" store:"cell_max_hp"`
	CellAttack   int64  `dao:"nopersist,nosync" store:"cell_attack"`
	CellPower    int64  `dao:"nopersist,nosync" store:"cell_power"`
	CellPanelVer uint64 `dao:"nopersist,nosync" store:"cell_panel_ver"`
	// The entry sequence (cellworld.ActorState.Entry), same name as
	// SceneActorDao's; a monster never enters, so it stays 0.
	CellEntry uint64 `dao:"nopersist,nosync" store:"cell_entry"`
	// The sub-unit position remainder (cellworld.ActorState.FracX / FracY,
	// thousandths of a unit), same names as SceneActorDao's.
	CellFracX int32 `dao:"nopersist,nosync" store:"cell_frac_x"`
	CellFracY int32 `dao:"nopersist,nosync" store:"cell_frac_y"`
}

// CellHit 是一条已结算伤害的去重记录（cellworld.AppliedHit）。
type CellHit struct {
	Attacker int64  `store:"attacker"`
	Seq      uint64 `store:"seq"`
	ID       string `store:"id"`
	At       int64  `store:"at"`
}

// CellHandoff 是冻结中的交接（cellworld.HandoffState）。时间是系统时间 UnixNano。
type CellHandoff struct {
	ID        string `store:"id"`
	Col       int32  `store:"col"`
	Row       int32  `store:"row"`
	Epoch     uint64 `store:"epoch"`
	StartedAt int64  `store:"started_at"`
	LastSent  int64  `store:"last_sent"`
}

// CellOwnership 对应 cellworld 的授权与待确认操作，不传给客户端。
type CellOwnership struct {
	ID             string `store:"id"`
	Epoch          uint64 `store:"epoch"`
	SID            int32  `store:"sid"`
	Incarnation    string `store:"incarnation"`
	CloseEntry     bool   `store:"closed"`
	PendingToken   string `store:"pending"`
	TransferID     string `store:"transfer"`
	TransferTarget int32  `store:"target"`
	TransferEpoch  uint64 `store:"transfer_epoch"`
}

// CellRecovery 是限时状态的可恢复表示；绝对 UTC 毫秒截止在停机期间照常流逝。
type CellRecovery struct {
	Revision  uint64         `store:"v"`
	Effects   []CellEffect   `store:"e"`
	Cooldowns []CellCooldown `store:"c"`
}
type CellEffect struct {
	Key       string `store:"k"`
	Stacks    int32  `store:"s"`
	Value     int64  `store:"v"`
	ExpiresAt int64  `store:"e"`
}
type CellCooldown struct {
	Key     string `store:"k"`
	ReadyAt int64  `store:"r"`
}

// CellDeath 是尚在完成持久死亡 / 奖励确认的临时代理状态。权威事实在共享 OwnerRegistry。
type CellDeath struct {
	ID         string `store:"1"`
	Target     int64  `store:"2"`
	Life       uint64 `store:"3"`
	Attacker   int64  `store:"4"`
	Sequence   uint64 `store:"5"`
	HitID      string `store:"6"`
	RewardBase int32  `store:"7"`
	ReplySID   int32  `store:"8"`
	Damage     int32  `store:"9"`
	At         int64  `store:"10"`
	Kind       int32  `store:"11"`
	Base       int32  `store:"12"`
	X          int64  `store:"13"`
	Y          int64  `store:"14"`
	VX         int64  `store:"15"`
	VY         int64  `store:"16"`
	Epoch      uint64 `store:"17"`
	StateSeq   uint64 `store:"18"`
	Idle       bool   `store:"19"`
	MaxHP      int32  `store:"20"`
	Attack     int32  `store:"21"`
	Power      int32  `store:"22"`
	PanelVer   uint64 `store:"23"`
}
