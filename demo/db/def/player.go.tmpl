package dbdef

//roost:dao coll=player db=main dbscope=sid schema=4
type PlayerDao struct {
	// 名字、等级、经验不在这里：它们是 profile 模块的状态，安装时追加在这个结构体末尾
	// （Profile：名字与等级，别的玩家也可以看；ProfilePrivate：等级内经验，只给本人；定义在 db/def/profile.go）。
	//
	// The bag is not declared here either: it is the bag module's state, the nested
	// struct PlayerDao.Bag (db/def/bag.go, store key "bag") that
	// `roost module add bag` appends to the end of this DAO.

	// DungeonClaims is the exactly-once ledger for dungeon clear rewards:
	// run id -> the run's resolution time. The claim transaction records the
	// run here and pays only when it is the one that recorded it. Entries
	// are pruned by the same window that decides whether a claim is still
	// admissible; see game/dungeon for why those have to be one number.
	// PosX / PosY / SceneID / Facing are where the player is right now, and
	// this is the ONLY place that answers that. The scene's AOI keeps an
	// index of positions so it can answer "who is near whom" without walking
	// every player, but an index is not a second authority: it is written
	// from the one path that writes these fields (movement.MapBasic, reached
	// through MapComponent) and never read as the answer to "where is X".
	//
	// They are `nopersist,sync`: a moving player changes them on every
	// movement beat (5 a second at the default move period), and writing that
	// to the WAL and Mongo buys nothing — what a restart needs is where the
	// player was, give or take a few steps. Synced, so moving is replicated
	// by the same pipeline as everything else, no separate movement
	// broadcast. Being DAO fields is also what rolls them back: a step whose
	// transaction failed puts the player back where it was.
	PosX int64 `dao:"nopersist,sync" store:"pos_x"`
	PosY int64 `dao:"nopersist,sync" store:"pos_y"`
	// SceneID is which scene the player is in, 0 for nowhere.
	SceneID int64 `dao:"nopersist,sync" store:"scene_id"`
	// Facing is the direction of the last step, 1/100 degree (movement.Facing).
	Facing int32 `dao:"nopersist,sync" store:"facing"`
	// SavedSceneID / SavedPosX / SavedPosY / SavedFacing are the stored copy
	// of the above: written when the player leaves the scene and every
	// actor.SavePeriod while it is on it (movement.MapConfig Save /
	// SaveOnLeave / SaveEvery), only when the scene, position or facing
	// changed since the last write, and read back when the player is placed
	// on the map again (the position as the preferred point, the facing as
	// is). Facing follows the position's rule: it is MapBasic data like the
	// position. Persisted and not synced: nobody draws them.
	SavedSceneID int64 `dao:"persist" store:"saved_scene_id"`
	SavedPosX    int64 `dao:"persist" store:"saved_pos_x"`
	SavedPosY    int64 `dao:"persist" store:"saved_pos_y"`
	SavedFacing  int32 `dao:"persist" store:"saved_facing"`
	// 装备与属性层由 equipment / attribute 模块追加；demo 不另建一份状态。
	DungeonClaims map[string]int64 `dao:"persist,map=fast" store:"dungeon_claims"`
	// DungeonClears counts paid dungeon clears per leaderboard season:
	// season -> clears. It moves in the same claim transaction that records
	// the run in DungeonClaims, only when that transaction pays, so "paid"
	// and "counted" are one durable fact; unlike that ledger it is never
	// pruned. The clears board takes it as a snapshot (rank UpdateMax), so a
	// replay of any run resubmits the current count instead of adding one —
	// see game/leaderboard for why the rank service's request ring cannot be the
	// ledger for this.
	DungeonClears map[int64]int64 `dao:"persist,map=fast" store:"dungeon_clears"`
	// SagaReceipts is where the gift saga's native steps (debit and its
	// refund) keep their receipts: operation (saga.Command.IdempotencyKey) ->
	// the framework's encoding of saga.StepReceipt. The step writes it in the
	// same transaction as the Bag change, so the change and "this operation is
	// done" are one WAL record; a redelivered command finds the receipt and
	// replays it instead of debiting twice (game/entities/player/saga_receipts.go,
	// roost-core SAGA.md 原生步骤执行契约). Persisted, never synced: the client
	// has no use for it. Old receipts are pruned by the step itself after
	// saga.receipt_retention.
	SagaReceipts map[string][]byte `dao:"persist" store:"saga_receipts"`

	// The Cell* fields are the player's routing state for a partitioned scene
	// (scene.partition, gameplay/cellworld.BaseState): this process is the
	// player's Base, the scene's authority is the Cell process of the cell
	// the player stands in, and these say which one that is, which epoch,
	// the move intent and its sequence, the attack sequence and the watchdog
	// times. The Player's own heartbeat ("cell.base") reads and writes them.
	// `nopersist,nosync`: they describe one login on one process; a restarted
	// Base enters again.
	CellActor     int64  `dao:"nopersist,nosync" store:"cell_actor"`
	CellInWorld   bool   `dao:"nopersist,nosync" store:"cell_in_world"`
	CellOwner     int32  `dao:"nopersist,nosync" store:"cell_owner"`
	CellEpoch     uint64 `dao:"nopersist,nosync" store:"cell_epoch"`
	CellIntentSeq uint64 `dao:"nopersist,nosync" store:"cell_intent_seq"`
	CellVX        int64  `dao:"nopersist,nosync" store:"cell_vx"`
	CellVY        int64  `dao:"nopersist,nosync" store:"cell_vy"`
	CellAttackSeq uint64 `dao:"nopersist,nosync" store:"cell_attack_seq"`
	CellViewAt    int64  `dao:"nopersist,nosync" store:"cell_view_at"`
	CellEnterAt   int64  `dao:"nopersist,nosync" store:"cell_enter_at"`
	CellLeaseAt   int64  `dao:"nopersist,nosync" store:"cell_lease_at"`
	CellHint      int32  `dao:"nopersist,nosync" store:"cell_hint"`
	CellLostEpoch uint64 `dao:"nopersist,nosync" store:"cell_lost_epoch"`
	CellLostAt    int64  `dao:"nopersist,nosync" store:"cell_lost_at"`
	CellShown     bool   `dao:"nopersist,nosync" store:"cell_shown"`
	// CellEntry is this entry's sequence (cellworld.BaseState.Entry): Enter
	// and Leave carry it and the Real only takes a Leave of the same entry
	// (RV-20261106-03). Not persisted: it is taken from the clock at Enter.
	CellEntry uint64 `dao:"nopersist,nosync" store:"cell_entry"`
	// CellHP / CellSnapEpoch / CellSnapSeq are the player's snapshot from the
	// partitioned scene: the HP its SceneActor last wrote back and that
	// write-back's version. Persisted — they are what a crashed Cell rebuilds
	// the SceneActor from, and a restarted Base must still refuse an older
	// write-back. CellHP is also synced: the Base's mirror of the player's
	// SceneActor is packed with this DAO's encoding (the client's `player`
	// namespace, D2 = A), and HP is one of the fields it carries. The live
	// position is PosX / PosY; the snapshot position is SavedPosX / SavedPosY
	// with SavedSceneID = the partitioned scene, written with each accepted
	// write-back (the fixed moment, not every witness).
	CellHP        int64  `dao:"persist,sync" store:"cell_hp"`
	CellSnapEpoch uint64 `dao:"persist" store:"cell_snap_epoch"`
	CellSnapSeq   uint64 `dao:"persist" store:"cell_snap_seq"`
	// CellMaxHP / CellAttack / CellPower / CellPanelVer are the battle panel
	// this Base derived from the player's growth (level, equipment: the Final
	// attribute layer) for the partitioned scene, and its sequence
	// (cellworld.Panel, maintainer decision 2026-11-04 item 3 = A). The
	// panel's authority is the cell's Real; this is what the Base last sent
	// it. Written in the same transaction as the level-up or the equipment
	// change, so the sequence stays monotonic across a Base restart.
	// CellPanelAcked is the highest sequence the Real has confirmed — it comes
	// back with the write-back snapshot. Persisted. The three numbers are
	// also synced for the same reason as CellHP: the SceneActor's mirror is
	// packed with this DAO's encoding and carries the Real's panel; the
	// player's own `self` view leaves them out (the panel and the HP of a
	// partitioned scene are the scene actor's). CellPanelSentAt /
	// CellPanelSince / CellPanelUnknown are the resend and "unknown" timers.
	CellMaxHP        int64  `dao:"persist,sync" store:"cell_max_hp"`
	CellAttack       int64  `dao:"persist,sync" store:"cell_attack"`
	CellPower        int64  `dao:"persist,sync" store:"cell_power"`
	CellPanelVer     uint64 `dao:"persist" store:"cell_panel_ver"`
	CellPanelAcked   uint64 `dao:"persist" store:"cell_panel_acked"`
	CellPanelSentAt  int64  `dao:"nopersist,nosync" store:"cell_panel_sent_at"`
	CellPanelSince   int64  `dao:"nopersist,nosync" store:"cell_panel_since"`
	CellPanelUnknown bool   `dao:"nopersist,nosync" store:"cell_panel_unknown"`
	// TeamVer / TeamMembers 是 Base 缓存的成员表（cellworld.Group）：版本与每名成员的 Player、SceneActor、Base sid。不持久：
	// 重启后版本为 0，Node 从 Team 实体重读（GroupResync）。CellGroupSentAt / CellGroupSyncAt / CellGroupViewID /
	// CellGroupViewVer 是队伍面板的计时与组关系视野的版本（cellworld.BaseState）。
	TeamVer          uint64     `dao:"nopersist,nosync" store:"team_ver"`
	TeamMembers      []TeamSeat `dao:"nopersist,nosync" store:"team_members"`
	CellGroupSentAt  int64      `dao:"nopersist,nosync" store:"cell_group_sent_at"`
	CellGroupSyncAt  int64      `dao:"nopersist,nosync" store:"cell_group_sync_at"`
	CellGroupViewID  int64      `dao:"nopersist,nosync" store:"cell_group_view_id"`
	CellGroupViewVer uint64     `dao:"nopersist,nosync" store:"cell_group_view_ver"`
}

// TeamSeat 是缓存的成员表里的一名成员（cellworld.GroupMember）。
type TeamSeat struct {
	Player int64 `store:"player"`
	Actor  int64 `store:"actor"`
	SID    int32 `store:"sid"`
}
