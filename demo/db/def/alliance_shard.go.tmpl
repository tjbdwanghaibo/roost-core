package dbdef

// AllianceShardDao is the per-instance timer host of the alliance service:
// one AllianceShard per service sid (its id is the sid), a plain local entity
// persisted through the Data Engine. Remote-managed entities cannot carry
// persistent timers (roost add timer refuses them), so the deadlines that
// belong to alliances and guards on this instance — today, a guard
// reservation that was not confirmed in time — are nodes here. A node fires
// inside the shard's Nest lock and only records an effect; the I/O it leads
// to happens in the effect's consumer.
//
//roost:dao coll=alliance_shard db=main
type AllianceShardDao struct {
	Timers    map[int64]*AllianceShardTimerNode `store:"timers" dao:"persist,map=fast"`
	TimerSeed int64                             `store:"timer_seed" dao:"persist"`
}
