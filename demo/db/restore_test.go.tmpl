package db

import (
 "errors"
 "testing"
 "github.com/tjbdwanghaibo/roost-core/dataengine"
 "go.mongodb.org/mongo-driver/v2/bson"
)

// 正式生成 DAO：拒绝任何不匹配的 schema，拒绝前不改变数据、版本与脏状态。
func TestRestorePersistedRequiresCurrentSchema(t *testing.T) {
 raw, err := bson.Marshal(bson.M{"_id": int64(42), "name": "stored"})
 if err != nil { t.Fatal(err) }
 for _, schema := range []uint32{0, PlayerDaoSchemaVersion-1, PlayerDaoSchemaVersion+1} {
  dao := NewPlayerDao()
  dao.SetId(42)
  initial, err := bson.Marshal(bson.M{"_id": int64(42), "name": "unchanged"})
  if err != nil { t.Fatal(err) }
  if err := dao.RestorePersisted(initial, PlayerDaoSchemaVersion, 7); err != nil { t.Fatal(err) }
  dao.DirtyTracker().SetVersion(7)
  if err := dao.RestorePersisted(raw,schema,9); !errors.Is(err,dataengine.ErrSchemaMismatch) { t.Fatalf("schema=%d err=%v",schema,err) }
  if dao.GetName()!="unchanged" || dao.DirtyTracker().Version()!=7 { t.Fatal("refusal modified DAO") }
 }
 dao := NewPlayerDao()
 dao.SetId(42)
 if err := dao.RestorePersisted(raw,PlayerDaoSchemaVersion,9); err != nil { t.Fatal(err) }
 if dao.GetName()!="stored" || dao.DirtyTracker().Version()!=9 {t.Fatal("current schema did not restore")}
}
