{
  "schema": "roost.skill/v2",
  "id": "skill.test.simple_damage",
  "name": "Simple Damage",
  "description": "Deals physical damage to the input target.",
  "activation": {
    "type": "active",
    "policy": {"mode": "tap"}
  },
  "input_schema": {
    "type": "entity"
  },
  "cooldown_ticks": 0,
  "costs": [],
  "memory": {},
  "initial_phase": "cast",
  "phases": [
    {
      "id": "cast",
      "timeout_ticks": 0,
      "on": {
        "enter": {
          "flow": "sequence",
          "steps": [
            {
              "flow": "effect",
              "effect": {
                "type": "damage",
                "target": "$input.target",
                "amount": 10,
                "damage_type": "physical"
              }
            },
            {
              "flow": "finish",
              "reason": "done"
            }
          ]
        }
      }
    }
  ]
}
