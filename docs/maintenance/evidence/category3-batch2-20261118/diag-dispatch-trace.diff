+package nest
+
+// 临时诊断（第三类批次 2，不提交）：ROOST_DIAG_DISPATCH_DIR 非空时，每个外部作业结束时记一行 CSV 到
+// <dir>/dispatch-<pid>.csv：队列名、handler、各目标的 kind:id、准入 / 就绪 / 开始 / 结束（相对队列原点的 µs）、
+// 是否等过前驱、最后一个放行它的前驱共享的目标 ID 与该前驱的 handler。
+
+import (
+	"bufio"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/tjbdwanghaibo/roost-core/framework/entity"
+)
+
+var diagDispatch = struct {
+	once sync.Once
+	ch   chan string
+}{}
+
+func diagDispatchChan() chan string {
+	diagDispatch.once.Do(func() {
+		dir := os.Getenv("ROOST_DIAG_DISPATCH_DIR")
+		if dir == "" {
+			return
+		}
+		f, err := os.Create(filepath.Join(dir, fmt.Sprintf("dispatch-%d.csv", os.Getpid())))
+		if err != nil {
+			return
+		}
+		ch := make(chan string, 1<<17)
+		diagDispatch.ch = ch
+		go func() {
+			w := bufio.NewWriterSize(f, 1<<16)
+			fmt.Fprintln(w, "queue,handler,targets,admitted_us,ready_us,started_us,ended_us,waited_pred,blocker_id,blocker_handler")
+			tick := time.NewTicker(200 * time.Millisecond)
+			for {
+				select {
+				case line := <-ch:
+					w.WriteString(line)
+				case <-tick.C:
+					w.Flush()
+				}
+			}
+		}()
+	})
+	return diagDispatch.ch
+}
+
+func diagTargets(ids []int64) string {
+	parts := make([]string, len(ids))
+	for i, id := range ids {
+		parts[i] = fmt.Sprintf("%d:%d", entity.GetEntityKindFromID(id), id)
+	}
+	return strings.Join(parts, " ")
+}
+
+// diagRecordJob 在 q.mu 内调用；只做非阻塞投递。
+func (q *dispatchQueue) diagRecordJob(j *dispatchJob, ended time.Duration) {
+	ch := diagDispatchChan()
+	if ch == nil || j.continuation || j.tryBatch != nil {
+		return
+	}
+	line := fmt.Sprintf("%s,%s,%s,%d,%d,%d,%d,%t,%d,%s\n", q.name, j.diagName, diagTargets(j.ids),
+		j.admittedAt.Microseconds(), j.readyAt.Microseconds(), j.diagStarted.Microseconds(), ended.Microseconds(),
+		j.waitedForPredecessor, j.diagBlockerID, j.diagBlockerName)
+	select {
+	case ch <- line:
+	default:
+	}
+}
