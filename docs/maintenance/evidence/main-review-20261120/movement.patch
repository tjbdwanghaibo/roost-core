+// Use the same Save transaction as the periodic heartbeat between the drill's
+// before sample and shutdown. Count committed position fields by player ID.
+func TestReviewDrainSaveAttribution(t *testing.T) {
+	for _, early := range []bool{false, true} {
+		t.Run(fmt.Sprintf("save_before_drain_%v", early), func(t *testing.T) {
+			w := newMoveWorld(t)
+			spawn, last := spatial.Point{X: 500, Y: 500}, spatial.Point{X: 620, Y: 540}
+			p := w.join(9934, spawn)
+			save := p.MapComp().Body().Map.Save
+			if err := sharedBodyRequest(w, p, save); err != nil {
+				t.Fatal(err)
+			}
+			if err := syncsender.NewMovePlayerSender(w.engine).MultiSync_MovePlayer(w.ctx, p.ID(), w.area.ID(), last.X, last.Y); err != nil {
+				t.Fatal(err)
+			}
+			w.bridge.Leave(w.ctx, p.ID())
+			if before := w.saved.of(p.ID()); before != spawn {
+				t.Fatalf("before=%v", before)
+			}
+			if early {
+				if err := sharedBodyRequest(w, p, save); err != nil {
+					t.Fatal(err)
+				}
+			}
+			count := func() int { w.saved.mu.Lock(); defer w.saved.mu.Unlock(); return w.saved.writes[p.ID()] }
+			start := count()
+			var logs bytes.Buffer
+			old := slog.Default()
+			slog.SetDefault(slog.New(slog.NewTextHandler(&logs, nil)))
+			defer slog.SetDefault(old)
+			d := playerEvictor{scene: w.bridge, manager: w.entities, nest: w.engine, ordinarySceneID: w.area.ID()}
+			ids, err := d.beginOrdinaryDrain(w.ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := d.finishOrdinaryDrain(w.ctx, ids); err != nil {
+				t.Fatal(err)
+			}
+			marker := strings.Contains(logs.String(), "ordinary map drain saved resident") && strings.Contains(logs.String(), fmt.Sprint(p.ID()))
+			delta := count() - start
+			t.Logf("before=%v after=%v saved_marker=%v drain_position_writes=%d", spawn, w.saved.of(p.ID()), marker, delta)
+			if !marker || w.saved.of(p.ID()) != last || (delta == 0) != early {
+				t.Fatal("unexpected evidence")
+			}
+		})
+	}
+}
