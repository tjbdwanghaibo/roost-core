+func TestReviewSavedOrigin(t *testing.T) {
+	cfg := gamescene.DefaultConfig()
+	cfg.Spawn = spatial.Point{X: 400, Y: 410}
+	cfg.PlayerCapacity = 1
+	w := newMoveWorldOn(t, cfg)
+	p := newScenePlayer(t, 9922)
+	w.entities.Add(p)
+	const sid int32 = 1001
+	source := spatial.Point{X: 620, Y: 540}
+	_, err := w.engine.Request(w.ctx, sharedBodyWrite, p.ID(), nest.NewParams(func() error {
+		p.Dao().SetSavedPosX(source.X)
+		p.Dao().SetSavedPosY(source.Y)
+		s := p.Dao().GetRehome()
+		s.SetPendingID("transfer-A")
+		s.SetPendingFrom(1000)
+		s.SetPendingTo(sid)
+		return nil
+	}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	place := func() (spatial.Point, bool, error) {
+		entry, err := syncsender.NewEnterSceneSender(w.engine).MultiSync_PlaceOrdinaryPlayer(w.ctx, p.ID(), w.area.ID(), sid)
+		return entry.At, entry.Arriving, err
+	}
+	block := w.join(9923, cfg.Spawn)
+	if _, _, err := place(); !errors.Is(err, apperrors.ErrSceneFull) {
+		t.Fatalf("full destination: %v", err)
+	}
+	if at := locked(w, p.ID(), p.MapComp().SavedPos); at != source {
+		t.Fatalf("refusal changed source save: %v", at)
+	}
+	if marked := locked(w, p.ID(), func() bool { _, v := p.RehomeComp().PendingArrival(sid); return v }); marked {
+		t.Fatal("refusal consumed placement")
+	}
+	leave := syncsender.NewLeaveSceneSender(w.engine)
+	if err := leave.MultiSync_LeaveOrdinaryScene(w.ctx, block.ID(), w.area.ID()); err != nil {
+		t.Fatal(err)
+	}
+	at, arriving, err := place()
+	if err != nil || !arriving || at != cfg.Spawn || locked(w, p.ID(), p.MapComp().SavedPos) != at {
+		t.Fatalf("arrival at %v, arriving=%t: %v", at, arriving, err)
+	}
+	// Join/OnEntered can be interrupted after placement. Move again and unload the map;
+	// retry with the still-pending transfer must use the saved destination point, not spawn again.
+	moved := spatial.Point{}
+	if err := syncsender.NewMovePlayerSender(w.engine).MultiSync_MovePlayer(w.ctx, p.ID(), w.area.ID(), moved.X, moved.Y); err != nil {
+		t.Fatal(err)
+	}
+	if err := leave.MultiSync_LeaveOrdinaryScene(w.ctx, p.ID(), w.area.ID()); err != nil {
+		t.Fatal(err)
+	}
+	// Rebuild a fresh Player through the production DAO hydration path; no live component
+	// or in-memory arrival flag is available after a destination process restart.
+	pid := p.ID()
+	raw := locked(w, pid, p.Dao().Marshal)
+	if err := w.entities.Destroy(w.ctx, p, entity.DestroyReasonCommon, false); err != nil {
+		t.Fatal(err)
+	}
+	restored := db.NewPlayerDao()
+	if err := restored.RestorePersisted(raw, restored.SchemaVersion(), 1); err != nil {
+		t.Fatal(err)
+	}
+	loaded, err := entity.BuildEntity(&entity.EntityCreateParam{Kind: player.EntityKindPlayer, Id: pid, Dao: map[string]entity.DaoInterface{restored.CollName(): restored}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	p = loaded.(*player.Player)
+	w.entities.Add(p)
+	t.Logf("restored saved_scene=%d saved=(%d,%d)", restored.GetSavedSceneID(), restored.GetSavedPosX(), restored.GetSavedPosY())
+	at, arriving, err = place()
+	if err != nil || !arriving || at != moved {
+		t.Fatalf("cold pending retry reset to %v: %v", at, err)
+	}
+	_, err = w.engine.Request(w.ctx, sharedBodyWrite, p.ID(), nest.NewParams(func() error {
+		result, e := p.RehomeComp().Arrive(sid, 1234)
+		if e == nil && !result.Arrived {
+			return errors.New("arrival not applied")
+		}
+		return e
+	}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	at, arriving, err = place()
+	if err != nil || arriving || at != moved || locked(w, p.ID(), p.RehomeComp().Count) != 1 {
+		t.Fatalf("same-sid reconnect: %v %t %v", at, arriving, err)
+	}
+}
